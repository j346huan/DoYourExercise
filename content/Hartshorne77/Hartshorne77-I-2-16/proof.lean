/-! ## Appendix: the two quadric surfaces are irreducible varieties

To justify the opening sentence of the exercise ("the intersection of two varieties need not be a
variety") inside the formalization, we also show that `Q₁` and `Q₂` themselves are irreducible
closed subsets of `ℙ³`, i.e. genuine quadric surfaces. -/

section QuadricsIrreducible

/-- The vanishing ideal of a projective hypersurface `Z(f)` with `f` a prime homogeneous
polynomial is the principal ideal `(f)` (projective Nullstellensatz). -/
theorem I_Z_singleton_of_prime {n : ℕ} {f : Poly k n} (hprime : Prime f)
    (hhom : ∃ d, f.IsHomogeneous d) (hne : Z ({f} : Set (Poly k n)) ≠ ∅) :
    I (Z ({f} : Set (Poly k n))) = Ideal.span {f} := by
  have hhom' : ∀ h ∈ ({f} : Set (Poly k n)), ∃ d, h.IsHomogeneous d := by
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    rw [hh]
    exact hhom
  have hne' : Z (↑(Ideal.span ({f} : Set (Poly k n))) : Set (Poly k n)) ≠ ∅ := by
    rwa [Z_span hhom']
  have h := part_d (Ideal.span ({f} : Set (Poly k n))) ⟨_, hhom', rfl⟩ hne'
  rw [Z_span hhom'] at h
  rw [h]
  exact (Ideal.IsPrime.isRadical ((Ideal.span_singleton_prime hprime.ne_zero).mpr hprime)).radical

lemma I_empty_aux {n : ℕ} : I (∅ : Set (Proj k n)) = ⊤ := by
  refine le_antisymm le_top ?_
  intro f _
  rw [mem_I_iff]
  intro P hP
  exact absurd hP (Set.notMem_empty P)

/-- A closed subset of `ℙⁿ` whose vanishing ideal is prime is irreducible. -/
theorem isIrreducible_of_isPrime_I {n : ℕ} {Y : Set (Proj k n)} (hY : IsClosed Y)
    (hprime : (I Y).IsPrime) : IsIrreducible Y := by
  have hnonempty : Y.Nonempty := by
    rcases Y.eq_empty_or_nonempty with rfl | h
    · exact absurd (I_empty_aux (k := k) (n := n)) hprime.ne_top
    · exact h
  refine ⟨hnonempty, ?_⟩
  rw [isPreirreducible_iff_isClosed_union_isClosed]
  intro z1 z2 hz1 hz2 hsub
  by_contra hcon
  push Not at hcon
  obtain ⟨h1, h2⟩ := hcon
  -- points of `Y` outside `z₁` and `z₂` give elements of `I(z₁)`, `I(z₂)` not in `I(Y)`
  have hex : ∀ z : Set (Proj k n), IsClosed z → ¬ Y ⊆ z →
      ∃ f ∈ I z, f ∉ I Y := by
    intro z hz hYz
    have hZY : Z (↑(I z) : Set (Poly k n)) = z := by
      rw [part_e]
      exact hz.closure_eq
    rw [Set.subset_def] at hYz
    push Not at hYz
    obtain ⟨P, hPY, hPz⟩ := hYz
    have hP : P ∉ Z (↑(I z) : Set (Poly k n)) := by rw [hZY]; exact hPz
    simp only [Z, Set.mem_ofPred_eq, not_forall] at hP
    obtain ⟨f, hfI, -, hfv⟩ := hP
    exact ⟨f, hfI, fun hfY => hfv ((mem_I_iff.mp hfY) P hPY)⟩
  obtain ⟨f, hf1, hfY⟩ := hex z1 hz1 h1
  obtain ⟨g, hg2, hgY⟩ := hex z2 hz2 h2
  have hfg : f * g ∈ I Y := by
    have hmem : f * g ∈ I z1 ⊓ I z2 :=
      ⟨Ideal.mul_mem_right g (I z1) hf1, Ideal.mul_mem_left (I z2) f hg2⟩
    have hmono : I z1 ⊓ I z2 ≤ I Y := by
      rw [← part_c]
      exact part_b hsub
    exact hmono hmem
  rcases hprime.mem_or_mem hfg with h | h
  · exact hfY h
  · exact hgY h

/-! ### Primality of the two quadric equations -/

lemma finSuccEquiv4_X0 : (MvPolynomial.finSuccEquiv k 3) (X (0 : Fin 4)) = Polynomial.X :=
  finSuccEquiv_X_zero

lemma finSuccEquiv4_X1 : (MvPolynomial.finSuccEquiv k 3) (X (1 : Fin 4))
    = Polynomial.C (X (0 : Fin 3)) := by
  have h : (1 : Fin 4) = Fin.succ (0 : Fin 3) := rfl
  rw [h]; exact finSuccEquiv_X_succ

lemma finSuccEquiv4_X2 : (MvPolynomial.finSuccEquiv k 3) (X (2 : Fin 4))
    = Polynomial.C (X (1 : Fin 3)) := by
  have h : (2 : Fin 4) = Fin.succ (1 : Fin 3) := rfl
  rw [h]; exact finSuccEquiv_X_succ

lemma finSuccEquiv4_X3 : (MvPolynomial.finSuccEquiv k 3) (X (3 : Fin 4))
    = Polynomial.C (X (2 : Fin 3)) := by
  have h : (3 : Fin 4) = Fin.succ (2 : Fin 3) := rfl
  rw [h]; exact finSuccEquiv_X_succ

/-- `x² - yw` is a prime element of `k[x,y,z,w]`. -/
theorem prime_Q1_eqn : Prime (((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3)) := by
  have hirr : Irreducible (Polynomial.C (-(X (0 : Fin 3) : Poly k 2)) * Polynomial.X +
      Polynomial.C ((X (2 : Fin 3) : Poly k 2) ^ 2)) := by
    apply Polynomial.irreducible_C_mul_X_add_C
    · simp
    · intro d h1 h2
      exact isUnit_of_dvd_X_of_dvd_X_pow (i := (0 : Fin 3)) (j := (2 : Fin 3)) (by decide)
        (dvd_neg.mp h1) h2
  have hprime3 : Prime ((X (3 : Fin 4) : Poly k 3) ^ 2 - (X 1) * (X 0)) := by
    have key : (MvPolynomial.finSuccEquiv k 3) ((X (3 : Fin 4) : Poly k 3) ^ 2 - (X 1) * (X 0))
        = Polynomial.C (-(X (0 : Fin 3) : Poly k 2)) * Polynomial.X +
          Polynomial.C ((X (2 : Fin 3) : Poly k 2) ^ 2) := by
      rw [map_sub, map_pow, map_mul, finSuccEquiv4_X0, finSuccEquiv4_X1, finSuccEquiv4_X3]
      simp only [Polynomial.C_neg, Polynomial.C_pow]
      ring
    rw [← key] at hirr
    exact UniqueFactorizationMonoid.irreducible_iff_prime.mp
      ((MulEquiv.irreducible_iff (MvPolynomial.finSuccEquiv k 3)).mp hirr)
  have key : (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 4) 3))
      ((X (3 : Fin 4) : Poly k 3) ^ 2 - (X 1) * (X 0))
      = (((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3)) := by
    simp [MvPolynomial.renameEquiv_apply, Equiv.swap_apply_def]
  rw [← key]
  exact (MulEquiv.prime_iff (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 4) 3))).mpr hprime3

/-- `xy - zw` is a prime element of `k[x,y,z,w]`. -/
theorem prime_Q2_eqn : Prime (((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3)) := by
  have hirr : Irreducible (Polynomial.C (-(X (1 : Fin 3) : Poly k 2)) * Polynomial.X +
      Polynomial.C ((X (0 : Fin 3) : Poly k 2) * (X (2 : Fin 3) : Poly k 2))) := by
    apply Polynomial.irreducible_C_mul_X_add_C
    · simp
    · intro d h1 h2
      exact isUnit_of_dvd_X_of_dvd_X_mul_X (i := (1 : Fin 3)) (j := (0 : Fin 3)) (l := (2 : Fin 3))
        (by decide) (by decide) (dvd_neg.mp h1) h2
  have hprime3 : Prime ((X (3 : Fin 4) : Poly k 3) * (X 1) - (X 2) * (X 0)) := by
    have key : (MvPolynomial.finSuccEquiv k 3)
        ((X (3 : Fin 4) : Poly k 3) * (X 1) - (X 2) * (X 0))
        = Polynomial.C (-(X (1 : Fin 3) : Poly k 2)) * Polynomial.X +
          Polynomial.C ((X (0 : Fin 3) : Poly k 2) * (X (2 : Fin 3) : Poly k 2)) := by
      rw [map_sub, map_mul, map_mul, finSuccEquiv4_X0, finSuccEquiv4_X1, finSuccEquiv4_X2,
        finSuccEquiv4_X3]
      simp only [Polynomial.C_neg, Polynomial.C_mul]
      ring
    rw [← key] at hirr
    exact UniqueFactorizationMonoid.irreducible_iff_prime.mp
      ((MulEquiv.irreducible_iff (MvPolynomial.finSuccEquiv k 3)).mp hirr)
  have key : (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 4) 3))
      ((X (3 : Fin 4) : Poly k 3) * (X 1) - (X 2) * (X 0))
      = (((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3)) := by
    simp [MvPolynomial.renameEquiv_apply, Equiv.swap_apply_def]
  rw [← key]
  exact (MulEquiv.prime_iff (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 4) 3))).mpr hprime3

lemma Q1_ne_zero_poly :
    (((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3)) ≠ 0 := prime_Q1_eqn.ne_zero

lemma Q1_Z_nonempty :
    Z ({(((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3))} : Set (Poly k 3)) ≠ ∅ := by
  intro h
  have hvan : Van (((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3)) (ptC (k := k)) := by
    have h' := (van_mk isHomog_quad1 (ptC_ne_zero (k := k))).mpr (by simp)
    simpa [ptC] using h'
  have hmem : ptC (k := k) ∈ Z ({(((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3))} :
      Set (Poly k 3)) := (mem_Z_single ⟨2, isHomog_quad1⟩).mpr hvan
  rw [h] at hmem
  exact hmem

lemma Q2_Z_nonempty : Z ({(((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3))} :
    Set (Poly k 3)) ≠ ∅ := by
  intro h
  have hvan : Van (((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3)) (ptC (k := k)) := by
    have h' := (van_mk isHomog_quad2 (ptC_ne_zero (k := k))).mpr (by simp)
    simpa [ptC] using h'
  have hmem : ptC (k := k) ∈ Z ({(((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3))} :
      Set (Poly k 3)) := (mem_Z_single ⟨2, isHomog_quad2⟩).mpr hvan
  rw [h] at hmem
  exact hmem

/-- The first quadric surface `Q₁ ⊂ ℙ³` is irreducible. -/
theorem Q1_irreducible : IsIrreducible (Q1 (k := k)) := by
  have hI : I (Q1 (k := k)) = Ideal.span {(((X (0 : Fin 4) : Poly k 3)) ^ 2 - (X 1) * (X 3))} :=
    I_Z_singleton_of_prime prime_Q1_eqn ⟨2, isHomog_quad1⟩ Q1_Z_nonempty
  refine isIrreducible_of_isPrime_I (isClosed_Z _) ?_
  rw [hI]
  exact (Ideal.span_singleton_prime prime_Q1_eqn.ne_zero).mpr prime_Q1_eqn

/-- The second quadric surface `Q₂ ⊂ ℙ³` is irreducible. -/
theorem Q2_irreducible : IsIrreducible (Q2 (k := k)) := by
  have hI : I (Q2 (k := k)) =
      Ideal.span {(((X (0 : Fin 4) : Poly k 3)) * (X 1) - (X 2) * (X 3))} :=
    I_Z_singleton_of_prime prime_Q2_eqn ⟨2, isHomog_quad2⟩ Q2_Z_nonempty
  refine isIrreducible_of_isPrime_I (isClosed_Z _) ?_
  rw [hI]
  exact (Ideal.span_singleton_prime prime_Q2_eqn.ne_zero).mpr prime_Q2_eqn

end QuadricsIrreducible

