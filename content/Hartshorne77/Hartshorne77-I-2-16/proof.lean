/-- Exercise I.2.16 in full, together with the fact that `Q₁` and `Q₂` are themselves
irreducible (so that `Q₁ ∩ Q₂` really is the intersection of two varieties). -/
theorem hartshorne_I_2_16_complete :
    IsIrreducible (Q1 (k := k)) ∧ IsIrreducible (Q2 (k := k)) ∧
    (Q1 (k := k) ∩ Q2 = twistCubic ∪ lineL) ∧
    (twistCubic (k := k) = tcImage) ∧
    (¬ IsIrreducible (Q1 (k := k) ∩ Q2)) ∧
    (conic (k := k) ∩ line2 = {ptP}) ∧
    (I (conic (k := k)) + I (line2 (k := k)) =
      Ideal.span {(((X (0 : Fin 3) : Poly k 2)) ^ 2), ((X (1 : Fin 3) : Poly k 2))}) ∧
    (I (conic (k := k)) + I (line2 (k := k)) ≠ I ({ptP (k := k)} : Set (Proj k 2))) ∧
    (I ({ptP (k := k)} : Set (Proj k 2)) =
      Ideal.span ({(X (0 : Fin 3) : Poly k 2), (X (1 : Fin 3) : Poly k 2)} : Set (Poly k 2))) :=
  ⟨Q1_irreducible, Q2_irreducible, Q1_inter_Q2, twistCubic_eq_tcImage,
    not_isIrreducible_Q1_inter_Q2, conic_inter_line2, conic_ideal_add_line_ideal,
    ideal_inequality, ptP_ideal⟩

