import Mathlib

/-!
# Hartshorne, *Algebraic Geometry* (1977), Chapter I, §2, Exercise 2.2

Source statement (Hartshorne, Ch. I, §2, Exercise 2.2):

> For a homogeneous ideal `𝔞 ⊆ S`, show that the following conditions are equivalent:
> (i) `V(𝔞) = ∅`;
> (ii) `√𝔞 = S` or `√𝔞 = S_+ = ⊕_{d>0} S_d`;
> (iii) `𝔞 ⊇ S_d` for some `d > 0`.

Here `S = k[x_0,…,x_n]` with `k` an algebraically closed field, and `V(𝔞)` is the zero locus
of `𝔞` in projective space `P^n` (Hartshorne, §I.2, p. 10).

## Faithful encoding of the objects

* `S` is `Poly k n = MvPolynomial (Fin (n+1)) k`, i.e. `k[x_0,…,x_n]` (`n+1` variables).
* The graded piece `S_d` of all homogeneous polynomials of degree `d` is
  `gradedPiece k n d = MvPolynomial.homogeneousSubmodule (Fin (n+1)) k d`.
* The irrelevant ideal `S_+ = ⊕_{d>0} S_d = (x_0,…,x_n)` is `Splus k n =
  MvPolynomial.idealOfVars (Fin (n+1)) k`; that it is generated by the variables and that it
  is the vanishing ideal of the origin is `Splus_eq_vanishingIdeal_zero`, which also yields
  its maximality (`isMaximal_Splus`), used for the `√𝔞 = S_+` alternative in (ii).
* Classical projective points `P^n = (k^{n+1} \ {0}) / k^×` are modelled as the
  one-dimensional `k`-submodules of `k^{n+1}` (`Proj k n`): every such line is precisely the
  set of all nonzero multiples of a single nonzero vector, i.e. one equivalence class, and
  conversely each equivalence class is such a line.  This is *not* `Proj`/`ProjectiveSpectrum`.
* `V(𝔞) ⊆ P^n` is `projVanishesSet`: the set of lines on which every homogeneous element of
  `𝔞` of positive degree vanishes -- literally Hartshorne's definition.  Because a homogeneous
  polynomial of degree `d > 0` satisfies `f(c·v) = c^d f(v)`
  (`aeval_smul_of_isHomogeneous`), vanishing is independent of the chosen homogeneous
  coordinates (`aeval_eq_zero_iff_of_mem_proj`).  For a homogeneous ideal this set coincides
  with `projZeroLocus`, the set of lines meeting the affine cone `Z(𝔞) ⊆ A^{n+1}` in a nonzero
  point (`projVanishesSet_eq_projZeroLocus`); all the geometric content is proved through the
  affine cone, i.e. through Hilbert's Nullstellensatz.
-/

namespace Hartshorne77.Ex_I_2_2

open MvPolynomial

noncomputable section

variable {k : Type*} [Field k]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- `S = k[x_0, …, x_n]`, the polynomial ring in `n + 1` variables. -/
abbrev Poly (k : Type*) [CommSemiring k] (n : ℕ) : Type _ := MvPolynomial (Fin (n + 1)) k

/-- The irrelevant ideal `S_+ = ⨁_{d>0} S_d = (x_0, …, x_n)`. -/
abbrev Splus (k : Type*) [CommSemiring k] (n : ℕ) : Ideal (Poly k n) :=
  MvPolynomial.idealOfVars (Fin (n + 1)) k

/-- The graded piece `S_d`: the `k`-subspace of homogeneous polynomials of degree `d`. -/
abbrev gradedPiece (k : Type*) [CommSemiring k] (n d : ℕ) : Submodule k (Poly k n) :=
  MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k d

/-- `𝔞` is a homogeneous ideal of `S`. -/
abbrev IsHomogIdeal (k : Type*) [CommSemiring k] (n : ℕ) (a : Ideal (Poly k n)) : Prop :=
  a.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)

/-- The vector space `k^{n+1}` whose lines are the points of `P^n`. -/
abbrev Coord (k : Type*) (n : ℕ) : Type _ := Fin (n + 1) → k

/-- `P^n`: the projective points, i.e. the one-dimensional subspaces of `k^{n+1}`, which is
`(k^{n+1} \ {0}) / k^×`. -/
abbrev Proj (k : Type*) [Field k] (n : ℕ) : Type _ :=
  {L : Submodule k (Coord k n) // Module.finrank k L = 1}

/-- The affine cone `Z(𝔞) ⊆ A^{n+1}` over `V(𝔞)`. -/
abbrev affCone (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n)) : Set (Coord k n) :=
  MvPolynomial.zeroLocus (K := k) a

/-- `V(𝔞) ⊆ P^n` as defined by Hartshorne: the points at which every homogeneous element of
`𝔞` of positive degree vanishes. -/
def projVanishesSet (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n)) : Set (Proj k n) :=
  {L | ∀ f ∈ a, ∀ d : ℕ, f.IsHomogeneous d → 0 < d →
    ∀ v : Coord k n, v ∈ (L : Submodule k (Coord k n)) → MvPolynomial.aeval v f = 0}

/-- `V(𝔞) ⊆ P^n` in cone form: the projective points (lines) meeting the affine cone `Z(𝔞)`
in a nonzero point. -/
def projZeroLocus (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n)) : Set (Proj k n) :=
  {L | ∃ v : Coord k n, v ∈ (L : Submodule k (Coord k n)) ∧ v ≠ 0 ∧ v ∈ affCone k n a}

/-! ## `S_+` is the vanishing ideal of the origin, hence maximal -/

/-- `S_+ = (x_0, …, x_n)` is the vanishing ideal of the origin of `A^{n+1}`, i.e. the ideal of
polynomials with zero constant term. -/
theorem Splus_eq_vanishingIdeal_zero (k : Type*) [Field k] (n : ℕ) :
    Splus k n = MvPolynomial.vanishingIdeal k ({(0 : Coord k n)} : Set (Coord k n)) := by
  refine le_antisymm ?_ ?_
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    show ∀ x ∈ ({(0 : Coord k n)} : Set (Coord k n)),
      MvPolynomial.aeval x (MvPolynomial.X i) = 0
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    simp
  · intro f hf
    have h0 : MvPolynomial.aeval (0 : Coord k n) f = 0 := hf 0 rfl
    rw [MvPolynomial.aeval_zero] at h0
    have hc : MvPolynomial.coeff (0 : Fin (n + 1) →₀ ℕ) f = 0 := by
      simpa [MvPolynomial.constantCoeff_eq] using h0
    change f ∈ Ideal.span (Set.range MvPolynomial.X)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hc
    obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hm0
    exact ⟨i, Set.mem_univ i, Finsupp.mem_support_iff.mp hi⟩

/-- The irrelevant ideal `S_+` is maximal: it is the vanishing ideal of a point. -/
theorem isMaximal_Splus (k : Type*) [Field k] (n : ℕ) : (Splus k n).IsMaximal := by
  rw [Splus_eq_vanishingIdeal_zero]
  infer_instance

/-! ## Graded pieces versus powers of `S_+` -/

/-- Every homogeneous polynomial of degree `d` lies in the `d`-th power of `S_+`. -/
theorem homogeneousSubmodule_mem_idealOfVars_pow (k : Type*) [Field k] (n d : ℕ)
    (f : Poly k n) (hf : f ∈ gradedPiece k n d) : f ∈ (Splus k n) ^ d := by
  rw [MvPolynomial.mem_pow_idealOfVars_iff]
  intro m hm
  rw [MvPolynomial.mem_homogeneousSubmodule] at hf
  rw [Finsupp.degree_apply, ← hf.degree_eq_sum_deg_support hm]

/-- If `m` is an exponent vector of degree `∑ q_i + 1`, then `m_i ≥ q_i` for some `i`. -/
theorem exists_le_of_degree_eq {n : ℕ} (m : Fin (n + 1) →₀ ℕ) (q : Fin (n + 1) → ℕ)
    (hm : m.degree = ∑ i, q i + 1) : ∃ i, q i ≤ m i := by
  by_contra h
  push Not at h
  have hsum : ∑ i, m i = ∑ i, q i + 1 := by
    rw [← Finsupp.degree_eq_sum]
    exact hm
  have hlt : ∑ i, m i < ∑ i, q i :=
    Finset.sum_lt_sum (fun i _ => le_of_lt (h i))
      ⟨⟨0, Nat.succ_pos n⟩, Finset.mem_univ _, h _⟩
  omega

/-- If `𝔞` contains `x_i^{q_i}` for every `i`, then `𝔞` contains `S_d` where `d = ∑ q_i + 1`. -/
theorem gradedPiece_subset_of_X_pow_mem (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n))
    (q : Fin (n + 1) → ℕ) (hq : ∀ i, MvPolynomial.X i ^ q i ∈ a) :
    ∀ f, f ∈ gradedPiece k n (∑ i, q i + 1) → f ∈ a := by
  have hmain : (Splus k n) ^ (∑ i, q i + 1) ≤ a := by
    rw [MvPolynomial.pow_idealOfVars_eq_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨m, hm, rfl⟩
    change MvPolynomial.monomial m 1 ∈ a
    obtain ⟨i, hi⟩ := exists_le_of_degree_eq m q hm
    have hsingle : Finsupp.single i (q i) ≤ m := Finsupp.single_le_iff.mpr hi
    have hexp : (m - Finsupp.single i (q i)) + Finsupp.single i (q i) = m :=
      tsub_add_cancel_of_le hsingle
    have hmul : MvPolynomial.monomial (m - Finsupp.single i (q i)) 1 *
        MvPolynomial.X i ^ q i ∈ a :=
      Ideal.mul_mem_left a (MvPolynomial.monomial (m - Finsupp.single i (q i)) 1) (hq i)
    convert hmul using 2
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, hexp]
    simp
  intro f hf
  exact hmain (homogeneousSubmodule_mem_idealOfVars_pow k n _ f hf)

/-! ## Homogeneous polynomials are homogeneous functions -/

/-- A homogeneous polynomial of degree `d` is a homogeneous function of degree `d`:
`f(c·v) = c^d · f(v)`. -/
theorem aeval_smul_of_isHomogeneous {σ : Type*} [Fintype σ] {f : MvPolynomial σ k} {d : ℕ}
    (hf : f.IsHomogeneous d) (c : k) (v : σ → k) :
    MvPolynomial.aeval (c • v) f = c ^ d * MvPolynomial.aeval v f := by
  rw [MvPolynomial.as_sum f, map_sum, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro m hm
  have hdeg : m.degree = d := by
    rw [Finsupp.degree_apply, ← hf.degree_eq_sum_deg_support hm]
  have hprod : m.prod (fun i k => (c • v) i ^ k) = c ^ d * m.prod (fun i k => v i ^ k) := by
    have hfun : (fun i k => (c • v) i ^ k) = fun i k => c ^ k * v i ^ k := by
      funext i k
      rw [Pi.smul_apply, smul_eq_mul, mul_pow]
    rw [hfun, Finsupp.prod_mul]
    congr 1
    rw [Finsupp.prod_pow, Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum, hdeg]
  rw [MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial, hprod]
  ring

/-- Vanishing at a projective point is independent of the chosen homogeneous coordinates. -/
theorem aeval_eq_zero_iff_of_mem_proj (k : Type*) [Field k] (n : ℕ) (L : Proj k n)
    {v : Coord k n} (hv : v ∈ (L : Submodule k (Coord k n))) (hv0 : v ≠ 0)
    {f : Poly k n} {d : ℕ} (hf : f.IsHomogeneous d) (_hd : 0 < d) :
    (∀ w ∈ (L : Submodule k (Coord k n)), MvPolynomial.aeval w f = 0) ↔
      MvPolynomial.aeval v f = 0 := by
  constructor
  · exact fun h => h v hv
  · intro h w hw
    have hL : (L : Submodule k (Coord k n)) = Submodule.span k {v} :=
      eq_span_singleton_of_mem_of_finrank_eq_one L.2 hv hv0
    have hw' : w ∈ Submodule.span k {v} := hL ▸ hw
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hw'
    rw [aeval_smul_of_isHomogeneous hf c v, h, mul_zero]

/-! ## The point model really is `(k^{n+1} \ {0}) / k^×` -/

/-- Two nonzero vectors represent the same projective point iff they are nonzero scalar
multiples of one another. -/
theorem exists_unit_smul_eq_of_mem_of_ne_zero (k : Type*) [Field k] (n : ℕ) (L : Proj k n)
    {v w : Coord k n} (hv : v ∈ (L : Submodule k (Coord k n))) (hv0 : v ≠ 0)
    (hw : w ∈ (L : Submodule k (Coord k n))) (hw0 : w ≠ 0) :
    ∃ c : kˣ, (c : k) • v = w := by
  have hL : (L : Submodule k (Coord k n)) = Submodule.span k {v} :=
    eq_span_singleton_of_mem_of_finrank_eq_one L.2 hv hv0
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hL ▸ hw)
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hc
    exact hw0 hc.symm
  exact ⟨Units.mk0 c hc0, by rw [Units.val_mk0, hc]⟩

/-- Every nonzero vector of `k^{n+1}` lies on a projective point. -/
theorem exists_mem_proj_of_ne_zero (k : Type*) [Field k] (n : ℕ) (v : Coord k n) (hv : v ≠ 0) :
    ∃ L : Proj k n, v ∈ (L : Submodule k (Coord k n)) :=
  ⟨⟨Submodule.span k {v}, finrank_span_singleton hv⟩, Submodule.mem_span_singleton_self v⟩

/-! ## The two models of `V(𝔞)` agree for homogeneous `𝔞` -/

/-- For a homogeneous ideal, `V(𝔞)` in the sense of Hartshorne (every homogeneous element of
positive degree vanishes) is the same as the set of lines meeting the affine cone `Z(𝔞)` in a
nonzero point. -/
theorem projVanishesSet_eq_projZeroLocus (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n))
    (ha : IsHomogIdeal k n a) : projVanishesSet k n a = projZeroLocus k n a := by
  ext L
  constructor
  · intro h
    have hne : (L : Submodule k (Coord k n)) ≠ ⊥ := by
      intro hbot
      have hfin : Module.finrank k L = 1 := L.2
      rw [hbot, finrank_bot] at hfin
      exact absurd hfin.symm one_ne_zero
    obtain ⟨v, hvL, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    refine ⟨v, hvL, hv0, ?_⟩
    rw [MvPolynomial.mem_zeroLocus_iff]
    intro f hf
    have hne_top : a ≠ ⊤ := by
      intro htop
      have hvanish : ∀ i : Fin (n + 1), v i = 0 := by
        intro i
        have hmem : MvPolynomial.X i ∈ a := htop ▸ Submodule.mem_top
        have h3 : MvPolynomial.aeval v (MvPolynomial.X i) = 0 :=
          h (MvPolynomial.X i) hmem 1 (MvPolynomial.isHomogeneous_X (R := k) i)
            (by norm_num) v hvL
        simpa using h3
      exact hv0 (funext hvanish)
    have hcoeff0 : MvPolynomial.coeff (0 : Fin (n + 1) →₀ ℕ) f = 0 := by
      by_contra hc
      have hmem : (MvPolynomial.C (MvPolynomial.coeff 0 f) : Poly k n) ∈ a := by
        have h0 := MvPolynomial.homogeneousComponent_mem_of_mem ha hf 0
        simpa using h0
      have hone : (1 : Poly k n) ∈ a := by
        have hmul : (MvPolynomial.C ((MvPolynomial.coeff 0 f)⁻¹) : Poly k n) *
            MvPolynomial.C (MvPolynomial.coeff 0 f) = 1 := by
          rw [← map_mul, inv_mul_cancel₀ hc, map_one]
        rw [← hmul]
        exact Ideal.mul_mem_left a _ hmem
      exact hne_top ((Ideal.eq_top_iff_one a).mpr hone)
    rw [← MvPolynomial.sum_homogeneousComponent (φ := f), map_sum]
    refine Finset.sum_eq_zero ?_
    intro i _
    rcases Nat.eq_zero_or_pos i with rfl | hpos
    · simp [hcoeff0]
    · exact h _ (MvPolynomial.homogeneousComponent_mem_of_mem ha hf i) i
        (MvPolynomial.homogeneousComponent_isHomogeneous i f) hpos v hvL
  · rintro ⟨v, hvL, hv0, hvZ⟩ f hf d hhd hd w hwL
    exact (aeval_eq_zero_iff_of_mem_proj k n L hvL hv0 hhd hd).mpr (hvZ f hf) w hwL

/-! ## (i) ↔ the affine cone is contained in the origin -/

/-- `V(𝔞) = ∅` iff the affine cone over `𝔞` is contained in the origin of `A^{n+1}`. -/
theorem projZeroLocus_empty_iff_zeroLocus_subset (k : Type*) [Field k] (n : ℕ)
    (a : Ideal (Poly k n)) :
    projZeroLocus k n a = ∅ ↔ affCone k n a ⊆ {0} := by
  constructor
  · intro h v hv
    by_contra hv0
    have hline : (⟨Submodule.span k {v}, finrank_span_singleton hv0⟩ : Proj k n) ∈
        projZeroLocus k n a :=
      ⟨v, Submodule.mem_span_singleton_self v, hv0, hv⟩
    rw [h, Set.mem_empty_iff_false] at hline
    exact hline
  · intro h
    refine Set.eq_empty_iff_forall_notMem.mpr ?_
    rintro ⟨L, hL⟩ ⟨v, hvL, hv0, hvZ⟩
    have : v ∈ ({0} : Set (Coord k n)) := h hvZ
    rw [Set.mem_singleton_iff] at this
    exact hv0 this

/-! ## (i) ↔ (ii): the projective form of the Nullstellensatz -/

/-- Hilbert's Nullstellensatz in the form needed: if the affine cone over `𝔞` is contained in
the origin, then `√𝔞` is either `S_+` (the ideal of the origin) or all of `S`. -/
theorem zeroLocus_subset_iff_radical (k : Type*) [Field k] [IsAlgClosed k] (n : ℕ)
    (a : Ideal (Poly k n)) :
    affCone k n a ⊆ {0} ↔ a.radical = ⊤ ∨ a.radical = Splus k n := by
  have hvan : MvPolynomial.vanishingIdeal k (affCone k n a) = a.radical :=
    MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := k) a
  constructor
  · intro h
    have hle : Splus k n ≤ a.radical := by
      rw [Splus_eq_vanishingIdeal_zero, ← hvan]
      exact MvPolynomial.vanishingIdeal_anti_mono h
    by_cases htop : a.radical = ⊤
    · exact Or.inl htop
    · exact Or.inr ((isMaximal_Splus k n).eq_of_le htop hle).symm
  · rintro (h | h) x hx
    · exfalso
      have h1 : (1 : Poly k n) ∈ a.radical := by rw [h]; exact Submodule.mem_top
      have h2 : (1 : Poly k n) ∈ MvPolynomial.vanishingIdeal k (affCone k n a) := by
        rw [hvan]; exact h1
      rw [MvPolynomial.mem_vanishingIdeal_iff] at h2
      have h3 : MvPolynomial.aeval x (1 : Poly k n) = 0 := h2 x hx
      rw [map_one] at h3
      exact one_ne_zero h3
    · have hmem : ∀ i : Fin (n + 1),
          MvPolynomial.X i ∈ MvPolynomial.vanishingIdeal k (affCone k n a) := by
        intro i
        rw [hvan, h]
        exact Ideal.subset_span ⟨i, rfl⟩
      simp only [MvPolynomial.mem_vanishingIdeal_iff] at hmem
      rw [Set.mem_singleton_iff]
      funext i
      have h3 : MvPolynomial.aeval x (MvPolynomial.X i) = 0 := hmem i x hx
      simpa using h3

/-! ## (ii) ↔ (iii) -/

/-- If `√𝔞` is `S` or `S_+`, then `𝔞` contains a full graded piece `S_d` with `d > 0`. -/
theorem radical_iff_gradedPiece (k : Type*) [Field k] (n : ℕ) (a : Ideal (Poly k n)) :
    (a.radical = ⊤ ∨ a.radical = Splus k n) ↔
      ∃ d : ℕ, 0 < d ∧ ∀ f, f ∈ gradedPiece k n d → f ∈ a := by
  constructor
  · rintro (h | h)
    · have hone : (1 : Poly k n) ∈ a := by
        have h1 : (1 : Poly k n) ∈ a.radical := by rw [h]; exact Submodule.mem_top
        rcases Ideal.mem_radical_iff.mp h1 with ⟨m, hm⟩
        simpa using hm
      refine ⟨1, by norm_num, ?_⟩
      intro f _
      rw [(Ideal.eq_top_iff_one a).mpr hone]
      exact Submodule.mem_top
    · have hXi : ∀ i : Fin (n + 1), MvPolynomial.X i ∈ a.radical := by
        intro i
        rw [h, Splus, MvPolynomial.idealOfVars]
        exact Ideal.subset_span ⟨i, rfl⟩
      choose q hq using fun i : Fin (n + 1) => Ideal.mem_radical_iff.mp (hXi i)
      exact ⟨∑ i, q i + 1, Nat.succ_pos _, gradedPiece_subset_of_X_pow_mem k n a q hq⟩
  · rintro ⟨d, hd, hle⟩
    have hX : ∀ i : Fin (n + 1), MvPolynomial.X i ∈ a.radical := by
      intro i
      have hmem : MvPolynomial.X i ^ d ∈ gradedPiece k n d := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        simpa using (MvPolynomial.isHomogeneous_X (R := k) i).pow d
      exact Ideal.mem_radical_iff.mpr ⟨d, hle _ hmem⟩
    have hle' : Splus k n ≤ a.radical := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hX i
    by_cases htop : a.radical = ⊤
    · exact Or.inl htop
    · exact Or.inr ((isMaximal_Splus k n).eq_of_le htop hle').symm

/-! ## (iii) ⇒ (i) -/

/-- If `𝔞` contains a full graded piece of positive degree, then `V(𝔞)` is empty. -/
theorem gradedPiece_subset_imp_projZeroLocus_empty (k : Type*) [Field k] (n : ℕ)
    (a : Ideal (Poly k n)) (d : ℕ) (hd : 0 < d)
    (hle : ∀ f, f ∈ gradedPiece k n d → f ∈ a) :
    projZeroLocus k n a = ∅ := by
  refine Set.eq_empty_iff_forall_notMem.mpr ?_
  rintro ⟨L, hL⟩ ⟨v, hvL, hv0, hvZ⟩
  have hXi : ∀ i : Fin (n + 1), MvPolynomial.X i ^ d ∈ a := by
    intro i
    refine hle _ ?_
    rw [MvPolynomial.mem_homogeneousSubmodule]
    simpa using (MvPolynomial.isHomogeneous_X (R := k) i).pow d
  have hvanish : ∀ i : Fin (n + 1), v i = 0 := by
    intro i
    have h3 : MvPolynomial.aeval v (MvPolynomial.X i ^ d) = 0 := hvZ _ (hXi i)
    have h4 : (v i) ^ d = 0 := by simpa using h3
    exact (pow_eq_zero_iff hd.ne').mp h4
  exact hv0 (funext hvanish)

/-! ## The exercise -/

/-- **Hartshorne, Chapter I, Exercise 2.2.**  For a homogeneous ideal `𝔞` of
`S = k[x_0,…,x_n]` over an algebraically closed field `k`, the following are equivalent:

(i) `V(𝔞) = ∅` in `P^n`;
(ii) `√𝔞 = S` or `√𝔞 = S_+ = ⊕_{d>0} S_d`;
(iii) `𝔞 ⊇ S_d` for some `d > 0`. -/
theorem hartshorne_I_2_2 (k : Type*) [Field k] [IsAlgClosed k] (n : ℕ) (a : Ideal (Poly k n))
    (ha : IsHomogIdeal k n a) :
    (projVanishesSet k n a = ∅ ↔ a.radical = ⊤ ∨ a.radical = Splus k n) ∧
    (a.radical = ⊤ ∨ a.radical = Splus k n ↔
      ∃ d : ℕ, 0 < d ∧ ∀ f, f ∈ gradedPiece k n d → f ∈ a) ∧
    (projVanishesSet k n a = ∅ ↔ ∃ d : ℕ, 0 < d ∧ ∀ f, f ∈ gradedPiece k n d → f ∈ a) := by
  have heq : projVanishesSet k n a = projZeroLocus k n a :=
    projVanishesSet_eq_projZeroLocus k n a ha
  have h1 : projVanishesSet k n a = ∅ ↔ affCone k n a ⊆ {0} := by
    rw [heq]
    exact projZeroLocus_empty_iff_zeroLocus_subset k n a
  have h2 := zeroLocus_subset_iff_radical k n a
  have h3 := radical_iff_gradedPiece k n a
  have h4 : projVanishesSet k n a = ∅ →
      ∃ d : ℕ, 0 < d ∧ ∀ f, f ∈ gradedPiece k n d → f ∈ a :=
    fun h => h3.mp (h2.mp (h1.mp h))
  have h5 : (∃ d : ℕ, 0 < d ∧ ∀ f, f ∈ gradedPiece k n d → f ∈ a) →
      projVanishesSet k n a = ∅ := by
    rintro ⟨d, hd, hle⟩
    rw [heq]
    exact gradedPiece_subset_imp_projZeroLocus_empty k n a d hd hle
  exact ⟨h1.trans h2, h3, ⟨h4, h5⟩⟩

end

end Hartshorne77.Ex_I_2_2
