import Mathlib

/-!
# Hartshorne, *Algebraic Geometry* (1977), Exercise I.1.11

For an algebraically closed field `k` let `Y = {(t³, t⁴, t⁵) : t ∈ k} ⊆ A³ = k³`.  Its
vanishing ideal `I(Y)` is the kernel of the parametrization `k[x,y,z] → k[t]`,
`x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵`.  We prove that `I(Y)` is prime, that its height is two, and
that it is not generated by two elements (although `y² - xz`, `yz - x³` and `z² - x²y` all
lie in `I(Y)`).

The development is complete: no placeholders, no custom axioms, and no imports beyond
`Mathlib`.
-/

namespace Hartshorne77.Ex_I_1_11

noncomputable section

open MvPolynomial

variable {k : Type*} [Field k]

/-- The point `(t³, t⁴, t⁵)` of affine `3`-space `A³ = k³`. -/
def curvePt (t : k) : Fin 3 → k := ![t ^ 3, t ^ 4, t ^ 5]

@[simp] lemma curvePt_apply_zero (t : k) : curvePt t 0 = t ^ 3 := rfl
@[simp] lemma curvePt_apply_one (t : k) : curvePt t 1 = t ^ 4 := rfl
@[simp] lemma curvePt_apply_two (t : k) : curvePt t 2 = t ^ 5 := rfl

/-- The curve `Y ⊆ A³` given parametrically by `x = t³`, `y = t⁴`, `z = t⁵`. -/
def curveSet : Set (Fin 3 → k) := Set.range (curvePt (k := k))

/-- The parametrization `k[x,y,z] → k[t]`, `x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵`. -/
def paramAlgHom : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k :=
  MvPolynomial.aeval
    (![(Polynomial.X) ^ 3, (Polynomial.X) ^ 4, (Polynomial.X) ^ 5] : Fin 3 → Polynomial k)

/-- `I(Y)`, the vanishing ideal of `Y`, as the kernel of the parametrization. -/
def IY : Ideal (MvPolynomial (Fin 3) k) := RingHom.ker (paramAlgHom (k := k)).toRingHom

/-- The vanishing ideal of a set of points of `A³ = k³`. -/
def vanishingIdeal (S : Set (Fin 3 → k)) : Ideal (MvPolynomial (Fin 3) k) where
  carrier := {f | ∀ P ∈ S, MvPolynomial.eval P f = 0}
  zero_mem' := by simp
  add_mem' := by intro f g hf hg P hP; simp [hf P hP, hg P hP]
  smul_mem' := by intro a f hf P hP; simp [hf P hP]

lemma IY_eq_ker :
    (IY (k := k)) = RingHom.ker (paramAlgHom (k := k)).toRingHom := rfl

@[simp] lemma paramAlgHom_X_zero : paramAlgHom (k := k) (MvPolynomial.X 0) = Polynomial.X ^ 3 := by
  simp [paramAlgHom]

@[simp] lemma paramAlgHom_X_one : paramAlgHom (k := k) (MvPolynomial.X 1) = Polynomial.X ^ 4 := by
  simp [paramAlgHom]

@[simp] lemma paramAlgHom_X_two : paramAlgHom (k := k) (MvPolynomial.X 2) = Polynomial.X ^ 5 := by
  simp [paramAlgHom]

lemma eval_paramAlgHom (t : k) (f : MvPolynomial (Fin 3) k) :
    (paramAlgHom (k := k) f).eval t = MvPolynomial.eval (curvePt t) f := by
  have h : (Polynomial.evalRingHom t).comp (paramAlgHom (k := k)).toRingHom
      = (MvPolynomial.eval (curvePt t) : MvPolynomial (Fin 3) k →+* k) := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp [paramAlgHom]
    · fin_cases i <;> simp [paramAlgHom, curvePt]
  exact RingHom.congr_fun h f

section AlgClosed

variable [IsAlgClosed k]

/-- `I(Y)` is the vanishing ideal of the point set `Y = {(t³,t⁴,t⁵) : t ∈ k}`. -/
theorem IY_eq_vanishingIdeal : IY (k := k) = vanishingIdeal (curveSet (k := k)) := by
  refine Ideal.ext (fun f => ?_)
  simp only [IY_eq_ker, RingHom.mem_ker, vanishingIdeal]
  constructor
  · intro hf P hP
    obtain ⟨t, rfl⟩ := hP
    have hf' : paramAlgHom (k := k) f = 0 := hf
    rw [← eval_paramAlgHom t f, hf']
    simp
  · intro hf
    have h : ∀ t : k, (paramAlgHom (k := k) f).eval t = 0 := by
      intro t
      rw [eval_paramAlgHom t f]
      exact hf _ ⟨t, rfl⟩
    by_contra hne
    refine hne (Polynomial.eq_zero_of_infinite_isRoot _ ?_)
    have hset : {x : k | (paramAlgHom (k := k)).toRingHom f |>.IsRoot x} = Set.univ := by
      ext x
      simpa using h x
    rw [hset]
    exact Set.infinite_univ

omit [IsAlgClosed k] in
/-- `I(Y)` is a prime ideal. -/
instance IY_isPrime : (IY (k := k)).IsPrime :=
  RingHom.ker_isPrime (paramAlgHom (k := k)).toRingHom

/-- A polynomial that vanishes at every point of the curve lies in `I(Y)`. -/
lemma mem_IY_of_forall_eval (f : MvPolynomial (Fin 3) k)
    (h : ∀ t : k, MvPolynomial.eval (curvePt t) f = 0) : f ∈ IY (k := k) := by
  rw [IY_eq_vanishingIdeal]
  intro P hP
  obtain ⟨t, rfl⟩ := hP
  exact h t

/-- `y² - xz ∈ I(Y)`. -/
lemma y_sq_sub_x_mul_z_mem : (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2
    : MvPolynomial (Fin 3) k) ∈ IY (k := k) := by
  refine mem_IY_of_forall_eval _ (fun t => ?_)
  simp [curvePt]
  ring

/-- `x³ - yz ∈ I(Y)`. -/
lemma x_cu_sub_y_mul_z_mem : (MvPolynomial.X 0 ^ 3 - MvPolynomial.X 1 * MvPolynomial.X 2
    : MvPolynomial (Fin 3) k) ∈ IY (k := k) := by
  refine mem_IY_of_forall_eval _ (fun t => ?_)
  simp [curvePt]
  ring

/-- `z² - x²y ∈ I(Y)`. -/
lemma z_sq_sub_x_sq_mul_y_mem : (MvPolynomial.X 2 ^ 2 - MvPolynomial.X 0 ^ 2 * MvPolynomial.X 1
    : MvPolynomial (Fin 3) k) ∈ IY (k := k) := by
  refine mem_IY_of_forall_eval _ (fun t => ?_)
  simp [curvePt]
  ring

/-- `x ∉ I(Y)`. -/
lemma X_zero_notMem_IY : (MvPolynomial.X 0 : MvPolynomial (Fin 3) k) ∉ IY (k := k) := by
  rw [IY_eq_vanishingIdeal]
  intro h
  have hx := h (curvePt 1) ⟨1, rfl⟩
  simp [curvePt] at hx

/-- `z ∉ I(Y)`. -/
lemma X_two_notMem_IY : (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) ∉ IY (k := k) := by
  rw [IY_eq_vanishingIdeal]
  intro h
  have := h (curvePt 1) ⟨1, rfl⟩
  simp [curvePt] at this


/-! ### Irreducibility of `y² - xz` -/

omit [IsAlgClosed k] in
/-- A variable of `k[x,y,z]` is irreducible (it has total degree one and primitive coefficients). -/
lemma irreducible_X (i : Fin 3) : Irreducible (MvPolynomial.X i : MvPolynomial (Fin 3) k) := by
  refine MvPolynomial.irreducible_of_totalDegree_eq_one ?_ ?_
  · simp
  · intro x hx
    exact isUnit_of_dvd_one (by simpa using hx (Finsupp.single i 1))

omit [IsAlgClosed k] in
/-- `X i` does not divide a positive power of `X j` for `i ≠ j`. -/
lemma not_dvd_X_pow {i j : Fin 3} (hij : i ≠ j) (n : ℕ) :
    ¬ ((MvPolynomial.X i : MvPolynomial (Fin 3) k) ∣ (MvPolynomial.X j) ^ n) := by
  rintro ⟨d, hd⟩
  have h := congrArg (MvPolynomial.eval (fun t : Fin 3 => if t = j then (1 : k) else 0)) hd
  have hPXj : MvPolynomial.eval (fun t : Fin 3 => if t = j then (1 : k) else 0)
      (MvPolynomial.X j ^ n) = 1 := by simp
  have hPXi : MvPolynomial.eval (fun t : Fin 3 => if t = j then (1 : k) else 0)
      (MvPolynomial.X i) = 0 := by simp [hij]
  rw [map_mul, hPXj, hPXi, zero_mul] at h
  exact one_ne_zero h

omit [IsAlgClosed k] in
/-- `X 0` and `X 1 ^ 2` have no common divisor other than units. -/
lemma isRelPrime_X_zero_X_one_sq :
    IsRelPrime (MvPolynomial.X 0 : MvPolynomial (Fin 3) k) ((MvPolynomial.X 1) ^ 2) := by
  rw [UniqueFactorizationMonoid.isRelPrime_iff_no_prime_factors (MvPolynomial.X_ne_zero 0)]
  intro d hd1 hd2 hdprime
  rcases (irreducible_X (k := k) 0).dvd_iff.mp hd1 with hu | hassoc
  · exact hdprime.not_isUnit hu
  · obtain ⟨u, hu⟩ := hassoc
    obtain ⟨e, he⟩ := hd2
    refine not_dvd_X_pow (k := k) (i := 0) (j := 1) (by decide) 2 ⟨u * e, ?_⟩
    rw [he, ← hu]
    ring

omit [IsAlgClosed k] in
/-- `y² - xz` is irreducible in `k[x,y,z]`. -/
lemma irreducible_y_sq_sub_x_mul_z :
    Irreducible (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2
      : MvPolynomial (Fin 3) k) := by
  have h : Irreducible ((-MvPolynomial.X 0) * MvPolynomial.X 2 + MvPolynomial.X 1 ^ 2
      : MvPolynomial (Fin 3) k) := by
    refine MvPolynomial.irreducible_mul_X_add (-MvPolynomial.X 0) (MvPolynomial.X 1 ^ 2) 2
      ?_ ?_ ?_ ?_
    · simp
    · simp [MvPolynomial.vars_neg]
    · intro hmem
      have hsub := MvPolynomial.vars_pow (MvPolynomial.X 1 : MvPolynomial (Fin 3) k) 2
      exact absurd (hsub hmem) (by simp)
    · exact isRelPrime_X_zero_X_one_sq.neg_left
  convert h using 2
  ring

omit [IsAlgClosed k] in
/-- `y² - xz` is prime. -/
lemma prime_y_sq_sub_x_mul_z :
    Prime (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2
      : MvPolynomial (Fin 3) k) :=
  UniqueFactorizationMonoid.irreducible_iff_prime.mp irreducible_y_sq_sub_x_mul_z

omit [IsAlgClosed k] in
lemma y_sq_sub_x_mul_z_ne_zero :
    (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2 : MvPolynomial (Fin 3) k) ≠ 0 := by
  intro h
  have h' := congrArg (MvPolynomial.eval (![(1 : k), 1, 0] : Fin 3 → k)) h
  simp at h'

omit [IsAlgClosed k] in
/-- The principal prime ideal `(y² - xz)`. -/
instance span_y_sq_sub_x_mul_z_isPrime :
    (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
      : Ideal (MvPolynomial (Fin 3) k)).IsPrime :=
  Ideal.span_singleton_prime y_sq_sub_x_mul_z_ne_zero |>.mpr prime_y_sq_sub_x_mul_z

/-- `(y² - xz) ⊊ I(Y)`: the curve does not lie in the cone `y² = xz` only. -/
lemma span_y_sq_sub_x_mul_z_lt_IY :
    (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
      : Ideal (MvPolynomial (Fin 3) k)) < IY (k := k) := by
  have hle : (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
      : Ideal (MvPolynomial (Fin 3) k)) ≤ IY (k := k) := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact y_sq_sub_x_mul_z_mem
  refine lt_of_le_of_ne hle (fun heq => ?_)
  have hmem : (MvPolynomial.X 0 ^ 3 - MvPolynomial.X 1 * MvPolynomial.X 2
      : MvPolynomial (Fin 3) k) ∈
      Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2} := by
    rw [heq]; exact x_cu_sub_y_mul_z_mem
  rw [Ideal.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  -- substitute `x ↦ s²`, `y ↦ st`, `z ↦ t²`
  set ψ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (![MvPolynomial.X 0 ^ 2, MvPolynomial.X 0 * MvPolynomial.X 1, MvPolynomial.X 1 ^ 2]
        : Fin 3 → MvPolynomial (Fin 2) k)
  have h1 : ψ (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2) = 0 := by
    simp [ψ]; ring
  have h2 : ψ (MvPolynomial.X 0 ^ 3 - MvPolynomial.X 1 * MvPolynomial.X 2)
      = MvPolynomial.X 0 ^ 6 - MvPolynomial.X 0 * MvPolynomial.X 1 ^ 3 := by
    simp [ψ]; ring
  have h3 := congrArg ψ hc
  rw [map_mul, h1, zero_mul, h2] at h3
  have h4 := congrArg (MvPolynomial.eval (![(1 : k), 0] : Fin 2 → k)) h3
  simp at h4

/-- The height of `I(Y)` is at least `2`. -/
theorem two_le_height : 2 ≤ (IY (k := k)).height := by
  have hlt : (⊥ : Ideal (MvPolynomial (Fin 3) k)) <
      Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2} := by
    rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
    exact y_sq_sub_x_mul_z_ne_zero
  have h1 : (⊥ : Ideal (MvPolynomial (Fin 3) k)).height + 1
      ≤ (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
        : Ideal (MvPolynomial (Fin 3) k)).height :=
    Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have h2 : (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
      : Ideal (MvPolynomial (Fin 3) k)).height + 1 ≤ (IY (k := k)).height :=
    Ideal.height_add_one_le_of_lt_of_isPrime span_y_sq_sub_x_mul_z_lt_IY
  rw [Ideal.height_bot, zero_add] at h1
  calc (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ (Ideal.span {MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2}
        : Ideal (MvPolynomial (Fin 3) k)).height + 1 := add_le_add h1 le_rfl
    _ ≤ (IY (k := k)).height := h2


/-! ### Height upper bound: localize in the `z`-variable -/

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- `k[x,y,z]` as a polynomial ring in `x`, `y` over `k[z]`. -/
noncomputable def e :
    MvPolynomial (Fin 3) k ≃ₐ[k] MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k) :=
  (MvPolynomial.renameEquiv k (finSumFinEquiv (m := 2) (n := 1)).symm).trans
    (MvPolynomial.sumAlgEquiv k (Fin 2) (Fin 1))

omit [IsAlgClosed k] in
lemma e_X_zero : e (k := k) (MvPolynomial.X 0) = MvPolynomial.X 0 := by
  have h : (finSumFinEquiv (m := 2) (n := 1)).symm (0 : Fin 3) = Sum.inl 0 := by
    rw [Equiv.symm_apply_eq, finSumFinEquiv_apply_left]; rfl
  simp only [e, AlgEquiv.trans_apply, MvPolynomial.renameEquiv_apply, h, MvPolynomial.rename_X,
    MvPolynomial.sumAlgEquiv_X_inl]

omit [IsAlgClosed k] in
lemma e_X_one : e (k := k) (MvPolynomial.X 1) = MvPolynomial.X 1 := by
  have h : (finSumFinEquiv (m := 2) (n := 1)).symm (1 : Fin 3) = Sum.inl 1 := by
    rw [Equiv.symm_apply_eq, finSumFinEquiv_apply_left]; rfl
  simp only [e, AlgEquiv.trans_apply, MvPolynomial.renameEquiv_apply, h, MvPolynomial.rename_X,
    MvPolynomial.sumAlgEquiv_X_inl]

omit [IsAlgClosed k] in
lemma e_X_two : e (k := k) (MvPolynomial.X 2)
    = MvPolynomial.C (MvPolynomial.X 0) := by
  have h : (finSumFinEquiv (m := 2) (n := 1)).symm (2 : Fin 3) = Sum.inr 0 := by
    rw [Equiv.symm_apply_eq, finSumFinEquiv_apply_right]; rfl
  simp only [e, AlgEquiv.trans_apply, MvPolynomial.renameEquiv_apply, h, MvPolynomial.rename_X,
    MvPolynomial.sumAlgEquiv_X_inr]

omit [IsAlgClosed k] in
/-- The inverse of `e` sends the base variable to `z = X 2`. -/
lemma e_symm_C (q : MvPolynomial (Fin 1) k) :
    (e (k := k)).symm (MvPolynomial.C q)
      = MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)) q := by
  have h1 : (e (k := k)).symm (MvPolynomial.C (MvPolynomial.X 0)) = MvPolynomial.X 2 := by
    rw [← e_X_two]; simp
  have h2 : ((e (k := k)).symm : MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k) →+*
        MvPolynomial (Fin 3) k).comp
      (MvPolynomial.C : MvPolynomial (Fin 1) k →+*
        MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))
      = MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)) := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simpa [MvPolynomial.algebraMap_eq] using (e (k := k)).symm.commutes a
    · fin_cases i
      simpa using h1
  exact RingHom.congr_fun h2 q

omit [IsAlgClosed k] in
/-- The map `k[z] → k[t]`, `z ↦ t⁵`, factored through `k[X]`. -/
lemma param_rename_two (q : MvPolynomial (Fin 1) k) :
    paramAlgHom (k := k) (MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)) q)
      = Polynomial.expand k 5
        (MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k)) q) := by
  have h : (paramAlgHom (k := k)).comp
        (MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)))
      = (Polynomial.expand k 5).comp
        (MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k))) := by
    refine MvPolynomial.algHom_ext (fun i => ?_)
    fin_cases i
    simp [paramAlgHom, Polynomial.expand_eq_comp_X_pow]
  exact DFunLike.congr_fun h q

omit [IsAlgClosed k] in
/-- `q ↦ q(X)` from `k[X]` to `k[X]` is injective. -/
lemma aeval_polynomial_X_injective :
    Function.Injective
      (MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k))
        : MvPolynomial (Fin 1) k →ₐ[k] Polynomial k) := by
  intro q q' h
  have hτ : ∀ p : MvPolynomial (Fin 1) k,
      Polynomial.eval₂RingHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k) (MvPolynomial.X 0)
        (MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k)) p) = p := by
    intro p
    have hcomp : (Polynomial.eval₂RingHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)
          (MvPolynomial.X 0)).comp
        (MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k))).toRingHom
        = RingHom.id (MvPolynomial (Fin 1) k) := by
      refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
      · simp
      · fin_cases i; simp
    exact RingHom.congr_fun hcomp p
  rw [← hτ q, h, hτ q']

omit [IsAlgClosed k] in
/-- A nonzero polynomial in `z` does not vanish identically on the curve. -/
lemma param_rename_two_ne_zero {q : MvPolynomial (Fin 1) k} (hq : q ≠ 0) :
    paramAlgHom (k := k) (MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)) q) ≠ 0 := by
  rw [param_rename_two]
  intro h
  have h1 : MvPolynomial.aeval (R := k) (fun _ : Fin 1 => (Polynomial.X : Polynomial k)) q = 0 := by
    by_contra h2
    refine h2 (Polynomial.expand_injective (R := k) (n := 5) (by norm_num) ?_)
    rw [h, map_zero]
  refine hq (aeval_polynomial_X_injective ?_)
  rw [h1, map_zero]

omit [IsAlgClosed k] in
/-- No nonzero polynomial in `z` lies in `I(Y)`: `k[z] → A(Y)` is injective. -/
lemma under_IY_map_e :
    ((IY (k := k)).map (e (k := k)).toRingEquiv).under (MvPolynomial (Fin 1) k) = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro q hq
  rw [Ideal.mem_bot]
  by_contra hq0
  have hmem : MvPolynomial.C q ∈ (IY (k := k)).map (e (k := k)).toRingEquiv := hq
  have he : e (k := k) (MvPolynomial.rename (R := k) (fun _ : Fin 1 => (2 : Fin 3)) q)
      = MvPolynomial.C q := by
    rw [← e_symm_C]
    simp
  rw [← he] at hmem
  exact param_rename_two_ne_zero hq0 ((Ideal.apply_mem_of_equiv_iff).mp hmem)

omit [IsAlgClosed k] in
lemma ringKrullDim_base_localization :
    ringKrullDim (MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k))) = 2 := by
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing]
  simp

omit [IsAlgClosed k] in
set_option maxHeartbeats 2000000 in
/-- The height of `I(Y)` is at most `2`. -/
theorem height_le_two : (IY (k := k)).height ≤ 2 := by
  have hdisj : Disjoint
      (((nonZeroDivisors (MvPolynomial (Fin 1) k)).map (MvPolynomial.C (σ := Fin 2)))
        : Set (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k)))
      (((IY (k := k)).map (e (k := k)).toRingEquiv)
        : Set (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))) := by
    rw [Set.disjoint_left]
    intro x hx hxI
    obtain ⟨q, hq, rfl⟩ := hx
    have hthis : q ∈ (((IY (k := k)).map (e (k := k)).toRingEquiv)).under
        (MvPolynomial (Fin 1) k) := by
      simpa [Ideal.under, MvPolynomial.algebraMap_eq] using hxI
    rw [under_IY_map_e] at hthis
    exact (mem_nonZeroDivisors_iff_ne_zero.mp hq) (by simpa using hthis)
  have hne : ((IY (k := k)).map (e (k := k)).toRingEquiv).map
      (algebraMap (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))
        (MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k)))) ≠ ⊤ :=
    (IsLocalization.map_algebraMap_ne_top_iff_disjoint
      (M := (nonZeroDivisors (MvPolynomial (Fin 1) k)).map (MvPolynomial.C (σ := Fin 2)))
      (S := MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k)))
      (I := (IY (k := k)).map (e (k := k)).toRingEquiv)).mpr hdisj
  have h1 : ((IY (k := k)).map (e (k := k)).toRingEquiv).height
      = (IY (k := k)).height :=
    RingEquiv.height_map (R := MvPolynomial (Fin 3) k)
      (S := MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))
      (e (k := k)).toRingEquiv (IY (k := k))
  set J : Ideal (MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k))) :=
    ((IY (k := k)).map (e (k := k)).toRingEquiv).map
      (algebraMap (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))
        (MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k)))) with hJ
  have step1 : ((IY (k := k)).map (e (k := k)).toRingEquiv).height
      ≤ (J.under (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))).height :=
    Ideal.height_mono Ideal.le_comap_map
  have step2 : (J.under (MvPolynomial (Fin 2) (MvPolynomial (Fin 1) k))).height = J.height :=
    IsLocalization.height_under
      ((nonZeroDivisors (MvPolynomial (Fin 1) k)).map (MvPolynomial.C (σ := Fin 2))) J
  have step3 : J.height ≤ 2 := by
    refine WithBot.coe_le_coe.mp ?_
    calc ((↑J.height) : WithBot ℕ∞)
        ≤ ringKrullDim (MvPolynomial (Fin 2) (FractionRing (MvPolynomial (Fin 1) k))) :=
          Ideal.height_le_ringKrullDim_of_ne_top hne
      _ = ((2 : ℕ∞) : WithBot ℕ∞) := by rw [ringKrullDim_base_localization]; rfl
  have h2 : ((IY (k := k)).map (e (k := k)).toRingEquiv).height ≤ 2 :=
    step1.trans (step2.trans_le step3)
  rwa [h1] at h2

/-- The height of `I(Y)` is `2`. -/
theorem height_eq_two : (IY (k := k)).height = 2 :=
  le_antisymm height_le_two two_le_height

end AlgClosed

/-! ### The weights `3, 4, 5`: the constant and linear parts of `I(Y)` vanish

The parameterization `x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵` assigns to the monomial with exponent
vector `d` the degree `wdeg d = 3 * d 0 + 4 * d 1 + 5 * d 2` in `t`.  For `f ∈ I(Y)` the
substituted polynomial `f(t³,t⁴,t⁵)` vanishes, so all of its coefficients vanish.  The
monomials of ordinary degree at most one have distinct weights `0, 3, 4, 5`, while every
monomial of ordinary degree at least two has weight at least `6`; hence the constant and the
linear coefficients of `f` vanish separately, i.e. `f ∈ 𝔪²` for `𝔪 = (x,y,z)`. -/

/-- The weights of the parameterization `x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵`. -/
def wt : Fin 3 → ℕ := ![3, 4, 5]

@[simp] lemma wt_zero : wt 0 = 3 := rfl
@[simp] lemma wt_one : wt 1 = 4 := rfl
@[simp] lemma wt_two : wt 2 = 5 := rfl

/-- The degree in `t` of the monomial with exponent vector `d` after substituting
`x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵`. -/
def wdeg (d : Fin 3 →₀ ℕ) : ℕ := ∑ i, wt i * d i

@[simp] lemma wdeg_zero : wdeg 0 = 0 := by simp [wdeg]

@[simp] lemma wdeg_single_zero : wdeg (Finsupp.single 0 1) = 3 := by
  simp [wdeg, Fin.sum_univ_three]

@[simp] lemma wdeg_single_one : wdeg (Finsupp.single 1 1) = 4 := by
  simp [wdeg, Fin.sum_univ_three]

@[simp] lemma wdeg_single_two : wdeg (Finsupp.single 2 1) = 5 := by
  simp [wdeg, Fin.sum_univ_three]

/-- Every monomial of ordinary degree `n` has substituted degree at least `3 * n`. -/
lemma three_mul_degree_le_wdeg (d : Fin 3 →₀ ℕ) : 3 * d.degree ≤ wdeg d := by
  rw [Finsupp.degree_eq_sum, wdeg, Fin.sum_univ_three, Fin.sum_univ_three]
  simp only [wt_zero, wt_one, wt_two]
  have h1 : 0 ≤ d 0 := Nat.zero_le _
  have h2 : 0 ≤ d 1 := Nat.zero_le _
  have h3 : 0 ≤ d 2 := Nat.zero_le _
  omega

/-- Every monomial of ordinary degree `n` has substituted degree at most `5 * n`. -/
lemma wdeg_le_five_mul_degree (d : Fin 3 →₀ ℕ) : wdeg d ≤ 5 * d.degree := by
  rw [Finsupp.degree_eq_sum, wdeg, Fin.sum_univ_three, Fin.sum_univ_three]
  simp only [wt_zero, wt_one, wt_two]
  have h1 : 0 ≤ d 0 := Nat.zero_le _
  have h2 : 0 ≤ d 1 := Nat.zero_le _
  have h3 : 0 ≤ d 2 := Nat.zero_le _
  omega

/-- The parameterization, as a vector of polynomials: `x ↦ t³`, `y ↦ t⁴`, `z ↦ t⁵`. -/
def paramVec : Fin 3 → Polynomial k := fun i => Polynomial.X ^ wt i

lemma paramAlgHom_eq_aeval : paramAlgHom (k := k) = MvPolynomial.aeval (paramVec (k := k)) := by
  rw [paramAlgHom]
  congr 1
  funext i
  fin_cases i <;> simp [paramVec]

lemma prod_paramVec (d : Fin 3 →₀ ℕ) :
    d.prod (fun i n => paramVec (k := k) i ^ n) = Polynomial.X ^ wdeg d := by
  have h := Finsupp.prod_of_support_subset (f := d) (s := Finset.univ) (Finset.subset_univ _)
    (g := fun i n => paramVec (k := k) i ^ n) (by intro i _; simp)
  rw [h, wdeg]
  simp only [paramVec, ← pow_mul]
  rw [Finset.prod_pow_eq_pow_sum]

lemma paramAlgHom_monomial (d : Fin 3 →₀ ℕ) (a : k) :
    paramAlgHom (k := k) (MvPolynomial.monomial d a) = Polynomial.C a * Polynomial.X ^ wdeg d := by
  rw [paramAlgHom_eq_aeval, MvPolynomial.aeval_monomial, prod_paramVec]
  simp

/-- The coefficient of `t^n` in the substituted polynomial, as a sum over the support. -/
lemma coeff_paramAlgHom (f : MvPolynomial (Fin 3) k) (n : ℕ) :
    (paramAlgHom (k := k) f).coeff n
      = ∑ d ∈ f.support, if wdeg d = n then f.coeff d else 0 := by
  conv_lhs => rw [MvPolynomial.as_sum f]
  rw [map_sum, ← Polynomial.lcoeff_apply, map_sum]
  refine Finset.sum_congr rfl (fun d _ => ?_)
  rw [Polynomial.lcoeff_apply, paramAlgHom_monomial, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
  by_cases h : n = wdeg d
  · subst h; simp
  · have h' : ¬ (wdeg d = n) := fun hh => h hh.symm
    simp [h, h']

/-- The exponent vectors of total degree at most one are `0`, `x`, `y`, `z`. -/
lemma degree_le_one_cases {d : Fin 3 →₀ ℕ} (hd : d.degree ≤ 1) :
    d = 0 ∨ d = Finsupp.single 0 1 ∨ d = Finsupp.single 1 1 ∨ d = Finsupp.single 2 1 := by
  have hsum : d 0 + d 1 + d 2 ≤ 1 := by
    rw [Finsupp.degree_eq_sum, Fin.sum_univ_three] at hd
    exact hd
  have h0 : d 0 = 0 ∨ d 0 = 1 := by omega
  have h1 : d 1 = 0 ∨ d 1 = 1 := by omega
  have h2 : d 2 = 0 ∨ d 2 = 1 := by omega
  rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2
  · left
    refine Finsupp.ext fun i => ?_
    fin_cases i <;> simp_all
  · right; right; right
    refine Finsupp.ext fun i => ?_
    fin_cases i <;> simp_all
  · right; right; left
    refine Finsupp.ext fun i => ?_
    fin_cases i <;> simp_all
  · omega
  · right; left
    refine Finsupp.ext fun i => ?_
    fin_cases i <;> simp_all
  · omega
  · omega
  · omega

/-- Among exponent vectors of total degree at most one the substituted degree determines the
monomial: the weights of `0`, `x`, `y`, `z` are `0, 3, 4, 5`. -/
lemma eq_of_wdeg_eq {d e : Fin 3 →₀ ℕ} (hd : d.degree ≤ 1) (he : e.degree ≤ 1)
    (h : wdeg e = wdeg d) : e = d := by
  rcases degree_le_one_cases hd with h1 | h1 | h1 | h1 <;>
    rcases degree_le_one_cases he with h2 | h2 | h2 | h2 <;>
      simp_all

/-- **Constant and linear coefficients of `I(Y)` vanish.**  If `f ∈ I(Y)` then the coefficient
of every monomial of total degree at most one is zero. -/
lemma coeff_eq_zero_of_mem_IY {f : MvPolynomial (Fin 3) k} (hf : f ∈ IY (k := k))
    {d : Fin 3 →₀ ℕ} (hd : d.degree ≤ 1) : f.coeff d = 0 := by
  have hpar : paramAlgHom (k := k) f = 0 := hf
  have hcoeff : (paramAlgHom (k := k) f).coeff (wdeg d) = 0 := by rw [hpar]; simp
  rw [coeff_paramAlgHom] at hcoeff
  have hlow : ∀ e : Fin 3 →₀ ℕ, wdeg e = wdeg d → e = d := by
    intro e he
    have hw : wdeg e ≤ 5 * d.degree := by rw [he]; exact wdeg_le_five_mul_degree d
    have h3 : 3 * e.degree ≤ 5 * d.degree := le_trans (three_mul_degree_le_wdeg e) hw
    have he1 : e.degree ≤ 1 := by omega
    exact eq_of_wdeg_eq hd he1 he
  have hsingle : ∑ e ∈ f.support, (if wdeg e = wdeg d then f.coeff e else 0)
      = if wdeg d = wdeg d then f.coeff d else 0 :=
    Finset.sum_eq_single d
      (fun e _ hed => by
        rw [if_neg (fun hw => hed (hlow e hw))])
      (fun hd' => by rw [if_pos rfl, MvPolynomial.notMem_support_iff.mp hd'])
  rw [hsingle] at hcoeff
  simpa using hcoeff

/-- **`I(Y)` is contained in `𝔪²`**, where `𝔪 = (x,y,z)` is the maximal ideal of the origin. -/
theorem IY_le_sq : IY (k := k) ≤ MvPolynomial.idealOfVars (Fin 3) k ^ 2 := by
  intro f hf
  rw [MvPolynomial.mem_pow_idealOfVars_iff']
  intro d hd
  exact coeff_eq_zero_of_mem_IY hf (by omega)

/-- **`𝔪 · I(Y) ⊆ 𝔪³`**: the product of the maximal ideal of the origin with `I(Y)` lies in the
third power of `𝔪`. -/
theorem mul_IY_le_cube :
    MvPolynomial.idealOfVars (Fin 3) k * IY (k := k)
      ≤ MvPolynomial.idealOfVars (Fin 3) k ^ 3 := by
  refine le_trans (Ideal.mul_mono_right (I := MvPolynomial.idealOfVars (Fin 3) k) IY_le_sq) ?_
  rw [← pow_succ']

/-! ### The three relations `y² - xz`, `yz - x³`, `z² - x²y` and their independence modulo `𝔪 · I(Y)` -/

/-- The relation `q₁ = y² - xz` among the generators of the parametrized curve. -/
def q1 : MvPolynomial (Fin 3) k := MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2

/-- The relation `q₂ = yz - x³` among the generators of the parametrized curve. -/
def q2 : MvPolynomial (Fin 3) k := MvPolynomial.X 1 * MvPolynomial.X 2 - MvPolynomial.X 0 ^ 3

/-- The relation `q₃ = z² - x²y` among the generators of the parametrized curve. -/
def q3 : MvPolynomial (Fin 3) k := MvPolynomial.X 2 ^ 2 - MvPolynomial.X 0 ^ 2 * MvPolynomial.X 1

lemma q1_mem : q1 (k := k) ∈ IY (k := k) := by
  have h : paramAlgHom (k := k) (q1 (k := k)) = 0 := by
    simp only [q1, map_sub, map_pow, map_mul, paramAlgHom_X_zero, paramAlgHom_X_one,
      paramAlgHom_X_two]
    ring
  exact h

lemma q2_mem : q2 (k := k) ∈ IY (k := k) := by
  have h : paramAlgHom (k := k) (q2 (k := k)) = 0 := by
    simp only [q2, map_sub, map_pow, map_mul, paramAlgHom_X_zero, paramAlgHom_X_one,
      paramAlgHom_X_two]
    ring
  exact h

lemma q3_mem : q3 (k := k) ∈ IY (k := k) := by
  have h : paramAlgHom (k := k) (q3 (k := k)) = 0 := by
    simp only [q3, map_sub, map_pow, map_mul, paramAlgHom_X_zero, paramAlgHom_X_one,
      paramAlgHom_X_two]
    ring
  exact h

/-- The three relations, bundled as a family indexed by `Fin 3`. -/
def qfun : Fin 3 → MvPolynomial (Fin 3) k := ![q1, q2, q3]

@[simp] lemma qfun_zero : qfun (k := k) 0 = q1 := rfl

@[simp] lemma qfun_one : qfun (k := k) 1 = q2 := rfl

@[simp] lemma qfun_two : qfun (k := k) 2 = q3 := rfl

lemma qfun_mem (i : Fin 3) : qfun (k := k) i ∈ IY (k := k) := by
  fin_cases i
  · simpa using q1_mem (k := k)
  · simpa using q2_mem (k := k)
  · simpa using q3_mem (k := k)

lemma sum_smul_qfun (c : Fin 3 → k) :
    (∑ i, c i • qfun (k := k) i) = c 0 • q1 (k := k) + c 1 • q2 (k := k) + c 2 • q3 (k := k) := by
  rw [Fin.sum_univ_three]
  simp

lemma homogeneousComponent_two_q1 :
    MvPolynomial.homogeneousComponent 2 (q1 (k := k))
      = MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2 := by
  rw [q1, map_sub]
  rw [MvPolynomial.homogeneousComponent_eq_self
      ((MvPolynomial.isHomogeneous_X k 1).pow 2),
    MvPolynomial.homogeneousComponent_eq_self
      ((MvPolynomial.isHomogeneous_X k 0).mul (MvPolynomial.isHomogeneous_X k 2))]

lemma homogeneousComponent_two_q2 :
    MvPolynomial.homogeneousComponent 2 (q2 (k := k))
      = MvPolynomial.X 1 * MvPolynomial.X 2 := by
  rw [q2, map_sub]
  rw [MvPolynomial.homogeneousComponent_eq_self
      ((MvPolynomial.isHomogeneous_X k 1).mul (MvPolynomial.isHomogeneous_X k 2)),
    MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.isHomogeneous_X k 0).pow 3)]
  norm_num

lemma homogeneousComponent_two_q3 :
    MvPolynomial.homogeneousComponent 2 (q3 (k := k)) = MvPolynomial.X 2 ^ 2 := by
  rw [q3, map_sub]
  rw [MvPolynomial.homogeneousComponent_eq_self ((MvPolynomial.isHomogeneous_X k 2).pow 2),
    MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.isHomogeneous_X k 0).pow 2 |>.mul (MvPolynomial.isHomogeneous_X k 1))]
  norm_num

/-- The degree-two part of a `k`-linear combination of `q₁, q₂, q₃` is the corresponding
`k`-linear combination of `y² - xz`, `yz`, `z²`. -/
lemma homogeneousComponent_two_sum (c : Fin 3 → k) :
    MvPolynomial.homogeneousComponent 2
      (c 0 • q1 (k := k) + c 1 • q2 (k := k) + c 2 • q3 (k := k))
      = c 0 • (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2)
        + c 1 • (MvPolynomial.X 1 * MvPolynomial.X 2) + c 2 • (MvPolynomial.X 2 ^ 2) := by
  simp only [map_add, map_smul, homogeneousComponent_two_q1, homogeneousComponent_two_q2,
    homogeneousComponent_two_q3]

/-- The quadratic forms `y² - xz`, `yz`, `z²` are `k`-linearly independent. -/
lemma eq_zero_of_smul_quadratic {c : Fin 3 → k}
    (h : c 0 • (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2 :
          MvPolynomial (Fin 3) k)
        + c 1 • (MvPolynomial.X 1 * MvPolynomial.X 2) + c 2 • (MvPolynomial.X 2 ^ 2) = 0) :
    c = 0 := by
  have hc0 : c 0 = 0 := by
    have h' := congrArg (MvPolynomial.eval (![(0 : k), 1, 0] : Fin 3 → k)) h
    simpa [MvPolynomial.smul_eq_C_mul] using h'
  have hc2 : c 2 = 0 := by
    have h' := congrArg (MvPolynomial.eval (![(0 : k), 0, 1] : Fin 3 → k)) h
    simpa [MvPolynomial.smul_eq_C_mul] using h'
  have hc1 : c 1 = 0 := by
    have h' := congrArg (MvPolynomial.eval (![(0 : k), 1, 1] : Fin 3 → k)) h
    simpa [MvPolynomial.smul_eq_C_mul, hc0, hc2] using h'
  funext i
  fin_cases i
  · simpa using hc0
  · simpa using hc1
  · simpa using hc2

/-- The degree-two part of any element of `𝔪³` vanishes. -/
lemma homogeneousComponent_two_eq_zero_of_mem_cube {p : MvPolynomial (Fin 3) k}
    (hp : p ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 3) :
    MvPolynomial.homogeneousComponent 2 p = 0 := by
  rw [MvPolynomial.mem_pow_idealOfVars_iff] at hp
  refine MvPolynomial.homogeneousComponent_eq_zero' 2 p (fun d hd => ?_)
  have h3 : 3 ≤ d.degree := hp d hd
  omega

/-- **The classes of `q₁, q₂, q₃` in `k[x,y,z] ⧸ 𝔪³` are `k`-linearly independent.**  A `k`-linear
combination of the three relations lies in `𝔪³` only if it is zero. -/
theorem qsum_mem_cube_iff (c : Fin 3 → k) :
    (∑ i, c i • qfun (k := k) i) ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 3 ↔ c = 0 := by
  refine ⟨fun hmem => ?_, fun hc => by rw [hc]; simp⟩
  have hz : MvPolynomial.homogeneousComponent 2 (∑ i, c i • qfun (k := k) i) = 0 :=
    homogeneousComponent_two_eq_zero_of_mem_cube hmem
  rw [sum_smul_qfun, homogeneousComponent_two_sum (k := k)] at hz
  exact eq_zero_of_smul_quadratic hz

/-- **No nontrivial `k`-linear combination of `q₁, q₂, q₃` lies in `𝔪 · I(Y)`**; equivalently the
classes of `q₁, q₂, q₃` in `I(Y) ⧸ (𝔪 · I(Y))` are `k`-linearly independent. -/
theorem qsum_mem_mul_IY_iff (c : Fin 3 → k) :
    (∑ i, c i • qfun (k := k) i) ∈ MvPolynomial.idealOfVars (Fin 3) k * IY (k := k) ↔ c = 0 := by
  refine ⟨fun hmem => (qsum_mem_cube_iff c).mp (mul_IY_le_cube hmem), fun hc => ?_⟩
  rw [hc]
  simp

/-- The classes of `q₁, q₂, q₃` in `k[x,y,z] ⧸ 𝔪³` are `k`-linearly independent. -/
theorem linearIndependent_qfun_mod_cube :
    LinearIndependent k (fun i : Fin 3 =>
      (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin 3) k ^ 3)) (qfun (k := k) i)) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc
  have h1 : (Ideal.Quotient.mkₐ k (MvPolynomial.idealOfVars (Fin 3) k ^ 3))
      (∑ i, c i • qfun (k := k) i) = 0 := by
    rw [map_sum]
    simpa using hc
  have hmem : (∑ i, c i • qfun (k := k) i) ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 3 := by
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    exact h1
  have hc0 : c = 0 := (qsum_mem_cube_iff c).mp hmem
  subst hc0
  simp

/-! ### `I(Y)` cannot be generated by two elements

Let `𝔪 = (x,y,z)` be the maximal ideal of the origin and work in the quotient ring
`k[x,y,z] ⧸ 𝔪³`.  Since `𝔪 · I(Y) ⊆ 𝔪³`, the classes of `q₁, q₂, q₃` in this quotient are a
faithful image of their classes in `I(Y) ⧸ (𝔪 · I(Y))` as far as the degree-two part is
concerned, and they stay `k`-linearly independent (`qsum_mem_cube_iff`).

The `k`-vector space `I(Y) ⧸ (𝔪 · I(Y))` is annihilated by `𝔪`: for `a ∈ 𝔪` and `x ∈ I(Y)` we
have `a · x ∈ 𝔪 · I(Y)`.  Consequently a generating set of the ideal `I(Y)` with two elements
would give a `k`-spanning set with two elements of the image in `k[x,y,z] ⧸ 𝔪³`: on `I(Y)` the
multiplication by an arbitrary `a` reduces to the multiplication by its constant term, because
the remaining part of `a` lies in `𝔪` (`sub_C_constantCoeff_mem_idealOfVars`) and `𝔪 · I(Y) ⊆ 𝔪³`
(`cubeMk_mul_eq`).  This is the Nakayama-type dimension bound used in the natural proof; the
three independent classes then contradict the bound `2`.

No minimal generating family (and hence no induction on the number of generators) is needed:
the hypothesis `I(Y) = (f, g)` is converted directly into a two-element `k`-spanning set of the
image of `I(Y)` in `k[x,y,z] ⧸ 𝔪³`.  Note also that we never claim that `q₁, q₂, q₃` generate
`I(Y)` globally (they do not); only their `k`-linear independence modulo `𝔪 · I(Y)` is used. -/

/-- The third power `𝔪³` of the maximal ideal `𝔪 = (x,y,z)` of the origin. -/
abbrev mcub : Ideal (MvPolynomial (Fin 3) k) := MvPolynomial.idealOfVars (Fin 3) k ^ 3

/-- The quotient map `k[x,y,z] → k[x,y,z] ⧸ 𝔪³`. -/
def cubeMk : MvPolynomial (Fin 3) k →ₐ[k] (MvPolynomial (Fin 3) k ⧸ mcub (k := k)) :=
  Ideal.Quotient.mkₐ k (mcub (k := k))

lemma cubeMk_eq_mk (x : MvPolynomial (Fin 3) k) :
    cubeMk (k := k) x = Ideal.Quotient.mk (mcub (k := k)) x := rfl

lemma cubeMk_eq_zero_iff (x : MvPolynomial (Fin 3) k) :
    cubeMk (k := k) x = 0 ↔ x ∈ mcub (k := k) :=
  Ideal.Quotient.eq_zero_iff_mem

lemma cubeMk_C (c : k) :
    cubeMk (k := k) (MvPolynomial.C c)
      = algebraMap k (MvPolynomial (Fin 3) k ⧸ mcub (k := k)) c :=
  (cubeMk (k := k)).commutes c

/-- The non-constant part of `a` lies in the maximal ideal `𝔪 = (x,y,z)` of the origin. -/
lemma sub_C_constantCoeff_mem_idealOfVars (a : MvPolynomial (Fin 3) k) :
    a - MvPolynomial.C (MvPolynomial.constantCoeff a) ∈ MvPolynomial.idealOfVars (Fin 3) k := by
  have h := (MvPolynomial.mem_pow_idealOfVars_iff' (σ := Fin 3) (R := k) 1
    (a - MvPolynomial.C (MvPolynomial.constantCoeff a))).mpr ?_
  rwa [pow_one] at h
  intro d hd
  have hd0 : d = 0 := Finsupp.degree_eq_zero_iff d |>.mp (by omega)
  subst hd0
  rw [MvPolynomial.coeff_sub]
  have h1 : MvPolynomial.coeff (0 : Fin 3 →₀ ℕ) a = MvPolynomial.constantCoeff a := by
    rw [MvPolynomial.constantCoeff_eq]
  rw [h1]
  simp

/-- The non-constant part of `a`, multiplied by an element of `I(Y)`, lies in `𝔪³`. -/
lemma mul_sub_C_constantCoeff_mem_cube {f : MvPolynomial (Fin 3) k} (hf : f ∈ IY (k := k))
    (a : MvPolynomial (Fin 3) k) :
    f * (a - MvPolynomial.C (MvPolynomial.constantCoeff a))
      ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 3 := by
  have h2 : f ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 2 := IY_le_sq hf
  have h1 : a - MvPolynomial.C (MvPolynomial.constantCoeff a)
      ∈ MvPolynomial.idealOfVars (Fin 3) k := sub_C_constantCoeff_mem_idealOfVars a
  have hmem : f * (a - MvPolynomial.C (MvPolynomial.constantCoeff a))
      ∈ MvPolynomial.idealOfVars (Fin 3) k ^ 2 * MvPolynomial.idealOfVars (Fin 3) k :=
    Ideal.mul_mem_mul h2 h1
  rwa [pow_succ] at hmem

/-- Multiplication by the non-constant part of `r` is invisible in `k[x,y,z] ⧸ 𝔪³` on `I(Y)`. -/
lemma cubeMk_mul_eq (r x : MvPolynomial (Fin 3) k) (hx : x ∈ IY (k := k)) :
    cubeMk (k := k) (r * x) = MvPolynomial.constantCoeff r • cubeMk (k := k) x := by
  have hz : cubeMk (k := k) (r * x - MvPolynomial.C (MvPolynomial.constantCoeff r) * x) = 0 := by
    rw [cubeMk_eq_zero_iff]
    have h := mul_sub_C_constantCoeff_mem_cube hx r
    simpa [mcub, mul_sub, mul_comm] using h
  have heq : cubeMk (k := k) (r * x)
      = cubeMk (k := k) (MvPolynomial.C (MvPolynomial.constantCoeff r) * x) := by
    have h2 : cubeMk (k := k) (r * x)
        - cubeMk (k := k) (MvPolynomial.C (MvPolynomial.constantCoeff r) * x) = 0 := by
      rw [← map_sub]
      exact hz
    exact sub_eq_zero.mp h2
  rw [heq, map_mul, cubeMk_C, Algebra.smul_def]

/-- The `k`-linear map `k³ → k[x,y,z] ⧸ 𝔪³` sending the `i`-th standard basis vector to the class
of the `i`-th relation `qᵢ`. -/
def qLin : (Fin 3 → k) →ₗ[k] (MvPolynomial (Fin 3) k ⧸ mcub (k := k)) :=
  { toFun := fun c => ∑ i, c i • cubeMk (k := k) (qfun (k := k) i)
    map_add' := by
      intro a b
      simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
    map_smul' := by
      intro r a
      simp [Finset.smul_sum, smul_smul] }

@[simp] lemma qLin_apply (c : Fin 3 → k) :
    qLin (k := k) c = ∑ i, c i • cubeMk (k := k) (qfun (k := k) i) := rfl

/-- **`q₁, q₂, q₃` are `k`-linearly independent modulo `𝔪³`**, in the form needed below. -/
lemma qLin_injective : Function.Injective (qLin (k := k)) := by
  have hker : ∀ c : Fin 3 → k, qLin (k := k) c = 0 → c = 0 := by
    intro c hc
    have hsum : cubeMk (k := k) (∑ i, c i • qfun (k := k) i) = 0 := by
      rw [map_sum]
      exact hc
    exact (qsum_mem_cube_iff c).mp ((cubeMk_eq_zero_iff _).mp hsum)
  intro c c' hcc
  have h0 : c - c' = 0 := hker (c - c') (by rw [map_sub, hcc, sub_self])
  simpa using sub_eq_zero.mp h0

lemma finrank_range_qLin : Module.finrank k ↥(LinearMap.range (qLin (k := k))) = 3 := by
  rw [← LinearEquiv.finrank_eq (LinearEquiv.ofInjective (qLin (k := k)) qLin_injective)]
  exact Module.finrank_fin_fun k

/-- If `I(Y)` is generated by `f` and `g`, the range of `qLin` is contained in the span of the
two classes of `f` and `g`. -/
lemma qLin_range_le_span {f g : MvPolynomial (Fin 3) k}
    (hfg : Ideal.span {f, g} = IY (k := k)) :
    LinearMap.range (qLin (k := k))
      ≤ Submodule.span k ({cubeMk (k := k) f, cubeMk (k := k) g} :
          Set (MvPolynomial (Fin 3) k ⧸ mcub (k := k))) := by
  have hfIY : f ∈ IY (k := k) := by rw [← hfg]; exact Ideal.subset_span (by simp)
  have hgIY : g ∈ IY (k := k) := by rw [← hfg]; exact Ideal.subset_span (by simp)
  rintro _ ⟨c, rfl⟩
  have hsumIY : (∑ i, c i • qfun (k := k) i) ∈ IY (k := k) := by
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [MvPolynomial.smul_eq_C_mul]
    exact Ideal.mul_mem_left _ _ (qfun_mem i)
  have hspan : (∑ i, c i • qfun (k := k) i) ∈ Ideal.span {f, g} := by
    rw [hfg]
    exact hsumIY
  rw [Ideal.mem_span_pair] at hspan
  obtain ⟨a, b, hab⟩ := hspan
  have hq : qLin (k := k) c
      = cubeMk (k := k) (a * f) + cubeMk (k := k) (b * g) := by
    rw [qLin_apply,
      show (∑ i, c i • cubeMk (k := k) (qfun (k := k) i))
          = cubeMk (k := k) (∑ i, c i • qfun (k := k) i) from by rw [map_sum]; simp,
      ← hab, map_add]
  rw [hq, cubeMk_mul_eq a f hfIY, cubeMk_mul_eq b g hgIY]
  exact Submodule.add_mem _
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

/-- The `k`-linear map `k² → k[x,y,z] ⧸ 𝔪³` whose two basis vectors map to `v 0` and `v 1`. -/
def pairLin (v : Fin 2 → (MvPolynomial (Fin 3) k ⧸ mcub (k := k))) :
    (Fin 2 → k) →ₗ[k] (MvPolynomial (Fin 3) k ⧸ mcub (k := k)) :=
  { toFun := fun c => ∑ i, c i • v i
    map_add' := by
      intro a b
      simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
    map_smul' := by
      intro r a
      simp [smul_smul] }

@[simp] lemma pairLin_apply (v : Fin 2 → (MvPolynomial (Fin 3) k ⧸ mcub (k := k)))
    (c : Fin 2 → k) : pairLin v c = ∑ i, c i • v i := rfl

lemma pairLin_range (v : Fin 2 → (MvPolynomial (Fin 3) k ⧸ mcub (k := k))) :
    LinearMap.range (pairLin v) = Submodule.span k ({v 0, v 1} :
      Set (MvPolynomial (Fin 3) k ⧸ mcub (k := k))) := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨c, rfl⟩
    rw [pairLin_apply, Fin.sum_univ_two]
    exact Submodule.add_mem _
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
  · rw [Submodule.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · refine ⟨![1, 0], ?_⟩
      rw [pairLin_apply, Fin.sum_univ_two]
      simp
    · refine ⟨![0, 1], ?_⟩
      rw [pairLin_apply, Fin.sum_univ_two]
      simp

/-- **The span of two classes has `k`-dimension at most two.** -/
lemma finrank_span_pair_le (a b : MvPolynomial (Fin 3) k ⧸ mcub (k := k)) :
    Module.finrank k ↥(Submodule.span k ({a, b} :
      Set (MvPolynomial (Fin 3) k ⧸ mcub (k := k)))) ≤ 2 := by
  have h := LinearMap.finrank_range_le (pairLin ![a, b])
  rw [Module.finrank_fin_fun] at h
  have hrange : LinearMap.range (pairLin ![a, b])
      = Submodule.span k ({a, b} : Set (MvPolynomial (Fin 3) k ⧸ mcub (k := k))) := by
    rw [pairLin_range]
    simp
  rwa [hrange] at h

/-- **`I(Y)` is not generated by two elements**: no pair of polynomials generates `I(Y)`. -/
theorem not_two_generated :
    ¬ ∃ f g : MvPolynomial (Fin 3) k, Ideal.span {f, g} = IY (k := k) := by
  rintro ⟨f, g, hfg⟩
  have hle := qLin_range_le_span (f := f) (g := g) hfg
  have hle' : LinearMap.range (qLin (k := k))
      ≤ LinearMap.range (pairLin ![cubeMk (k := k) f, cubeMk (k := k) g]) := by
    refine le_trans hle ?_
    rw [pairLin_range]
    simp
  have h1 : Module.finrank k ↥(LinearMap.range (qLin (k := k)))
      ≤ Module.finrank k ↥(LinearMap.range (pairLin ![cubeMk (k := k) f, cubeMk (k := k) g])) :=
    Submodule.finrank_mono hle'
  have h2 : Module.finrank k
      ↥(LinearMap.range (pairLin ![cubeMk (k := k) f, cubeMk (k := k) g])) ≤ 2 := by
    have h := LinearMap.finrank_range_le (pairLin ![cubeMk (k := k) f, cubeMk (k := k) g])
    rwa [Module.finrank_fin_fun] at h
  have hfin : Module.finrank k ↥(LinearMap.range (qLin (k := k))) ≤ 2 := le_trans h1 h2
  rw [finrank_range_qLin] at hfin
  omega

/-! ### The exercise: `I(Y)` is prime of height two but is not generated by two elements -/

section Final

variable [IsAlgClosed k]

omit [IsAlgClosed k] in
/-- The three displayed relations `y² = xz`, `yz = x³`, `z² = x²y` vanish on `Y`, i.e. lie in
`I(Y)` (in the notation of the statement: `q₁ = y² - xz`, `q₂ = yz - x³`, `q₃ = z² - x²y`). -/
theorem three_relations :
    (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * MvPolynomial.X 2 : MvPolynomial (Fin 3) k)
        = q1 (k := k)
      ∧ (MvPolynomial.X 1 * MvPolynomial.X 2 - MvPolynomial.X 0 ^ 3 : MvPolynomial (Fin 3) k)
        = q2 (k := k)
      ∧ (MvPolynomial.X 2 ^ 2 - MvPolynomial.X 0 ^ 2 * MvPolynomial.X 1
          : MvPolynomial (Fin 3) k) = q3 (k := k)
      ∧ q1 (k := k) ∈ IY (k := k) ∧ q2 (k := k) ∈ IY (k := k) ∧ q3 (k := k) ∈ IY (k := k) :=
  ⟨rfl, rfl, rfl, q1_mem, q2_mem, q3_mem⟩

/-- **Hartshorne, *Algebraic Geometry* (1977), Exercise I.1.11.**

The curve `Y = {(t³, t⁴, t⁵) : t ∈ k} ⊆ A³` has vanishing ideal `I(Y)` equal to the kernel of
`k[x,y,z] → k[t]`, `(x,y,z) ↦ (t³,t⁴,t⁵)`; this ideal is prime, of height two, but is not
generated by two elements (although it contains the three relations `y² - xz`, `yz - x³`,
`z² - x²y`). -/
theorem exercise_I_1_11 :
    IY (k := k) = vanishingIdeal (curveSet (k := k))
      ∧ (IY (k := k)).IsPrime
      ∧ (IY (k := k)).height = 2
      ∧ ¬ ∃ f g : MvPolynomial (Fin 3) k, Ideal.span {f, g} = IY (k := k) :=
  ⟨IY_eq_vanishingIdeal, IY_isPrime, height_eq_two, not_two_generated⟩

end Final

end
end Hartshorne77.Ex_I_1_11

