#print axioms Hartshorne77.Ex_I_2_3.part_b
#print axioms Hartshorne77.Ex_I_2_3.part_c
#print axioms Hartshorne77.Ex_I_2_3.part_d
#print axioms Hartshorne77.Ex_I_2_3.part_e
#print axioms Hartshorne77.Ex_I_2_3.hartshorne_I_2_3

/-! ### Why the hypothesis `Z(𝔞) ≠ ∅` in (d) cannot be dropped

The irrelevant ideal `S₊ = (x₀,…,xₙ) = MvPolynomial.idealOfVars` is homogeneous, has empty
zero locus, and is a proper ideal.  Hence `I(Z(S₊)) = I(∅) = S ⊋ S₊`, while `√S₊ = S₊`
(`S₊` is maximal, being the kernel of `eval 0`).  The literal statement of (d) without the
nonemptiness hypothesis is therefore false, which is why (d) carries it.
-/

lemma I_empty : I (∅ : Set (Proj k n)) = ⊤ := by
  refine le_antisymm le_top ?_
  intro f _
  rw [mem_I_iff]
  intro P hP
  exact absurd hP (Set.notMem_empty P)

lemma Z_idealOfVars :
    Z (↑(MvPolynomial.idealOfVars (Fin (n + 1)) k) : Set (Poly k n)) = ∅ := by
  rw [MvPolynomial.idealOfVars]
  rw [Z_span]
  · refine Set.eq_empty_iff_forall_notMem.2 fun P hP => ?_
    obtain ⟨i, hi⟩ : ∃ i, P.rep i ≠ 0 := by
      by_contra h
      push Not at h
      exact P.rep_nonzero (funext h)
    have h1 : Van (MvPolynomial.X i) P := hP _ ⟨i, rfl⟩ ⟨1, MvPolynomial.isHomogeneous_X (σ := Fin (n + 1)) (R := k) i⟩
    have h2 : MvPolynomial.eval P.rep (MvPolynomial.X i) = 0 :=
      h1 P.rep P.rep_nonzero (Projectivization.mk_rep P)
    exact hi (by simpa using h2)
  · rintro _ ⟨i, rfl⟩
    exact ⟨1, MvPolynomial.isHomogeneous_X (σ := Fin (n + 1)) (R := k) i⟩

lemma one_notMem_idealOfVars : (1 : Poly k n) ∉ MvPolynomial.idealOfVars (Fin (n + 1)) k := by
  intro h
  have h1 : MvPolynomial.C (1 : k) ∈ MvPolynomial.idealOfVars (Fin (n + 1)) k ^ 1 := by
    simpa using h
  rw [MvPolynomial.C_mem_pow_idealOfVars_iff] at h1
  rcases h1 with h2 | h2
  · exact one_ne_zero h2
  · exact one_ne_zero h2

/-- The hypothesis `Z(𝔞) ≠ ∅` in part (d) is indispensable: for the irrelevant ideal `S₊`,
`Z(S₊) = ∅` and `I(Z(S₊)) = S`, while `S₊ ⊊ S` (and `√S₊ = S₊`). -/
theorem part_d_hypothesis_needed :
    Z (↑(MvPolynomial.idealOfVars (Fin (n + 1)) k) : Set (Poly k n)) = ∅ ∧
    I (Z (↑(MvPolynomial.idealOfVars (Fin (n + 1)) k) : Set (Poly k n))) = ⊤ ∧
    (1 : Poly k n) ∉ MvPolynomial.idealOfVars (Fin (n + 1)) k :=
  ⟨Z_idealOfVars, by rw [Z_idealOfVars, I_empty], one_notMem_idealOfVars⟩

#print axioms Hartshorne77.Ex_I_2_3.part_d_hypothesis_needed
