import Mathlib

/-!
# Hartshorne (1977), *Algebraic Geometry*, Exercise I.1.4

Source statement (Chapter I, §1, Exercise 1.4):

> If we identify `A²` with `A¹ × A¹` in the natural way, show that the Zariski
> topology on `A²` is not the product topology of the Zariski topologies on the
> two copies of `A¹`.

## Formalisation choices

* Following Hartshorne's definitions, `A¹` is the point set `k` and `A²` is the
  point set `k × k`; the "natural identification" `A² ≅ A¹ × A¹` is therefore the
  identity map of `k × k`, equipped below with two different topologies, `zar2 k`
  and `prodTop k`.
* `zar1 k` is the topology on `k` generated by the complements of the zero sets of
  polynomials in `k[x]`.  Its closed sets are exactly the finite subsets and the
  whole space (Hartshorne's Example 1.1.1); this is proved below.
* `zar2 k` is the topology on `k × k` generated by the complements of the zero
  sets of polynomials in `k[X₀,X₁]`.  Its closed sets are exactly the common zero
  loci `Z(T)` of sets `T` of polynomials (Hartshorne's algebraic sets), which is
  also proved below.  Note `k[x][y] ≅ k[X₀,X₁]`.
* The book works over an algebraically closed field.  The only property of `k`
  used in the argument is that `k` is infinite (a nonzero one-variable polynomial
  has finitely many roots), so the main result is proved for an arbitrary
  infinite field.  Infiniteness cannot be dropped: over a finite field both
  topologies are discrete.  The book's version is recovered as a corollary at
  the end.

## Proof route

1. The projections `A¹ × A¹ → A¹` are Zariski continuous (pull back a one-variable
   polynomial to a two-variable one), hence the Zariski topology on `A²` is finer
   than the product topology: `zar2 k ≤ prodTop k` (smaller means finer in
   Mathlib's order on topologies).
2. The diagonal `Δ = {(a,a) | a ∈ k}` is Zariski closed in `A²`, being the zero
   locus of `X₁ - X₀`.
3. `Δ` is not closed in the product topology.  If it were, the point `(0,1) ∉ Δ`
   would have a product-basic open neighbourhood `U × V` disjoint from `Δ`.  But
   nonempty Zariski open subsets of `A¹` are cofinite, and `k` is infinite, so
   `U ∩ V ≠ ∅`, giving a point of `Δ` inside `U × V`: contradiction.
4. Hence `zar2 k < prodTop k`, so in particular the two topologies are not equal.
-/

namespace Hartshorne77.Ex_I_1_4

open Polynomial MvPolynomial
open scoped Topology

variable (k : Type*) [Field k]

/-! ## The Zariski topologies on the affine line and the affine plane -/

/-- The Zariski topology on the affine line `A¹ = k`: the topology generated by
the complements of the zero sets of polynomials in one variable. -/
@[instance_reducible]
noncomputable def zar1 : TopologicalSpace k :=
  TopologicalSpace.generateFrom {s : Set k | ∃ f : k[X], s = {x | f.eval x = 0}ᶜ}

/-- The Zariski topology on the affine plane `A² = k × k`: the topology generated
by the complements of the zero sets of polynomials in `k[X₀,X₁]`, evaluated at
the point `(p₀,p₁)`. -/
@[instance_reducible]
noncomputable def zar2 : TopologicalSpace (k × k) :=
  TopologicalSpace.generateFrom {s : Set (k × k) |
    ∃ f : MvPolynomial (Fin 2) k, s = {p | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ}

/-- The product topology on `A¹ × A¹`, where each factor carries the Zariski
topology. -/
@[instance_reducible]
noncomputable def prodTop : TopologicalSpace (k × k) :=
  @instTopologicalSpaceProd k k (zar1 k) (zar1 k)

/-! ## Basic Zariski open and closed sets -/

lemma isOpen_zar1_compl_zeroSet (f : k[X]) :
    IsOpen[zar1 k] {x : k | f.eval x = 0}ᶜ :=
  TopologicalSpace.GenerateOpen.basic {x : k | f.eval x = 0}ᶜ ⟨f, rfl⟩

/-- Constructor for `IsClosed` with the topology passed explicitly.  (`IsClosed`
is a typeclass in this Mathlib version, so its topology argument would otherwise
be found by typeclass search.) -/
theorem isClosed_of_isOpen_compl {α : Type*} (t : TopologicalSpace α) {s : Set α}
    (h : @IsOpen α t sᶜ) : @IsClosed α t s :=
  @IsClosed.mk α t s h

lemma isClosed_zar1_zeroSet (f : k[X]) : IsClosed[zar1 k] {x : k | f.eval x = 0} :=
  isClosed_of_isOpen_compl (zar1 k) (isOpen_zar1_compl_zeroSet k f)

lemma isOpen_zar2_compl_zeroSet (f : MvPolynomial (Fin 2) k) :
    IsOpen[zar2 k] {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ :=
  TopologicalSpace.GenerateOpen.basic {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ
    ⟨f, rfl⟩

lemma isClosed_zar2_zeroSet (f : MvPolynomial (Fin 2) k) :
    IsClosed[zar2 k] {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0} :=
  isClosed_of_isOpen_compl (zar2 k) (isOpen_zar2_compl_zeroSet k f)

/-- The zero locus of a set of polynomials in two variables on `A² = k × k`. -/
def zeroLocus (T : Set (MvPolynomial (Fin 2) k)) : Set (k × k) :=
  {p | ∀ f ∈ T, MvPolynomial.eval ![p.1, p.2] f = 0}

lemma zeroLocus_singleton (f : MvPolynomial (Fin 2) k) :
    zeroLocus k {f} = {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0} := by
  ext p
  simp [zeroLocus]

lemma zeroLocus_biUnion {ι : Type*} (S : Set ι) (T : ι → Set (MvPolynomial (Fin 2) k)) :
    zeroLocus k (⋃ i ∈ S, T i) = ⋂ i ∈ S, zeroLocus k (T i) := by
  ext p
  simp only [zeroLocus, Set.mem_iUnion, Set.mem_iInter, Set.mem_ofPred_eq, exists_prop]
  exact ⟨fun h i hi f hf => h f ⟨i, hi, hf⟩, fun h f ⟨i, hi, hf⟩ => h i hi f hf⟩

/-- The union of two zero loci is again a zero locus: the zero locus of the set of
all products of a polynomial from the first set with one from the second (the
computation behind `Z(T₁) ∪ Z(T₂) = Z(T₁T₂)` in Hartshorne's Proposition 1.1). -/
lemma zeroLocus_union (T U : Set (MvPolynomial (Fin 2) k)) :
    zeroLocus k T ∪ zeroLocus k U = zeroLocus k (Set.image2 (· * ·) T U) := by
  ext p
  constructor
  · rintro (hp | hp) f ⟨g, hg, h, hh, rfl⟩
    · rw [map_mul, hp g hg, zero_mul]
    · rw [map_mul, hp h hh, mul_zero]
  · intro hp
    by_contra h
    rw [Set.mem_union, not_or] at h
    have hT : ∃ f ∈ T, MvPolynomial.eval ![p.1, p.2] f ≠ 0 := by
      by_contra hc
      refine h.1 ?_
      intro f hf
      by_contra hf0
      exact hc ⟨f, hf, hf0⟩
    obtain ⟨f, hfT, hf0⟩ := hT
    have hU : ∃ g ∈ U, MvPolynomial.eval ![p.1, p.2] g ≠ 0 := by
      by_contra hc
      refine h.2 ?_
      intro g hg
      by_contra hg0
      exact hc ⟨g, hg, hg0⟩
    obtain ⟨g, hgU, hg0⟩ := hU
    have h1 := hp (f * g) ⟨f, hfT, g, hgU, rfl⟩
    rw [map_mul] at h1
    exact mul_ne_zero hf0 hg0 h1

/-- Every open subset of `A²` is the complement of an algebraic set. -/
theorem exists_zeroLocus_of_isOpen_zar2 {s : Set (k × k)} (h : IsOpen[zar2 k] s) :
    ∃ T : Set (MvPolynomial (Fin 2) k), sᶜ = zeroLocus k T := by
  induction h with
  | basic s hs =>
      obtain ⟨f, rfl⟩ := hs
      exact ⟨{f}, by rw [compl_compl, zeroLocus_singleton]⟩
  | univ =>
      refine ⟨{1}, ?_⟩
      ext p
      simp [zeroLocus]
  | inter s t _ _ ihs iht =>
      obtain ⟨T, hT⟩ := ihs
      obtain ⟨U, hU⟩ := iht
      exact ⟨Set.image2 (· * ·) T U, by rw [Set.compl_inter, hT, hU, zeroLocus_union]⟩
  | sUnion S _ ih =>
      classical
      let T : Set (k × k) → Set (MvPolynomial (Fin 2) k) :=
        fun s => if hs : s ∈ S then Classical.choose (ih s hs) else ∅
      have hT : ∀ s ∈ S, sᶜ = zeroLocus k (T s) := by
        intro s hs
        simp only [T, dif_pos hs]
        exact Classical.choose_spec (ih s hs)
      refine ⟨⋃ s ∈ S, T s, ?_⟩
      have h1 : (⋃₀ S)ᶜ = ⋂ s ∈ S, sᶜ := by
        ext x
        simp
      rw [h1]
      have h2 : (⋂ s ∈ S, sᶜ) = ⋂ s ∈ S, zeroLocus k (T s) := by
        ext p
        simp only [Set.mem_iInter]
        exact ⟨fun h s hs => by rw [← hT s hs]; exact h s hs,
          fun h s hs => by rw [hT s hs]; exact h s hs⟩
      rw [h2, zeroLocus_biUnion]

/-- The Zariski closed subsets of `A²` are exactly the algebraic sets `Z(T)` of
Hartshorne's definition. -/
theorem isClosed_zar2_iff {s : Set (k × k)} :
    IsClosed[zar2 k] s ↔ ∃ T : Set (MvPolynomial (Fin 2) k), s = zeroLocus k T := by
  constructor
  · intro hs
    obtain ⟨T, hT⟩ := exists_zeroLocus_of_isOpen_zar2 k hs.isOpen_compl
    exact ⟨T, by rw [← hT]; simp⟩
  · rintro ⟨T, rfl⟩
    refine isClosed_of_isOpen_compl (zar2 k) ?_
    have h : (zeroLocus k T)ᶜ
        = ⋃ f ∈ T, {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ := by
      ext p
      simp only [zeroLocus, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_ofPred_eq,
        not_forall, exists_prop]
    rw [h]
    have h2 : (⋃ f ∈ T, {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ)
        = ⋃₀ {u : Set (k × k) | ∃ f ∈ T,
            u = {p : k × k | MvPolynomial.eval ![p.1, p.2] f = 0}ᶜ} := by
      ext p
      simp
    rw [h2]
    exact (zar2 k).isOpen_sUnion _ (by
      rintro u ⟨f, -, rfl⟩
      exact isOpen_zar2_compl_zeroSet k f)

/-! ## Zariski closed subsets of the affine line

Hartshorne's Example 1.1.1: the algebraic subsets of `A¹` are the finite subsets
and the whole space.  We use this to show that nonempty Zariski open subsets of
`A¹` are cofinite, hence that two nonempty ones meet (as `k` is infinite).
-/

lemma finite_zeroSet_of_ne_zero {f : k[X]} (hf : f ≠ 0) :
    {x : k | f.eval x = 0}.Finite := by
  have h := Polynomial.finite_setOfPred_isRoot (p := f) hf
  simpa [Polynomial.IsRoot] using h

lemma isClosed_zar1_singleton (a : k) : IsClosed[zar1 k] ({a} : Set k) := by
  have h : {a} = {x : k | (Polynomial.X - Polynomial.C a : k[X]).eval x = 0} := by
    ext x
    simp [sub_eq_zero, eq_comm]
  rw [h]
  exact isClosed_zar1_zeroSet k (Polynomial.X - Polynomial.C a)

lemma isClosed_zar1_finite {s : Set k} (hs : s.Finite) : IsClosed[zar1 k] s := by
  classical
  rw [← hs.coe_toFinset]
  induction hs.toFinset using Finset.induction_on with
  | empty => simp
  | insert a t _ ih =>
      rw [Finset.coe_insert]
      exact @IsClosed.union k ({a} : Set k) (↑t : Set k) (zar1 k)
        (isClosed_zar1_singleton k a) ih

/-- Every open set of the cofinite topology on `k` is empty or cofinite: the
defining generators have this property and it is preserved by finite
intersections and arbitrary unions. -/
lemma generateOpen_cofinite {α : Type*} {s : Set α}
    (h : TopologicalSpace.GenerateOpen {t : Set α | tᶜ.Finite} s) :
    s = ∅ ∨ sᶜ.Finite := by
  induction h with
  | basic s hs => exact Or.inr hs
  | univ => exact Or.inr (by simp)
  | inter s t _ _ ihs iht =>
      rcases ihs with rfl | hs
      · exact Or.inl (by simp)
      rcases iht with rfl | ht
      · exact Or.inl (by simp)
      · exact Or.inr (by rw [Set.compl_inter]; exact hs.union ht)
  | sUnion S _ ih =>
      by_cases hne : ∃ s ∈ S, s ≠ ∅
      · obtain ⟨s, hsS, hsne⟩ := hne
        rcases ih s hsS with hs | hs
        · exact absurd hs hsne
        · refine Or.inr (hs.subset ?_)
          intro x hx hxs
          exact hx ⟨s, hsS, hxs⟩
      · push Not at hne
        refine Or.inl (Set.not_nonempty_iff_eq_empty.mp ?_)
        rintro ⟨x, hx⟩
        obtain ⟨s, hsS, hxs⟩ := Set.mem_sUnion.mp hx
        rw [hne s hsS] at hxs
        exact hxs

/-- Every Zariski open subset of `A¹` is empty or cofinite. -/
lemma cofinite_le_zar1 :
    TopologicalSpace.generateFrom {t : Set k | tᶜ.Finite} ≤ zar1 k := by
  rw [zar1, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s ⟨f, rfl⟩
  rcases eq_or_ne f 0 with hf | hf
  · subst hf
    have hempty : {x : k | (0 : k[X]).eval x = 0}ᶜ = (∅ : Set k) := by
      ext x
      simp
    rw [hempty]
    simp
  · refine TopologicalSpace.GenerateOpen.basic {x : k | f.eval x = 0}ᶜ ?_
    simpa using finite_zeroSet_of_ne_zero k hf

/-- A nonempty Zariski open subset of the affine line is the complement of a
finite set. -/
lemma finite_compl_of_isOpen_zar1 {U : Set k} (hU : IsOpen[zar1 k] U)
    (hne : U.Nonempty) : Uᶜ.Finite := by
  have hU' : IsOpen[TopologicalSpace.generateFrom {t : Set k | tᶜ.Finite}] U :=
    (TopologicalSpace.le_def.mp (cofinite_le_zar1 k)) U hU
  rcases generateOpen_cofinite hU' with h | h
  · exact absurd h hne.ne_empty
  · exact h

/-- Hartshorne, Example 1.1.1: a subset of `A¹` is Zariski closed if and only if
it is finite or the whole space. -/
theorem isClosed_zar1_iff {s : Set k} : IsClosed[zar1 k] s ↔ s.Finite ∨ s = Set.univ := by
  constructor
  · intro hs
    have h' : IsOpen[TopologicalSpace.generateFrom {t : Set k | tᶜ.Finite}] sᶜ :=
      (TopologicalSpace.le_def.mp (cofinite_le_zar1 k)) sᶜ hs.isOpen_compl
    rcases generateOpen_cofinite h' with h | h
    · exact Or.inr (by simpa using congrArg compl h)
    · exact Or.inl (by simpa using h)
  · rintro (hs | rfl)
    · exact isClosed_zar1_finite k hs
    · exact @isClosed_univ k (zar1 k)

/-- **Nonempty Zariski open sets in `A¹` meet.**  Two nonempty Zariski open
subsets of `A¹` have a common point (here `k` is infinite); this is the key
point-set input showing that the diagonal is not closed in the product topology. -/
lemma nonempty_inter_of_isOpen_zar1 [Infinite k] {U V : Set k}
    (hU : IsOpen[zar1 k] U) (hV : IsOpen[zar1 k] V) (hUne : U.Nonempty)
    (hVne : V.Nonempty) : (U ∩ V).Nonempty := by
  have hUfin : Uᶜ.Finite := finite_compl_of_isOpen_zar1 k hU hUne
  have hVfin : Vᶜ.Finite := finite_compl_of_isOpen_zar1 k hV hVne
  have hfin : (U ∩ V)ᶜ.Finite := by
    rw [Set.compl_inter]
    exact hUfin.union hVfin
  obtain ⟨x, hx⟩ := hfin.exists_notMem
  exact ⟨x, by simpa using hx⟩

/-! ## The Zariski topology on `A²` is finer than the product topology -/

/-- The one-variable polynomial `f` regarded as a polynomial in the first
coordinate `X₀` of `A²`. -/
noncomputable def lift₀ (f : k[X]) : MvPolynomial (Fin 2) k :=
  Polynomial.aeval (MvPolynomial.X 0) f

/-- The one-variable polynomial `f` regarded as a polynomial in the second
coordinate `X₁` of `A²`. -/
noncomputable def lift₁ (f : k[X]) : MvPolynomial (Fin 2) k :=
  Polynomial.aeval (MvPolynomial.X 1) f

lemma eval_lift₀ (p : k × k) (f : k[X]) :
    MvPolynomial.eval ![p.1, p.2] (lift₀ k f) = f.eval p.1 := by
  have h1 : (MvPolynomial.aeval ![p.1, p.2]).comp
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) k)) =
      (Polynomial.aeval p.1 : k[X] →ₐ[k] k) := by
    apply Polynomial.algHom_ext
    simp
  have := DFunLike.congr_fun h1 f
  simpa [lift₀, Polynomial.aeval_def, MvPolynomial.aeval_def, Polynomial.eval₂_id] using this

lemma eval_lift₁ (p : k × k) (f : k[X]) :
    MvPolynomial.eval ![p.1, p.2] (lift₁ k f) = f.eval p.2 := by
  have h1 : (MvPolynomial.aeval ![p.1, p.2]).comp
      (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k)) =
      (Polynomial.aeval p.2 : k[X] →ₐ[k] k) := by
    apply Polynomial.algHom_ext
    simp
  have := DFunLike.congr_fun h1 f
  simpa [lift₁, Polynomial.aeval_def, MvPolynomial.aeval_def, Polynomial.eval₂_id] using this

/-- The first projection `A¹ × A¹ → A¹` is continuous for the Zariski topologies. -/
lemma continuous_fst_zar2 : Continuous[zar2 k, zar1 k] Prod.fst := by
  rw [zar1, continuous_generateFrom_iff]
  rintro s ⟨f, rfl⟩
  have hset : Prod.fst ⁻¹' {x : k | f.eval x = 0}ᶜ
      = {p : k × k | MvPolynomial.eval ![p.1, p.2] (lift₀ k f) = 0}ᶜ := by
    ext p
    simp [eval_lift₀ k p f]
  rw [hset]
  exact isOpen_zar2_compl_zeroSet k (lift₀ k f)

/-- The second projection `A¹ × A¹ → A¹` is continuous for the Zariski topologies. -/
lemma continuous_snd_zar2 : Continuous[zar2 k, zar1 k] Prod.snd := by
  rw [zar1, continuous_generateFrom_iff]
  rintro s ⟨f, rfl⟩
  have hset : Prod.snd ⁻¹' {x : k | f.eval x = 0}ᶜ
      = {p : k × k | MvPolynomial.eval ![p.1, p.2] (lift₁ k f) = 0}ᶜ := by
    ext p
    simp [eval_lift₁ k p f]
  rw [hset]
  exact isOpen_zar2_compl_zeroSet k (lift₁ k f)

/-- **The Zariski topology on `A²` is finer than the product topology on
`A¹ × A¹`:** every product-open subset of `k × k` is Zariski open.  (In the
order on topologies used by Mathlib, finer means smaller, so this is
`zar2 k ≤ prodTop k`.) -/
theorem zar2_le_prodTop : zar2 k ≤ prodTop k := by
  have hgen : prodTop k = TopologicalSpace.generateFrom
      {g : Set (k × k) | ∃ s t : Set k,
        IsOpen[zar1 k] s ∧ IsOpen[zar1 k] t ∧ g = s ×ˢ t} := by
    simpa [prodTop] using (@prod_eq_generateFrom k k (zar1 k) (zar1 k))
  rw [hgen]
  refine TopologicalSpace.le_generateFrom_iff_subset_isOpen.2 ?_
  rintro g ⟨s, t, hs, ht, rfl⟩
  have hst : s ×ˢ t = Prod.fst ⁻¹' s ∩ Prod.snd ⁻¹' t := by
    ext p
    simp
  rw [hst]
  exact (zar2 k).isOpen_inter _ _
    (continuous_def.mp (continuous_fst_zar2 k) s hs)
    (continuous_def.mp (continuous_snd_zar2 k) t ht)

/-! ## The diagonal -/

/-- The diagonal of `A² = A¹ × A¹` is the Zariski closed set `Z(X₁ - X₀)`. -/
theorem isClosed_zar2_diag : IsClosed[zar2 k] {p : k × k | p.1 = p.2} := by
  have hset : {p : k × k | p.1 = p.2}
      = zeroLocus k {MvPolynomial.X 1 - MvPolynomial.X 0} := by
    ext p
    simp [zeroLocus, sub_eq_zero, eq_comm]
  rw [hset, zeroLocus_singleton]
  exact isClosed_zar2_zeroSet k _

/-- Explicit description of open sets in the product topology: every point of an
open set has a product-basic neighbourhood `U × V`. -/
lemma isOpen_prodTop_iff {s : Set (k × k)} :
    IsOpen[prodTop k] s ↔ ∀ a b, (a, b) ∈ s →
      ∃ u v : Set k, IsOpen[zar1 k] u ∧ IsOpen[zar1 k] v ∧ a ∈ u ∧ b ∈ v ∧ u ×ˢ v ⊆ s := by
  have h := @isOpen_prod_iff k k (zar1 k) (zar1 k) s
  simpa [prodTop] using h

/-- **The diagonal is not closed in the product topology.** -/
theorem not_isClosed_prodTop_diag [Infinite k] :
    ¬ IsClosed[prodTop k] {p : k × k | p.1 = p.2} := by
  intro hcl
  have hop : IsOpen[prodTop k] {p : k × k | p.1 = p.2}ᶜ := hcl.isOpen_compl
  have hmem : ((0 : k), (1 : k)) ∈ {p : k × k | p.1 = p.2}ᶜ := by
    simp
  obtain ⟨u, v, hu, hv, h0u, h1v, huv⟩ := (isOpen_prodTop_iff k).1 hop 0 1 hmem
  obtain ⟨c, hcu, hcv⟩ :=
    nonempty_inter_of_isOpen_zar1 k hu hv ⟨0, h0u⟩ ⟨1, h1v⟩
  have hcu' : (c, c) ∈ u ×ˢ v := ⟨hcu, hcv⟩
  have hmem' : (c, c) ∈ {p : k × k | p.1 = p.2}ᶜ := huv hcu'
  exact hmem' rfl

/-! ## Main theorem -/

/-- **Hartshorne, Exercise I.1.4.**  The Zariski topology on `A²` is not the
product topology on `A¹ × A¹`. -/
theorem zariski_ne_productTop [Infinite k] : zar2 k ≠ prodTop k := by
  intro h
  exact not_isClosed_prodTop_diag k (h ▸ isClosed_zar2_diag k)

/-- **Hartshorne, Exercise I.1.4 (strict form).**  The Zariski topology on `A²`
is strictly finer than the product topology on `A¹ × A¹`. -/
theorem zar2_lt_prodTop [Infinite k] : zar2 k < prodTop k :=
  lt_of_le_of_ne (zar2_le_prodTop k) (zariski_ne_productTop k)

/-- **Hartshorne, Exercise I.1.4, in the book's hypotheses.**  Over an
algebraically closed field the Zariski topology on `A²` is not the product
topology on `A¹ × A¹`. -/
theorem zariski_ne_productTop_of_isAlgClosed [IsAlgClosed k] : zar2 k ≠ prodTop k :=
  zariski_ne_productTop k

/-- The refinement `zar2 k ≤ prodTop k` restated without the order on topologies:
every set open in the product topology is open in the Zariski topology. -/
theorem isOpen_zar2_of_isOpen_prodTop {u : Set (k × k)} (h : IsOpen[prodTop k] u) :
    IsOpen[zar2 k] u :=
  (TopologicalSpace.le_def.mp (zar2_le_prodTop k)) u h

/-- The identity map `(A², Zariski) → (A¹ × A¹, product topology)` is continuous,
i.e. the Zariski topology contains the product topology. -/
theorem continuous_id_zar2_prodTop :
    Continuous[zar2 k, prodTop k] (id : k × k → k × k) :=
  continuous_def.mpr fun _ hu => isOpen_zar2_of_isOpen_prodTop k hu

/-- The two topologies really differ: there is a set that is Zariski closed but not
closed in the product topology (namely the diagonal). -/
theorem exists_isClosed_zar2_not_isClosed_prodTop [Infinite k] :
    ∃ s : Set (k × k), IsClosed[zar2 k] s ∧ ¬ IsClosed[prodTop k] s :=
  ⟨{p : k × k | p.1 = p.2}, isClosed_zar2_diag k, not_isClosed_prodTop_diag k⟩

/-! ## Remark: infiniteness of `k` is necessary

Over a finite field both topologies are discrete and hence coincide, so the
hypothesis `[Infinite k]` in the main theorem cannot be dropped.  (The exercise
is stated over an algebraically closed field, which is automatically infinite, so
this does not affect the source statement.) -/

/-- Every finite subset of `A²` is Zariski closed (it is a finite union of
points). -/
lemma isClosed_zar2_finite {s : Set (k × k)} (hs : s.Finite) : IsClosed[zar2 k] s := by
  classical
  have hsing : ∀ p : k × k, IsClosed[zar2 k] ({p} : Set (k × k)) := by
    intro p
    have h : ({p} : Set (k × k)) = zeroLocus k
        {MvPolynomial.X 0 - MvPolynomial.C p.1,
          MvPolynomial.X 1 - MvPolynomial.C p.2} := by
      ext q
      simp only [zeroLocus, Set.mem_singleton_iff, Set.mem_insert_iff, Set.mem_ofPred_eq]
      constructor
      · rintro rfl f (hf | hf) <;> simp [hf]
      · intro h
        have h1 := h (MvPolynomial.X 0 - MvPolynomial.C p.1) (Or.inl rfl)
        have h2 := h (MvPolynomial.X 1 - MvPolynomial.C p.2) (Or.inr rfl)
        simp only [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, Matrix.cons_val_zero,
          Matrix.cons_val_one, sub_eq_zero] at h1 h2
        exact Prod.ext h1 h2
    rw [h]
    exact (isClosed_zar2_iff (s := zeroLocus k
      {MvPolynomial.X 0 - MvPolynomial.C p.1,
        MvPolynomial.X 1 - MvPolynomial.C p.2})).mpr ⟨_, rfl⟩
  rw [← hs.coe_toFinset]
  induction hs.toFinset using Finset.induction_on with
  | empty => simp
  | insert p t _ ih =>
      rw [Finset.coe_insert]
      exact @IsClosed.union (k × k) ({p} : Set (k × k)) (↑t : Set (k × k)) (zar2 k)
        (hsing p) ih

lemma zar1_eq_bot_of_finite [Finite k] : zar1 k = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro u _
  simpa using (isClosed_zar1_finite k (Set.toFinite uᶜ)).isOpen_compl

lemma zar2_eq_bot_of_finite [Finite k] : zar2 k = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro u _
  simpa using (isClosed_zar2_finite k (Set.toFinite uᶜ)).isOpen_compl

set_option linter.style.haveILetI false in
lemma prodTop_eq_bot_of_finite [Finite k] : prodTop k = ⊥ := by
  have h1 : zar1 k = ⊥ := zar1_eq_bot_of_finite k
  letI := zar1 k
  haveI d1 : DiscreteTopology k := ⟨h1⟩
  haveI d2 : DiscreteTopology (k × k) := inferInstance
  exact d2.eq_bot

/-- Over a finite field the Zariski topology on `A²` and the product topology on
`A¹ × A¹` coincide (both are discrete), so infiniteness is essential. -/
theorem zar2_eq_prodTop_of_finite [Finite k] : zar2 k = prodTop k := by
  rw [zar2_eq_bot_of_finite k, prodTop_eq_bot_of_finite k]

