/-
Atiyah–Macdonald (1969), *Introduction to Commutative Algebra*, Chapter 2, Exercise 16.

Statement (Exercise 2.16, verbatim): "Show that the direct limit is characterized (up to
isomorphism) by the following property. Let N be an A-module and for each i ∈ I let
αᵢ : Mᵢ → N be an A-module homomorphism such that αᵢ = αⱼ ∘ μᵢⱼ whenever i ≤ j. Then there
exists a unique homomorphism α : M → N such that αᵢ = α ∘ μᵢ for all i ∈ I."

The direct system (Mᵢ, μᵢⱼ) over the directed set I and its direct limit M = lim Mᵢ are those
of Exercise 14: C = ⨁ᵢ Mᵢ, D ⊆ C the submodule generated by the elements xᵢ - μᵢⱼ(xᵢ),
M = C/D, π : C → M the projection, and μᵢ = π ∘ (canonical inclusion Mᵢ → C).

Contents:
* `DirectSystem` : a direct system of A-modules over a directed set (Exercise 14 data);
* `DirectSystem.rel`, `DirectSystem.lim`, `DirectSystem.μ` : the construction of Exercise 14;
* `DirectSystem.μ_map` : μᵢ = μⱼ ∘ μᵢⱼ ("clear from the construction");
* `DirectSystem.lift`, `lift_apply_mk`, `lift_comp_μ`, `lift_unique`, `existsUnique_lift` :
  existence and uniqueness of the factorisation α : M → N of a compatible family (αᵢ) — the
  property of Exercise 2.16, for the constructed limit;
* `DirectSystem.exists_rep` : the element form of Exercise 15 (every element of lim Mᵢ is
  μᵢ(xᵢ)), i.e. the step "move finitely many representatives to a common stage" used in the
  textbook proof of well-definedness of α;
* `IsDirectLimit` : the property of Exercise 2.16 as a predicate on a pair (X, (νᵢ));
* `IsDirectLimit.unique_iso` : any two pairs with the property are isomorphic, by a unique
  isomorphism compatible with the structure maps;
* `DirectSystem.unique_iso_of_isDirectLimit` : the direct limit is characterized, up to
  isomorphism, by the property — the assertion of Exercise 2.16;
* `constSystem_lim_iso` : a concrete verification, for the constant system over ℕ, that the
  limit is A itself (so that the characterization is not vacuous);
* `IsUniversalWithoutCompat`, `badNu`, `badNu_isUniversalWithoutCompat`, `badNu_not_compat`,
  `isUniversalWithoutCompat_not_isDirectLimit` : an audit of the statement, showing that the
  compatibility of the structure maps with the transition maps is an essential part of the
  data (it is not a consequence of the universal property), hence that it is the pair
  `(M, (μᵢ))` — not the module `M` — that Exercise 2.16 characterizes.

Universes: a `Prop` can only quantify over one universe, so the property of Exercise 2.16 is
formalized with all the modules involved (the Mᵢ, the limit, and the test module N) living in
the single universe `max u v`, where `A : Type u` and `I : Type v`. This is a purely formal
restriction; the mathematical statement is unchanged.
-/
import Mathlib

open DirectSum

namespace AtiyahMcdonald69.Ex_2_16

noncomputable section

attribute [local instance] Classical.decEq

universe u v

variable {A : Type u} [CommRing A] {I : Type v} [Preorder I]

/-- A direct system of `A`-modules over a directed set `I`, as in Atiyah–Macdonald, Chapter 2,
Exercise 14: a family `(M i)` of `A`-modules together with, for every pair `i ≤ j`, an
`A`-linear map `map i j h : M i →ₗ[A] M j`, subject to `map i i = id` and
`map i k = map j k ∘ map i j` for `i ≤ j ≤ k`; and the index set `I` is a directed set. -/
structure DirectSystem (A : Type u) [CommRing A] (I : Type v) [Preorder I] where
  /-- The modules `Mᵢ` of the system. -/
  M : I → Type (max u v)
  [instAddCommGroup : ∀ i, AddCommGroup (M i)]
  [instModule : ∀ i, Module A (M i)]
  /-- The transition maps `μᵢⱼ : Mᵢ → Mⱼ`, for `i ≤ j`. -/
  map : ∀ i j : I, i ≤ j → M i →ₗ[A] M j
  /-- Axiom (1) of Exercise 14: `μᵢᵢ` is the identity. -/
  map_self : ∀ i : I, map i i le_rfl = LinearMap.id
  /-- Axiom (2) of Exercise 14: `μᵢₖ = μⱼₖ ∘ μᵢⱼ` for `i ≤ j ≤ k`. -/
  map_comp : ∀ ⦃i j k : I⦄ (hij : i ≤ j) (hjk : j ≤ k),
    map i k (hij.trans hjk) = (map j k hjk).comp (map i j hij)
  /-- `I` is a directed set: any two indices have a common upper bound. -/
  directed : ∀ i j : I, ∃ k, i ≤ k ∧ j ≤ k

attribute [instance] DirectSystem.instAddCommGroup DirectSystem.instModule

/-- The property by which the direct limit is characterized (Atiyah–Macdonald, Chapter 2,
Exercise 16). A pair `(X, ν)` consisting of an `A`-module `X` and `A`-linear maps
`νᵢ : Mᵢ → X` that are compatible with the transition maps (`νᵢ = νⱼ ∘ μᵢⱼ` for `i ≤ j`) has
the property if every compatible family `αᵢ : Mᵢ → N` admits a unique factorisation
`αᵢ = α ∘ νᵢ` through a single `A`-linear map `α : X → N`. -/
def IsDirectLimit (D : DirectSystem A I) (X : Type (max u v)) [AddCommGroup X] [Module A X]
    (ν : ∀ i, D.M i →ₗ[A] X) : Prop :=
  (∀ ⦃i j : I⦄ (h : i ≤ j), ν i = (ν j).comp (D.map i j h)) ∧
    ∀ (N : Type (max u v)) [AddCommGroup N] [Module A N] (α : ∀ i, D.M i →ₗ[A] N),
      (∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h)) →
        ∃! (a : X →ₗ[A] N), ∀ i, a.comp (ν i) = α i

namespace DirectSystem

variable (D : DirectSystem A I)

section Construction

/-- The submodule `D` of Exercise 14 inside `C = ⨁ i, M i`: it is generated by the elements
`xᵢ - μᵢⱼ(xᵢ)` for `i ≤ j` and `xᵢ ∈ Mᵢ`. -/
abbrev rel : Submodule A (DirectSum I D.M) :=
  Submodule.span A {z | ∃ (i j : I) (h : i ≤ j) (x : D.M i),
    z = lof A I D.M i x - lof A I D.M j (D.map i j h x)}

theorem subset_rel {i j : I} (h : i ≤ j) (x : D.M i) :
    lof A I D.M i x - lof A I D.M j (D.map i j h x) ∈ D.rel :=
  Submodule.subset_span ⟨i, j, h, x, rfl⟩

/-- The direct limit `M = C/D` of Exercise 14. -/
abbrev lim : Type (max u v) := DirectSum I D.M ⧸ D.rel

instance : AddCommGroup D.lim := inferInstanceAs (AddCommGroup (DirectSum I D.M ⧸ D.rel))

instance : Module A D.lim := inferInstanceAs (Module A (DirectSum I D.M ⧸ D.rel))

/-- The structure map `μᵢ : Mᵢ → M`, namely the projection `π : C → M` restricted to `Mᵢ`. -/
def μ (i : I) : D.M i →ₗ[A] D.lim := D.rel.mkQ.comp (lof A I D.M i)

@[simp]
theorem μ_apply (i : I) (x : D.M i) :
    D.μ i x = Submodule.Quotient.mk (lof A I D.M i x) := rfl

/-- "From the construction it is clear that μᵢ = μⱼ ∘ μᵢⱼ whenever i ≤ j." -/
theorem μ_map {i j : I} (h : i ≤ j) (x : D.M i) : D.μ j (D.map i j h x) = D.μ i x := by
  have hmem := D.subset_rel h x
  simp only [μ_apply]
  rw [Submodule.Quotient.eq']
  simpa [neg_add_eq_sub] using hmem

/-- The transition maps are compatible with the structure maps of the direct limit. -/
theorem μ_compat {i j : I} (h : i ≤ j) : D.μ i = (D.μ j).comp (D.map i j h) :=
  LinearMap.ext fun x => (D.μ_map h x).symm

end Construction

section UniversalProperty

variable {N : Type (max u v)} [AddCommGroup N] [Module A N]
variable (α : ∀ i, D.M i →ₗ[A] N)

/-- The element `Σᵢ xᵢ ↦ Σᵢ αᵢ(xᵢ)` of the textbook proof, obtained from the universal property
of the direct sum `C = ⨁ i, M i`. -/
def toDirectSum : DirectSum I D.M →ₗ[A] N := DirectSum.toModule A I N α

theorem toDirectSum_lof (i : I) (x : D.M i) :
    D.toDirectSum α (lof A I D.M i x) = α i x :=
  DirectSum.toModule_lof A i x

/-- The factorisation `α : M → N` of a compatible family `(αᵢ)` through the direct limit
(Exercise 2.16, existence). -/
def lift (hα : ∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h)) : D.lim →ₗ[A] N :=
  D.rel.liftQ (D.toDirectSum α) (by
    rw [Submodule.span_le]
    rintro z ⟨i, j, h, x, rfl⟩
    have h1 : α i x = α j (D.map i j h x) := by rw [hα h]; rfl
    simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, toDirectSum_lof, h1, sub_self])

theorem lift_apply_mk (hα : ∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h))
    (y : DirectSum I D.M) :
    D.lift α hα (Submodule.Quotient.mk y) = D.toDirectSum α y :=
  rfl

/-- The factorisation extends the family `(αᵢ)`: `αᵢ = α ∘ μᵢ`. -/
theorem lift_comp_μ (hα : ∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h)) (i : I) :
    (D.lift α hα).comp (D.μ i) = α i := by
  ext x
  rw [LinearMap.comp_apply, μ_apply, lift_apply_mk, toDirectSum_lof]

/-- The factorisation is unique (Exercise 2.16, uniqueness). -/
theorem lift_unique (hα : ∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h))
    (β : D.lim →ₗ[A] N) (hβ : ∀ i, β.comp (D.μ i) = α i) : β = D.lift α hα := by
  have h1 : β.comp D.rel.mkQ = (D.lift α hα).comp D.rel.mkQ := by
    refine DirectSum.linearMap_ext A fun i => ?_
    simp only [LinearMap.comp_assoc]
    rw [show D.rel.mkQ.comp (lof A I D.M i) = D.μ i from rfl, hβ i, D.lift_comp_μ α hα i]
  refine LinearMap.ext fun z => ?_
  exact Submodule.Quotient.induction_on D.rel z fun y => LinearMap.congr_fun h1 y

/-- **Exercise 2.16, existence and uniqueness** for the constructed direct limit: every
compatible family `(αᵢ : Mᵢ → N)` factors as `αᵢ = α ∘ μᵢ` through a unique `α : lim Mᵢ → N`. -/
theorem existsUnique_lift (hα : ∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h)) :
    ∃! (a : D.lim →ₗ[A] N), ∀ i, a.comp (D.μ i) = α i :=
  ⟨D.lift α hα, D.lift_comp_μ α hα, fun β hβ => D.lift_unique α hα β hβ⟩

end UniversalProperty

/-- **The direct limit satisfies the property of Exercise 2.16.** -/
theorem isDirectLimit : IsDirectLimit D D.lim D.μ :=
  ⟨fun _ _ h => D.μ_compat h, fun _ _ _ α hα => D.existsUnique_lift α hα⟩

section Elements

variable [Nonempty I]

/-- **Exercise 2.15 (first part)**: every element of the direct limit is of the form
`μᵢ(xᵢ)`. This is the "move finitely many representatives to a common stage" step of the
textbook proof of Exercise 2.16. -/
theorem exists_rep (z : D.lim) : ∃ (i : I) (x : D.M i), D.μ i x = z := by
  obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective D.rel z
  induction y using DirectSum.induction_on with
  | zero => exact ⟨Classical.arbitrary I, 0, by simp⟩
  | of i x => exact ⟨i, x, rfl⟩
  | add a b ha hb =>
      obtain ⟨i, x, hx⟩ := ha
      obtain ⟨j, y, hy⟩ := hb
      obtain ⟨k, hik, hjk⟩ := D.directed i j
      refine ⟨k, D.map i k hik x + D.map j k hjk y, ?_⟩
      rw [map_add, D.μ_map hik x, D.μ_map hjk y, hx, hy, map_add]

end Elements

end DirectSystem

namespace IsDirectLimit

variable {D : DirectSystem A I}
variable {X : Type (max u v)} [AddCommGroup X] [Module A X] {ν : ∀ i, D.M i →ₗ[A] X}

/-- A pair with the property of Exercise 2.16 has no non-trivial endomorphisms compatible with
the structure maps: the identity is the only one. -/
theorem uniq_self (hX : IsDirectLimit D X ν) (a : X →ₗ[A] X)
    (ha : ∀ i, a.comp (ν i) = ν i) : a = LinearMap.id := by
  obtain ⟨_, _, huniq⟩ := hX.2 X ν hX.1
  rw [huniq a ha, huniq LinearMap.id fun i => LinearMap.id_comp (ν i)]

/-- **Exercise 2.16: the direct limit is characterized, up to isomorphism, by its property.**
Two pairs `(X, ν)` and `(Y, ω)` satisfying the property of Exercise 2.16 are isomorphic, and
there is exactly one isomorphism `X ≃ₗ[A] Y` compatible with the structure maps. -/
theorem unique_iso {Y : Type (max u v)} [AddCommGroup Y] [Module A Y]
    {ω : ∀ i, D.M i →ₗ[A] Y} (hX : IsDirectLimit D X ν) (hY : IsDirectLimit D Y ω) :
    ∃! e : X ≃ₗ[A] Y, ∀ i, (e : X →ₗ[A] Y).comp (ν i) = ω i := by
  -- `ψ : X → Y` and `φ : Y → X`, from the two universal properties
  obtain ⟨ψ, hψ, hψuniq⟩ := hX.2 Y ω hY.1
  obtain ⟨φ, hφ, _⟩ := hY.2 X ν hX.1
  -- `φ ∘ ψ = id` on `X` and `ψ ∘ φ = id` on `Y`, by uniqueness
  have hφψ : φ.comp ψ = LinearMap.id := by
    have h : ∀ i, (φ.comp ψ).comp (ν i) = ν i := by
      intro i
      rw [LinearMap.comp_assoc, hψ i, hφ i]
    exact hX.uniq_self _ h
  have hψφ : ψ.comp φ = LinearMap.id := by
    have h : ∀ i, (ψ.comp φ).comp (ω i) = ω i := by
      intro i
      rw [LinearMap.comp_assoc, hφ i, hψ i]
    exact hY.uniq_self _ h
  refine ⟨LinearEquiv.ofLinearMap ψ φ hψφ hφψ, ?_, ?_⟩
  · -- the isomorphism is compatible with the structure maps
    intro i
    exact hψ i
  · -- and it is the only such isomorphism
    intro e he
    refine LinearEquiv.toLinearMap_inj.mp ?_
    exact (hψuniq (e : X →ₗ[A] Y) he).trans (hψuniq ψ hψ).symm

end IsDirectLimit

namespace DirectSystem

variable (D : DirectSystem A I)

/-- **Atiyah–Macdonald, Chapter 2, Exercise 2.16.** The direct limit `lim Mᵢ` of a direct
system of `A`-modules is characterized up to isomorphism by the property that every compatible
family `αᵢ : Mᵢ → N` factors uniquely as `αᵢ = α ∘ μᵢ`: any pair `(X, ν)` with that property is
isomorphic to `(lim Mᵢ, μ)`, by a unique compatible isomorphism. -/
theorem unique_iso_of_isDirectLimit {X : Type (max u v)} [AddCommGroup X] [Module A X]
    {ν : ∀ i, D.M i →ₗ[A] X} (hX : IsDirectLimit D X ν) :
    ∃! e : D.lim ≃ₗ[A] X, ∀ i, (e : D.lim →ₗ[A] X).comp (D.μ i) = ν i :=
  IsDirectLimit.unique_iso D.isDirectLimit hX

section ConstantSystem

/-- The constant direct system over `ℕ`: every module is `A` and every transition map is the
identity. -/
def constSystem (A : Type u) [CommRing A] : DirectSystem A ℕ where
  M := fun _ => A
  map := fun _ _ _ => LinearMap.id
  map_self := fun _ => rfl
  map_comp := by
    intro i j k hij hjk
    exact LinearMap.ext fun x => rfl
  directed := fun i j => ⟨max i j, le_max_left _ _, le_max_right _ _⟩

/-- The constant system over `ℕ` satisfies the property of Exercise 2.16 with `X = A` and
`νᵢ = id`: a compatible family on a constant system is a single map `A → N`. -/
theorem constSystem_isDirectLimit :
    IsDirectLimit (constSystem A) A fun _ => LinearMap.id := by
  constructor
  · intro i j h
    exact LinearMap.ext fun x => rfl
  · intro N _ _ α hα
    refine ⟨α 0, fun i => ?_, fun b hb => ?_⟩
    · exact hα (Nat.zero_le i)
    · exact hb 0

/-- The direct limit of the constant system over `ℕ` is `A` itself, an instance of the
characterization proved in Exercise 2.16. -/
theorem constSystem_lim_iso :
    ∃! e : (constSystem A).lim ≃ₗ[A] A,
      ∀ i, (e : (constSystem A).lim →ₗ[A] A).comp ((constSystem A).μ i) = LinearMap.id :=
  unique_iso_of_isDirectLimit _ constSystem_isDirectLimit

end ConstantSystem

end DirectSystem

/-! ### Audit of the statement: compatibility of the structure maps is essential

Exercise 2.16 characterizes the pair `(M, (μᵢ))`, not the module `M` alone. The hypothesis
`μᵢ = μⱼ ∘ μᵢⱼ` on the structure maps is part of that data and is *not* a consequence of the
universal property: below, for the constant system over `ℕ` with values in `ℚ`, the pair
`(ℚ × ℚ, ν)` with `ν₀ = (x ↦ (x,0))` and `νᵢ = (x ↦ (0,x))` for `i ≥ 1` satisfies the
universal property of Exercise 2.16, yet `ν₀ ≠ ν₁ ∘ μ₀₁`. So it is not isomorphic, as a pair
with structure maps, to the direct limit `(ℚ, (id))`. -/

section Audit

/-- The universal property of Exercise 2.16 *without* the requirement that the structure maps
`νᵢ` be compatible with the transition maps `μᵢⱼ`. -/
def IsUniversalWithoutCompat (D : DirectSystem A I) (X : Type (max u v)) [AddCommGroup X]
    [Module A X] (ν : ∀ i, D.M i →ₗ[A] X) : Prop :=
  ∀ (N : Type (max u v)) [AddCommGroup N] [Module A N] (α : ∀ i, D.M i →ₗ[A] N),
    (∀ ⦃i j : I⦄ (h : i ≤ j), α i = (α j).comp (D.map i j h)) →
      ∃! (a : X →ₗ[A] N), ∀ i, a.comp (ν i) = α i

/-- The structure maps of the "bad" pair for the constant system over `ℕ` with values in `ℚ`:
`x ↦ (x, 0)` at the index `0` and `x ↦ (0, x)` at every other index. -/
def badNu (i : ℕ) : ℚ →ₗ[ℚ] ℚ × ℚ :=
  if i = 0 then LinearMap.inl ℚ ℚ ℚ else LinearMap.inr ℚ ℚ ℚ

theorem badNu_zero : badNu 0 = LinearMap.inl ℚ ℚ ℚ := by simp [badNu]

theorem badNu_one : badNu 1 = LinearMap.inr ℚ ℚ ℚ := by simp [badNu]

theorem badNu_succ (n : ℕ) : badNu (n + 1) = LinearMap.inr ℚ ℚ ℚ := by
  simp [badNu]

/-- On a constant system a compatible family is a single map, and with that observation the
pair `(ℚ × ℚ, badNu)` satisfies the universal property of Exercise 2.16. -/
theorem badNu_isUniversalWithoutCompat :
    IsUniversalWithoutCompat (DirectSystem.constSystem ℚ) (ℚ × ℚ) badNu := by
  intro N _ _ α hα
  have hconst : ∀ i, α i = α 0 := by
    intro i
    refine LinearMap.ext fun (x : ℚ) => ?_
    exact (LinearMap.congr_fun (hα (Nat.zero_le i)) x).symm
  refine ⟨(α 0).comp (LinearMap.fst ℚ ℚ ℚ) + (α 0).comp (LinearMap.snd ℚ ℚ ℚ),
    fun i => ?_, fun b hb => ?_⟩
  · refine LinearMap.ext fun (x : ℚ) => ?_
    rcases Nat.eq_zero_or_pos i with h0 | hi
    · subst h0
      show (α 0) x + (α 0) 0 = (α 0) x
      rw [map_zero, add_zero]
    · obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, (Nat.succ_pred_eq_of_pos hi).symm⟩
      have hc : α (n + 1) = α 0 := hconst (n + 1)
      show (α 0) 0 + (α 0) x = (α (n + 1)) x
      rw [hc, map_zero, zero_add]
      rfl
  · refine LinearMap.ext fun (p : ℚ × ℚ) => ?_
    obtain ⟨x, y⟩ := p
    have h1 : b (x, 0) = α 0 x := by
      have hh := LinearMap.congr_fun (hb 0) x
      rw [badNu_zero] at hh
      exact hh
    have h2 : b (0, y) = α 0 y := by
      have hh := LinearMap.congr_fun (hb 1) y
      rw [badNu_one, hconst 1] at hh
      exact hh
    have hxy : ((x, y) : ℚ × ℚ) = (x, 0) + (0, y) := by simp
    calc b (x, y) = b ((x, 0) + (0, y)) := by rw [hxy]
      _ = b (x, 0) + b (0, y) := map_add b _ _
      _ = α 0 x + α 0 y := by rw [h1, h2]
      _ = ((α 0).comp (LinearMap.fst ℚ ℚ ℚ) + (α 0).comp (LinearMap.snd ℚ ℚ ℚ)) (x, y) := rfl

/-- The structure maps `badNu` are not compatible with the transition maps. -/
theorem badNu_not_compat :
    ¬ (∀ ⦃i j : ℕ⦄ (h : i ≤ j),
        badNu i = (badNu j).comp ((DirectSystem.constSystem ℚ).map i j h)) := by
  intro h
  have h01' : badNu 0 = badNu 1 := by
    have hh := h (show (0 : ℕ) ≤ 1 from by norm_num)
    simp only [DirectSystem.constSystem] at hh
    exact hh
  have hx : ((1, 0) : ℚ × ℚ) = (0, 1) := by
    have hh := LinearMap.congr_fun h01' (1 : ℚ)
    rw [badNu_zero, badNu_one] at hh
    exact hh
  exact one_ne_zero (congr_arg Prod.fst hx)

/-- **Audit remark.** The compatibility of the structure maps with the transition maps is not a
consequence of the universal property: the pair `(ℚ × ℚ, badNu)` satisfies the universal
property of Exercise 2.16 but is not a pair with compatible structure maps, hence fails
`IsDirectLimit`, i.e. it is not a direct limit of the system in the sense of Exercises 14–16. -/
theorem isUniversalWithoutCompat_not_isDirectLimit :
    ¬ IsDirectLimit (DirectSystem.constSystem ℚ) (ℚ × ℚ) badNu :=
  fun h => badNu_not_compat h.1

end Audit

end

end AtiyahMcdonald69.Ex_2_16

