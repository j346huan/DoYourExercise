/-
# Atiyah–Macdonald (1969), Exercise 3.3

The exercise (Chapter 3, "Rings and Modules of Fractions", verbatim from the text) reads:

> Let `A` be a ring, let `S` and `T` be two multiplicatively closed subsets of `A`, and let `U`
> be the image of `T` in `S⁻¹A`. Show that the rings `(ST)⁻¹A` and `U⁻¹(S⁻¹A)` are isomorphic.

Here `ST` denotes the multiplicatively closed subset `{s * t | s ∈ S, t ∈ T}`.

## Formalization notes

* A "ring" in Atiyah–Macdonald is commutative with `1`; a "multiplicatively closed subset" is
  required to contain `1` and be closed under multiplication.  These are `CommRing` and
  `Submonoid` in Mathlib.
* This Mathlib version has no multiplication instance on `Submonoid A`; the smallest submonoid
  containing `S` and `T` is `S ⊔ T`, and in a commutative monoid it is *exactly* the set of
  products `s * t` (`mem_sup_iff` below).  This is the formal counterpart of `ST`.
* The image `U` of `T` in `S⁻¹A` is `T.map (algebraMap A (Localization S))`; using `Submonoid.map`
  (rather than a set-theoretic image) keeps the statement correct even when `A → S⁻¹A` is not
  injective.
* `U⁻¹(S⁻¹A)` is `Localization (imageSubmonoid S T)`, i.e. the localization of the ring
  `S⁻¹A` at the submonoid `U`.

## Main results

* `solution S T : Localization (S ⊔ T) ≃+* Localization (imageSubmonoid S T)` — the isomorphism.
* `solution_mk` — it is the map `a/(s*t) ↦ (a/s)/(t/1)` of the natural proof.
* `solution_algebraMap`, `solution_symm_algebraMap` — it is compatible with the canonical maps
  from `A` and from `S⁻¹A`.
* `isLocalization_image` — the canonical map `A → S⁻¹A → U⁻¹(S⁻¹A)` exhibits `U⁻¹(S⁻¹A)` as the
  localization of `A` at `S ⊔ T`, which is the content of the natural proof (elements of `ST`
  become units, the induced map is bijective).
-/
import Mathlib

open IsLocalization

namespace AtiyahMcdonald69.Ex_3_3

variable {A : Type*} [CommRing A]

/-- In a commutative monoid, the submonoid generated by `S` and `T` is the set of products
`s * t`; this is the formal counterpart of the multiplicatively closed subset `ST` of
Atiyah–Macdonald, Exercise 3.3. -/
lemma mem_sup_iff {S T : Submonoid A} {x : A} :
    x ∈ S ⊔ T ↔ ∃ s ∈ S, ∃ t ∈ T, s * t = x :=
  Submonoid.mem_sup

/-- The image `U` of `T` in `S⁻¹A`, for `S`, `T` multiplicatively closed subsets of `A`. -/
abbrev imageSubmonoid (S T : Submonoid A) : Submonoid (Localization S) :=
  T.map (algebraMap A (Localization S))

lemma mem_imageSubmonoid {S T : Submonoid A} {x : Localization S} :
    x ∈ imageSubmonoid S T ↔ ∃ t ∈ T, algebraMap A (Localization S) t = x :=
  Submonoid.mem_map

variable (S T : Submonoid A)

/-- The canonical map `A → S⁻¹A → U⁻¹(S⁻¹A)`. -/
noncomputable def toLoc : A →+* Localization (imageSubmonoid S T) :=
  (algebraMap (Localization S) (Localization (imageSubmonoid S T))).comp
    (algebraMap A (Localization S))

lemma toLoc_apply (a : A) : toLoc S T a =
    algebraMap (Localization S) (Localization (imageSubmonoid S T))
      (algebraMap A (Localization S) a) := rfl

/-- The canonical map `A → U⁻¹(S⁻¹A)` inverts every element of `ST`. -/
lemma toLoc_isUnit (y : ↥(S ⊔ T)) : IsUnit (toLoc S T (y : A)) := by
  obtain ⟨s, hs, t, ht, hst⟩ := Submonoid.mem_sup.mp y.2
  rw [← hst, map_mul]
  refine IsUnit.mul ?_ ?_
  · exact (IsLocalization.map_units (Localization S) ⟨s, hs⟩).map
      (algebraMap (Localization S) (Localization (imageSubmonoid S T)))
  · exact IsLocalization.map_units (Localization (imageSubmonoid S T))
      (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ ht⟩ : ↥(imageSubmonoid S T))

/-- Hence it induces a ring homomorphism `(ST)⁻¹A ⟶ U⁻¹(S⁻¹A)`, the map `a/(s*t) ↦ (a/s)/(t/1)`. -/
noncomputable def fwd : Localization (S ⊔ T) →+* Localization (imageSubmonoid S T) :=
  IsLocalization.lift (S := Localization (S ⊔ T)) (M := S ⊔ T)
    (P := Localization (imageSubmonoid S T)) (g := toLoc S T) (toLoc_isUnit S T)

lemma fwd_algebraMap (a : A) :
    fwd S T (algebraMap A (Localization (S ⊔ T)) a) = toLoc S T a :=
  IsLocalization.lift_eq _ a

/-- The canonical map `S⁻¹A ⟶ (ST)⁻¹A` induced by `S ≤ ST`. -/
noncomputable def fromLoc : Localization S →+* Localization (S ⊔ T) :=
  IsLocalization.lift (S := Localization S) (M := S) (P := Localization (S ⊔ T))
    (g := algebraMap A (Localization (S ⊔ T)))
    (fun y => IsLocalization.map_units (Localization (S ⊔ T))
      (⟨(y : A), Submonoid.mem_sup.mpr ⟨y, y.2, 1, T.one_mem, mul_one (y : A)⟩⟩ : ↥(S ⊔ T)))

lemma fromLoc_algebraMap (a : A) :
    fromLoc S T (algebraMap A (Localization S) a) = algebraMap A (Localization (S ⊔ T)) a :=
  IsLocalization.lift_eq _ a

/-- The canonical map `S⁻¹A ⟶ (ST)⁻¹A` inverts every element of `U`. -/
lemma fromLoc_isUnit (y : ↥(imageSubmonoid S T)) : IsUnit (fromLoc S T (y : Localization S)) := by
  obtain ⟨t, ht, hty⟩ := mem_imageSubmonoid.mp y.2
  rw [← hty, fromLoc_algebraMap]
  exact IsLocalization.map_units (Localization (S ⊔ T))
    (⟨t, Submonoid.mem_sup.mpr ⟨1, S.one_mem, t, ht, one_mul t⟩⟩ : ↥(S ⊔ T))

/-- Hence it induces a ring homomorphism `U⁻¹(S⁻¹A) ⟶ (ST)⁻¹A`, the map `(a/s)/(t/1) ↦ a/(s*t)`. -/
noncomputable def bwd : Localization (imageSubmonoid S T) →+* Localization (S ⊔ T) :=
  IsLocalization.lift (S := Localization (imageSubmonoid S T)) (M := imageSubmonoid S T)
    (P := Localization (S ⊔ T)) (g := fromLoc S T) (fromLoc_isUnit S T)

lemma bwd_algebraMap (z : Localization S) :
    bwd S T (algebraMap (Localization S) (Localization (imageSubmonoid S T)) z) =
      fromLoc S T z :=
  IsLocalization.lift_eq _ z

/-- `(a/s)/(t/1) ↦ a/(s*t) ↦ (a/s)/(t/1)`. -/
lemma bwd_fwd : (bwd S T).comp (fwd S T) = RingHom.id (Localization (S ⊔ T)) := by
  refine IsLocalization.ringHom_ext (S ⊔ T) (P := Localization (S ⊔ T)) ?_
  refine RingHom.ext fun a => ?_
  simp only [RingHom.comp_apply, RingHom.id_apply]
  rw [fwd_algebraMap, toLoc, RingHom.comp_apply, bwd_algebraMap, fromLoc_algebraMap]

lemma fwd_fromLoc : (fwd S T).comp (fromLoc S T) =
    algebraMap (Localization S) (Localization (imageSubmonoid S T)) := by
  refine IsLocalization.ringHom_ext S (P := Localization (imageSubmonoid S T)) ?_
  refine RingHom.ext fun a => ?_
  simp only [RingHom.comp_apply]
  rw [fromLoc_algebraMap, fwd_algebraMap]
  rfl

/-- `a/(s*t) ↦ (a/s)/(t/1) ↦ a/(s*t)`. -/
lemma fwd_bwd : (fwd S T).comp (bwd S T) =
    RingHom.id (Localization (imageSubmonoid S T)) := by
  refine IsLocalization.ringHom_ext (imageSubmonoid S T)
    (P := Localization (imageSubmonoid S T)) ?_
  refine RingHom.ext fun z => ?_
  simp only [RingHom.comp_apply, RingHom.id_apply]
  rw [bwd_algebraMap]
  exact RingHom.congr_fun (fwd_fromLoc S T) z

/-- **Atiyah–Macdonald, Exercise 3.3.**  If `S`, `T` are multiplicatively closed subsets of a
commutative ring `A` and `U` is the image of `T` in `S⁻¹A`, then `(ST)⁻¹A` and `U⁻¹(S⁻¹A)` are
isomorphic rings.

In the formalization, `ST` is `S ⊔ T` (the submonoid of products `s * t`, see `mem_sup_iff`) and
`U` is `imageSubmonoid S T`; `U⁻¹(S⁻¹A)` is `Localization (imageSubmonoid S T)`, the
localization of the ring `S⁻¹A` at `U`. -/
noncomputable def solution : Localization (S ⊔ T) ≃+* Localization (imageSubmonoid S T) where
  toFun := fwd S T
  invFun := bwd S T
  left_inv x := RingHom.congr_fun (bwd_fwd S T) x
  right_inv x := RingHom.congr_fun (fwd_bwd S T) x
  map_mul' := map_mul (fwd S T)
  map_add' := map_add (fwd S T)

/-- The isomorphism is `a/1 ↦ a/1`: it is compatible with the canonical maps from `A`. -/
lemma solution_algebraMap (a : A) :
    solution S T (algebraMap A (Localization (S ⊔ T)) a) =
      algebraMap (Localization S) (Localization (imageSubmonoid S T))
        (algebraMap A (Localization S) a) :=
  fwd_algebraMap S T a

/-- The inverse isomorphism sends `z/1 ↦ z/1`: it is compatible with the canonical map from
`S⁻¹A` (there is no `S⁻¹A`-algebra structure on `(ST)⁻¹A` in Mathlib, so this is stated for the
explicit canonical ring homomorphism `fromLoc`). -/
lemma solution_symm_algebraMap (z : Localization S) :
    (solution S T).symm (algebraMap (Localization S) (Localization (imageSubmonoid S T)) z) =
      fromLoc S T z :=
  bwd_algebraMap S T z

/-- **The explicit map of the natural proof**: `a/(s*t) ↦ (a/s)/(t/1)`. -/
lemma solution_mk (a : A) (s : S) (t : T) :
    solution S T (IsLocalization.mk' (Localization (S ⊔ T)) a
        (⟨(s : A) * t, Submonoid.mem_sup.mpr ⟨s, s.2, t, t.2, rfl⟩⟩ : ↥(S ⊔ T))) =
      IsLocalization.mk' (Localization (imageSubmonoid S T))
        (IsLocalization.mk' (Localization S) a s)
        (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ t.2⟩ :
          ↥(imageSubmonoid S T)) := by
  show IsLocalization.lift (toLoc_isUnit S T)
      (IsLocalization.mk' (Localization (S ⊔ T)) a
        (⟨(s : A) * t, Submonoid.mem_sup.mpr ⟨s, s.2, t, t.2, rfl⟩⟩ : ↥(S ⊔ T))) = _
  rw [IsLocalization.lift_mk'_spec]
  have h1 : IsLocalization.mk' (Localization (imageSubmonoid S T))
      (IsLocalization.mk' (Localization S) a s)
      (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ t.2⟩ :
        ↥(imageSubmonoid S T)) *
      algebraMap (Localization S) (Localization (imageSubmonoid S T))
        (algebraMap A (Localization S) t) =
      algebraMap (Localization S) (Localization (imageSubmonoid S T))
        (IsLocalization.mk' (Localization S) a s) :=
    IsLocalization.mk'_spec _ _ _
  have h2 : algebraMap A (Localization S) s * IsLocalization.mk' (Localization S) a s =
      algebraMap A (Localization S) a := by
    rw [mul_comm]; exact IsLocalization.mk'_spec _ _ _
  calc toLoc S T a
      = algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (algebraMap A (Localization S) s * IsLocalization.mk' (Localization S) a s) := by
        rw [h2]; rfl
    _ = algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (algebraMap A (Localization S) s) *
        algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (IsLocalization.mk' (Localization S) a s) := map_mul ..
    _ = algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (algebraMap A (Localization S) s) *
        (IsLocalization.mk' (Localization (imageSubmonoid S T))
            (IsLocalization.mk' (Localization S) a s)
            (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ t.2⟩ :
              ↥(imageSubmonoid S T)) *
          algebraMap (Localization S) (Localization (imageSubmonoid S T))
            (algebraMap A (Localization S) t)) := by
        rw [h1]
    _ = algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (algebraMap A (Localization S) (s * t)) *
        IsLocalization.mk' (Localization (imageSubmonoid S T))
          (IsLocalization.mk' (Localization S) a s)
          (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ t.2⟩ :
            ↥(imageSubmonoid S T)) := by
        rw [map_mul, map_mul]
        ring
    _ = toLoc S T ((s : A) * t) *
        IsLocalization.mk' (Localization (imageSubmonoid S T))
          (IsLocalization.mk' (Localization S) a s)
          (⟨algebraMap A (Localization S) t, Submonoid.mem_map_of_mem _ t.2⟩ :
            ↥(imageSubmonoid S T)) := rfl

/-- The natural proof of Exercise 3.3: the canonical map `A → S⁻¹A → U⁻¹(S⁻¹A)` inverts every
element of `ST` (`toLoc_isUnit`), is surjective and its kernel is computed by `ST`; equivalently,
`U⁻¹(S⁻¹A)` is the localization of `A` at `S ⊔ T` with respect to this map.

(Since Mathlib has no canonical `A`-algebra structure on an iterated localization over `A`, the
algebra structure is given explicitly by `(toLoc S T).toAlgebra`.) -/
theorem isLocalization_image :
    @IsLocalization A _ (S ⊔ T) (Localization (imageSubmonoid S T)) _ (toLoc S T).toAlgebra := by
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    simpa only [RingHom.algebraMap_toAlgebra] using toLoc_isUnit S T y
  · intro z
    obtain ⟨⟨z₁, u⟩, hzu⟩ := IsLocalization.surj (imageSubmonoid S T) z
    obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj S z₁
    obtain ⟨t, ht, htu⟩ := mem_imageSubmonoid.mp u.2
    refine ⟨⟨a, ⟨(t : A) * s, Submonoid.mem_sup.mpr ⟨s, s.2, t, ht, mul_comm (s : A) t⟩⟩⟩, ?_⟩
    simp only [RingHom.algebraMap_toAlgebra]
    have step1 : toLoc S T ((t : A) * s) =
        algebraMap (Localization S) (Localization (imageSubmonoid S T)) (u : Localization S) *
        algebraMap (Localization S) (Localization (imageSubmonoid S T))
          (algebraMap A (Localization S) s) := by
      rw [toLoc, RingHom.comp_apply, map_mul, map_mul, ← htu]
    rw [step1, ← mul_assoc, hzu, ← map_mul, has]
    rfl
  · intro x y hxy
    obtain ⟨⟨u, hu⟩, huxy⟩ :=
      (IsLocalization.eq_iff_exists (imageSubmonoid S T)
        (Localization (imageSubmonoid S T))).mp hxy
    obtain ⟨t, ht, htu⟩ := mem_imageSubmonoid.mp hu
    have h' : algebraMap A (Localization S) (t * x) = algebraMap A (Localization S) (t * y) := by
      rw [map_mul, map_mul, htu]
      exact huxy
    obtain ⟨⟨c, hc⟩, hcxy⟩ := (IsLocalization.eq_iff_exists S (Localization S)).mp h'
    refine ⟨⟨(c : A) * t, Submonoid.mem_sup.mpr ⟨c, hc, t, ht, rfl⟩⟩, ?_⟩
    change (c : A) * t * x = (c : A) * t * y
    calc (c : A) * t * x = c * (t * x) := by ring
      _ = c * (t * y) := hcxy
      _ = (c : A) * t * y := by ring

/-- Exercise 3.3 stated as an existence of a ring isomorphism. -/
theorem exercise_3_3 :
    Nonempty (Localization (S ⊔ T) ≃+* Localization (imageSubmonoid S T)) :=
  ⟨solution S T⟩

end AtiyahMcdonald69.Ex_3_3

namespace AtiyahMcdonald69.Ex_3_3

-- The main exports are constructive and depend only on the standard axioms.
#print axioms solution
#print axioms solution_mk
#print axioms isLocalization_image

end AtiyahMcdonald69.Ex_3_3
