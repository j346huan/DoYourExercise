import Mathlib

/-!
# Atiyah–Macdonald (1969), Chapter 2, Exercise 2

Statement (p. 31 of the 1969 edition):

> Let `A` be a ring, `𝔞` an ideal, `M` an `A`-module. Show that `(A ⧸ 𝔞) ⊗_A M` is isomorphic to
> `M ⧸ 𝔞M`.

Here `𝔞M` is the submodule of `M` generated by the products `a • m`, `a ∈ 𝔞`, `m ∈ M`
(Atiyah–Macdonald, p. 2), i.e. `𝔞 • ⊤` in Mathlib's notation.

## The natural proof, and its audit

The textbook reads the result off from right exactness of the tensor product: tensoring the exact
sequence `0 → 𝔞 → A → A ⧸ 𝔞 → 0` with `M` gives

`𝔞 ⊗_A M → M → (A ⧸ 𝔞) ⊗_A M → 0`,

the first map sends `a ⊗ m` to `am`, so its image is `𝔞M`, and the first isomorphism theorem yields
the required isomorphism `(a mod 𝔞) ⊗ m ↦ am mod 𝔞M`.

Audit of that argument, and how it is reflected below:

* no finiteness hypothesis on `A` or `M` is needed, and none is used here;
* the argument silently uses the canonical identification `A ⊗_A M ≅ M` (`TensorProduct.lid`) and
  the right exactness theorem for `M ⊗ -` (A&M, Proposition 2.18). We use neither: both maps are
  constructed explicitly from universal properties and checked to be mutually inverse. The
  right-exactness statements in this special case are proved separately
  (`range_idealTensorToModule`, `range_tensorMkOne`, `ker_tensorMkOne`, packaged as
  `exact_idealTensor`);
* the argument omits the verification that `(a + 𝔞) ⊗ m ↦ am + 𝔞M` is well defined and
  `A`-linear; here the bilinear map is obtained from the universal property of the quotient
  (`Submodule.liftQ`) followed by the universal property of the tensor product
  (`TensorProduct.lift`);
* the statement is literally true as printed; no counterexample is needed, and there is no
  hypothesis to weaken.

## Main results

* `idealSMul 𝔞 : Submodule A M` is `𝔞M`, with `idealSMul_eq_span` identifying it with the span of
  the products `a • m`;
* `preBilin 𝔞 : A →ₗ[A] M →ₗ[A] M ⧸ 𝔞M` and `bilin 𝔞 : (A ⧸ 𝔞) →ₗ[A] M →ₗ[A] M ⧸ 𝔞M` are the
  bilinear maps `(r, m) ↦ rm + 𝔞M` and `(a + 𝔞, m) ↦ am + 𝔞M`;
* `toQuot 𝔞 : (A ⧸ 𝔞) ⊗[A] M →ₗ[A] M ⧸ 𝔞M` sends `(a + 𝔞) ⊗ m` to `am + 𝔞M`;
  `ofQuot 𝔞 : M ⧸ 𝔞M →ₗ[A] (A ⧸ 𝔞) ⊗[A] M` sends `m + 𝔞M` to `1 ⊗ m`;
* `tensorQuotientEquiv 𝔞 : (A ⧸ 𝔞) ⊗[A] M ≃ₗ[A] M ⧸ 𝔞M` is the isomorphism of the exercise,
  with computation rules `tensorQuotientEquiv_tmul` and `tensorQuotientEquiv_symm_mk`;
* `exact_idealTensor`, `range_idealTensorToModule`, `ker_tensorMkOne`, `range_tensorMkOne` are the
  exactness statements behind the textbook hint;
* `subsingleton_tensor_iff`: `(A ⧸ 𝔞) ⊗_A M` is trivial if and only if `𝔞M = M`;
* `mapQSMul` and `tensorQuotientEquiv_natural`: the isomorphism is natural in `M`, i.e. for every
  `A`-linear map `f : M →ₗ[A] N` the square formed with `TensorProduct.map LinearMap.id f` and
  the induced map `M ⧸ 𝔞M →ₗ[A] N ⧸ 𝔞N` commutes.
-/

open TensorProduct

namespace AtiyahMcdonald69.Ex_2_2

variable {A : Type*} [CommRing A]
variable {M : Type*} [AddCommGroup M] [Module A M]

/-- For an ideal `𝔞` of `A` and an `A`-module `M`, `𝔞M` is the submodule of `M`
generated by the products `a • m` with `a ∈ 𝔞` and `m ∈ M` (Atiyah–Macdonald, p. 2):
Mathlib's `𝔞 • ⊤`. -/
abbrev idealSMul (𝔞 : Ideal A) : Submodule A M := 𝔞 • (⊤ : Submodule A M)

theorem idealSMul_eq_span (𝔞 : Ideal A) :
    idealSMul (M := M) 𝔞 = Submodule.span A {m : M | ∃ a ∈ 𝔞, ∃ n : M, a • n = m} := by
  apply le_antisymm
  · rw [idealSMul, Submodule.smul_le]
    intro r hr n _
    exact Submodule.subset_span ⟨r, hr, n, rfl⟩
  · rw [Submodule.span_le]
    rintro m ⟨a, ha, n, rfl⟩
    exact Submodule.smul_mem_smul ha Submodule.mem_top

/-- The `A`-bilinear map `A × M → M ⧸ 𝔞M`, `(r, m) ↦ rm + 𝔞M`. -/
noncomputable def preBilin (𝔞 : Ideal A) :
    A →ₗ[A] M →ₗ[A] (M ⧸ idealSMul (M := M) 𝔞) where
  toFun r := r • Submodule.mkQ (idealSMul (M := M) 𝔞)
  map_add' r s := by
    ext m
    simp [add_smul]
  map_smul' c r := by
    ext m
    simp [mul_smul]

theorem preBilin_apply (𝔞 : Ideal A) (r : A) (m : M) :
    preBilin (M := M) 𝔞 r m = Submodule.Quotient.mk (r • m) := by
  show r • (Submodule.Quotient.mk m : M ⧸ idealSMul (M := M) 𝔞) = Submodule.Quotient.mk (r • m)
  rw [← Submodule.Quotient.mk_smul]

theorem preBilin_mem_ker (𝔞 : Ideal A) : 𝔞 ≤ LinearMap.ker (preBilin (M := M) 𝔞) := by
  intro r hr
  rw [LinearMap.mem_ker]
  refine LinearMap.ext fun m => ?_
  rw [preBilin_apply, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero]
  exact Submodule.smul_mem_smul hr Submodule.mem_top

/-- The `A`-bilinear map `(A ⧸ 𝔞) × M → M ⧸ 𝔞M`, `(a + 𝔞, m) ↦ am + 𝔞M`. -/
noncomputable def bilin (𝔞 : Ideal A) :
    (A ⧸ 𝔞) →ₗ[A] M →ₗ[A] (M ⧸ idealSMul (M := M) 𝔞) :=
  Submodule.liftQ 𝔞 (preBilin 𝔞) (preBilin_mem_ker 𝔞)

theorem bilin_mk_apply (𝔞 : Ideal A) (r : A) (m : M) :
    bilin (M := M) 𝔞 (Submodule.Quotient.mk r) m = Submodule.Quotient.mk (r • m) := by
  rw [bilin, Submodule.liftQ_apply, preBilin_apply]

theorem bilin_mk_apply' (𝔞 : Ideal A) (r : A) (m : M) :
    bilin (M := M) 𝔞 (Ideal.Quotient.mk 𝔞 r) m = Submodule.Quotient.mk (r • m) := by
  rw [← Ideal.Quotient.mk_eq_mk, bilin_mk_apply]

/-- The `A`-linear map `(A ⧸ 𝔞) ⊗[A] M →ₗ[A] M ⧸ 𝔞M` induced by `bilin`: it sends
`(a + 𝔞) ⊗ m` to `am + 𝔞M`. -/
noncomputable def toQuot (𝔞 : Ideal A) :
    (A ⧸ 𝔞) ⊗[A] M →ₗ[A] (M ⧸ idealSMul (M := M) 𝔞) :=
  TensorProduct.lift (bilin (M := M) 𝔞)

theorem toQuot_tmul (𝔞 : Ideal A) (r : A) (m : M) :
    toQuot (M := M) 𝔞 (Submodule.Quotient.mk r ⊗ₜ[A] m) = Submodule.Quotient.mk (r • m) := by
  rw [toQuot, TensorProduct.lift.tmul, bilin_mk_apply]

theorem toQuot_tmul' (𝔞 : Ideal A) (r : A) (m : M) :
    toQuot (M := M) 𝔞 (Ideal.Quotient.mk 𝔞 r ⊗ₜ[A] m) = Submodule.Quotient.mk (r • m) := by
  rw [← Ideal.Quotient.mk_eq_mk, toQuot_tmul]

theorem toQuot_one_tmul (𝔞 : Ideal A) (m : M) :
    toQuot (M := M) 𝔞 ((1 : A ⧸ 𝔞) ⊗ₜ[A] m) = Submodule.Quotient.mk m := by
  nth_rewrite 1 [show (1 : A ⧸ 𝔞) = Submodule.Quotient.mk (1 : A) from rfl]
  rw [toQuot_tmul, one_smul]

/-- The `A`-linear map `M → (A ⧸ 𝔞) ⊗[A] M`, `m ↦ 1 ⊗ m`. -/
noncomputable def tensorMkOne (𝔞 : Ideal A) : M →ₗ[A] (A ⧸ 𝔞) ⊗[A] M :=
  TensorProduct.mk A (A ⧸ 𝔞) M 1

theorem tensorMkOne_apply (𝔞 : Ideal A) (m : M) :
    tensorMkOne (M := M) 𝔞 m = (1 : A ⧸ 𝔞) ⊗ₜ[A] m := by
  rw [tensorMkOne, TensorProduct.mk_apply]

theorem smul_one_eq_mk (𝔞 : Ideal A) (r : A) :
    r • (1 : A ⧸ 𝔞) = Submodule.Quotient.mk r := by
  nth_rewrite 1 [show (1 : A ⧸ 𝔞) = Submodule.Quotient.mk (1 : A) from rfl]
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]

theorem smul_one_eq_zero (𝔞 : Ideal A) {r : A} (hr : r ∈ 𝔞) : r • (1 : A ⧸ 𝔞) = 0 := by
  rw [smul_one_eq_mk, Submodule.Quotient.mk_eq_zero]
  exact hr

theorem tensorMkOne_mem_ker (𝔞 : Ideal A) :
    idealSMul (M := M) 𝔞 ≤ LinearMap.ker (tensorMkOne (M := M) 𝔞) := by
  rw [idealSMul, Submodule.smul_le]
  intro r hr n _
  rw [LinearMap.mem_ker, tensorMkOne_apply, ← TensorProduct.smul_tmul,
    smul_one_eq_zero 𝔞 hr, TensorProduct.zero_tmul]

/-- The `A`-linear map `M ⧸ 𝔞M → (A ⧸ 𝔞) ⊗[A] M`, `m + 𝔞M ↦ 1 ⊗ m`. It is well defined
because `m ∈ 𝔞M` implies `1 ⊗ m = 0`. -/
noncomputable def ofQuot (𝔞 : Ideal A) :
    (M ⧸ idealSMul (M := M) 𝔞) →ₗ[A] (A ⧸ 𝔞) ⊗[A] M :=
  Submodule.liftQ (idealSMul (M := M) 𝔞) (tensorMkOne 𝔞) (tensorMkOne_mem_ker 𝔞)

theorem ofQuot_mk (𝔞 : Ideal A) (m : M) :
    ofQuot (M := M) 𝔞 (Submodule.Quotient.mk m) = (1 : A ⧸ 𝔞) ⊗ₜ[A] m := by
  rw [ofQuot, Submodule.liftQ_apply, tensorMkOne_apply]

theorem ofQuot_toQuot (𝔞 : Ideal A) (x : (A ⧸ 𝔞) ⊗[A] M) :
    ofQuot (M := M) 𝔞 (toQuot (M := M) 𝔞 x) = x := by
  induction x using TensorProduct.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul y m =>
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective (p := (𝔞 : Submodule A A)) y
    rw [toQuot_tmul, ofQuot_mk, ← TensorProduct.smul_tmul (r := r), smul_one_eq_mk (𝔞 := 𝔞)]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

theorem toQuot_ofQuot (𝔞 : Ideal A) (y : M ⧸ idealSMul (M := M) 𝔞) :
    toQuot (M := M) 𝔞 (ofQuot (M := M) 𝔞 y) = y := by
  obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective (p := idealSMul (M := M) 𝔞) y
  rw [ofQuot_mk, toQuot_one_tmul]

/-- **Atiyah–Macdonald, Chapter 2, Exercise 2.** Let `A` be a commutative ring, `𝔞` an ideal of `A`
and `M` an `A`-module. Then

`(A ⧸ 𝔞) ⊗[A] M ≃ₗ[A] M ⧸ 𝔞M`,

sending `(a + 𝔞) ⊗ m` to `am + 𝔞M`. -/
noncomputable def tensorQuotientEquiv (𝔞 : Ideal A) :
    (A ⧸ 𝔞) ⊗[A] M ≃ₗ[A] (M ⧸ idealSMul (M := M) 𝔞) :=
  LinearEquiv.ofLinearMap (toQuot (M := M) 𝔞) (ofQuot (M := M) 𝔞)
    (LinearMap.ext (toQuot_ofQuot 𝔞)) (LinearMap.ext (ofQuot_toQuot 𝔞))

@[simp]
theorem tensorQuotientEquiv_tmul (𝔞 : Ideal A) (r : A) (m : M) :
    tensorQuotientEquiv (M := M) 𝔞 (Submodule.Quotient.mk r ⊗ₜ[A] m)
      = Submodule.Quotient.mk (r • m) :=
  toQuot_tmul 𝔞 r m

@[simp]
theorem tensorQuotientEquiv_tmul' (𝔞 : Ideal A) (r : A) (m : M) :
    tensorQuotientEquiv (M := M) 𝔞 (Ideal.Quotient.mk 𝔞 r ⊗ₜ[A] m)
      = Submodule.Quotient.mk (r • m) :=
  toQuot_tmul' 𝔞 r m

@[simp]
theorem tensorQuotientEquiv_symm_mk (𝔞 : Ideal A) (m : M) :
    (tensorQuotientEquiv (M := M) 𝔞).symm (Submodule.Quotient.mk m)
      = (1 : A ⧸ 𝔞) ⊗ₜ[A] m :=
  ofQuot_mk 𝔞 m


/-- The `A`-linear map `𝔞 ⊗[A] M →ₗ[A] M`, `a ⊗ m ↦ am`, i.e. the map whose image is
`𝔞M` in the textbook's exact sequence. -/
noncomputable def idealTensorToModule (𝔞 : Ideal A) : (↥𝔞) ⊗[A] M →ₗ[A] M :=
  TensorProduct.lift ((LinearMap.lsmul A M).comp (Submodule.subtype 𝔞))

theorem idealTensorToModule_tmul (𝔞 : Ideal A) (a : ↥𝔞) (m : M) :
    idealTensorToModule (M := M) 𝔞 (a ⊗ₜ[A] m) = (a : A) • m := by
  rw [idealTensorToModule, TensorProduct.lift.tmul, LinearMap.comp_apply,
    LinearMap.lsmul_apply]
  rfl

theorem range_idealTensorToModule (𝔞 : Ideal A) :
    LinearMap.range (idealTensorToModule (M := M) 𝔞) = idealSMul (M := M) 𝔞 := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    induction z using TensorProduct.induction_on with
    | zero => exact (idealSMul (M := M) 𝔞).zero_mem
    | tmul a m =>
      rw [idealTensorToModule_tmul]
      exact Submodule.smul_mem_smul a.2 Submodule.mem_top
    | add z w hz hw =>
      rw [map_add]
      exact (idealSMul (M := M) 𝔞).add_mem hz hw
  · rw [idealSMul, Submodule.smul_le]
    intro r hr n _
    exact ⟨⟨r, hr⟩ ⊗ₜ[A] n, idealTensorToModule_tmul 𝔞 ⟨r, hr⟩ n⟩

theorem range_tensorMkOne (𝔞 : Ideal A) :
    LinearMap.range (tensorMkOne (M := M) 𝔞) = ⊤ := by
  rw [LinearMap.range_eq_top]
  intro z
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | tmul y m =>
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective (p := (𝔞 : Submodule A A)) y
    refine ⟨r • m, ?_⟩
    rw [tensorMkOne_apply, ← TensorProduct.smul_tmul, smul_one_eq_mk]
  | add z w hz hw =>
    obtain ⟨z', rfl⟩ := hz
    obtain ⟨w', rfl⟩ := hw
    exact ⟨z' + w', map_add _ _ _⟩

theorem ker_tensorMkOne (𝔞 : Ideal A) :
    LinearMap.ker (tensorMkOne (M := M) 𝔞) = idealSMul (M := M) 𝔞 := by
  refine le_antisymm ?_ (tensorMkOne_mem_ker 𝔞)
  intro m hm
  rw [LinearMap.mem_ker] at hm
  have hinj : Function.Injective (ofQuot (M := M) 𝔞) := fun x y h => by
    have := congrArg (toQuot (M := M) 𝔞) h
    rwa [toQuot_ofQuot, toQuot_ofQuot] at this
  have hzero : ofQuot (M := M) 𝔞 (Submodule.Quotient.mk m) = ofQuot (M := M) 𝔞 0 := by
    rw [ofQuot_mk, map_zero, ← tensorMkOne_apply]
    exact hm
  exact (Submodule.Quotient.mk_eq_zero (p := idealSMul (M := M) 𝔞)).1 (hinj hzero)

theorem subsingleton_tensor_iff (𝔞 : Ideal A) :
    Subsingleton ((A ⧸ 𝔞) ⊗[A] M) ↔ idealSMul (M := M) 𝔞 = ⊤ := by
  rw [← Submodule.Quotient.subsingleton_iff (p := idealSMul (M := M) 𝔞)]
  exact ⟨fun h => (tensorQuotientEquiv (M := M) 𝔞).symm.injective.subsingleton,
    fun h => (tensorQuotientEquiv (M := M) 𝔞).injective.subsingleton⟩


/-- The exactness content of the textbook hint: the sequence
`𝔞 ⊗_A M → M → (A ⧸ 𝔞) ⊗_A M → 0` is exact, i.e. the image of `𝔞 ⊗_A M → M` is the kernel
of `M → (A ⧸ 𝔞) ⊗_A M`, and the latter map is surjective. -/
theorem exact_idealTensor (𝔞 : Ideal A) :
    LinearMap.range (idealTensorToModule (M := M) 𝔞) = LinearMap.ker (tensorMkOne (M := M) 𝔞)
      ∧ LinearMap.range (tensorMkOne (M := M) 𝔞) = ⊤ :=
  ⟨by rw [range_idealTensorToModule, ker_tensorMkOne], range_tensorMkOne 𝔞⟩

theorem idealSMul_le_comap {N : Type*} [AddCommGroup N] [Module A N] (𝔞 : Ideal A)
    (f : M →ₗ[A] N) : idealSMul (M := M) 𝔞 ≤ Submodule.comap f (idealSMul (M := N) 𝔞) := by
  rw [idealSMul, Submodule.smul_le]
  intro r hr m _
  rw [Submodule.mem_comap, map_smul]
  exact Submodule.smul_mem_smul hr Submodule.mem_top

/-- The map `M ⧸ 𝔞M →ₗ[A] N ⧸ 𝔞N` induced by an `A`-linear map `f : M →ₗ[A] N`, showing that the
isomorphism `tensorQuotientEquiv` is natural in `M`. -/
noncomputable def mapQSMul (𝔞 : Ideal A) {N : Type*} [AddCommGroup N] [Module A N]
    (f : M →ₗ[A] N) :
    (M ⧸ idealSMul (M := M) 𝔞) →ₗ[A] (N ⧸ idealSMul (M := N) 𝔞) :=
  Submodule.mapQ _ _ f (idealSMul_le_comap 𝔞 f)

theorem mapQSMul_mk (𝔞 : Ideal A) {N : Type*} [AddCommGroup N] [Module A N]
    (f : M →ₗ[A] N) (m : M) :
    mapQSMul (M := M) 𝔞 f (Submodule.Quotient.mk m) = Submodule.Quotient.mk (f m) :=
  Submodule.mapQ_apply _ _ _ _

theorem tensorQuotientEquiv_natural (𝔞 : Ideal A) {N : Type*} [AddCommGroup N] [Module A N]
    (f : M →ₗ[A] N) (x : (A ⧸ 𝔞) ⊗[A] M) :
    tensorQuotientEquiv (M := N) 𝔞 (TensorProduct.map LinearMap.id f x)
      = mapQSMul (M := M) 𝔞 f (tensorQuotientEquiv (M := M) 𝔞 x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul y m =>
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective (p := (𝔞 : Submodule A A)) y
    simp only [TensorProduct.map_tmul, LinearMap.id_apply, tensorQuotientEquiv_tmul, mapQSMul_mk,
      map_smul]
  | add x y hx hy => simp only [map_add, hx, hy]



/-! ### Axiom checks on the principal exports -/

namespace AtiyahMcdonald69.Ex_2_2

#print axioms tensorQuotientEquiv
#print axioms tensorQuotientEquiv_tmul
#print axioms tensorQuotientEquiv_tmul'
#print axioms tensorQuotientEquiv_symm_mk
#print axioms idealSMul_eq_span
#print axioms range_idealTensorToModule
#print axioms range_tensorMkOne
#print axioms ker_tensorMkOne
#print axioms exact_idealTensor
#print axioms subsingleton_tensor_iff
#print axioms tensorQuotientEquiv_natural

end AtiyahMcdonald69.Ex_2_2
