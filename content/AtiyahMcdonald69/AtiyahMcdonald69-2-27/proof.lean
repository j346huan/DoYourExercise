set_option maxHeartbeats 1000000

/-!
# Atiyah–Macdonald (1969), Chapter 2, Exercise 27

Standalone formalisation of Exercise 27 of Chapter 2 of M. F. Atiyah and I. G. Macdonald,
*Introduction to Commutative Algebra*, Addison–Wesley, 1969.

The exercise states: for a ring `A`, the following conditions are equivalent.

(i) `A` is *absolutely flat* (every `A`-module is flat).
(ii) Every principal ideal of `A` is idempotent.
(iii) Every finitely generated ideal of `A` is a direct summand of `A`.

As throughout Atiyah–Macdonald, all rings are commutative with identity, so `A` is a
`CommRing`.  The statement is true as printed; no hypothesis is missing, so no counterexample
to the literal statement is required (the last section records instead two examples showing
that the conditions are not vacuous: a field satisfies them, `ℤ` does not).

The book's proof is formalised literally:

* (i) ⇒ (ii): if `A` is absolutely flat then `A ⧸ I` is flat, so tensoring the inclusion
  `I → A` with `A ⧸ I` yields an injection `I ⊗[A] A ⧸ I → A ⊗[A] A ⧸ I`. That map is
  zero (every element of `I` acts as zero on `A ⧸ I`), hence `I ⊗[A] A ⧸ I = 0`.
  Since `I ⊗[A] A ⧸ I ≃ I ⧸ I ^ 2` (Exercise 2.2), `I = I ^ 2`.
* (ii) ⇒ (iii): write `x = a * x ^ 2`, then `e = a * x` is idempotent with `(e) = (x)`;
  the sum of two idempotent ideals is idempotent, so a finitely generated idempotent ideal
  is principal generated by an idempotent, and `A = (e) ⊕ (1 - e)`.
* (iii) ⇒ (i): the inclusion `I → A` of a finitely generated ideal splits, so it stays
  injective after tensoring with any module; the ideal criterion for flatness then gives
  that every module is flat.
-/

namespace AtiyahMcdonald69.Ex_2_27

open TensorProduct

open scoped TensorProduct

universe u

/-- Condition (i) of Exercise 2.27: `A` is *absolutely flat*, i.e. every `A`-module is flat. -/
def AbsolutelyFlat (A : Type u) [CommRing A] : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M

/-- Condition (ii) of Exercise 2.27: every principal ideal of `A` is idempotent, that is,
`(x) ^ 2 = (x)` for every `x : A`. -/
def PrincipalIdempotent (A : Type u) [CommRing A] : Prop :=
  ∀ x : A, IsIdempotentElem (Ideal.span {x})

/-- Condition (iii) of Exercise 2.27: every finitely generated ideal of `A` is a direct
summand of `A` (as an `A`-module). -/
def FGDirectSummand (A : Type u) [CommRing A] : Prop :=
  ∀ I : Ideal A, I.FG → ∃ J : Ideal A, IsCompl I J

variable {A : Type u} [CommRing A]

/-! ## The tensor product computation of (i) ⇒ (ii) -/

/-- An element of the quotient `A ⧸ I` is annihilated by every element of `I`. -/
theorem smul_quotient_eq_zero (I : Ideal A) (i : I) (m : A ⧸ I) : (i : A) • m = 0 := by
  rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr i.2,
    zero_mul]

/-- The multiplication map `I ⊗[A] (A ⧸ I) → A ⊗[A] (A ⧸ I)` is zero: the image of a pure
tensor `i ⊗ m` is `i ⊗ m`, which is `0` because `i` kills `A ⧸ I`. -/
theorem rTensor_subtype_quotient_apply_eq_zero (I : Ideal A) (i : I) (m : A ⧸ I) :
    I.subtype.rTensor (A ⧸ I) (i ⊗ₜ[A] m) = 0 := by
  rw [LinearMap.rTensor_tmul]
  have h : TensorProduct.lid A (A ⧸ I) ((i : A) ⊗ₜ[A] m) = 0 := by
    rw [TensorProduct.lid_tmul, smul_quotient_eq_zero]
  exact (TensorProduct.lid A (A ⧸ I)).injective (by simp [h])

/-- The map `I ⊗[A] (A ⧸ I) → A ⊗[A] (A ⧸ I)` induced by the inclusion `I → A` is zero. -/
theorem rTensor_subtype_quotient_eq_zero (I : Ideal A) :
    I.subtype.rTensor (A ⧸ I) = 0 :=
  TensorProduct.ext' fun i m => rTensor_subtype_quotient_apply_eq_zero I i m

/-- If `A` is absolutely flat then `I ⊗[A] A ⧸ I = 0` for every ideal `I`. -/
theorem subsingleton_tensor_quotient (h : AbsolutelyFlat A) (I : Ideal A) :
    Subsingleton (I ⊗[A] (A ⧸ I)) := by
  have hinj : Function.Injective (I.subtype.rTensor (A ⧸ I)) :=
    (Module.Flat.iff_rTensor_injective'.mp (h (A ⧸ I))) I
  have hzero : I.subtype.rTensor (A ⧸ I) = 0 := rTensor_subtype_quotient_eq_zero I
  refine ⟨fun x y => ?_⟩
  have hx : x = 0 := hinj (by simp [hzero])
  have hy : y = 0 := hinj (by simp [hzero])
  rw [hx, hy]

/-- Exercise 2.2: `I ⊗[A] A ⧸ I ≃ I ⧸ I ^ 2`. -/
noncomputable def tensorQuotEquivCotangent (I : Ideal A) :
    (I ⊗[A] (A ⧸ I)) ≃ₗ[A] I.Cotangent :=
  TensorProduct.tensorQuotEquivQuotSMul I I

/-- `I ⊗[A] A ⧸ I = 0` forces `I ^ 2 = I`. -/
theorem isIdempotentElem_of_subsingleton_tensor (I : Ideal A)
    (h : Subsingleton (I ⊗[A] (A ⧸ I))) : IsIdempotentElem I := by
  refine (Ideal.cotangent_subsingleton_iff I).mp (Subsingleton.intro fun x y => ?_)
  exact (tensorQuotEquivCotangent I).symm.injective
    (@Subsingleton.elim (I ⊗[A] (A ⧸ I)) h ((tensorQuotEquivCotangent I).symm x)
      ((tensorQuotEquivCotangent I).symm y))

/-- (i) ⇒ (ii). -/
theorem absolutelyFlat_implies_principalIdempotent (h : AbsolutelyFlat A) :
    PrincipalIdempotent A :=
  fun x => isIdempotentElem_of_subsingleton_tensor (Ideal.span {x})
    (subsingleton_tensor_quotient h (Ideal.span {x}))

/-! ## (ii) ⇒ (iii): finitely generated idempotent ideals are generated by an idempotent -/

/-- The sum of two idempotent ideals is idempotent. -/
theorem isIdempotentElem_sup {I J : Ideal A} (hI : IsIdempotentElem I)
    (hJ : IsIdempotentElem J) : IsIdempotentElem (I ⊔ J) := by
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
    refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
    · exact le_trans (le_of_eq hI) le_sup_left
    · exact Ideal.mul_le_left.trans le_sup_left
    · exact Ideal.mul_le_right.trans le_sup_left
    · exact le_trans (le_of_eq hJ) le_sup_right
  · exact le_trans (le_of_eq hI.symm) (Ideal.mul_mono le_sup_left le_sup_left)
  · exact le_trans (le_of_eq hJ.symm) (Ideal.mul_mono le_sup_right le_sup_right)

/-- If every principal ideal is idempotent then every finitely generated ideal is
idempotent. -/
theorem isIdempotentElem_of_fg (h : PrincipalIdempotent A) ⦃I : Ideal A⦄ (hI : I.FG) :
    IsIdempotentElem I := by
  induction I, hI using Submodule.fg_sup_span_induction with
  | bot => simp [IsIdempotentElem]
  | sup N x hN ih =>
    have hx : IsIdempotentElem (A ∙ x : Ideal A) := h x
    exact isIdempotentElem_sup ih hx

/-- If `e` is idempotent then `A = (e) ⊕ (1 - e)`, i.e. `(e)` is a direct summand with
complement `(1 - e)`. -/
theorem isCompl_span_one_sub {e : A} (he : IsIdempotentElem e) :
    IsCompl (Ideal.span {e}) (Ideal.span {1 - e}) := by
  constructor
  · rw [disjoint_iff_inf_le]
    intro z hz
    rw [Submodule.mem_inf] at hz
    obtain ⟨hz₁, hz₂⟩ := hz
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hz₁
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hz₂
    rw [Submodule.mem_bot]
    have h1 : z * e = z := by rw [← ha, mul_assoc, he]
    have h2 : z * e = 0 := by rw [← hb, mul_assoc, he.one_sub_mul_self, mul_zero]
    rw [← h1, h2]
  · rw [codisjoint_iff_le_sup]
    intro y _
    have h1 : y * e ∈ Ideal.span ({e} : Set A) ⊔ Ideal.span ({1 - e} : Set A) :=
      Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨y, rfl⟩)
    have h2 : y * (1 - e) ∈ Ideal.span ({e} : Set A) ⊔ Ideal.span ({1 - e} : Set A) :=
      Ideal.mem_sup_right (Ideal.mem_span_singleton'.mpr ⟨y, rfl⟩)
    have hy : y = y * e + y * (1 - e) := by ring
    rw [hy]
    exact add_mem h1 h2

/-- (ii) ⇒ (iii). -/
theorem principalIdempotent_implies_fgDirectSummand (h : PrincipalIdempotent A) :
    FGDirectSummand A := by
  intro I hI
  obtain ⟨e, he, hIe⟩ := (Ideal.isIdempotentElem_iff_of_fg I hI).mp (isIdempotentElem_of_fg h hI)
  exact ⟨Ideal.span {1 - e}, hIe ▸ isCompl_span_one_sub he⟩

/-! ## (iii) ⇒ (i): direct summands split, and the ideal criterion for flatness -/

/-- If `I` is a direct summand of `A` then the inclusion `I → A` remains injective after
tensoring with any module. -/
theorem injective_rTensor_subtype_of_isCompl {I J : Ideal A} (hIJ : IsCompl I J) (M : Type u)
    [AddCommGroup M] [Module A M] : Function.Injective (I.subtype.rTensor M) := by
  have hp : (Submodule.projectionOnto I J hIJ).comp I.subtype = LinearMap.id := by
    ext x
    simp
  have hcomp : ((Submodule.projectionOnto I J hIJ).rTensor M).comp (I.subtype.rTensor M) =
      LinearMap.id := by
    rw [← LinearMap.rTensor_comp, hp, LinearMap.rTensor_id]
  refine Function.LeftInverse.injective (g := (Submodule.projectionOnto I J hIJ).rTensor M) ?_
  intro x
  have hx := LinearMap.congr_fun hcomp x
  simpa using hx

/-- (iii) ⇒ (i). -/
theorem fgDirectSummand_implies_absolutelyFlat (h : FGDirectSummand A) : AbsolutelyFlat A := by
  intro M _ _
  rw [Module.Flat.iff_rTensor_injective]
  intro I hI
  obtain ⟨J, hJ⟩ := h I hI
  exact injective_rTensor_subtype_of_isCompl hJ M

/-! ## The three equivalences of Exercise 2.27 -/

/-- Exercise 2.27, (i) ⇔ (ii). -/
theorem absolutelyFlat_iff_principalIdempotent :
    AbsolutelyFlat A ↔ PrincipalIdempotent A :=
  ⟨absolutelyFlat_implies_principalIdempotent,
    fun h => fgDirectSummand_implies_absolutelyFlat (principalIdempotent_implies_fgDirectSummand h)⟩

/-- Exercise 2.27, (ii) ⇔ (iii). -/
theorem principalIdempotent_iff_fgDirectSummand :
    PrincipalIdempotent A ↔ FGDirectSummand A :=
  ⟨principalIdempotent_implies_fgDirectSummand,
    fun h => absolutelyFlat_implies_principalIdempotent (fgDirectSummand_implies_absolutelyFlat h)⟩

/-- Exercise 2.27, (iii) ⇔ (i). -/
theorem fgDirectSummand_iff_absolutelyFlat :
    FGDirectSummand A ↔ AbsolutelyFlat A :=
  ⟨fgDirectSummand_implies_absolutelyFlat,
    fun h => principalIdempotent_implies_fgDirectSummand (absolutelyFlat_implies_principalIdempotent h)⟩

/-! ## Remarks: the meaning of (iii), and non-vacuity -/

/-- `(x)` is idempotent exactly when `(x ^ 2) = (x)`, the form in which the book uses
condition (ii). -/
theorem isIdempotentElem_span_iff (x : A) :
    IsIdempotentElem (Ideal.span {x}) ↔ Ideal.span {x * x} = Ideal.span {x} := by
  rw [IsIdempotentElem, Ideal.span_singleton_mul_span_singleton]

/-- Condition (ii) in the form `(x ^ 2) = (x)` for every `x`. -/
theorem principalIdempotent_iff_span_sq :
    PrincipalIdempotent A ↔ ∀ x : A, Ideal.span {x * x} = Ideal.span {x} :=
  ⟨fun h x => (isIdempotentElem_span_iff x).mp (h x),
    fun h x => (isIdempotentElem_span_iff x).mpr (h x)⟩

/-- Condition (iii) says precisely that a finitely generated ideal is a direct summand of the
`A`-module `A`: the module `A` splits as `I × J`. -/
theorem exists_prod_linearEquiv_of_fgDirectSummand (h : FGDirectSummand A) (I : Ideal A)
    (hI : I.FG) : ∃ J : Ideal A, Nonempty ((I × J) ≃ₗ[A] A) := by
  obtain ⟨J, hJ⟩ := h I hI
  exact ⟨J, ⟨Submodule.prodEquivOfIsCompl I J hJ⟩⟩

/-- `ℤ` is not absolutely flat, since `(2) ^ 2 = (4) ≠ (2)`: condition (ii) fails.  This shows
that the conditions of Exercise 2.27 are not vacuous. -/
theorem not_absolutelyFlat_int : ¬ AbsolutelyFlat ℤ := by
  intro h
  have hidem : IsIdempotentElem (Ideal.span {(2 : ℤ)}) :=
    absolutelyFlat_implies_principalIdempotent h 2
  have hmem : (2 : ℤ) ∈ Ideal.span {(2 : ℤ)} * Ideal.span {(2 : ℤ)} := by
    rw [hidem]
    exact Ideal.mem_span_singleton_self 2
  rw [Ideal.span_singleton_mul_span_singleton] at hmem
  have hdvd : ((2 : ℤ) * 2) ∣ 2 := Ideal.mem_span_singleton.mp hmem
  have h4 : (2 : ℤ) * 2 = 4 := by norm_num
  rw [h4] at hdvd
  have hle : (4 : ℤ) ≤ 2 := Int.le_of_dvd (by norm_num) hdvd
  exact absurd hle (by norm_num)

/-- Atiyah–Macdonald, Chapter 2, Exercise 27: the three conditions are equivalent. -/
theorem tfae :
    AbsolutelyFlat A ↔ PrincipalIdempotent A ∧ FGDirectSummand A :=
  ⟨fun h => ⟨absolutelyFlat_implies_principalIdempotent h,
      principalIdempotent_implies_fgDirectSummand
        (absolutelyFlat_implies_principalIdempotent h)⟩,
    fun h => fgDirectSummand_implies_absolutelyFlat h.2⟩

/-- Atiyah–Macdonald, Chapter 2, Exercise 27: pairwise form. -/
theorem tfae' :
    (AbsolutelyFlat A ↔ PrincipalIdempotent A) ∧
      (PrincipalIdempotent A ↔ FGDirectSummand A) ∧
      (FGDirectSummand A ↔ AbsolutelyFlat A) :=
  ⟨absolutelyFlat_iff_principalIdempotent, principalIdempotent_iff_fgDirectSummand,
    fgDirectSummand_iff_absolutelyFlat⟩

/-- A field is absolutely flat: every module over a field is free, hence flat.  Together with
`not_absolutelyFlat_int` this shows that Exercise 2.27 separates rings. -/
theorem absolutelyFlat_of_field (K : Type u) [Field K] : AbsolutelyFlat K := by
  intro M _ _
  infer_instance

/-- The step of the book "write `x = a * x ^ 2`, then `e = a * x` is idempotent and
`(e) = (x)`": a principal idempotent ideal is generated by an idempotent element. -/
theorem exists_isIdempotentElem_of_span (h : PrincipalIdempotent A) (x : A) :
    ∃ e : A, IsIdempotentElem e ∧ Ideal.span {x} = A ∙ e :=
  (Ideal.isIdempotentElem_iff_of_fg (Ideal.span {x})
    (Submodule.fg_span_singleton x)).mp (h x)

/-- Cross-check of (i) ⇒ (ii) through Mathlib's `Ideal.Pure`: if `A ⧸ I` is flat then
`I ⊓ J = I * J` for every ideal `J` (this is `Ideal.inf_eq_mul_of_pure`, the tensor-product
computation in Mathlib's form), and with `J = I` this says `I ^ 2 = I`. -/
theorem isIdempotentElem_of_pure (I : Ideal A) [I.Pure] : IsIdempotentElem I := by
  have h2 : I ⊓ I = I * I := Ideal.inf_eq_mul_of_pure I I
  rw [inf_idem] at h2
  exact h2.symm

end AtiyahMcdonald69.Ex_2_27

