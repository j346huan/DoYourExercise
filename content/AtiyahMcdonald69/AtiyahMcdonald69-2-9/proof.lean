/-
Atiyah--Macdonald, *Introduction to Commutative Algebra* (1969),
Chapter 2 (Modules), Exercise 9.

The literal statement of the 1969 text (Chapter 2, Exercises, no. 9; see also
the local transcription `.scratch/reference/atiyah-macdonald-original.txt`,
line 1482) is

  "Let  0 --> M' --> M --> M'' --> 0  be an exact sequence of A-modules.
   If M' and M'' are finitely generated, then so is M."

Note that it is a one-directional implication: nothing is asserted about
`M'` being finitely generated when `M` is (and that converse is false in
general; see the counterexample at the end of this file).

Formalization choices (all dictated by the textbook):

* `A` is a commutative ring, as everywhere in Atiyah--Macdonald.
* "finitely generated A-module" is Mathlib's `Module.Finite A M`, i.e.
  `(⊤ : Submodule A M).FG`, the span of a finite set is everything.
* "`0 → M' --f--> M --g--> M'' → 0` is exact" is `Function.Injective f`
  (exactness at `M'`), `LinearMap.range f = LinearMap.ker g` (exactness at
  `M`) and `Function.Surjective g` (exactness at `M''`).

The proof is the textbook one: take finitely many generators of `M''`, lift
each of them along the surjection `M → M''`, and add the images in `M` of
finitely many generators of `M'`; these finitely many elements generate `M`
(the difference of any `m : M` and a suitable linear combination of the lifts
lies in `ker g = range f`).

Nothing from Mathlib's `Module.Finite.of_exact` (which *is* this exercise) is
used; the argument is carried out from the elementary finiteness lemmas
`Submodule.fg_span`, `Submodule.FG.map` and `Submodule.FG.sup`.
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_2_9

variable {A : Type*} [CommRing A]
variable {M' M M'' : Type*}
variable [AddCommGroup M'] [Module A M']
variable [AddCommGroup M] [Module A M]
variable [AddCommGroup M''] [Module A M'']

/-! ## Exercise 2.9 -/

/-- **Exercise 2.9, key step.**  Let `M' --f--> M --g--> M''` be exact at `M`
(`range f = ker g`) and let `g` be surjective.  If `M'` and `M''` are finitely
generated `A`-modules, then so is `M`.

This is the part of the textbook hypothesis that the argument actually uses;
injectivity of `f` and exactness at `M'` are not needed (see
`module_finite_of_short_exact` for the literal statement). -/
theorem module_finite_of_range_eq_ker
    (f : M' →ₗ[A] M) (g : M →ₗ[A] M'')
    (hker : LinearMap.range f = LinearMap.ker g) (hsurj : Function.Surjective g)
    (hM' : Module.Finite A M') (hM'' : Module.Finite A M'') :
    Module.Finite A M := by
  classical
  -- Finitely many generators of `M''` ...
  obtain ⟨n'', s'', hs''⟩ := Module.Finite.exists_fin (R := A) (M := M'')
  -- ... and arbitrary lifts of them to `M`.
  set y : Fin n'' → M := fun i => Classical.choose (hsurj (s'' i)) with hy_def
  have hy : ∀ i, g (y i) = s'' i := fun i => Classical.choose_spec (hsurj (s'' i))
  -- The submodule generated by these lifts.
  set N : Submodule A M := Submodule.span A (Set.range y) with hN_def
  have hN : N.FG := Submodule.fg_span (Set.finite_range y)
  -- The image of `M'` is finitely generated.
  have hfg' : (⊤ : Submodule A M').FG := Module.finite_def.mp hM'
  have hR : (LinearMap.range f).FG := by
    have h := Submodule.FG.map (f := f) hfg'
    rwa [Submodule.map_top] at h
  -- `range f` and `N` together cover `M`.
  have hsup : LinearMap.range f ⊔ N = ⊤ := by
    rw [eq_top_iff]
    intro m _
    -- `g m` lies in the image of `N`, because `g` maps the lifts onto generators.
    have hmap : Submodule.map g N = Submodule.span A (Set.range s'') := by
      rw [hN_def, Submodule.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, (hy i).symm⟩
      · rintro ⟨i, rfl⟩
        exact ⟨y i, ⟨i, rfl⟩, hy i⟩
    have hgm : g m ∈ Submodule.map g N := by
      rw [hmap, hs'']
      exact Submodule.mem_top
    obtain ⟨n, hn, hgn⟩ := hgm
    -- Hence `m - n` lies in `ker g = range f`.
    have hmem : m - n ∈ LinearMap.range f := by
      rw [hker, LinearMap.mem_ker, map_sub, hgn, sub_self]
    obtain ⟨m', hm'⟩ := hmem
    have hmn : m = f m' + n := by
      rw [hm']
      abel
    rw [hmn]
    exact Submodule.add_mem_sup (LinearMap.mem_range.mpr ⟨m', rfl⟩) hn
  -- A supremum of two finitely generated submodules is finitely generated.
  exact Module.Finite.of_fg_top (hsup ▸ Submodule.FG.sup hR hN)

/-- **Atiyah–Macdonald (1969), Chapter 2, Exercise 9.**

Let `0 → M' → M → M'' → 0` be an exact sequence of `A`-modules: `f` is
injective, `g` is surjective and `range f = ker g`.  If `M'` and `M''` are
finitely generated `A`-modules, then so is `M`. -/
theorem module_finite_of_short_exact
    (f : M' →ₗ[A] M) (g : M →ₗ[A] M'')
    (_hinj : Function.Injective f) (hsurj : Function.Surjective g)
    (hexact : LinearMap.range f = LinearMap.ker g)
    (hM' : Module.Finite A M') (hM'' : Module.Finite A M'') :
    Module.Finite A M :=
  module_finite_of_range_eq_ker f g hexact hsurj hM' hM''

/-- Atiyah--Macdonald, Chapter 2, Exercise 9, under a name matching the
exercise number. -/
theorem exercise_2_9
    (f : M' →ₗ[A] M) (g : M →ₗ[A] M'')
    (hinj : Function.Injective f) (hsurj : Function.Surjective g)
    (hexact : LinearMap.range f = LinearMap.ker g)
    (hM' : Module.Finite A M') (hM'' : Module.Finite A M'') :
    Module.Finite A M :=
  module_finite_of_short_exact f g hinj hsurj hexact hM' hM''

/-- Exercise 2.9 with exactness of the whole sequence stated through
`Function.Exact` for the pair `(f, g)` together with injectivity of `f` and
surjectivity of `g`. -/
theorem module_finite_of_exact
    (f : M' →ₗ[A] M) (g : M →ₗ[A] M'')
    (hex : Function.Exact f g) (_hinj : Function.Injective f)
    (hsurj : Function.Surjective g)
    (hM' : Module.Finite A M') (hM'' : Module.Finite A M'') :
    Module.Finite A M :=
  module_finite_of_range_eq_ker f g (LinearMap.exact_iff.mp hex).symm hsurj hM' hM''

/-- The companion direction that needs no hypothesis on the ring: a surjective
image of a finitely generated module is finitely generated (`M''` in the
exercise).  (The same direction for `M'` is false in general over a
non-Noetherian ring, which is exactly why Exercise 2.9 is stated as an
implication and not as an equivalence.) -/
theorem module_finite_of_surjective
    (g : M →ₗ[A] M'') (hsurj : Function.Surjective g)
    (hM : Module.Finite A M) : Module.Finite A M'' :=
  Module.Finite.of_surjective g hsurj

/-- The textbook construction, made explicit: if `s'` generates `M'`, and `y`
lifts a generating family `s''` of `M''` (so `g (y i) = s'' i`), then the
family `Sum.elim (fun i => f (s' i)) y` generates `M`.  This is precisely the
"two finite sets therefore generate `M`" of the natural proof. -/
theorem span_union_lifts_eq_top
    {ι' ι'' : Type*} (f : M' →ₗ[A] M) (g : M →ₗ[A] M'')
    (hker : LinearMap.range f = LinearMap.ker g)
    (s' : ι' → M') (hs' : Submodule.span A (Set.range s') = ⊤)
    (s'' : ι'' → M'') (hs'' : Submodule.span A (Set.range s'') = ⊤)
    (y : ι'' → M) (hy : ∀ i, g (y i) = s'' i) :
    Submodule.span A (Set.range (Sum.elim (fun i => f (s' i)) y)) = ⊤ := by
  classical
  have hrange : Set.range (Sum.elim (fun i => f (s' i)) y)
      = Set.range (fun i => f (s' i)) ∪ Set.range y := by
    ext z
    constructor
    · rintro ⟨i | i, rfl⟩
      · exact Or.inl ⟨i, rfl⟩
      · exact Or.inr ⟨i, rfl⟩
    · rintro (⟨i, rfl⟩ | ⟨i, rfl⟩)
      · exact ⟨Sum.inl i, rfl⟩
      · exact ⟨Sum.inr i, rfl⟩
  rw [hrange, Submodule.span_union]
  rw [eq_top_iff]
  intro m _
  have hmap : Submodule.map g (Submodule.span A (Set.range y))
      = Submodule.span A (Set.range s'') := by
    rw [Submodule.map_span]
    congr 1
    ext z
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, (hy i).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨y i, ⟨i, rfl⟩, hy i⟩
  have hgm : g m ∈ Submodule.map g (Submodule.span A (Set.range y)) := by
    rw [hmap, hs'']
    exact Submodule.mem_top
  obtain ⟨n, hn, hgn⟩ := hgm
  have hmem : m - n ∈ LinearMap.range f := by
    rw [hker, LinearMap.mem_ker, map_sub, hgn, sub_self]
  obtain ⟨m', hm'⟩ := hmem
  have himage : f '' Set.range s' = Set.range (fun i => f (s' i)) := by
    ext z
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨s' i, ⟨i, rfl⟩, rfl⟩
  have hm'span : f m' ∈ Submodule.span A (Set.range (fun i => f (s' i))) := by
    have h1 : m' ∈ Submodule.span A (Set.range s') := by rw [hs']; exact Submodule.mem_top
    have h2 : f m' ∈ Submodule.map f (Submodule.span A (Set.range s')) :=
      Submodule.mem_map_of_mem h1
    rw [Submodule.map_span, himage] at h2
    exact h2
  have hmn : m = f m' + n := by
    rw [hm']
    abel
  rw [hmn]
  exact Submodule.add_mem_sup hm'span hn


/-! ## Audit: the converse implication fails

Exercise 2.9 is stated as an implication and cannot be strengthened to an
equivalence: over the non-Noetherian ring `ℕ → ℚ` (all functions `ℕ → ℚ`,
with pointwise operations) the ideal `finitelySupported` of finitely supported
sequences is not finitely generated, yet it is the kernel of the surjection
`(ℕ → ℚ) → (ℕ → ℚ) ⧸ finitelySupported` onto a quotient of the finitely
generated module `ℕ → ℚ`.  So `M` and `M''` finitely generated do **not**
force `M'` finitely generated; only the direction proved above holds (and the
`M''`-side is automatic, see `module_finite_of_surjective`).
-/

/-- A sequence `x : ℕ → ℚ` has finite support if it vanishes at all but finitely
many coordinates. -/
def FinSupp (x : ℕ → ℚ) : Prop := (Function.support x).Finite

theorem finSupp_zero : FinSupp (0 : ℕ → ℚ) := by
  rw [FinSupp, Function.support_zero]
  exact Set.finite_empty

theorem finSupp_add {a b : ℕ → ℚ} (ha : FinSupp a) (hb : FinSupp b) : FinSupp (a + b) := by
  refine Set.Finite.subset (ha.union hb) ?_
  intro n hn
  by_contra h
  simp only [Set.mem_union, Function.mem_support, not_or, not_not] at h
  exact hn (by rw [Pi.add_apply, h.1, h.2, add_zero])

theorem finSupp_smul (c : ℕ → ℚ) {x : ℕ → ℚ} (hx : FinSupp x) : FinSupp (c • x) := by
  refine Set.Finite.subset hx ?_
  intro n hn
  simp only [Function.mem_support] at hn
  intro h
  exact hn (by simp [h])

/-- The finitely supported sequences form an ideal of the product ring `ℕ → ℚ`. -/
def finitelySupported : Ideal (ℕ → ℚ) where
  carrier := {x | FinSupp x}
  add_mem' := fun ha hb => finSupp_add ha hb
  zero_mem' := finSupp_zero
  smul_mem' := fun c _ hx => finSupp_smul c hx

theorem mem_finitelySupported {x : ℕ → ℚ} : x ∈ finitelySupported ↔ FinSupp x := Iff.rfl

/-- The coordinate hyperplane `{x | x j = 0}` as a submodule of the product ring. -/
def evalZeroSubmodule (j : ℕ) : Submodule (ℕ → ℚ) (ℕ → ℚ) where
  carrier := {x | x j = 0}
  add_mem' := by
    intro a b ha hb
    show a j + b j = 0
    rw [ha, hb, add_zero]
  zero_mem' := by
    show (0 : ℕ → ℚ) j = 0
    exact rfl
  smul_mem' := by
    intro c x hx
    show c j * x j = 0
    rw [hx, mul_zero]

theorem mem_evalZeroSubmodule {j : ℕ} {x : ℕ → ℚ} : x ∈ evalZeroSubmodule j ↔ x j = 0 := Iff.rfl

/-- Over the non-Noetherian ring `ℕ → ℚ`, the ideal of finitely supported
sequences is not finitely generated. -/
theorem finitelySupported_not_fg :
    ¬ Submodule.FG (finitelySupported : Submodule (ℕ → ℚ) (ℕ → ℚ)) := by
  classical
  rintro ⟨S, hS⟩
  -- every member of `S` lies in the ideal, hence has finite support
  have hfin : ∀ s ∈ S, FinSupp s := by
    intro s hs
    have hmem : s ∈ finitelySupported := by
      rw [← hS]
      exact Submodule.subset_span (by simpa using hs)
    exact mem_finitelySupported.mp hmem
  -- a coordinate occurring in none of the finitely many generators
  set T : Finset ℕ := S.attach.biUnion (fun s => (hfin s.1 s.2).toFinset) with hT
  obtain ⟨j, hj⟩ : ∃ j : ℕ, j ∉ T := by
    obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range T
    exact ⟨n, fun h => absurd (hn h) (by simp)⟩
  have hzero_of_mem : ∀ s ∈ S, s j = 0 := by
    intro s hs
    have hnot : j ∉ (hfin s hs).toFinset := by
      intro h
      refine hj ?_
      rw [hT]
      exact Finset.mem_biUnion.mpr ⟨⟨s, hs⟩, Finset.mem_attach S ⟨s, hs⟩, h⟩
    by_contra hne
    exact hnot ((hfin s hs).mem_toFinset.mpr (by simpa [Function.mem_support] using hne))
  -- hence everything in the span of `S` vanishes at `j`
  have hsub : (↑S : Set (ℕ → ℚ)) ⊆ (evalZeroSubmodule j : Set (ℕ → ℚ)) := by
    intro s hs
    exact hzero_of_mem s hs
  have hspanle : Submodule.span (ℕ → ℚ) (↑S : Set (ℕ → ℚ)) ≤ evalZeroSubmodule j :=
    Submodule.span_le.mpr hsub
  -- but the unit vector at `j` belongs to the ideal
  have heI : (Pi.single j (1 : ℚ) : ℕ → ℚ) ∈ finitelySupported := by
    rw [mem_finitelySupported, FinSupp]
    refine Set.Finite.subset (Set.finite_singleton j) ?_
    intro n hn
    by_contra h
    have hnj : n ≠ j := by simpa using h
    exact hn (by simp [Pi.single_eq_of_ne hnj])
  have hespan : (Pi.single j (1 : ℚ) : ℕ → ℚ)
      ∈ Submodule.span (ℕ → ℚ) (↑S : Set (ℕ → ℚ)) := by
    rw [hS]
    exact heI
  have hzero := hspanle hespan
  rw [mem_evalZeroSubmodule] at hzero
  rw [Pi.single_eq_same] at hzero
  exact one_ne_zero hzero

/-- The converse of Exercise 2.9 is false: over `ℕ → ℚ` the submodule
`finitelySupported` sits in a short exact sequence whose middle and right terms
are finitely generated, while it itself is not. -/
theorem exists_short_exact_not_finite_left :
    ∃ M' : Submodule (ℕ → ℚ) (ℕ → ℚ),
      ¬ Module.Finite (ℕ → ℚ) M' ∧ Module.Finite (ℕ → ℚ) ((ℕ → ℚ) ⧸ M') := by
  refine ⟨finitelySupported, ?_, ?_⟩
  · rw [Module.Finite.iff_fg]
    exact finitelySupported_not_fg
  · exact Module.Finite.of_surjective (hM := Module.Finite.self _)
      (Submodule.mkQ _) (Submodule.mkQ_surjective _)

/-- The same failure, phrased in the shape of Exercise 2.9: there is a short
exact sequence `0 → M' → M → M'' → 0` of modules over the ring `ℕ → ℚ` for which
`M` and `M''` are finitely generated but `M'` is not, so the converse
implication of the exercise fails. -/
theorem converse_of_exercise_fails :
    ∃ M' : Submodule (ℕ → ℚ) (ℕ → ℚ),
      ∃ (f : M' →ₗ[ℕ → ℚ] (ℕ → ℚ)) (g : (ℕ → ℚ) →ₗ[ℕ → ℚ] ((ℕ → ℚ) ⧸ M')),
        Function.Injective f ∧ Function.Surjective g ∧
        LinearMap.range f = LinearMap.ker g ∧
        Module.Finite (ℕ → ℚ) (ℕ → ℚ) ∧
        Module.Finite (ℕ → ℚ) ((ℕ → ℚ) ⧸ M') ∧
        ¬ Module.Finite (ℕ → ℚ) M' := by
  refine ⟨finitelySupported, finitelySupported.subtype, finitelySupported.mkQ,
    Submodule.subtype_injective _, Submodule.mkQ_surjective _, ?_, ?_, ?_, ?_⟩
  · rw [Submodule.range_subtype, Submodule.ker_mkQ]
  · exact Module.Finite.self _
  · exact Module.Finite.of_surjective (hM := Module.Finite.self _)
      (Submodule.mkQ _) (Submodule.mkQ_surjective _)
  · rw [Module.Finite.iff_fg]
    exact finitelySupported_not_fg


end AtiyahMcdonald69.Ex_2_9
