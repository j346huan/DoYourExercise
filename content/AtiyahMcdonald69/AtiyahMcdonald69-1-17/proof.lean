/-
# Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 1, Exercise 17

For a commutative ring `A` and `f : A`, let `Xf f = Spec A \ V(f)`, i.e. the set of prime
ideals of `A` not containing `f`.  This file formalises all of Exercise 1.17, following the
book's own list of assertions (with the book's convention that "compact" means quasi-compact,
i.e. every open cover has a finite subcover, with no Hausdorff hypothesis):

* `Xf f` is open, and the sets `Xf f` form a basis for the Zariski topology:
  `isOpen_Xf`, `basis_Xf`, `exists_Xf_subset_of_mem_isOpen`;
* `Xf f ∩ Xf g = Xf (f * g)`: `Xf_inter`;
* `Xf f = ∅` iff `f` is nilpotent: `Xf_eq_empty_iff`;
* `Xf f = univ` iff `f` is a unit of `A`: `Xf_eq_univ_iff`;
* `Xf f = Xf g` iff `(f)` and `(g)` have the same radical: `Xf_eq_iff`
  (with the equivalent form `V(f) = V(g)` in `Xf_eq_iff_zeroLocus`);
* `Spec A` is quasi-compact: `isCompact_univ_spectrum`, `compactSpace_spectrum`;
* each `Xf f` is quasi-compact: `isCompact_Xf`;
* an open subset of `Spec A` is quasi-compact iff it is a finite union of `Xf`'s:
  `isCompact_iff_finite_iUnion_Xf`.

The proofs follow the book: a family `{Xf g} g ∈ S` covers `Spec A` exactly when the ideal
generated by `S` is the unit ideal, and `1 = ∑ aᵢ gᵢ` involves only finitely many `gᵢ`;
see `exists_finset_of_iUnion_Xf_eq_univ` and `exists_finset_of_cover_Xf`.
-/

import Mathlib

/- Natural-language solution: https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-1-17 -/


namespace AtiyahMcdonald69.Ex_1_17

open PrimeSpectrum

variable {A : Type*} [CommRing A]

/-! ### The basic open sets `Xf` -/

/-- `Xf f` is the basic open set `Spec A \ V(f)` of Exercise 1.17, i.e. the set of prime
ideals of `A` which do not contain `f`. -/
def Xf (f : A) : Set (PrimeSpectrum A) := (PrimeSpectrum.zeroLocus ({f} : Set A))ᶜ

theorem mem_Xf (p : PrimeSpectrum A) (f : A) : p ∈ Xf f ↔ f ∉ p.asIdeal := by
  simp [Xf]

theorem Xf_eq_basicOpen (f : A) :
    Xf f = (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A)) := by
  rw [Xf, PrimeSpectrum.basicOpen_eq_zeroLocus_compl]

theorem isOpen_Xf (f : A) : IsOpen (Xf f) := by
  rw [Xf_eq_basicOpen]
  exact PrimeSpectrum.isOpen_basicOpen

/-! ### The sets `Xf` form a basis of the Zariski topology -/

/-- `V(s)` is the intersection of the sets `V(f)`, `f ∈ s`. -/
theorem zeroLocus_eq_iInter_singleton (s : Set A) :
    PrimeSpectrum.zeroLocus s = ⋂ f ∈ s, PrimeSpectrum.zeroLocus ({f} : Set A) := by
  ext x
  simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_iInter, Set.singleton_subset_iff]
  exact ⟨fun h f hf => h hf, fun h f hf => h f hf⟩

/-- Membership in a union of basic open sets. -/
theorem mem_iUnion_Xf_iff (p : PrimeSpectrum A) (s : Set A) :
    p ∈ ⋃ f ∈ s, Xf f ↔ ∃ f, f ∈ s ∧ p ∈ Xf f := by
  simp only [Set.mem_iUnion]
  exact ⟨fun ⟨f, hf, h⟩ => ⟨f, hf, h⟩, fun ⟨f, hf, h⟩ => ⟨f, hf, h⟩⟩

/-- The complement of `V(s)` is the union of the sets `Xf f`, `f ∈ s`. -/
theorem compl_zeroLocus_eq_iUnion_Xf (s : Set A) :
    (PrimeSpectrum.zeroLocus s)ᶜ = ⋃ f ∈ s, Xf f := by
  rw [zeroLocus_eq_iInter_singleton]
  ext p
  simp only [Set.mem_compl_iff, Set.mem_iInter, mem_iUnion_Xf_iff, mem_Xf,
    PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
  constructor
  · intro h
    by_contra hcon
    exact h fun f hf => by
      by_contra hfp
      exact hcon ⟨f, hf, hfp⟩
  · rintro ⟨f, hf, hfp⟩ h
    exact hfp (h f hf)

/-- Every open subset of `Spec A` is a union of basic open sets `Xf f`: the neighbourhood form
of the statement that the `Xf f` form a basis of the Zariski topology. -/
theorem exists_Xf_subset_of_mem_isOpen {U : Set (PrimeSpectrum A)} (hU : IsOpen U)
    {p : PrimeSpectrum A} (hp : p ∈ U) : ∃ f : A, p ∈ Xf f ∧ Xf f ⊆ U := by
  obtain ⟨s, hs⟩ := (PrimeSpectrum.isOpen_iff U).mp hU
  have hps : ¬ s ⊆ p.asIdeal := by
    intro hsub
    have hpc : p ∈ Uᶜ := by
      rw [hs]
      exact (PrimeSpectrum.mem_zeroLocus p s).mpr hsub
    exact hpc hp
  obtain ⟨f, hfs, hfp⟩ := Set.not_subset.mp hps
  refine ⟨f, (mem_Xf p f).mpr hfp, ?_⟩
  intro q hq
  by_contra hqU
  have hqZ : q ∈ PrimeSpectrum.zeroLocus s := by
    rw [← hs]
    exact hqU
  exact (mem_Xf q f).mp hq ((PrimeSpectrum.mem_zeroLocus q s).mp hqZ hfs)

/-- The sets `Xf f`, `f ∈ A`, form a basis of the Zariski topology on `Spec A`. -/
theorem basis_Xf : TopologicalSpace.IsTopologicalBasis (Set.range (Xf (A := A))) := by
  refine TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds ?_ ?_
  · rintro _ ⟨f, rfl⟩
    exact isOpen_Xf f
  · intro p U hp hU
    obtain ⟨f, hpf, hfU⟩ := exists_Xf_subset_of_mem_isOpen hU hp
    exact ⟨Xf f, ⟨f, rfl⟩, hpf, hfU⟩

/-! ### Part: `Xf f ∩ Xf g = Xf (f * g)` -/

theorem Xf_inter (f g : A) : Xf f ∩ Xf g = Xf (f * g) := by
  ext p
  simp only [Set.mem_inter_iff, mem_Xf]
  constructor
  · rintro ⟨hf, hg⟩ hfg
    rcases p.isPrime.mem_or_mem hfg with h | h
    · exact hf h
    · exact hg h
  · intro h
    exact ⟨fun hf => h (Ideal.mul_mem_right g p.asIdeal hf),
      fun hg => h (Ideal.mul_mem_left p.asIdeal f hg)⟩

/-! ### Part: `Xf f = ∅` iff `f` is nilpotent

The book's proof uses that the intersection of all prime ideals is the nilradical, and that the
nilradical consists of the nilpotent elements (Proposition 1.8 of the text); in Mathlib this is
`nilpotent_iff_mem_prime`, which is proved from `nilradical_eq_sInf` and `mem_nilradical`. -/

theorem Xf_eq_empty_iff (f : A) : Xf f = ∅ ↔ IsNilpotent f := by
  rw [← Set.not_nonempty_iff_eq_empty, nilpotent_iff_mem_prime]
  constructor
  · intro h I hI
    by_contra hf
    exact h ⟨⟨I, hI⟩, (mem_Xf (⟨I, hI⟩ : PrimeSpectrum A) f).mpr hf⟩
  · rintro h ⟨p, hp⟩
    exact (mem_Xf p f).mp hp (h p.asIdeal p.isPrime)

/-! ### Part: `Xf f = Spec A` iff `f` is a unit

A unit belongs to no proper ideal; conversely a non-unit generates a proper ideal, which is
contained in a maximal (hence prime) ideal (Proposition 1.4 of the text, `Ideal.exists_le_maximal`). -/

theorem Xf_eq_univ_iff (f : A) : Xf f = Set.univ ↔ IsUnit f := by
  rw [Set.eq_univ_iff_forall]
  constructor
  · intro h
    by_contra hnu
    have hspan : Ideal.span ({f} : Set A) ≠ ⊤ := by
      intro htop
      exact hnu (Ideal.span_singleton_eq_top.mp htop)
    obtain ⟨M, hmax, hle⟩ := Ideal.exists_le_maximal (Ideal.span ({f} : Set A)) hspan
    have hfM : f ∈ M := hle (Ideal.mem_span_singleton_self f)
    have hnot : ¬ f ∈ M := (mem_Xf (⟨M, hmax.isPrime⟩ : PrimeSpectrum A) f).mp
      (h ⟨M, hmax.isPrime⟩)
    exact hnot hfM
  · intro h p
    exact (mem_Xf p f).mpr fun hfp =>
      p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hfp h)

/-! ### Part: `Xf f = Xf g` iff `V(f) = V(g)` iff `√(f) = √(g)`

The proof is the book's: `√(f)` is the intersection of the prime ideals containing `f`
(`Ideal.radical_eq_sInf`), and `V(√I) = V(I)` (`PrimeSpectrum.zeroLocus_radical`). -/

theorem Xf_eq_iff_zeroLocus (f g : A) :
    Xf f = Xf g ↔ PrimeSpectrum.zeroLocus ({f} : Set A) = PrimeSpectrum.zeroLocus {g} := by
  rw [Xf, Xf, compl_inj_iff]

theorem Xf_eq_iff (f g : A) :
    Xf f = Xf g ↔
      (Ideal.span ({f} : Set A)).radical = (Ideal.span ({g} : Set A)).radical := by
  have hV := Xf_eq_iff_zeroLocus f g
  constructor
  · intro h
    have hfg : {J : Ideal A | Ideal.span ({f} : Set A) ≤ J ∧ J.IsPrime} =
        {J : Ideal A | Ideal.span ({g} : Set A) ≤ J ∧ J.IsPrime} := by
      ext J
      simp only [Set.mem_ofPred_eq]
      constructor
      · rintro ⟨hle, hJ⟩
        refine ⟨?_, hJ⟩
        have hmem : (⟨J, hJ⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus ({g} : Set A) := by
          rw [← hV.mp h]
          rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
          exact hle (Ideal.mem_span_singleton_self f)
        rw [Ideal.span_le, Set.singleton_subset_iff]
        rwa [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hmem
      · rintro ⟨hle, hJ⟩
        refine ⟨?_, hJ⟩
        have hmem : (⟨J, hJ⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus ({f} : Set A) := by
          rw [hV.mp h]
          rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
          exact hle (Ideal.mem_span_singleton_self g)
        rw [Ideal.span_le, Set.singleton_subset_iff]
        rwa [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hmem
    rw [Ideal.radical_eq_sInf, Ideal.radical_eq_sInf, hfg]
  · intro h
    rw [hV, ← PrimeSpectrum.zeroLocus_span ({f} : Set A),
      ← PrimeSpectrum.zeroLocus_span ({g} : Set A),
      ← PrimeSpectrum.zeroLocus_radical (Ideal.span ({f} : Set A)),
      ← PrimeSpectrum.zeroLocus_radical (Ideal.span ({g} : Set A)), h]

/-! ### Finiteness lemmas for covers by basic open sets

The mathematical content of (v) and (vi): if a family of basic open sets covers `Spec A` (or a
basic open set `Xf f₀`), then finitely many of them already do.  Both are proved from the
criterion "the ideal generated by the corresponding elements is the unit ideal", together with
the fact that `1 ∈ Ideal.span S` only involves finitely many elements of `S`.
-/

/-- If the sets `Xf g`, `g ∈ S`, cover `Spec A`, then finitely many of them already cover
`Spec A`. -/
theorem exists_finset_of_iUnion_Xf_eq_univ (S : Set A)
    (hS : ⋃ g ∈ S, Xf g = Set.univ) :
    ∃ t : Finset A, ↑t ⊆ S ∧ ⋃ g ∈ t, Xf g = Set.univ := by
  classical
  -- The family covers exactly when the ideal generated by `S` is the unit ideal.
  have hspan : Ideal.span S = ⊤ := by
    by_contra hne
    obtain ⟨m, hmax, hle⟩ := Ideal.exists_le_maximal (Ideal.span S) hne
    have hmem : (⟨m, hmax.isPrime⟩ : PrimeSpectrum A) ∈ ⋃ g ∈ S, Xf g := by
      rw [hS]
      exact Set.mem_univ _
    obtain ⟨g, hgS, hg⟩ := Set.mem_iUnion₂.mp hmem
    exact (mem_Xf (⟨m, hmax.isPrime⟩ : PrimeSpectrum A) g).mp hg
      (hle (Ideal.subset_span hgS))
  obtain ⟨t, htS, htspan⟩ := (Ideal.span_eq_top_iff_finite S).mp hspan
  refine ⟨t, htS, ?_⟩
  refine Set.eq_univ_of_forall ?_
  intro p
  by_contra hp
  -- If `p` is outside the union, then every `g ∈ t` lies in `p`, so `1 ∈ p`.
  have hall : ∀ g ∈ t, g ∈ p.asIdeal := by
    intro g hg
    by_contra hgp
    exact hp (Set.mem_iUnion₂.mpr ⟨g, hg, (mem_Xf p g).mpr hgp⟩)
  have hle : Ideal.span (↑t : Set A) ≤ p.asIdeal := by
    rw [Ideal.span_le]
    exact hall
  rw [htspan] at hle
  exact p.isPrime.ne_top (top_le_iff.mp hle)

/-- If the sets `Xf g`, `g ∈ S`, cover a basic open set `Xf f₀`, then finitely many of them
already cover `Xf f₀`. -/
theorem exists_finset_of_cover_Xf (f₀ : A) (S : Set A) (h : Xf f₀ ⊆ ⋃ g ∈ S, Xf g) :
    ∃ t : Finset A, ↑t ⊆ S ∧ Xf f₀ ⊆ ⋃ g ∈ t, Xf g := by
  classical
  -- Every prime ideal containing all of `S` contains `f₀`, i.e. `V(S) ⊆ V(f₀)`.
  have hsub : PrimeSpectrum.zeroLocus S ⊆ PrimeSpectrum.zeroLocus ({f₀} : Set A) := by
    intro p hp
    rw [PrimeSpectrum.mem_zeroLocus] at hp ⊢
    rw [Set.singleton_subset_iff]
    by_contra hfp
    obtain ⟨g, hgS, hg⟩ := (mem_iUnion_Xf_iff p S).mp (h ((mem_Xf p f₀).mpr hfp))
    exact (mem_Xf p g).mp hg (hp hgS)
  have hle : Ideal.span ({f₀} : Set A) ≤ (Ideal.span S).radical := by
    have h' : PrimeSpectrum.zeroLocus (Ideal.span S : Set A) ⊆
        PrimeSpectrum.zeroLocus (Ideal.span ({f₀} : Set A) : Set A) := by
      rwa [PrimeSpectrum.zeroLocus_span, PrimeSpectrum.zeroLocus_span]
    exact (PrimeSpectrum.zeroLocus_subset_zeroLocus_iff (Ideal.span S)
      (Ideal.span ({f₀} : Set A))).mp h'
  -- Hence some power of `f₀` lies in the ideal generated by `S`, whence in the ideal
  -- generated by finitely many elements of `S`.
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp (hle (Ideal.mem_span_singleton_self f₀))
  obtain ⟨t, htS, htn⟩ := Submodule.mem_span_finite_of_mem_span hn
  refine ⟨t, htS, ?_⟩
  intro p hp
  by_contra hcon
  have hall : ∀ g ∈ t, g ∈ p.asIdeal := by
    intro g hg
    by_contra hgp
    exact hcon (Set.mem_iUnion₂.mpr ⟨g, hg, (mem_Xf p g).mpr hgp⟩)
  have hle' : Ideal.span (↑t : Set A) ≤ p.asIdeal := by
    rw [Ideal.span_le]
    exact hall
  exact (mem_Xf p f₀).mp hp (p.isPrime.mem_of_pow_mem n (hle' htn))

/-! ### Part: `Spec A` is quasi-compact -/

theorem isCompact_univ_spectrum : IsCompact (Set.univ : Set (PrimeSpectrum A)) := by
  refine isCompact_of_finite_subcover ?_
  intro ι U hUo hcov
  classical
  -- Refine the given open cover by basic open sets.
  choose s hs using fun i => (PrimeSpectrum.isOpen_iff (U i)).mp (hUo i)
  have hUi : ∀ i, U i = ⋃ g ∈ s i, Xf g := by
    intro i
    calc U i = ((U i)ᶜ)ᶜ := (compl_compl (U i)).symm
      _ = (PrimeSpectrum.zeroLocus (s i))ᶜ := by rw [hs i]
      _ = ⋃ g ∈ s i, Xf g := compl_zeroLocus_eq_iUnion_Xf (s i)
  have hcover : ⋃ g ∈ (⋃ i, (s i : Set A)), Xf g = Set.univ := by
    refine Set.eq_univ_of_forall ?_
    intro p
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov (Set.mem_univ p))
    rw [hUi i] at hi
    obtain ⟨g, hg, hpg⟩ := Set.mem_iUnion₂.mp hi
    exact Set.mem_iUnion₂.mpr ⟨g, Set.mem_iUnion.mpr ⟨i, hg⟩, hpg⟩
  obtain ⟨t, htS, htuniv⟩ := exists_finset_of_iUnion_Xf_eq_univ _ hcover
  -- Each of the finitely many elements of `t` lies in one of the sets `s i`.
  have hex : ∀ g ∈ t, ∃ i, g ∈ (s i : Set A) := by
    intro g hg
    exact Set.mem_iUnion.mp (htS (by simpa using hg))
  choose I hI using hex
  refine ⟨t.attach.image (fun x => I x.1 x.2), ?_⟩
  intro p hp
  have hp' : p ∈ ⋃ g ∈ t, Xf g := by
    rw [htuniv]
    exact Set.mem_univ p
  obtain ⟨g, hgt, hpg⟩ := Set.mem_iUnion₂.mp hp'
  refine Set.mem_iUnion₂.mpr ⟨I g hgt, ?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨⟨g, hgt⟩, Finset.mem_attach t ⟨g, hgt⟩, rfl⟩
  · rw [hUi (I g hgt)]
    exact Set.mem_iUnion₂.mpr ⟨g, hI g hgt, hpg⟩

/-- `Spec A` is a compact (quasi-compact) topological space. -/
theorem compactSpace_spectrum : CompactSpace (PrimeSpectrum A) :=
  isCompact_univ_iff.mp isCompact_univ_spectrum

/-! ### Part: each `Xf f` is quasi-compact -/

theorem isCompact_Xf (f : A) : IsCompact (Xf f) := by
  refine isCompact_of_finite_subcover ?_
  intro ι U hUo hcov
  classical
  choose s hs using fun i => (PrimeSpectrum.isOpen_iff (U i)).mp (hUo i)
  have hUi : ∀ i, U i = ⋃ g ∈ s i, Xf g := by
    intro i
    calc U i = ((U i)ᶜ)ᶜ := (compl_compl (U i)).symm
      _ = (PrimeSpectrum.zeroLocus (s i))ᶜ := by rw [hs i]
      _ = ⋃ g ∈ s i, Xf g := compl_zeroLocus_eq_iUnion_Xf (s i)
  have hcov' : Xf f ⊆ ⋃ g ∈ (⋃ i, (s i : Set A)), Xf g := by
    intro p hp
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov hp)
    rw [hUi i] at hi
    obtain ⟨g, hg, hpg⟩ := Set.mem_iUnion₂.mp hi
    exact Set.mem_iUnion₂.mpr ⟨g, Set.mem_iUnion.mpr ⟨i, hg⟩, hpg⟩
  obtain ⟨t, htS, htcover⟩ := exists_finset_of_cover_Xf f _ hcov'
  have hex : ∀ g ∈ t, ∃ i, g ∈ (s i : Set A) := by
    intro g hg
    exact Set.mem_iUnion.mp (htS (by simpa using hg))
  choose I hI using hex
  refine ⟨t.attach.image (fun x => I x.1 x.2), ?_⟩
  intro p hp
  obtain ⟨g, hgt, hpg⟩ := Set.mem_iUnion₂.mp (htcover hp)
  refine Set.mem_iUnion₂.mpr ⟨I g hgt, ?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨⟨g, hgt⟩, Finset.mem_attach t ⟨g, hgt⟩, rfl⟩
  · rw [hUi (I g hgt)]
    exact Set.mem_iUnion₂.mpr ⟨g, hI g hgt, hpg⟩

/-! ### Part: an open set is quasi-compact iff it is a finite union of `Xf`'s -/

theorem isCompact_finite_iUnion_Xf (t : Finset A) :
    IsCompact (⋃ f ∈ t, Xf f) :=
  Set.Finite.isCompact_biUnion t.finite_toSet fun f _ => isCompact_Xf f

theorem isCompact_iff_finite_iUnion_Xf (U : Set (PrimeSpectrum A)) (hU : IsOpen U) :
    IsCompact U ↔ ∃ t : Finset A, U = ⋃ f ∈ t, Xf f := by
  classical
  constructor
  · intro hc
    -- Cover `U` by the basic open sets it contains.
    have hcover : U ⊆ ⋃ g : {g : A // Xf g ⊆ U}, Xf g.1 := by
      intro p hp
      obtain ⟨f, hpf, hfU⟩ := exists_Xf_subset_of_mem_isOpen hU hp
      exact Set.mem_iUnion.mpr ⟨⟨f, hfU⟩, hpf⟩
    obtain ⟨t, ht⟩ := hc.elim_finite_subcover (fun g : {g : A // Xf g ⊆ U} => Xf g.1)
      (fun g => isOpen_Xf g.1) hcover
    refine ⟨t.image Subtype.val, ?_⟩
    refine Set.Subset.antisymm ?_ ?_
    · intro p hp
      obtain ⟨g, hgt, hpg⟩ := Set.mem_iUnion₂.mp (ht hp)
      exact Set.mem_iUnion₂.mpr ⟨g.1, Finset.mem_image.mpr ⟨g, hgt, rfl⟩, hpg⟩
    · intro p hp
      obtain ⟨f, hf, hpf⟩ := Set.mem_iUnion₂.mp hp
      obtain ⟨g, _, rfl⟩ := Finset.mem_image.mp hf
      exact g.2 hpf
  · rintro ⟨t, rfl⟩
    exact isCompact_finite_iUnion_Xf t

/-! ### The exercise as a single statement -/

/-- All assertions of Atiyah–Macdonald, Chapter 1, Exercise 17. -/
structure Solution (A : Type*) [CommRing A] : Prop where
  /-- Each `Xf f` is open. -/
  isOpen_Xf : ∀ f : A, IsOpen (Xf f)
  /-- The sets `Xf f` form a basis of the Zariski topology. -/
  basis_Xf : TopologicalSpace.IsTopologicalBasis (Set.range (Xf (A := A)))
  /-- `Xf f ∩ Xf g = Xf (f * g)`. -/
  inter : ∀ f g : A, Xf f ∩ Xf g = Xf (f * g)
  /-- `Xf f = ∅` iff `f` is nilpotent. -/
  eq_empty_iff : ∀ f : A, Xf f = ∅ ↔ IsNilpotent f
  /-- `Xf f = Spec A` iff `f` is a unit. -/
  eq_univ_iff : ∀ f : A, Xf f = Set.univ ↔ IsUnit f
  /-- `Xf f = Xf g` iff `√(f) = √(g)`. -/
  eq_iff_radical : ∀ f g : A,
    Xf f = Xf g ↔ (Ideal.span ({f} : Set A)).radical = (Ideal.span ({g} : Set A)).radical
  /-- `Spec A` is quasi-compact. -/
  compact_univ : IsCompact (Set.univ : Set (PrimeSpectrum A))
  /-- Each `Xf f` is quasi-compact. -/
  isCompact_Xf : ∀ f : A, IsCompact (Xf f)
  /-- An open set is quasi-compact iff it is a finite union of `Xf`'s. -/
  isCompact_open_iff : ∀ U : Set (PrimeSpectrum A), IsOpen U →
    (IsCompact U ↔ ∃ t : Finset A, U = ⋃ f ∈ t, Xf f)

