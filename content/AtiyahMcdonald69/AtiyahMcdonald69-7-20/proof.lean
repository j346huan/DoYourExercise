import Mathlib

/-!
# Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 7, Exercise 20

Let `X` be a topological space and let `F` be the smallest collection of subsets of `X` which
contains all open subsets of `X` and is closed with respect to the formation of finite intersections
and complements.

* `part_a`: a subset `E` of `X` belongs to `F` if and only if `E` is a finite union of sets of the
  form `U ∩ C`, where `U` is open and `C` is closed.
* `part_b`: if `X` is irreducible and `E ∈ F`, then `E` is dense in `X` if and only if `E` contains
  a non-empty open subset of `X`.

The family `F` is formalised as the Boolean subalgebra of the power set of `X` generated by the
open subsets of `X` (`F`), and `mem_F_iff` records that this is exactly the smallest collection of
subsets of `X` containing all open subsets and closed under finite intersections and complements.
A finite union of terms `U ∩ C` is formalised as a union indexed by `Fin n`.

Natural-language proof: <https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-20>
-/

namespace AtiyahMcdonald69.Ex_7_20

open Set Topology

variable {X : Type*} [TopologicalSpace X]

/-! ### The family `F` of the exercise -/

/-- The family `F` of the exercise: the smallest collection of subsets of `X` which contains all
open subsets of `X` and is closed under the formation of finite intersections and complements.
Concretely this is the Boolean subalgebra of `Set X` generated by the open subsets. -/
def F (X : Type*) [TopologicalSpace X] : BooleanSubalgebra (Set X) :=
  BooleanSubalgebra.closure {U : Set X | IsOpen U}

/-- `F` is the *smallest* collection of subsets of `X` containing all open subsets of `X` and
closed under finite intersections and complements: a set belongs to `F` if and only if it belongs
to every such collection. -/
theorem mem_F_iff (E : Set X) :
    E ∈ F X ↔ ∀ G : Set (Set X), (∀ U : Set X, IsOpen U → U ∈ G) →
      (∀ A : Set X, A ∈ G → Aᶜ ∈ G) →
      (∀ A : Set X, A ∈ G → ∀ B : Set X, B ∈ G → A ∩ B ∈ G) → E ∈ G := by
  constructor
  · intro hE G hopen hcompl hinter
    refine BooleanSubalgebra.closure_bot_sup_induction (s := {U : Set X | IsOpen U})
      (p := fun g _ => g ∈ G) (fun U hU => hopen U hU) ?_ ?_ ?_ hE
    · simpa using hcompl univ (hopen univ isOpen_univ)
    · intro A _ B _ ihA ihB
      have h : A ⊔ B = (Aᶜ ∩ Bᶜ)ᶜ := by
        rw [Set.compl_inter, compl_compl, compl_compl]
        rfl
      rw [h]
      exact hcompl _ (hinter _ (hcompl A ihA) _ (hcompl B ihB))
    · intro A _ ih
      exact hcompl A ih
  · intro H
    exact H (F X : Set (Set X)) (fun U hU => BooleanSubalgebra.subset_closure hU)
      (fun A hA => (F X).compl_mem hA) (fun A hA B hB => (F X).inf_mem hA hB)

/-- `F` read literally as the exercise states it: the intersection of all collections of subsets of
`X` which contain all open subsets of `X` and are closed under finite intersections and complements,
i.e. the smallest such collection. -/
theorem F_eq_sInter :
    (F X : Set (Set X)) = ⋂₀ {G : Set (Set X) | (∀ U : Set X, IsOpen U → U ∈ G) ∧
      (∀ A : Set X, A ∈ G → Aᶜ ∈ G) ∧
      (∀ A : Set X, A ∈ G → ∀ B : Set X, B ∈ G → A ∩ B ∈ G)} := by
  ext E
  refine (mem_F_iff E).trans ?_
  rw [Set.mem_sInter]
  exact ⟨fun h G hG => h G hG.1 hG.2.1 hG.2.2, fun h G h1 h2 h3 => h G ⟨h1, h2, h3⟩⟩

/-- Every open set belongs to `F`. -/
lemma isOpen_mem_F {U : Set X} (hU : IsOpen U) : U ∈ F X :=
  BooleanSubalgebra.subset_closure hU

/-- Every closed set belongs to `F`. -/
lemma isClosed_mem_F {C : Set X} (hC : IsClosed C) : C ∈ F X := by
  rw [show C = Cᶜᶜ from (compl_compl C).symm]
  exact (F X).compl_mem (isOpen_mem_F hC.isOpen_compl)

/-- `F` is closed under complements. -/
lemma compl_mem_F {A : Set X} (hA : A ∈ F X) : Aᶜ ∈ F X :=
  (F X).compl_mem hA

/-- `F` is closed under finite intersections. -/
lemma inter_mem_F {A B : Set X} (hA : A ∈ F X) (hB : B ∈ F X) : A ∩ B ∈ F X :=
  (F X).inf_mem hA hB

/-- `F` is closed under finite unions (a consequence of De Morgan's law). -/
lemma union_mem_F {A B : Set X} (hA : A ∈ F X) (hB : B ∈ F X) : A ∪ B ∈ F X :=
  (F X).sup_mem hA hB

/-! ### Part (i): finite unions of sets of the form `U ∩ C` -/

/-- `E` is a finite union of sets of the form `U ∩ C`, with `U` open and `C` closed. -/
def IsFinUnion (E : Set X) : Prop :=
  ∃ (n : ℕ) (U C : Fin n → Set X),
    (∀ i, IsOpen (U i)) ∧ (∀ i, IsClosed (C i)) ∧ E = ⋃ i, U i ∩ C i

/-- The canonical equivalence `Fin n ⊕ Fin m ≃ Fin (n + m)`. -/
private def finSumEquiv (n m : ℕ) : Fin n ⊕ Fin m ≃ Fin (n + m) where
  toFun := Sum.elim (Fin.castAdd m) (Fin.natAdd n)
  invFun := Fin.addCases Sum.inl Sum.inr
  left_inv x := by rcases x with i | j <;> simp
  right_inv x := by refine Fin.addCases (fun i => ?_) (fun j => ?_) x <;> simp

lemma isFinUnion_term {U C : Set X} (hU : IsOpen U) (hC : IsClosed C) : IsFinUnion (U ∩ C) := by
  exact ⟨1, fun _ => U, fun _ => C, fun _ => hU, fun _ => hC, (Set.iUnion_const (U ∩ C)).symm⟩

lemma isFinUnion_union {E E' : Set X} (hE : IsFinUnion E) (hE' : IsFinUnion E') :
    IsFinUnion (E ∪ E') := by
  obtain ⟨n, U, C, hU, hC, rfl⟩ := hE
  obtain ⟨m, U', C', hU', hC', rfl⟩ := hE'
  refine ⟨n + m, fun k => Sum.elim U U' ((finSumEquiv n m).symm k),
    fun k => Sum.elim C C' ((finSumEquiv n m).symm k), ?_, ?_, ?_⟩
  · intro k
    rcases hk : (finSumEquiv n m).symm k with i | j
    · simpa [hk] using hU i
    · simpa [hk] using hU' j
  · intro k
    rcases hk : (finSumEquiv n m).symm k with i | j
    · simpa [hk] using hC i
    · simpa [hk] using hC' j
  · rw [Function.Surjective.iUnion_comp (finSumEquiv n m).symm.surjective
      (fun x : Fin n ⊕ Fin m => Sum.elim U U' x ∩ Sum.elim C C' x), Set.iUnion_sum]
    simp

theorem isFinUnion_iff_mem_F (E : Set X) : IsFinUnion E ↔ E ∈ F X := by
  constructor
  · rintro ⟨n, U, C, hU, hC, rfl⟩
    have hmem : ∀ i : Fin n, U i ∩ C i ∈ (F X : Set (Set X)) := fun i =>
      (F X).inf_mem (isOpen_mem_F (hU i)) (isClosed_mem_F (hC i))
    simpa using (F X).iSup_mem hmem
  · intro hE
    refine BooleanSubalgebra.closure_sdiff_sup_induction (s := {U : Set X | IsOpen U})
      ⟨fun a ha b hb => ha.union hb, fun a ha b hb => ha.inter hb⟩
      isOpen_empty isOpen_univ (p := fun g _ => IsFinUnion g) ?_ ?_ E hE
    · intro x hx y hy
      rw [Set.sdiff_eq]
      exact isFinUnion_term hx (IsOpen.isClosed_compl hy)
    · intro x _ y _ ihx ihy
      exact isFinUnion_union ihx ihy

/-- **Exercise 7.20 (i).** A subset `E` of `X` belongs to `F` if and only if `E` is a finite union
of sets of the form `U ∩ C`, where `U` is open and `C` is closed. -/
theorem part_a (E : Set X) :
    E ∈ F X ↔ ∃ (n : ℕ) (U C : Fin n → Set X),
      (∀ i, IsOpen (U i)) ∧ (∀ i, IsClosed (C i)) ∧ E = ⋃ i, U i ∩ C i :=
  (isFinUnion_iff_mem_F E).symm

/-! ### Part (ii): density of members of `F` in an irreducible space -/

/-- In an irreducible space, a cover of the whole space by finitely many closed sets already has
one member equal to the whole space. -/
lemma exists_isClosed_eq_univ_of_iUnion_eq_univ [IrreducibleSpace X] {n : ℕ}
    {D : Fin n → Set X} (hD : ∀ i, IsClosed (D i)) (h : ⋃ i, D i = univ) :
    ∃ i, D i = univ := by
  have hirr : IsIrreducible (univ : Set X) := IrreducibleSpace.isIrreducible_univ X
  have hclosed : ∀ z ∈ (Finset.univ.image D : Finset (Set X)), IsClosed z := by
    intro z hz
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hz
    exact hD i
  have hsub : (univ : Set X) ⊆ ⋃₀ ↑(Finset.univ.image D : Finset (Set X)) := by
    rw [← h]
    intro x hx
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hx
    exact Set.mem_sUnion.2
      ⟨D i, Finset.mem_coe.2 (Finset.mem_image.2 ⟨i, Finset.mem_univ i, rfl⟩), hi⟩
  obtain ⟨z, hz, huz⟩ := (isIrreducible_iff_sUnion_isClosed.1 hirr) _ hclosed hsub
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hz
  exact ⟨i, Set.univ_subset_iff.1 huz⟩

/-- **Exercise 7.20 (ii).** If `X` is irreducible and `E ∈ F`, then `E` is dense in `X` if and only
if `E` contains a non-empty open subset of `X`. -/
theorem part_b [IrreducibleSpace X] {E : Set X} (hE : E ∈ F X) :
    Dense E ↔ ∃ U : Set X, IsOpen U ∧ U.Nonempty ∧ U ⊆ E := by
  constructor
  · intro hdense
    obtain ⟨n, U, C, hU, hC, rfl⟩ := (part_a E).1 hE
    have hcover : (⋃ i : Fin n, closure (U i ∩ C i)) = univ := by
      rw [← closure_iUnion_of_finite]
      exact dense_iff_closure_eq.1 hdense
    obtain ⟨i, hi⟩ :=
      exists_isClosed_eq_univ_of_iUnion_eq_univ (fun i => isClosed_closure) hcover
    have hCuniv : C i = univ := Set.univ_subset_iff.1 (by
      rw [← hi]
      exact closure_minimal inter_subset_right (hC i))
    have hUi : U i ∩ C i = U i := by rw [hCuniv, inter_univ]
    have hdenseUi : Dense (U i) := by
      rw [dense_iff_closure_eq, ← hUi]
      exact hi
    have hne : (U i).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h0
      have h : (univ : Set X) = ∅ := by rw [← dense_iff_closure_eq.1 hdenseUi, h0, closure_empty]
      exact univ_nonempty.ne_empty h
    refine ⟨U i, hU i, hne, ?_⟩
    intro x hx
    exact Set.mem_iUnion.2 ⟨i, ⟨hx, by rw [hCuniv]; exact Set.mem_univ x⟩⟩
  · rintro ⟨U, hU, hUne, hUE⟩
    exact Dense.mono hUE (hU.dense hUne)

/-- **Atiyah–Macdonald, Exercise 7.20**, both parts. -/
theorem solution [IrreducibleSpace X] {E : Set X} (hE : E ∈ F X) :
    (E ∈ F X ↔ ∃ (n : ℕ) (U C : Fin n → Set X),
        (∀ i, IsOpen (U i)) ∧ (∀ i, IsClosed (C i)) ∧ E = ⋃ i, U i ∩ C i) ∧
      (Dense E ↔ ∃ U : Set X, IsOpen U ∧ U.Nonempty ∧ U ⊆ E) :=
  ⟨part_a E, part_b hE⟩

/-! ### Axiom check -/

#print axioms AtiyahMcdonald69.Ex_7_20.mem_F_iff
#print axioms AtiyahMcdonald69.Ex_7_20.F_eq_sInter
#print axioms AtiyahMcdonald69.Ex_7_20.part_a
#print axioms AtiyahMcdonald69.Ex_7_20.part_b
#print axioms AtiyahMcdonald69.Ex_7_20.solution

end AtiyahMcdonald69.Ex_7_20
