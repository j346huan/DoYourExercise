import Mathlib

/-!
# Atiyah–Macdonald, Exercise 3.20

Formalisation of Exercise 20 of Chapter 3 of M. F. Atiyah and I. G. Macdonald,
*Introduction to Commutative Algebra* (Addison-Wesley, 1969), p. 46.

The book states: let `f : A → B` be a ring homomorphism and `f* : Spec(B) → Spec(A)` the
associated mapping. Show that

(i) every prime ideal of `A` is a contracted ideal ⇔ `f*` is surjective;
(ii) every prime ideal of `B` is an extended ideal ⇒ `f*` is injective.
Is the converse of (ii) true?

Following Chapter 1 (p. 9) of the book, an ideal `𝔞` of `A` is **contracted** if `𝔞 = 𝔟ᶜ`
(the contraction `f⁻¹(𝔟)`) for some ideal `𝔟` of `B`, and an ideal `𝔟` of `B` is **extended** if
`𝔟 = 𝔞ᵉ` (the ideal generated by `f(𝔞)`) for some ideal `𝔞` of `A`.

## Formalisation dictionary

* `f*` is `PrimeSpectrum.comap f`, which sends `q` to `Ideal.comap f q.asIdeal`;
* `𝔞ᵉ = Ideal.map f 𝔞`, `𝔟ᶜ = Ideal.comap f 𝔟`;
* `IsContracted f 𝔞` and `IsExtended f 𝔟` are the book's notions, spelled out as
  `∃ 𝔟, 𝔟ᶜ = 𝔞` and `∃ 𝔞, 𝔞ᵉ = 𝔟`;
* `𝔮^{ec} = (𝔮ᶜ)ᵉ` and `𝔭^{ce} = (𝔭ᵉ)ᶜ`.

## Coverage

* Chapter 1, Prop. 1.17 iii) (the contracted ideals are exactly `{𝔞 | 𝔞^{ec} = 𝔞}` and the
  extended ideals exactly `{𝔟 | 𝔟^{ce} = 𝔟}`):
  `isContracted_iff_comap_map_eq_self`, `isExtended_iff_map_comap_eq_self`.
* Chapter 3, Prop. 3.16 (`𝔭` is the contraction of a prime ideal iff `𝔭^{ec} = 𝔭`):
  `prop_3_16`, `isContracted_iff_exists_isPrime`; pointwise forms
  `mem_range_comap_iff_isContracted`, `range_comap_eq_setOf_isContracted`.
* (i) `part_i` (with the two implications also available as `part_i_mp`, `part_i_mpr`).
* (ii) `part_ii` (and the pointwise form `eq_of_comap_eq_of_isExtended`).
* (iii) the answer to the question is **no**: `part_iii` gives the counterexample
  `K → K[ε]` (dual numbers over a field), `exists_injective_not_forall_isExtended` restates it
  in existential form and `converse_of_part_ii_fails` packages the negative answer to the
  general statement.  The supporting computation is
  `subsingleton_primeSpectrum` (`K[ε]` has exactly one prime ideal), `subsingleton_primeSpectrum_field`
  (`K` has exactly one prime ideal), `comap_algebraMap_asIdeal` (the induced map on spectra sends
  the unique point `(ε)` to the unique point `(0)`), `comap_algebraMap_injective`
  (`f*` is injective because its source has one point) and `span_eps_not_isExtended`
  (the unique prime `(ε)` is not extended: the only ideals of the field `K` are `⊥` and `⊤`).
* Audit: `surjective_of_forall_isContracted` notes that the implication of (i) still holds with
  "every prime ideal" replaced by "every ideal", while `not_forall_isContracted_of_surjective`
  shows that the converse of that statement fails (for `fst : ℚ[ε] → ℚ`).

## Audited hypotheses

* Part (ii) is only an implication in the book, and this is sharp: see (iii).
* Part (i) needs primality of the ideal: `IsContracted f 𝔞 ↔ 𝔞^{ec} = 𝔞` holds for every ideal
  (`isContracted_iff_comap_map_eq_self`), but the description "contraction of a *prime* ideal"
  is only equivalent to it when `𝔞` is prime (`isContracted_iff_exists_isPrime`).
* The counterexample ring `K[ε]` is the ring of dual numbers `DualNumber K`, i.e. the
  trivially-square-zero extension of `K` (equivalently `K[x]/(x²)`, the example of the natural
  solution); it is a local ring whose unique prime is the nilradical `(ε)`, so `Spec K[ε]` and
  `Spec K` both have one point, `f*` is injective, while `(ε)` is not extended from `K`.

Reference: <https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-3-20>
-/

namespace AtiyahMcdonald69.Ex_3_20

open scoped DualNumber

section ContractedExtended

variable {A B : Type*} [CommRing A] [CommRing B]

/-- An ideal `𝔞` of `A` is *contracted* (from `B` along `f`) if it is the contraction of some
ideal of `B` (Atiyah–Macdonald, Chapter 1, p. 9). -/
def IsContracted (f : A →+* B) (a : Ideal A) : Prop := ∃ b : Ideal B, b.comap f = a

/-- An ideal `𝔟` of `B` is *extended* (from `A` along `f`) if it is the extension of some ideal
of `A` (Atiyah–Macdonald, Chapter 1, p. 9). -/
def IsExtended (f : A →+* B) (b : Ideal B) : Prop := ∃ a : Ideal A, a.map f = b

/-- Chapter 1, Prop. 1.17: an ideal is contracted iff `𝔞^{ec} = 𝔞`.  No primality is needed. -/
theorem isContracted_iff_comap_map_eq_self (f : A →+* B) (a : Ideal A) :
    IsContracted f a ↔ (a.map f).comap f = a := by
  constructor
  · rintro ⟨b, rfl⟩
    exact le_antisymm (Ideal.comap_mono (Ideal.map_comap_le (f := f) (K := b)))
      Ideal.le_comap_map
  · intro h
    exact ⟨a.map f, h⟩

/-- Chapter 1, Prop. 1.17: an ideal is extended iff `𝔟^{ce} = 𝔟`.  No primality is needed. -/
theorem isExtended_iff_map_comap_eq_self (f : A →+* B) (b : Ideal B) :
    IsExtended f b ↔ (b.comap f).map f = b := by
  constructor
  · rintro ⟨a, rfl⟩
    exact le_antisymm Ideal.map_comap_le (Ideal.map_mono Ideal.le_comap_map)
  · intro h
    exact ⟨b.comap f, h⟩

/-- Chapter 3, Prop. 3.16: for a prime ideal `𝔭` of `A`, being contracted from *some* ideal of
`B` is the same as being the contraction of a *prime* ideal of `B`.  Primality of `𝔭` cannot be
dropped: a contraction of a prime ideal is again prime, whereas along `f = RingHom.id A` every
ideal is contracted. -/
theorem isContracted_iff_exists_isPrime (f : A →+* B) (p : Ideal A) [p.IsPrime] :
    IsContracted f p ↔ ∃ q : Ideal B, q.IsPrime ∧ q.comap f = p := by
  rw [isContracted_iff_comap_map_eq_self, Ideal.comap_map_eq_self_iff_of_isPrime]

/-- Chapter 3, Prop. 3.16, in the book's exact form: for a prime ideal `𝔭` of `A`, we have
`𝔭^{ec} = 𝔭` if and only if `𝔭` is the contraction of a prime ideal of `B`. -/
theorem prop_3_16 (f : A →+* B) (p : Ideal A) [p.IsPrime] :
    (p.map f).comap f = p ↔ ∃ q : Ideal B, q.IsPrime ∧ q.comap f = p :=
  Ideal.comap_map_eq_self_iff_of_isPrime p

/-- Pointwise form of part (i): a prime of `A` lies in the image of `f*` exactly when it is a
contracted ideal. -/
theorem mem_range_comap_iff_isContracted (f : A →+* B) (p : PrimeSpectrum A) :
    p ∈ Set.range (PrimeSpectrum.comap f) ↔ IsContracted f p.asIdeal := by
  rw [PrimeSpectrum.mem_range_comap_iff f, isContracted_iff_comap_map_eq_self]

/-- The image of `f*` consists precisely of the prime ideals that are contracted. -/
theorem range_comap_eq_setOf_isContracted (f : A →+* B) :
    Set.range (PrimeSpectrum.comap f) = {p : PrimeSpectrum A | IsContracted f p.asIdeal} :=
  Set.ext (mem_range_comap_iff_isContracted f)

/-- Part (i), direction ⇒: if every prime ideal of `A` is contracted then `f*` is surjective. -/
theorem part_i_mp (f : A →+* B)
    (h : ∀ p : PrimeSpectrum A, IsContracted f p.asIdeal) :
    Function.Surjective (PrimeSpectrum.comap f) := by
  intro p
  obtain ⟨q, hq, hqp⟩ := (isContracted_iff_exists_isPrime f p.asIdeal).mp (h p)
  exact ⟨⟨q, hq⟩, PrimeSpectrum.ext hqp⟩

/-- Part (i), direction ⇐: if `f*` is surjective then every prime ideal of `A` is contracted. -/
theorem part_i_mpr (f : A →+* B)
    (h : Function.Surjective (PrimeSpectrum.comap f)) :
    ∀ p : PrimeSpectrum A, IsContracted f p.asIdeal := by
  intro p
  obtain ⟨q, hq⟩ := h p
  exact ⟨q.asIdeal, by simpa using congrArg PrimeSpectrum.asIdeal hq⟩

/-- Part (i) of the exercise: every prime ideal of `A` is a contracted ideal if and only if
the associated map `f* : Spec B → Spec A` is surjective. -/
theorem part_i (f : A →+* B) :
    (∀ p : PrimeSpectrum A, IsContracted f p.asIdeal) ↔
      Function.Surjective (PrimeSpectrum.comap f) :=
  ⟨part_i_mp f, part_i_mpr f⟩

/-- Part (ii), pointwise form: if every prime of `B` is extended then a prime of `B` is
determined by its contraction. -/
theorem eq_of_comap_eq_of_isExtended (f : A →+* B)
    (h : ∀ q : PrimeSpectrum B, IsExtended f q.asIdeal) {q₁ q₂ : PrimeSpectrum B}
    (hc : PrimeSpectrum.comap f q₁ = PrimeSpectrum.comap f q₂) : q₁ = q₂ := by
  have h₁ : (q₁.asIdeal.comap f).map f = q₁.asIdeal :=
    (isExtended_iff_map_comap_eq_self f q₁.asIdeal).mp (h q₁)
  have h₂ : (q₂.asIdeal.comap f).map f = q₂.asIdeal :=
    (isExtended_iff_map_comap_eq_self f q₂.asIdeal).mp (h q₂)
  have hc' : q₁.asIdeal.comap f = q₂.asIdeal.comap f := by
    simpa using congrArg PrimeSpectrum.asIdeal hc
  exact PrimeSpectrum.ext (by rw [← h₁, ← h₂, hc'])

/-- Part (ii) of the exercise: if every prime ideal of `B` is an extended ideal, then
`f* : Spec B → Spec A` is injective. -/
theorem part_ii (f : A →+* B)
    (h : ∀ q : PrimeSpectrum B, IsExtended f q.asIdeal) :
    Function.Injective (PrimeSpectrum.comap f) :=
  fun _ _ hq => eq_of_comap_eq_of_isExtended f h hq

end ContractedExtended

/-! ### Part (iii): the converse of (ii) is false

The counterexample is the inclusion of a field into its ring of dual numbers,
`K → K[ε] = DualNumber K`, `x ↦ x`.  The ring `K[ε]` is local with unique prime ideal `(ε)`,
the nilradical, so `Spec K[ε]` is a single point and `f*` is injective; but `(ε)` is not an
extended ideal, since the only ideals of the field `K` are `(0)` and `K`.
-/

section DualNumberCounterexample

variable (K : Type*) [Field K]

/-- `ε ≠ 0` in the ring of dual numbers over a field. -/
lemma eps_ne_zero : (ε : K[ε]) ≠ 0 := by
  intro h
  have h1 : (1 : K) = 0 := by simpa using congrArg TrivSqZeroExt.snd h
  exact one_ne_zero h1

/-- `(0)` is not a prime ideal of `K[ε]`: `K[ε]` is not a domain, as `ε * ε = 0 ≠ ε`. -/
lemma bot_not_isPrime : ¬ (⊥ : Ideal K[ε]).IsPrime := by
  intro h
  have hmem : (ε : K[ε]) * ε ∈ (⊥ : Ideal K[ε]) := by simp
  rcases h.mem_or_mem hmem with h' | h' <;>
    exact eps_ne_zero K (by simpa using h')

/-- The nilradical `(ε)` is a prime ideal of `K[ε]`. -/
lemma isPrime_span_eps : (Ideal.span {(ε : K[ε])}).IsPrime :=
  DualNumber.isMaximal_span_singleton_eps.isPrime

/-- **The unique prime of `K[ε]`**: a prime ideal of the dual numbers over a field is the
nilradical `(ε)`. -/
lemma eq_span_eps_of_isPrime (P : PrimeSpectrum K[ε]) :
    P.asIdeal = Ideal.span {(ε : K[ε])} := by
  rcases DualNumber.ideal_trichotomy P.asIdeal with h | h | h
  · exact absurd (h ▸ P.isPrime) (bot_not_isPrime K)
  · exact h
  · exact absurd h P.isPrime.ne_top

/-- **`Spec K[ε]` is a single point.** -/
theorem subsingleton_primeSpectrum : Subsingleton (PrimeSpectrum K[ε]) :=
  ⟨fun P Q => PrimeSpectrum.ext
    ((eq_span_eps_of_isPrime K P).trans (eq_span_eps_of_isPrime K Q).symm)⟩

/-- The contraction of the nilradical `(ε)` along `K → K[ε]` is `(0)`: the induced map on spectra
sends the unique point of `Spec K[ε]` to the unique point of `Spec K`. -/
lemma comap_span_eps_eq_bot :
    Ideal.comap (algebraMap K K[ε]) (Ideal.span {(ε : K[ε])}) = ⊥ := by
  ext x
  rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_span_singleton,
    ← DualNumber.fst_eq_zero_iff_eps_dvd]
  exact Iff.rfl

/-- `Spec K` is a single point for a field `K`. -/
theorem subsingleton_primeSpectrum_field : Subsingleton (PrimeSpectrum K) := inferInstance

/-- The induced map on spectra sends every point of `Spec K[ε]` (there is only one) to the
unique point `(0)` of `Spec K`. -/
lemma comap_algebraMap_asIdeal (q : PrimeSpectrum K[ε]) :
    (PrimeSpectrum.comap (algebraMap K K[ε]) q).asIdeal = ⊥ := by
  rw [PrimeSpectrum.comap_asIdeal, eq_span_eps_of_isPrime K q, comap_span_eps_eq_bot K]

/-- `f*` for `K → K[ε]` is injective, because `Spec K[ε]` is a single point. -/
theorem comap_algebraMap_injective :
    Function.Injective (PrimeSpectrum.comap (algebraMap K K[ε])) :=
  fun x y _ => (subsingleton_primeSpectrum K).allEq x y

/-- The unique prime `(ε)` of `K[ε]` is **not** an extended ideal: the only ideals of the field
`K` are `(0)` and `K`, whose extensions are `(0)` and `K[ε]` respectively, and `(ε)` is neither. -/
theorem span_eps_not_isExtended :
    ¬ IsExtended (algebraMap K K[ε]) (Ideal.span {(ε : K[ε])}) := by
  rintro ⟨a, ha⟩
  rcases Ideal.eq_bot_or_top a with rfl | rfl
  · rw [Ideal.map_bot] at ha
    refine eps_ne_zero K ?_
    rw [← Ideal.mem_bot, ha]
    exact Ideal.subset_span (Set.mem_singleton (ε : K[ε]))
  · rw [Ideal.map_top (algebraMap K K[ε])] at ha
    exact DualNumber.isMaximal_span_singleton_eps.ne_top ha.symm

/-- Part (iii): the converse of (ii) fails.  For `K → K[ε]` the induced map on spectra is
injective, yet not every prime ideal of `K[ε]` is an extended ideal. -/
theorem part_iii :
    Function.Injective (PrimeSpectrum.comap (algebraMap K K[ε])) ∧
      ¬ (∀ q : PrimeSpectrum K[ε], IsExtended (algebraMap K K[ε]) q.asIdeal) :=
  ⟨comap_algebraMap_injective K,
    fun h => span_eps_not_isExtended K (h ⟨Ideal.span {ε}, isPrime_span_eps K⟩)⟩

end DualNumberCounterexample

/-- Explicit counterexample, in positive form: there is a ring homomorphism `f : A → B` whose
induced map on spectra is injective although not every prime ideal of `B` is extended
(namely `f : ℚ → ℚ[ε]` and the prime ideal `(ε)`). -/
theorem exists_injective_not_forall_isExtended :
    ∃ (A B : Type) (_ : CommRing A) (_ : CommRing B) (f : A →+* B),
      Function.Injective (PrimeSpectrum.comap f) ∧
        ¬ ∀ q : PrimeSpectrum B, IsExtended f q.asIdeal :=
  ⟨ℚ, ℚ[ε], inferInstance, inferInstance, algebraMap ℚ ℚ[ε], part_iii ℚ⟩

/-- The negative answer to the question of part (ii): the converse of (ii) is false in general.
The counterexample is `K → K[ε]` for any field `K`. -/
theorem converse_of_part_ii_fails :
    ¬ ∀ (A B : Type) [CommRing A] [CommRing B] (f : A →+* B),
        Function.Injective (PrimeSpectrum.comap f) →
          ∀ q : PrimeSpectrum B, IsExtended f q.asIdeal := by
  intro h
  exact (part_iii ℚ).2 (h ℚ ℚ[ε] (algebraMap ℚ ℚ[ε]) (part_iii ℚ).1)

/-! ### Audit: the analogue of (i) for *all* ideals is false

Part (i) is genuinely about prime ideals.  The implication "every ideal of `A` is contracted ⇒
`f*` is surjective" is true (`surjective_of_forall_isContracted`), but the converse fails: taking
`fst : ℚ[ε] → ℚ` (the projection onto the constant term) the map `f*` is surjective because both
spectra are single points, while the zero ideal of `ℚ[ε]` is not contracted, since the only
ideals of `ℚ` are `(0)` and `ℚ`, with contractions `(ε)` and `ℚ[ε]`.
-/

section FstAudit

/-- If *every* ideal of `A` is contracted then `f*` is surjective (the easy direction of the
analogue of part (i) for all ideals). -/
theorem surjective_of_forall_isContracted {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (h : ∀ a : Ideal A, IsContracted f a) :
    Function.Surjective (PrimeSpectrum.comap f) :=
  part_i_mp f fun p => h p.asIdeal

variable (K : Type*) [Field K]

/-- The ideal `(0)` of `K` contracts to `(ε)` along the constant-term projection. -/
lemma comap_fst_bot :
    Ideal.comap (TrivSqZeroExt.fstHom K K K).toRingHom (⊥ : Ideal K)
      = Ideal.span {(ε : K[ε])} := by
  ext x
  rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_span_singleton,
    ← DualNumber.fst_eq_zero_iff_eps_dvd]
  exact Iff.rfl

/-- The analogue of part (i) with "every prime ideal" replaced by "every ideal" fails in the
direction ⇐ (concretely, for `fst : ℚ[ε] → ℚ`). -/
theorem not_forall_isContracted_of_surjective :
    ∃ (A B : Type) (_ : CommRing A) (_ : CommRing B) (f : A →+* B),
      Function.Surjective (PrimeSpectrum.comap f) ∧ ¬ ∀ a : Ideal A, IsContracted f a := by
  refine ⟨ℚ[ε], ℚ, inferInstance, inferInstance,
    (TrivSqZeroExt.fstHom ℚ ℚ ℚ).toRingHom, ?_, ?_⟩
  · intro q
    refine ⟨⟨⊥, Ideal.bot_isMaximal.isPrime⟩, PrimeSpectrum.ext ?_⟩
    rw [PrimeSpectrum.comap_asIdeal, comap_fst_bot ℚ, eq_span_eps_of_isPrime ℚ q]
  · intro h
    obtain ⟨J, hJ⟩ := h ⊥
    rcases Ideal.eq_bot_or_top J with rfl | rfl
    · have hmem : (ε : ℚ[ε]) ∈ Ideal.comap (TrivSqZeroExt.fstHom ℚ ℚ ℚ).toRingHom
          (⊥ : Ideal ℚ) := by
        rw [comap_fst_bot ℚ]
        exact Ideal.subset_span (Set.mem_singleton (ε : ℚ[ε]))
      rw [hJ, Ideal.mem_bot] at hmem
      exact eps_ne_zero ℚ hmem
    · have htop : (⊤ : Ideal ℚ[ε]) = ⊥ := by
        rw [← hJ, Ideal.comap_top]
      exact top_ne_bot htop

end FstAudit

/-- The complete exercise: (i) the equivalence, (ii) the implication, and (iii) the failure of
the converse of (ii). -/
theorem solution :
    (∀ {A B : Type*} [CommRing A] [CommRing B] (f : A →+* B),
        (∀ p : PrimeSpectrum A, IsContracted f p.asIdeal) ↔
          Function.Surjective (PrimeSpectrum.comap f)) ∧
      (∀ {A B : Type*} [CommRing A] [CommRing B] (f : A →+* B),
        (∀ q : PrimeSpectrum B, IsExtended f q.asIdeal) →
          Function.Injective (PrimeSpectrum.comap f)) ∧
      ¬ ∀ (A B : Type) [CommRing A] [CommRing B] (f : A →+* B),
          Function.Injective (PrimeSpectrum.comap f) →
            ∀ q : PrimeSpectrum B, IsExtended f q.asIdeal :=
  ⟨fun f => part_i f, fun f => part_ii f, converse_of_part_ii_fails⟩

end AtiyahMcdonald69.Ex_3_20
