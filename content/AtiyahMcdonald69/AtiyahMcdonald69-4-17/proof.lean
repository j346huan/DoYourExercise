/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969),
Chapter 4 (Primary Decomposition), Exercise 17 (book pages 56–57).

**Original statement** (verbatim, from the text of the book):

  "17. Let A be a ring with the following property.

   (L1) For every ideal a ≠ (1) in A and every prime ideal p, there exists x ∉ p such that
   S_p(a) = (a:x), where S_p = A - p.

   Then every ideal in A is an intersection of (possibly infinitely many) primary ideals."

Here `S_p = A - p = p.primeCompl` and `S_p(a)` is the *saturation* of `a` with respect to the
multiplicatively closed set `A - p`, i.e. the contraction of `S_p⁻¹ a` to `A` (Chapter 4,
Exercise 12): `S_p(a) = { y | ∃ s ∉ p, s*y ∈ a }`.  `(a : x)` is the colon ideal
`a.colon (span {x}) = { y | y*x ∈ a }`.

**Proof route formalised here** (Zorn + irreducible ideals, rather than the book's transfinite
recursion):

* every ideal is an intersection of irreducible ideals (`eq_sInf_infIrred`), which is Zorn's
  lemma: for `y ∉ a` there is an ideal maximal among ideals containing `a` and avoiding `y`;
* under (L1) every irreducible ideal is primary (`isPrimary_of_infIrred`).  Concretely, for `b`
  irreducible one chooses a prime `p` minimal over `b` and applies (L1) to get `x ∉ p` with
  `S_p(b) = (b : x)`, whence `b = S_p(b) ⊓ (b + (x))`; irreducibility forces `b = S_p(b)`, and
  `S_p(b)` is `p`-primary because `p` is minimal over `b`.

The natural solution invokes Atiyah–Macdonald Exercise 4.11 for the last step ("`S_p(b)` is
`p`-primary when `p` is minimal over `b`"); that is not in Mathlib, so it is proved here from
scratch (`radical_saturation_eq_of_isMinimalPrime`, `isPrimary_saturation`).  Nothing else is
imported beyond Mathlib, and there are no `sorry`s.
-/
import Mathlib

-- `Ideal.primeCompl` takes the primality of `p` as a typeclass argument, so in a few proofs the
-- available hypothesis `p.IsPrime` has to be registered as an instance; the style linter that
-- prefers `have` over `haveI` for propositions is therefore switched off.
set_option linter.style.haveILetI false

namespace AtiyahMcdonald69.Ex_4_17

variable {A : Type*} [CommRing A]

/-! ## The saturation `S_I(a)` -/

/-- The **saturation** of an ideal `I` with respect to a multiplicatively closed subset `S ⊆ A`
(Atiyah–Macdonald, Chapter 4, Exercise 12): the contraction of `S⁻¹I` to `A`, i.e.
`S_I(I) = { y | ∃ s ∈ S, s * y ∈ I }`.  In the notation of Exercise 17, `S_p(a)` is
`saturation p.primeCompl a`. -/
def saturation (S : Submonoid A) (I : Ideal A) : Ideal A where
  carrier := {y | ∃ s ∈ S, s * y ∈ I}
  zero_mem' := ⟨1, S.one_mem, by simp⟩
  add_mem' := by
    rintro x y ⟨s, hs, hx⟩ ⟨t, ht, hy⟩
    refine ⟨s * t, S.mul_mem hs ht, ?_⟩
    have h : s * t * (x + y) = t * (s * x) + s * (t * y) := by ring
    rw [h]
    exact I.add_mem (I.mul_mem_left t hx) (I.mul_mem_left s hy)
  smul_mem' := by
    intro c x ⟨s, hs, hx⟩
    refine ⟨s, hs, ?_⟩
    show s * (c * x) ∈ I
    have h : s * (c * x) = c * (s * x) := by ring
    rw [h]
    exact I.mul_mem_left c hx

@[simp]
theorem mem_saturation {S : Submonoid A} {I : Ideal A} {y : A} :
    y ∈ saturation S I ↔ ∃ s ∈ S, s * y ∈ I := Iff.rfl

theorem saturation_mono (S : Submonoid A) {I J : Ideal A} (h : I ≤ J) :
    saturation S I ≤ saturation S J :=
  fun _ ⟨s, hs, hsy⟩ => ⟨s, hs, h hsy⟩

theorem le_saturation (S : Submonoid A) (I : Ideal A) : I ≤ saturation S I :=
  fun y hy => ⟨1, S.one_mem, by simpa using hy⟩

/-- A saturated ideal is stable under division by elements of `S`. -/
theorem saturation_mul_mem {S : Submonoid A} {I : Ideal A} {s y : A} (hs : s ∈ S)
    (h : s * y ∈ saturation S I) : y ∈ saturation S I := by
  obtain ⟨t, ht, hty⟩ := h
  refine ⟨t * s, S.mul_mem ht hs, ?_⟩
  have h' : t * s * y = t * (s * y) := by ring
  rw [h']
  exact hty

/-- `S_p(a) ⊆ p` for `p` prime and `a ⊆ p`. -/
theorem saturation_le_of_le_prime {p I : Ideal A} (hp : p.IsPrime) (h : I ≤ p) :
    saturation p.primeCompl I ≤ p := by
  rintro y ⟨s, hs, hsy⟩
  rcases hp.mem_or_mem (h hsy) with h' | h'
  · exact absurd h' hs
  · exact h'

/-! ## The radical of `S_p(b)` for `p` minimal over `b` -/

/-- The multiplicatively closed set generated by `A - p` and `y`, namely
`{ s * y ^ n | s ∉ p, n : ℕ }`. -/
def primeComplPowers (p : Ideal A) [hp : p.IsPrime] (y : A) : Submonoid A where
  carrier := {z | ∃ s : A, s ∉ p ∧ ∃ n : ℕ, s * y ^ n = z}
  one_mem' := ⟨1, (Ideal.ne_top_iff_one p).mp hp.ne_top, 0, by simp⟩
  mul_mem' := by
    rintro a b ⟨s, hs, m, rfl⟩ ⟨t, ht, n, rfl⟩
    refine ⟨s * t, ?_, m + n, by rw [pow_add]; ring⟩
    intro h
    exact (hp.mem_or_mem h).elim hs ht

@[simp]
theorem mem_primeComplPowers {p : Ideal A} [hp : p.IsPrime] {y z : A} :
    z ∈ primeComplPowers p y ↔ ∃ s : A, s ∉ p ∧ ∃ n : ℕ, s * y ^ n = z := Iff.rfl

/-- If `p` is a minimal prime ideal over `b`, then `p` is the radical of the saturation
`S_p(b)`: the inclusion `p ⊆ √(S_p(b))` is the substantive half, proved by enlarging `b` to a
prime ideal disjoint from the multiplicatively closed set `{ s * y ^ n | s ∉ p }`. -/
theorem radical_saturation_eq_of_isMinimalPrime {b p : Ideal A} [hp : p.IsPrime]
    (h : b.IsMinimalPrime p) : (saturation p.primeCompl b).radical = p := by
  refine le_antisymm (hp.radical_le_iff.mpr (saturation_le_of_le_prime hp h.le)) ?_
  intro y hy
  rw [Ideal.mem_radical_iff]
  by_contra hcon
  simp only [not_exists] at hcon
  have hdisj : Disjoint (b : Set A) ((primeComplPowers p y : Submonoid A) : Set A) := by
    rw [Set.disjoint_left]
    rintro z hz ⟨s, hs, n, hsz⟩
    rw [← hsz] at hz
    exact hcon n ⟨s, hs, hz⟩
  obtain ⟨P, hP, hbP, hPdisj⟩ := Ideal.exists_le_prime_disjoint b (primeComplPowers p y) hdisj
  have hPle : P ≤ p := by
    intro z hz
    by_contra hzp
    exact Set.disjoint_left.mp hPdisj hz ⟨z, hzp, 0, by simp⟩
  have hPge : p ≤ P := h.le_of_le ⟨hP, hbP⟩ hPle
  exact Set.disjoint_left.mp hPdisj (hPge hy) ⟨1, (Ideal.ne_top_iff_one p).mp hp.ne_top, 1, by simp⟩

/-- **`S_p(b)` is `p`-primary when `p` is a minimal prime ideal over `b`** (this is the content of
Atiyah–Macdonald, Chapter 4, Exercise 11, which Exercise 17 invokes). -/
theorem isPrimary_saturation {b p : Ideal A} [hp : p.IsPrime] (h : b.IsMinimalPrime p) :
    (saturation p.primeCompl b).IsPrimary := by
  have hrad := radical_saturation_eq_of_isMinimalPrime h
  have hle := saturation_le_of_le_prime hp h.le
  rw [Ideal.isPrimary_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    have h1 : (1 : A) ∈ saturation p.primeCompl b := htop ▸ Submodule.mem_top
    obtain ⟨s, hs, hs1⟩ := h1
    exact hs (h.le (by simpa using hs1))
  · intro x y hxy
    by_cases hx : x ∈ p
    · by_cases hy : y ∈ p
      · exact Or.inr (by rw [hrad]; exact hy)
      · have hyx : y * x ∈ saturation p.primeCompl b := by rwa [mul_comm] at hxy
        exact Or.inl (saturation_mul_mem hy hyx)
    · refine Or.inr (by rw [hrad]; exact hle (saturation_mul_mem hx hxy))

/-- Any `p`-primary ideal containing `b` contains `S_p(b)`.  (Primary: from `s·y ∈ q` with
`s ∉ p = √q` we get `y ∈ q`; here `S_p = A - p`, so `s ∉ p`.) -/
theorem saturation_le_of_isPrimary {b p q : Ideal A} [hp : p.IsPrime]
    (hq : q.IsPrimary) (hqr : q.radical = p) (hbq : b ≤ q) : saturation p.primeCompl b ≤ q := by
  rintro y ⟨s, hs, hsy⟩
  have hsq : s ∉ q.radical := by rw [hqr]; exact hs
  have hys : y * s ∈ q := by rw [mul_comm]; exact hbq hsy
  rcases (Ideal.isPrimary_iff.mp hq).2 hys with h | h
  · exact h
  · exact absurd h hsq

/-- **Atiyah–Macdonald, Chapter 4, Exercise 11** — the ingredient that Exercise 17 imports — in the
form in which Exercise 17 uses it: if `p` is a minimal prime ideal over `b`, then `S_p(b)` is
`p`-primary and is contained in every `p`-primary ideal containing `b`, i.e. it is the *least*
`p`-primary ideal containing `b`. -/
theorem saturation_isLeast_isPrimary_of_isMinimalPrime {b p : Ideal A} [hp : p.IsPrime]
    (h : b.IsMinimalPrime p) :
    (saturation p.primeCompl b).IsPrimary ∧ b ≤ saturation p.primeCompl b ∧
      ∀ q : Ideal A, q.IsPrimary → q.radical = p → b ≤ q → saturation p.primeCompl b ≤ q :=
  ⟨isPrimary_saturation h, le_saturation _ _,
    fun _ hq hqr hbq => saturation_le_of_isPrimary hq hqr hbq⟩

/-! ## Condition (L1) and irreducible ideals -/

/-- Atiyah–Macdonald's condition (L1) (Chapter 4, Exercise 17): for every proper ideal `a` and
every prime ideal `p` there is `x ∉ p` such that `S_p(a) = (a : x)`. -/
def ConditionL1 : Prop :=
  ∀ (a : Ideal A), a ≠ ⊤ → ∀ (p : Ideal A) [p.IsPrime],
    ∃ x : A, x ∉ p ∧ saturation p.primeCompl a = a.colon (Ideal.span {x})

/-- `(a : x) = { y | y * x ∈ a }`. -/
theorem mem_colon_singleton {a : Ideal A} {x y : A} :
    y ∈ a.colon (Ideal.span {x}) ↔ y * x ∈ a :=
  Ideal.mem_colon_span_singleton

/-- **Irreducible ideals are primary under (L1).**  Let `b` be irreducible, and let `p` be a prime
ideal minimal over `b`.  Condition (L1) provides `x ∉ p` with `S_p(b) = (b : x)`; then
`b = S_p(b) ⊓ (b + (x))`, and since `b + (x) ≠ b`, irreducibility forces `b = S_p(b)`, which is
`p`-primary. -/
theorem isPrimary_of_infIrred (hL1 : ConditionL1 (A := A)) {b : Ideal A} (hb : InfIrred b) :
    b.IsPrimary := by
  obtain ⟨p, hp⟩ := Ideal.nonempty_minimalPrimes hb.ne_top
  haveI : p.IsPrime := hp.isPrime
  obtain ⟨x, hx, hq⟩ := hL1 b hb.ne_top p
  set q := saturation p.primeCompl b with hqdef
  have hbq : b ≤ q := le_saturation _ _
  have hxb : x ∉ b := fun h => hx (hp.le h)
  have hsup : b ⊔ Ideal.span {x} ≠ b := by
    intro h
    refine hxb (h ▸ ?_)
    exact Submodule.mem_sup_right (Ideal.mem_span_singleton_self x)
  have hkey : q ⊓ (b ⊔ Ideal.span {x}) = b := by
    refine le_antisymm ?_ (le_inf hbq le_sup_left)
    intro z hz
    obtain ⟨hzq, hzs⟩ := Ideal.mem_inf.mp hz
    obtain ⟨b₀, hb₀, x', hx', hsum⟩ := Submodule.mem_sup.mp hzs
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx'
    rw [mul_comm x a] at hsum
    have hax : a * x ∈ q := by
      have h : (b₀ + a * x) - b₀ ∈ q := q.sub_mem (hsum ▸ hzq) (hbq hb₀)
      rwa [show (b₀ + a * x) - b₀ = a * x by ring] at h
    have ha : a ∈ q :=
      saturation_mul_mem (show x ∈ p.primeCompl from hx) (by rwa [mul_comm] at hax)
    rw [hq] at ha
    exact hsum ▸ b.add_mem hb₀ (Ideal.mem_colon_span_singleton.mp ha)
  rcases hb.2 hkey with h | h
  · exact h ▸ isPrimary_saturation hp
  · exact absurd h hsup

/-- **A maximal ideal avoiding a given element.**  If `y ∉ a`, there is an ideal containing `a`,
not containing `y`, and maximal with these properties; it is irreducible. -/
theorem exists_infIrred_le_notMem (a : Ideal A) {y : A} (hy : y ∉ a) :
    ∃ m : Ideal A, a ≤ m ∧ y ∉ m ∧ InfIrred m := by
  obtain ⟨m, ham, hm⟩ :=
    zorn_le_nonempty₀ {m : Ideal A | y ∉ m}
      (fun c hc hc' z hz => by
        refine ⟨sSup c, ?_, fun w hw => le_sSup hw⟩
        intro hys
        obtain ⟨n, hnc, hyn⟩ :=
          (Submodule.mem_sSup_of_directed ⟨z, hz⟩ hc'.directedOn).mp hys
        exact hc hnc hyn)
      a hy
  refine ⟨m, ham, hm.1, ?_, ?_⟩
  · intro hmax
    rw [isMax_iff_eq_top] at hmax
    exact hm.1 (hmax ▸ Submodule.mem_top)
  · rintro J K hJK
    by_contra hcon
    simp only [not_or] at hcon
    have hmJ : m ≤ J := hJK ▸ inf_le_left
    have hmK : m ≤ K := hJK ▸ inf_le_right
    have hyJ : y ∈ J := by
      by_contra hyJ
      exact hcon.1 (le_antisymm (hm.2 hyJ hmJ) hmJ)
    have hyK : y ∈ K := by
      by_contra hyK
      exact hcon.2 (le_antisymm (hm.2 hyK hmK) hmK)
    exact hm.1 (hJK ▸ Ideal.mem_inf.mpr ⟨hyJ, hyK⟩)

/-- The Atiyah–Macdonald definition of an *irreducible* ideal: `I ≠ ⊤` and `I` is not the
intersection of two strictly larger ideals.  This is exactly Mathlib's `InfIrred`. -/
theorem infIrred_iff (I : Ideal A) :
    InfIrred I ↔ I ≠ ⊤ ∧ ∀ J K : Ideal A, I < J → I < K → J ⊓ K ≠ I := by
  constructor
  · rintro ⟨hmax, h⟩
    refine ⟨by rwa [isMax_iff_eq_top] at hmax, ?_⟩
    intro J K hJ hK hJK
    rcases h hJK with h' | h'
    · exact (ne_of_gt hJ) h'
    · exact (ne_of_gt hK) h'
  · rintro ⟨hne, h⟩
    refine ⟨by rwa [isMax_iff_eq_top], ?_⟩
    intro J K hJK
    by_contra hc
    rw [not_or] at hc
    exact h J K (lt_of_le_of_ne (hJK ▸ inf_le_left) (Ne.symm hc.1))
      (lt_of_le_of_ne (hJK ▸ inf_le_right) (Ne.symm hc.2)) hJK

/-- **Every ideal is an intersection of irreducible ideals** (no hypothesis on `A`). -/
theorem eq_sInf_infIrred (a : Ideal A) :
    a = sInf {m : Ideal A | InfIrred m ∧ a ≤ m} := by
  refine le_antisymm (le_sInf fun m hm => hm.2) ?_
  intro z hz
  by_contra hza
  obtain ⟨m, ham, hzm, him⟩ := exists_infIrred_le_notMem a hza
  exact hzm (sInf_le (show m ∈ {m : Ideal A | InfIrred m ∧ a ≤ m} from ⟨him, ham⟩) hz)

/-- **Atiyah–Macdonald, Chapter 4, Exercise 17.**  Let `A` be a ring satisfying (L1): for every
ideal `a ≠ (1)` and every prime ideal `p` there is `x ∉ p` with `S_p(a) = (a : x)`.  Then every
ideal of `A` is an intersection of (possibly infinitely many) primary ideals.

(The ideal `⊤` is the empty intersection, `sInf ∅ = ⊤`, so "possibly infinitely many" covers the
improper case, exactly as in the book.) -/
theorem solution (hL1 : ConditionL1 (A := A)) (a : Ideal A) :
    ∃ S : Set (Ideal A), (∀ q ∈ S, q.IsPrimary) ∧ a = sInf S :=
  ⟨{m : Ideal A | InfIrred m ∧ a ≤ m},
    fun _ hq => isPrimary_of_infIrred hL1 hq.1,
    eq_sInf_infIrred a⟩

/-- **Exercise 17**, set-theoretic form: the intersection exhibited in `solution` really is the
intersection of the primary ideals, computed in the set `A`. -/
theorem solution_iInter (hL1 : ConditionL1 (A := A)) (a : Ideal A) :
    ∃ S : Set (Ideal A), (∀ q ∈ S, q.IsPrimary) ∧ (a : Set A) = ⋂ q ∈ S, (q : Set A) := by
  obtain ⟨S, hS, hEq⟩ := solution hL1 a
  exact ⟨S, hS, by rw [hEq, Submodule.coe_sInf]⟩

/-- The saturation is the contraction of the localisation `S⁻¹I` — this is the definition of
`S_I(a)` in Atiyah–Macdonald (Chapter 4, Exercise 12). -/
theorem saturation_eq_comap_map (S : Submonoid A) (I : Ideal A) :
    saturation S I = (I.map (algebraMap A (Localization S))).comap (algebraMap A (Localization S)) := by
  ext x
  rw [mem_saturation, Ideal.mem_comap,
    IsLocalization.algebraMap_mem_map_algebraMap_iff S (Localization S) I x]

/-- Consistency check: a field satisfies (L1).  The only proper ideal is `⊥`, and for it (L1) holds
with `x = 1`; thus the hypothesis of `solution` is satisfiable. -/
theorem conditionL1_of_field (K : Type*) [Field K] : ConditionL1 (A := K) := by
  intro a ha p hp
  haveI : p.IsPrime := hp
  have hpbot : p = ⊥ := (Ideal.eq_bot_or_top p).resolve_right hp.ne_top
  have habot : a = ⊥ := (Ideal.eq_bot_or_top a).resolve_right ha
  subst hpbot
  subst habot
  have h1 : saturation (⊥ : Ideal K).primeCompl (⊥ : Ideal K) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro y ⟨s, hs, hsy⟩
    have hs0 : s ≠ 0 := by simpa using hs
    have hsy0 : s * y = 0 := by simpa using hsy
    exact (mul_eq_zero.mp hsy0).resolve_left hs0
  have h2 : (⊥ : Ideal K).colon (Ideal.span {(1 : K)}) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro y hy
    rw [Ideal.mem_colon_span_singleton, mul_one, Submodule.mem_bot] at hy
    exact hy
  exact ⟨1, by simp, by rw [h1, h2]⟩

