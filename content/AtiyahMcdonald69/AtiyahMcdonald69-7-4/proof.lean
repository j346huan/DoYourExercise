/-
# Atiyah–Macdonald, Chapter 7, Exercise 4, recovered in Lean 4 / Mathlib

*Which of the following rings are Noetherian?*
  (i) rational functions of `z` having no pole on the circle `|z| = 1`;
 (ii) power series in `z` with a positive radius of convergence;
(iii) power series in `z` with an infinite radius of convergence;
 (iv) polynomials in `z` whose first `k` derivatives vanish at the origin (`k` fixed);
  (v) polynomials in `z, w` all of whose partial derivatives with respect to `w` vanish
      for `z = 0`.
In all cases the coefficients are complex numbers.

Answers: (i) yes, (ii) yes, (iii) no, (iv) yes, (v) no.

## The precise universe of each ring, and the closure conditions

Part (i).  `noPoleOnCircle` is the subring of `FractionRing ℂ[X] = ℂ(X)` of
rational functions with a presentation `p/q` whose denominator never vanishes on the
unit circle.  `locToFrac_range` identifies it with the image of the localization
`S⁻¹ℂ[X]` with `S = {q : ℂ[X] // ∀ z, ‖z‖ = 1 → q.eval z ≠ 0}`, so it is Noetherian.
Evaluation at circle points is independent of the chosen presentation, and
`inv_X_sub_one_not_mem` proves the ring proper explicitly.

Parts (iv) and (v) are literally about polynomials; they are formalized as
`Subalgebra ℂ ℂ[X]` and `Subalgebra ℂ (ℂ[w])[z]` by the exact derivative conditions.

The analytic parts (ii) and (iii) are formalized **directly on Mathlib's
`PowerSeries ℂ = ℂ⟦X⟧`** (coefficient sequences `ℕ → ℂ`), never on germs or entire
functions:

* `convSubring : Subring ℂ⟦X⟧` is the set of series whose coefficients satisfy an
  explicit growth bound `∃ C M, 0 ≤ C ∧ 0 < M ∧ ∀ n, ‖a n‖ ≤ C * M ^ n`.
  `growth_iff_posRadius` proves this set is **exactly** the set of power series
  converging on some disc of positive radius (the book's "positive radius of
  convergence"), i.e. `a ∈ convSubring ↔ ∃ ρ > 0, ∀ z, ‖z‖ < ρ → Summable (a n * z^n)`.
  Note the quantifier structure: this is the union over **all** `ρ > 0` of the series
  convergent on the disc of radius `ρ` — not convergence at one particular point and
  not one fixed radius.
  Closure under `+` and `*` is proved by absorbing the polynomial factor of the
  antidiagonal sum into the geometric bound (`(n+1) ≤ 2^n`); no summability or
  Hadamard theory is assumed.  Every ideal of the convergent subring is principal, using the least order of a
  nonzero coefficient. A series with nonzero constant term is a unit (its reciprocal has a growth bound,
  proved by an explicit induction on the recursion of `PowerSeries.invOfUnit`).
* `entireSubring : Subring ℂ⟦X⟧` is the set of series whose coefficients obey **every**
  growth bound (`∀ M > 0, ∃ C, ∀ n, ‖a n‖ ≤ C * M ^ n`), and `growthAll_iff_infRadius`
  proves this is exactly the set of series converging everywhere (all of `ℂ`), i.e. the
  book's "infinite radius of convergence" — again a union/intersection condition over
  all radii, not a condition at a single point.  It is shown to be non-Noetherian by the strictly
  increasing chain of principal ideals generated by
  `ψ / ((X-1)···(X-n))`, where `ψ = ∑ (2πi)^n/n! X^n - 1` is the exponential series
  (it converges everywhere and vanishes at every positive integer).  Division by
  `X - c` (`c ≠ 0`) inside this ring when the value at `c` vanishes is
  `exists_div_linear`, whose quotient is the closed formula `g n = ∑_j f (n+1+j) c^j`.

Everything is proved in this one file; it uses only `Mathlib` (no extra imports),
no `sorry`/`admit`, and no axioms beyond Lean's kernel axioms (see `#print axioms`
at the end).
-/

import Mathlib

noncomputable section

namespace AtiyahMcdonald69.Ex_7_4

/-! ## Part (i): rational functions with no pole on the unit circle -/

section PolynomialParts

open Polynomial

/-! ## The multiplicative set and the subring of `ℂ(X)` -/

/-- The multiplicative subset of `ℂ[X]` of polynomials that do not vanish on the unit
circle `|z| = 1`. -/
def unitCirclePolys : Submonoid ℂ[X] where
  carrier := {f | ∀ z : ℂ, ‖z‖ = 1 → f.eval z ≠ 0}
  one_mem' := by intro z _; simp
  mul_mem' := by
    intro f g hf hg z hz
    simp only [Polynomial.eval_mul]
    exact mul_ne_zero (hf z hz) (hg z hz)

/-- The rational functions of `z` that admit a presentation `p/q` with `q` not vanishing
on the unit circle: the rational functions with no pole on `|z| = 1`, as a subring of
`ℂ(X) = FractionRing ℂ[X]`. -/
def noPoleOnCircle : Subring (FractionRing ℂ[X]) where
  carrier := {f | ∃ p q : ℂ[X], (∀ z : ℂ, ‖z‖ = 1 → q.eval z ≠ 0) ∧
    f * algebraMap ℂ[X] (FractionRing ℂ[X]) q = algebraMap ℂ[X] (FractionRing ℂ[X]) p}
  zero_mem' := ⟨0, 1, by intro z _; simp, by simp⟩
  one_mem' := ⟨1, 1, by intro z _; simp, by simp⟩
  add_mem' := by
    rintro f g ⟨p1, q1, hq1, h1⟩ ⟨p2, q2, hq2, h2⟩
    refine ⟨p1 * q2 + p2 * q1, q1 * q2, fun z hz => ?_, ?_⟩
    · simp only [Polynomial.eval_mul]
      exact mul_ne_zero (hq1 z hz) (hq2 z hz)
    · simp only [map_mul, map_add]
      rw [← h1, ← h2]
      ring
  mul_mem' := by
    rintro f g ⟨p1, q1, hq1, h1⟩ ⟨p2, q2, hq2, h2⟩
    refine ⟨p1 * p2, q1 * q2, fun z hz => ?_, ?_⟩
    · simp only [Polynomial.eval_mul]
      exact mul_ne_zero (hq1 z hz) (hq2 z hz)
    · simp only [map_mul]
      rw [← h1, ← h2]
      ring
  neg_mem' := by
    rintro f ⟨p, q, hq, h⟩
    refine ⟨-p, q, hq, ?_⟩
    rw [map_neg, ← h]
    ring

theorem mem_noPoleOnCircle {f : FractionRing ℂ[X]} :
    f ∈ noPoleOnCircle ↔ ∃ p q : ℂ[X], (∀ z : ℂ, ‖z‖ = 1 → q.eval z ≠ 0) ∧
      f * algebraMap ℂ[X] (FractionRing ℂ[X]) q = algebraMap ℂ[X] (FractionRing ℂ[X]) p :=
  Iff.rfl

/-! ## It is the image of the localization `S⁻¹ℂ[X]`, hence Noetherian -/

/-- Every polynomial without zeros on the unit circle is a unit in `ℂ(X)`. -/
theorem isUnit_algebraMap_of_mem (y : unitCirclePolys) :
    IsUnit (algebraMap ℂ[X] (FractionRing ℂ[X]) (y : ℂ[X])) := by
  rw [isUnit_iff_ne_zero]
  intro h0
  have hy0 : (y : ℂ[X]) = 0 :=
    IsFractionRing.injective ℂ[X] (FractionRing ℂ[X]) (by rw [h0, map_zero])
  have h1 := y.2 1 (by norm_num)
  rw [hy0] at h1
  simp at h1

/-- The localization map `S⁻¹ℂ[X] → ℂ(X)`. -/
noncomputable def locToFrac :
    Localization unitCirclePolys →+* FractionRing ℂ[X] :=
  IsLocalization.lift (M := unitCirclePolys)
    (g := algebraMap ℂ[X] (FractionRing ℂ[X])) isUnit_algebraMap_of_mem

/-- The image of `S⁻¹ℂ[X]` in `ℂ(X)` is exactly the set of rational functions admitting
a denominator with no zero on the unit circle. -/
theorem locToFrac_range : locToFrac.range = noPoleOnCircle := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    obtain ⟨⟨r, m⟩, rfl⟩ := IsLocalization.mk'_surjective unitCirclePolys x
    have hspec := (IsLocalization.lift_mk'_spec (M := unitCirclePolys)
      (g := algebraMap ℂ[X] (FractionRing ℂ[X])) isUnit_algebraMap_of_mem r
      (locToFrac (IsLocalization.mk' (Localization unitCirclePolys) r m)) m).mp rfl
    exact ⟨r, (m : ℂ[X]), m.2, by rw [hspec]; ring⟩
  · rintro f ⟨p, q, hq, hpq⟩
    exact ⟨(IsLocalization.mk' (Localization unitCirclePolys) p
        (⟨q, hq⟩ : unitCirclePolys) : Localization unitCirclePolys),
      (IsLocalization.lift_mk'_spec (M := unitCirclePolys)
        (g := algebraMap ℂ[X] (FractionRing ℂ[X])) isUnit_algebraMap_of_mem p f
        (⟨q, hq⟩ : unitCirclePolys)).mpr (by rw [mul_comm]; exact hpq.symm)⟩

/-- **(i)**, faithful form: the ring of rational functions of `z` with no pole on the
unit circle — realized as a subring of `ℂ(X)` — is Noetherian. -/
theorem isNoetherian_noPoleOnCircle : IsNoetherianRing ↥noPoleOnCircle := by
  rw [← locToFrac_range]
  exact isNoetherianRing_range locToFrac

/-- The localization form: `S⁻¹ℂ[X]` is Noetherian.  (This is the statement the
candidate file proves; here it is a consequence of the identification above.) -/
theorem isNoetherian_localization : IsNoetherianRing (Localization unitCirclePolys) :=
  inferInstance

/-! ## Values on the unit circle -/

/-- Two presentations `f = p/q = p'/q'` of the same rational function agree at every
point of the unit circle: `p(z) q'(z) = p'(z) q(z)`. -/
theorem eval_value_independent {f : FractionRing ℂ[X]} {p q p' q' : ℂ[X]}
    (hp : f * algebraMap ℂ[X] (FractionRing ℂ[X]) q = algebraMap ℂ[X] (FractionRing ℂ[X]) p)
    (hp' : f * algebraMap ℂ[X] (FractionRing ℂ[X]) q' =
      algebraMap ℂ[X] (FractionRing ℂ[X]) p') {z : ℂ} :
    p.eval z * q'.eval z = p'.eval z * q.eval z := by
  have hinj := IsFractionRing.injective ℂ[X] (FractionRing ℂ[X])
  have key : p * q' = p' * q := by
    apply hinj
    simp only [map_mul]
    rw [← hp, ← hp']
    ring
  calc p.eval z * q'.eval z = (p * q').eval z := by rw [Polynomial.eval_mul]
    _ = (p' * q).eval z := by rw [key]
    _ = p'.eval z * q.eval z := by rw [Polynomial.eval_mul]

/-- The value of `f : noPoleOnCircle` at a point of the unit circle, read off from the
canonical presentation of `f`. -/
noncomputable def evalOnCircle (f : ↥noPoleOnCircle) (z : ℂ) (_hz : ‖z‖ = 1) : ℂ :=
  f.2.choose.eval z / f.2.choose_spec.choose.eval z

/-- **The point of "no pole on `S¹`".**  The value at a point of the unit circle does not
depend on the presentation `f = p/q` chosen: for any `p`, `q` with `q` non-vanishing on
the circle and `f * q = p`, the value `p(z)/q(z)` is the value computed from the
canonical presentation. -/
theorem evalOnCircle_eq (f : ↥noPoleOnCircle) {p q : ℂ[X]}
    (hq : ∀ z : ℂ, ‖z‖ = 1 → q.eval z ≠ 0)
    (hp : (f : FractionRing ℂ[X]) * algebraMap ℂ[X] (FractionRing ℂ[X]) q =
      algebraMap ℂ[X] (FractionRing ℂ[X]) p) {z : ℂ} (hz : ‖z‖ = 1) :
    evalOnCircle f z hz = p.eval z / q.eval z := by
  rw [evalOnCircle, div_eq_div_iff (f.2.choose_spec.choose_spec.1 z hz) (hq z hz)]
  exact eval_value_independent f.2.choose_spec.choose_spec.2 hp

/-- Evaluating a polynomial (seen as an element of `noPoleOnCircle`) recovers the
polynomial value: a sanity check that `evalOnCircle` is the honest evaluation. -/
theorem evalOnCircle_algebraMap (p : ℂ[X]) (z : ℂ) (hz : ‖z‖ = 1) :
    evalOnCircle ⟨algebraMap ℂ[X] (FractionRing ℂ[X]) p,
      ⟨p, 1, by intro w _; simp, by simp⟩⟩ z hz = p.eval z := by
  rw [evalOnCircle_eq _ (p := p) (q := 1) (by intro w _; simp) (by simp)]
  simp

/-! ## The ring is a proper subring of `ℂ(X)` -/

/-- `X - 1` is a non-zero polynomial. -/
theorem X_sub_one_ne_zero : (X - 1 : ℂ[X]) ≠ 0 := by
  intro h0
  have h1 : (X - 1 : ℂ[X]).eval 2 = 0 := by rw [h0]; simp
  norm_num at h1

/-- `1/(X-1)` has a pole at `1 ∈ S¹`, so it is not a rational function without poles on
the unit circle.  Hence `noPoleOnCircle` is a proper subring of `ℂ(X)`. -/
theorem inv_X_sub_one_not_mem :
    (algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1))⁻¹ ∉ noPoleOnCircle := by
  intro h
  obtain ⟨p, q, hq, hpq⟩ := h
  have hX : algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1) ≠ 0 := by
    intro h0
    have h1 : (X - 1 : ℂ[X]) = 0 :=
      IsFractionRing.injective ℂ[X] (FractionRing ℂ[X]) (by rw [h0, map_zero])
    exact X_sub_one_ne_zero h1
  have hcancel : algebraMap ℂ[X] (FractionRing ℂ[X]) q =
      algebraMap ℂ[X] (FractionRing ℂ[X]) (p * (X - 1)) := by
    have h'' : algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1) *
        ((algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1))⁻¹ *
          algebraMap ℂ[X] (FractionRing ℂ[X]) q) =
        algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1) *
          algebraMap ℂ[X] (FractionRing ℂ[X]) p := by
      rw [hpq]
    rw [← mul_assoc, mul_inv_cancel₀ hX, one_mul] at h''
    rw [h'', map_mul]
    exact mul_comm _ _
  have hqp : q = p * (X - 1) :=
    IsFractionRing.injective ℂ[X] (FractionRing ℂ[X]) hcancel
  have h1 := hq 1 (by norm_num)
  rw [hqp] at h1
  simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
    Polynomial.eval_one] at h1
  norm_num at h1

/-- `noPoleOnCircle` is a proper subring of `ℂ(X)`: it is not the whole field. -/
theorem noPoleOnCircle_ne_top : (noPoleOnCircle : Subring (FractionRing ℂ[X])) ≠ ⊤ := by
  intro h
  have hmem : (algebraMap ℂ[X] (FractionRing ℂ[X]) (X - 1))⁻¹ ∈ noPoleOnCircle := by
    rw [h]
    exact Subring.mem_top _
  exact inv_X_sub_one_not_mem hmem

/-! ## Part (iv): polynomials whose first `k` derivatives vanish at the origin -/

section PartIV

/-- The `j`-th derivative of `p`, evaluated at the origin, is `j!` times the `j`-th
coefficient of `p`. -/
lemma eval_iterate_derivative_zero (p : ℂ[X]) (j : ℕ) :
    (derivative^[j] p).eval 0 = (j.factorial : ℂ) * p.coeff j := by
  rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_iterate_derivative]
  simp [Nat.descFactorial_self]

/-- For a complex polynomial, the vanishing of the first `k` derivatives at the origin
is equivalent to the vanishing of the coefficients of `X, …, X^k`. -/
lemma coeff_eq_zero_iff_deriv (k : ℕ) (p : ℂ[X]) :
    (∀ j ∈ Finset.Icc 1 k, (derivative^[j] p).eval 0 = 0) ↔
      ∀ j ∈ Finset.Icc 1 k, p.coeff j = 0 := by
  refine forall₂_congr fun j _ => ?_
  rw [eval_iterate_derivative_zero]
  constructor
  · intro h
    refine (mul_eq_zero.mp h).resolve_left ?_
    exact_mod_cast Nat.factorial_ne_zero j
  · intro h
    rw [h, mul_zero]

/-- **(iv)** The ring of complex polynomials whose first `k` derivatives vanish at the
origin. -/
def vanishingDerivatives (k : ℕ) : Subalgebra ℂ ℂ[X] where
  carrier := {p | ∀ j ∈ Finset.Icc 1 k, (derivative^[j] p).eval 0 = 0}
  zero_mem' := (coeff_eq_zero_iff_deriv k 0).mpr (by intro j _; simp)
  one_mem' := (coeff_eq_zero_iff_deriv k 1).mpr (by
    intro j hj
    rw [Finset.mem_Icc] at hj
    rw [Polynomial.coeff_one]
    simp [show j ≠ 0 by omega])
  add_mem' := by
    intro p q hp hq
    refine (coeff_eq_zero_iff_deriv k (p + q)).mpr ?_
    have hp' := (coeff_eq_zero_iff_deriv k p).mp hp
    have hq' := (coeff_eq_zero_iff_deriv k q).mp hq
    intro j hj
    simp [hp' j hj, hq' j hj]
  algebraMap_mem' := by
    intro r
    refine (coeff_eq_zero_iff_deriv k (algebraMap ℂ ℂ[X] r)).mpr ?_
    intro j hj
    rw [Finset.mem_Icc] at hj
    rw [Polynomial.algebraMap_eq, Polynomial.coeff_C]
    simp [show j ≠ 0 by omega]
  mul_mem' := by
    intro p q hp hq
    refine (coeff_eq_zero_iff_deriv k (p * q)).mpr ?_
    have hp' := (coeff_eq_zero_iff_deriv k p).mp hp
    have hq' := (coeff_eq_zero_iff_deriv k q).mp hq
    intro j hj
    rw [Finset.mem_Icc] at hj
    rw [Polynomial.coeff_mul]
    refine Finset.sum_eq_zero fun a ha => ?_
    have ha' : a.1 + a.2 = j := by simpa using ha
    rcases Nat.eq_zero_or_pos a.1 with h | h
    · have h2 : a.2 = j := by omega
      rw [h, h2, hq' j (Finset.mem_Icc.mpr ⟨hj.1, hj.2⟩), mul_zero]
    · have h1 : a.1 ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨h, by omega⟩
      rw [hp' a.1 h1, zero_mul]

/-- The polynomial `X^(k+1+i)` belongs to the ring of part (iv): all its coefficients
in degrees `1, …, k` vanish. -/
lemma X_pow_mem_vanishingDerivatives (k : ℕ) (i : Fin (k + 1)) :
    (X : ℂ[X]) ^ (k + 1 + (i : ℕ)) ∈ vanishingDerivatives k := by
  refine (coeff_eq_zero_iff_deriv k _).mpr fun j hj => ?_
  rw [Finset.mem_Icc] at hj
  rw [Polynomial.coeff_X_pow]
  exact if_neg (by omega)

/-- The evaluation homomorphism `ℂ[X_0,…,X_k] → ℂ[X]` sending `X_i` to `X^(k+1+i)`. -/
noncomputable def gensAeval (k : ℕ) : MvPolynomial (Fin (k + 1)) ℂ →ₐ[ℂ] ℂ[X] :=
  MvPolynomial.aeval fun i => (X : ℂ[X]) ^ (k + 1 + (i : ℕ))

lemma gensAeval_range_le (k : ℕ) : (gensAeval k).range ≤ vanishingDerivatives k := by
  rw [gensAeval, ← Algebra.adjoin_range_eq_range_aeval]
  refine Algebra.adjoin_le fun x ⟨i, hi⟩ => ?_
  rw [← hi]
  exact X_pow_mem_vanishingDerivatives k i

/-- Every power `X^m` with `m ≥ k+1` is a polynomial in the generators
`X^(k+1), …, X^(2k+1)`. -/
lemma exists_gensAeval_X_pow (k : ℕ) :
    ∀ m : ℕ, k + 1 ≤ m → ∃ y : MvPolynomial (Fin (k + 1)) ℂ,
      gensAeval k y = (X : ℂ[X]) ^ m := by
  intro m
  induction m using Nat.strong_induction_on with
  | h m ih =>
    intro hm
    by_cases h2 : m ≤ 2 * k + 1
    · refine ⟨MvPolynomial.X ⟨m - (k + 1), by omega⟩, ?_⟩
      rw [gensAeval, MvPolynomial.aeval_X]
      congr 1
      have hc : ((⟨m - (k + 1), by omega⟩ : Fin (k + 1)) : ℕ) = m - (k + 1) := rfl
      rw [hc]
      omega
    · rw [not_le] at h2
      obtain ⟨y, hy⟩ := ih (m - (k + 1)) (by omega) (by omega)
      refine ⟨MvPolynomial.X ⟨0, Nat.succ_pos k⟩ * y, ?_⟩
      rw [map_mul, hy, gensAeval, MvPolynomial.aeval_X]
      have h0 : (k + 1 + ((⟨0, Nat.succ_pos k⟩ : Fin (k + 1)) : ℕ)) = k + 1 := by simp
      rw [h0, ← pow_add]
      congr 1
      omega

/-- Every element of the ring of part (iv) is a polynomial in `X^(k+1), …, X^(2k+1)`. -/
lemma exists_gensAeval_of_mem (k : ℕ) {p : ℂ[X]} (hp : p ∈ vanishingDerivatives k) :
    ∃ y : MvPolynomial (Fin (k + 1)) ℂ, gensAeval k y = p := by
  have hcoeff : ∀ j ∈ Finset.Icc 1 k, p.coeff j = 0 := (coeff_eq_zero_iff_deriv k p).mp hp
  have hdvd : (X : ℂ[X]) ^ (k + 1) ∣ p - C (p.coeff 0) := by
    rw [Polynomial.X_pow_dvd_iff]
    intro d hd
    rw [Polynomial.coeff_sub, Polynomial.coeff_C]
    rcases Nat.eq_zero_or_pos d with h | h
    · simp [h]
    · have hdz : p.coeff d = 0 := hcoeff d (Finset.mem_Icc.mpr ⟨h, by omega⟩)
      have hne : d ≠ 0 := by omega
      simp [hdz, hne]
  obtain ⟨q, hq⟩ : ∃ q, p = C (p.coeff 0) + (X : ℂ[X]) ^ (k + 1) * q := by
    obtain ⟨q, hq⟩ := hdvd
    exact ⟨q, by rw [← hq]; ring⟩
  have hex : ∀ i : ℕ, ∃ y : MvPolynomial (Fin (k + 1)) ℂ,
      gensAeval k y = (X : ℂ[X]) ^ (k + 1 + i) := fun i =>
    exists_gensAeval_X_pow k (k + 1 + i) (by omega)
  choose Y hYm using hex
  refine ⟨MvPolynomial.C (p.coeff 0) + ∑ i ∈ q.support, MvPolynomial.C (q.coeff i) * Y i, ?_⟩
  have hC : ∀ a : ℂ, gensAeval k (MvPolynomial.C a) = C a := by
    intro a
    rw [gensAeval, MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
  have hsum : (∑ i ∈ q.support, gensAeval k (MvPolynomial.C (q.coeff i) * Y i))
      = (X : ℂ[X]) ^ (k + 1) * q := by
    have hterm : ∀ i ∈ q.support, gensAeval k (MvPolynomial.C (q.coeff i) * Y i)
        = C (q.coeff i) * X ^ i * X ^ (k + 1) := by
      intro i _
      rw [map_mul, hYm i, hC, show k + 1 + i = i + (k + 1) by omega, pow_add]
      ring
    rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul,
      ← Polynomial.as_sum_support_C_mul_X_pow q, mul_comm]
  rw [map_add, map_sum, hC, hsum]
  exact hq.symm

/-- The ring of part (iv) is a finitely generated `ℂ`-algebra. -/
theorem finiteType_vanishingDerivatives (k : ℕ) :
    Algebra.FiniteType ℂ ↥(vanishingDerivatives k) :=
  Algebra.FiniteType.of_surjective
    ((gensAeval k).codRestrict (vanishingDerivatives k)
      (fun y => gensAeval_range_le k (Set.mem_range_self y)))
    (by
      rintro ⟨p, hp⟩
      obtain ⟨y, hy⟩ := exists_gensAeval_of_mem k hp
      exact ⟨y, Subtype.ext hy⟩)

/-- **(iv)** The ring of complex polynomials whose first `k` derivatives vanish at the
origin is Noetherian. -/
theorem isNoetherian_vanishingDerivatives (k : ℕ) :
    IsNoetherianRing ↥(vanishingDerivatives k) :=
  haveI := finiteType_vanishingDerivatives k
  Algebra.FiniteType.isNoetherianRing ℂ ↥(vanishingDerivatives k)

end PartIV

/-! ## Part (v): polynomials in `z, w` whose `w`-partial derivatives vanish at `z = 0` -/

section PartV

/-- `ℂ[z,w]` modelled as `(ℂ[w])[z]`: the outer variable is `z`, the inner one `w`. -/
abbrev Poly2 : Type := (Polynomial ℂ)[X]

/-- The condition defining the ring of part (v): every partial derivative of `p` with
respect to `w`, evaluated at `z = 0`, vanishes.  In the model `(ℂ[w])[z]` the
specialisation `z = 0` of `∂^j p/∂w^j` is the `j`-th `w`-derivative of the `z^0`
coefficient of `p`, so the condition reads as follows. -/
def wDerivVanishAtZero (p : Poly2) : Prop :=
  ∀ j : ℕ, 1 ≤ j → Polynomial.derivative^[j] (p.coeff 0) = 0

lemma iterate_derivative_C (c : ℂ) :
    ∀ j : ℕ, 1 ≤ j → Polynomial.derivative^[j] (Polynomial.C c) = 0 := by
  intro j hj
  induction j with
  | zero => omega
  | succ n ih =>
    rw [Function.iterate_succ_apply']
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · rw [ih hn]; simp

/-- In characteristic zero a polynomial in `w` has all derivatives vanishing iff it is a
constant, so the condition of part (v) says that the `z^0`-coefficient of `p` is a
constant polynomial in `w`. -/
lemma wDerivVanishAtZero_iff (p : Poly2) :
    wDerivVanishAtZero p ↔ ∃ c : ℂ, p.coeff 0 = Polynomial.C c := by
  constructor
  · intro h
    have h1 : Polynomial.derivative (p.coeff 0) = 0 := by simpa using h 1 le_rfl
    refine ⟨(p.coeff 0).coeff 0, Polynomial.ext fun n => ?_⟩
    match n with
    | 0 => simp
    | m + 1 =>
      have hc : (Polynomial.derivative (p.coeff 0)).coeff m = 0 := by
        rw [h1, Polynomial.coeff_zero]
      rw [Polynomial.coeff_derivative] at hc
      have hm : ((m : ℂ) + 1) ≠ 0 := by
        have hpos : ((m + 1 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
        simpa using hpos
      have := (mul_eq_zero.mp hc).resolve_right hm
      rw [this, Polynomial.coeff_C]
      simp
  · rintro ⟨c, hc⟩ j hj
    rw [hc]
    exact iterate_derivative_C c j hj

/-- **(v)** The ring of complex polynomials in `z, w` all of whose partial derivatives
with respect to `w` vanish for `z = 0`. -/
def partialWSub : Subalgebra ℂ Poly2 where
  carrier := {p | wDerivVanishAtZero p}
  zero_mem' := (wDerivVanishAtZero_iff 0).mpr ⟨0, by simp⟩
  one_mem' := (wDerivVanishAtZero_iff 1).mpr ⟨1, by simp⟩
  add_mem' := by
    intro p q hp hq
    obtain ⟨c, hc⟩ := (wDerivVanishAtZero_iff p).mp hp
    obtain ⟨d, hd⟩ := (wDerivVanishAtZero_iff q).mp hq
    exact (wDerivVanishAtZero_iff (p + q)).mpr ⟨c + d, by rw [Polynomial.coeff_add, hc, hd, map_add]⟩
  mul_mem' := by
    intro p q hp hq
    obtain ⟨c, hc⟩ := (wDerivVanishAtZero_iff p).mp hp
    obtain ⟨d, hd⟩ := (wDerivVanishAtZero_iff q).mp hq
    exact (wDerivVanishAtZero_iff (p * q)).mpr ⟨c * d, by
      rw [Polynomial.mul_coeff_zero, hc, hd, map_mul]⟩
  algebraMap_mem' := by
    intro r
    exact (wDerivVanishAtZero_iff _).mpr ⟨r, by simp [Polynomial.algebraMap_eq]⟩

lemma mem_partialWSub_iff (p : Poly2) :
    p ∈ partialWSub ↔ ∃ c : ℂ, p.coeff 0 = Polynomial.C c :=
  wDerivVanishAtZero_iff p

/-- The polynomial `z * w^j`, as an element of the ring of part (v). -/
noncomputable def zw (j : ℕ) : ↥partialWSub :=
  ⟨(X : Poly2) * Polynomial.C ((Polynomial.X : Polynomial ℂ) ^ j), by
    refine (mem_partialWSub_iff _).mpr ⟨0, ?_⟩
    rw [Polynomial.mul_coeff_zero]
    simp⟩

lemma coeff_one_mul (p q : Poly2) :
    (p * q).coeff 1 = p.coeff 0 * q.coeff 1 + p.coeff 1 * q.coeff 0 := by
  rw [Polynomial.coeff_mul,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => p.coeff i * q.coeff j)]
  simp [Finset.sum_range_succ]

lemma zw_coeff_zero (j : ℕ) : ((zw j : ↥partialWSub) : Poly2).coeff 0 = 0 := by
  rw [zw, Polynomial.mul_coeff_zero]
  simp

lemma zw_coeff_one (j : ℕ) :
    ((zw j : ↥partialWSub) : Poly2).coeff 1 = (Polynomial.X : Polynomial ℂ) ^ j := by
  rw [zw, Polynomial.coeff_X_mul, Polynomial.coeff_C]
  simp

/-- The ideals `(z, zw, …, zw^n)` of the ring of part (v). -/
noncomputable def chainV (n : ℕ) : Ideal ↥partialWSub :=
  Ideal.span (Set.range fun j : Fin (n + 1) => zw (j : ℕ))

/-- The `z^1`-coefficient of an element of `(z, zw, …, zw^n)` is a polynomial in `w` of
degree at most `n`, and its `z^0`-coefficient vanishes. -/
lemma chainV_coeff (n : ℕ) {x : ↥partialWSub} (hx : x ∈ chainV n) :
    ((x : ↥partialWSub) : Poly2).coeff 0 = 0 ∧
      Polynomial.natDegree (((x : ↥partialWSub) : Poly2).coeff 1) ≤ n := by
  refine Submodule.span_induction ?mem ?zero ?add ?smul hx
  · rintro _ ⟨j, rfl⟩
    refine ⟨zw_coeff_zero j, ?_⟩
    rw [zw_coeff_one, Polynomial.natDegree_X_pow]
    omega
  · refine ⟨?_, ?_⟩
    · simp
    · rw [Subalgebra.coe_zero, Polynomial.coeff_zero]
      simp
  · intro x y hx hy hpx hpy
    refine ⟨?_, ?_⟩
    · rw [Subalgebra.coe_add, Polynomial.coeff_add, hpx.1, hpy.1, add_zero]
    · rw [Subalgebra.coe_add, Polynomial.coeff_add]
      exact (Polynomial.natDegree_add_le _ _).trans (max_le hpx.2 hpy.2)
  · intro a x hx hpx
    obtain ⟨c, hc⟩ := (mem_partialWSub_iff (a : Poly2)).mp a.2
    have hmul : ((a • x : ↥partialWSub) : Poly2) = (a : Poly2) * (x : Poly2) := rfl
    refine ⟨?_, ?_⟩
    · rw [hmul, Polynomial.mul_coeff_zero, hc, hpx.1, mul_zero]
    · rw [hmul, coeff_one_mul, hc, hpx.1, mul_zero, add_zero]
      exact (Polynomial.natDegree_C_mul_le c _).trans hpx.2

lemma chainV_mono : Monotone chainV := by
  intro n m hnm
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨j, rfl⟩
  exact Submodule.subset_span ⟨⟨(j : ℕ), by omega⟩, by simp⟩

/-- The element `z * w^(n+1)` does not lie in `(z, zw, …, zw^n)`. -/
lemma zw_not_mem (n : ℕ) : zw (n + 1) ∉ chainV n := by
  intro h
  obtain ⟨h0, h1⟩ := chainV_coeff n h
  rw [zw_coeff_one n.succ, Polynomial.natDegree_X_pow] at h1
  omega

lemma chainV_lt (n : ℕ) : chainV n < chainV (n + 1) := by
  refine lt_of_le_of_ne (chainV_mono (Nat.le_succ n)) ?_
  intro h
  refine zw_not_mem n ?_
  rw [h]
  exact Submodule.subset_span ⟨⟨n + 1, by omega⟩, rfl⟩

lemma chainV_strictMono : StrictMono chainV :=
  strictMono_nat_of_lt_succ chainV_lt

/-- A strictly increasing sequence of ideals contradicts the ascending chain condition. -/
lemma false_of_strictMono_ideal {R : Type*} [CommRing R] [IsNoetherianRing R]
    (f : ℕ → Ideal R) (hf : StrictMono f) : False := by
  obtain ⟨x, hx, hmax⟩ :=
    exists_maximal_of_wellFoundedGT (fun x => x ∈ Set.range f) ⟨f 0, Set.mem_range_self 0⟩
  obtain ⟨N, rfl⟩ := hx
  have hlt : f N < f (N + 1) := hf (Nat.lt_succ_self N)
  have hle : f (N + 1) ≤ f N := hmax (Set.mem_range_self (N + 1)) (le_of_lt hlt)
  exact (lt_irrefl (f N)) (lt_of_lt_of_le hlt hle)

/-- **(v)** The ring of complex polynomials in `z, w` all of whose partial derivatives
with respect to `w` vanish for `z = 0` is **not** Noetherian: the ideals
`(z, zw, …, zw^n)` form a strictly increasing sequence. -/
theorem not_isNoetherian_partialWSub : ¬ IsNoetherianRing ↥partialWSub :=
  fun h => @false_of_strictMono_ideal ↥partialWSub _ h chainV chainV_strictMono

end PartV

end PolynomialParts

/-! ## Parts (ii) and (iii): power series with positive / infinite radius of convergence

The definitions, closure proofs, the identification with honest disc convergence, and
the Noetherianity results below are all stated on the ring `PowerSeries ℂ` itself. -/

open PowerSeries
open Finset
open Filter
open scoped Topology

/-- `Growth a`: the coefficients of `a` are dominated by a geometric sequence. -/
def Growth (a : ℂ⟦X⟧) : Prop :=
  ∃ C M : ℝ, 0 ≤ C ∧ 0 < M ∧ ∀ n : ℕ, ‖coeff n a‖ ≤ C * M ^ n

/-- `GrowthAll a`: the coefficients of `a` are dominated by every geometric sequence,
i.e. `a` has infinite radius of convergence. -/
def GrowthAll (a : ℂ⟦X⟧) : Prop :=
  ∀ M : ℝ, 0 < M → ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, ‖coeff n a‖ ≤ C * M ^ n

theorem growth_zero : Growth (0 : ℂ⟦X⟧) := by
  refine ⟨0, 1, le_rfl, one_pos, fun n => ?_⟩
  simp

theorem growth_one : Growth (1 : ℂ⟦X⟧) := by
  refine ⟨1, 2, zero_le_one, by norm_num, fun n => ?_⟩
  rw [coeff_one]
  split_ifs with h
  · subst h; norm_num
  · simp

theorem Growth.C (c : ℂ) : Growth (C c) := by
  refine ⟨‖c‖, 1, norm_nonneg c, one_pos, fun n => ?_⟩
  rw [coeff_C]
  split_ifs with h
  · simp
  · simp

theorem Growth.neg {a : ℂ⟦X⟧} (ha : Growth a) : Growth (-a) := by
  obtain ⟨C, M, hC, hM, hb⟩ := ha
  exact ⟨C, M, hC, hM, fun n => by rw [map_neg, norm_neg]; exact hb n⟩

theorem Growth.add {a b : ℂ⟦X⟧} (ha : Growth a) (hb : Growth b) : Growth (a + b) := by
  obtain ⟨C, M, hC, hM, hb1⟩ := ha
  obtain ⟨D, N, hD, hN, hb2⟩ := hb
  refine ⟨C + D, max M N + 1, by positivity, by positivity, fun n => ?_⟩
  have hMle : M ^ n ≤ (max M N + 1) ^ n := pow_le_pow_left₀ hM.le (by linarith [le_max_left M N]) n
  have hNle : N ^ n ≤ (max M N + 1) ^ n := pow_le_pow_left₀ hN.le (by linarith [le_max_right M N]) n
  rw [map_add]
  have h1 := hb1 n
  have h2 := hb2 n
  have h3 : C * M ^ n ≤ C * (max M N + 1) ^ n := mul_le_mul_of_nonneg_left hMle hC
  have h4 : D * N ^ n ≤ D * (max M N + 1) ^ n := mul_le_mul_of_nonneg_left hNle hD
  calc ‖coeff n a + coeff n b‖ ≤ ‖coeff n a‖ + ‖coeff n b‖ := norm_add_le _ _
    _ ≤ (C + D) * (max M N + 1) ^ n := by
        rw [add_mul]; linarith

theorem Growth.mul {a b : ℂ⟦X⟧} (ha : Growth a) (hb : Growth b) : Growth (a * b) := by
  obtain ⟨C, M, hC, hM, hb1⟩ := ha
  obtain ⟨D, N, hD, hN, hb2⟩ := hb
  set K : ℝ := max M N + 1 with hKdef
  have hKpos : 0 < K := by positivity
  have hMK : M ≤ K := by rw [hKdef]; linarith [le_max_left M N]
  have hNK : N ≤ K := by rw [hKdef]; linarith [le_max_right M N]
  refine ⟨C * D, 2 * K, by positivity, by positivity, fun n => ?_⟩
  have hstep : ∀ p ∈ HasAntidiagonal.antidiagonal n,
      ‖coeff p.1 a * coeff p.2 b‖ ≤ (C * K ^ p.1) * (D * K ^ p.2) := by
    intro p _
    rw [norm_mul]
    have h1 : ‖coeff p.1 a‖ ≤ C * K ^ p.1 :=
      (hb1 p.1).trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hM.le hMK p.1) hC)
    have h2 : ‖coeff p.2 b‖ ≤ D * K ^ p.2 :=
      (hb2 p.2).trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hN.le hNK p.2) hD)
    exact mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
  have hsum : ∑ p ∈ HasAntidiagonal.antidiagonal n, (C * K ^ p.1) * (D * K ^ p.2)
      = ((n : ℝ) + 1) * (C * D) * K ^ n := by
    rw [Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => (C * K ^ i) * (D * K ^ j))]
    have hterm : ∀ i ∈ Finset.range (n + 1), (C * K ^ i) * (D * K ^ (n - i))
        = C * D * K ^ n := by
      intro i hi
      rw [Finset.mem_range] at hi
      have hsub : i + (n - i) = n := Nat.add_sub_cancel' (by omega)
      calc C * K ^ i * (D * K ^ (n - i)) = C * D * (K ^ i * K ^ (n - i)) := by ring
        _ = C * D * K ^ (i + (n - i)) := by rw [pow_add]
        _ = C * D * K ^ n := by rw [hsub]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range]
    ring
  have hKn : (0:ℝ) ≤ K ^ n := by positivity
  have hnpow : ((n : ℝ) + 1) ≤ 2 ^ n := by
    have h : n + 1 ≤ 2 ^ n := Nat.lt_two_pow_self (n := n)
    exact_mod_cast h
  rw [coeff_mul]
  calc ‖∑ p ∈ HasAntidiagonal.antidiagonal n, coeff p.1 a * coeff p.2 b‖
      ≤ ∑ p ∈ HasAntidiagonal.antidiagonal n, ‖coeff p.1 a * coeff p.2 b‖ := norm_sum_le _ _
    _ ≤ ∑ p ∈ HasAntidiagonal.antidiagonal n, (C * K ^ p.1) * (D * K ^ p.2) := Finset.sum_le_sum hstep
    _ = ((n : ℝ) + 1) * (C * D) * K ^ n := hsum
    _ = (C * D) * (((n : ℝ) + 1) * K ^ n) := by ring
    _ ≤ (C * D) * (2 ^ n * K ^ n) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact mul_le_mul_of_nonneg_right hnpow hKn
    _ = (C * D) * (2 * K) ^ n := by rw [mul_pow]

theorem growthAll_zero : GrowthAll (0 : ℂ⟦X⟧) := by
  intro M hM
  exact ⟨0, le_rfl, by simp⟩

theorem growthAll_one : GrowthAll (1 : ℂ⟦X⟧) := by
  intro M hM
  refine ⟨1, zero_le_one, fun n => ?_⟩
  rw [coeff_one]
  split_ifs with h0
  · subst h0; simp
  · simp only [norm_zero]
    positivity

theorem GrowthAll.neg {a : ℂ⟦X⟧} (ha : GrowthAll a) : GrowthAll (-a) := by
  intro M hM
  obtain ⟨C, hC, hb⟩ := ha M hM
  exact ⟨C, hC, fun n => by rw [map_neg, norm_neg]; exact hb n⟩

theorem GrowthAll.add {a b : ℂ⟦X⟧} (ha : GrowthAll a) (hb : GrowthAll b) :
    GrowthAll (a + b) := by
  intro M hM
  obtain ⟨C, hC, hb1⟩ := ha M hM
  obtain ⟨D, hD, hb2⟩ := hb M hM
  refine ⟨C + D, by positivity, fun n => ?_⟩
  rw [map_add]
  have h1 := hb1 n
  have h2 := hb2 n
  calc ‖coeff n a + coeff n b‖ ≤ ‖coeff n a‖ + ‖coeff n b‖ := norm_add_le _ _
    _ ≤ (C + D) * M ^ n := by rw [add_mul]; linarith

theorem GrowthAll.mul {a b : ℂ⟦X⟧} (ha : GrowthAll a) (hb : GrowthAll b) :
    GrowthAll (a * b) := by
  intro M hM
  have hhalf : (0 : ℝ) < M / 2 := by positivity
  obtain ⟨C, hC, hb1⟩ := ha (M / 2) hhalf
  obtain ⟨D, hD, hb2⟩ := hb (M / 2) hhalf
  refine ⟨C * D, by positivity, fun n => ?_⟩
  have hstep : ∀ p ∈ HasAntidiagonal.antidiagonal n,
      ‖coeff p.1 a * coeff p.2 b‖ ≤ (C * (M / 2) ^ p.1) * (D * (M / 2) ^ p.2) := by
    intro p _
    rw [norm_mul]
    exact mul_le_mul (hb1 p.1) (hb2 p.2) (norm_nonneg _) (by positivity)
  have hsum : ∑ p ∈ HasAntidiagonal.antidiagonal n, (C * (M / 2) ^ p.1) * (D * (M / 2) ^ p.2)
      = ((n : ℝ) + 1) * (C * D) * (M / 2) ^ n := by
    rw [Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => (C * (M / 2) ^ i) * (D * (M / 2) ^ j))]
    have hterm : ∀ i ∈ Finset.range (n + 1),
        (C * (M / 2) ^ i) * (D * (M / 2) ^ (n - i)) = C * D * (M / 2) ^ n := by
      intro i hi
      rw [Finset.mem_range] at hi
      have hsub : i + (n - i) = n := Nat.add_sub_cancel' (by omega)
      calc C * (M / 2) ^ i * (D * (M / 2) ^ (n - i))
          = C * D * ((M / 2) ^ i * (M / 2) ^ (n - i)) := by ring
        _ = C * D * (M / 2) ^ (i + (n - i)) := by rw [pow_add]
        _ = C * D * (M / 2) ^ n := by rw [hsub]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range]
    ring
  have hhalfn : (0:ℝ) ≤ (M / 2) ^ n := by positivity
  have hnpow : ((n : ℝ) + 1) ≤ 2 ^ n := by
    have h : n + 1 ≤ 2 ^ n := Nat.lt_two_pow_self (n := n)
    exact_mod_cast h
  rw [coeff_mul]
  calc ‖∑ p ∈ HasAntidiagonal.antidiagonal n, coeff p.1 a * coeff p.2 b‖
      ≤ ∑ p ∈ HasAntidiagonal.antidiagonal n, ‖coeff p.1 a * coeff p.2 b‖ := norm_sum_le _ _
    _ ≤ ∑ p ∈ HasAntidiagonal.antidiagonal n, (C * (M / 2) ^ p.1) * (D * (M / 2) ^ p.2) :=
        Finset.sum_le_sum hstep
    _ = ((n : ℝ) + 1) * (C * D) * (M / 2) ^ n := hsum
    _ = (C * D) * (((n : ℝ) + 1) * (M / 2) ^ n) := by ring
    _ ≤ (C * D) * (2 ^ n * (M / 2) ^ n) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact mul_le_mul_of_nonneg_right hnpow hhalfn
    _ = (C * D) * M ^ n := by
        have h2 : (2:ℝ) ^ n * (M / 2) ^ n = M ^ n := by
          rw [← mul_pow, show (2:ℝ) * (M / 2) = M by ring]
        rw [h2]

/-- The subring of `ℂ⟦X⟧` of power series with a positive radius of convergence. -/
def convSubring : Subring ℂ⟦X⟧ where
  carrier := {a | Growth a}
  zero_mem' := growth_zero
  one_mem' := growth_one
  add_mem' := Growth.add
  mul_mem' := Growth.mul
  neg_mem' := Growth.neg

/-- The subring of `ℂ⟦X⟧` of power series with infinite radius of convergence. -/
def entireSubring : Subring ℂ⟦X⟧ where
  carrier := {a | GrowthAll a}
  zero_mem' := growthAll_zero
  one_mem' := growthAll_one
  add_mem' := GrowthAll.add
  mul_mem' := GrowthAll.mul
  neg_mem' := GrowthAll.neg

theorem entire_le_conv : entireSubring ≤ convSubring := by
  rintro a ha
  obtain ⟨C, hC, hb⟩ := ha 1 one_pos
  exact ⟨C, 1, hC, one_pos, hb⟩

/-! ### Shifting coefficients (division by a power of `X`) -/

/-- The series `∑ a_{n+d} X^n`. -/
def shiftPS (d : ℕ) (a : ℂ⟦X⟧) : ℂ⟦X⟧ := mk fun n => coeff (n + d) a

theorem coeff_shiftPS (d : ℕ) (a : ℂ⟦X⟧) (n : ℕ) : coeff n (shiftPS d a) = coeff (n + d) a := by
  simp [shiftPS]

theorem X_pow_mul_shiftPS_add_trunc (d : ℕ) (a : ℂ⟦X⟧) :
    X ^ d * shiftPS d a + (a.trunc d : ℂ⟦X⟧) = a := by
  simp only [shiftPS]
  exact (eq_X_pow_mul_shift_add_trunc d a).symm

theorem X_pow_mul_shiftPS (d : ℕ) (a : ℂ⟦X⟧) :
    X ^ d * shiftPS d a = a - (a.trunc d : ℂ⟦X⟧) :=
  eq_sub_iff_add_eq.mpr (X_pow_mul_shiftPS_add_trunc d a)

theorem trunc_eq_zero_of_coeff_eq_zero {d : ℕ} {a : ℂ⟦X⟧} (h : ∀ i < d, coeff i a = 0) :
    a.trunc d = 0 := by
  ext i
  rw [coeff_trunc, Polynomial.coeff_zero]
  split_ifs with hi
  · exact h i hi
  · rfl

theorem X_pow_mul_shiftPS_of_coeff_eq_zero {d : ℕ} {a : ℂ⟦X⟧}
    (h : ∀ i < d, coeff i a = 0) : X ^ d * shiftPS d a = a := by
  rw [X_pow_mul_shiftPS, trunc_eq_zero_of_coeff_eq_zero h]
  simp

theorem Growth.shiftPS {a : ℂ⟦X⟧} (ha : Growth a) (d : ℕ) : Growth (shiftPS d a) := by
  obtain ⟨C, M, hC, hM, hb⟩ := ha
  refine ⟨C * M ^ d, M, by positivity, hM, fun n => ?_⟩
  rw [coeff_shiftPS]
  calc ‖coeff (n + d) a‖ ≤ C * M ^ (n + d) := hb _
    _ = (C * M ^ d) * M ^ n := by rw [pow_add]; ring

theorem GrowthAll.shiftPS {a : ℂ⟦X⟧} (ha : GrowthAll a) (d : ℕ) : GrowthAll (shiftPS d a) := by
  intro M hM
  obtain ⟨C, hC, hb⟩ := ha M hM
  refine ⟨C * M ^ d, by positivity, fun n => ?_⟩
  rw [coeff_shiftPS]
  calc ‖coeff (n + d) a‖ ≤ C * M ^ (n + d) := hb _
    _ = (C * M ^ d) * M ^ n := by rw [pow_add]; ring

/-! ### Positive and infinite radius of convergence as honest convergence properties -/

/-- `a` converges on some disc of positive radius around `0`. -/
def PosRadius (a : ℂ⟦X⟧) : Prop :=
  ∃ ρ : ℝ, 0 < ρ ∧ ∀ z : ℂ, ‖z‖ < ρ → Summable fun n => coeff n a * z ^ n

/-- `a` converges everywhere on `ℂ`. -/
def InfRadius (a : ℂ⟦X⟧) : Prop := ∀ z : ℂ, Summable fun n => coeff n a * z ^ n

/-- The terms of a summable sequence of complex numbers are bounded. -/
theorem exists_norm_le_of_summable {f : ℕ → ℂ} (h : Summable f) : ∃ K : ℝ, ∀ n, ‖f n‖ ≤ K := by
  have ht : Tendsto f atTop (𝓝 0) := h.tendsto_atTop_zero
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 ht 1 one_pos
  refine ⟨max 1 (∑ n ∈ Finset.range N, ‖f n‖), fun n => ?_⟩
  rcases Nat.lt_or_ge n N with hn | hn
  · have h2 : ‖f n‖ ≤ ∑ m ∈ Finset.range N, ‖f m‖ :=
      Finset.single_le_sum (f := fun m => ‖f m‖) (fun i _ => norm_nonneg _)
        (Finset.mem_range.mpr hn)
    exact le_trans h2 (le_max_right _ _)
  · have h2 := hN n hn
    rw [dist_zero_right] at h2
    exact le_trans h2.le (le_max_left _ _)

theorem Growth.posRadius {a : ℂ⟦X⟧} (h : Growth a) : PosRadius a := by
  obtain ⟨C, M, hC, hM, hb⟩ := h
  refine ⟨1 / (2 * M), by positivity, fun z hz => ?_⟩
  have hMz : M * ‖z‖ ≤ 1 / 2 := by
    have h2 : ‖z‖ < 1 / (2 * M) := hz
    have h3 : M * ‖z‖ < M * (1 / (2 * M)) := by
      exact mul_lt_mul_of_pos_left h2 hM
    have h4 : M * (1 / (2 * M)) = 1 / 2 := by field_simp
    linarith
  have hbound : ∀ n : ℕ, ‖coeff n a * z ^ n‖ ≤ C * (1 / 2) ^ n := by
    intro n
    rw [norm_mul, norm_pow]
    have h1 : ‖coeff n a‖ * ‖z‖ ^ n ≤ (C * M ^ n) * ‖z‖ ^ n :=
      mul_le_mul_of_nonneg_right (hb n) (by positivity)
    have h2 : (C * M ^ n) * ‖z‖ ^ n = C * (M * ‖z‖) ^ n := by rw [mul_pow]; ring
    calc ‖coeff n a‖ * ‖z‖ ^ n ≤ (C * M ^ n) * ‖z‖ ^ n := h1
      _ = C * (M * ‖z‖) ^ n := h2
      _ ≤ C * (1 / 2) ^ n :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hMz n) hC
  exact (Summable.mul_left C
    (summable_geometric_of_lt_one (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num))).of_norm_bounded hbound

theorem PosRadius.growth {a : ℂ⟦X⟧} (h : PosRadius a) : Growth a := by
  obtain ⟨ρ, hρ, hconv⟩ := h
  have hz : ‖((ρ / 2 : ℝ) : ℂ)‖ = ρ / 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]
  have hlt : ‖((ρ / 2 : ℝ) : ℂ)‖ < ρ := by rw [hz]; linarith
  obtain ⟨K, hK⟩ := exists_norm_le_of_summable (hconv _ hlt)
  have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0)
  refine ⟨K, 2 / ρ, hK0, by positivity, fun n => ?_⟩
  have h1 : ‖coeff n a‖ * (ρ / 2) ^ n = ‖coeff n a * ((ρ / 2 : ℝ) : ℂ) ^ n‖ := by
    rw [norm_mul, norm_pow, hz]
  have h2 : ‖coeff n a‖ * (ρ / 2) ^ n ≤ K := by
    rw [h1]; exact hK n
  have hpos : (0:ℝ) < ρ / 2 := by linarith
  have h3 : ‖coeff n a‖ ≤ K / (ρ / 2) ^ n := by
    rw [le_div_iff₀ (by positivity)]
    linarith [h2]
  have h4 : K / (ρ / 2) ^ n = K * (2 / ρ) ^ n := by
    rw [div_pow, div_pow]
    field_simp
  rw [h4] at h3
  exact h3

theorem growth_iff_posRadius {a : ℂ⟦X⟧} : Growth a ↔ PosRadius a :=
  ⟨Growth.posRadius, PosRadius.growth⟩

theorem GrowthAll.infRadius {a : ℂ⟦X⟧} (h : GrowthAll a) : InfRadius a := by
  intro z
  have hM : (0:ℝ) < 1 / (2 * (‖z‖ + 1)) := by positivity
  obtain ⟨C, hC, hb⟩ := h (1 / (2 * (‖z‖ + 1))) hM
  have hMz : (1 / (2 * (‖z‖ + 1))) * ‖z‖ < 1 := by
    rw [div_mul_eq_mul_div, div_lt_one (by positivity)]
    linarith [norm_nonneg z]
  have hbound : ∀ n : ℕ, ‖coeff n a * z ^ n‖ ≤ C * ((1 / (2 * (‖z‖ + 1))) * ‖z‖) ^ n := by
    intro n
    rw [norm_mul, norm_pow]
    have h1 : ‖coeff n a‖ * ‖z‖ ^ n ≤ (C * (1 / (2 * (‖z‖ + 1))) ^ n) * ‖z‖ ^ n :=
      mul_le_mul_of_nonneg_right (hb n) (by positivity)
    calc ‖coeff n a‖ * ‖z‖ ^ n ≤ (C * (1 / (2 * (‖z‖ + 1))) ^ n) * ‖z‖ ^ n := h1
      _ = C * ((1 / (2 * (‖z‖ + 1))) * ‖z‖) ^ n := by rw [mul_pow]; ring
  exact (Summable.mul_left C
    (summable_geometric_of_lt_one (by positivity) hMz)).of_norm_bounded hbound

theorem InfRadius.growthAll {a : ℂ⟦X⟧} (h : InfRadius a) : GrowthAll a := by
  intro M hM
  have hz : ‖((2 / M : ℝ) : ℂ)‖ = 2 / M := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  obtain ⟨K, hK⟩ := exists_norm_le_of_summable (h ((2 / M : ℝ) : ℂ))
  have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0)
  refine ⟨K, hK0, fun n => ?_⟩
  have h1 : ‖coeff n a‖ * (2 / M) ^ n = ‖coeff n a * ((2 / M : ℝ) : ℂ) ^ n‖ := by
    rw [norm_mul, norm_pow, hz]
  have h2 : ‖coeff n a‖ * (2 / M) ^ n ≤ K := by rw [h1]; exact hK n
  have h3 : ‖coeff n a‖ ≤ K / (2 / M) ^ n := by
    rw [le_div_iff₀ (by positivity)]
    linarith [h2]
  have h4 : K / (2 / M) ^ n = K * (M / 2) ^ n := by
    rw [div_pow, div_pow]
    field_simp
  rw [h4] at h3
  have h5 : K * (M / 2) ^ n ≤ K * M ^ n := by
    refine mul_le_mul_of_nonneg_left ?_ hK0
    exact pow_le_pow_left₀ (by positivity) (by linarith) n
  linarith [h3, h5]

theorem growthAll_iff_infRadius {a : ℂ⟦X⟧} : GrowthAll a ↔ InfRadius a :=
  ⟨GrowthAll.infRadius, InfRadius.growthAll⟩

/-! ### Geometric sums of the form `∑ M^i K^(n-i)` -/

theorem geom_sum_pow_mul_pow (M K : ℝ) (n : ℕ) :
    (K - M) * ∑ i ∈ Finset.range (n + 1), M ^ i * K ^ (n - i) = K ^ (n + 1) - M ^ (n + 1) := by
  induction n with
  | zero => simp
  | succ n ih =>
      have hsplit : ∑ i ∈ Finset.range (n + 2), M ^ i * K ^ (n + 1 - i)
          = K * (∑ i ∈ Finset.range (n + 1), M ^ i * K ^ (n - i)) + M ^ (n + 1) := by
        rw [Finset.sum_range_succ, Finset.mul_sum]
        congr 1
        · refine Finset.sum_congr rfl fun i hi => ?_
          rw [Finset.mem_range] at hi
          rw [show n + 1 - i = (n - i) + 1 by omega, pow_succ]
          ring
        · simp
      have hstep : (K - M) * (K * (∑ i ∈ Finset.range (n + 1), M ^ i * K ^ (n - i))
          + M ^ (n + 1))
          = K * ((K - M) * ∑ i ∈ Finset.range (n + 1), M ^ i * K ^ (n - i))
            + (K - M) * M ^ (n + 1) := by ring
      rw [hsplit, hstep, ih]
      ring

/-- The conditional sum occurring in the recursion for the reciprocal of a power series. -/
theorem geom_antidiagonal_identity (m : ℕ) {M K : ℝ} (_hMK : M < K) :
    (K - M) * ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
        (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0)
      = M * (K ^ (m + 1) - M ^ (m + 1)) := by
  rw [Nat.sum_antidiagonal_eq_sum_range_succ
    (fun i j => if j < m + 1 then M ^ i * K ^ j else 0)]
  have hpt : ∀ i ∈ Finset.range (m + 2),
      (if m + 1 - i < m + 1 then M ^ i * K ^ (m + 1 - i) else 0)
        = M ^ i * K ^ (m + 1 - i) - (if i = 0 then K ^ (m + 1) else 0) := by
    intro i hi
    rw [Finset.mem_range] at hi
    rcases Nat.eq_zero_or_pos i with h0 | h0
    · subst h0; simp
    · rw [if_pos (by omega), if_neg (by omega), sub_zero]
  rw [Finset.sum_congr rfl hpt, Finset.sum_sub_distrib]
  have hsingle : ∑ i ∈ Finset.range (m + 2), (if i = 0 then K ^ (m + 1) else 0) = K ^ (m + 1) := by
    rw [Finset.sum_ite_eq']
    simp
  rw [hsingle, mul_sub, geom_sum_pow_mul_pow]
  ring

theorem antidiagonal_cond_bound (m : ℕ) {M K : ℝ} (hM : 0 ≤ M) (hMK : M < K) :
    ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
        (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0)
      ≤ K ^ (m + 1) * (M / (K - M)) := by
  have hpos : 0 < K - M := by linarith
  have hid := geom_antidiagonal_identity m hMK
  have hS : ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
        (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0)
      = M * (K ^ (m + 1) - M ^ (m + 1)) / (K - M) := by
    rw [eq_div_iff hpos.ne']
    rw [mul_comm]
    exact hid
  rw [hS]
  have h2 : M * (K ^ (m + 1) - M ^ (m + 1)) ≤ M * K ^ (m + 1) := by
    have h3 : (0:ℝ) ≤ M ^ (m + 1) := by positivity
    nlinarith
  calc M * (K ^ (m + 1) - M ^ (m + 1)) / (K - M) ≤ M * K ^ (m + 1) / (K - M) := by
        gcongr
    _ = K ^ (m + 1) * (M / (K - M)) := by ring

/-! ### The reciprocal of a series with nonzero constant term -/

theorem growth_invOfUnit {a : ℂ⟦X⟧} (ha : Growth a) (u : ℂˣ)
    (_hu : constantCoeff a = (u : ℂ)) : Growth (PowerSeries.invOfUnit a u) := by
  obtain ⟨C, M, hC, hM, hb⟩ := ha
  set D : ℝ := ‖((u⁻¹ : ℂˣ) : ℂ)‖ with hDdef
  have hD0 : 0 ≤ D := norm_nonneg _
  set K : ℝ := M * (2 + C * D) with hKdef
  have hKpos : 0 < K := by rw [hKdef]; positivity
  have hMK : M < K := by
    rw [hKdef]
    nlinarith [mul_nonneg hC hD0, hM]
  have hCD : C * D * (M / (K - M)) ≤ 1 := by
    have hKM : K - M = M * (1 + C * D) := by rw [hKdef]; ring
    have h1 : 0 < 1 + C * D := by nlinarith [mul_nonneg hC hD0]
    have h2 : M / (M * (1 + C * D)) = 1 / (1 + C * D) := by
      rw [eq_div_iff (by positivity)]
      field_simp
    rw [hKM, h2, mul_one_div, div_le_one h1]
    linarith [mul_nonneg hC hD0]
  have key : ∀ n : ℕ, ‖coeff n (PowerSeries.invOfUnit a u)‖ ≤ D * K ^ n := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        rw [coeff_invOfUnit, if_pos rfl]
        simp only [pow_zero, mul_one]
        exact le_rfl
      · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        rw [coeff_invOfUnit, if_neg (by omega : ¬ (m + 1 = 0))]
        rw [norm_mul, norm_neg, hDdef]
        have hstep : ‖∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
            (if x.2 < m + 1 then coeff x.1 a * coeff x.2 (PowerSeries.invOfUnit a u) else 0)‖
              ≤ C * D * (K ^ (m + 1) * (M / (K - M))) := by
          refine (norm_sum_le _ _).trans ?_
          have hterm : ∀ x ∈ HasAntidiagonal.antidiagonal (m + 1),
              ‖if x.2 < m + 1 then coeff x.1 a * coeff x.2 (PowerSeries.invOfUnit a u) else 0‖
                ≤ C * D * (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0) := by
            intro x _
            split_ifs with h2
            · rw [norm_mul]
              have h1 : ‖coeff x.1 a‖ ≤ C * M ^ x.1 := hb x.1
              have h3 : ‖coeff x.2 (PowerSeries.invOfUnit a u)‖ ≤ D * K ^ x.2 := ih x.2 h2
              calc ‖coeff x.1 a‖ * ‖coeff x.2 (PowerSeries.invOfUnit a u)‖
                  ≤ (C * M ^ x.1) * (D * K ^ x.2) :=
                    mul_le_mul h1 h3 (norm_nonneg _) (by positivity)
                _ = C * D * (M ^ x.1 * K ^ x.2) := by ring
            · simp
          calc ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
                ‖if x.2 < m + 1 then coeff x.1 a * coeff x.2 (PowerSeries.invOfUnit a u) else 0‖
              ≤ ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
                  C * D * (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0) :=
                Finset.sum_le_sum hterm
            _ = C * D * ∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
                  (if x.2 < m + 1 then M ^ x.1 * K ^ x.2 else 0) := by rw [Finset.mul_sum]
            _ ≤ C * D * (K ^ (m + 1) * (M / (K - M))) := by
                refine mul_le_mul_of_nonneg_left (antidiagonal_cond_bound m hM.le hMK) ?_
                positivity
        calc D * ‖∑ x ∈ HasAntidiagonal.antidiagonal (m + 1),
              (if x.2 < m + 1 then coeff x.1 a * coeff x.2 (PowerSeries.invOfUnit a u) else 0)‖
            ≤ D * (C * D * (K ^ (m + 1) * (M / (K - M)))) :=
              mul_le_mul_of_nonneg_left hstep hD0
          _ = D * K ^ (m + 1) * (C * D * (M / (K - M))) := by ring
          _ ≤ D * K ^ (m + 1) * 1 := by
              refine mul_le_mul_of_nonneg_left hCD (by positivity)
          _ = D * K ^ (m + 1) := by ring
  exact ⟨D, K, hD0, hKpos, key⟩

/-! ### Every ideal of the convergent subring is principal (part (ii)) -/

theorem conv_ideal_principal (I : Ideal ↥convSubring) :
    ∃ x : ↥convSubring, I = Ideal.span {x} := by
  classical
  by_cases hI : I = ⊥
  · exact ⟨0, by rw [hI]; simp⟩
  · obtain ⟨x, hxI, hxne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
    have hxne' : (x : ℂ⟦X⟧) ≠ 0 := fun h => hxne (Subtype.ext h)
    obtain ⟨n0, hn0⟩ := PowerSeries.exists_coeff_ne_zero_iff_ne_zero.mpr hxne'
    set S : Set ℕ := {n | ∃ y ∈ I, coeff n (y : ℂ⟦X⟧) ≠ 0} with hS
    have hSne : S.Nonempty := ⟨n0, x, hxI, hn0⟩
    set d : ℕ := Nat.find hSne with hd
    obtain ⟨g, hgI, hgd⟩ := Nat.find_spec hSne
    have hmin : ∀ (y : ↥convSubring), y ∈ I → ∀ i < d, coeff i (y : ℂ⟦X⟧) = 0 := by
      intro y hy i hi
      by_contra hne
      have hmem : i ∈ S := ⟨y, hy, hne⟩
      have hle : d ≤ i := by
        rw [hd]
        exact Nat.find_min' hSne hmem
      omega
    refine ⟨g, ?_⟩
    refine le_antisymm ?_ ?_
    · intro y hy
      have hy0 : ∀ i < d, coeff i (y : ℂ⟦X⟧) = 0 := hmin y hy
      have hg0 : ∀ i < d, coeff i (g : ℂ⟦X⟧) = 0 := hmin g hgI
      have hyeq : (y : ℂ⟦X⟧) = X ^ d * shiftPS d (y : ℂ⟦X⟧) :=
        (X_pow_mul_shiftPS_of_coeff_eq_zero hy0).symm
      have hgeq : (g : ℂ⟦X⟧) = X ^ d * shiftPS d (g : ℂ⟦X⟧) :=
        (X_pow_mul_shiftPS_of_coeff_eq_zero hg0).symm
      have hv : Growth (shiftPS d (y : ℂ⟦X⟧)) := Growth.shiftPS y.2 d
      have hu : Growth (shiftPS d (g : ℂ⟦X⟧)) := Growth.shiftPS g.2 d
      have hu0 : coeff 0 (shiftPS d (g : ℂ⟦X⟧)) ≠ 0 := by
        rw [coeff_shiftPS, Nat.zero_add]; exact hgd
      have hc : PowerSeries.constantCoeff (shiftPS d (g : ℂ⟦X⟧)) =
          ((Units.mk0 (coeff 0 (shiftPS d (g : ℂ⟦X⟧))) hu0 : ℂˣ) : ℂ) := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, Units.val_mk0]
      have hunit : ∃ w : ↥convSubring, shiftPS d (g : ℂ⟦X⟧) * (w : ℂ⟦X⟧) = 1 := by
        refine ⟨⟨PowerSeries.invOfUnit (shiftPS d (g : ℂ⟦X⟧))
          (Units.mk0 (coeff 0 (shiftPS d (g : ℂ⟦X⟧))) hu0), ?_⟩, ?_⟩
        · exact growth_invOfUnit hu _ hc
        · exact PowerSeries.mul_invOfUnit _ _ hc
      obtain ⟨w, hw⟩ := hunit
      have hthis : (y : ℂ⟦X⟧) = (g : ℂ⟦X⟧) * ((w : ℂ⟦X⟧) * shiftPS d (y : ℂ⟦X⟧)) := by
        calc (y : ℂ⟦X⟧) = X ^ d * shiftPS d (y : ℂ⟦X⟧) := hyeq
          _ = X ^ d * ((shiftPS d (g : ℂ⟦X⟧) * (w : ℂ⟦X⟧)) * shiftPS d (y : ℂ⟦X⟧)) := by
              rw [hw, one_mul]
          _ = X ^ d * (shiftPS d (g : ℂ⟦X⟧) * ((w : ℂ⟦X⟧) * shiftPS d (y : ℂ⟦X⟧))) := by
              rw [mul_assoc]
          _ = (X ^ d * shiftPS d (g : ℂ⟦X⟧)) * ((w : ℂ⟦X⟧) * shiftPS d (y : ℂ⟦X⟧)) := by
              rw [mul_assoc]
          _ = (g : ℂ⟦X⟧) * ((w : ℂ⟦X⟧) * shiftPS d (y : ℂ⟦X⟧)) := by rw [← hgeq]
      have hmem : y = g * ⟨(w : ℂ⟦X⟧) * shiftPS d (y : ℂ⟦X⟧),
          Growth.mul w.2 hv⟩ := Subtype.ext hthis
      rw [hmem]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton g))
    · rw [Ideal.span_le]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact hgI

instance instIsPrincipalIdealRingConvSubring : IsPrincipalIdealRing ↥convSubring where
  principal I := by
    obtain ⟨x, hx⟩ := conv_ideal_principal I
    exact ⟨x, hx⟩

theorem isNoetherian_convSubring : IsNoetherianRing ↥convSubring := inferInstance



open PowerSeries
open Finset
open Filter
open scoped Topology

/-! ### Part (iii): the ring of power series of infinite radius -/

theorem exists_le_of_summable_real {f : ℕ → ℝ} (h : Summable f) : ∃ K : ℝ, ∀ n, f n ≤ K := by
  have ht : Tendsto f atTop (𝓝 0) := h.tendsto_atTop_zero
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 ht 1 one_pos
  refine ⟨max 1 (∑ n ∈ Finset.range N, |f n|), fun n => ?_⟩
  rcases Nat.lt_or_ge n N with hn | hn
  · have h1 : |f n| ≤ ∑ m ∈ Finset.range N, |f m| :=
      Finset.single_le_sum (f := fun m => |f m|) (fun i _ => abs_nonneg _)
        (Finset.mem_range.mpr hn)
    have h2 : f n ≤ |f n| := le_abs_self _
    linarith [le_max_right (1:ℝ) (∑ m ∈ Finset.range N, |f m|)]
  · have h2 := hN n hn
    rw [Real.dist_eq, sub_zero] at h2
    have h3 : f n < 1 := (abs_lt.mp h2).2
    linarith [le_max_left (1:ℝ) (∑ m ∈ Finset.range N, |f m|)]

/-- Evaluation of a power series of infinite radius at a complex number. -/
def evalPS (a : ↥entireSubring) (z : ℂ) : ℂ := ∑' n, coeff n (a : ℂ⟦X⟧) * z ^ n

theorem summable_evalPS (a : ↥entireSubring) (z : ℂ) :
    Summable fun n => coeff n (a : ℂ⟦X⟧) * z ^ n :=
  GrowthAll.infRadius a.2 z

theorem norm_summable_evalPS (a : ↥entireSubring) (z : ℂ) :
    Summable fun n => ‖coeff n (a : ℂ⟦X⟧) * z ^ n‖ := by
  have hM : (0:ℝ) < 1 / (2 * (‖z‖ + 1)) := by positivity
  obtain ⟨C, hC, hb⟩ := a.2 (1 / (2 * (‖z‖ + 1))) hM
  have hMz : (1 / (2 * (‖z‖ + 1))) * ‖z‖ < 1 := by
    rw [div_mul_eq_mul_div, div_lt_one (by positivity)]
    linarith [norm_nonneg z]
  refine (Summable.mul_left C (summable_geometric_of_lt_one (by positivity) hMz)).of_norm_bounded ?_
  intro n
  rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  calc ‖coeff n (a : ℂ⟦X⟧) * z ^ n‖
      = ‖coeff n (a : ℂ⟦X⟧)‖ * ‖z‖ ^ n := by rw [norm_mul, norm_pow]
    _ ≤ (C * (1 / (2 * (‖z‖ + 1))) ^ n) * ‖z‖ ^ n :=
        mul_le_mul_of_nonneg_right (hb n) (by positivity)
    _ = C * ((1 / (2 * (‖z‖ + 1))) * ‖z‖) ^ n := by rw [mul_pow]; ring

theorem evalPS_add (a b : ↥entireSubring) (z : ℂ) :
    evalPS (a + b) z = evalPS a z + evalPS b z := by
  have hpt : ∀ n : ℕ, coeff n ((a + b : ↥entireSubring) : ℂ⟦X⟧) * z ^ n =
      coeff n (a : ℂ⟦X⟧) * z ^ n + coeff n (b : ℂ⟦X⟧) * z ^ n := by
    intro n
    rw [Subring.coe_add, map_add, add_mul]
  simp only [evalPS]
  rw [tsum_congr hpt]
  exact (summable_evalPS a z).tsum_add (summable_evalPS b z)

theorem evalPS_zero (z : ℂ) : evalPS 0 z = 0 := by
  have h : (fun n : ℕ => coeff n ((0 : ↥entireSubring) : ℂ⟦X⟧) * z ^ n) = fun _ => (0:ℂ) := by
    funext n
    simp
  show (∑' n : ℕ, coeff n ((0 : ↥entireSubring) : ℂ⟦X⟧) * z ^ n) = 0
  rw [h]
  exact tsum_zero

theorem evalPS_one (z : ℂ) : evalPS 1 z = 1 := by
  have h : (fun n : ℕ => coeff n ((1 : ↥entireSubring) : ℂ⟦X⟧) * z ^ n)
      = fun n => if n = 0 then (1:ℂ) else 0 := by
    funext n
    rw [Subring.coe_one, coeff_one]
    split_ifs with hn
    · subst hn; simp
    · simp
  simp only [evalPS, h]
  rw [tsum_eq_single (0 : ℕ) (fun n hn => by simp [hn])]
  simp

theorem evalPS_mul (a b : ↥entireSubring) (z : ℂ) :
    evalPS (a * b) z = evalPS a z * evalPS b z := by
  simp only [evalPS]
  rw [tsum_mul_tsum_eq_tsum_sum_antidiagonal_of_summable_norm
    (norm_summable_evalPS a z) (norm_summable_evalPS b z)]
  refine tsum_congr fun n => ?_
  have hleft : ∑ x ∈ HasAntidiagonal.antidiagonal n,
      (coeff x.1 (a : ℂ⟦X⟧) * z ^ x.1) * (coeff x.2 (b : ℂ⟦X⟧) * z ^ x.2)
      = ∑ i ∈ Finset.range (n + 1),
          (coeff i (a : ℂ⟦X⟧) * coeff (n - i) (b : ℂ⟦X⟧)) * z ^ n := by
    rw [Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => (coeff i (a : ℂ⟦X⟧) * z ^ i) * (coeff j (b : ℂ⟦X⟧) * z ^ j))]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.mem_range] at hi
    have h2 : i + (n - i) = n := Nat.add_sub_cancel' (by omega)
    calc (coeff i (a : ℂ⟦X⟧) * z ^ i) * (coeff (n - i) (b : ℂ⟦X⟧) * z ^ (n - i))
        = coeff i (a : ℂ⟦X⟧) * coeff (n - i) (b : ℂ⟦X⟧) * (z ^ i * z ^ (n - i)) := by ring
      _ = coeff i (a : ℂ⟦X⟧) * coeff (n - i) (b : ℂ⟦X⟧) * z ^ n := by
            rw [← pow_add, h2]
      _ = (coeff i (a : ℂ⟦X⟧) * coeff (n - i) (b : ℂ⟦X⟧)) * z ^ n := by ring
  have hright : coeff n ((a * b : ↥entireSubring) : ℂ⟦X⟧) * z ^ n
      = ∑ i ∈ Finset.range (n + 1),
          (coeff i (a : ℂ⟦X⟧) * coeff (n - i) (b : ℂ⟦X⟧)) * z ^ n := by
    rw [Subring.coe_mul, coeff_mul,
      Nat.sum_antidiagonal_eq_sum_range_succ
        (fun i j => coeff i (a : ℂ⟦X⟧) * coeff j (b : ℂ⟦X⟧)), Finset.sum_mul]
  rw [hright, ← hleft]

/-- Evaluation at `z` as a ring homomorphism on the ring of series of infinite radius. -/
def evalHom (z : ℂ) : ↥entireSubring →+* ℂ where
  toFun a := evalPS a z
  map_one' := evalPS_one z
  map_mul' := fun a b => evalPS_mul a b z
  map_zero' := evalPS_zero z
  map_add' := fun a b => evalPS_add a b z

@[simp] theorem evalHom_apply (z : ℂ) (a : ↥entireSubring) : evalHom z a = evalPS a z := rfl

/-- The constant series as an element of the ring of infinite radius. -/
def constSub (a : ℂ) : ↥entireSubring := ⟨C a, by
  intro M hM
  refine ⟨‖a‖, norm_nonneg a, fun n => ?_⟩
  rw [coeff_C]
  split_ifs with h
  · rw [h]; simp
  · simp only [norm_zero]; positivity⟩

/-- The series `X` as an element of the ring of infinite radius. -/
def Xsub : ↥entireSubring := ⟨X, by
  intro M hM
  refine ⟨M⁻¹, by positivity, fun n => ?_⟩
  rw [coeff_X]
  split_ifs with h
  · subst h
    rw [norm_one, pow_one]
    exact le_of_eq (inv_mul_cancel₀ hM.ne').symm
  · simp only [norm_zero]; positivity⟩

theorem evalHom_constSub (z a : ℂ) : evalHom z (constSub a) = a := by
  simp only [evalHom_apply, constSub, evalPS]
  rw [tsum_eq_single 0]
  · simp
  · intro n hn
    simp [coeff_C, hn]

theorem evalHom_Xsub (z : ℂ) : evalHom z Xsub = z := by
  simp only [evalHom_apply, Xsub, evalPS]
  rw [tsum_eq_single 1]
  · simp
  · intro n hn
    simp [coeff_X, hn]

/-! ### The exponential series -/

/-- The series `∑ (2πi)^n / n! X^n`. -/
def expPS : ℂ⟦X⟧ := mk fun n => (2 * (Real.pi : ℂ) * Complex.I) ^ n / ((n.factorial : ℕ) : ℂ)

theorem coeff_expPS (n : ℕ) :
    coeff n expPS = (2 * (Real.pi : ℂ) * Complex.I) ^ n / ((n.factorial : ℕ) : ℂ) := by
  simp [expPS]

theorem norm_two_pi_I : ‖(2 * (Real.pi : ℂ) * Complex.I)‖ = 2 * Real.pi := by
  rw [norm_mul, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
    Real.norm_of_nonneg (by positivity)]
  norm_num

theorem growthAll_expPS : GrowthAll expPS := by
  intro M hM
  have hr : (0:ℝ) < 2 * Real.pi / M := by positivity
  obtain ⟨K, hK⟩ := exists_le_of_summable_real
    (Real.summable_pow_div_factorial (2 * Real.pi / M))
  have hK1 : (1:ℝ) ≤ K := by simpa using hK 0
  have hK0 : (0:ℝ) ≤ K := by linarith
  refine ⟨K, hK0, fun n => ?_⟩
  rw [coeff_expPS, norm_div, norm_pow, norm_two_pi_I, Complex.norm_natCast]
  have hfact : (0:ℝ) < (n.factorial : ℝ) := by exact_mod_cast n.factorial_pos
  have hA : ((2 * Real.pi / M) ^ n) * M ^ n = (2 * Real.pi) ^ n := by
    rw [← mul_pow, div_mul_cancel₀ (2 * Real.pi) hM.ne']
  have h1 : ((2 * Real.pi / M) ^ n / (n.factorial : ℝ)) * M ^ n
      = (2 * Real.pi) ^ n / (n.factorial : ℝ) := by
    rw [div_mul_eq_mul_div, hA]
  rw [← h1]
  exact mul_le_mul_of_nonneg_right (hK n) (by positivity)

/-- The exponential series as an element of the ring of infinite radius. -/
def expSub : ↥entireSubring := ⟨expPS, growthAll_expPS⟩

/-- The series `∑ (2πi)^n/n! X^n - 1`, which vanishes at every positive integer. -/
def psi : ↥entireSubring := expSub - constSub 1

theorem evalPS_sub (a b : ↥entireSubring) (z : ℂ) :
    evalPS (a - b) z = evalPS a z - evalPS b z :=
  map_sub (evalHom z) a b

theorem eval_expSub (z : ℂ) : evalPS expSub z = Complex.exp (z * (2 * (Real.pi : ℂ) * Complex.I)) := by
  have hterm : ∀ n : ℕ, coeff n (expSub : ℂ⟦X⟧) * z ^ n =
      (z * (2 * (Real.pi : ℂ) * Complex.I)) ^ n / ((n.factorial : ℕ) : ℂ) := by
    intro n
    rw [expSub, coeff_expPS]
    rw [div_mul_eq_mul_div, mul_pow, mul_comm z]
    ring
  simp only [evalPS]
  rw [tsum_congr hterm]
  have hexp := congrFun NormedSpace.exp_eq_tsum_div
    (z * (2 * (Real.pi : ℂ) * Complex.I))
  rw [← hexp, Complex.exp_eq_exp_ℂ]

theorem eval_psi_nat (k : ℕ) : evalPS psi (k : ℂ) = 0 := by
  have h2 : evalPS psi (k : ℂ) = evalHom (k : ℂ) psi := rfl
  rw [h2, psi, map_sub]
  have h3 : evalHom (k : ℂ) expSub = evalPS expSub (k : ℂ) := rfl
  have h4 : evalHom (k : ℂ) (constSub 1) = 1 := evalHom_constSub (k : ℂ) 1
  rw [h3, h4, eval_expSub]
  have h5 : (k : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) =
      ((k : ℤ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    push_cast; ring
  rw [h5, Complex.exp_int_mul_two_pi_mul_I, sub_self]

theorem eval_psi_nat' (k : ℕ) : evalHom (k : ℂ) psi = 0 := eval_psi_nat k



open PowerSeries
open Finset
open Filter
open scoped Topology

@[simp] theorem coe_Xsub : ((Xsub : ↥entireSubring) : ℂ⟦X⟧) = X := rfl

@[simp] theorem coe_constSub (a : ℂ) : ((constSub a : ↥entireSubring) : ℂ⟦X⟧) = C a := rfl

/-- The coefficient of `X * g`. -/
theorem coeff_X_mul_PS (g : ℂ⟦X⟧) (m : ℕ) :
    coeff m (X * g) = if m = 0 then 0 else coeff (m - 1) g := by
  rcases Nat.eq_zero_or_pos m with hm | hm
  · subst hm
    rw [coeff_mul,
      Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => coeff i (X : ℂ⟦X⟧) * coeff j g)]
    simp [coeff_X]
  · obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    rw [if_neg (by omega), show k + 1 - 1 = k by omega]
    rw [coeff_mul,
      Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => coeff i (X : ℂ⟦X⟧) * coeff j g)]
    refine Eq.trans (Finset.sum_eq_single 1 ?_ ?_) ?_
    · intro i _ hne
      rcases Nat.eq_zero_or_pos i with h0 | h0
      · subst h0; simp [coeff_X]
      · rw [coeff_X]; simp [hne]
    · intro h1
      exact absurd (Finset.mem_range.mpr (by omega : 1 < k + 2)) h1
    · simp [coeff_X]

/-- Division by `X - c` in the ring of series of infinite radius, for `c ≠ 0`, when the
series vanishes at `c`.  The quotient is given by the closed formula
`g_n = ∑_j f_{n+1+j} c^j`. -/
theorem exists_div_linear (c : ℂ) (hc : c ≠ 0) (f : ↥entireSubring) (hf : evalHom c f = 0) :
    ∃ g : ↥entireSubring, (Xsub - constSub c) * g = f := by
  classical
  set G : ℕ → ℂ := fun n => ∑' j : ℕ, coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j with hG
  have hεpos : (0:ℝ) < 1 / (2 * (‖c‖ + 1)) := by positivity
  have hεc : (1 / (2 * (‖c‖ + 1))) * ‖c‖ < 1 := by
    rw [div_mul_eq_mul_div, div_lt_one (by positivity)]
    linarith [norm_nonneg c]
  have hsum : ∀ n : ℕ, Summable fun j : ℕ => coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j := by
    intro n
    obtain ⟨C, hC, hbf⟩ := f.2 (1 / (2 * (‖c‖ + 1))) hεpos
    refine (Summable.mul_left (C * (1 / (2 * (‖c‖ + 1))) ^ (n + 1))
      (summable_geometric_of_lt_one (by positivity) hεc)).of_norm_bounded ?_
    intro j
    rw [norm_mul, norm_pow]
    calc ‖coeff (n + 1 + j) (f : ℂ⟦X⟧)‖ * ‖c‖ ^ j
        ≤ (C * (1 / (2 * (‖c‖ + 1))) ^ (n + 1 + j)) * ‖c‖ ^ j :=
          mul_le_mul_of_nonneg_right (hbf _) (by positivity)
      _ = (C * (1 / (2 * (‖c‖ + 1))) ^ (n + 1)) *
            ((1 / (2 * (‖c‖ + 1))) * ‖c‖) ^ j := by
          rw [pow_add, mul_pow]; ring
  have hgrowth : GrowthAll (mk G) := by
    intro M hM
    set δ : ℝ := min M (1 / (2 * (‖c‖ + 1))) with hδdef
    have hδpos : 0 < δ := lt_min hM (by positivity)
    have hδM : δ ≤ M := min_le_left _ _
    have hδc : δ * ‖c‖ ≤ 1 / 2 := by
      have h1 : δ ≤ 1 / (2 * (‖c‖ + 1)) := min_le_right _ _
      have h2 : δ * ‖c‖ ≤ (1 / (2 * (‖c‖ + 1))) * ‖c‖ :=
        mul_le_mul_of_nonneg_right h1 (norm_nonneg c)
      have h3 : (1 / (2 * (‖c‖ + 1))) * ‖c‖ ≤ 1 / 2 := by
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        nlinarith [norm_nonneg c]
      linarith
    have hδc1 : δ * ‖c‖ < 1 := by linarith
    obtain ⟨C, hC, hbf⟩ := f.2 δ hδpos
    have hterm : ∀ n j : ℕ, ‖coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖
        ≤ C * δ ^ (n + 1) * (δ * ‖c‖) ^ j := by
      intro n j
      rw [norm_mul, norm_pow]
      calc ‖coeff (n + 1 + j) (f : ℂ⟦X⟧)‖ * ‖c‖ ^ j
          ≤ (C * δ ^ (n + 1 + j)) * ‖c‖ ^ j :=
            mul_le_mul_of_nonneg_right (hbf _) (by positivity)
        _ = C * δ ^ (n + 1) * (δ * ‖c‖) ^ j := by rw [pow_add, mul_pow]; ring
    have hnorm : ∀ n : ℕ, Summable fun j : ℕ => ‖coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖ := by
      intro n
      refine (Summable.mul_left (C * δ ^ (n + 1))
        (summable_geometric_of_lt_one (by positivity) hδc1)).of_norm_bounded ?_
      intro i
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact hterm n i
    refine ⟨C * δ * (1 - δ * ‖c‖)⁻¹, by positivity, fun n => ?_⟩
    have hgm : (0:ℝ) < 1 - δ * ‖c‖ := by linarith
    have h1 : ‖G n‖ ≤ C * δ ^ (n + 1) * (1 - δ * ‖c‖)⁻¹ := by
      have h2 : ‖∑' j : ℕ, coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖
          ≤ ∑' j : ℕ, ‖coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖ :=
        norm_tsum_le_tsum_norm (hnorm n)
      have h3 : (∑' j : ℕ, ‖coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖)
          ≤ ∑' j : ℕ, C * δ ^ (n + 1) * (δ * ‖c‖) ^ j :=
        Summable.tsum_le_tsum (hterm n) (hnorm n)
          (Summable.mul_left (C * δ ^ (n + 1))
            (summable_geometric_of_lt_one (by positivity) hδc1))
      have h4 : (∑' j : ℕ, C * δ ^ (n + 1) * (δ * ‖c‖) ^ j)
          = C * δ ^ (n + 1) * (1 - δ * ‖c‖)⁻¹ := by
        rw [tsum_mul_left, tsum_geometric_of_lt_one (by positivity) hδc1]
      calc ‖G n‖ = ‖∑' j : ℕ, coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖ := by rw [hG]
        _ ≤ ∑' j : ℕ, ‖coeff (n + 1 + j) (f : ℂ⟦X⟧) * c ^ j‖ := h2
        _ ≤ ∑' j : ℕ, C * δ ^ (n + 1) * (δ * ‖c‖) ^ j := h3
        _ = C * δ ^ (n + 1) * (1 - δ * ‖c‖)⁻¹ := h4
    have h5 : C * δ ^ (n + 1) * (1 - δ * ‖c‖)⁻¹
        = (C * δ * (1 - δ * ‖c‖)⁻¹) * δ ^ n := by
      rw [pow_succ]; ring
    rw [h5] at h1
    rw [coeff_mk]
    refine le_trans h1 (mul_le_mul_of_nonneg_left ?_ (by positivity))
    exact pow_le_pow_left₀ (le_of_lt hδpos) hδM n
  refine ⟨⟨PowerSeries.mk G, hgrowth⟩, ?_⟩
  have hcoe : (((Xsub - constSub c) * ⟨PowerSeries.mk G, hgrowth⟩ : ↥entireSubring) : ℂ⟦X⟧)
      = (X - C c) * PowerSeries.mk G := by
    rw [Subring.coe_mul, sub_eq_add_neg, Subring.coe_add, Subring.coe_neg, coe_Xsub,
      coe_constSub]
    rfl
  refine Subtype.ext ?_
  rw [hcoe, sub_mul]
  ext m
  rw [map_sub, coeff_C_mul, coeff_X_mul_PS]
  have hsum' : ∀ k : ℕ, Summable fun j : ℕ => coeff (k + j) (f : ℂ⟦X⟧) * c ^ j := by
    intro k
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      simpa using summable_evalPS f c
    · obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      exact hsum k'
  have hsplit : ∀ k : ℕ, (∑' j : ℕ, coeff (k + j) (f : ℂ⟦X⟧) * c ^ j)
      = coeff k (f : ℂ⟦X⟧) + ∑' j : ℕ, coeff (k + 1 + j) (f : ℂ⟦X⟧) * c ^ (j + 1) := by
    intro k
    rw [(hsum' k).tsum_eq_zero_add]
    have h2 : coeff (k + 0) (f : ℂ⟦X⟧) * c ^ 0 = coeff k (f : ℂ⟦X⟧) := by
      rw [Nat.add_zero, pow_zero, mul_one]
    rw [h2]
    exact congrArg (fun t => coeff k (f : ℂ⟦X⟧) + t)
      (tsum_congr fun j => by rw [show k + (j + 1) = k + 1 + j by omega])
  have hGc : ∀ k : ℕ, coeff k (PowerSeries.mk G)
      = ∑' j : ℕ, coeff (k + 1 + j) (f : ℂ⟦X⟧) * c ^ j := by
    intro k
    rw [coeff_mk]
  rcases Nat.eq_zero_or_pos m with hm | hm
  · subst hm
    rw [if_pos rfl, zero_sub, hGc 0]
    have h3 : (∑' b : ℕ, coeff b (f : ℂ⟦X⟧) * c ^ b) = 0 := hf
    have hsplit0 := hsplit 0
    simp only [Nat.zero_add] at hsplit0
    have h0 : coeff 0 (f : ℂ⟦X⟧)
        = -(∑' j : ℕ, coeff (1 + j) (f : ℂ⟦X⟧) * c ^ (j + 1)) := by
      rw [h3] at hsplit0
      exact eq_neg_iff_add_eq_zero.mpr hsplit0.symm
    have h4 : c * (∑' j : ℕ, coeff (1 + j) (f : ℂ⟦X⟧) * c ^ j)
        = ∑' j : ℕ, coeff (1 + j) (f : ℂ⟦X⟧) * c ^ (j + 1) := by
      rw [← tsum_mul_left]
      exact tsum_congr fun j => by rw [pow_succ]; ring
    rw [h4, h0]
  · obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
    rw [if_neg (by omega), show n + 1 - 1 = n by omega, hGc n, hGc (n + 1)]
    have h4 : c * (∑' j : ℕ, coeff (n + 1 + 1 + j) (f : ℂ⟦X⟧) * c ^ j)
        = ∑' j : ℕ, coeff (n + 1 + 1 + j) (f : ℂ⟦X⟧) * c ^ (j + 1) := by
      rw [← tsum_mul_left]
      exact tsum_congr fun j => by rw [pow_succ]; ring
    rw [h4]
    have hgen := hsplit (n + 1)
    rw [hgen]
    ring



open PowerSeries
open Finset

/-- `∏_{j<n} ((n) - j) = n!`. -/
theorem prod_range_sub_factorial (k : ℕ) :
    ∏ j ∈ Finset.range k, (((k : ℂ) + 1) - ((j : ℂ) + 1)) = (k.factorial : ℂ) := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Finset.prod_range_succ']
      have hstep : ∀ j ∈ Finset.range k,
          ((↑(k + 1) : ℂ) + 1 - (↑(j + 1) + 1)) = ((↑k : ℂ) + 1 - (↑j + 1)) := by
        intro j _
        push_cast
        ring
      rw [Finset.prod_congr rfl hstep, ih]
      have h0 : ((↑(k + 1) : ℂ) + 1 - ((↑(0 : ℕ)) + 1)) = ((k : ℂ) + 1) := by
        push_cast; ring
      rw [h0, Nat.factorial_succ]
      push_cast
      ring

/-- The product `(X-1)(X-2)···(X-n)` in the ring of series of infinite radius. -/
noncomputable def Pprod (n : ℕ) : ↥entireSubring :=
  ∏ j ∈ Finset.range n, (Xsub - constSub ((j : ℂ) + 1))

theorem Pprod_succ (n : ℕ) :
    Pprod (n + 1) = Pprod n * (Xsub - constSub ((n : ℂ) + 1)) := by
  simp [Pprod, Finset.prod_range_succ]

theorem evalHom_Pprod (z : ℂ) (n : ℕ) :
    evalHom z (Pprod n) = ∏ j ∈ Finset.range n, (z - ((j : ℂ) + 1)) := by
  simp only [Pprod, map_prod]
  exact Finset.prod_congr rfl fun j _ => by rw [map_sub, evalHom_Xsub, evalHom_constSub]

theorem evalHom_Pprod_nat (n : ℕ) :
    evalHom ((n : ℂ) + 1) (Pprod n) = (n.factorial : ℂ) := by
  rw [evalHom_Pprod]
  exact prod_range_sub_factorial n

theorem Pprod_ne_zero (n : ℕ) : Pprod n ≠ 0 := by
  have h : ∀ j ∈ Finset.range n, (Xsub - constSub ((j : ℂ) + 1)) ≠ 0 := by
    intro j _ h0
    have h1 : evalHom ((j : ℂ) + 2) (Xsub - constSub ((j : ℂ) + 1)) = evalHom ((j : ℂ) + 2) 0 := by
      rw [h0]
    rw [map_zero, map_sub, evalHom_Xsub, evalHom_constSub] at h1
    have h2 : ((j : ℂ) + 2) - ((j : ℂ) + 1) = 1 := by ring
    rw [h2] at h1
    exact one_ne_zero h1
  exact Finset.prod_ne_zero_iff.mpr h

theorem psi_ne_zero : psi ≠ 0 := by
  intro h
  have h1 : evalPS psi (1 / 2 : ℂ) = 0 := by rw [h]; simp [evalPS]
  have h2 : evalPS psi (1 / 2 : ℂ) = -2 := by
    show evalHom (1 / 2 : ℂ) psi = -2
    rw [psi, map_sub, evalHom_constSub]
    have hstep : evalHom (1 / 2 : ℂ) expSub = evalPS expSub (1 / 2 : ℂ) := rfl
    rw [hstep, eval_expSub]
    have h3 : (1 / 2 : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) = (Real.pi : ℂ) * Complex.I := by
      ring
    rw [h3, Complex.exp_pi_mul_I]
    ring
  rw [h2] at h1
  norm_num at h1

/-- The chain datum: a series `g` with `(X-1)···(X-n) * g = psi`. -/
noncomputable def hData : (n : ℕ) → {g : ↥entireSubring // Pprod n * g = psi}
  | 0 => ⟨psi, by simp [Pprod]⟩
  | (n + 1) => by
      obtain ⟨g, hg⟩ := hData n
      have hzero : evalHom ((n : ℂ) + 1) g = 0 := by
        have h1 : evalHom ((n : ℂ) + 1) (Pprod n) * evalHom ((n : ℂ) + 1) g = 0 := by
          rw [← map_mul, hg]
          have hp := eval_psi_nat' (n + 1)
          push_cast at hp
          exact hp
        rw [evalHom_Pprod_nat] at h1
        rcases mul_eq_zero.mp h1 with h' | h'
        · exact absurd h' (by exact_mod_cast n.factorial_ne_zero)
        · exact h'
      have hex : ∃ h' : ↥entireSubring, (Xsub - constSub ((n : ℂ) + 1)) * h' = g :=
        exists_div_linear ((n : ℂ) + 1)
          (by exact_mod_cast Nat.succ_ne_zero n) g hzero
      refine ⟨Classical.choose hex, ?_⟩
      rw [Pprod_succ, mul_assoc, Classical.choose_spec hex, hg]

/-- The series `psi / ((X-1)···(X-n))`. -/
noncomputable def hTerm (n : ℕ) : ↥entireSubring := (hData n).1

theorem hTerm_spec (n : ℕ) : Pprod n * hTerm n = psi := (hData n).2

theorem hTerm_ne_zero (n : ℕ) : hTerm n ≠ 0 := by
  intro h
  have h1 : psi = 0 := by rw [← hTerm_spec n, h, mul_zero]
  exact psi_ne_zero h1

theorem hTerm_step (n : ℕ) :
    hTerm n = (Xsub - constSub ((n : ℂ) + 1)) * hTerm (n + 1) := by
  have h1 : Pprod n * ((Xsub - constSub ((n : ℂ) + 1)) * hTerm (n + 1)) = Pprod n * hTerm n := by
    rw [← mul_assoc, ← Pprod_succ, hTerm_spec, hTerm_spec]
  exact (mul_left_cancel₀ (Pprod_ne_zero n) h1).symm

/-- The ideals `(psi / ((X-1)···(X-n)))` in the ring of series of infinite radius. -/
noncomputable def chainI (n : ℕ) : Ideal ↥entireSubring := Ideal.span {hTerm n}

theorem chainI_lt (n : ℕ) : chainI n < chainI (n + 1) := by
  have hle : chainI n ≤ chainI (n + 1) := by
    rw [chainI, Ideal.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx, hTerm_step n]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  refine lt_of_le_of_ne hle ?_
  intro heq
  have hmem : hTerm (n + 1) ∈ chainI n := by
    rw [heq]
    exact Ideal.subset_span (Set.mem_singleton _)
  rw [chainI, Ideal.mem_span_singleton] at hmem
  obtain ⟨q, hq⟩ := hmem
  have h1 : (1 - (Xsub - constSub ((n : ℂ) + 1)) * q) * hTerm (n + 1) = 0 := by
    have h2 : hTerm (n + 1) = ((Xsub - constSub ((n : ℂ) + 1)) * q) * hTerm (n + 1) := by
      calc hTerm (n + 1) = hTerm n * q := hq
        _ = ((Xsub - constSub ((n : ℂ) + 1)) * hTerm (n + 1)) * q := by rw [hTerm_step n]
        _ = ((Xsub - constSub ((n : ℂ) + 1)) * q) * hTerm (n + 1) := by ring
    calc (1 - (Xsub - constSub ((n : ℂ) + 1)) * q) * hTerm (n + 1)
        = hTerm (n + 1) - ((Xsub - constSub ((n : ℂ) + 1)) * q) * hTerm (n + 1) := by ring
      _ = 0 := by rw [← h2, sub_self]
  have h2 : (1 - (Xsub - constSub ((n : ℂ) + 1)) * q) = 0 := by
    rcases mul_eq_zero.mp h1 with h' | h'
    · exact h'
    · exact absurd h' (hTerm_ne_zero (n + 1))
  have h3 := congrArg (evalHom ((n : ℂ) + 1)) h2
  simp only [map_sub, map_one, map_mul, evalHom_Xsub, evalHom_constSub, sub_self, zero_mul,
    sub_zero, map_zero] at h3
  exact one_ne_zero h3

/-- **(iii)** The ring of power series with infinite radius of convergence is not
Noetherian. -/
theorem not_isNoetherian_entireSubring : ¬ IsNoetherianRing ↥entireSubring :=
  fun h => @false_of_strictMono_ideal ↥entireSubring _ h chainI
    (strictMono_nat_of_lt_succ chainI_lt)



/-! ## The five parts, under their final names -/

/-- **(i)** The ring of rational functions of `z` with no pole on `|z| = 1`
(realized as `S⁻¹ℂ[X]`, `S` the polynomials with no zero on the unit circle)
is Noetherian. -/
theorem part_i_isNoetherian : IsNoetherianRing ↥noPoleOnCircle :=
  isNoetherian_noPoleOnCircle

/-- The equivalent localization model is Noetherian as well. -/
theorem part_i_localization_isNoetherian :
    IsNoetherianRing (Localization unitCirclePolys) :=
  inferInstance

/-- **(ii)** The ring of power series with positive radius of convergence, as an
explicit subring of `ℂ⟦X⟧`, is Noetherian. -/
theorem part_ii_isNoetherian : IsNoetherianRing ↥convSubring := isNoetherian_convSubring

/-- **(ii)**, membership form: the subring is exactly the set of series with positive
radius of convergence. -/
theorem part_ii_mem_iff (a : ℂ⟦X⟧) : a ∈ convSubring ↔ PosRadius a := growth_iff_posRadius

/-- **(iii)** The ring of power series with infinite radius of convergence, as an
explicit subring of `ℂ⟦X⟧`, is **not** Noetherian. -/
theorem part_iii_not_isNoetherian : ¬ IsNoetherianRing ↥entireSubring :=
  not_isNoetherian_entireSubring

/-- **(iii)**, membership form: the subring is exactly the set of series converging
everywhere. -/
theorem part_iii_mem_iff (a : ℂ⟦X⟧) : a ∈ entireSubring ↔ InfRadius a :=
  growthAll_iff_infRadius

/-- **(iv)** The ring of polynomials whose first `k` derivatives vanish at the origin
is Noetherian. -/
theorem part_iv_isNoetherian (k : ℕ) : IsNoetherianRing ↥(vanishingDerivatives k) :=
  isNoetherian_vanishingDerivatives k

/-- **(v)** The ring of polynomials in `z, w` all of whose `w`-partial derivatives
vanish at `z = 0` is **not** Noetherian. -/
theorem part_v_not_isNoetherian : ¬ IsNoetherianRing ↥partialWSub :=
  not_isNoetherian_partialWSub

end AtiyahMcdonald69.Ex_7_4

