/-
# Atiyah–Macdonald (1969), Chapter 4, Exercise 8

*Book statement* (Chapter 4, "Primary decomposition", Exercise 8, p. 55):

> Let `k` be a field. Show that in the polynomial ring `k[x₁, …, xₙ]` the ideals
> `p_i = (x₁, …, x_i)` (`1 ≤ i ≤ n`) are prime and all their powers are primary.

*Formal version.*  We work with `MvPolynomial (Fin n) k`, whose variables `X 0, …, X (n-1)`
are the book's `x₁, …, xₙ` (Lean indexes from `0`).  The ideal `p n i` below is the span of
`X j` for `j < i`, i.e. the book's `p_i = (x₁, …, x_i)`.  The two main results are

* `isPrime_p : (p n i).IsPrime`;
* `isPrimary_p_pow : r ≠ 0 → ((p n i) ^ r).IsPrimary`,

bundled as `solution`.  Note that the statement has to be read with *positive* powers only:
`p_i ^ 0 = ⊤` is the unit ideal, which is not primary because primary ideals are required to be
proper (see `isPrimary_p_zero_not` below).  We prove the statement for all `n`, `i`, including
the cases `i = 0` (where `p_0 = (0)`) and `i > n`; the book's side conditions `1 ≤ i ≤ n` are
carried along in `solution` for faithfulness.

*Proof route*  (different from the solution's suggested route through Exercise 7, which
transfers primary ideals along `A → A[x]`; no such transfer result is needed here).
Mathlib's `MvPolynomial.mem_pow_idealOfVars_iff` describes the powers of the ideal generated by
all variables in a polynomial ring `A[x₁,…,x_m]` in terms of the total degree of the monomials
occurring in a polynomial.  Writing `k[x₀,…,x_{n-1}] = k[x | j < i][x | ¬ j < i]`
(`splitEquiv`), the ideal `p_i` becomes the ideal generated by *all* variables of the polynomial
ring with coefficient ring `B = k[x | ¬ j < i]`, which is a domain.  Over a domain, the minimal
total degree of the monomials of a product is the sum of the minimal total degrees
(`minDeg_mul`, proved from a computation with homogeneous components), which gives at once that
the powers of that ideal are primary (`isPrimary_idealOfVars_pow`) and the ideal itself is prime
(`isPrime_idealOfVars`).  Transferring along the algebra equivalence (which is bijective, so
contractions along it are just preimages) yields the exercise.
-/

import Mathlib

namespace AtiyahMcdonald69.Ex_4_8

open MvPolynomial

/-! ## 1. The minimal degree of a monomial occurring in a polynomial -/

section MinDeg

variable {A : Type*} [CommSemiring A] {τ : Type*}

noncomputable def minDeg (f : MvPolynomial τ A) : ℕ :=
  if h : f.support.Nonempty then f.support.inf' h (fun α => Finsupp.degree α) else 0

lemma support_nonempty_iff {f : MvPolynomial τ A} : f.support.Nonempty ↔ f ≠ 0 := by
  rw [Finset.nonempty_iff_ne_empty, Ne, support_eq_empty]

lemma minDeg_eq_zero {f : MvPolynomial τ A} (h : f = 0) : minDeg f = 0 := by
  subst h
  simp [minDeg]

lemma minDeg_le {f : MvPolynomial τ A} (hf : f ≠ 0) {α : τ →₀ ℕ} (hα : α ∈ f.support) :
    minDeg f ≤ Finsupp.degree α := by
  have hne : f.support.Nonempty := support_nonempty_iff.mpr hf
  simp only [minDeg, dif_pos hne]
  exact Finset.inf'_le _ hα

lemma exists_minDeg {f : MvPolynomial τ A} (hf : f ≠ 0) :
    ∃ α ∈ f.support, Finsupp.degree α = minDeg f := by
  have hne : f.support.Nonempty := support_nonempty_iff.mpr hf
  have h1 : f.support.inf' hne (fun α => Finsupp.degree α) ≤ minDeg f := by
    rw [minDeg, dif_pos hne]
  obtain ⟨b, hb, hle⟩ := (Finset.inf'_le_iff (s := f.support) hne
    (f := fun α => Finsupp.degree α) (a := minDeg f)).mp h1
  exact ⟨b, hb, le_antisymm hle (minDeg_le hf hb)⟩

/-- Membership in the powers of the ideal of all variables, in terms of `minDeg`. -/
theorem mem_idealOfVars_pow_iff (r : ℕ) (f : MvPolynomial τ A) :
    f ∈ idealOfVars τ A ^ r ↔ f = 0 ∨ r ≤ minDeg f := by
  by_cases hf : f = 0
  · subst hf
    simp [minDeg_eq_zero]
  · rw [mem_pow_idealOfVars_iff]
    constructor
    · intro h
      obtain ⟨α, hα, hαd⟩ := exists_minDeg hf
      exact Or.inr (hαd ▸ h α hα)
    · rintro (h | h)
      · exact absurd h hf
      · intro α hα
        exact le_trans h (minDeg_le hf hα)

/-- Membership in the ideal of all variables, in terms of `minDeg`. -/
theorem mem_idealOfVars_iff (f : MvPolynomial τ A) :
    f ∈ idealOfVars τ A ↔ f = 0 ∨ 1 ≤ minDeg f := by
  rw [← pow_one (idealOfVars τ A), mem_idealOfVars_pow_iff]

lemma minDeg_monomial {s : τ →₀ ℕ} {c : A} (hc : c ≠ 0) :
    minDeg (monomial s c) = Finsupp.degree s := by
  classical
  have hsupp : (monomial s c).support = {s} := by
    rw [support_monomial]; simp [hc]
  have hne : (monomial s c).support.Nonempty := by
    rw [hsupp]; exact Finset.singleton_nonempty s
  simp only [minDeg, dif_pos hne, hsupp, Finset.inf'_singleton]

lemma minDeg_one [Nontrivial A] : minDeg (1 : MvPolynomial τ A) = 0 := by
  have h : (1 : MvPolynomial τ A) = monomial (0 : τ →₀ ℕ) (1 : A) := by
    simp
  rw [h, minDeg_monomial (one_ne_zero : (1 : A) ≠ 0), map_zero]

lemma hc_minDeg_ne_zero {f : MvPolynomial τ A} (hf : f ≠ 0) :
    homogeneousComponent (minDeg f) f ≠ 0 := by
  obtain ⟨α, hα, hαd⟩ := exists_minDeg hf
  intro h
  have h1 : coeff α (homogeneousComponent (minDeg f) f) = 0 := by rw [h]; simp
  rw [coeff_homogeneousComponent, if_pos hαd] at h1
  exact (mem_support_iff.mp hα) h1

end MinDeg


/-! ## 2. The homogeneous component of minimal degree is multiplicative -/

section MulAux

variable {A : Type*} [CommSemiring A] {τ : Type*} [DecidableEq τ]

/-- The degree-`minDeg f + minDeg g` homogeneous component of `f * g` is the product of the
lowest homogeneous components. -/
lemma hc_mul {f g : MvPolynomial τ A} (hf : f ≠ 0) (hg : g ≠ 0) :
    homogeneousComponent (minDeg f + minDeg g) (f * g) =
      homogeneousComponent (minDeg f) f * homogeneousComponent (minDeg g) g := by
  ext γ
  rw [coeff_homogeneousComponent, coeff_mul, coeff_mul]
  by_cases hγ : Finsupp.degree γ = minDeg f + minDeg g
  · rw [if_pos hγ]
    refine Finset.sum_congr rfl fun x hx => ?_
    have hx' : x.1 + x.2 = γ := by simpa using hx
    have hdeg : Finsupp.degree γ = Finsupp.degree x.1 + Finsupp.degree x.2 := by
      rw [← hx', map_add]
    rw [coeff_homogeneousComponent, coeff_homogeneousComponent]
    by_cases h1 : Finsupp.degree x.1 = minDeg f
    · have h2 : Finsupp.degree x.2 = minDeg g := by omega
      rw [if_pos h1, if_pos h2]
    · have hzero : coeff x.1 f * coeff x.2 g = 0 := by
        by_cases hc1 : coeff x.1 f = 0
        · rw [hc1, zero_mul]
        · have hmem1 : x.1 ∈ f.support := mem_support_iff.mpr hc1
          have hlt : minDeg f < Finsupp.degree x.1 :=
            lt_of_le_of_ne (minDeg_le hf hmem1) (Ne.symm h1)
          have hc2 : coeff x.2 g = 0 := by
            by_contra hc2
            have hmem2 : x.2 ∈ g.support := mem_support_iff.mpr hc2
            have h2 := minDeg_le hg hmem2
            omega
          rw [hc2, mul_zero]
      rw [if_neg h1, zero_mul, hzero]
  · rw [if_neg hγ]
    refine Eq.symm (Finset.sum_eq_zero fun x hx => ?_)
    have hx' : x.1 + x.2 = γ := by simpa using hx
    have hdeg : Finsupp.degree γ = Finsupp.degree x.1 + Finsupp.degree x.2 := by
      rw [← hx', map_add]
    rw [coeff_homogeneousComponent, coeff_homogeneousComponent]
    by_cases h1 : Finsupp.degree x.1 = minDeg f
    · by_cases h2 : Finsupp.degree x.2 = minDeg g
      · exfalso; omega
      · rw [if_neg h2, mul_zero]
    · rw [if_neg h1, zero_mul]

end MulAux


/-! ## 3. The minimal degree is additive over products -/

section Mul

variable {A : Type*} [CommSemiring A] [NoZeroDivisors A] {τ : Type*} [DecidableEq τ]

/-- The minimal degree is additive over products. -/
theorem minDeg_mul {f g : MvPolynomial τ A} (hf : f ≠ 0) (hg : g ≠ 0) :
    minDeg (f * g) = minDeg f + minDeg g := by
  have hfg : f * g ≠ 0 := mul_ne_zero hf hg
  refine le_antisymm ?_ ?_
  · have hne : homogeneousComponent (minDeg f + minDeg g) (f * g) ≠ 0 := by
      rw [hc_mul hf hg]
      exact mul_ne_zero (hc_minDeg_ne_zero hf) (hc_minDeg_ne_zero hg)
    obtain ⟨γ, hγ⟩ := support_nonempty_iff.mpr hne
    rw [support_homogeneousComponent, Finset.mem_filter] at hγ
    calc minDeg (f * g) ≤ Finsupp.degree γ := minDeg_le hfg hγ.1
      _ = minDeg f + minDeg g := hγ.2
  · obtain ⟨α, hα, hαd⟩ := exists_minDeg hfg
    obtain ⟨a, ha, b, hb, hab⟩ := Finset.mem_add.mp (support_mul f g hα)
    rw [← hαd, ← hab, map_add]
    exact add_le_add (minDeg_le hf ha) (minDeg_le hg hb)

end Mul



/-! ## 4. Powers of the ideal of all variables over a domain are primary -/

section Prime

variable {A : Type*} [CommSemiring A] [IsDomain A] {τ : Type*} [DecidableEq τ]

/-- The ideal of all variables of a polynomial ring over a domain is prime. -/
theorem isPrime_idealOfVars : (idealOfVars τ A).IsPrime := by
  rw [Ideal.isPrime_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    have h1 : (1 : MvPolynomial τ A) ∈ idealOfVars τ A := by rw [htop]; exact Submodule.mem_top
    rw [mem_idealOfVars_iff] at h1
    rcases h1 with h1 | h1
    · exact one_ne_zero h1
    · rw [minDeg_one] at h1
      exact absurd h1 (by omega)
  · intro x y hxy
    rw [mem_idealOfVars_iff] at hxy
    rw [mem_idealOfVars_iff, mem_idealOfVars_iff]
    by_cases hx : x = 0
    · exact Or.inl (Or.inl hx)
    by_cases hy : y = 0
    · exact Or.inr (Or.inl hy)
    rcases hxy with hz | h
    · exact absurd hz (mul_ne_zero hx hy)
    · have hm : 1 ≤ minDeg x + minDeg y := by rwa [minDeg_mul hx hy] at h
      rcases Nat.eq_zero_or_pos (minDeg x) with h0 | h0
      · exact Or.inr (Or.inr (by omega))
      · exact Or.inl (Or.inr (by omega))

/-- Powers of the ideal of all variables in a polynomial ring over a domain are primary. -/
theorem isPrimary_idealOfVars_pow {r : ℕ} (hr : r ≠ 0) :
    ((idealOfVars τ A) ^ r).IsPrimary := by
  rw [Ideal.isPrimary_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    have h1 : (1 : MvPolynomial τ A) ∈ (idealOfVars τ A) ^ r := by
      rw [htop]; exact Submodule.mem_top
    rw [mem_idealOfVars_pow_iff] at h1
    rcases h1 with h1 | h1
    · exact one_ne_zero h1
    · rw [minDeg_one] at h1
      exact absurd h1 (by omega)
  · intro x y hxy
    rw [mem_idealOfVars_pow_iff] at hxy
    rw [Ideal.radical_pow _ hr, isPrime_idealOfVars.radical, mem_idealOfVars_iff,
      mem_idealOfVars_pow_iff]
    by_cases hx : x = 0
    · exact Or.inl (Or.inl hx)
    rcases hxy with hz | h
    · by_cases hy : y = 0
      · exact Or.inr (Or.inl hy)
      · exact absurd hz (mul_ne_zero hx hy)
    · by_cases hy : y = 0
      · exact Or.inr (Or.inl hy)
      · have hm : r ≤ minDeg x + minDeg y := by rwa [minDeg_mul hx hy] at h
        rcases Nat.lt_or_ge (minDeg x) r with hlt | hge
        · exact Or.inr (Or.inr (by omega))
        · exact Or.inl (Or.inr hge)

end Prime



/-! ## 5. The exercise: `p_i = (x_1, …, x_i)` in `k[x_1, …, x_n]` -/

section Main

variable {k : Type*} [Field k]

/-- `p n i` is the ideal `(x_0, …, x_{i-1})` of `k[x_0, …, x_{n-1}]`, i.e. the book's
`p_i = (x_1, …, x_i)`. -/
noncomputable def p (n i : ℕ) : Ideal (MvPolynomial (Fin n) k) :=
  Ideal.span (X '' {j : Fin n | (j : ℕ) < i})

/-- The algebra equivalence `k[x_0,…,x_{n-1}] ≃ k[x | j < i][x | ¬ j < i]` obtained by
splitting the variables into the first `i` and the remaining ones. -/
noncomputable def splitEquiv (n i : ℕ) :
    MvPolynomial (Fin n) k ≃ₐ[k]
      MvPolynomial {j : Fin n // (j : ℕ) < i} (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k) :=
  (MvPolynomial.renameEquiv k (Equiv.Set.sumCompl {j : Fin n | (j : ℕ) < i}).symm).trans
    (MvPolynomial.sumAlgEquiv k {j : Fin n // (j : ℕ) < i} {j : Fin n // ¬ (j : ℕ) < i})

lemma splitEquiv_X (n i : ℕ) (x : {j : Fin n // (j : ℕ) < i}) :
    splitEquiv (k := k) n i (X (x : Fin n)) = X x := by
  classical
  have h1 : (Equiv.Set.sumCompl {j : Fin n | (j : ℕ) < i}).symm ((x : Fin n)) = Sum.inl x := by
    rw [Equiv.symm_apply_eq, Equiv.Set.sumCompl_apply_inl]
  simp only [splitEquiv, AlgEquiv.trans_apply, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X,
    h1, MvPolynomial.sumAlgEquiv_X_inl]

lemma map_p (n i : ℕ) :
    Ideal.map (splitEquiv (k := k) n i).toRingHom (p n i) =
      MvPolynomial.idealOfVars {j : Fin n // (j : ℕ) < i}
        (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k) := by
  classical
  rw [p, Ideal.map_span]
  change Ideal.span ((⇑(splitEquiv (k := k) n i)) '' (X '' {j : Fin n | (j : ℕ) < i})) =
    Ideal.span (Set.range (fun x : {j : Fin n // (j : ℕ) < i} => X x))
  congr 1
  ext y
  constructor
  · rintro ⟨z, ⟨j, hj, hz⟩, hyz⟩
    refine ⟨⟨j, hj⟩, ?_⟩
    rw [← hyz, ← hz]
    show X ⟨j, hj⟩ = splitEquiv (k := k) n i (X j)
    rw [← splitEquiv_X (k := k) n i ⟨j, hj⟩]
  · rintro ⟨x, hx⟩
    refine ⟨X (x : Fin n), ⟨(x : Fin n), x.2, rfl⟩, ?_⟩
    rw [← hx, splitEquiv_X (k := k) n i x]


lemma comap_map_self (n i : ℕ) (I : Ideal (MvPolynomial (Fin n) k)) :
    Ideal.comap (splitEquiv (k := k) n i).toRingHom
        (Ideal.map (splitEquiv (k := k) n i).toRingHom I) = I := by
  classical
  have hker : RingHom.ker ((splitEquiv (k := k) n i).toRingHom) = ⊥ :=
    RingHom.injective_iff_ker_eq_bot _ |>.mp (splitEquiv (k := k) n i).injective
  have h1 := Ideal.comap_map_of_surjective' (f := (splitEquiv (k := k) n i).toRingHom)
    (splitEquiv (k := k) n i).surjective I
  exact h1.trans (by rw [hker, sup_bot_eq])

/-- `p n i` is the contraction of the ideal of all variables in the split ring. -/
lemma comap_p (n i : ℕ) :
    p (k := k) n i = Ideal.comap (splitEquiv (k := k) n i).toRingHom
      (MvPolynomial.idealOfVars {j : Fin n // (j : ℕ) < i}
        (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)) := by
  rw [← map_p (k := k) n i, comap_map_self]

lemma comap_p_pow (n i r : ℕ) :
    p (k := k) n i ^ r = Ideal.comap (splitEquiv (k := k) n i).toRingHom
      ((MvPolynomial.idealOfVars {j : Fin n // (j : ℕ) < i}
        (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)) ^ r) := by
  have h1 : Ideal.map (splitEquiv (k := k) n i).toRingHom (p (k := k) n i ^ r) =
      (MvPolynomial.idealOfVars {j : Fin n // (j : ℕ) < i}
        (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)) ^ r := by
    rw [Ideal.map_pow, map_p]
  rw [← h1, comap_map_self]

/-- **Atiyah–Macdonald, Chapter 4, Exercise 8 (primality).** The ideal
`p_i = (x_1, …, x_i)` of `k[x_1, …, x_n]` is prime. -/
theorem isPrime_p (n i : ℕ) : (p (k := k) n i).IsPrime := by
  classical
  rw [comap_p (k := k) n i]
  exact Ideal.IsPrime.comap (f := (splitEquiv (k := k) n i).toRingHom)
    (hK := isPrime_idealOfVars (A := MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)
      (τ := {j : Fin n // (j : ℕ) < i}))

/-- **Atiyah–Macdonald, Chapter 4, Exercise 8 (primary).** Every positive power of
`p_i` is primary. -/
theorem isPrimary_p_pow (n i r : ℕ) (hr : r ≠ 0) : ((p (k := k) n i) ^ r).IsPrimary := by
  classical
  rw [comap_p_pow (k := k) n i r]
  exact Ideal.IsPrimary.comap
    (I := (MvPolynomial.idealOfVars {j : Fin n // (j : ℕ) < i}
      (MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)) ^ r)
    (isPrimary_idealOfVars_pow (A := MvPolynomial {j : Fin n // ¬ (j : ℕ) < i} k)
      (τ := {j : Fin n // (j : ℕ) < i}) hr)
    ((splitEquiv (k := k) n i).toRingHom)

/-- The radical of a positive power of `p n i` is `p n i` itself; in other words `p n i ^ r` is
`p n i`-primary in the sense of Atiyah–Macdonald. -/
theorem radical_p_pow (n i r : ℕ) (hr : r ≠ 0) :
    ((p (k := k) n i) ^ r).radical = p (k := k) n i := by
  rw [Ideal.radical_pow _ hr, (isPrime_p n i).radical]

/-- The same statement in Atiyah–Macdonald's original formulation of primary ideals
(`xy ∈ q` implies `x ∈ q` or `y^n ∈ q` for some `n > 0`). -/
theorem isPrimary_p_pow_am (n i r : ℕ) (hr : 1 ≤ r) {x y : MvPolynomial (Fin n) k}
    (hxy : x * y ∈ (p (k := k) n i) ^ r) :
    x ∈ (p (k := k) n i) ^ r ∨ ∃ m : ℕ, 0 < m ∧ y ^ m ∈ (p (k := k) n i) ^ r := by
  obtain ⟨-, hmem⟩ := Ideal.isPrimary_iff.mp (isPrimary_p_pow (k := k) n i r (by omega))
  rcases hmem hxy with h | h
  · exact Or.inl h
  · rw [Ideal.mem_radical_iff] at h
    obtain ⟨m, hm⟩ := h
    refine Or.inr ⟨max m 1, by omega, ?_⟩
    have he : y ^ max m 1 = y ^ m * y ^ (max m 1 - m) := by
      rw [← pow_add]; congr 1; omega
    rw [he]
    exact Ideal.mul_mem_right _ _ hm

/-- **Atiyah–Macdonald, Chapter 4, Exercise 8**, in the precise form stated in the book:
for a field `k` and `1 ≤ i ≤ n`, the ideal `p_i = (x_1, …, x_i)` of `k[x_1, …, x_n]` is prime
and all of its positive powers are primary. -/
theorem solution (n i : ℕ) (_hi1 : 1 ≤ i) (_hin : i ≤ n) :
    (p (k := k) n i).IsPrime ∧ ∀ r : ℕ, 0 < r → ((p (k := k) n i) ^ r).IsPrimary :=
  ⟨isPrime_p n i, fun _ hr => isPrimary_p_pow n i _ hr.ne'⟩

/-- The literal statement "every power of `p n i` is primary" is false for the zeroth power:
`p n i ^ 0 = ⊤` is the unit ideal, and primary ideals are proper.  This is why
`isPrimary_p_pow` assumes `r ≠ 0` (and the book says "positive powers"). -/
theorem isPrimary_p_zero_not (n i : ℕ) : ¬ ((p (k := k) n i) ^ 0).IsPrimary := by
  intro h
  have htop : (p (k := k) n i) ^ 0 = ⊤ := by simp
  exact h.ne_top htop

end Main

end AtiyahMcdonald69.Ex_4_8

#print axioms AtiyahMcdonald69.Ex_4_8.isPrime_p
#print axioms AtiyahMcdonald69.Ex_4_8.isPrimary_p_pow
#print axioms AtiyahMcdonald69.Ex_4_8.isPrimary_p_pow_am
#print axioms AtiyahMcdonald69.Ex_4_8.radical_p_pow
#print axioms AtiyahMcdonald69.Ex_4_8.isPrimary_p_zero_not
#print axioms AtiyahMcdonald69.Ex_4_8.solution
