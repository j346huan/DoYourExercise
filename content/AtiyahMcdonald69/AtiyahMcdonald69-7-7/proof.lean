/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969),
Chapter 7 ("Noetherian Rings"), Exercise 7.

Reference solution page (statement and natural-language proof):
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-7

Book statement (Chapter 7, Exercises, no. 7):

  "Let X be an affine algebraic variety given by a family of equations
   f_α(t₁, …, tₙ) = 0 (α ∈ I) (Chapter 1, Exercise 27). Show that there exists a
   finite subset I₀ of I such that X is given by the equations
   f_α(t₁, …, tₙ) = 0 for α ∈ I₀."

Conventions fixed by Chapter 1, Exercise 27: k is an algebraically closed field,
the f_α are polynomials in k[t₁, …, tₙ], and X ⊆ kⁿ is the set of common zeros
of the f_α.  Here `MvPolynomial (Fin n) k` is k[t₁, …, tₙ] and X is modelled by
the family of equations itself, `variety f = {x | ∀ α, f_α(x) = 0}`; "X is given
by the equations f_α = 0 for α ∈ I₀" is the assertion that the same set is cut
out by the subfamily, i.e. `variety f = variety (f ∘ inclusion)`.

Proof sketch (the one used below): k[t₁, …, tₙ] is Noetherian by Hilbert's basis
theorem, so the ideal generated by the family is generated by finitely many
polynomials; each of these involves only finitely many members of the family, and
collecting those indices gives the finite I₀.  The common zero set of a family
equals the common zero set of the ideal it generates, so passing to the finite
subfamily does not change X.  Algebraic closedness of k is never used: the
argument goes through for any field, and in fact for any Noetherian commutative
ring (see `exists_finset_span_image_eq`).

Source audit.  The scan text available in this workspace
(`.scratch/reference/atiyah-macdonald-original.txt`) breaks off inside Chapter 6
(at Proposition 6.11) and contains no Chapter 7 text, so the statement quoted
above was read from a complete copy of the 1969 Addison-Wesley text
(http://math.univ-lyon1.fr/~mathieu/CoursM2-2020/AMD-ComAlg.pdf), Chapter 7,
Exercises, page 84; the excerpt used is `book-ch1ex27-and-ch7ex.txt` next to this
file, which also records Chapter 1, Exercise 27.  No hypothesis is missing from
the exercise and none of the stated hypotheses (in particular algebraic
closedness of k) is actually needed for the argument, which is why the field
hypothesis alone is treated below as well.  The natural-language proof on the
reference page — the ideal generated by the f_α is finitely generated, finitely
many generators involve finitely many f_α, and the common zero set of that
subfamily equals that of the whole ideal — is correct and needs no correction;
it is the same argument formalized below.
-/
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.PrincipalIdealDomain

namespace AtiyahMcdonald69.Ex_7_7

open MvPolynomial

/-- The general commutative-algebra core of the exercise: for a family `f` in a
Noetherian ring `R`, the ideal generated by the family is generated by a finite
subfamily.  Noetherianity gives a finite set `s` of generators of
`Ideal.span (Set.range f)`; each element of `s` lies in the span of the whole
family, hence in the span of a finite subfamily of it
(`Submodule.mem_span_finite_of_mem_span`, packaged as
`Submodule.fg_span_iff_fg_span_finset_subset`), and the union of those finitely
many finite subfamilies is a finite subfamily spanning the same ideal. -/
theorem exists_finset_span_image_eq {R : Type*} [CommRing R] [IsNoetherianRing R]
    {ι : Type*} (f : ι → R) :
    ∃ I₀ : Finset ι, Ideal.span (f '' (I₀ : Set ι)) = Ideal.span (Set.range f) := by
  classical
  obtain ⟨s, hsub, hspan⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset (Set.range f)).mp
      (IsNoetherian.noetherian (Ideal.span (Set.range f)))
  -- For each generator `y ∈ s` choose an index `g y` with `f (g y) = y`.
  let g : ↥(s : Set R) → ι := fun y => Classical.choose (hsub y.2)
  have hg : ∀ y : ↥(s : Set R), f (g y) = (y : R) := fun y => Classical.choose_spec (hsub y.2)
  refine ⟨s.attach.image g, ?_⟩
  have himage : f '' ((s.attach.image g : Finset ι) : Set ι) = (s : Set R) := by
    apply Set.Subset.antisymm
    · rintro y ⟨a, ha, rfl⟩
      obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp ha
      exact (hg y).symm ▸ y.2
    · intro y hy
      exact ⟨g ⟨y, hy⟩, Finset.mem_image.mpr ⟨⟨y, hy⟩, Finset.mem_attach _ _, rfl⟩,
        hg ⟨y, hy⟩⟩
  rw [himage]
  exact hspan.symm

variable {k : Type*} {n : ℕ} {ι : Type*}

/-- The affine algebraic variety cut out by a family of polynomial equations
`f_α(t₁, …, tₙ) = 0` (Chapter 1, Exercise 27): the set of points
`x : Fin n → k` at which every polynomial of the family vanishes. -/
def variety [CommSemiring k] (f : ι → MvPolynomial (Fin n) k) : Set (Fin n → k) :=
  {x | ∀ a, MvPolynomial.eval x (f a) = 0}

variable [Field k]

/-- **Atiyah–Macdonald, Exercise 7.7.**  If an affine algebraic variety `X` is
given by a family of polynomial equations `f_α = 0` (α ∈ I), then `X` is already
given by a finite subfamily: there is a finite set `I₀` of indices such that a
point satisfies all the equations `(α ∈ I)` if and only if it satisfies the
equations indexed by `I₀`. -/
theorem solution [IsAlgClosed k] (f : ι → MvPolynomial (Fin n) k) :
    ∃ I₀ : Finset ι, ∀ x : Fin n → k,
      (∀ a : ι, MvPolynomial.eval x (f a) = 0) ↔ (∀ a ∈ I₀, MvPolynomial.eval x (f a) = 0) := by
  classical
  obtain ⟨I₀, hI₀⟩ := exists_finset_span_image_eq f
  refine ⟨I₀, fun x => ⟨fun h a _ => h a, fun h a => ?_⟩⟩
  -- The point `x` kills every member of the finite subfamily, hence it kills the
  -- whole ideal they generate, which by `hI₀` is the ideal the full family generates.
  have hker : Ideal.span (f '' (I₀ : Set ι)) ≤ RingHom.ker (MvPolynomial.eval x) := by
    rw [Ideal.span_le]
    rintro p ⟨a, ha, rfl⟩
    exact RingHom.mem_ker.mpr (h a ha)
  have hmem : f a ∈ Ideal.span (f '' (I₀ : Set ι)) := by
    rw [hI₀]
    exact Ideal.subset_span ⟨a, rfl⟩
  exact RingHom.mem_ker.mp (hker hmem)

/-- Exercise 7.7 in the form in which the book states it: "X is given by the
equations f_α = 0 for α ∈ I₀", i.e. the subfamily cuts out the same variety. -/
theorem solution_variety [IsAlgClosed k] (f : ι → MvPolynomial (Fin n) k) :
    ∃ I₀ : Finset ι, variety f = variety (fun a : ↥I₀ => f a.1) := by
  obtain ⟨I₀, hI₀⟩ := solution f
  refine ⟨I₀, ?_⟩
  ext x
  simp only [variety, Set.mem_ofPred_eq]
  exact ⟨fun h a => h a.1, fun h => (hI₀ x).mpr fun a ha => h ⟨a, ha⟩⟩

/-- Exercise 7.7 verbatim, in the form "let `X` be a variety given by a family of
equations": if `X` is the common zero set of the family `f`, then it is also the
common zero set of a finite subfamily. -/
theorem solution_of_eq_variety [IsAlgClosed k] (X : Set (Fin n → k))
    (f : ι → MvPolynomial (Fin n) k) (hX : X = variety f) :
    ∃ I₀ : Finset ι, X = variety (fun a : ↥I₀ => f a.1) := by
  obtain ⟨I₀, h⟩ := solution_variety f
  exact ⟨I₀, hX.trans h⟩

/-- The same statement, with the algebraic closedness of `k` (a hypothesis
inherited from Chapter 1, Exercise 27) dropped: the argument only needs `k` to be
a field, so that `k[t₁, …, tₙ]` is Noetherian. -/
theorem solution_of_field (f : ι → MvPolynomial (Fin n) k) :
    ∃ I₀ : Finset ι, variety f = variety (fun a : ↥I₀ => f a.1) := by
  classical
  obtain ⟨I₀, hI₀⟩ := exists_finset_span_image_eq f
  refine ⟨I₀, ?_⟩
  ext x
  simp only [variety, Set.mem_ofPred_eq]
  constructor
  · intro h a
    exact h a.1
  · intro h a
    have hker : Ideal.span (f '' (I₀ : Set ι)) ≤ RingHom.ker (MvPolynomial.eval x) := by
      rw [Ideal.span_le]
      rintro p ⟨b, hb, rfl⟩
      exact RingHom.mem_ker.mpr (h ⟨b, hb⟩)
    have hmem : f a ∈ Ideal.span (f '' (I₀ : Set ι)) := by
      rw [hI₀]
      exact Ideal.subset_span ⟨a, rfl⟩
    exact RingHom.mem_ker.mp (hker hmem)

end AtiyahMcdonald69.Ex_7_7
