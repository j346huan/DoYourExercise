import Mathlib

/-!
# Atiyah--Macdonald, Exercise 10.11

The exercise (Chapter 10, exercise 11 of *Introduction to Commutative Algebra*) asks:

*Show that there is a non-Noetherian local ring `(A, 𝔪)` and an ideal `𝔞 ⊆ A` such that the
`𝔞`-adic completion `Â` is Noetherian. Show that one can even arrange things so that `Â` is a
finitely generated `A`-module.*

Statements: `part_a` (first sentence) and `part_b` (the stronger form including finite
generation), proved from the single example `solution`, which additionally shows that `𝔞` may be
taken to be the maximal ideal `𝔪` itself (as in the reference solution, where `𝔞 = 𝔪`).

## The example

Let `k = ℚ`, let `P = ℚ_{≥0}` be the (additive) monoid of non-negative rationals and let
`A₀ = k[x^a : a ∈ P] = AddMonoidAlgebra ℚ P` be the monoid algebra of `P`; write `x^a` for
`single a 1`. Let `𝔪₀ ⊆ A₀` be the ideal generated by the monomials `x^a` with `a ≠ 0`; it is the
kernel of the ring homomorphism `ε : A₀ → ℚ` taking the coefficient of `x^0`, hence maximal with
`A₀/𝔪₀ ≅ ℚ`. Since `x^a = x^(a/2) · x^(a/2)`, `𝔪₀` is idempotent. Let
`A = (A₀)_{𝔪₀}` be the localisation of `A₀` at `𝔪₀` and `𝔞 = 𝔪₀ A` its maximal ideal.

* `𝔞` is idempotent, so the `𝔞`-adic completion of `A` is `A/𝔞` (`adicCompletionEquivQuotient`,
  an instance of the general lemma for idempotent ideals).
* `A/𝔞 ≅ A₀/𝔪₀ ≅ ℚ`, which is Noetherian; hence `Â` is Noetherian and even a cyclic `A`-module.
* `𝔞` is idempotent and nonzero; if `A` were Noetherian, `𝔞` would be finitely generated and
  Nakayama's lemma would force `𝔞 = 0`, a contradiction. So `A` is not Noetherian.

This is a variant of the reference solution (which uses the trivial extension
`ℚ[[t]] ⊕ ℚ((t))/ℚ[[t]]`, where the maximal ideal `tR ⊕ E` is idempotent for the same reason:
`t E = E`, so `𝔪 I = I`); the localisation of a monoid algebra at a maximal ideal with idempotent
extension plays the role of that trivial extension. (Verifying the reference construction inside
Lean would in addition need "the adic completion of a Noetherian ring is Noetherian", which the
current Mathlib does not have; no such result is required here, and the exercise, being an
existence statement, is proved in full.) Both parts of the exercise are established.

Reference solution: https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-10-11

No `sorry`, no custom axioms; only the standard axioms (`propext`, `Classical.choice`,
`Quot.sound`) are used, see the `#print axioms` commands at the end.
-/

namespace AtiyahMcdonald69.Ex_10_11

open Ideal
open scoped Pointwise


section AdicIdem

variable {R : Type*} [CommRing R] {I : Ideal R}

/-- Powers of an idempotent ideal are itself. -/
lemma pow_succ_eq_self_of_mul_self (h : I * I = I) (n : ℕ) : I ^ (n + 1) = I := by
  induction n with
  | zero => simp
  | succ k ih => rw [pow_succ, ih, h]

/-- Powers of an idempotent ideal are itself. -/
lemma pow_eq_self_of_mul_self (h : I * I = I) {n : ℕ} (hn : 0 < n) : I ^ n = I := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact pow_succ_eq_self_of_mul_self h m

/-- A ring is `I`-adically precomplete when `I` is idempotent: every Cauchy sequence
converges against its first term. -/
lemma isPrecomplete_of_mul_self_eq (h : I * I = I) : IsPrecomplete I R := by
  refine ⟨fun f hf => ⟨f 1, ?_⟩⟩
  intro n
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn; simp
  · have h1 : I ^ n = I ^ 1 := by rw [pow_one, pow_eq_self_of_mul_self h hn]
    have h2 : f n ≡ f 1 [SMOD (I ^ 1 • ⊤ : Submodule R R)] := (hf hn).symm
    simpa [h1] using h2

/-- If `I` is idempotent, the canonical map to the `I`-adic completion is surjective. -/
lemma of_surjective_of_mul_self_eq (h : I * I = I) :
    Function.Surjective (AdicCompletion.of I R) :=
  AdicCompletion.of_surjective_iff.mpr (isPrecomplete_of_mul_self_eq h)

/-- Characterisation of the kernel of the canonical map into the completion, componentwise. -/
lemma of_eq_zero_iff (x : R) :
    AdicCompletion.of I R x = 0 ↔ ∀ n : ℕ, x ∈ (I ^ n • ⊤ : Submodule R R) := by
  constructor
  · intro hx n
    have h2 : ((AdicCompletion.of I R x).val n) = 0 := by rw [hx]; rfl
    rw [AdicCompletion.of_apply, Submodule.mkQ_apply] at h2
    exact (Submodule.Quotient.mk_eq_zero _).mp h2
  · intro hx
    refine AdicCompletion.ext (fun n => ?_)
    rw [AdicCompletion.val_zero_apply, AdicCompletion.of_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact hx n

/-- The kernel of `R → AdicCompletion I R` is `I` when `I` is idempotent. -/
lemma ker_algebraMap_eq (h : I * I = I) :
    RingHom.ker (algebraMap R (AdicCompletion I R)) = I := by
  ext x
  rw [RingHom.mem_ker, show algebraMap R (AdicCompletion I R) x = AdicCompletion.of I R x from by
    simpa using AdicCompletion.algebraMap_apply (I := I) (S := R) x]
  rw [of_eq_zero_iff]
  constructor
  · intro hx
    have := hx 1
    simpa [pow_one] using this
  · intro hx n
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn; simp
    · rw [pow_eq_self_of_mul_self h hn]
      simpa using hx

/-- The `I`-adic completion of `R` at an idempotent ideal `I` is the quotient `R ⧸ I`. -/
noncomputable def adicCompletionEquivQuotient (h : I * I = I) :
    AdicCompletion I R ≃+* (R ⧸ I) :=
  (RingHom.quotientKerEquivOfSurjective (of_surjective_of_mul_self_eq h)).symm.trans
    (Ideal.quotientEquivAlgOfEq R (ker_algebraMap_eq h)).toRingEquiv

/-- The adic completion at an idempotent ideal is Noetherian if the quotient is. -/
lemma isNoetherianRing_adicCompletion (h : I * I = I) [IsNoetherianRing (R ⧸ I)] :
    IsNoetherianRing (AdicCompletion I R) :=
  isNoetherianRing_of_ringEquiv (R ⧸ I) (adicCompletionEquivQuotient h).symm

/-- The adic completion at an idempotent ideal is a cyclic module. -/
lemma moduleFinite_adicCompletion (h : I * I = I) : Module.Finite R (AdicCompletion I R) := by
  rw [Module.finite_def, Submodule.fg_def]
  refine ⟨{AdicCompletion.of I R 1}, Set.finite_singleton _, ?_⟩
  rw [eq_top_iff]
  intro y _
  obtain ⟨x, rfl⟩ := of_surjective_of_mul_self_eq h y
  have hxy : AdicCompletion.of I R x = x • AdicCompletion.of I R 1 := by
    rw [← map_smul, smul_eq_mul, mul_one]
  rw [hxy]
  exact Submodule.smul_mem _ x (Submodule.subset_span (Set.mem_singleton _))

end AdicIdem


noncomputable section

/-- The exponent monoid. -/
abbrev P : Type := ℚ≥0

/-- The monoid algebra `ℚ[x^a : a ∈ ℚ_{≥0}]`; `single a c` is `c x^a`. -/
abbrev A₀ : Type := AddMonoidAlgebra ℚ P

/-- The multiplicative monoid hom `ℚ_{≥0} → ℚ` that is `1` at `0` and `0` elsewhere. -/
def phi : Multiplicative P →* ℚ where
  toFun a := if a.toAdd = 0 then 1 else 0
  map_one' := by simp
  map_mul' a b := by
    have hab : (a * b).toAdd = a.toAdd + b.toAdd := rfl
    rw [hab]
    by_cases ha : a.toAdd = 0
    · by_cases hb : b.toAdd = 0
      · simp [ha, hb]
      · simp [ha, hb]
    · have h : a.toAdd + b.toAdd ≠ 0 := by
        intro h
        have h1 : a.toAdd ≤ a.toAdd + b.toAdd := le_self_add
        rw [h] at h1
        exact ha (le_antisymm h1 zero_le)
      simp [ha, h]

/-- The `ℚ`-algebra map `ℚ[x^a] → ℚ` sending `x^0 ↦ 1` and `x^a ↦ 0` for `a ≠ 0`. -/
def epsAlg : A₀ →ₐ[ℚ] ℚ := (AddMonoidAlgebra.lift ℚ ℚ P) phi

/-- The coefficient-of-`x^0` ring homomorphism. -/
def eps : A₀ →+* ℚ := epsAlg.toRingHom

lemma eps_single (a : P) (c : ℚ) : eps (AddMonoidAlgebra.single a c) = if a = 0 then c else 0 := by
  have h : eps (AddMonoidAlgebra.single a c) = c • phi (Multiplicative.ofAdd a) :=
    AddMonoidAlgebra.lift_single phi a c
  rw [h]
  by_cases ha : a = 0
  · simp [phi, ha]
  · simp [phi, ha]

lemma eps_surjective : Function.Surjective eps :=
  fun c => ⟨AddMonoidAlgebra.single 0 c, by rw [eps_single]; simp⟩

/-- The maximal ideal: all elements with zero constant coefficient. -/
def mm : Ideal A₀ := RingHom.ker eps

/-- The set of monomials with nonzero exponent. -/
def S : Set A₀ := Set.range (fun a : {a : P // a ≠ 0} => (AddMonoidAlgebra.single a.1 1 : A₀))

lemma single_mem_mm {a : P} (ha : a ≠ 0) : (AddMonoidAlgebra.single a 1 : A₀) ∈ mm := by
  rw [mm, RingHom.mem_ker, eps_single]
  simp [ha]

lemma span_le_mm : Ideal.span S ≤ mm := by
  rw [Ideal.span_le]
  rintro _ ⟨⟨a, ha⟩, rfl⟩
  exact single_mem_mm ha

lemma single_eq_mul (a : P) (b : ℚ) :
    (AddMonoidAlgebra.single a b : A₀) = AddMonoidAlgebra.single a 1 * AddMonoidAlgebra.single 0 b := by
  rw [AddMonoidAlgebra.single_mul_single, add_zero, one_mul]

lemma sub_single_zero_mem_span_aux : ∀ q : P →₀ ℚ,
    AddMonoidAlgebra.ofCoeff q - AddMonoidAlgebra.single 0 (q 0) ∈ Ideal.span S := by
  intro q
  induction q using Finsupp.induction with
  | zero => simp
  | single_add a b g ha_supp hb ih =>
      have key : AddMonoidAlgebra.ofCoeff ((Finsupp.single a b : P →₀ ℚ) + g) -
          AddMonoidAlgebra.single 0 (((Finsupp.single a b : P →₀ ℚ) + g) 0) ∈ Ideal.span S := by
        by_cases ha : a = 0
        · subst ha
          have h1 : ((Finsupp.single (0 : P) b : P →₀ ℚ) + g) 0 = b + g 0 := by
            rw [Finsupp.add_apply, Finsupp.single_eq_same]
          rw [h1, AddMonoidAlgebra.ofCoeff_add, AddMonoidAlgebra.ofCoeff_single]
          have hsingle : AddMonoidAlgebra.single (0 : P) (b + g 0) =
              AddMonoidAlgebra.single 0 b + AddMonoidAlgebra.single (0 : P) (g 0) := by
            rw [← AddMonoidAlgebra.coeff_inj, AddMonoidAlgebra.coeff_add,
              AddMonoidAlgebra.coeff_single, AddMonoidAlgebra.coeff_single,
              AddMonoidAlgebra.coeff_single, Finsupp.single_add]
          rw [hsingle]
          have heq : AddMonoidAlgebra.single (0 : P) b + AddMonoidAlgebra.ofCoeff g -
              (AddMonoidAlgebra.single 0 b + AddMonoidAlgebra.single (0 : P) (g 0)) =
              AddMonoidAlgebra.ofCoeff g - AddMonoidAlgebra.single 0 (g 0) := by abel
          rw [heq]
          exact ih
        · have h1 : ((Finsupp.single a b : P →₀ ℚ) + g) 0 = g 0 := by
            rw [Finsupp.add_apply, Finsupp.single_eq_of_ne (Ne.symm ha), zero_add]
          rw [h1, AddMonoidAlgebra.ofCoeff_add, AddMonoidAlgebra.ofCoeff_single]
          rw [show AddMonoidAlgebra.single a b + AddMonoidAlgebra.ofCoeff g -
            AddMonoidAlgebra.single (0 : P) (g 0) =
            AddMonoidAlgebra.single a b + (AddMonoidAlgebra.ofCoeff g -
              AddMonoidAlgebra.single 0 (g 0)) from by abel]
          refine add_mem ?_ ih
          rw [single_eq_mul]
          exact Ideal.mul_mem_right _ _
            (Ideal.subset_span (Set.mem_range_self
              (f := fun x : {x : P // x ≠ 0} => (AddMonoidAlgebra.single x.1 1 : A₀)) ⟨a, ha⟩))
      simpa using key

lemma sub_single_zero_mem_span (f : A₀) :
    f - AddMonoidAlgebra.single 0 (f.coeff 0) ∈ Ideal.span S := by
  have h := sub_single_zero_mem_span_aux f.coeff
  simpa [AddMonoidAlgebra.ofCoeff_coeff] using h

lemma eps_eq_coeff_zero (f : A₀) : eps f = f.coeff 0 := by
  have h1 : f - AddMonoidAlgebra.single 0 (f.coeff 0) ∈ mm :=
    span_le_mm (sub_single_zero_mem_span f)
  have h2 : eps (f - AddMonoidAlgebra.single 0 (f.coeff 0)) = 0 := h1
  have h3 : eps (AddMonoidAlgebra.single 0 (f.coeff 0)) = f.coeff 0 := by
    rw [eps_single]; simp
  have h4 : AddMonoidAlgebra.single 0 (f.coeff 0) +
      (f - AddMonoidAlgebra.single 0 (f.coeff 0)) = f := by abel
  calc eps f = eps (AddMonoidAlgebra.single 0 (f.coeff 0) +
        (f - AddMonoidAlgebra.single 0 (f.coeff 0))) := by rw [h4]
    _ = eps (AddMonoidAlgebra.single 0 (f.coeff 0)) +
        eps (f - AddMonoidAlgebra.single 0 (f.coeff 0)) := map_add eps _ _
    _ = f.coeff 0 := by rw [h3, h2, add_zero]

lemma mm_le_span : mm ≤ Ideal.span S := by
  intro f hf
  have h0 : f.coeff 0 = 0 := by rw [← eps_eq_coeff_zero f]; exact hf
  have h := sub_single_zero_mem_span f
  rw [h0, AddMonoidAlgebra.single_zero] at h
  simpa using h

lemma mm_eq_span : mm = Ideal.span S := le_antisymm mm_le_span span_le_mm

lemma mem_S_iff {x : A₀} : x ∈ S ↔ ∃ a : P, a ≠ 0 ∧ x = AddMonoidAlgebra.single a 1 := by
  simp [S, eq_comm]

lemma S_mul_S : S * S = S := by
  ext x
  constructor
  · rintro ⟨y, hy, z, hz, rfl⟩
    obtain ⟨a, ha, rfl⟩ := mem_S_iff.mp hy
    obtain ⟨b, hb, rfl⟩ := mem_S_iff.mp hz
    rw [mem_S_iff]
    refine ⟨a + b, ?_, ?_⟩
    · intro h
      have h1 : a ≤ a + b := le_self_add
      rw [h] at h1
      exact ha (le_antisymm h1 zero_le)
    · simp [AddMonoidAlgebra.single_mul_single]
  · intro hx
    obtain ⟨a, ha, rfl⟩ := mem_S_iff.mp hx
    have ha2 : a / 2 ≠ 0 := by
      intro h
      apply ha
      have h2 : a / 2 + a / 2 = a := add_halves a
      rw [← h2, h]
      simp
    have hmem : (AddMonoidAlgebra.single (a / 2) 1 : A₀) ∈ S :=
      mem_S_iff.mpr ⟨a / 2, ha2, rfl⟩
    have h := Set.mul_mem_mul hmem hmem
    rwa [AddMonoidAlgebra.single_mul_single, one_mul, add_halves] at h

lemma mm_mul_mm : mm * mm = mm := by
  rw [mm_eq_span, Ideal.span_mul_span, S_mul_S]

lemma mm_ne_top : mm ≠ ⊤ := by
  intro h
  have h1 : (1 : A₀) ∈ mm := h ▸ Submodule.mem_top
  rw [mm, RingHom.mem_ker, map_one] at h1
  exact one_ne_zero h1

lemma mm_isMaximal : mm.IsMaximal :=
  RingHom.ker_isMaximal_of_surjective eps eps_surjective

/-! ### Localising at the maximal ideal -/

instance mmIsPrime : mm.IsPrime := mm_isMaximal.isPrime

/-- The local ring `ℚ[x^a : a ∈ ℚ_{≥0}]` localised at the ideal of elements of positive
`x`-adic order. -/
abbrev A : Type := Localization.AtPrime mm

/-- The maximal ideal of `A`, i.e. the extension of `mm`. -/
def Am : Ideal A := Ideal.map (algebraMap A₀ A) mm

lemma Am_eq_maximalIdeal : Am = IsLocalRing.maximalIdeal A :=
  Localization.AtPrime.map_eq_maximalIdeal (I := mm)

lemma Am_isMaximal : Am.IsMaximal := by
  rw [Am_eq_maximalIdeal]
  exact IsLocalRing.maximalIdeal.isMaximal A

lemma Am_mul_Am : Am * Am = Am := by
  rw [Am, ← Ideal.map_mul, mm_mul_mm]

lemma algebraMap_injective : Function.Injective (algebraMap A₀ A) := by
  refine IsLocalization.injective (M := mm.primeCompl) A ?_
  intro x hx
  rw [mem_nonZeroDivisors_iff_ne_zero]
  intro h
  exact hx (h ▸ Ideal.zero_mem mm)

lemma algebraMap_single_one_ne_zero :
    algebraMap A₀ A (AddMonoidAlgebra.single 1 1) ≠ 0 := by
  intro h
  have h1 : AddMonoidAlgebra.single (1 : P) (1 : ℚ) = 0 :=
    algebraMap_injective (by rw [h, map_zero])
  have h2 : (Finsupp.single (1 : P) (1 : ℚ)) = 0 := by
    rw [← AddMonoidAlgebra.coeff_single, h1, AddMonoidAlgebra.coeff_zero]
  rw [Finsupp.single_eq_zero] at h2
  exact one_ne_zero h2

lemma Am_ne_bot : Am ≠ ⊥ := by
  intro h
  have hmem : algebraMap A₀ A (AddMonoidAlgebra.single 1 1) ∈ Am :=
    Ideal.mem_map_of_mem _ (single_mem_mm one_ne_zero)
  rw [h] at hmem
  simp only [Submodule.mem_bot] at hmem
  exact algebraMap_single_one_ne_zero hmem

/-- The residue map `A → ℚ`, i.e. `eps` transported through the localisation. -/
def epsBar : A →+* ℚ :=
  IsLocalization.lift (M := mm.primeCompl) (S := A) (g := eps) (fun y => by
    rw [isUnit_iff_ne_zero]
    intro h
    exact y.2 (show eps (y : A₀) = 0 from h))

lemma epsBar_algebraMap (x : A₀) : epsBar (algebraMap A₀ A x) = eps x :=
  IsLocalization.lift_eq (M := mm.primeCompl) (S := A) _ x

lemma epsBar_surjective : Function.Surjective epsBar := by
  intro c
  obtain ⟨x, hx⟩ := eps_surjective c
  exact ⟨algebraMap A₀ A x, by rw [epsBar_algebraMap]; exact hx⟩


/-! ### The completion of `A` at `Am` -/

lemma Am_le_ker_epsBar : Am ≤ RingHom.ker epsBar := by
  rw [Am, Ideal.map_le_iff_le_comap]
  intro x hx
  rw [Ideal.mem_comap, RingHom.mem_ker, epsBar_algebraMap]
  exact hx

lemma ker_epsBar_ne_top : RingHom.ker epsBar ≠ ⊤ := by
  intro h
  have h1 : (1 : A) ∈ RingHom.ker epsBar := h ▸ Submodule.mem_top
  rw [RingHom.mem_ker, map_one] at h1
  exact one_ne_zero h1

lemma ker_epsBar : RingHom.ker epsBar = Am :=
  (Am_isMaximal.eq_of_le ker_epsBar_ne_top Am_le_ker_epsBar).symm

/-- The residue field of `A` is `ℚ`. -/
def quotientEquivRat : (A ⧸ Am) ≃+* ℚ :=
  (Ideal.quotEquivOfEq ker_epsBar).symm.trans
    (RingHom.quotientKerEquivOfSurjective epsBar_surjective)

lemma isNoetherianRing_quotient : IsNoetherianRing (A ⧸ Am) :=
  isNoetherianRing_of_ringEquiv ℚ quotientEquivRat.symm

/-- `A` itself is not Noetherian: its maximal ideal is idempotent and nonzero, so it cannot be
finitely generated. -/
theorem not_isNoetherianRing_A : ¬ IsNoetherianRing A := by
  intro h
  have hfg : Am.FG := Ideal.fg_of_isNoetherianRing Am
  have hle : Am ≤ Am • Am := by
    rw [Ideal.smul_eq_mul, Am_mul_Am]
  have hjac : Am ≤ Ideal.jacobson ⊥ := by
    rw [Am_eq_maximalIdeal]
    exact IsLocalRing.maximalIdeal_le_jacobson ⊥
  have hbot : Am = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot Am Am hfg hle hjac
  exact Am_ne_bot hbot

/-- The `Am`-adic completion of `A` is Noetherian (it is the residue field `ℚ`). -/
theorem completion_noetherian : IsNoetherianRing (AdicCompletion Am A) :=
  @isNoetherianRing_adicCompletion A _ Am Am_mul_Am isNoetherianRing_quotient

/-- The `Am`-adic completion of `A` is the residue field `ℚ`. -/
def completionEquivRat : AdicCompletion Am A ≃+* ℚ :=
  (adicCompletionEquivQuotient Am_mul_Am).trans quotientEquivRat

/-- The `Am`-adic completion of `A` is even a finitely generated (indeed cyclic) `A`-module. -/
theorem completion_finite : Module.Finite A (AdicCompletion Am A) :=
  moduleFinite_adicCompletion Am_mul_Am

/-! ### The exercise -/

/-- Atiyah--Macdonald, Exercise 10.11, first sentence: there is a non-Noetherian local ring
whose `𝔞`-adic completion is Noetherian for some ideal `𝔞`. -/
theorem part_a : ∃ (A' : Type) (_ : CommRing A') (_ : IsLocalRing A') (𝔞 : Ideal A'),
    ¬ IsNoetherianRing A' ∧ IsNoetherianRing (AdicCompletion 𝔞 A') :=
  ⟨A, inferInstance, inferInstance, Am, not_isNoetherianRing_A, completion_noetherian⟩

/-- Atiyah--Macdonald, Exercise 10.11, second sentence: the completion can even be arranged to be
a finitely generated `A`-module. -/
theorem part_b : ∃ (A' : Type) (_ : CommRing A') (_ : IsLocalRing A') (𝔞 : Ideal A'),
    ¬ IsNoetherianRing A' ∧ IsNoetherianRing (AdicCompletion 𝔞 A') ∧
      Module.Finite A' (AdicCompletion 𝔞 A') :=
  ⟨A, inferInstance, inferInstance, Am, not_isNoetherianRing_A, completion_noetherian,
    completion_finite⟩

lemma Am_ne_top : Am ≠ ⊤ := Am_isMaximal.ne_top

/-- Both parts of the exercise at once, with the additional information that `𝔞` can be taken to
be the maximal ideal (as in the reference solution), so that in particular `𝔞` is a proper
ideal. -/
theorem solution : ∃ (A' : Type) (_ : CommRing A') (_ : IsLocalRing A') (𝔞 : Ideal A'),
    𝔞 = IsLocalRing.maximalIdeal A' ∧ 𝔞 ≠ ⊤ ∧ ¬ IsNoetherianRing A' ∧
      IsNoetherianRing (AdicCompletion 𝔞 A') ∧ Module.Finite A' (AdicCompletion 𝔞 A') :=
  ⟨A, inferInstance, inferInstance, Am, Am_eq_maximalIdeal, Am_ne_top, not_isNoetherianRing_A,
    completion_noetherian, completion_finite⟩

#print axioms part_a
#print axioms part_b
#print axioms solution
#print axioms not_isNoetherianRing_A
#print axioms completion_noetherian
#print axioms completion_finite
#print axioms completionEquivRat
#print axioms adicCompletionEquivQuotient

end

end AtiyahMcdonald69.Ex_10_11
