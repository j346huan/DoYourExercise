import Mathlib

/- The style linter below insists that a `haveI`/`letI` whose value is a proposition be written
as `have`/`let`.  Here the local instances (`Field A`, `P.IsPrime`,
`IsDiscreteValuationRing (Localization.AtPrime P)`) are genuine typeclass instances that the
elaborator must use for instance synthesis, which plain `have` would not provide. -/
set_option linter.style.haveILetI false

/-!
# Atiyah–Macdonald (1969), Exercise 9.2 — content is multiplicative over a Dedekind domain

## The exercise

Let `A` be a Dedekind domain and let `f, g ∈ A[X]`.  The *content* of `h ∈ A[X]` is
the ideal `c(h)` of `A` generated by the coefficients of `h`.  Then

  `c(f * g) = c(f) * c(g)`.

(This is Chapter 9, *Discrete Valuation Rings and Dedekind Domains*; the equality is
the content formula used, e.g., to prove that `A[X]` is a GCD domain.)

## Statement coverage

The formalised statement is `solution` below:

* `[CommRing A] [IsDedekindDomain A]`, `f g : A[X]`,
  conclusion `(f * g).contentIdeal = f.contentIdeal * g.contentIdeal`,

where `Polynomial.contentIdeal h` is Mathlib's ideal generated by the coefficients
of `h`, i.e. `Polynomial.contentIdeal_def : h.contentIdeal = Ideal.span ↑h.coeffs`
(so `contentIdeal` *is* the book's `c(h)`).  The variant `solution_span_coeffs`
spells the same equality out without the definition.  All quantifiers of the
exercise are preserved; nothing is weakened and no hypothesis is added.  Zero
polynomials are included (both sides are then `⊥`), so the statement is a
fortiori the version for non-zero `f`, `g`.

`IsDedekindDomain` is Mathlib's standard notion (Noetherian, integrally closed,
Krull dimension ≤ 1); the proof shows in fact that every maximal ideal either is
`⊥` (the field case) or has DVR localisation, so both common readings of
"Dedekind domain" (fields allowed or not) are covered.

## Approach (the informal proof, formalised)

* `c(f)·c(g) ≤ c(fg)` holds over any ring: each coefficient of `fg` is a sum of
  products (`Polynomial.contentIdeal_mul_le_mul_contentIdeal`).
* For the converse, localise at every maximal ideal `P`
  (`Ideal.eq_of_localization_maximal`) and use
  `Polynomial.contentIdeal_map_eq_map_contentIdeal` to transport contents.
  – If `A` is a field, a non-zero polynomial has content `⊤`, done.
  – Otherwise `P ≠ ⊥` and `A_P` is a discrete valuation ring
    (`IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain`).
    In a DVR, a coefficient of minimal valuation `a` (from the additive valuation
    `IsDiscreteValuationRing.addVal`) divides all coefficients, so `f = a·F` with
    `c(f) = (a)` and `F` having a unit coefficient (`1`); likewise `g = b·G`.
    Modulo the maximal ideal, `F` and `G` are non-zero polynomials over the
    residue field, so `F·G` has a unit coefficient (Gauss' lemma
    `Polynomial.contentIdeal_mul_eq_top_of_contentIdeal_eq_top` together with
    `exists_isUnit_coeff_of_contentIdeal_eq_top`), whence
    `c(fg) = (a·b) = (a)(b) = c(f)c(g)`.

## Informal source

https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-9-2

## Adaptations

None in content.  The only notational choice is to use Mathlib's
`Polynomial.contentIdeal` for the book's content ideal `c(h)`.
-/

namespace AtiyahMcdonald69.Ex_9_2

open Polynomial

/-! ## Content of polynomials with a unit coefficient -/

section UnitCoeff

variable {R : Type*} [Semiring R] {p : R[X]}

/-- A polynomial with a unit coefficient has content the unit ideal. -/
theorem contentIdeal_eq_top_of_isUnit_coeff (h : ∃ n, IsUnit (p.coeff n)) :
    p.contentIdeal = ⊤ := by
  obtain ⟨n, hn⟩ := h
  exact Ideal.eq_top_of_isUnit_mem _ (p.coeff_mem_contentIdeal n) hn

end UnitCoeff

/-! ## Over a local ring: the unit content ideal has a unit coefficient -/

section LocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- Over a local ring, a polynomial whose content is the unit ideal has some
coefficient that is a unit (otherwise all coefficients lie in the maximal ideal,
so does their span, which then is not the unit ideal). -/
theorem exists_isUnit_coeff_of_contentIdeal_eq_top {p : R[X]} (h : p.contentIdeal = ⊤) :
    ∃ n, IsUnit (p.coeff n) := by
  by_contra hc
  push Not at hc
  have hle : p.contentIdeal ≤ IsLocalRing.maximalIdeal R := by
    rw [Polynomial.contentIdeal_def, Ideal.span_le]
    rintro x hx
    obtain ⟨n, -, rfl⟩ := Polynomial.mem_coeffs_iff.mp (by simpa using hx)
    by_contra hxm
    exact hc n (IsLocalRing.notMem_maximalIdeal.mp hxm)
  rw [h] at hle
  exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp hle)

end LocalRing

/-! ## The field case -/

section Field

variable {K : Type*} [Field K]

theorem contentIdeal_eq_top_of_ne_zero {f : K[X]} (hf : f ≠ 0) : f.contentIdeal = ⊤ := by
  obtain ⟨n, hn⟩ : ∃ n, f.coeff n ≠ 0 := by
    by_contra h
    push Not at h
    exact hf (Polynomial.ext fun n => by simpa using h n)
  exact contentIdeal_eq_top_of_isUnit_coeff ⟨n, isUnit_iff_ne_zero.mpr hn⟩

/-- Over a field every non-zero polynomial has content `⊤`, so content is
multiplicative. -/
theorem contentIdeal_mul_of_field (f g : K[X]) :
    (f * g).contentIdeal = f.contentIdeal * g.contentIdeal := by
  rcases eq_or_ne f 0 with rfl | hf
  · rw [zero_mul, Polynomial.contentIdeal_zero, Ideal.bot_mul]
  rcases eq_or_ne g 0 with rfl | hg
  · rw [mul_zero, Polynomial.contentIdeal_zero, Ideal.mul_bot]
  rw [contentIdeal_eq_top_of_ne_zero hf, contentIdeal_eq_top_of_ne_zero hg,
    contentIdeal_eq_top_of_ne_zero (mul_ne_zero hf hg), Ideal.top_mul]

end Field

/-! ## The discrete valuation ring case -/

section Dvr

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- In a DVR, some coefficient of a non-zero polynomial divides all coefficients,
namely a coefficient of minimal valuation. -/
theorem exists_coeff_dvd_all_coeffs {f : R[X]} (hf : f ≠ 0) :
    ∃ (a : R) (i : ℕ), i ∈ f.support ∧ f.coeff i = a ∧ ∀ n, a ∣ f.coeff n := by
  classical
  have hne : f.support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty, Ne, Polynomial.support_eq_empty]
    exact hf
  obtain ⟨i, hi_mem, hi_min⟩ :=
    Finset.exists_min_image f.support
      (fun n => IsDiscreteValuationRing.addVal R (f.coeff n)) hne
  refine ⟨f.coeff i, i, hi_mem, rfl, fun n => ?_⟩
  by_cases hn : n ∈ f.support
  · exact IsDiscreteValuationRing.addVal_le_iff_dvd.mp (hi_min n hn)
  · rw [Polynomial.notMem_support_iff.mp hn]
    exact dvd_zero _

/-- In a discrete valuation ring, content is multiplicative. -/
theorem contentIdeal_mul_of_dvr (f g : R[X]) :
    (f * g).contentIdeal = f.contentIdeal * g.contentIdeal := by
  classical
  rcases eq_or_ne f 0 with rfl | hf0
  · rw [zero_mul, Polynomial.contentIdeal_zero, Ideal.bot_mul]
  rcases eq_or_ne g 0 with rfl | hg0
  · rw [mul_zero, Polynomial.contentIdeal_zero, Ideal.mul_bot]
  -- coefficients of minimal valuation
  obtain ⟨a, i, hi_mem, hai, hdvd⟩ := exists_coeff_dvd_all_coeffs hf0
  obtain ⟨b, j, hj_mem, hbj, hdvd'⟩ := exists_coeff_dvd_all_coeffs hg0
  have ha0 : a ≠ 0 := by
    rw [← hai]
    exact Polynomial.mem_support_iff.mp hi_mem
  have hb0 : b ≠ 0 := by
    rw [← hbj]
    exact Polynomial.mem_support_iff.mp hj_mem
  -- factor out those coefficients
  obtain ⟨F, hF⟩ := (Polynomial.C_dvd_iff_dvd_coeff a f).mpr hdvd
  obtain ⟨G, hG⟩ := (Polynomial.C_dvd_iff_dvd_coeff b g).mpr hdvd'
  have hFi : F.coeff i = 1 := by
    have h1 : a * F.coeff i = a := by
      rw [← Polynomial.coeff_C_mul, ← hF, hai]
    exact mul_left_cancel₀ ha0 (by rw [h1, mul_one])
  have hGj : G.coeff j = 1 := by
    have h1 : b * G.coeff j = b := by
      rw [← Polynomial.coeff_C_mul, ← hG, hbj]
    exact mul_left_cancel₀ hb0 (by rw [h1, mul_one])
  -- contents are principal, generated by the chosen coefficients
  have hfcon : f.contentIdeal = Ideal.span {a} := by
    refine le_antisymm ?_ ?_
    · rw [← Polynomial.contentIdeal_C a]
      exact Polynomial.contentIdeal_le_contentIdeal_of_dvd ⟨F, hF⟩
    · rw [← hai]
      exact (Ideal.span_singleton_le_iff_mem _).mpr (Polynomial.coeff_mem_contentIdeal f i)
  have hgcon : g.contentIdeal = Ideal.span {b} := by
    refine le_antisymm ?_ ?_
    · rw [← Polynomial.contentIdeal_C b]
      exact Polynomial.contentIdeal_le_contentIdeal_of_dvd ⟨G, hG⟩
    · rw [← hbj]
      exact (Ideal.span_singleton_le_iff_mem _).mpr (Polynomial.coeff_mem_contentIdeal g j)
  have hfg : f * g = C (a * b) * (F * G) := by
    rw [hF, hG, Polynomial.C_mul]
    ring
  -- `F * G` has content `⊤`, hence (local ring!) even a unit coefficient
  have hunit : ∃ k, IsUnit ((F * G).coeff k) :=
    exists_isUnit_coeff_of_contentIdeal_eq_top <|
      Polynomial.contentIdeal_mul_eq_top_of_contentIdeal_eq_top
        (contentIdeal_eq_top_of_isUnit_coeff ⟨i, hFi ▸ isUnit_one⟩)
        (contentIdeal_eq_top_of_isUnit_coeff ⟨j, hGj ▸ isUnit_one⟩)
  have hcon : (f * g).contentIdeal = Ideal.span {a * b} := by
    refine le_antisymm ?_ ?_
    · rw [← Polynomial.contentIdeal_C (a * b)]
      exact Polynomial.contentIdeal_le_contentIdeal_of_dvd ⟨F * G, hfg⟩
    · obtain ⟨k, hk⟩ := hunit
      obtain ⟨u, hu⟩ := hk
      rw [Ideal.span_singleton_le_iff_mem]
      have hcoef : (f * g).coeff k = a * b * (F * G).coeff k := by
        rw [hfg, Polynomial.coeff_C_mul]
      have hkey : a * b = (f * g).coeff k * ↑u⁻¹ := by
        rw [hcoef, ← hu, mul_assoc, Units.mul_inv, mul_one]
      rw [hkey]
      exact Ideal.mul_mem_right _ _ (Polynomial.coeff_mem_contentIdeal (f * g) k)
  rw [hfcon, hgcon, hcon, Ideal.span_singleton_mul_span_singleton]

end Dvr

/-! ## The exercise: Dedekind domains -/

section Dedekind

variable {A : Type*} [CommRing A] [IsDedekindDomain A]

/-- **Atiyah–Macdonald, Exercise 9.2.**  In a Dedekind domain the content of a
product of two polynomials is the product of the contents. -/
theorem contentIdeal_mul (f g : A[X]) :
    (f * g).contentIdeal = f.contentIdeal * g.contentIdeal := by
  classical
  by_cases hfield : IsField A
  · letI : Field A := hfield.toField
    exact contentIdeal_mul_of_field f g
  · -- the localisation at any maximal ideal is a DVR
    refine Ideal.eq_of_localization_maximal (fun P hP => ?_)
    have hPbot : P ≠ ⊥ := by
      rintro rfl
      exact hfield (Ring.isField_iff_maximal_bot.mpr hP)
    haveI : P.IsPrime := hP.isPrime
    haveI : IsDiscreteValuationRing (Localization.AtPrime P) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hPbot _
    rw [← Polynomial.contentIdeal_map_eq_map_contentIdeal, Polynomial.map_mul, Ideal.map_mul,
      ← Polynomial.contentIdeal_map_eq_map_contentIdeal,
      ← Polynomial.contentIdeal_map_eq_map_contentIdeal]
    exact contentIdeal_mul_of_dvr _ _

/-- **Atiyah–Macdonald, Exercise 9.2** (the required `solution` statement). -/
theorem solution (f g : A[X]) :
    (f * g).contentIdeal = f.contentIdeal * g.contentIdeal :=
  contentIdeal_mul f g

/-- The exercise written out without the `contentIdeal` abbreviation: the ideal
generated by the coefficients of `f * g` is the product of the ideals generated by
the coefficients of `f` and of `g`. -/
theorem solution_span_coeffs (f g : A[X]) :
    Ideal.span ((f * g).coeffs : Set A) = Ideal.span (f.coeffs : Set A) * Ideal.span (g.coeffs : Set A) := by
  rw [← Polynomial.contentIdeal_def, ← Polynomial.contentIdeal_def, ← Polynomial.contentIdeal_def]
  exact solution f g

/-- Gauss's lemma over a Dedekind domain (consequence of the exercise): a product
of two polynomials has content the unit ideal iff both factors do. -/
theorem contentIdeal_mul_eq_top_iff (f g : A[X]) :
    (f * g).contentIdeal = ⊤ ↔ f.contentIdeal = ⊤ ∧ g.contentIdeal = ⊤ := by
  refine ⟨fun h => ⟨?_, ?_⟩, fun ⟨hf, hg⟩ => ?_⟩
  · exact Polynomial.contentIdeal_eq_top_of_contentIdeal_mul_eq_top h
  · exact Polynomial.contentIdeal_eq_top_of_contentIdeal_mul_eq_top (p := g) (q := f)
      (by rwa [mul_comm] at h)
  · rw [solution, hf, hg, Ideal.top_mul]

end Dedekind

end AtiyahMcdonald69.Ex_9_2
