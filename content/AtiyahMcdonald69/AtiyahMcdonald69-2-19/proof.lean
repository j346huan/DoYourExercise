-/

namespace AtiyahMcdonald69.Ex_2_19

noncomputable section

variable {A : Type*} [CommRing A] {ι : Type*} [Preorder ι] [DecidableEq ι]
  {M N P : ι → Type*}
  [∀ i, AddCommMonoid (M i)] [∀ i, Module A (M i)]
  [∀ i, AddCommMonoid (N i)] [∀ i, Module A (N i)]
  [∀ i, AddCommMonoid (P i)] [∀ i, Module A (P i)]

/-- The direct limit of a direct system of `A`-modules over `ι` (Exercise 14): the quotient
of `⨁ᵢ Mᵢ` by the submodule generated by the elements `xᵢ - μᵢⱼ(xᵢ)`. -/
abbrev DLim (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) : Type _ := Module.DirectLimit M μ

/-- The canonical map `Mᵢ → lim M` into the direct limit (Exercise 14). -/
abbrev DOf (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (i : ι) : M i →ₗ[A] DLim μ :=
  Module.DirectLimit.of A ι M μ i

/-! ### Exercise 15 (the two facts about direct limits that Exercise 2.19 uses)

The book proves these in Exercise 15; in Lean they are `Module.DirectLimit.exists_of`,
`Module.DirectLimit.of.zero_exact` and `Module.DirectLimit.exists_eq_of_of_eq`.  They are
restated here in the notation of this file so that the proof of Exercise 2.19 below reads
like the book's proof.  They are *proved* in Mathlib (no axioms). -/

/-- **Exercise 15 (a).**  Every element of `lim M` is `μᵢ(xᵢ)` for some `i` and some
`xᵢ ∈ Mᵢ`. -/
theorem exists_DOf [IsDirectedOrder ι] [Nonempty ι] (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j)
    (z : DLim μ) : ∃ (i : ι) (x : M i), DOf μ i x = z :=
  Module.DirectLimit.exists_of z

/-- **Exercise 15 (b).**  If `μᵢ(xᵢ) = 0` in `lim M`, then already `μᵢⱼ(xᵢ) = 0` in `Mⱼ` for
some `j ≥ i`. -/
theorem DOf_eq_zero [IsDirectedOrder ι] (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j)
    (hM : DirectedSystem M (μ · · ·)) {i : ι} {x : M i} (h : DOf μ i x = 0) :
    ∃ (j : ι) (hij : i ≤ j), μ i j hij x = 0 :=
  Module.DirectLimit.of.zero_exact h

/-- Exercise 15 (b), equality form: two elements of `Mᵢ` with the same image in `lim M` have
the same image in some `Mⱼ`, `j ≥ i`. -/
theorem DOf_eq_DOf [IsDirectedOrder ι] (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j)
    (hM : DirectedSystem M (μ · · ·)) {i : ι} {x y : M i} (h : DOf μ i x = DOf μ i y) :
    ∃ (j : ι) (hij : i ≤ j), μ i j hij x = μ i j hij y :=
  Module.DirectLimit.exists_eq_of_of_eq h

section InducedMap

/-- **Exercise 18.**  A family of linear maps `φᵢ : Mᵢ → Nᵢ` commuting with the maps of the
two direct systems induces a linear map `lim φ : lim M → lim N` of the direct limits. -/
def directLimitMap (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j)
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x)) :
    DLim μ →ₗ[A] DLim ν :=
  Module.DirectLimit.lift A ι M μ (fun i => (DOf ν i).comp (φ i)) fun i j h x => by
    rw [LinearMap.comp_apply, LinearMap.comp_apply, hφ i j h x, Module.DirectLimit.of_f]

/-- The induced map `lim φ` is `φᵢ` on the `i`-th component. -/
@[simp]
theorem directLimitMap_of (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j)
    (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j) (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x)) {i : ι} (x : M i) :
    directLimitMap μ ν φ hφ (DOf μ i x) = DOf ν i (φ i x) := by
  simp [directLimitMap, DOf, DLim]

/-- The identity morphism of a direct system induces the identity of its direct limit. -/
theorem directLimitMap_id (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) :
    directLimitMap μ μ (fun _ => LinearMap.id) (fun _ _ _ _ => rfl) = LinearMap.id := by
  refine Module.DirectLimit.hom_ext (fun i => ?_)
  ext x
  simp [directLimitMap_of]

/-- Induced maps of direct limits are compatible with composition of morphisms of direct
systems. -/
theorem directLimitMap_comp (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j)
    (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j) (ξ : ∀ i j, i ≤ j → P i →ₗ[A] P j)
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (ψ : ∀ i, N i →ₗ[A] P i)
    (hψ : ∀ i j (h : i ≤ j) (x : N i), ψ j (ν i j h x) = ξ i j h (ψ i x)) :
    (directLimitMap ν ξ ψ hψ).comp (directLimitMap μ ν φ hφ) =
      directLimitMap μ ξ (fun i => (ψ i).comp (φ i))
        (fun i j h x => by rw [LinearMap.comp_apply, LinearMap.comp_apply, hφ i j h x,
          hψ i j h (φ i x)]) := by
  refine Module.DirectLimit.hom_ext (fun i => ?_)
  ext x
  simp [directLimitMap_of]

end InducedMap

section Exact

set_option linter.unusedVariables false in
/-- **Atiyah–Macdonald, Exercise 2.19.**  Let `ι` be a directed set and let `M`, `N`, `P` be
direct systems of `A`-modules over `ι` (Exercise 14).  Let `φ : M → N` and `ψ : N → P` be
morphisms of direct systems, and suppose that for every `i ∈ ι` the sequence
`Mᵢ --φᵢ--> Nᵢ --ψᵢ--> Pᵢ` is exact.  Then the induced sequence of direct limits
`lim M --lim φ--> lim N --lim ψ--> lim P` is exact, i.e. `im (lim φ) = ker (lim ψ)`. -/
theorem exact_directLimit [IsDirectedOrder ι]
    (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (hM : DirectedSystem M (μ · · ·))
    (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j) (hN : DirectedSystem N (ν · · ·))
    (ξ : ∀ i j, i ≤ j → P i →ₗ[A] P j) (hP : DirectedSystem P (ξ · · ·))
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (ψ : ∀ i, N i →ₗ[A] P i)
    (hψ : ∀ i j (h : i ≤ j) (x : N i), ψ j (ν i j h x) = ξ i j h (ψ i x))
    (hex : ∀ i, LinearMap.range (φ i) = LinearMap.ker (ψ i)) :
    LinearMap.range (directLimitMap μ ν φ hφ) = LinearMap.ker (directLimitMap ν ξ ψ hψ) := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · -- The index set is empty: all three direct limits are then the zero module.
    have := hι
    refine le_antisymm ?_ ?_
    · rintro z ⟨m, -⟩
      exact Subsingleton.elim _ _
    · intro z _
      exact ⟨0, Subsingleton.elim _ _⟩
  · have := hι
    have := hN
    refine le_antisymm ?_ ?_
    · -- `im (lim φ) ⊆ ker (lim ψ)`: this uses only that `im φᵢ ⊆ ker ψᵢ`.
      rintro z ⟨m, rfl⟩
      refine Module.DirectLimit.induction_on m ?_
      intro i x
      rw [LinearMap.mem_ker, directLimitMap_of, directLimitMap_of]
      have hx : ψ i (φ i x) = 0 := by
        have hmem : φ i x ∈ LinearMap.range (φ i) := LinearMap.mem_range.mpr ⟨x, rfl⟩
        rw [hex i] at hmem
        exact hmem
      rw [hx, map_zero]
    · -- `ker (lim ψ) ⊆ im (lim φ)`: use Exercise 15 twice.
      intro z hz
      rw [LinearMap.mem_ker] at hz
      obtain ⟨i, y, rfl⟩ := exists_DOf ν z
      rw [directLimitMap_of] at hz
      -- Exercise 15(b): a component that dies in the limit already dies in a later module.
      obtain ⟨j, hij, hzero⟩ := DOf_eq_zero ξ hP hz
      have hψj : ψ j (ν i j hij y) = 0 := by
        rw [hψ i j hij y]
        exact hzero
      have hmem : ν i j hij y ∈ LinearMap.range (φ j) := by
        rw [hex j]
        exact hψj
      obtain ⟨x', hx'⟩ := LinearMap.mem_range.mp hmem
      exact ⟨DOf μ j x', by rw [directLimitMap_of, hx', Module.DirectLimit.of_f]⟩

/-- **Exercise 2.19**, stated with `Function.Exact`: exactness of `lim M → lim N → lim P`. -/
theorem functionExact_directLimit [IsDirectedOrder ι]
    (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (hM : DirectedSystem M (μ · · ·))
    (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j) (hN : DirectedSystem N (ν · · ·))
    (ξ : ∀ i j, i ≤ j → P i →ₗ[A] P j) (hP : DirectedSystem P (ξ · · ·))
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (ψ : ∀ i, N i →ₗ[A] P i)
    (hψ : ∀ i j (h : i ≤ j) (x : N i), ψ j (ν i j h x) = ξ i j h (ψ i x))
    (hex : ∀ i, LinearMap.range (φ i) = LinearMap.ker (ψ i)) :
    Function.Exact (directLimitMap μ ν φ hφ) (directLimitMap ν ξ ψ hψ) := by
  rw [LinearMap.exact_iff]
  exact (exact_directLimit μ hM ν hN ξ hP φ hφ ψ hψ hex).symm

/-- A morphism of directed systems whose components are injective induces an injective map of
direct limits. -/
theorem directLimitMap_injective [IsDirectedOrder ι]
    (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j)
    (hN : DirectedSystem N (ν · · ·))
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (hinj : ∀ i, Function.Injective (φ i)) :
    Function.Injective (directLimitMap μ ν φ hφ) := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · have := hι
    intro x y _
    exact Subsingleton.elim _ _
  · have := hι
    have := hN
    intro z w hzw
    obtain ⟨i, x, y, rfl, rfl⟩ := Module.DirectLimit.exists_of₂ z w
    rw [directLimitMap_of, directLimitMap_of] at hzw
    -- Exercise 15(b): two elements equal in the limit are equal in a later component.
    obtain ⟨j, hij, hν⟩ := DOf_eq_DOf ν hN hzw
    have hμ : μ i j hij x = μ i j hij y := by
      apply hinj j
      rw [hφ i j hij x, hφ i j hij y, hν]
    rw [← Module.DirectLimit.of_f (f := μ) (i := i) (j := j) (hij := hij) (x := x),
      ← Module.DirectLimit.of_f (f := μ) (i := i) (j := j) (hij := hij) (x := y), hμ]

/-- A morphism of directed systems whose components are surjective induces a surjective map of
direct limits. -/
theorem directLimitMap_surjective [IsDirectedOrder ι]
    (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j)
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (hsurj : ∀ i, Function.Surjective (φ i)) :
    Function.Surjective (directLimitMap μ ν φ hφ) := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · have := hι
    intro y
    exact ⟨0, Subsingleton.elim _ _⟩
  · have := hι
    intro y
    obtain ⟨i, yᵢ, rfl⟩ := exists_DOf ν y
    obtain ⟨xᵢ, rfl⟩ := hsurj i yᵢ
    exact ⟨DOf μ i xᵢ, by rw [directLimitMap_of]⟩

/-- **Exercise 2.19**, short exact form: if `0 → Mᵢ → Nᵢ → Pᵢ → 0` is exact for every `i`,
then `0 → lim M → lim N → lim P → 0` is exact.  The book only asks for exactness at the
middle term; injectivity at `lim M` and surjectivity at `lim P` are added here because they
are what the exercise is normally used for. -/
theorem shortExact_directLimit [IsDirectedOrder ι]
    (μ : ∀ i j, i ≤ j → M i →ₗ[A] M j) (hM : DirectedSystem M (μ · · ·))
    (ν : ∀ i j, i ≤ j → N i →ₗ[A] N j) (hN : DirectedSystem N (ν · · ·))
    (ξ : ∀ i j, i ≤ j → P i →ₗ[A] P j) (hP : DirectedSystem P (ξ · · ·))
    (φ : ∀ i, M i →ₗ[A] N i)
    (hφ : ∀ i j (h : i ≤ j) (x : M i), φ j (μ i j h x) = ν i j h (φ i x))
    (ψ : ∀ i, N i →ₗ[A] P i)
    (hψ : ∀ i j (h : i ≤ j) (x : N i), ψ j (ν i j h x) = ξ i j h (ψ i x))
    (hinj : ∀ i, Function.Injective (φ i))
    (hex : ∀ i, LinearMap.range (φ i) = LinearMap.ker (ψ i))
    (hsurj : ∀ i, Function.Surjective (ψ i)) :
    Function.Injective (directLimitMap μ ν φ hφ) ∧
      LinearMap.range (directLimitMap μ ν φ hφ) = LinearMap.ker (directLimitMap ν ξ ψ hψ) ∧
        Function.Surjective (directLimitMap ν ξ ψ hψ) :=
  ⟨directLimitMap_injective μ ν hN φ hφ hinj,
    exact_directLimit μ hM ν hN ξ hP φ hφ ψ hψ hex,
    directLimitMap_surjective ν ξ ψ hψ hsurj⟩

/-! ### Sharpness: the converse fails

Exercise 2.19 is an implication, not an equivalence: exactness of `lim M → lim N → lim P` does
*not* force the systems `Mᵢ → Nᵢ → Pᵢ` to be exact.  The counterexample below is over
`A = ℤ` and `ι = ℕ`: take `Mᵢ = Nᵢ = Pᵢ = ℤ`, let `M` and `N` have identity maps, and let the
maps of `P` be the identity on a component and zero otherwise.  Then `lim P = 0`, so the
sequence of limits is trivially exact, while the components at `0` are
`ℤ --1--> ℤ --1--> ℤ`, which is not exact.

This is not a defect of the exercise's statement — it is exactly why the exercise has to
assume exactness of the systems — but it pins down the quantified content of the result. -/

section Counterexample

/-- The modules of the counterexample: `ℤ` at every index `i : ℕ`. -/
abbrev ceSys : ℕ → Type := fun _ => ℤ

/-- The direct systems `M = N` of the counterexample: identity maps. -/
abbrev ceId : ∀ i j : ℕ, i ≤ j → ceSys i →ₗ[ℤ] ceSys j := fun _ _ _ => LinearMap.id

/-- The third direct system `P` of the counterexample: the identity on a component and zero
otherwise.  Its direct limit is `0`. -/
abbrev ceKill : ∀ i j : ℕ, i ≤ j → ceSys i →ₗ[ℤ] ceSys j :=
  fun i j _ => if i = j then LinearMap.id else 0

instance ceId_directedSystem : DirectedSystem ceSys (ceId · · ·) where
  map_self := fun _ _ => rfl
  map_map := fun _ _ _ _ _ _ => rfl

lemma ceKill_apply (i j : ℕ) (h : i ≤ j) (x : ℤ) :
    ceKill i j h x = if i = j then x else 0 := by
  simp only [ceKill]
  split_ifs <;> simp

lemma ceKill_self (i : ℕ) (h : i ≤ i) : ceKill i i h = (LinearMap.id : ℤ →ₗ[ℤ] ℤ) := by
  apply LinearMap.ext
  intro x
  rw [ceKill_apply]
  simp

lemma ceKill_of_ne (i j : ℕ) (h : i ≤ j) (hij : i ≠ j) : ceKill i j h = 0 := by
  apply LinearMap.ext
  intro x
  rw [ceKill_apply]
  simp [hij]

instance ceKill_directedSystem : DirectedSystem ceSys (ceKill · · ·) where
  map_self := fun i x => by rw [ceKill_self]; simp
  map_map := fun {k j i} hij hjk x => by
    rw [ceKill_apply, ceKill_apply, ceKill_apply]
    by_cases h1 : i = j
    · subst h1; simp
    · have hik : i ≠ k := by
        rintro rfl
        exact h1 (le_antisymm hij hjk)
      simp [h1, hik]

/-- The direct limit of `ceKill` is the zero module: `of i x = of (i+1) (ceKill i (i+1) x) = 0`. -/
theorem ceKill_limit_subsingleton : Subsingleton (DLim ceKill) := by
  have hstep : ∀ (i : ℕ) (y : ℤ), DOf ceKill i y = 0 := by
    intro i y
    rw [← Module.DirectLimit.of_f (f := ceKill) (i := i) (j := i + 1)
      (hij := Nat.le_succ i) (x := y)]
    rw [ceKill_apply]
    simp
  have hzero : ∀ z : DLim ceKill, z = 0 := by
    intro z
    obtain ⟨i, y, rfl⟩ := exists_DOf ceKill z
    exact hstep i y
  exact ⟨fun z w => by rw [hzero z, hzero w]⟩

/-- The first morphism of systems of the counterexample: the identity on every component. -/
abbrev ceφ : ∀ i, ceSys i →ₗ[ℤ] ceSys i := fun _ => LinearMap.id

/-- The second morphism of systems: the identity on the `0`-th component and zero elsewhere. -/
abbrev ceψ : ∀ i, ceSys i →ₗ[ℤ] ceSys i := fun i => if i = 0 then LinearMap.id else 0

theorem ceφ_compat :
    ∀ i j (h : i ≤ j) (x : ceSys i), ceφ j (ceId i j h x) = ceId i j h (ceφ i x) :=
  fun _ _ _ _ => rfl

theorem ceψ_compat :
    ∀ i j (h : i ≤ j) (x : ceSys i), ceψ j (ceId i j h x) = ceKill i j h (ceψ i x) := by
  intro i j h x
  by_cases hij : i = j
  · subst hij
    rw [ceKill_self]
    simp [ceψ, ceId]
  · rw [ceKill_of_ne i j h hij]
    have hj : j ≠ 0 := by
      rintro rfl
      exact hij (Nat.le_zero.mp h)
    simp [ceψ, ceId, hj]

/-- The systems are **not** exact at the component `0`: there the sequence is
`ℤ --1--> ℤ --1--> ℤ`. -/
theorem ce_not_exact_at_zero : LinearMap.range (ceφ 0) ≠ LinearMap.ker (ceψ 0) := by
  rintro h
  have hmem : (1 : ℤ) ∈ LinearMap.ker (ceψ 0) :=
    h ▸ LinearMap.mem_range_self (ceφ 0) (1 : ℤ)
  have h0 : ceψ 0 = (LinearMap.id : ℤ →ₗ[ℤ] ℤ) := by simp [ceψ]
  rw [h0, LinearMap.mem_ker] at hmem
  exact one_ne_zero hmem

/-- Nonetheless the sequence of direct limits **is** exact (the third limit is `0`). -/
theorem ce_limit_exact :
    LinearMap.range (directLimitMap ceId ceId ceφ ceφ_compat) =
      LinearMap.ker (directLimitMap ceId ceKill ceψ ceψ_compat) := by
  have := ceKill_limit_subsingleton
  refine le_antisymm ?_ ?_
  · intro z _
    rw [LinearMap.mem_ker]
    exact Subsingleton.elim _ _
  · intro z _
    obtain ⟨i, y, rfl⟩ := exists_DOf ceId z
    exact ⟨DOf ceId i y, by rw [directLimitMap_of]; simp [ceφ]⟩

/-- **The converse of Exercise 2.19 fails.**  These direct systems over `ℕ` are not exact at
the component `0`, yet the induced sequence of direct limits is exact.  So the exercise cannot
be strengthened to an equivalence, and its pointwise exactness hypothesis is essential.

The data satisfy the hypotheses of Exercise 14 (`ceId_directedSystem`, `ceKill_directedSystem`)
and `ceφ_compat`, `ceψ_compat` say that `ceφ` and `ceψ` are morphisms of direct systems. -/
theorem converse_of_exact_directLimit_fails :
    ¬ (∀ i, LinearMap.range (ceφ i) = LinearMap.ker (ceψ i)) ∧
      LinearMap.range (directLimitMap ceId ceId ceφ ceφ_compat) =
        LinearMap.ker (directLimitMap ceId ceKill ceψ ceψ_compat) :=
  ⟨fun hall => ce_not_exact_at_zero (hall 0), ce_limit_exact⟩

end Counterexample

end Exact

end

