/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 3, Exercise 29.

Statement (book, p. 49):

  "Let f : A → B be a ring homomorphism. Show that f* : Spec B → Spec A is a
   continuous closed mapping (i.e. maps closed sets to closed sets) for the
   constructible topology."

Here f* = PrimeSpectrum.comap f, and the constructible topology on Spec A = X is the
topology introduced in Exercises 27 and 28 of the same chapter, generated by the sets
X_g = D(g) = {p | g ∉ p} and their complements V(g) = {p | g ∈ p}
(Exercise 28 (i): each X_g is both open and closed for the constructible topology, and
(ii)-(iii): the constructible topology is the smallest topology for which the X_g are
clopen; the X_g and the V(g) form a subbasis).

Proof, exactly as in the book:
* (f*)⁻¹(D(a)) = D(f a) and (f*)⁻¹(V(a)) = V(f a), hence f* is continuous, since the
  D(a) and the V(a) form a subbasis of the constructible topology;
* by Exercise 28 (iv) (via Exercise 27 (iv)), Spec A and Spec B are compact in the
  constructible topology, and by Exercise 28 (ii) they are Hausdorff in it;
* hence a closed subset Z ⊆ Spec B is compact, its image f*(Z) is compact, and a
  compact subset of the Hausdorff space Spec A is closed.

The topological inputs from Exercise 28 that are used are proved here from scratch
(isClopen_basicOpen_specC, isClopen_zeroLocus_singleton_specC, compactSpace_specC,
totallySeparatedSpace_specC, t2Space_specC), so that the file is self-contained.
Compactness of Spec A in the constructible topology is obtained from Mathlib's general
theorem that a spectral space is quasi-compact in its constructible topology
(compactSpace_withConstructibleTopology), after identifying Mathlib's constructible
topology (generated by the compact open sets and their complements) with the topology
generated by the D(a) and the V(a) (specC_eq_constructibleTopology).
-/
import Mathlib

-- `letI` is used in proofs below to replace the ambient (Zariski) topology by the
-- constructible topology; this is a style-linter warning only.
set_option linter.style.haveILetI false

open Set Topology

namespace AtiyahMcdonald69.Ex_3_29

variable {A B : Type*} [CommRing A] [CommRing B]

/-! ### A general topological lemma: compact source, Hausdorff target -/

/-- A continuous map from a compact space to a Hausdorff space is closed: a closed subset
of the source is compact, its image is compact, and a compact subset of a Hausdorff space
is closed.  This is the last step of Atiyah-Macdonald, Exercise 3.29. -/
theorem isClosedMap_of_compactSpace_of_t2Space {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] [CompactSpace X] [T2Space Y] {f : X → Y} (hf : Continuous f) :
    IsClosedMap f :=
  fun _s hs => (hs.isCompact.image hf).isClosed

/-! ### The constructible topology on the prime spectrum -/

/-- The subbasis of the constructible topology on `Spec A` (Atiyah-Macdonald, Chapter 3,
Exercises 27-28): the sets `D(a) = X_a` together with their complements `V(a)`. -/
def specSubbasis (A : Type*) [CommRing A] : Set (Set (PrimeSpectrum A)) :=
  Set.range (fun a : A => (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A))) ∪
    Set.range (fun a : A => PrimeSpectrum.zeroLocus ({a} : Set A))

/-- The constructible topology on `Spec A`: the topology generated by the sets `D(a)` and
`V(a)` (Atiyah-Macdonald, Chapter 3, Exercise 28). -/
@[instance_reducible]
def specC (A : Type*) [CommRing A] : TopologicalSpace (PrimeSpectrum A) :=
  TopologicalSpace.generateFrom (specSubbasis A)

/-! ### The sets `D(a)` and `V(a)` are clopen (Exercise 28 (i)) -/

theorem isOpen_basicOpen_specC (a : A) :
    IsOpen[specC A] (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨a, rfl⟩)

theorem isOpen_zeroLocus_singleton_specC (a : A) :
    IsOpen[specC A] (PrimeSpectrum.zeroLocus ({a} : Set A)) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨a, rfl⟩)

/-- `V(a)` is the complement of `D(a)`. -/
theorem zeroLocus_singleton_eq_compl_basicOpen (a : A) :
    PrimeSpectrum.zeroLocus ({a} : Set A) =
      (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A))ᶜ := by
  rw [PrimeSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl]

theorem isClosed_basicOpen_specC (a : A) :
    IsClosed[specC A] (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
  letI := specC A
  refine ⟨?_⟩
  rw [← zeroLocus_singleton_eq_compl_basicOpen]
  exact isOpen_zeroLocus_singleton_specC a

/-- Exercise 28 (i): `D(a)` is both open and closed in the constructible topology. -/
theorem isClopen_basicOpen_specC (a : A) :
    @IsClopen (PrimeSpectrum A) (specC A) (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
  letI := specC A
  exact ⟨isClosed_basicOpen_specC a, isOpen_basicOpen_specC a⟩

/-- Exercise 28 (i): `V(a)` is both open and closed in the constructible topology. -/
theorem isClopen_zeroLocus_singleton_specC (a : A) :
    @IsClopen (PrimeSpectrum A) (specC A) (PrimeSpectrum.zeroLocus ({a} : Set A)) := by
  letI := specC A
  rw [zeroLocus_singleton_eq_compl_basicOpen]
  exact (isClopen_basicOpen_specC a).compl

/-! ### Compact open subsets and comparison with Mathlib's constructible topology -/

/-- `V` of a finite set is the intersection of the `V(a)`, `a` in the set. -/
theorem zeroLocus_finset_eq (t : Finset A) :
    PrimeSpectrum.zeroLocus (↑t : Set A) = ⋂ a ∈ t, PrimeSpectrum.zeroLocus ({a} : Set A) := by
  rw [← PrimeSpectrum.zeroLocus_iUnion₂]
  congr 1
  ext x
  simp

/-- A finite intersection of sets open in the constructible topology is open. -/
theorem isOpen_biInter_finset {ι : Type*} (t : Finset ι) {f : ι → Set (PrimeSpectrum A)}
    (h : ∀ i ∈ t, IsOpen[specC A] (f i)) : IsOpen[specC A] (⋂ i ∈ t, f i) := by
  letI := specC A
  classical
  revert h
  induction t using Finset.induction_on with
  | empty => intro _; simp
  | insert a s ha ih =>
      intro h
      rw [Finset.set_biInter_insert]
      exact (h a (Finset.mem_insert_self a s)).inter
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- A Zariski-closed subset of `Spec A` whose complement is Zariski-compact is open in the
constructible topology. -/
theorem isOpen_specC_of_isClosed_of_isCompact_compl {s : Set (PrimeSpectrum A)}
    (hsc : IsClosed s) (hcomp : IsCompact sᶜ) : IsOpen[specC A] s := by
  obtain ⟨t, ht⟩ := PrimeSpectrum.isCompact_isOpen_iff.mp ⟨hcomp, hsc.isOpen_compl⟩
  have hs : PrimeSpectrum.zeroLocus (↑t : Set A) = s := by
    simpa using congrArg compl ht
  rw [← hs, zeroLocus_finset_eq]
  exact isOpen_biInter_finset t fun a _ => isOpen_zeroLocus_singleton_specC a

/-- A compact open (Zariski) subset of `Spec A` is open in the constructible topology:
such a set is a finite union of the basic open sets `D(a)`. -/
theorem isOpen_specC_of_isCompact_of_isOpen {s : Set (PrimeSpectrum A)} (hs : IsCompact s)
    (hso : IsOpen s) : IsOpen[specC A] s := by
  obtain ⟨t, ht⟩ := PrimeSpectrum.isCompact_isOpen_iff.mp ⟨hs, hso⟩
  have hz : (PrimeSpectrum.zeroLocus (↑t : Set A))ᶜ =
      ⋃ a ∈ t, (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
    rw [zeroLocus_finset_eq, Set.compl_iInter₂]
    simp only [← PrimeSpectrum.basicOpen_eq_zeroLocus_compl]
  rw [← ht, hz]
  letI := specC A
  exact isOpen_biUnion fun a _ => isOpen_basicOpen_specC a

/-- The constructible topology is finer than the Zariski topology
(Atiyah-Macdonald, Chapter 3, Exercise 27 (iii)). -/
theorem specC_le_zariski : specC A ≤ PrimeSpectrum.zariskiTopology := by
  rw [TopologicalSpace.le_def]
  intro U hU
  have h : U = ⋃ (a : {x : A // (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A)) ⊆ U}),
      (PrimeSpectrum.basicOpen a.1 : Set (PrimeSpectrum A)) := by
    ext p
    constructor
    · intro hp
      obtain ⟨_v, ⟨a, rfl⟩, hpv, hvU⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp hU
      exact Set.mem_iUnion.mpr ⟨⟨a, hvU⟩, hpv⟩
    · intro hp
      obtain ⟨a, hpa⟩ := Set.mem_iUnion.mp hp
      exact a.2 hpa
  rw [h]
  letI := specC A
  exact isOpen_iUnion fun a => isOpen_basicOpen_specC a.1

/-- Every set in the subbasis of Mathlib's constructible topology (the compact open sets
and the complements of the compact closed sets) is open for the topology generated by the
`D(a)` and the `V(a)`. -/
theorem specC_le_constructibleTopology :
    specC A ≤ _root_.constructibleTopology (PrimeSpectrum A) := by
  rw [_root_.constructibleTopology, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s (⟨hso, hsc⟩ | ⟨hsc, hcomp⟩)
  · exact isOpen_specC_of_isCompact_of_isOpen hsc hso
  · exact isOpen_specC_of_isClosed_of_isCompact_compl hsc hcomp

/-- Conversely, the `D(a)` and the `V(a)` are open for Mathlib's constructible topology. -/
theorem constructibleTopology_le_specC :
    _root_.constructibleTopology (PrimeSpectrum A) ≤ specC A := by
  rw [specC, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s (⟨a, rfl⟩ | ⟨a, rfl⟩)
  · exact IsCompact.isOpen_constructibleTopology_of_isOpen (PrimeSpectrum.isCompact_basicOpen a)
      (PrimeSpectrum.basicOpen a).2
  · refine IsCompact.isOpen_constructibleTopology_of_isClosed ?_ (PrimeSpectrum.isClosed_zeroLocus _)
    have h : (PrimeSpectrum.zeroLocus ({a} : Set A))ᶜ = (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
      rw [zeroLocus_singleton_eq_compl_basicOpen, compl_compl]
    rw [h]
    exact PrimeSpectrum.isCompact_basicOpen a

/-- The constructible topology generated by the `D(a)` and the `V(a)` (Exercise 28) is
Mathlib's constructible topology, generated by the compact open sets and the complements
of the compact closed sets. -/
theorem specC_eq_constructibleTopology :
    specC A = _root_.constructibleTopology (PrimeSpectrum A) :=
  le_antisymm specC_le_constructibleTopology constructibleTopology_le_specC

/-! ### `Spec A` is compact, Hausdorff and totally disconnected in the
constructible topology (Exercise 28 (ii) and (iv)) -/

/-- Exercise 28 (iv): `Spec A` is quasi-compact in the constructible topology. -/
theorem compactSpace_specC : @CompactSpace (PrimeSpectrum A) (specC A) := by
  rw [specC_eq_constructibleTopology]
  -- `WithConstructibleTopology (Spec A)` is the same set with Mathlib's constructible
  -- topology; `ofTopology` is a continuous surjection to `Spec A` with this topology.
  exact @Function.Surjective.compactSpace
    (WithTopology (PrimeSpectrum A) (_root_.constructibleTopology (PrimeSpectrum A)))
    (PrimeSpectrum A)
    (WithTopology.instTopologicalSpace _ _) (_root_.constructibleTopology (PrimeSpectrum A))
    (WithTopology.ofTopology (t := _root_.constructibleTopology (PrimeSpectrum A)))
    (WithTopology.continuous_ofTopology (_root_.constructibleTopology (PrimeSpectrum A)))
    (compactSpace_withConstructibleTopology (X := PrimeSpectrum A))
    (WithTopology.ofTopology_surjective (_root_.constructibleTopology (PrimeSpectrum A)))

/-- Exercise 28 (ii) and (iv): `Spec A` is totally separated, hence Hausdorff and totally
disconnected, in the constructible topology: two distinct primes are separated by the
clopen set `D(a)` or the clopen set `V(a)` for a suitable `a`. -/
theorem totallySeparatedSpace_specC : @TotallySeparatedSpace (PrimeSpectrum A) (specC A) := by
  letI := specC A
  rw [totallySeparatedSpace_iff_exists_isClopen]
  intro p q hpq
  by_cases h : p.asIdeal ≤ q.asIdeal
  · have h' : ¬ q.asIdeal ≤ p.asIdeal := fun hqp =>
      hpq (PrimeSpectrum.ext (le_antisymm h hqp))
    obtain ⟨a, haq, hap⟩ := Set.not_subset.mp h'
    refine ⟨(PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)),
      isClopen_basicOpen_specC a, ?_, ?_⟩
    · simpa using hap
    · simpa using haq
  · obtain ⟨a, hap, haq⟩ := Set.not_subset.mp h
    refine ⟨PrimeSpectrum.zeroLocus ({a} : Set A),
      isClopen_zeroLocus_singleton_specC a, ?_, ?_⟩
    · simpa using hap
    · simpa using haq

/-- Exercise 28 (ii): `Spec A` is Hausdorff in the constructible topology. -/
theorem t2Space_specC : @T2Space (PrimeSpectrum A) (specC A) := by
  letI := specC A
  haveI := totallySeparatedSpace_specC (A := A)
  infer_instance

/-- Exercise 28 (iv): `Spec A` is totally disconnected in the constructible topology. -/
theorem totallyDisconnectedSpace_specC :
    @TotallyDisconnectedSpace (PrimeSpectrum A) (specC A) := by
  letI := specC A
  haveI := totallySeparatedSpace_specC (A := A)
  infer_instance

/-! ### Exercise 3.29 -/

/-- First half of Atiyah-Macdonald, Exercise 3.29: for a ring homomorphism `f : A → B` the
induced map `f* : Spec B → Spec A` is continuous for the constructible topology, because
`(f*)⁻¹(D(a)) = D(f a)` and `(f*)⁻¹(V(a)) = V(f a)` and the `D(a)`, `V(a)` form a
subbasis. -/
theorem continuous_comap_specC (f : A →+* B) :
    @Continuous (PrimeSpectrum B) (PrimeSpectrum A) (specC B) (specC A)
      (PrimeSpectrum.comap f) := by
  have key : ∀ s ∈ specSubbasis A, IsOpen[specC B] (PrimeSpectrum.comap f ⁻¹' s) := by
    rintro s (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · have hpre : PrimeSpectrum.comap f ⁻¹' (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A))
          = (PrimeSpectrum.basicOpen (f a) : Set (PrimeSpectrum B)) := by
        ext x
        simp
      rw [hpre]
      exact isOpen_basicOpen_specC (f a)
    · have hpre : PrimeSpectrum.comap f ⁻¹' (PrimeSpectrum.zeroLocus ({a} : Set A))
          = PrimeSpectrum.zeroLocus ({f a} : Set B) := by
        rw [PrimeSpectrum.preimage_comap_zeroLocus, Set.image_singleton]
      rw [hpre]
      exact isOpen_zeroLocus_singleton_specC (f a)
  exact continuous_generateFrom_iff.mpr key

/-- Second half of Atiyah-Macdonald, Exercise 3.29: `f* : Spec B → Spec A` is a closed map
for the constructible topology. -/
theorem isClosedMap_comap_specC (f : A →+* B) :
    @IsClosedMap (PrimeSpectrum B) (PrimeSpectrum A) (specC B) (specC A)
      (PrimeSpectrum.comap f) := by
  letI := specC B
  letI := specC A
  haveI : CompactSpace (PrimeSpectrum B) := compactSpace_specC
  haveI : T2Space (PrimeSpectrum A) := t2Space_specC
  exact isClosedMap_of_compactSpace_of_t2Space (continuous_comap_specC f)

/-- Atiyah-Macdonald, Exercise 3.29, spelled out: the image under `f*` of a closed set of
`Spec B` is closed in `Spec A`, for the constructible topology. -/
theorem isClosed_image_comap_specC (f : A →+* B) {Z : Set (PrimeSpectrum B)}
    (hZ : IsClosed[specC B] Z) : IsClosed[specC A] (PrimeSpectrum.comap f '' Z) :=
  isClosedMap_comap_specC f Z hZ

/-- Atiyah-Macdonald, Exercise 3.29: for a ring homomorphism `f : A → B`, the induced map
`f* : Spec B → Spec A` is a continuous closed mapping for the constructible topology. -/
theorem solution (f : A →+* B) :
    @Continuous (PrimeSpectrum B) (PrimeSpectrum A) (specC B) (specC A)
        (PrimeSpectrum.comap f) ∧
      @IsClosedMap (PrimeSpectrum B) (PrimeSpectrum A) (specC B) (specC A)
        (PrimeSpectrum.comap f) :=
  ⟨continuous_comap_specC f, isClosedMap_comap_specC f⟩

/-- Consequence (the easy half of Exercise 28 (iii)): the image of `Spec B` under `f*` is
closed in the constructible topology of `Spec A`. -/
theorem isClosed_range_comap_specC (f : A →+* B) :
    IsClosed[specC A] (PrimeSpectrum.comap f '' univ) := by
  letI := specC A
  letI := specC B
  exact isClosed_image_comap_specC f isClosed_univ

/-! ### The constructible topology as the smallest topology making the `D(a)` clopen
(Exercise 28 (ii)-(iii)) -/

/-- Exercise 28 (iii): any topology on `Spec A` in which every `D(a)` is clopen is finer
than the constructible topology, i.e. the constructible topology is the smallest topology
for which the sets `D(a)` (equivalently `X_a`) are both open and closed. -/
theorem le_specC_of_forall_isClopen (t : TopologicalSpace (PrimeSpectrum A))
    (h : ∀ a : A, @IsClopen (PrimeSpectrum A) t
      (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A))) :
    t ≤ specC A := by
  rw [specC, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s (⟨a, rfl⟩ | ⟨a, rfl⟩)
  · exact (h a).2
  · dsimp only
    rw [zeroLocus_singleton_eq_compl_basicOpen]
    exact @IsClosed.isOpen_compl (PrimeSpectrum A) t (PrimeSpectrum.basicOpen a : Set _) (h a).1

/-! ### Concrete examples -/

/-- For a surjective homomorphism, the image of `f*` is the Zariski closed set `V(ker f)`;
so for such `f` the conclusion of Exercise 3.29 also holds for the Zariski topology. -/
theorem isClosed_range_comap_of_surjective {f : A →+* B} (hf : Function.Surjective f) :
    IsClosed (Set.range (PrimeSpectrum.comap f)) := by
  rw [@_root_.range_comap_of_surjective A B _ _ f hf]
  exact PrimeSpectrum.isClosed_zeroLocus _

/-- For the localization `f : ℤ → ℤ[1/2]`, the image of `f*` is `D(2)`. -/
theorem range_comap_int_localization :
    Set.range (PrimeSpectrum.comap (algebraMap ℤ (Localization.Away (2 : ℤ)))) =
      (PrimeSpectrum.basicOpen (2 : ℤ) : Set (PrimeSpectrum ℤ)) :=
  PrimeSpectrum.localization_away_comap_range (Localization.Away (2 : ℤ)) 2

/-- `D(2) ⊆ Spec ℤ` is not Zariski closed: `Spec ℤ` has the generic point `(0)`, which lies
in `D(2)`, whereas the only closed sets containing `(0)` are all of `Spec ℤ`, and `(2)` is
a point of `Spec ℤ` outside `D(2)`. -/
theorem not_isClosed_basicOpen_two :
    ¬ IsClosed (PrimeSpectrum.basicOpen (2 : ℤ) : Set (PrimeSpectrum ℤ)) := by
  intro h
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp h
  have h0 : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum ℤ) ∈
      (PrimeSpectrum.basicOpen (2 : ℤ) : Set (PrimeSpectrum ℤ)) := by
    simp
  rw [hI, PrimeSpectrum.mem_zeroLocus] at h0
  have hIbot : I = ⊥ := le_bot_iff.mp h0
  have h2 : (⟨Ideal.span {(2 : ℤ)}, Ideal.isPrime_span_singleton_of_prime Int.prime_two⟩ :
      PrimeSpectrum ℤ) ∈ (PrimeSpectrum.basicOpen (2 : ℤ) : Set (PrimeSpectrum ℤ)) := by
    simp [hI, hIbot]
  simp at h2

/-- The image of `f* : Spec ℤ[1/2] → Spec ℤ` is closed in the constructible topology (as
asserted by Exercise 3.29) but not in the Zariski topology; so the constructible topology
in Exercise 3.29 cannot be replaced by the Zariski topology. -/
theorem range_comap_int_localization_isClosed_iff :
    IsClosed[specC ℤ]
        (Set.range (PrimeSpectrum.comap (algebraMap ℤ (Localization.Away (2 : ℤ))))) ∧
      ¬ IsClosed (Set.range (PrimeSpectrum.comap (algebraMap ℤ (Localization.Away (2 : ℤ))))) := by
  have hrange := range_comap_int_localization
  constructor
  · rw [hrange]
    exact (isClopen_basicOpen_specC (2 : ℤ)).1
  · rw [hrange]
    exact not_isClosed_basicOpen_two

/-! ### Axiom check -/

#print axioms AtiyahMcdonald69.Ex_3_29.solution
#print axioms AtiyahMcdonald69.Ex_3_29.continuous_comap_specC
#print axioms AtiyahMcdonald69.Ex_3_29.isClosedMap_comap_specC
#print axioms AtiyahMcdonald69.Ex_3_29.specC_eq_constructibleTopology
#print axioms AtiyahMcdonald69.Ex_3_29.t2Space_specC
#print axioms AtiyahMcdonald69.Ex_3_29.compactSpace_specC
#print axioms AtiyahMcdonald69.Ex_3_29.range_comap_int_localization_isClosed_iff

end AtiyahMcdonald69.Ex_3_29
