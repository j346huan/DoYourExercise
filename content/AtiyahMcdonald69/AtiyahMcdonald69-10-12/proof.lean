/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 10 (Completions),
Exercise 10.12 (p. 115):

  "If `A` is Noetherian, then `B := A[[x₁, …, xₙ]]` is a faithfully flat `A`-algebra."

Original statement coverage.  The exercise quantifies over a natural number `n` of variables and
over a Noetherian (commutative, unital) ring `A`; `B = A[[x₁, …, xₙ]]` is the ring of formal power
series, an `A`-algebra via the constant power series.  Here we take an arbitrary finite index type
`σ` of variables (`Finite σ`, so `σ ≃ Fin n`; `n = 0` included) and prove
`Module.FaithfullyFlat A (MvPowerSeries σ A)`: `A[[xᵢ : i ∈ σ]]` is flat and faithfully flat as an
`A`-module.  `Module.FaithfullyFlat` is Mathlib's standard notion (flat, and `𝔪B ≠ B` for every
maximal ideal `𝔪` of `A`); the equivalent "tensoring with `B` cannot kill a nonzero module"
formulation is recorded and proved separately as `tensorProduct_injective`.

Source proof (natural language):
  https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-10-12
(public j346huan/DoYourExercise commit 80e1ebef1d7621c66aabb3920d981ffd8995ba91).

Mathematical approach (the source argument, formalized):
 * `A[x₁,…,xₙ]` is free, hence flat, over `A`.
 * `A[x₁,…,xₙ]` is Noetherian (Hilbert basis theorem) and `A[[x₁,…,xₙ]]` is its `(x)`-adic
   completion; the `(x)`-adic completion of a Noetherian ring is flat (AM Prop. 10.14), i.e.
   `AdicCompletion.flat_of_isNoetherian`.  Flatness is transitive (`Module.Flat.trans`).
 * The comparison maps between the `(x)`-adic completion of `MvPolynomial σ A` and
   `MvPowerSeries σ A` are built by coefficient truncation, using Mathlib's description of the
   powers of the ideal generated by the variables (`MvPolynomial.mem_pow_idealOfVars_iff'`):
   `completionToSeries` (read off coefficients at level `deg m + 1`) and `seriesToCompletion`
   (truncate at total degree `n`).  Their composite is the identity, so `MvPowerSeries σ A` is a
   retract of a flat module, hence flat (`Module.Flat.of_retract`).
 * Faithfulness: evaluation at `x = 0` (the constant-coefficient map `B → A`) is an `A`-algebra
   retraction of `A → B`, so `𝔪B ≠ B` for every maximal ideal `𝔪`; equivalently
   `M → M ⊗_A B`, `m ↦ m ⊗ 1`, is split injective for every `A`-module `M`.

Statement adaptation: the book's `n` variables are represented by a finite type `σ`
(`MvPowerSeries σ A`); no other changes.  No `sorry`, no extra axioms.
-/
import Mathlib

set_option linter.style.haveILetI false

namespace AtiyahMcdonald69.Ex_10_12

variable {A : Type*} [CommRing A] {σ : Type*}

noncomputable section

/-! ### The ideal generated by the variables and coefficient extraction -/

/-- The ideal `(x₁, …, xₙ)` of the polynomial ring `A[xᵢ : i ∈ σ]`. -/
abbrev varsIdeal : Ideal (MvPolynomial σ A) := MvPolynomial.idealOfVars σ A

/-- The `n`-th power of the ideal of the variables, as an ideal of `A[xᵢ : i ∈ σ]`. -/
abbrev varsTop (n : ℕ) : Ideal (MvPolynomial σ A) := varsIdeal (A := A) (σ := σ) ^ n • ⊤

/-- The `m`-th coefficient of a multivariate polynomial, as an `A`-linear map. -/
def polyCoeff (m : σ →₀ ℕ) : MvPolynomial σ A →ₗ[A] A where
  toFun := MvPolynomial.coeff m
  map_add' p q := MvPolynomial.coeff_add m p q
  map_smul' a p := by simp

/-- A polynomial in `(x)^n` has no coefficients in total degree `< n`. -/
theorem coeff_eq_zero_of_mem_pow {n : ℕ} {p : MvPolynomial σ A}
    (hp : p ∈ varsIdeal (A := A) (σ := σ) ^ n) {m : σ →₀ ℕ} (hm : Finsupp.degree m < n) :
    MvPolynomial.coeff m p = 0 :=
  (MvPolynomial.mem_pow_idealOfVars_iff' n p).mp hp m hm

/-- The `m`-th coefficient, viewed as a linear functional on `A[x] ⧸ (x)^n` for `deg m < n`. -/
def coeffQ (n : ℕ) (m : σ →₀ ℕ) (hm : Finsupp.degree m < n) :
    (MvPolynomial σ A ⧸ varsTop (A := A) (σ := σ) n) →ₗ[A] A :=
  Submodule.liftQ (Submodule.restrictScalars A (varsTop (A := A) (σ := σ) n))
    (polyCoeff m) (by
      intro p hp
      rw [LinearMap.mem_ker]
      have hp' : p ∈ (varsIdeal (A := A) (σ := σ) ^ n • ⊤ : Ideal (MvPolynomial σ A)) := hp
      exact coeff_eq_zero_of_mem_pow (by simpa only [varsTop, Ideal.smul_eq_mul, Ideal.mul_top]
        using hp') hm)

theorem coeffQ_mk (n : ℕ) (m : σ →₀ ℕ) (hm : Finsupp.degree m < n) (p : MvPolynomial σ A) :
    coeffQ (A := A) n m hm (Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) n)) p)
      = MvPolynomial.coeff m p :=
  rfl

/-! ### The comparison map `Â[x] → A[[x]]` from the `(x)`-adic completion -/

/-- Read off the `m`-th coefficient of a compatible family of polynomials modulo `(x)^n`; the
coefficient is taken at level `deg m + 1`, which determines it by compatibility. -/
def completionToSeries (x : AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)) :
    MvPowerSeries σ A :=
  fun m =>
    coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
      (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
        (Finsupp.degree m + 1) x)

/-- `completionToSeries` as an `A`-linear map. -/
def completionToSeriesLM :
    AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) →ₗ[A] MvPowerSeries σ A where
  toFun := completionToSeries
  map_add' x y := by
    funext m
    show coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
          (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
            (Finsupp.degree m + 1) (x + y))
        = coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
            (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
              (Finsupp.degree m + 1) x)
          + coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
              (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
                (Finsupp.degree m + 1) y)
    rw [map_add, map_add]
  map_smul' a x := by
    funext m
    show coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
          (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
            (Finsupp.degree m + 1) (a • x))
        = a • coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
            (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
              (Finsupp.degree m + 1) x)
    rw [AdicCompletion.eval_apply, AdicCompletion.eval_apply, AdicCompletion.val_smul_apply,
      map_smul]

/-! ### The comparison map `A[[x]] → Â[x]` into the `(x)`-adic completion -/

/-- Truncation of a power series at total degree `n`, as a compatible family of polynomials
modulo `(x)^n`. -/
def seriesToCompletion [Finite σ] (g : MvPowerSeries σ A) :
    AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) :=
  ⟨fun n => Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) n))
      (MvPowerSeries.truncTotal n g), by
    intro m n hmn
    have hmem : MvPowerSeries.truncTotal n g - MvPowerSeries.truncTotal m g
        ∈ (varsTop (A := A) (σ := σ) m) := by
      rw [varsTop, Ideal.smul_eq_mul, Ideal.mul_top, MvPolynomial.mem_pow_idealOfVars_iff']
      intro x hx
      rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal g (by omega),
        MvPowerSeries.coeff_truncTotal g (by omega), sub_self]
    have hq : Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) m))
          (MvPowerSeries.truncTotal n g)
        = Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) m))
            (MvPowerSeries.truncTotal m g) := by
      rw [Submodule.Quotient.eq]
      simpa only [varsTop, Ideal.smul_eq_mul, Ideal.mul_top] using hmem
    rw [AdicCompletion.transitionMap, Submodule.factorPow]
    exact hq⟩

@[simp]
theorem eval_seriesToCompletion [Finite σ] (n : ℕ) (g : MvPowerSeries σ A) :
    AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n (seriesToCompletion g)
      = Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) n))
          (MvPowerSeries.truncTotal n g) :=
  rfl

/-- `seriesToCompletion` as an `A`-linear map. -/
def seriesToCompletionLM [Finite σ] :
    MvPowerSeries σ A →ₗ[A] AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) where
  toFun := seriesToCompletion
  map_add' g h := by
    apply AdicCompletion.ext
    intro n
    have key : AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
          (seriesToCompletion (g + h))
        = AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
            (seriesToCompletion g)
          + AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
              (seriesToCompletion h) := by
      rw [eval_seriesToCompletion, eval_seriesToCompletion, eval_seriesToCompletion, map_add]
      exact map_add (Submodule.mkQ (varsTop (A := A) (σ := σ) n))
        (MvPowerSeries.truncTotal n g) (MvPowerSeries.truncTotal n h)
    rw [AdicCompletion.val_add_apply]
    exact key
  map_smul' a g := by
    apply AdicCompletion.ext
    intro n
    have key : AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
          (seriesToCompletion (a • g))
        = a • AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
              (seriesToCompletion g) := by
      rw [eval_seriesToCompletion, eval_seriesToCompletion, map_smul]
      exact map_smul ((Submodule.mkQ (varsTop (A := A) (σ := σ) n)).restrictScalars A) a
        (MvPowerSeries.truncTotal n g)
    rw [AdicCompletion.val_smul_apply]
    simp only [RingHom.id_apply]
    exact key

@[simp]
theorem eval_seriesToCompletionLM [Finite σ] (n : ℕ) (g : MvPowerSeries σ A) :
    AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A) n
        (seriesToCompletionLM (A := A) (σ := σ) g)
      = Submodule.Quotient.mk (p := (varsTop (A := A) (σ := σ) n))
          (MvPowerSeries.truncTotal n g) :=
  rfl

/-! ### The retraction `Â[x] → A[[x]] → Â[x]` is the identity -/

theorem completionToSeries_seriesToCompletion [Finite σ] :
    (completionToSeriesLM (A := A) (σ := σ)).comp (seriesToCompletionLM (A := A) (σ := σ))
      = LinearMap.id := by
  ext g m
  show coeffQ (A := A) (Finsupp.degree m + 1) m (Nat.lt_succ_self _)
      (AdicCompletion.eval (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)
        (Finsupp.degree m + 1) (seriesToCompletionLM (A := A) (σ := σ) g)) = g m
  rw [eval_seriesToCompletionLM, coeffQ_mk]
  exact MvPowerSeries.coeff_truncTotal g (Nat.lt_succ_self _)

/-! ### Flatness -/

/-- `A[[xᵢ : i ∈ σ]]` is flat over `A` when `A` is Noetherian. -/
theorem flat [Finite σ] [IsNoetherianRing A] : Module.Flat A (MvPowerSeries σ A) := by
  haveI h1 : Module.Flat (MvPolynomial σ A)
      (AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)) :=
    AdicCompletion.flat_of_isNoetherian (varsIdeal (A := A) (σ := σ))
  haveI h2 : Module.Flat A (AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A)) :=
    Module.Flat.trans A (MvPolynomial σ A) (AdicCompletion (varsIdeal (A := A) (σ := σ))
      (MvPolynomial σ A))
  exact Module.Flat.of_retract (R := A)
    (M := AdicCompletion (varsIdeal (A := A) (σ := σ)) (MvPolynomial σ A))
    (N := MvPowerSeries σ A) (f := h2) seriesToCompletionLM completionToSeriesLM
    completionToSeries_seriesToCompletion

/-! ### Faithfulness -/

/-- The constant coefficient as an `A`-linear map (evaluation of a power series at `x = 0`). -/
def constantCoeffLM : MvPowerSeries σ A →ₗ[A] A where
  toFun := MvPowerSeries.constantCoeff
  map_add' x y := map_add _ x y
  map_smul' a f := by
    rw [MvPowerSeries.smul_eq_C_mul, map_mul, MvPowerSeries.constantCoeff_C]
    rfl

theorem constantCoeff_mem_of_mem_smul (m : Ideal A)
    (x : MvPowerSeries σ A) (hx : x ∈ m • (⊤ : Submodule A (MvPowerSeries σ A))) :
    MvPowerSeries.constantCoeff x ∈ m := by
  refine Submodule.smul_induction_on (p := fun x => MvPowerSeries.constantCoeff x ∈ m) hx
    (fun r hr y _ => ?_) (fun x y hx hy => ?_)
  · rw [MvPowerSeries.smul_eq_C_mul, map_mul, MvPowerSeries.constantCoeff_C]
    exact Ideal.mul_mem_right _ m hr
  · rw [map_add]
    exact Ideal.add_mem m hx hy

/-- `A[[xᵢ : i ∈ σ]]` is faithfully flat over a Noetherian ring `A`. -/
theorem faithfullyFlat [Finite σ] [IsNoetherianRing A] :
    Module.FaithfullyFlat A (MvPowerSeries σ A) :=
  Module.FaithfullyFlat.mk (toFlat := flat (A := A) (σ := σ)) (fun m hm htop => by
    have h1 : (1 : MvPowerSeries σ A) ∈ m • (⊤ : Submodule A (MvPowerSeries σ A)) := by
      rw [htop]; exact Submodule.mem_top
    have h2 : MvPowerSeries.constantCoeff (1 : MvPowerSeries σ A) ∈ m :=
      constantCoeff_mem_of_mem_smul m 1 h1
    exact hm.ne_top (Ideal.eq_top_iff_one m |>.mpr (by simpa using h2)))

/-- The splitting argument of the source proof: for every `A`-module `M`, the natural map
`M → M ⊗_A A[[x]]`, `m ↦ m ⊗ 1`, is injective (so tensoring with `A[[x]]` cannot kill a nonzero
module).  This is the "faithful" half of faithful flatness in its functorial form. -/
theorem tensorProduct_injective (M : Type*) [AddCommGroup M] [Module A M] :
    Function.Injective (fun m : M => m ⊗ₜ[A] (1 : MvPowerSeries σ A)) := by
  intro m₁ m₂ h
  have h' : m₁ ⊗ₜ[A] (1 : A) = m₂ ⊗ₜ[A] (1 : A) := by
    have hmap := congrArg (TensorProduct.map (LinearMap.id : M →ₗ[A] M) (constantCoeffLM (σ := σ))) h
    simpa [TensorProduct.map_tmul, constantCoeffLM] using hmap
  rw [← TensorProduct.rid_symm_apply, ← TensorProduct.rid_symm_apply] at h'
  exact (TensorProduct.rid A M).symm.injective h'

end

/-- Atiyah–Macdonald, Exercise 10.12: if `A` is Noetherian, then `A[[x₁, …, xₙ]]` is a faithfully
flat `A`-algebra. -/
theorem solution (A : Type*) [CommRing A] [IsNoetherianRing A] (σ : Type*) [Finite σ] :
    Module.FaithfullyFlat A (MvPowerSeries σ A) :=
  faithfullyFlat (A := A) (σ := σ)

/-- The same statement in the form "the ring homomorphism `A → A[[x₁, …, xₙ]]` is faithfully
flat", i.e. `B` is a faithfully flat `A`-*algebra*. -/
theorem solution_algebraMap (A : Type*) [CommRing A] [IsNoetherianRing A] (σ : Type*) [Finite σ] :
    RingHom.FaithfullyFlat (algebraMap A (MvPowerSeries σ A)) :=
  RingHom.faithfullyFlat_algebraMap_iff.mpr (solution A σ)

end AtiyahMcdonald69.Ex_10_12
