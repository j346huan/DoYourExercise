/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 1, Exercise 1.20.

Let `X` be a topological space.

a. If `Y` is an irreducible subspace of `X`, then the closure `Ȳ` of `Y` in `X` is irreducible.
b. Every irreducible subspace of `X` is contained in a maximal irreducible subspace.
c. The maximal irreducible subspaces of `X` are closed and cover `X`. What are the irreducible
   components of a Hausdorff space?
d. What are the irreducible components of `Spec(A)`?

Formalisation notes.

* The book (Chapter 1, §1) calls a space irreducible when it is non-empty and any two non-empty
  open subsets meet; a subset `Y ⊆ X` is an irreducible subspace when the subspace `Y` is
  irreducible, i.e. when any two non-empty relatively open subsets of `Y` meet.  This is exactly
  Mathlib's `IsIrreducible Y`: its second component quantifies over `U`, `V` open in `X` and asks
  the non-empty sets `Y ∩ U`, `Y ∩ V` to meet inside `Y`; the relatively open subsets of `Y` are
  precisely the sets `Y ∩ U`.  Non-emptiness of `Y` is the first component.
* `IsIrredComponent Y` is the book's "maximal irreducible subspace", i.e. an irreducible
  component.
* In part (d), `V E` is the book's set of prime ideals containing `E`; it is definitionally the
  zero locus `PrimeSpectrum.zeroLocus E` of Mathlib's Zariski topology on `Spec A`.
* Part (d) follows the book's own argument.  Besides the definitional description of Mathlib's
  Zariski topology (the closed sets are the zero loci `V(E)`, and `V(E) ⊆ V(F)` exactly when
  `F` lies in the radical of the ideal generated by `E`), the only auxiliary fact used is that
  the vanishing ideal of `V(I)` is the radical of `I`
  (`PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical`), which is Atiyah–Macdonald
  Proposition 1.8, a result of the main text rather than an exercise.  The basis of basic open
  sets `X_f` is proved here from scratch (`exists_basicOpen_subset`) and every other step is
  proved from the definitions, so no exercise of Chapter 1 is assumed.
-/
import Mathlib

/- Natural-language solution: https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-1-20 -/


open Set

namespace AtiyahMcdonald69.Ex_1_20

section GeneralTopology

variable {X : Type*} [TopologicalSpace X]

/-! ### Part (a): the closure of an irreducible subspace is irreducible -/

/-- Exercise 1.20 (a). If `Y` is an irreducible subspace of `X`, then its closure is
irreducible. -/
theorem part_a {Y : Set X} (hY : IsIrreducible Y) : IsIrreducible (closure Y) := by
  refine ⟨closure_nonempty_iff.mpr hY.1, ?_⟩
  intro U V hU hV hUY hVY
  -- An open set meeting `closure Y` meets `Y`.
  have key : ∀ {W : Set X}, IsOpen W → (closure Y ∩ W).Nonempty → (Y ∩ W).Nonempty := by
    intro W hW h
    obtain ⟨x, hx, hxW⟩ := h
    obtain ⟨y, hyW, hyY⟩ := (mem_closure_iff.mp hx) W hW hxW
    exact ⟨y, hyY, hyW⟩
  obtain ⟨x, hxY, hxU⟩ := key hU hUY
  obtain ⟨y, hyY, hyV⟩ := key hV hVY
  obtain ⟨z, hzY, hzU, hzV⟩ := hY.2 U V hU hV ⟨x, hxY, hxU⟩ ⟨y, hyY, hyV⟩
  exact ⟨z, subset_closure hzY, hzU, hzV⟩

/-! ### Part (b): every irreducible subspace lies in a maximal one -/

/-- The book's notion of an irreducible component: a maximal irreducible subspace. -/
def IsIrredComponent (Y : Set X) : Prop :=
  IsIrreducible Y ∧ ∀ Z : Set X, IsIrreducible Z → Y ⊆ Z → Z = Y

/-- The union of a chain of irreducible subspaces is irreducible. -/
theorem isIrreducible_sUnion_isChain {c : Set (Set X)} (hc : IsChain (· ⊆ ·) c)
    (hirr : ∀ Y ∈ c, IsIrreducible Y) (hne : c.Nonempty) : IsIrreducible (⋃₀ c) := by
  obtain ⟨Y₀, hY₀⟩ := hne
  have hne' : (⋃₀ c).Nonempty := by
    obtain ⟨x, hx⟩ := (hirr Y₀ hY₀).1
    exact ⟨x, mem_sUnion_of_mem hx hY₀⟩
  refine ⟨hne', ?_⟩
  intro U V hU hV hU' hV'
  obtain ⟨x, hx, hxU⟩ := hU'
  obtain ⟨y, hy, hyV⟩ := hV'
  obtain ⟨Y₁, hY₁, hxY₁⟩ := mem_sUnion.mp hx
  obtain ⟨Y₂, hY₂, hyY₂⟩ := mem_sUnion.mp hy
  have hcases : Y₁ ⊆ Y₂ ∨ Y₂ ⊆ Y₁ := by
    rcases eq_or_ne Y₁ Y₂ with hEq | hNe
    · exact Or.inl hEq.le
    · exact hc hY₁ hY₂ hNe
  rcases hcases with h12 | h21
  · obtain ⟨z, hz, hzU, hzV⟩ :=
      (hirr Y₂ hY₂).2 U V hU hV ⟨x, h12 hxY₁, hxU⟩ ⟨y, hyY₂, hyV⟩
    exact ⟨z, mem_sUnion_of_mem hz hY₂, hzU, hzV⟩
  · obtain ⟨z, hz, hzU, hzV⟩ :=
      (hirr Y₁ hY₁).2 U V hU hV ⟨x, hxY₁, hxU⟩ ⟨y, h21 hyY₂, hyV⟩
    exact ⟨z, mem_sUnion_of_mem hz hY₁, hzU, hzV⟩

/-- Exercise 1.20 (b). Every irreducible subspace of `X` is contained in a maximal
irreducible subspace. -/
theorem part_b {Y : Set X} (hY : IsIrreducible Y) :
    ∃ C : Set X, IsIrredComponent C ∧ Y ⊆ C := by
  have hbound : ∀ c ⊆ {Z : Set X | Y ⊆ Z ∧ IsIrreducible Z}, IsChain (· ⊆ ·) c →
      c.Nonempty → ∃ ub ∈ {Z : Set X | Y ⊆ Z ∧ IsIrreducible Z}, ∀ s ∈ c, s ⊆ ub := by
    intro c hcS hcc hcne
    refine ⟨⋃₀ c, ⟨?_, isIrreducible_sUnion_isChain hcc (fun Z hZ => (hcS hZ).2) hcne⟩,
      fun Z hZ => subset_sUnion_of_mem hZ⟩
    intro y hy
    obtain ⟨Z, hZ⟩ := hcne
    exact mem_sUnion_of_mem ((hcS hZ).1 hy) hZ
  obtain ⟨C, hYC, hCmax⟩ :=
    zorn_subset_nonempty {Z : Set X | Y ⊆ Z ∧ IsIrreducible Z} hbound Y ⟨subset_rfl, hY⟩
  refine ⟨C, ⟨hCmax.1.2, ?_⟩, hYC⟩
  intro Z hZ hCZ
  exact le_antisymm (hCmax.2 ⟨hYC.trans hCZ, hZ⟩ hCZ) hCZ

/-! ### Part (c): components are closed, cover the space, and in a Hausdorff space are
exactly the singletons -/

/-- Exercise 1.20 (c), first assertion: every maximal irreducible subspace is closed. -/
theorem part_c_closed {C : Set X} (hC : IsIrredComponent C) : IsClosed C := by
  rw [← closure_eq_iff_isClosed]
  exact hC.2 (closure C) (part_a hC.1) subset_closure

/-- Exercise 1.20 (c), second assertion: the maximal irreducible subspaces cover `X`. -/
theorem part_c_cover (x : X) : ∃ C : Set X, IsIrredComponent C ∧ x ∈ C := by
  obtain ⟨C, hC, hxC⟩ := part_b (Y := {x}) isIrreducible_singleton
  exact ⟨C, hC, hxC (mem_singleton x)⟩

/-- In an irreducible subspace, a covering by two closed sets can be reduced to one of them. -/
theorem subset_left_or_right_of_isClosed {Y z₁ z₂ : Set X} (hY : IsIrreducible Y)
    (h₁ : IsClosed z₁) (h₂ : IsClosed z₂) (hcov : Y ⊆ z₁ ∪ z₂) : Y ⊆ z₁ ∨ Y ⊆ z₂ := by
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨h1, h2⟩ := hcon
  obtain ⟨x, hxY, hx1⟩ := Set.not_subset.mp h1
  obtain ⟨y, hyY, hy2⟩ := Set.not_subset.mp h2
  have ho1 : IsOpen z₁ᶜ := h₁.isOpen_compl
  have ho2 : IsOpen z₂ᶜ := h₂.isOpen_compl
  obtain ⟨z, hzY, hz1, hz2⟩ := hY.2 z₁ᶜ z₂ᶜ ho1 ho2 ⟨x, hxY, hx1⟩ ⟨y, hyY, hy2⟩
  rcases hcov hzY with hz | hz
  · exact hz1 hz
  · exact hz2 hz

/-- In a Hausdorff space every irreducible subspace has at most one point. -/
theorem subsingleton_of_isIrreducible [T2Space X] {Y : Set X} (hY : IsIrreducible Y) :
    Y.Subsingleton := by
  intro x hx y hy
  by_contra hxy
  obtain ⟨U, V, hU, hV, hxU, hyV, hdisj⟩ := t2_separation hxy
  obtain ⟨z, _, hzU, hzV⟩ := hY.2 U V hU hV ⟨x, hx, hxU⟩ ⟨y, hy, hyV⟩
  exact absurd (hdisj.le_bot ⟨hzU, hzV⟩) (by simp)

/-- Exercise 1.20 (c), Hausdorff case: the irreducible components of a Hausdorff space are
precisely the one-point subsets. -/
theorem part_c_hausdorff [T2Space X] (C : Set X) :
    IsIrredComponent C ↔ ∃ x : X, C = {x} := by
  constructor
  · intro hC
    obtain ⟨x, hx⟩ := hC.1.1
    exact ⟨x, (subsingleton_of_isIrreducible hC.1).eq_singleton_of_mem hx⟩
  · rintro ⟨x, rfl⟩
    refine ⟨isIrreducible_singleton, ?_⟩
    intro Z hZ hsub
    exact (subsingleton_of_isIrreducible hZ).eq_singleton_of_mem (hsub (mem_singleton x))

/-- Exercise 1.20 (c), combined form: the maximal irreducible subspaces of `X` are closed and
they cover `X`. -/
theorem part_c :
    (∀ C : Set X, IsIrredComponent C → IsClosed C) ∧
      ⋃₀ {C : Set X | IsIrredComponent C} = univ := by
  refine ⟨fun C hC => part_c_closed hC, ?_⟩
  ext x
  refine ⟨fun _ => mem_univ x, fun _ => ?_⟩
  obtain ⟨C, hC, hxC⟩ := part_c_cover x
  exact mem_sUnion_of_mem hxC hC

end GeneralTopology

/-! ### Part (d): the irreducible components of `Spec A` -/

section Spectrum

variable {R : Type*} [CommRing R]

/-- The book's `V(E)`: the set of all prime ideals containing `E`. -/
def V (E : Set R) : Set (PrimeSpectrum R) := {p | E ⊆ (p.asIdeal : Set R)}

theorem mem_V {E : Set R} {p : PrimeSpectrum R} : p ∈ V E ↔ E ⊆ (p.asIdeal : Set R) :=
  Iff.rfl

/-- `V E` is precisely the zero locus of `E`: a closed set of the Zariski topology. -/
theorem V_eq_zeroLocus (E : Set R) : V E = PrimeSpectrum.zeroLocus E := rfl

/-- The basic open sets `X_f = {p : f ∉ p}` form a basis of the Zariski topology: every open
set `U` and every `p ∈ U` admit `f` with `p ∈ X_f ⊆ U`. -/
theorem exists_basicOpen_subset {U : Set (PrimeSpectrum R)} (hU : IsOpen U)
    {p : PrimeSpectrum R} (hp : p ∈ U) :
    ∃ f : R, p ∈ (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) ∧
      (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) ⊆ U := by
  obtain ⟨s, hs⟩ := (PrimeSpectrum.isOpen_iff U).mp hU
  have hps : p ∉ PrimeSpectrum.zeroLocus s := by
    rw [← hs]
    simpa using hp
  rw [PrimeSpectrum.mem_zeroLocus] at hps
  obtain ⟨f, hfs, hfp⟩ := Set.not_subset.mp hps
  refine ⟨f, (PrimeSpectrum.mem_basicOpen f p).mpr hfp, ?_⟩
  · intro q hq
    have hqf : f ∉ q.asIdeal := (PrimeSpectrum.mem_basicOpen f q).mp hq
    have hq' : q ∉ PrimeSpectrum.zeroLocus s := by
      rw [PrimeSpectrum.mem_zeroLocus]
      exact fun hsub => hqf (hsub hfs)
    have hqU : q ∉ Uᶜ := by
      rw [hs]
      exact hq'
    exact not_not.mp hqU

/-- For a prime ideal `P`, the closed set `V(P)` is an irreducible subspace of `Spec A`. -/
theorem isIrreducible_V {P : Ideal R} (hP : P.IsPrime) : IsIrreducible (V (P : Set R)) := by
  constructor
  · exact ⟨⟨P, hP⟩, fun _ hx => hx⟩
  · intro U W hU hW hU' hW'
    obtain ⟨x, hxV, hxU⟩ := hU'
    obtain ⟨y, hyV, hyW⟩ := hW'
    obtain ⟨f, hf, hfU⟩ := exists_basicOpen_subset hU hxU
    obtain ⟨g, hg, hgW⟩ := exists_basicOpen_subset hW hyW
    have hfx : f ∉ x.asIdeal := (PrimeSpectrum.mem_basicOpen f x).mp hf
    have hgy : g ∉ y.asIdeal := (PrimeSpectrum.mem_basicOpen g y).mp hg
    have hfP : f ∉ P := fun h => hfx ((mem_V.mp hxV) h)
    have hgP : g ∉ P := fun h => hgy ((mem_V.mp hyV) h)
    have hfgP : f * g ∉ P := hP.mul_notMem hfP hgP
    -- `X_f ∩ X_g = X_{fg}`, and `P` lies in it because `P` is prime and `f * g ∉ P`.
    have hPmem : (⟨P, hP⟩ : PrimeSpectrum R) ∈
        (PrimeSpectrum.basicOpen (f * g) : Set (PrimeSpectrum R)) :=
      (PrimeSpectrum.mem_basicOpen (f * g) ⟨P, hP⟩).mpr hfgP
    have hsub : (PrimeSpectrum.basicOpen (f * g) : Set (PrimeSpectrum R)) ⊆ U ∩ W := by
      rw [PrimeSpectrum.basicOpen_mul, TopologicalSpace.Opens.coe_inf]
      exact Set.inter_subset_inter hfU hgW
    exact ⟨⟨P, hP⟩, mem_V.mpr fun _ hx => hx, hsub hPmem⟩

/-- A closed irreducible subspace of `Spec A` is `V(P)` for a prime ideal `P`. -/
theorem exists_isPrime_of_isClosed_isIrreducible {Z : Set (PrimeSpectrum R)} (hZ : IsClosed Z)
    (hZirr : IsIrreducible Z) :
    ∃ P : Ideal R, P.IsPrime ∧ Z = V (P : Set R) := by
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z).mp hZ
  subst hI
  refine ⟨I.radical, ?_, (PrimeSpectrum.zeroLocus_radical I).symm⟩
  rw [Ideal.isPrime_iff]
  constructor
  · -- `I.radical ≠ ⊤`, since `V(I)` is non-empty
    intro htop
    obtain ⟨p, hp⟩ := hZirr.1
    have hp' : p ∈ PrimeSpectrum.zeroLocus (I.radical : Set R) :=
      (PrimeSpectrum.zeroLocus_radical I).symm ▸ hp
    have hprad : (I.radical : Set R) ⊆ (p.asIdeal : Set R) :=
      (PrimeSpectrum.mem_zeroLocus p (I.radical : Set R)).mp hp'
    have htop' : (⊤ : Ideal R) ≤ p.asIdeal := by
      rw [← htop]
      exact hprad
    exact p.isPrime.ne_top (top_le_iff.mp htop')
  · intro f g hfg
    by_contra hcon
    rw [not_or] at hcon
    obtain ⟨hf, hg⟩ := hcon
    -- The two closed sets `V(rad I + (f))` and `V(rad I + (g))` cover `V(I)`.
    have hcl₁ : IsClosed (V ((I.radical ⊔ Ideal.span {f} : Ideal R) : Set R)) :=
      PrimeSpectrum.isClosed_zeroLocus _
    have hcl₂ : IsClosed (V ((I.radical ⊔ Ideal.span {g} : Ideal R) : Set R)) :=
      PrimeSpectrum.isClosed_zeroLocus _
    have hcov : V (I : Set R) ⊆
        V ((I.radical ⊔ Ideal.span {f} : Ideal R) : Set R) ∪
          V ((I.radical ⊔ Ideal.span {g} : Ideal R) : Set R) := by
      intro p hp
      have hp' : p ∈ PrimeSpectrum.zeroLocus (I.radical : Set R) :=
        (PrimeSpectrum.zeroLocus_radical I).symm ▸ hp
      have hprad : (I.radical : Set R) ⊆ (p.asIdeal : Set R) :=
        (PrimeSpectrum.mem_zeroLocus p (I.radical : Set R)).mp hp'
      have hfgp : f * g ∈ p.asIdeal := hprad hfg
      rcases p.isPrime.mem_or_mem hfgp with hfp | hgp
      · refine Or.inl (mem_V.mpr ?_)
        exact sup_le (show I.radical ≤ p.asIdeal from hprad)
          ((Ideal.span_singleton_le_iff_mem p.asIdeal).mpr hfp)
      · refine Or.inr (mem_V.mpr ?_)
        exact sup_le (show I.radical ≤ p.asIdeal from hprad)
          ((Ideal.span_singleton_le_iff_mem p.asIdeal).mpr hgp)
    rcases subset_left_or_right_of_isClosed hZirr hcl₁ hcl₂ hcov with hsub | hsub
    · have hle : I.radical ⊔ Ideal.span {f} ≤ I.radical := by
        have h := (PrimeSpectrum.subset_zeroLocus_iff_le_vanishingIdeal
          (PrimeSpectrum.zeroLocus (I : Set R)) (I.radical ⊔ Ideal.span {f})).mp hsub
        rwa [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical I] at h
      exact hf (hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self f)))
    · have hle : I.radical ⊔ Ideal.span {g} ≤ I.radical := by
        have h := (PrimeSpectrum.subset_zeroLocus_iff_le_vanishingIdeal
          (PrimeSpectrum.zeroLocus (I : Set R)) (I.radical ⊔ Ideal.span {g})).mp hsub
        rwa [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical I] at h
      exact hg (hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self g)))

/-- The book's notion of a minimal prime ideal: a prime ideal containing no smaller prime
ideal. -/
def IsMinPrime (P : Ideal R) : Prop :=
  P.IsPrime ∧ ∀ Q : Ideal R, Q.IsPrime → Q ≤ P → Q = P

/-- `IsMinPrime P` is exactly minimality of `P` among the prime ideals. -/
theorem isMinPrime_iff_minimal (P : Ideal R) : IsMinPrime P ↔ Minimal Ideal.IsPrime P := by
  constructor
  · rintro ⟨hP, hmin⟩
    exact ⟨hP, fun Q hQ hQP => (hmin Q hQ hQP).ge⟩
  · rintro ⟨hP, hmin⟩
    exact ⟨hP, fun Q hQ hQP => le_antisymm hQP (hmin hQ hQP)⟩

/-- Cross-check of the notion against Mathlib's `IsMinimalPrime` (a minimal prime of the
ring). -/
theorem isMinPrime_iff_isMinimalPrime (P : Ideal R) : IsMinPrime P ↔ IsMinimalPrime P := by
  rw [isMinPrime_iff_minimal, IsMinimalPrime.iff_minimal]

/-- Exercise 1.20 (d). The irreducible components of `Spec A` are precisely the closed sets
`V(P)` for minimal prime ideals `P`. -/
theorem part_d (Y : Set (PrimeSpectrum R)) :
    IsIrredComponent Y ↔ ∃ P : Ideal R, IsMinPrime P ∧ Y = V (P : Set R) := by
  constructor
  · rintro ⟨hYirr, hYmax⟩
    obtain ⟨P, hP, hcl⟩ := exists_isPrime_of_isClosed_isIrreducible isClosed_closure (part_a hYirr)
    have hYeq : Y = V (P : Set R) :=
      (hYmax (V (P : Set R)) (isIrreducible_V hP) (by rw [← hcl]; exact subset_closure)).symm
    refine ⟨P, ⟨hP, ?_⟩, hYeq⟩
    -- minimality: a smaller prime `Q` gives the larger irreducible subspace `V(Q)`
    intro Q hQ hQP
    have hsub : V (P : Set R) ⊆ V (Q : Set R) := fun r hr => mem_V.mpr (hQP.trans (mem_V.mp hr))
    have hVQ : V (Q : Set R) = V (P : Set R) := by
      have h1 : V (Q : Set R) = Y := by
        refine hYmax (V (Q : Set R)) (isIrreducible_V hQ) ?_
        rw [hYeq]
        exact hsub
      rw [h1, hYeq]
    have hPQ : P ≤ Q := by
      have hmem : (⟨Q, hQ⟩ : PrimeSpectrum R) ∈ V (Q : Set R) := mem_V.mpr fun _ hx => hx
      rw [hVQ] at hmem
      exact mem_V.mp hmem
    exact le_antisymm hQP hPQ
  · rintro ⟨P, ⟨hP, hPmin⟩, rfl⟩
    refine ⟨isIrreducible_V hP, ?_⟩
    intro Z hZ hsub
    obtain ⟨Q, hQ, hcl⟩ := exists_isPrime_of_isClosed_isIrreducible isClosed_closure (part_a hZ)
    have hQP : Q ≤ P := by
      have hmem : (⟨P, hP⟩ : PrimeSpectrum R) ∈ V (Q : Set R) := by
        rw [← hcl]
        exact subset_closure (hsub (mem_V.mpr fun _ hx => hx))
      exact mem_V.mp hmem
    rw [hPmin Q hQ hQP] at hcl
    refine le_antisymm ?_ hsub
    rw [← hcl]
    exact subset_closure

/-- Exercise 1.20 (d), plural (book) form: the set of irreducible components of `Spec A` is
exactly the set of `V(P)` for minimal prime ideals `P`. -/
theorem part_d_image :
    {Y : Set (PrimeSpectrum R) | IsIrredComponent Y}
      = {Y | ∃ P : Ideal R, IsMinPrime P ∧ Y = V (P : Set R)} :=
  Set.ext part_d

end Spectrum

end AtiyahMcdonald69.Ex_1_20
