import Mathlib

/-!
# Atiyah–Macdonald (1969), Chapter 3, Exercise 9: the total ring of fractions

Let `A` be a commutative ring.  The set `S₀` of non-zero-divisors of `A` is a saturated
multiplicatively closed subset of `A`; the set `D` of zero-divisors is a union of prime ideals, and
every minimal prime ideal of `A` is contained in `D`.  The ring `S₀⁻¹A` is the *total ring of
fractions* of `A`, and:

(i)  `S₀` is the largest multiplicatively closed subset `S ⊆ A` for which `A → S⁻¹A` is injective;
(ii) every element of `S₀⁻¹A` is a unit or a zero-divisor;
(iii) if every non-unit of `A` is a zero-divisor then `A → S₀⁻¹A` is bijective.

The statement formalized here is Exercise 9 on p. 44 of Atiyah–Macdonald, *Introduction to
Commutative Algebra* (1969).  The book states the exercise for `A ≠ 0`; no argument below needs
that hypothesis (in the zero ring `S₀` is the whole ring and `D` is empty).
-/

namespace AtiyahMcdonald69.Ex_3_9

open scoped nonZeroDivisors

variable {A : Type*} [CommRing A]

/-! ### The set of zero-divisors -/

/-- The set `D` of zero-divisors of a commutative ring, i.e. the complement of the submonoid
`S₀ = nonZeroDivisors A` of non-zero-divisors. -/
def zeroDivisors (A : Type*) [CommRing A] : Set A := (nonZeroDivisors A : Set A)ᶜ

/-- The **total ring of fractions** of a commutative ring `A`: the localization `S₀⁻¹A` of `A` at
the multiplicative set `S₀` of non-zero-divisors. -/
abbrev totalRingOfFractions (A : Type*) [CommRing A] := Localization (nonZeroDivisors A)

/-- Membership in `D`: `a` is a zero-divisor iff `a * b = 0` for some `b ≠ 0`. -/
theorem mem_zeroDivisors_iff {a : A} : a ∈ zeroDivisors A ↔ ∃ b ≠ 0, a * b = 0 := by
  rw [zeroDivisors, Set.mem_compl_iff, SetLike.mem_coe, notMem_nonZeroDivisors_iff]
  constructor
  · rintro (⟨b, hb, hb0⟩ | ⟨b, hb, hb0⟩)
    · exact ⟨b, hb0, hb⟩
    · exact ⟨b, hb0, by rwa [mul_comm] at hb⟩
  · rintro ⟨b, hb0, hb⟩
    exact Or.inl ⟨b, hb, hb0⟩

/-- An element of `A` which is not a zero-divisor is a non-zero-divisor. -/
theorem mem_nonZeroDivisors_of_notMem_zeroDivisors {a : A}
    (ha : a ∉ zeroDivisors A) : a ∈ nonZeroDivisors A := by
  by_contra h
  exact ha h

/-- A multiple of a zero-divisor is a zero-divisor. -/
theorem mul_mem_zeroDivisors_left {a : A} (ha : a ∈ zeroDivisors A) (r : A) :
    r * a ∈ zeroDivisors A := by
  obtain ⟨b, hb0, hb⟩ := mem_zeroDivisors_iff.mp ha
  rw [mem_zeroDivisors_iff]
  exact ⟨b, hb0, by rw [mul_assoc, hb, mul_zero]⟩

/-- A multiple of a zero-divisor is a zero-divisor. -/
theorem mul_mem_zeroDivisors_right {a : A} (ha : a ∈ zeroDivisors A) (r : A) :
    a * r ∈ zeroDivisors A := by
  rw [mul_comm]
  exact mul_mem_zeroDivisors_left ha r

/-- The principal ideal generated by a zero-divisor consists of zero-divisors. -/
theorem ideal_span_singleton_subset_zeroDivisors {a : A} (ha : a ∈ zeroDivisors A) :
    (Ideal.span {a} : Set A) ⊆ zeroDivisors A := by
  intro x hx
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
  exact mul_mem_zeroDivisors_left ha c

/-! ### `S₀` is saturated, and `D` is a union of prime ideals -/

/-- The multiplicatively closed set `S₀` of non-zero-divisors is saturated:
`x * y ∈ S₀ ↔ x ∈ S₀ ∧ y ∈ S₀`. -/
theorem isSaturated_nonZeroDivisors {x y : A} :
    x * y ∈ nonZeroDivisors A ↔ x ∈ nonZeroDivisors A ∧ y ∈ nonZeroDivisors A := by
  rw [← isRegular_iff_mem_nonZeroDivisors, isRegular_mul_iff,
    isRegular_iff_mem_nonZeroDivisors, isRegular_iff_mem_nonZeroDivisors]

/-- `S₀` is multiplicatively closed. -/
theorem mul_mem_nonZeroDivisors {x y : A} (hx : x ∈ nonZeroDivisors A)
    (hy : y ∈ nonZeroDivisors A) : x * y ∈ nonZeroDivisors A :=
  isSaturated_nonZeroDivisors.mpr ⟨hx, hy⟩

/-- Every zero-divisor lies in a prime ideal all of whose elements are zero-divisors.  Together
with its converse this is the assertion that `D` is a union of prime ideals. -/
theorem exists_isPrime_mem_zeroDivisors {a : A} (ha : a ∈ zeroDivisors A) :
    ∃ p : Ideal A, p.IsPrime ∧ a ∈ p ∧ (p : Set A) ⊆ zeroDivisors A := by
  have hdisj : Disjoint (Ideal.span {a} : Set A) (nonZeroDivisors A : Set A) :=
    Set.disjoint_left.mpr fun x hx hxS₀ => ideal_span_singleton_subset_zeroDivisors ha hx hxS₀
  obtain ⟨p, hp, hle, hpd⟩ :=
    Ideal.exists_le_prime_disjoint (Ideal.span {a}) (nonZeroDivisors A) hdisj
  exact ⟨p, hp, hle (Ideal.mem_span_singleton_self a), fun x hx => Set.disjoint_left.mp hpd hx⟩

/-- The set of zero-divisors is the union of the prime ideals contained in it. -/
theorem zeroDivisors_eq_iUnion_primes :
    zeroDivisors A = ⋃ p : {p : Ideal A // p.IsPrime ∧ (p : Set A) ⊆ zeroDivisors A},
      (p.1 : Set A) := by
  ext a
  rw [Set.mem_iUnion]
  constructor
  · intro ha
    obtain ⟨p, hp, hap, hpd⟩ := exists_isPrime_mem_zeroDivisors ha
    exact ⟨⟨p, hp, hpd⟩, hap⟩
  · rintro ⟨p, hp⟩
    exact p.2.2 hp

/-- Every minimal prime ideal of `A` consists of zero-divisors. -/
theorem minimalPrime_subset_zeroDivisors {p : Ideal A} (hp : p ∈ minimalPrimes A) :
    (p : Set A) ⊆ zeroDivisors A := by
  intro x hx
  exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hp) hx

/-! ### (i) `S₀` is the largest multiplicatively closed set with `A → S⁻¹A` injective -/

/-- `A → S⁻¹A` is injective exactly when `S` consists of non-zero-divisors. -/
theorem injective_iff_le_nonZeroDivisors (S : Submonoid A) :
    Function.Injective (algebraMap A (Localization S)) ↔ S ≤ nonZeroDivisors A := by
  rw [IsLocalization.injective_iff_isRegular S]
  constructor
  · intro h x hx
    exact isRegular_iff_mem_nonZeroDivisors.mp (h ⟨x, hx⟩)
  · intro h x
    exact isRegular_iff_mem_nonZeroDivisors.mpr (h x.2)

/-- Part (i) for an arbitrary localization `A'` of `A` at `S` (not necessarily the canonical
model `Localization S`): injectivity of `A → A'` forces `S ≤ S₀`. -/
theorem injective_iff_le_nonZeroDivisors_of_isLocalization {A' : Type*} [CommRing A']
    [Algebra A A'] (S : Submonoid A) [IsLocalization S A'] :
    Function.Injective (algebraMap A A') ↔ S ≤ nonZeroDivisors A := by
  rw [IsLocalization.injective_iff_isRegular S]
  constructor
  · intro h x hx
    exact isRegular_iff_mem_nonZeroDivisors.mp (h ⟨x, hx⟩)
  · intro h x
    exact isRegular_iff_mem_nonZeroDivisors.mpr (h x.2)

/-- Part (i): any multiplicatively closed `S` for which `A → S⁻¹A` is injective is contained in
`S₀`, i.e. `S₀` is the largest such subset. -/
theorem le_nonZeroDivisors_of_injective (S : Submonoid A)
    (h : Function.Injective (algebraMap A (Localization S))) : S ≤ nonZeroDivisors A :=
  (injective_iff_le_nonZeroDivisors S).mp h

/-- `A → S₀⁻¹A` is injective. -/
theorem injective_algebraMap_localization_nonZeroDivisors :
    Function.Injective (algebraMap A (Localization (nonZeroDivisors A))) :=
  (injective_iff_le_nonZeroDivisors _).mpr le_rfl

/-- Part (i), in the form in which the book states it: `S₀` is the *largest* multiplicatively
closed subset `S` of `A` for which `A → S⁻¹A` is injective. -/
theorem isGreatest_injective :
    IsGreatest {S : Submonoid A | Function.Injective (algebraMap A (Localization S))}
      (nonZeroDivisors A) :=
  ⟨injective_algebraMap_localization_nonZeroDivisors,
    fun _ hS => le_nonZeroDivisors_of_injective _ hS⟩

/-! ### (ii) Every element of `S₀⁻¹A` is a unit or a zero-divisor -/

theorem isUnit_or_mem_zeroDivisors (x : Localization (nonZeroDivisors A)) :
    IsUnit x ∨ x ∈ zeroDivisors (Localization (nonZeroDivisors A)) := by
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors A) x
  by_cases ha : a ∈ nonZeroDivisors A
  · -- `a ∈ S₀`, so `x = a / s` is a unit
    obtain ⟨u, hu⟩ := IsLocalization.map_units (Localization (nonZeroDivisors A)) s
    obtain ⟨v, hv⟩ := IsLocalization.map_units (Localization (nonZeroDivisors A)) ⟨a, ha⟩
    have hsu : x * (u : Localization (nonZeroDivisors A)) = (v : Localization (nonZeroDivisors A)) := by
      rw [hu, hv]
      exact hs
    refine Or.inl ?_
    refine ⟨v * u⁻¹, ?_⟩
    show (((v * u⁻¹ : (Localization (nonZeroDivisors A))ˣ)) : Localization (nonZeroDivisors A)) = x
    rw [Units.val_mul]
    calc (v : Localization (nonZeroDivisors A)) *
          (((u⁻¹ : (Localization (nonZeroDivisors A))ˣ)) : Localization (nonZeroDivisors A))
        = (x * (u : Localization (nonZeroDivisors A))) *
            (((u⁻¹ : (Localization (nonZeroDivisors A))ˣ)) :
              Localization (nonZeroDivisors A)) := by rw [← hsu]
      _ = x * ((u : Localization (nonZeroDivisors A)) *
            (((u⁻¹ : (Localization (nonZeroDivisors A))ˣ)) :
              Localization (nonZeroDivisors A))) := by rw [mul_assoc]
      _ = x := by rw [Units.mul_inv, mul_one]
  · -- `a ∉ S₀`, so `x = a / s` is annihilated by `b / 1` for any `b ≠ 0` with `a * b = 0`
    obtain ⟨b, hb0, hb⟩ := mem_zeroDivisors_iff.mp (show a ∈ zeroDivisors A from ha)
    refine Or.inr ?_
    rw [mem_zeroDivisors_iff]
    refine ⟨algebraMap A (Localization (nonZeroDivisors A)) (s : A) *
      algebraMap A (Localization (nonZeroDivisors A)) b, ?_, ?_⟩
    · intro hzero
      have hb' : algebraMap A (Localization (nonZeroDivisors A)) b = 0 :=
        (IsUnit.mul_right_eq_zero (IsLocalization.map_units
          (Localization (nonZeroDivisors A)) s)).mp hzero
      have hb'' : b = 0 :=
        (IsLocalization.to_map_eq_zero_iff (Localization (nonZeroDivisors A)) le_rfl).mp hb'
      exact hb0 hb''
    · calc x * (algebraMap A (Localization (nonZeroDivisors A)) (s : A) *
            algebraMap A (Localization (nonZeroDivisors A)) b)
          = x * (algebraMap A (Localization (nonZeroDivisors A)) (s : A)) *
              algebraMap A (Localization (nonZeroDivisors A)) b := by rw [mul_assoc]
        _ = algebraMap A (Localization (nonZeroDivisors A)) a *
              algebraMap A (Localization (nonZeroDivisors A)) b := by rw [hs]
        _ = algebraMap A (Localization (nonZeroDivisors A)) (a * b) := by rw [map_mul]
        _ = 0 := by rw [hb, map_zero]

/-! ### (iii) A ring in which every non-unit is a zero-divisor is its own total ring of
fractions -/

theorem bijective_algebraMap_of_forall_not_isUnit_mem_zeroDivisors
    (h : ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A) :
    Function.Bijective (algebraMap A (Localization (nonZeroDivisors A))) := by
  refine ⟨injective_algebraMap_localization_nonZeroDivisors, fun x => ?_⟩
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors A) x
  -- `s` is a non-zero-divisor, hence a unit by hypothesis
  have hs_unit : IsUnit (s : A) := by
    by_contra hns
    exact h (s : A) hns s.2
  obtain ⟨t, ht⟩ := hs_unit
  refine ⟨a * ((t⁻¹ : Aˣ) : A), ?_⟩
  have hgt : algebraMap A (Localization (nonZeroDivisors A)) (s : A) *
      algebraMap A (Localization (nonZeroDivisors A)) ((t⁻¹ : Aˣ) : A) = 1 := by
    rw [← map_mul, ← ht, Units.mul_inv, map_one]
  calc algebraMap A (Localization (nonZeroDivisors A)) (a * ((t⁻¹ : Aˣ) : A))
      = algebraMap A (Localization (nonZeroDivisors A)) a *
          algebraMap A (Localization (nonZeroDivisors A)) ((t⁻¹ : Aˣ) : A) := map_mul _ _ _
    _ = x * (algebraMap A (Localization (nonZeroDivisors A)) (s : A)) *
          algebraMap A (Localization (nonZeroDivisors A)) ((t⁻¹ : Aˣ) : A) := by rw [← hs]
    _ = x * (algebraMap A (Localization (nonZeroDivisors A)) (s : A) *
          algebraMap A (Localization (nonZeroDivisors A)) ((t⁻¹ : Aˣ) : A)) := by rw [mul_assoc]
    _ = x := by rw [hgt, mul_one]

/-- The converse of part (iii): if `A → S₀⁻¹A` is bijective then every non-unit of `A` is a
zero-divisor.  So part (iii) is really a characterization of the rings that are their own total
ring of fractions. -/
theorem forall_not_isUnit_mem_zeroDivisors_of_bijective
    (h : Function.Bijective (algebraMap A (Localization (nonZeroDivisors A)))) :
    ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A := by
  intro a ha
  by_contra hmem
  have haS₀ : a ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_notMem_zeroDivisors hmem
  obtain ⟨u, hu⟩ := IsLocalization.map_units (Localization (nonZeroDivisors A)) ⟨a, haS₀⟩
  obtain ⟨b, hb⟩ := h.2
    (((u⁻¹ : (Localization (nonZeroDivisors A))ˣ)) : Localization (nonZeroDivisors A))
  have h1 : a * b = 1 := by
    apply h.1
    rw [map_mul, ← hu, hb, Units.mul_inv, map_one]
  exact ha ⟨⟨a, b, h1, by rw [mul_comm]; exact h1⟩, rfl⟩

/-- Part (iii) as the characterization it really is: `A → S₀⁻¹A` is bijective if and only if every
non-unit of `A` is a zero-divisor. -/
theorem bijective_iff_forall_not_isUnit_mem_zeroDivisors :
    Function.Bijective (algebraMap A (Localization (nonZeroDivisors A))) ↔
      ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A :=
  ⟨forall_not_isUnit_mem_zeroDivisors_of_bijective,
    bijective_algebraMap_of_forall_not_isUnit_mem_zeroDivisors⟩

/-- Under the hypothesis of (iii) the non-zero-divisors of `A` are exactly the units, which is how
`S₀⁻¹A = A` comes about. -/
theorem nonZeroDivisors_eq_units_of_forall_not_isUnit_mem_zeroDivisors
    (h : ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A) :
    (nonZeroDivisors A : Set A) = {a | IsUnit a} := by
  ext a
  constructor
  · intro ha
    by_contra hns
    exact h a hns ha
  · intro ha
    exact ha.mem_nonZeroDivisors

/-! ### The total ring of fractions -/

/-- Part (ii) for the total ring of fractions: every element of `S₀⁻¹A` is a unit or a
zero-divisor. -/
theorem totalRingOfFractions_isUnit_or_mem_zeroDivisors (x : totalRingOfFractions A) :
    IsUnit x ∨ x ∈ zeroDivisors (totalRingOfFractions A) :=
  isUnit_or_mem_zeroDivisors x

/-- Part (iii) for the total ring of fractions: if every non-unit of `A` is a zero-divisor then
`A` is its own total ring of fractions. -/
theorem totalRingOfFractions_bijective
    (h : ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A) :
    Function.Bijective (algebraMap A (totalRingOfFractions A)) :=
  bijective_algebraMap_of_forall_not_isUnit_mem_zeroDivisors h

/-- Part (iii) in isomorphism form: if every non-unit of `A` is a zero-divisor then `A` is
isomorphic to its total ring of fractions. -/
noncomputable def totalRingOfFractionsEquiv
    (h : ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A) : A ≃+* totalRingOfFractions A :=
  RingEquiv.ofBijective (algebraMap A (totalRingOfFractions A))
    (bijective_algebraMap_of_forall_not_isUnit_mem_zeroDivisors h)

/-! ### Consistency checks

The statements are not vacuous: `ℤ` has a non-unit which is not a zero-divisor, while `ZMod 4`
satisfies the hypothesis of (iii) and is therefore its own total ring of fractions. -/

/-- `2` is a non-unit of `ℤ` which is not a zero-divisor, so the hypothesis of (iii) is a genuine
restriction (a domain satisfies it exactly when it is a field). -/
example : ¬ (∀ a : ℤ, ¬ IsUnit a → a ∈ zeroDivisors ℤ) := by
  intro h
  have h2 : (2 : ℤ) ∈ zeroDivisors ℤ := h 2 (by simp [Int.isUnit_iff])
  obtain ⟨b, hb, hb0⟩ := mem_zeroDivisors_iff.mp h2
  rcases mul_eq_zero.mp hb0 with h' | h'
  · omega
  · exact hb h'

/-- In `ZMod 4` the non-units `0` and `2` are zero-divisors, so part (iii) applies. -/
example : ∀ a : ZMod 4, ¬ IsUnit a → a ∈ zeroDivisors (ZMod 4) := by
  intro a ha
  rw [mem_zeroDivisors_iff]
  fin_cases a
  · exact ⟨2, by decide, by decide⟩
  · exact absurd isUnit_one ha
  · exact ⟨2, by decide, by decide⟩
  · exact absurd ⟨⟨3, 3, by decide, by decide⟩, rfl⟩ ha

/-- Consequently `ZMod 4` is its own total ring of fractions. -/
example :
    Function.Bijective (algebraMap (ZMod 4) (totalRingOfFractions (ZMod 4))) :=
  totalRingOfFractions_bijective fun a ha => by
    rw [mem_zeroDivisors_iff]
    fin_cases a
    · exact ⟨2, by decide, by decide⟩
    · exact absurd isUnit_one ha
    · exact ⟨2, by decide, by decide⟩
    · exact absurd ⟨⟨3, 3, by decide, by decide⟩, rfl⟩ ha

/-- In `ℚ` every non-unit (i.e. `0`) is a zero-divisor and `S₀` is the set of units. -/
example : (nonZeroDivisors ℚ : Set ℚ) = {a | IsUnit a} := by
  have h : ∀ a : ℚ, ¬ IsUnit a → a ∈ zeroDivisors ℚ := by
    intro a ha
    rw [mem_zeroDivisors_iff]
    refine ⟨1, one_ne_zero, ?_⟩
    have ha0 : a = 0 := by
      by_contra h'
      exact ha (isUnit_iff_ne_zero.mpr h')
    rw [ha0, zero_mul]
  exact nonZeroDivisors_eq_units_of_forall_not_isUnit_mem_zeroDivisors h

/-! ### The complete exercise -/

/-- Atiyah–Macdonald, Chapter 3, Exercise 9, all parts. -/
theorem solution :
    (∀ x y : A, x * y ∈ nonZeroDivisors A ↔
        x ∈ nonZeroDivisors A ∧ y ∈ nonZeroDivisors A) ∧
      (zeroDivisors A = ⋃ p : {p : Ideal A // p.IsPrime ∧ (p : Set A) ⊆ zeroDivisors A},
        (p.1 : Set A)) ∧
      (∀ p : Ideal A, p ∈ minimalPrimes A → (p : Set A) ⊆ zeroDivisors A) ∧
      IsGreatest {S : Submonoid A | Function.Injective (algebraMap A (Localization S))}
        (nonZeroDivisors A) ∧
      (∀ x : Localization (nonZeroDivisors A),
        IsUnit x ∨ x ∈ zeroDivisors (Localization (nonZeroDivisors A))) ∧
      (∀ _ : ∀ a : A, ¬ IsUnit a → a ∈ zeroDivisors A,
        Function.Bijective (algebraMap A (Localization (nonZeroDivisors A)))) :=
  ⟨fun _ _ => isSaturated_nonZeroDivisors,
    zeroDivisors_eq_iUnion_primes,
    fun _ => minimalPrime_subset_zeroDivisors,
    isGreatest_injective,
    fun _ => isUnit_or_mem_zeroDivisors _,
    fun h => bijective_algebraMap_of_forall_not_isUnit_mem_zeroDivisors h⟩

end AtiyahMcdonald69.Ex_3_9

