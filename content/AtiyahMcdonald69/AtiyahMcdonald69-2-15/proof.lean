import Mathlib

/-!
# Atiyah–Macdonald (1969), Chapter 2, Exercise 15

This file formalizes Exercise 15 of Chapter 2 of M. F. Atiyah and I. G. Macdonald,
*Introduction to Commutative Algebra*, in the situation of Exercise 14 of the same chapter.

## The data of Exercise 14

Let `A` be a ring, `I` a directed partially ordered set (`∀ i j, ∃ k, i ≤ k ∧ j ≤ k`),
`M : I → Type` a family of `A`-modules, and `μ i j h : M i →ₗ[A] M j` for `h : i ≤ j`,
subject to the two axioms (see `IsDirectSystem`)

1. `μ i i le_rfl = LinearMap.id`;
2. `μ i k = μ j k ∘ μ i j` whenever `i ≤ j ≤ k`.

Write

* `C = ⨁ᵢ Mᵢ` for the direct sum (`Csum` below), with canonical inclusions `lof i : Mᵢ → C`;
* `D ≤ C` for the submodule generated by all elements `xᵢ - μᵢⱼ(xᵢ)` with `i ≤ j`, `xᵢ ∈ Mᵢ`
  (`D` below, exactly the generators of the textbook);
* `M = C ⧸ D` for the direct limit (`Lim` below);
* `μᵢ : Mᵢ → M` for the composite of `lof i` with the projection `C → C ⧸ D` (`muI` below).

From the construction, `μᵢ = μⱼ ∘ μᵢⱼ` whenever `i ≤ j` (`muI_comp`).

## The exercise

* **(a)** Every element of `M` is of the form `μᵢ(xᵢ)` for some `i : I` and some `xᵢ : Mᵢ`
  (`exists_muI_eq`).
* **(b)** If `μᵢ(xᵢ) = 0`, then there is `j ≥ i` with `μᵢⱼ(xᵢ) = 0` in `Mⱼ`
  (`muI_eq_zero_iff`).

We also prove the sharper statement of which (b) is the case `y = 0`: `μᵢ(xᵢ) = μⱼ(xⱼ)` iff
there is `k ≥ i, j` with `μᵢₖ(xᵢ) = μⱼₖ(xⱼ)` (`muI_eq_muI_iff`), and the conjunction of (a)
and (b) as `exercise_2_15`.

## Proof route

Everything is proved from the concrete quotient construction, not from an abstract universal
property.

The key tool is the family of linear maps `phi l : C →ₗ[A] Mₗ` (`l : I`) which sends a finite
sum `∑ xᵢ` to `∑_{i ≤ l} μᵢₗ(xᵢ)`; this is the rigorous form of "map every involved summand
`Mᵣ` to `Mₗ`" in the classical solution.  Let `Cof l` be the span in `C` of the components
`Mᵢ` with `i ≤ l`.  Then

* `muI l (phi l c) = c + D` for every `c ∈ Cof l` (`mkQ_eq_of_mem_Cof`) — componentwise,
  `μᵢ(xᵢ)` and `xᵢ` have the same image in the direct limit;
* `phi m c = μ l m (phi l c)` for `l ≤ m` and `c ∈ Cof l` (`phi_comp_of_mem`);
* every `c : C` lies in some `Cof l` (`exists_mem_Cof`), because the index set is directed.

Part (a) is then immediate.  For part (b) one observes that the set of `c ∈ C` for which there
is `l` above two prescribed indices with `c ∈ Cof l` and `phi l c = 0` is a submodule of `C`
containing all generators of `D` (`exists_bound_of_mem_D`); applying this to `μᵢ(xᵢ) ∈ D` and
evaluating at `l` gives `μᵢₗ(xᵢ) = phi l (xᵢ) = 0`.

## Remarks on hypotheses

* The textbook works with a partially ordered set; only reflexivity and transitivity of `≤` are
  used, so `Preorder` would do just as well as `PartialOrder`.
* `[Nonempty I]` is genuinely needed for (a): see `nonempty_of_forall_exists` and
  `not_forall_exists_muI_eq` at the end of the file.  The textbook never states it, taking the
  index set of a direct system to be nonempty.  An element of the limit is `μᵢ(xᵢ)` for a
  *single* index only because the index set is nonempty and directed.
* `[DecidableEq I]` is a purely technical assumption (classically every type has decidable
  equality) needed to write down finitely supported functions in Mathlib's direct sum.
-/

open scoped DirectSum

noncomputable section

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

-- Technical: `if i ≤ l then .. else ..` for `i l` in the abstract preorder `I` needs classical logic.
attribute [local instance] Classical.propDecidable

namespace AtiyahMcdonald69.Ex_2_15

variable {A : Type*} [CommRing A]
variable {I : Type*} [Preorder I] [DecidableEq I]
variable {M : I → Type*} [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)]

/-! ### The construction of Exercise 14 -/

/-- The direct sum `C = ⨁ᵢ Mᵢ`. -/
abbrev Csum : Type _ := ⨁ i, M i

/-- The set of elements `xᵢ - μᵢⱼ(xᵢ)` (`i ≤ j`, `xᵢ ∈ Mᵢ`) whose span is the submodule `D`. -/
def relSet (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) : Set (Csum (M := M)) :=
  {g | ∃ (i j : I) (h : i ≤ j) (x : M i),
    DirectSum.lof A I M i x - DirectSum.lof A I M j (μ i j h x) = g}

/-- The submodule `D` of the direct sum generated by all `xᵢ - μᵢⱼ(xᵢ)` with `i ≤ j`,
`xᵢ ∈ Mᵢ` (Exercise 14). -/
def D (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) : Submodule A (Csum (M := M)) :=
  Submodule.span A (relSet (A := A) (M := M) μ)

/-- The direct limit `M = C ⧸ D`. -/
abbrev Lim (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) : Type _ := Csum (M := M) ⧸ D (A := A) (M := M) μ

/-- The canonical map `μᵢ : Mᵢ → M = C ⧸ D`, the restriction of the projection to `Mᵢ`. -/
def muI (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) (i : I) : M i →ₗ[A] Lim μ :=
  (D (A := A) (M := M) μ).mkQ.comp (DirectSum.lof A I M i)

variable {μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j}

@[simp]
theorem muI_apply (i : I) (x : M i) :
    muI (A := A) (M := M) μ i x = Submodule.Quotient.mk (DirectSum.lof A I M i x) := rfl

/-- The defining property of the construction: `μᵢ = μⱼ ∘ μᵢⱼ` for `i ≤ j`. -/
theorem muI_comp {i j : I} (h : i ≤ j) (x : M i) :
    muI (A := A) (M := M) μ i x = muI (A := A) (M := M) μ j (μ i j h x) := by
  have hrel : DirectSum.lof A I M i x - DirectSum.lof A I M j (μ i j h x) ∈
      relSet (A := A) (M := M) μ := ⟨i, j, h, x, rfl⟩
  rw [muI_apply, muI_apply, Submodule.Quotient.eq]
  exact Submodule.subset_span (a := _) hrel

/-- The linear map `Φₗ : ⨁ᵢ Mᵢ → Mₗ` sending the component `Mᵢ` to `Mₗ` by `μᵢₗ` if `i ≤ l`
and to `0` otherwise.  This is the concrete form of "map the summands to `Mₗ`". -/
def phi (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) (l : I) : Csum (M := M) →ₗ[A] M l :=
  DirectSum.toModule A I (M l) fun i => if h : i ≤ l then μ i l h else 0

theorem phi_lof_of_le {l i : I} (h : i ≤ l) (x : M i) :
    phi (A := A) (M := M) μ l (DirectSum.lof A I M i x) = μ i l h x := by
  simp only [phi, DirectSum.toModule_lof, dif_pos h]

theorem phi_lof_of_not_le {l i : I} (h : ¬ i ≤ l) (x : M i) :
    phi (A := A) (M := M) μ l (DirectSum.lof A I M i x) = 0 := by
  simp only [phi, DirectSum.toModule_lof, dif_neg h, LinearMap.zero_apply]

/-! ### The axioms of a direct system -/

/-- The two axioms of Exercise 14 for `(Mᵢ, μᵢⱼ)` to be a direct system of `A`-modules over the
partially ordered set `I`. -/
class IsDirectSystem (μ : ∀ i j : I, i ≤ j → M i →ₗ[A] M j) : Prop where
  /-- Axiom (1): `μᵢᵢ` is the identity of `Mᵢ`. -/
  map_self : ∀ (i : I) (x : M i), μ i i le_rfl x = x
  /-- Axiom (2): `μᵢₖ = μⱼₖ ∘ μᵢⱼ` for `i ≤ j ≤ k`. -/
  map_comp : ∀ (i j k : I) (hij : i ≤ j) (hjk : j ≤ k),
    μ i k (hij.trans hjk) = (μ j k hjk).comp (μ i j hij)

/-- Axiom (2) of a direct system, pointwise. -/
theorem mu_comp_apply [IsDirectSystem (M := M) μ] {i j k : I} (hij : i ≤ j) (hjk : j ≤ k)
    (x : M i) : μ i k (hij.trans hjk) x = μ j k hjk (μ i j hij x) := by
  rw [IsDirectSystem.map_comp (M := M) (μ := μ) i j k hij hjk]
  rfl

/-- Axiom (2) of a direct system, pointwise, with an arbitrary proof of `i ≤ k`. -/
theorem mu_comp_apply' [IsDirectSystem (M := M) μ] {i j k : I} (hij : i ≤ j) (hjk : j ≤ k)
    (hik : i ≤ k) (x : M i) : μ i k hik x = μ j k hjk (μ i j hij x) :=
  (Subsingleton.elim hik (hij.trans hjk)) ▸ mu_comp_apply (M := M) hij hjk x

/-! ### The submodules `Cof l` and the reconstruction of `C ⧸ D` from its components -/

/-- `Cof l ≤ ⨁ᵢ Mᵢ` is the span of the components `Mᵢ` with `i ≤ l`, i.e. the direct summand
of all components below `l`. -/
def Cof (l : I) : Submodule A (Csum (M := M)) :=
  Submodule.span A
    {x : Csum (M := M) | ∃ (i : I) (_ : i ≤ l) (m : M i), DirectSum.lof A I M i m = x}

theorem lof_mem_Cof {l i : I} (h : i ≤ l) (m : M i) :
    DirectSum.lof A I M i m ∈ Cof (A := A) (M := M) (I := I) l :=
  Submodule.subset_span (a := DirectSum.lof A I M i m) ⟨i, h, m, rfl⟩

theorem Cof_mono {l m : I} (h : l ≤ m) :
    Cof (A := A) (M := M) (I := I) l ≤ Cof (A := A) (M := M) (I := I) m := by
  rw [Cof, Submodule.span_le]
  rintro x ⟨i, hil, v, rfl⟩
  exact lof_mem_Cof (A := A) (M := M) (hil.trans h) v

/-- Every element of the direct sum lies in one of the submodules `Cof l`. -/
theorem exists_mem_Cof [Nonempty I] (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k)
    (c : Csum (M := M)) : ∃ l : I, c ∈ Cof (A := A) (M := M) (I := I) l := by
  induction c using DFinsupp.induction with
  | h0 => exact ⟨Classical.arbitrary I, Submodule.zero_mem _⟩
  | ha i b f _ _ ih =>
    obtain ⟨l, hl⟩ := ih
    obtain ⟨m, him, hlm⟩ := hdir i l
    refine ⟨m, Submodule.add_mem _ (Cof_mono (M := M) him ?_) (Cof_mono (M := M) hlm hl)⟩
    exact lof_mem_Cof (A := A) (M := M) le_rfl b

/-- On `Cof l`, the composite of `Φₗ` with `μₗ` is the projection to the direct limit. -/
theorem mkQ_eq_of_mem_Cof {l : I} {c : Csum (M := M)} (hc : c ∈ Cof (A := A) (M := M) (I := I) l) :
    muI (A := A) (M := M) μ l (phi (A := A) (M := M) μ l c) = (D (A := A) (M := M) μ).mkQ c := by
  refine Submodule.span_induction
    (p := fun c _ => muI (A := A) (M := M) μ l (phi (A := A) (M := M) μ l c) = (D (A := A) (M := M) μ).mkQ c)
    ?_ ?_ ?_ ?_ hc
  · rintro x ⟨i, hil, m, rfl⟩
    rw [phi_lof_of_le (M := M) (μ := μ) hil, ← muI_comp (M := M) (μ := μ) hil m, muI_apply,
      Submodule.mkQ_apply]
  · simp
  · intro x y _ _ hx hy
    simp only [map_add, hx, hy]
  · intro a x _ hx
    simp only [map_smul, hx]

/-- For `l ≤ m`, the maps `Φₘ` and `μₗₘ ∘ Φₗ` agree on `Cof l`. -/
theorem phi_comp_of_mem [IsDirectSystem (M := M) μ] {l m : I} (hlm : l ≤ m)
    {c : Csum (M := M)} (hc : c ∈ Cof (A := A) (M := M) (I := I) l) :
    phi (A := A) (M := M) μ m c = μ l m hlm (phi (A := A) (M := M) μ l c) := by
  refine Submodule.span_induction
    (p := fun c _ => phi (A := A) (M := M) μ m c = μ l m hlm (phi (A := A) (M := M) μ l c)) ?_ ?_ ?_ ?_ hc
  · rintro x ⟨i, hil, v, rfl⟩
    rw [phi_lof_of_le (M := M) (μ := μ) (hil.trans hlm) v,
      phi_lof_of_le (M := M) (μ := μ) hil v]
    exact mu_comp_apply' (M := M) hil hlm (hil.trans hlm) v
  · simp
  · intro x y _ _ hx hy
    simp only [map_add, hx, hy]
  · intro a x _ hx
    simp only [map_smul, hx]

/-! ### The exercise -/

/-- The set of elements of `C` which are killed by `Φₗ` after passing to `Cof l`, for some `l`
above two prescribed indices, is a submodule containing all generators of `D`. -/
theorem exists_bound_of_mem_D [IsDirectSystem (M := M) μ]
    (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k) (i j : I) {c : Csum (M := M)}
    (hc : c ∈ D (A := A) (M := M) μ) :
    ∃ l : I, i ≤ l ∧ j ≤ l ∧ c ∈ Cof (A := A) (M := M) (I := I) l ∧ phi (A := A) (M := M) μ l c = 0 := by
  refine Submodule.span_induction
    (p := fun c _ => ∃ l : I, i ≤ l ∧ j ≤ l ∧ c ∈ Cof (A := A) (M := M) (I := I) l ∧
      phi (A := A) (M := M) μ l c = 0) ?_ ?_ ?_ ?_ hc
  · rintro g ⟨i', j', hg, m, rfl⟩
    obtain ⟨l₁, hil₁, hjl₁⟩ := hdir i j
    obtain ⟨l₂, hl₁l₂, hi'l₂⟩ := hdir l₁ i'
    obtain ⟨l₃, hl₂l₃, hj'l₃⟩ := hdir l₂ j'
    have hi₁ : i ≤ l₃ := hil₁.trans (hl₁l₂.trans hl₂l₃)
    have hj₁ : j ≤ l₃ := hjl₁.trans (hl₁l₂.trans hl₂l₃)
    have hi' : i' ≤ l₃ := hi'l₂.trans hl₂l₃
    refine ⟨l₃, hi₁, hj₁, ?_, ?_⟩
    · exact Submodule.sub_mem _ (lof_mem_Cof (A := A) (M := M) hi' m) (lof_mem_Cof (A := A) (M := M) hj'l₃ _)
    · rw [map_sub, phi_lof_of_le (M := M) (μ := μ) hi',
        phi_lof_of_le (M := M) (μ := μ) hj'l₃,
        mu_comp_apply' (M := M) hg hj'l₃ hi' m, sub_self]
  · obtain ⟨l, hil, hjl⟩ := hdir i j
    exact ⟨l, hil, hjl, Submodule.zero_mem _, by simp⟩
  · rintro x y _ _ ⟨l, hil, hjl, hcl, hxl⟩ ⟨l', hil', hjl', hcl', hxl'⟩
    obtain ⟨m, hlm, hl'm⟩ := hdir l l'
    refine ⟨m, hil.trans hlm, hjl.trans hlm,
      Submodule.add_mem _ (Cof_mono (M := M) hlm hcl) (Cof_mono (M := M) hl'm hcl'), ?_⟩
    rw [map_add, phi_comp_of_mem (M := M) hlm hcl, phi_comp_of_mem (M := M) hl'm hcl',
      hxl, hxl', map_zero, map_zero, add_zero]
  · rintro a x _ ⟨l, hil, hjl, hcl, hxl⟩
    exact ⟨l, hil, hjl, Submodule.smul_mem _ a hcl, by rw [map_smul, hxl, smul_zero]⟩

/-- **Exercise 2.15 (a).**  Every element of the direct limit is of the form `μᵢ(xᵢ)`. -/
theorem exists_muI_eq [Nonempty I] [IsDirectSystem (M := M) μ]
    (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k) (z : Lim (A := A) (M := M) μ) :
    ∃ (i : I) (x : M i), muI (A := A) (M := M) μ i x = z := by
  obtain ⟨c, rfl⟩ := Submodule.mkQ_surjective (D (A := A) (M := M) μ) z
  obtain ⟨l, hl⟩ := exists_mem_Cof (A := A) (M := M) hdir c
  exact ⟨l, phi (A := A) (M := M) μ l c, mkQ_eq_of_mem_Cof (A := A) (M := M) hl⟩

/-- **Exercise 2.15 (b).**  If `μᵢ(xᵢ) = 0` in the direct limit, then `μᵢⱼ(xᵢ) = 0` in some
`Mⱼ` with `j ≥ i`. -/
theorem muI_eq_zero_iff [IsDirectSystem (M := M) μ]
    (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k) (i : I) (x : M i) :
    muI (A := A) (M := M) μ i x = 0 ↔ ∃ (j : I) (h : i ≤ j), μ i j h x = 0 := by
  constructor
  · intro h
    have hmem : DirectSum.lof A I M i x ∈ D (A := A) (M := M) μ :=
      (Submodule.Quotient.mk_eq_zero (D (A := A) (M := M) μ)).mp (by rwa [muI_apply] at h)
    obtain ⟨l, hil, -, -, hphi⟩ := exists_bound_of_mem_D (A := A) (M := M) hdir i i hmem
    exact ⟨l, hil, by rw [← phi_lof_of_le (M := M) (μ := μ) hil x]; exact hphi⟩
  · rintro ⟨j, hij, hj⟩
    rw [muI_comp (M := M) (μ := μ) hij x, hj, map_zero]

/-- Sharpening of Exercise 2.15 (b): two elements of the limit agree iff they agree after
passing to a common larger index. -/
theorem muI_eq_muI_iff [IsDirectSystem (M := M) μ]
    (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k) (i j : I) (x : M i) (y : M j) :
    muI (A := A) (M := M) μ i x = muI (A := A) (M := M) μ j y ↔
      ∃ (k : I) (hik : i ≤ k) (hjk : j ≤ k), μ i k hik x = μ j k hjk y := by
  constructor
  · intro h
    have hmem : DirectSum.lof A I M i x - DirectSum.lof A I M j y ∈ D (A := A) (M := M) μ :=
      (Submodule.Quotient.eq (D (A := A) (M := M) μ)).mp (by rwa [muI_apply, muI_apply] at h)
    obtain ⟨l, hil, hjl, -, hphi⟩ := exists_bound_of_mem_D (A := A) (M := M) hdir i j hmem
    rw [map_sub, phi_lof_of_le (M := M) (μ := μ) hil x,
      phi_lof_of_le (M := M) (μ := μ) hjl y, sub_eq_zero] at hphi
    exact ⟨l, hil, hjl, hphi⟩
  · rintro ⟨k, hik, hjk, hk⟩
    rw [muI_comp (M := M) (μ := μ) hik x, muI_comp (M := M) (μ := μ) hjk y, hk]

/-- **Atiyah–Macdonald, Chapter 2, Exercise 15**, parts (a) and (b) together: for a direct
system `(Mᵢ, μᵢⱼ)` over a nonempty directed set,

* every element of `lim Mᵢ = (⨁ Mᵢ)/D` is `μᵢ(xᵢ)` for a single index `i`;
* `μᵢ(xᵢ) = 0` iff `μᵢⱼ(xᵢ) = 0` for some `j ≥ i`. -/
theorem exercise_2_15 [Nonempty I] (hμ : IsDirectSystem (M := M) μ)
    (hdir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k) :
    (∀ z : Lim (A := A) (M := M) μ, ∃ (i : I) (x : M i), muI (A := A) (M := M) μ i x = z) ∧
      (∀ (i : I) (x : M i), muI (A := A) (M := M) μ i x = 0 ↔
        ∃ (j : I) (h : i ≤ j), μ i j h x = 0) := by
  haveI := hμ
  exact ⟨exists_muI_eq (M := M) hdir, fun i x => muI_eq_zero_iff (M := M) hdir i x⟩

/-- The hypothesis `[Nonempty I]` of `exists_muI_eq` cannot be dropped: if every element of the
limit is of the form `μᵢ(xᵢ)`, then `I` is nonempty (apply the statement to `0`). -/
theorem nonempty_of_forall_exists
    (h : ∀ z : Lim (A := A) (M := M) μ, ∃ (i : I) (x : M i), muI (A := A) (M := M) μ i x = z) : Nonempty I := by
  obtain ⟨i, -, -⟩ := h 0
  exact ⟨i⟩


/-! ### The index set must be nonempty

The textbook's statement of Exercise 15 does not say that the index set is nonempty; it is
needed.  The two results below show exactly what is missing: statement (a) *implies* that `I`
is nonempty (`nonempty_of_forall_exists`, above), and it *fails* for the vacuous direct system
over the empty index set (`not_forall_exists_muI_eq`). -/

section EmptyIndex

/-- `PEmpty` with its unique preorder. -/
instance pemptyPreorder : Preorder PEmpty where
  le := fun _ _ => False
  lt := fun _ _ => False
  le_refl := fun a => PEmpty.elim a
  le_trans := fun a => PEmpty.elim a
  lt_iff_le_not_ge := fun a => PEmpty.elim a

/-- The vacuous family of `ℤ`-modules indexed by the empty set. -/
def MEmpty : PEmpty → Type := fun i => PEmpty.elim i

instance : ∀ i : PEmpty, AddCommGroup (MEmpty i) := fun i => PEmpty.elim i

instance : ∀ i : PEmpty, Module ℤ (MEmpty i) := fun i => PEmpty.elim i

/-- The vacuous direct system over the empty index set. -/
def muEmpty : ∀ i j : PEmpty, i ≤ j → MEmpty i →ₗ[ℤ] MEmpty j := fun i => PEmpty.elim i

instance : IsDirectSystem (A := ℤ) (I := PEmpty) (M := MEmpty) muEmpty where
  map_self := fun i => PEmpty.elim i
  map_comp := fun i => PEmpty.elim i

/-- Over the empty index set the direct limit is the zero module, so it has the element `0`, but
there is no index `i` at all, hence no element of it is of the form `μᵢ(xᵢ)`: statement (a) of
Exercise 2.15 fails without the hypothesis `Nonempty I`. -/
theorem not_forall_exists_muI_eq :
    ¬ (∀ z : Lim (A := ℤ) (I := PEmpty) (M := MEmpty) muEmpty,
        ∃ (i : PEmpty) (x : MEmpty i),
          muI (A := ℤ) (I := PEmpty) (M := MEmpty) muEmpty i x = z) := by
  intro h
  obtain ⟨i, -, -⟩ := h 0
  exact PEmpty.elim i

end EmptyIndex

/-! ### A concrete instance of the construction: the constant system over `ℕ` -/

section ConstantSystem

/-- The constant family `Mₙ = ℤ`. -/
abbrev MConst : ℕ → Type := fun _ => ℤ

instance : ∀ n : ℕ, AddCommGroup (MConst n) := fun _ => inferInstance

instance : ∀ n : ℕ, Module ℤ (MConst n) := fun _ => inferInstance

/-- The direct system over `ℕ` with all transition maps the identity. -/
def muConst : ∀ n m : ℕ, n ≤ m → MConst n →ₗ[ℤ] MConst m := fun _ _ _ => LinearMap.id

instance : IsDirectSystem (A := ℤ) (I := ℕ) (M := MConst) muConst where
  map_self := fun _ _ => rfl
  map_comp := fun _ _ _ _ _ => LinearMap.ext fun _ => rfl

/-- In the constant system over `ℕ` all transition maps are identities, and every element of the
limit is already `μ₀(x)`: statement (a) applied to this system. -/
theorem constant_every_element :
    ∀ z : Lim (A := ℤ) (I := ℕ) (M := MConst) muConst,
      ∃ x : ℤ, muI (A := ℤ) (I := ℕ) (M := MConst) muConst 0 x = z := by
  intro z
  obtain ⟨i, x, hx⟩ := exists_muI_eq (A := ℤ) (I := ℕ) (M := MConst) (μ := muConst)
    (fun i j => ⟨max i j, le_max_left i j, le_max_right i j⟩) z
  refine ⟨x, ?_⟩
  rw [muI_comp (A := ℤ) (I := ℕ) (M := MConst) (μ := muConst) (Nat.zero_le i) x]
  exact hx

end ConstantSystem

