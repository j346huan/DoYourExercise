/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Exercise 3.6 (Chapter 3).

Statement (A–M, Ch. 3, Exercise 6). Let `A` be a ring with `A ≠ 0` and let `Σ` be the set
of all multiplicatively closed subsets `S ⊆ A` such that `0 ∉ S`. Then `Σ` has maximal
elements, and `S ∈ Σ` is maximal if and only if `A - S` is a minimal prime ideal of `A`.

Formalization choices (to be read against the book):

* A "multiplicatively closed subset" of `A` is a `Submonoid A`. This is exactly the book's
  convention (p. 36): `1 ∈ S` and `xy ∈ S` whenever `x, y ∈ S`.
* `Σ` is `Sigma A : Set (Submonoid A)`, ordered by inclusion (the lattice order on
  `Submonoid A` is inclusion); maximality in `Σ` is `Maximal (· ∈ Sigma A)`, i.e.
  `S ∈ Σ` and every `T ∈ Σ` with `S ≤ T` satisfies `T ≤ S`.
* "`A - S` is a minimal prime ideal" is `IsMinimalPrimeCompl S`: there is an ideal `I`
  whose underlying set is the complement of `S` (in particular `A - S` is closed under
  addition and under multiplication by any element of `A`) which is a minimal prime of
  `A`, i.e. minimal among all prime ideals of `A`.

The proof follows the book. Zorn's lemma is applied to `Σ`: the union of a chain of
multiplicatively closed subsets of `A` not containing `0` is again one (the supremum of a
chain of submonoids has underlying set the union). For a maximal `S ∈ Σ`, adjoining an
element `a ∉ S` produces `0`, i.e. `s * a ^ n = 0` for some `s ∈ S` and `n ≥ 1`; this
shows that `A - S` is an ideal (the binomial argument of the book gives closure under
addition, `s * (r * a) ^ n = 0` gives absorption) and it is prime; it is minimal because a
prime contained in it has a complement that is a multiplicatively closed set avoiding `0`
and containing `S`. Conversely, if `A - S` is a minimal prime, any `T ∈ Σ` above `S`
extends to a maximal element of `Σ`, whose complement is a prime ideal contained in
`A - S` and hence equal to it by minimality.
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_3_6

variable {A : Type*} [CommRing A]

/-! ### The set `Σ` -/

/-- `Σ`: the set of multiplicatively closed subsets `S ⊆ A` with `0 ∉ S`. -/
def Sigma : Set (Submonoid A) := {S | (0 : A) ∉ S}

@[simp] theorem mem_Sigma {S : Submonoid A} : S ∈ Sigma (A := A) ↔ (0 : A) ∉ S := Iff.rfl

/-- `A - S` is a minimal prime ideal of `A`: an ideal whose underlying set is the
complement of `S`, minimal among the prime ideals of `A`. -/
def IsMinimalPrimeCompl (S : Submonoid A) : Prop :=
  ∃ I : Ideal A, (I : Set A) = (S : Set A)ᶜ ∧ IsMinimalPrime I

/-! ### `Σ` has maximal elements (Zorn) -/

/-- Every chain in `Σ` has an upper bound in `Σ`: the union of the chain, which is again
multiplicatively closed and does not contain `0`. (For a chain of submonoids the supremum
has underlying set the union of the chain.) -/
theorem sigma_chain_upper [Nontrivial A] (c : Set (Submonoid A)) (hc : c ⊆ Sigma (A := A))
    (hchain : IsChain (· ≤ ·) c) : ∃ ub, ub ∈ Sigma (A := A) ∧ ∀ z ∈ c, z ≤ ub := by
  rcases c.eq_empty_or_nonempty with rfl | ⟨S₀, hS₀⟩
  · refine ⟨⊥, ?_, fun z hz => absurd hz (Set.notMem_empty z)⟩
    rw [mem_Sigma, Submonoid.mem_bot]
    exact fun h => zero_ne_one h
  · refine ⟨sSup c, ?_, fun z hz => le_sSup hz⟩
    rw [mem_Sigma, Submonoid.mem_sSup_of_directedOn ⟨S₀, hS₀⟩ hchain.directedOn]
    rintro ⟨s, hs, h0⟩
    exact hc hs h0

/-- First assertion of Exercise 3.6: `Σ` has maximal elements. -/
theorem exists_maximal_Sigma [Nontrivial A] : ∃ m, Maximal (· ∈ Sigma (A := A)) m :=
  zorn_le₀ Sigma fun c hc hchain => sigma_chain_upper c hc hchain

/-- Every element of `Σ` is contained in a maximal element of `Σ`. -/
theorem exists_maximal_Sigma_ge [Nontrivial A] (S : Submonoid A) (hS : S ∈ Sigma (A := A)) :
    ∃ m, Maximal (· ∈ Sigma (A := A)) m ∧ S ≤ m := by
  obtain ⟨m, hSm, hmax⟩ :=
    zorn_le_nonempty₀ Sigma (fun c hc hchain _ _ => sigma_chain_upper c hc hchain) S hS
  exact ⟨m, hmax, hSm⟩

/-! ### Adjoining an element to a maximal member of `Σ` -/

/-- Key step: if `S` is maximal in `Σ` and `a ∉ S`, then adjoining `a` to `S` introduces
`0`, i.e. `s * a ^ n = 0` for some `s ∈ S` and some `n ≥ 1`. -/
theorem exists_mul_pow_eq_zero {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S)
    {a : A} (ha : a ∉ S) : ∃ s ∈ S, ∃ n : ℕ, 0 < n ∧ s * a ^ n = 0 := by
  -- the submonoid generated by `S` and `a` strictly contains `S`, so it contains `0`
  have h0T : (0 : A) ∈ Submonoid.closure ((S : Set A) ∪ {a}) := by
    by_contra h0
    have hSle : S ≤ Submonoid.closure ((S : Set A) ∪ {a}) :=
      fun x hx => Submonoid.subset_closure (Or.inl hx)
    have hle : Submonoid.closure ((S : Set A) ∪ {a}) ≤ S := hmax.2 h0 hSle
    exact ha (hle (Submonoid.subset_closure (Or.inr rfl)))
  -- and its elements are exactly the `s * a ^ n`, `s ∈ S`, `n ∈ ℕ`
  have key : ∀ x ∈ Submonoid.closure ((S : Set A) ∪ {a}), ∃ s ∈ S, ∃ n : ℕ, x = s * a ^ n := by
    intro x hx
    refine Submonoid.closure_induction
      (motive := fun x _ => ∃ s ∈ S, ∃ n : ℕ, x = s * a ^ n) ?_ ?_ ?_ hx
    · rintro y (hy | rfl)
      · exact ⟨y, hy, 0, by simp⟩
      · exact ⟨1, S.one_mem, 1, by simp⟩
    · exact ⟨1, S.one_mem, 0, by simp⟩
    · rintro x y _ _ ⟨s, hs, n, rfl⟩ ⟨t, ht, m, rfl⟩
      exact ⟨s * t, S.mul_mem hs ht, n + m, by rw [pow_add]; ring⟩
  obtain ⟨s, hs, n, hn⟩ := key 0 h0T
  rcases Nat.eq_zero_or_pos n with h | h
  · exfalso
    rw [h, pow_zero, mul_one] at hn
    rw [← hn] at hs
    exact hmax.1 hs
  · exact ⟨s, hs, n, h, hn.symm⟩

/-- If `S` is maximal in `Σ`, `a ∉ S` and `r ∈ A`, then `r * a ∉ S`. -/
theorem mul_notMem_of_maximal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S)
    {a : A} (ha : a ∉ S) (r : A) : r * a ∉ S := by
  obtain ⟨s, hs, n, _, hsa⟩ := exists_mul_pow_eq_zero hmax ha
  intro hra
  have hmem : s * (r * a) ^ n ∈ S := S.mul_mem hs (S.pow_mem hra n)
  have hzero : s * (r * a) ^ n = 0 := by
    calc s * (r * a) ^ n = s * (r ^ n * a ^ n) := by rw [mul_pow]
      _ = r ^ n * (s * a ^ n) := by ring
      _ = 0 := by rw [hsa, mul_zero]
  rw [hzero] at hmem
  exact hmax.1 hmem

/-- If `S` is maximal in `Σ` and `a, b ∉ S`, then `a + b ∉ S`: this is the binomial
argument of the book, using `s * a ^ n = 0` and `t * b ^ m = 0`. -/
theorem add_notMem_of_maximal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S)
    {a b : A} (ha : a ∉ S) (hb : b ∉ S) : a + b ∉ S := by
  obtain ⟨s, hs, n, _, hsa⟩ := exists_mul_pow_eq_zero hmax ha
  obtain ⟨t, ht, m, _, htb⟩ := exists_mul_pow_eq_zero hmax hb
  have hzero : s * t * (a + b) ^ (n + m) = 0 := by
    rw [add_pow, Finset.mul_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    rcases Nat.lt_or_ge k n with hklt | hkge
    · have hb' : b ^ (n + m - k) = b ^ m * b ^ (n + m - k - m) := by
        rw [← pow_add]; congr 1; omega
      have ht' : t * b ^ (n + m - k) = 0 := by
        rw [hb', ← mul_assoc, htb, zero_mul]
      calc s * t * (a ^ k * b ^ (n + m - k) * (Nat.choose (n + m) k : A))
          = (s * a ^ k * (Nat.choose (n + m) k : A)) * (t * b ^ (n + m - k)) := by ring
        _ = 0 := by rw [ht', mul_zero]
    · have ha' : a ^ k = a ^ n * a ^ (k - n) := by
        rw [← pow_add]; congr 1; omega
      have hs' : s * a ^ k = 0 := by
        rw [ha', ← mul_assoc, hsa, zero_mul]
      calc s * t * (a ^ k * b ^ (n + m - k) * (Nat.choose (n + m) k : A))
          = (s * a ^ k) * (t * b ^ (n + m - k) * (Nat.choose (n + m) k : A)) := by ring
        _ = 0 := by rw [hs', zero_mul]
  intro hS
  have hmem : s * t * (a + b) ^ (n + m) ∈ S := S.mul_mem (S.mul_mem hs ht) (S.pow_mem hS _)
  rw [hzero] at hmem
  exact hmax.1 hmem

/-! ### `A - S` is a minimal prime ideal -/

/-- For `S` maximal in `Σ`, the complement of `S` is an ideal. -/
def complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S) : Ideal A where
  carrier := (S : Set A)ᶜ
  add_mem' := fun hx hy => add_notMem_of_maximal hmax hx hy
  zero_mem' := hmax.1
  smul_mem' := fun r _ hx => mul_notMem_of_maximal hmax hx r

@[simp] theorem coe_complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S) :
    (complIdeal hmax : Set A) = (S : Set A)ᶜ := rfl

@[simp] theorem mem_complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S)
    {x : A} : x ∈ complIdeal hmax ↔ x ∉ S := Iff.rfl

/-- The complement of a maximal member of `Σ` is a prime ideal. -/
theorem isPrime_complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S) :
    (complIdeal hmax).IsPrime := by
  refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
  · intro h
    have h1 : (1 : A) ∈ complIdeal hmax := by rw [h]; exact Submodule.mem_top
    rw [mem_complIdeal] at h1
    exact h1 S.one_mem
  · intro x y hxy
    rw [mem_complIdeal] at hxy
    by_cases hx : x ∈ S
    · exact Or.inr (by rw [mem_complIdeal]; intro hy; exact hxy (S.mul_mem hx hy))
    · exact Or.inl (by rw [mem_complIdeal]; exact hx)

/-- The complement of a maximal member of `Σ` is a minimal prime ideal. -/
theorem isMinimalPrime_complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S) :
    IsMinimalPrime (complIdeal hmax) := by
  have hprime := isPrime_complIdeal hmax
  refine ⟨⟨hprime, bot_le⟩, ?_⟩
  rintro q ⟨hqprime, -⟩ hqle
  -- the complement of the prime ideal `q`, as a multiplicatively closed subset
  let T : Submonoid A :=
    { carrier := (q : Set A)ᶜ
      one_mem' := hqprime.one_notMem
      mul_mem' := fun {x y} hx hy hxy => by
        rcases hqprime.mem_or_mem hxy with h | h
        · exact absurd h hx
        · exact absurd h hy }
  -- `S` is contained in `T`
  have hSle : S ≤ T := fun x hx hxq => by
    have hx' : x ∉ S := by
      have := hqle hxq
      rwa [mem_complIdeal] at this
    exact hx' hx
  have hTmem : T ∈ Sigma (A := A) := by
    rw [mem_Sigma]
    intro h0
    exact h0 (Ideal.zero_mem q)
  have hle : T ≤ S := hmax.2 hTmem hSle
  intro x hx
  have hxS : x ∉ S := by rwa [mem_complIdeal] at hx
  by_contra hxq
  exact hxS (hle hxq)

/-- `S` maximal in `Σ` implies that `A - S` is a minimal prime ideal. -/
theorem isMinimalPrimeCompl_of_maximal {S : Submonoid A}
    (hmax : Maximal (· ∈ Sigma (A := A)) S) : IsMinimalPrimeCompl S :=
  ⟨complIdeal hmax, rfl, isMinimalPrime_complIdeal hmax⟩

/-- Conversely, if `A - S` is a minimal prime ideal then `S` is maximal in `Σ`. -/
theorem maximal_of_isMinimalPrimeCompl {S : Submonoid A} (h : IsMinimalPrimeCompl S) :
    Maximal (· ∈ Sigma (A := A)) S := by
  obtain ⟨I, hI, hmin⟩ := h
  have hS0 : (0 : A) ∉ S := by
    intro h0
    have h0I : (0 : A) ∉ (I : Set A) := by
      rw [hI]
      exact fun h => h h0
    exact h0I (Ideal.zero_mem I)
  have hnt : Nontrivial A := ⟨0, 1, fun h01 => hS0 (by rw [h01]; exact S.one_mem)⟩
  refine ⟨hS0, ?_⟩
  intro T hT hST
  obtain ⟨M, hMmax, hTM⟩ := @exists_maximal_Sigma_ge A _ hnt T hT
  have hMprime := isPrime_complIdeal hMmax
  -- `A - M ⊆ A - T ⊆ A - S = I`
  have hle : complIdeal hMmax ≤ I := by
    intro x hx
    have hx' : x ∉ M := by rwa [mem_complIdeal] at hx
    have hxT : x ∉ T := fun hxT => hx' (hTM hxT)
    have hxS : x ∉ S := fun hxS => hxT (hST hxS)
    show x ∈ (I : Set A)
    rw [hI]
    exact hxS
  -- so `A - M = I` by minimality of `I`, whence `T ≤ M ≤ S`
  have heq : complIdeal hMmax = I := le_antisymm hle (hmin.2 ⟨hMprime, bot_le⟩ hle)
  intro x hxT
  by_contra hxS
  have hxI : x ∈ I := by
    show x ∈ (I : Set A)
    rw [hI]
    exact hxS
  have hxM : x ∈ complIdeal hMmax := by rw [heq]; exact hxI
  rw [mem_complIdeal] at hxM
  exact hxM (hTM hxT)

/-! ### The exercise -/

/-- Exercise 3.6, second assertion: `S ∈ Σ` is maximal if and only if `A - S` is a minimal
prime ideal of `A`. -/
theorem maximal_iff_isMinimalPrimeCompl (S : Submonoid A) :
    Maximal (· ∈ Sigma (A := A)) S ↔ IsMinimalPrimeCompl S :=
  ⟨isMinimalPrimeCompl_of_maximal, maximal_of_isMinimalPrimeCompl⟩

/-- Exercise 3.6, second assertion, with maximality spelled out: `0 ∉ S`, and any
multiplicatively closed `T ⊆ A` with `0 ∉ T` and `S ⊆ T` satisfies `T ⊆ S`. -/
theorem maximal_iff_isMinimalPrimeCompl' (S : Submonoid A) :
    ((0 : A) ∉ S ∧ ∀ T : Submonoid A, (0 : A) ∉ T → S ≤ T → T ≤ S) ↔
      IsMinimalPrimeCompl S := by
  rw [← maximal_iff_isMinimalPrimeCompl]
  exact ⟨fun h => ⟨h.1, fun T hT hle => h.2 T hT hle⟩,
    fun h => ⟨h.1, fun T hT hle => h.2 hT hle⟩⟩

/-- Complements of minimal primes are maximal elements of `Σ` (the converse direction of
Exercise 3.6, stated directly for prime ideals). -/
theorem maximal_primeCompl {I : Ideal A} [I.IsPrime] (hI : IsMinimalPrime I) :
    Maximal (· ∈ Sigma (A := A)) I.primeCompl := by
  refine maximal_of_isMinimalPrimeCompl ⟨I, ?_, hI⟩
  rw [show ((I.primeCompl : Submonoid A) : Set A) = (I : Set A)ᶜ from rfl, compl_compl]

/-- For `S` maximal in `Σ`, `S` is the complement of the prime ideal `A - S`. -/
theorem eq_compl_complIdeal {S : Submonoid A} (hmax : Maximal (· ∈ Sigma (A := A)) S) :
    (S : Set A) = (complIdeal hmax : Set A)ᶜ := by
  rw [coe_complIdeal, compl_compl]

/-- Consequence: every multiplicatively closed subset avoiding `0` is contained in the
complement of a minimal prime ideal (compare the saturation of Exercise 3.7). -/
theorem subset_notMem_minimalPrime [Nontrivial A] {S : Submonoid A}
    (hS : S ∈ Sigma (A := A)) : ∃ I : Ideal A, IsMinimalPrime I ∧ ∀ x ∈ S, x ∉ I := by
  obtain ⟨M, hMmax, hSM⟩ := exists_maximal_Sigma_ge S hS
  obtain ⟨I, hI, hmin⟩ := isMinimalPrimeCompl_of_maximal hMmax
  refine ⟨I, hmin, fun x hx hxI => ?_⟩
  have hx' : x ∈ (I : Set A) := hxI
  rw [hI] at hx'
  exact hx' (hSM hx)

/-- Sanity check (the statement is not vacuous): for `A = ℤ` the multiplicatively closed
subset of nonzero integers is maximal in `Σ`, its complement being the minimal prime
`(0)`. -/
theorem maximal_nonZeroDivisors_int : Maximal (· ∈ Sigma (A := ℤ)) (nonZeroDivisors ℤ) := by
  rw [maximal_iff_isMinimalPrimeCompl]
  refine ⟨⊥, ?_, ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun q _ _ => bot_le⟩⟩
  ext x
  simp [mem_nonZeroDivisors_iff_ne_zero]

/-- Atiyah–Macdonald, Exercise 3.6, both assertions. -/
theorem solution [Nontrivial A] :
    (∃ S : Submonoid A, Maximal (· ∈ Sigma (A := A)) S) ∧
      (∀ S : Submonoid A, Maximal (· ∈ Sigma (A := A)) S ↔ IsMinimalPrimeCompl S) :=
  ⟨exists_maximal_Sigma, maximal_iff_isMinimalPrimeCompl⟩

end AtiyahMcdonald69.Ex_3_6
