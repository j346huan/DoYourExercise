# Atiyah–Macdonald (1969), Chapter II, Exercise 23

Statement (Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 2, Exercise 23):

> Let `B_λ` be a collection of `A`-algebras for `λ ∈ Λ`. When `J` is a finite subset of `Λ`, let
> `B_J` denote the tensor product of the `B_λ` for `λ ∈ J`. Then `B_J` is an `A`-algebra and if
> `J ⊆ J'` are finite sets, then there is a canonical map `B_J → B_{J'}`. Let `B` denote the direct
> limit of the `B_J` as `J` ranges over the finite subsets of `Λ`. Show that `B` has an `A`-algebra
> structure for which the maps `B_J → B` are `A`-algebra homomorphisms.

The formalisation follows the statement literally.

* `Bt A B J` is `⨂[A] i : {i // i ∈ J}, B i`, the tensor product over `A` of the `B i`, `i ∈ J`.
  It is a commutative ring and an `A`-algebra by the `PiTensorProduct` instances.
* `mu J J' h : Bt A B J →ₐ[A] Bt A B J'`, for `h : J ⊆ J'`, is the canonical map given by
  inserting factors `1` in the extra slots; its multilinearity is proved from scratch (`insMap`).
  It is the identity for `J = J'` (`mu_self`), compatible with composition (`mu_comp`) and with the
  structure maps of the `B_J` (`mu_algebraMap`), so the `B_J` form a directed system of
  `A`-algebras indexed by the finite subsets of `Λ` (directed by inclusion, `isDirected_finset`).
* `Binf A B` is the direct limit of this system.
* `structMap : A →+* Binf A B` is induced by the empty tensor product; the substance of the
  exercise is `structMap_eq_of`: all the composites `A → Bt A B J → Binf A B` agree.  It gives the
  `A`-algebra structure `instAlgebra` on the direct limit.
* `ofAlgHom J : Bt A B J →ₐ[A] Binf A B` is the canonical map, as an `A`-algebra homomorphism.
  Its underlying map is `of J = Ring.DirectLimit.of`.
* `lift_algHom` and `lift_algHom_unique` show that `B` is the direct limit of the `B_J` in the
  category of `A`-algebras: the `A`-algebra structure obtained is the correct one, not an
  accidental one.

-/

import Mathlib.RingTheory.PiTensorProduct
import Mathlib.Algebra.Colimit.Ring

open PiTensorProduct
open scoped TensorProduct

namespace AtiyahMcdonald69.Ex_2_23

noncomputable section

variable {A : Type*} [CommRing A]
variable {Λ : Type*} {B : Λ → Type*} [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)]

attribute [local instance] Classical.decEq

/-! ## The tensor products `B_J` and the canonical maps `B_J → B_{J'}` -/

/-- `Bt A B J` is the tensor product over `A` of the algebras `B i` for `i ∈ J`.  It is a
commutative ring and an `A`-algebra (instances generated by `PiTensorProduct`). -/
abbrev Bt (A : Type*) [CommRing A] {Λ : Type*} (B : Λ → Type*) [∀ i, CommRing (B i)]
    [∀ i, Algebra A (B i)] (J : Finset Λ) : Type _ := ⨂[A] i : {i // i ∈ J}, B i

/-- Each `B_J` is an `A`-algebra (the instance is inherited from `PiTensorProduct`). -/
example (J : Finset Λ) : Algebra A (Bt A B J) := inferInstance

/-- The finite subsets of `Λ` are directed by inclusion. -/
theorem isDirected_finset : IsDirectedOrder (Finset Λ) := inferInstance

instance isEmpty_subtype_empty : IsEmpty {i // i ∈ (∅ : Finset Λ)} :=
  ⟨fun i => (Finset.notMem_empty (α := Λ) (↑i)) i.2⟩

/-- Insert a tensor over `J` into the tensor product over `J'`, filling the extra slots with `1`. -/
def insFun (J J' : Finset Λ) (x : (i : {i // i ∈ J}) → B i) :
    (i : {i // i ∈ J'}) → B i :=
  fun i => if hi : (i : Λ) ∈ J then x ⟨i, hi⟩ else 1

@[simp] lemma insFun_apply (J J' : Finset Λ) (x : (i : {i // i ∈ J}) → B i)
    (i : {i // i ∈ J'}) :
    insFun J J' x i = if hi : (i : Λ) ∈ J then x ⟨i, hi⟩ else 1 := rfl

lemma insFun_update (J J' : Finset Λ) (h : J ⊆ J') (m : (i : {i // i ∈ J}) → B i)
    (i : {i // i ∈ J}) (v : B i) :
    insFun J J' (Function.update m i v) =
      Function.update (insFun J J' m) ⟨(i : Λ), h i.2⟩ v := by
  funext j
  by_cases hj : j = ⟨(i : Λ), h i.2⟩
  · subst hj
    rw [Function.update_self, insFun_apply, dif_pos i.2, Function.update_self]
  · have hne : (j : Λ) ≠ (i : Λ) := fun hh => hj (Subtype.ext hh)
    rw [Function.update_of_ne hj, insFun_apply, insFun_apply]
    by_cases hmem : (j : Λ) ∈ J
    · rw [dif_pos hmem, dif_pos hmem, Function.update_of_ne]
      intro hh
      exact hne (congrArg Subtype.val hh)
    · rw [dif_neg hmem, dif_neg hmem]

lemma insFun_self (J : Finset Λ) (x : (i : {i // i ∈ J}) → B i) : insFun J J x = x := by
  funext i
  rw [insFun_apply, dif_pos i.2]

lemma insFun_trans (J J' J'' : Finset Λ) (h1 : J ⊆ J')
    (x : (i : {i // i ∈ J}) → B i) : insFun J J'' x = insFun J' J'' (insFun J J' x) := by
  funext i
  by_cases hi : (i : Λ) ∈ J
  · rw [insFun_apply, dif_pos hi, insFun_apply, dif_pos (h1 hi), insFun_apply, dif_pos hi]
  · rw [insFun_apply, dif_neg hi, insFun_apply]
    by_cases hi' : (i : Λ) ∈ J'
    · rw [dif_pos hi', insFun_apply, dif_neg hi]
    · rw [dif_neg hi']

/-- The insertion map `x ↦ x ⊗ 1 ⊗ ⋯ ⊗ 1` is multilinear. -/
def insMap (J J' : Finset Λ) (h : J ⊆ J') :
    MultilinearMap A (fun i : {i // i ∈ J} => B i) (Bt A B J') :=
  MultilinearMap.mk' (fun x => tprod A (insFun J J' x))
    (by
      intro m i x y
      rw [insFun_update J J' h m i (x + y), insFun_update J J' h m i x,
        insFun_update J J' h m i y]
      exact MultilinearMap.map_update_add (tprod A) (insFun J J' m) ⟨(i : Λ), h i.2⟩ x y)
    (by
      intro m i c x
      rw [insFun_update J J' h m i (c • x), insFun_update J J' h m i x]
      exact MultilinearMap.map_update_smul (tprod A) (insFun J J' m) ⟨(i : Λ), h i.2⟩ c x)

@[simp] lemma insMap_apply (J J' : Finset Λ) (h : J ⊆ J')
    (x : (i : {i // i ∈ J}) → B i) : insMap J J' h x = tprod A (insFun J J' x) := rfl

/-- The canonical `A`-algebra map `B_J → B_{J'}` for `J ⊆ J'`, given by inserting factors `1`. -/
def mu (J J' : Finset Λ) (h : J ⊆ J') : Bt A B J →ₐ[A] Bt A B J' :=
  PiTensorProduct.liftAlgHom (insMap J J' h)
    (by
      rw [insMap_apply]
      have hone : insFun J J' (1 : (i : {i // i ∈ J}) → B i) = 1 := by
        funext i
        by_cases hi : (i : Λ) ∈ J
        · simp only [insFun_apply, dif_pos hi, Pi.one_apply]
        · simp only [insFun_apply, dif_neg hi, Pi.one_apply]
      rw [hone, ← PiTensorProduct.one_def])
    (by
      intro x y
      rw [insMap_apply, insMap_apply, insMap_apply]
      have hfun : insFun J J' (x * y) = insFun J J' x * insFun J J' y := by
        funext i
        by_cases hi : (i : Λ) ∈ J
        · simp only [insFun_apply, dif_pos hi, Pi.mul_apply]
        · simp only [insFun_apply, dif_neg hi, Pi.mul_apply, one_mul]
      rw [hfun, PiTensorProduct.tprod_mul_tprod])

/-- Evaluating the canonical map on a pure tensor. -/
theorem mu_tprod (J J' : Finset Λ) (h : J ⊆ J')
    (x : (i : {i // i ∈ J}) → B i) :
    mu J J' h (tprod A x) = tprod A (insFun J J' x) := by
  have h1 : mu J J' h (tprod A x) = insMap J J' h x := by
    simp only [mu, PiTensorProduct.liftAlgHom, AlgHom.ofLinearMap_apply,
      PiTensorProduct.lift.tprod]
  rw [h1, insMap_apply]

/-- The canonical maps are compatible with the `A`-algebra structure maps. -/
theorem mu_algebraMap (J J' : Finset Λ) (h : J ⊆ J') (a : A) :
    mu J J' h (algebraMap A (Bt A B J) a) = algebraMap A (Bt A B J') a :=
  (mu J J' h).commutes a

/-- The canonical map is the identity when `J = J'`. -/
theorem mu_self (J : Finset Λ) : mu J J (subset_refl J) = AlgHom.id A (Bt A B J) := by
  apply AlgHom.ext
  intro x
  induction x using PiTensorProduct.induction_on with
  | smul_tprod r m =>
      rw [map_smul, mu_tprod, insFun_self]
      rfl
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- The canonical maps are compatible with inclusions of finite sets. -/
theorem mu_comp (J J' J'' : Finset Λ) (h1 : J ⊆ J') (h2 : J' ⊆ J'') :
    mu (A := A) (B := B) J J'' (h1.trans h2) =
      (mu (A := A) (B := B) J' J'' h2).comp (mu (A := A) (B := B) J J' h1) := by
  apply AlgHom.ext
  intro x
  induction x using PiTensorProduct.induction_on with
  | smul_tprod r m =>
      simp only [AlgHom.coe_comp, Function.comp_apply, map_smul, mu_tprod]
      rw [insFun_trans J J' J'' h1 m]
  | add x y hx hy => simp only [map_add, hx, hy]

/-! ## The direct limit over the finite subsets of `Λ` -/

/-- The transition maps of the directed system, as functions (the shape required by
`Ring.DirectLimit`). -/
def muFun (J J' : Finset Λ) (h : J ≤ J') : Bt A B J → Bt A B J' := fun x => mu J J' h x

@[simp] lemma muFun_apply (J J' : Finset Λ) (h : J ≤ J') (x : Bt A B J) :
    muFun J J' h x = mu J J' h x := rfl

/-- `Binf A B` is the direct limit of the tensor products `Bt A B J` over the finite subsets
`J ⊆ Λ`, along the canonical maps `mu`. -/
abbrev Binf (A : Type*) [CommRing A] {Λ : Type*} (B : Λ → Type*) [∀ i, CommRing (B i)]
    [∀ i, Algebra A (B i)] : Type _ :=
  Ring.DirectLimit (fun J : Finset Λ => Bt A B J) (muFun (A := A) (B := B))

/-- The canonical map from the `J`-th component `B_J` into the direct limit `B`. -/
def of (J : Finset Λ) : Bt A B J →+* Binf A B :=
  Ring.DirectLimit.of (fun J : Finset Λ => Bt A B J) (muFun (A := A) (B := B)) J

lemma of_f {J J' : Finset Λ} (h : J ≤ J') (x : Bt A B J) :
    of J' (muFun J J' h x) = of J x :=
  Ring.DirectLimit.of_f h x

/-- The canonical maps of the direct limit are compatible with `mu`. -/
lemma of_mu {J J' : Finset Λ} (h : J ⊆ J') (x : Bt A B J) :
    of J' (mu J J' h x) = of J x :=
  of_f h x

/-- The structure map `A → B` of the direct limit, defined through the component of the empty set
(note that `B_∅ = A`). -/
def structMap : A →+* Binf A B :=
  (of (B := B) (∅ : Finset Λ)).comp (algebraMap A (Bt A B ∅))

/-- The composite `A → B_J → B` does not depend on the finite set `J`. -/
theorem structMap_eq_of (J : Finset Λ) (a : A) :
    structMap a = of J (algebraMap A (Bt A B J) a) := by
  rw [structMap, RingHom.comp_apply, ← of_mu (J := (∅ : Finset Λ)) (J' := J)
    (Finset.empty_subset J) (algebraMap A (Bt A B ∅) a), mu_algebraMap]

/-- The `A`-algebra structure on the direct limit `B`. -/
noncomputable instance instAlgebra : Algebra A (Binf A B) := (structMap (B := B)).toAlgebra

lemma algebraMap_apply (a : A) : algebraMap A (Binf A B) a = structMap a := rfl

lemma algebraMap_eq_of (J : Finset Λ) (a : A) :
    algebraMap A (Binf A B) a = of J (algebraMap A (Bt A B J) a) :=
  structMap_eq_of J a

/-- The tensor product over the empty finite set is `A`, i.e. `B_∅ = A`: the natural proof of the
exercise uses this identification to produce the structure map. -/
theorem bijective_algebraMap_empty :
    Function.Bijective (algebraMap A (Bt A B ∅)) := by
  let e : Bt A B ∅ ≃ₗ[A] A :=
    PiTensorProduct.isEmptyEquiv {i // i ∈ (∅ : Finset Λ)} (R := A)
      (s := fun i : {i // i ∈ (∅ : Finset Λ)} => B i)
  have he1 : ∀ (f : (i : {i // i ∈ (∅ : Finset Λ)}) → B i), e (tprod A f) = 1 := fun f =>
    PiTensorProduct.isEmptyEquiv_apply_tprod {i // i ∈ (∅ : Finset Λ)} (R := A)
      (s := fun i : {i // i ∈ (∅ : Finset Λ)} => B i) f
  have he1' : e (1 : Bt A B ∅) = 1 := by
    rw [PiTensorProduct.one_def, he1 1]
  have hleft : ∀ a : A, e (algebraMap A (Bt A B ∅) a) = a := by
    intro a
    rw [Algebra.algebraMap_eq_smul_one, PiTensorProduct.one_def, map_smul, he1 1,
      smul_eq_mul, mul_one]
  refine ⟨fun a b hab => ?_, fun x => ⟨e x, ?_⟩⟩
  · have h := congrArg e hab
    rwa [hleft, hleft] at h
  · induction x using PiTensorProduct.induction_on with
    | smul_tprod r f =>
        have hf : tprod A f = 1 := by
          apply e.injective
          rw [he1 f, he1']
        have hf' : tprod A f = tprod A (1 : (i : {i // i ∈ (∅ : Finset Λ)}) → B i) := by
          rw [hf, PiTensorProduct.one_def]
        rw [map_smul, he1 f, smul_eq_mul, mul_one, Algebra.algebraMap_eq_smul_one,
          PiTensorProduct.one_def, ← hf']
    | add x y hx hy => rw [map_add, map_add, hx, hy]

lemma of_algebraMap (J : Finset Λ) (a : A) :
    of J (algebraMap A (Bt A B J) a) = algebraMap A (Binf A B) a :=
  (algebraMap_eq_of J a).symm

/-- Each canonical map `B_J → B` is a homomorphism of `A`-algebras. -/
def ofAlgHom (J : Finset Λ) : Bt A B J →ₐ[A] Binf A B where
  toFun := of J
  map_one' := map_one _
  map_mul' := map_mul _
  map_zero' := map_zero _
  map_add' := map_add _
  commutes' := fun a => (algebraMap_eq_of J a).symm

@[simp] lemma ofAlgHom_apply (J : Finset Λ) (x : Bt A B J) :
    ofAlgHom J x = of J x := rfl

lemma ofAlgHom_mu {J J' : Finset Λ} (h : J ⊆ J') (x : Bt A B J) :
    ofAlgHom J' (mu J J' h x) = ofAlgHom J x :=
  of_mu h x

/-! ## The universal property of `B` in the category of `A`-algebras -/

/-- The direct limit `B`, with its `A`-algebra structure, satisfies the universal property of the
direct limit in the category of `A`-algebras: a compatible family of `A`-algebra maps out of the
components `B_J` factors through `B`. -/
theorem lift_algHom (C : Type*) [CommRing C] [Algebra A C]
    (g : ∀ J : Finset Λ, Bt A B J →ₐ[A] C)
    (hg : ∀ (J J' : Finset Λ) (h : J ⊆ J') (x : Bt A B J), g J' (mu J J' h x) = g J x) :
    ∃ G : Binf A B →ₐ[A] C, ∀ (J : Finset Λ) (x : Bt A B J), G (of J x) = g J x := by
  let φ : Binf A B →+* C :=
    Ring.DirectLimit.lift (fun J : Finset Λ => Bt A B J) (muFun (A := A) (B := B)) C
      (fun J => (g J).toRingHom) (fun J J' h x => hg J J' h x)
  have hφ : ∀ (J : Finset Λ) (x : Bt A B J), φ (of J x) = g J x := fun J x =>
    Ring.DirectLimit.lift_of C (fun J => (g J).toRingHom) (fun J J' h x => hg J J' h x) J x
  refine ⟨{ φ with commutes' := ?_ }, hφ⟩
  intro a
  rw [algebraMap_eq_of (J := (∅ : Finset Λ)) a]
  show φ (of (∅ : Finset Λ) (algebraMap A (Bt A B ∅) a)) = algebraMap A C a
  rw [hφ]
  exact (g ∅).commutes a

/-- Two `A`-algebra maps out of `B` which agree on every component agree everywhere. -/
theorem lift_algHom_unique (C : Type*) [CommRing C] [Algebra A C]
    (G₁ G₂ : Binf A B →ₐ[A] C)
    (h : ∀ (J : Finset Λ) (x : Bt A B J), G₁ (of J x) = G₂ (of J x)) : G₁ = G₂ := by
  apply AlgHom.ext
  intro z
  obtain ⟨J, x, rfl⟩ := Ring.DirectLimit.exists_of (G := fun J : Finset Λ => Bt A B J)
    (f := muFun (A := A) (B := B)) z
  exact h J x

/-! ## The statement of the exercise -/

/-- **Atiyah–Macdonald, Chapter 2, Exercise 23.**  The direct limit `B` of the finite tensor
products `B_J` carries a structure map `A →+* B` for which all the canonical maps `B_J → B` are
maps of `A`-algebras. -/
theorem main :
    ∃ φ : A →+* Binf A B, ∀ (J : Finset Λ) (a : A),
      of J (algebraMap A (Bt A B J) a) = φ a :=
  ⟨structMap, fun J a => (structMap_eq_of J a).symm⟩

/-- **Atiyah–Macdonald, Chapter 2, Exercise 23** (algebra homomorphism form): for every finite
`J ⊆ Λ` the canonical map `B_J → B` is an `A`-algebra homomorphism for the `A`-algebra structure
`instAlgebra` on the direct limit. -/
theorem main_algHom (J : Finset Λ) :
    ∃ F : Bt A B J →ₐ[A] Binf A B, ∀ x, F x = of J x :=
  ⟨ofAlgHom J, fun _ => rfl⟩

/-- Summary form of the exercise: the direct limit `B` carries a structure map `A →+* B` for which
every canonical map `B_J → B` is `A`-linear, i.e. an `A`-algebra homomorphism (compare
`ofAlgHom`). -/
theorem main_full :
    ∃ φ : A →+* Binf A B,
      (∀ (J : Finset Λ) (a : A), of J (algebraMap A (Bt A B J) a) = φ a) ∧
      (∀ (J : Finset Λ) (a : A) (x : Bt A B J),
        of J (algebraMap A (Bt A B J) a * x) = φ a * of J x) :=
  ⟨structMap, fun J a => (structMap_eq_of J a).symm, fun J a x => by
    rw [map_mul, show of J (algebraMap A (Bt A B J) a) = structMap a from
      (structMap_eq_of J a).symm]⟩

end

end AtiyahMcdonald69.Ex_2_23
