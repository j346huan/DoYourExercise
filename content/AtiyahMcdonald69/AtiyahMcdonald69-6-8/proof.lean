/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (Addison–Wesley, 1969),
Chapter 6, Exercise 8.  Original text (book, p. 79):

  "Show that Spec(A) is a Noetherian topological space whenever A is a Noetherian
   ring. Is the converse true?"

(Recall Chapter 6, Exercise 6: a topological space is Noetherian if every descending
chain of closed subsets is eventually stationary, equivalently every open subset is
quasi-compact.)

Source audit.  The extracted text of the public scan available here
(`atiyah-macdonald-original.txt`) stops at Corollary 6.11, i.e. before the exercise
list of Chapter 6, so the numbering could not be read off the scan itself.  The
statement above was checked against two independent sources that agree verbatim:
the published solutions (`.scratch/reference/atiyah-solutions.txt`, item 6.8) and
the reference solution below; the latter also records the dependency on Exercise
6.6, which is the definition of a Noetherian topological space used here.

Reference solution:
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-6-8

Contents:
* `spec_noetherian`     : the assertion of the exercise.
* `spec_noetherian_dcc` : the same assertion in the form of the definition of a
  Noetherian space given in Exercise 6.6 (d.c.c. on closed subsets).
* `converse_false`      : the converse fails.  The witness is
  `A = ℚ[X₀, X₁, …]/(Xᵢ² | i ∈ ℕ)`: every prime ideal of `A` contains every
  (nilpotent) variable, so `Spec A` is a single point and hence a Noetherian space,
  while `(x₀) ⊊ (x₀,x₁) ⊊ (x₀,x₁,x₂) ⊊ ⋯` is a strictly increasing chain of ideals
  of `A`, so `A` is not a Noetherian ring.
-/
import Mathlib

open MvPolynomial

namespace AtiyahMcdonald69.Ex_6_8

/-! ## Part 1: a Noetherian ring has a Noetherian spectrum -/

/-- **Atiyah–Macdonald, Chapter 6, Exercise 8, first part.**
If `A` is a Noetherian ring, then `Spec A` is a Noetherian topological space. -/
theorem spec_noetherian (A : Type*) [CommRing A] [IsNoetherianRing A] :
    TopologicalSpace.NoetherianSpace (PrimeSpectrum A) :=
  inferInstance

/-- The first part of Exercise 6.8 in the form of the definition of a Noetherian
space used in the book (Chapter 6, Exercise 6): every descending chain of closed
subsets of `Spec A` is eventually stationary. -/
theorem spec_noetherian_dcc (A : Type*) [CommRing A] [IsNoetherianRing A]
    (F : ℕ → TopologicalSpace.Closeds (PrimeSpectrum A)) (hF : Antitone F) :
    ∃ N, ∀ n, N ≤ n → F n = F N := by
  have hN : TopologicalSpace.NoetherianSpace (PrimeSpectrum A) := spec_noetherian A
  have hwf : WellFoundedLT (TopologicalSpace.Closeds (PrimeSpectrum A)) :=
    ((TopologicalSpace.noetherianSpace_TFAE (PrimeSpectrum A)).out 0 1).mp hN
  obtain ⟨_, ⟨N, rfl⟩, hmin⟩ := hwf.wf.has_min (Set.range F) ⟨F 0, Set.mem_range_self 0⟩
  refine ⟨N, fun n hn => ?_⟩
  rcases lt_or_eq_of_le (hF hn) with hlt | heq
  · exact absurd hlt (hmin (F n) (Set.mem_range_self n))
  · exact heq

/-! ## Part 2: the converse fails -/

/-- The polynomial ring `ℚ[X₀, X₁, X₂, …]` in countably many variables. -/
abbrev R : Type := MvPolynomial ℕ ℚ

/-- The ideal `(Xᵢ² | i ∈ ℕ)` generated by the squares of all the variables. -/
noncomputable abbrev sqIdeal : Ideal R := Ideal.span (Set.range fun i : ℕ => (X i) ^ 2)

/-- The counterexample ring `A = ℚ[X₀, X₁, …]/(Xᵢ² | i ∈ ℕ)`. -/
abbrev A : Type := R ⧸ sqIdeal

/-- Each variable is nilpotent in `A`. -/
lemma X_sq_eq_zero (i : ℕ) : (Ideal.Quotient.mk sqIdeal (X i) : A) ^ 2 = 0 := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- In `R`, a polynomial and its constant term agree modulo the ideal generated by
all the variables. -/
lemma sub_C_constantCoeff_mem_idealOfVars (f : R) :
    f - C (constantCoeff f) ∈ idealOfVars ℕ ℚ := by
  have h0 : (f - C (constantCoeff f)).coeff 0 = 0 := by
    have h : constantCoeff (f - C (constantCoeff f)) = 0 := by
      rw [map_sub, constantCoeff_C, sub_self]
    rwa [MvPolynomial.constantCoeff_eq] at h
  have key : ∀ m ∈ (f - C (constantCoeff f)).support, ∃ i ∈ (Set.univ : Set ℕ), m i ≠ 0 := by
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (mem_support_iff.mp hm) h0
    obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hm0
    exact ⟨i, trivial, Finsupp.mem_support_iff.mp hi⟩
  have h := (mem_ideal_span_X_image (s := (Set.univ : Set ℕ))).mpr key
  rw [Set.image_univ] at h
  exact h

/-- The kernel of the constant-term homomorphism is the ideal generated by all
variables. -/
lemma ker_constantCoeff : RingHom.ker (constantCoeff (σ := ℕ) (R := ℚ)) = idealOfVars ℕ ℚ := by
  refine le_antisymm ?_ ?_
  · intro f hf
    have hf' : constantCoeff f = 0 := RingHom.mem_ker.mp hf
    have h := sub_C_constantCoeff_mem_idealOfVars f
    rwa [hf', map_zero, sub_zero] at h
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (constantCoeff_X ℚ i)

/-- The ideal generated by all variables is maximal: the quotient is `ℚ`. -/
lemma idealOfVars_isMaximal : (idealOfVars ℕ ℚ).IsMaximal := by
  rw [Ideal.isMaximal_iff]
  constructor
  · intro h
    have h' : (1 : R) ∈ RingHom.ker (constantCoeff (σ := ℕ) (R := ℚ)) :=
      ker_constantCoeff.symm ▸ h
    have h2 : constantCoeff (1 : R) = 0 := RingHom.mem_ker.mp h'
    simp at h2
  · intro J x hKJ hxK hxJ
    have hx : constantCoeff x ≠ 0 := by
      intro h
      have h1 : x ∈ idealOfVars ℕ ℚ := ker_constantCoeff ▸ RingHom.mem_ker.mpr h
      exact hxK h1
    have hmem : C (constantCoeff x) ∈ J := by
      have h1 : x - C (constantCoeff x) ∈ idealOfVars ℕ ℚ := sub_C_constantCoeff_mem_idealOfVars x
      have h2 : x - C (constantCoeff x) ∈ J := hKJ h1
      have h3 : x - (x - C (constantCoeff x)) ∈ J := J.sub_mem hxJ h2
      rwa [sub_sub_cancel] at h3
    have hunit : (C (constantCoeff x)⁻¹ * C (constantCoeff x) : R) = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hx, map_one]
    rw [← hunit]
    exact Ideal.mul_mem_left J _ hmem

/-- Every prime ideal of `A` is the image of the ideal generated by all variables
of `R`; in particular `Spec A` has exactly one point. -/
lemma prime_eq (p : PrimeSpectrum A) :
    p.asIdeal = (idealOfVars ℕ ℚ).map (Ideal.Quotient.mk sqIdeal) := by
  have hX : ∀ i : ℕ, (X i : R) ∈ Ideal.comap (Ideal.Quotient.mk sqIdeal) p.asIdeal := by
    intro i
    have h2 : (Ideal.Quotient.mk sqIdeal (X i) : A) ∈ p.asIdeal := by
      refine p.isPrime.mem_of_pow_mem 2 ?_
      rw [X_sq_eq_zero i]
      exact p.asIdeal.zero_mem
    exact h2
  have hK : idealOfVars ℕ ℚ ≤ Ideal.comap (Ideal.Quotient.mk sqIdeal) p.asIdeal :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr hX)
  have hne : Ideal.comap (Ideal.Quotient.mk sqIdeal) p.asIdeal ≠ ⊤ := by
    intro h
    have h1 : (1 : R) ∈ Ideal.comap (Ideal.Quotient.mk sqIdeal) p.asIdeal := by
      rw [h]
      simp
    rw [Ideal.mem_comap, map_one] at h1
    exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1)
  have heq : Ideal.comap (Ideal.Quotient.mk sqIdeal) p.asIdeal = idealOfVars ℕ ℚ :=
    (idealOfVars_isMaximal.eq_of_le hne hK).symm
  rw [← heq]
  exact (Ideal.map_comap_of_surjective (Ideal.Quotient.mk sqIdeal)
    Ideal.Quotient.mk_surjective p.asIdeal).symm

/-- `Spec A` is a single point. -/
theorem counterexample_subsingleton : Subsingleton (PrimeSpectrum A) :=
  ⟨fun p q => PrimeSpectrum.ext (by rw [prime_eq p, prime_eq q])⟩

/-- `Spec A` is a Noetherian topological space (it is a one-point space). -/
theorem counterexample_spec_noetherian : TopologicalSpace.NoetherianSpace (PrimeSpectrum A) := by
  rw [TopologicalSpace.noetherianSpace_iff_opens]
  intro s
  have hs : (s : Set (PrimeSpectrum A)).Subsingleton :=
    fun x _ y _ => counterexample_subsingleton.elim x y
  rcases Set.Subsingleton.eq_empty_or_singleton hs with h | ⟨a, h⟩
  · rw [h]
    exact isCompact_empty
  · rw [h]
    exact isCompact_singleton

/-! ### `A` is not a Noetherian ring -/

/-- The ideal `(X₀, …, X_{n-1})` of `R`. -/
noncomputable abbrev K (n : ℕ) : Ideal R :=
  Ideal.span (Set.range fun i : Fin n => (X (i : ℕ) : R))

/-- The image in `A` of the ideal `(X₀, …, X_{n-1})`. -/
noncomputable abbrev chain (n : ℕ) : Ideal A := (K n).map (Ideal.Quotient.mk sqIdeal)

/-- For `x ∈ R`, the image of `x` in `R ⧸ I` lies in the image of an ideal `J` if and
only if `x ∈ J ⊔ I`. -/
lemma mk_mem_map_mk_iff {I J : Ideal R} {x : R} :
    Ideal.Quotient.mk I x ∈ J.map (Ideal.Quotient.mk I) ↔ x ∈ J ⊔ I := by
  have hker : Ideal.comap (Ideal.Quotient.mk I) ⊥ = I := Ideal.mk_ker
  constructor
  · intro hmem
    have h1 : Ideal.map (Ideal.Quotient.mk I) (Ideal.span {x}) ≤ J.map (Ideal.Quotient.mk I) := by
      rw [Ideal.map_span, Set.image_singleton]
      exact (Ideal.span_singleton_le_iff_mem (J.map (Ideal.Quotient.mk I))).mpr hmem
    have h2 : Ideal.span {x} ≤
        Ideal.comap (Ideal.Quotient.mk I) (J.map (Ideal.Quotient.mk I)) :=
      (Ideal.map_le_iff_le_comap (f := Ideal.Quotient.mk I)).mp h1
    rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
      hker] at h2
    exact (Ideal.span_singleton_le_iff_mem (J ⊔ I)).mp h2
  · intro hx
    have h1 : x ∈ Ideal.comap (Ideal.Quotient.mk I) (J.map (Ideal.Quotient.mk I)) := by
      rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective, hker]
      exact hx
    exact h1

/-- `X n` is not in `(X₀, …, X_{n-1}) ⊔ (Xᵢ² | i ∈ ℕ)`. -/
lemma X_notMem_sup (n : ℕ) : (X n : R) ∉ K n ⊔ sqIdeal := by
  intro h
  set S : Set (ℕ →₀ ℕ) :=
    Set.range (fun i : ℕ => Finsupp.single i 2) ∪
      Set.range (fun i : Fin n => Finsupp.single (i : ℕ) 1) with hS
  have hle : K n ⊔ sqIdeal ≤ Ideal.span ((fun s : ℕ →₀ ℕ => monomial s (1 : ℚ)) '' S) := by
    refine sup_le ?_ ?_
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      simp only []
      have hXi : (X (i : ℕ) : R) = monomial (Finsupp.single (i : ℕ) 1) (1 : ℚ) := by
        rw [← X_pow_eq_monomial, pow_one]
      rw [hXi]
      exact Ideal.subset_span ⟨_, Or.inr ⟨i, rfl⟩, rfl⟩
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      simp only []
      rw [X_pow_eq_monomial]
      exact Ideal.subset_span ⟨_, Or.inl ⟨i, rfl⟩, rfl⟩
  have h' := mem_ideal_span_monomial_image.mp (hle h)
  obtain ⟨si, hsi, hsi_le⟩ := h' (Finsupp.single n 1) (by
    rw [support_X]
    simp)
  rcases hsi with ⟨j, rfl⟩ | ⟨j, rfl⟩
  · rw [Finsupp.single_le_iff] at hsi_le
    rcases eq_or_ne j n with hjn | hjn
    · rw [hjn] at hsi_le
      simp at hsi_le
    · rw [Finsupp.single_eq_of_ne hjn] at hsi_le
      omega
  · rw [Finsupp.single_le_iff] at hsi_le
    rw [Finsupp.single_eq_of_ne (ne_of_lt j.isLt)] at hsi_le
    omega

/-- `A` is a nonzero ring, as required by the book's conventions: `X₀` is not in the
ideal generated by the squares of the variables. -/
lemma sqIdeal_ne_top : sqIdeal ≠ ⊤ := by
  intro h
  exact X_notMem_sup 0 (by rw [h]; exact Submodule.mem_sup_right Submodule.mem_top)

instance : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr sqIdeal_ne_top

/-- The ideals `(X₀, …, X_{n-1})` are nested. -/
lemma K_mono {m n : ℕ} (h : m ≤ n) : K m ≤ K n := by
  refine Ideal.span_le.mpr (Set.range_subset_iff.mpr ?_)
  intro i
  exact Ideal.subset_span ⟨⟨(i : ℕ), lt_of_lt_of_le i.isLt h⟩, rfl⟩

/-- The chain `(x₀) ⊊ (x₀,x₁) ⊊ ⋯` of ideals of `A` is strictly increasing. -/
lemma chain_lt_succ (n : ℕ) : chain n < chain (n + 1) := by
  refine lt_of_le_of_ne (Ideal.map_mono (K_mono (Nat.le_succ n))) ?_
  intro hEq
  have hmem : Ideal.Quotient.mk sqIdeal (X n) ∈ chain (n + 1) := by
    rw [mk_mem_map_mk_iff]
    exact Submodule.mem_sup_left (Ideal.subset_span ⟨⟨n, Nat.lt_succ_self n⟩, rfl⟩)
  rw [← hEq, mk_mem_map_mk_iff] at hmem
  exact X_notMem_sup n hmem

/-- `A` is not a Noetherian ring. -/
theorem counterexample_not_noetherian : ¬ IsNoetherianRing A := by
  intro hN
  have hmono : Monotone chain := monotone_nat_of_le_succ fun n => (chain_lt_succ n).le
  obtain ⟨n, hn⟩ := (monotone_stabilizes_iff_noetherian (R := A) (M := A)).mpr hN ⟨chain, hmono⟩
  exact (ne_of_lt (chain_lt_succ n)) (hn (n + 1) (Nat.le_succ n))

/-- **Atiyah–Macdonald, Chapter 6, Exercise 8, second part.**  The converse of the
first part is false. -/
theorem converse_false :
    ¬ ∀ (A' : Type) [CommRing A'],
      TopologicalSpace.NoetherianSpace (PrimeSpectrum A') → IsNoetherianRing A' :=
  fun h => counterexample_not_noetherian (h A counterexample_spec_noetherian)

/-- The counterexample, bundled: a nonzero ring with Noetherian spectrum which is not a
Noetherian ring. -/
theorem counterexample_data :
    Nontrivial A ∧ TopologicalSpace.NoetherianSpace (PrimeSpectrum A) ∧
      ¬ IsNoetherianRing A :=
  ⟨inferInstance, counterexample_spec_noetherian, counterexample_not_noetherian⟩

end AtiyahMcdonald69.Ex_6_8
