/-
Atiyah--Macdonald, *Introduction to Commutative Algebra*, Chapter 1, Exercise 3.

Let `A` be a commutative ring.  Exercise 1.2 asks, for `f = a_0 + a_1 X + ... + a_n X^n` in `A[X]`:

* (i)   `f` is a unit iff `a_0` is a unit and `a_1,...,a_n` are nilpotent;
* (ii)  `f` is nilpotent iff `a_0,...,a_n` are nilpotent;
* (iii) `f` is a zero-divisor iff there is `a != 0` in `A` with `a f = 0`;
* (iv)  `f` is primitive (the ideal generated by its coefficients is `(1)`) and
        `f g` is primitive iff `f` and `g` are primitive.

Exercise 1.3 asks for the same four criteria for the polynomial ring
`A[x_1,...,x_r] = MvPolynomial (Fin r) A` in several indeterminates:

* (i)   `f` is a unit iff its constant term is a unit of `A` and every coefficient of a
        nonconstant monomial is nilpotent;
* (ii)  `f` is nilpotent iff every coefficient of `f` is nilpotent;
* (iii) `f` is a zero-divisor iff there is `a != 0` in `A` with `a f = 0`.  This is the
        "scalar substitution" criterion: the annihilator of `f` meets `A` nontrivially.
        (The natural proof substitutes `x_i -> t^(N^(i-1))` for `N` larger than all exponents
        occurring in `f` and `g`, which turns `f g = 0` into a one-variable product without
        collisions between monomials and then applies Exercise 1.2 (iii).)
* (iv)  `f g` is primitive iff `f` and `g` are primitive, i.e. the ideal generated by the
        coefficients of `f g` is `(1)` iff the ideals generated by the coefficients of `f`
        and of `g` are both `(1)`.

Degenerate cases (the zero polynomial, a zero ring, `r = 0`) are covered by the statements
below; no properness or nonzeroness assumption is made.

Everything is proved from Mathlib alone; the file is standalone.
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_1_3

open MvPolynomial

variable {A : Type*} [CommRing A]

/-! ### Parts (ii) and (i): nilpotents and units, by iterating Exercise 1.2

Both criteria are proved by induction on the number of variables: the polynomials are
viewed as polynomials in the last variable over `A[x_1,...,x_{r-1}]` (`finSuccEquiv`) and the
one-variable criteria `Polynomial.isNilpotent_iff` and
`Polynomial.isUnit_iff_coeff_isUnit_isNilpotent` (Exercise 1.2 (i), (ii)) are applied once
per variable, exactly as in the natural proof of Exercise 1.3. -/

/-- Exercise 1.3 (ii): `f` in `A[x_1,...,x_r]` is nilpotent iff every coefficient of `f` is
nilpotent. -/
private lemma nilpotent_iff_coeff_aux (r : ℕ) :
    ∀ f : MvPolynomial (Fin r) A,
      IsNilpotent f ↔ ∀ d : Fin r →₀ ℕ, IsNilpotent (coeff d f) := by
  induction r with
  | zero =>
    intro f
    classical
    have hf : f = C (coeff 0 f) := by
      ext d
      have hd : d = 0 := Subsingleton.elim d 0
      subst hd
      simp
    rw [hf, IsNilpotent.map_iff (C_injective (Fin 0) A)]
    constructor
    · rintro h d
      have hd : d = 0 := Subsingleton.elim d 0
      subst hd
      simpa using h
    · intro h
      simpa using h 0
  | succ r ih =>
    intro f
    classical
    let e := finSuccEquiv A r
    have hiff : IsNilpotent f ↔ IsNilpotent (e f) :=
      ⟨fun h => h.map e, fun h => by simpa using h.map e.symm⟩
    rw [hiff, Polynomial.isNilpotent_iff]
    constructor
    · intro h d
      have hc : coeff (Finsupp.tail d) ((e f).coeff (d 0)) = coeff d f := by
        rw [finSuccEquiv_coeff_coeff (Finsupp.tail d) f (d 0), Finsupp.cons_tail]
      rw [← hc]
      exact (ih ((e f).coeff (d 0))).mp (h (d 0)) (Finsupp.tail d)
    · intro h i
      refine (ih ((e f).coeff i)).mpr (fun m => ?_)
      rw [finSuccEquiv_coeff_coeff m f i]
      exact h (Finsupp.cons i m)

/-- Exercise 1.3 (i): `f` in `A[x_1,...,x_r]` is a unit iff its constant term is a unit of
`A` and every coefficient of a nonconstant monomial is nilpotent. -/
private lemma unit_iff_aux (r : ℕ) :
    ∀ f : MvPolynomial (Fin r) A,
      IsUnit f ↔ IsUnit (coeff 0 f) ∧ ∀ d : Fin r →₀ ℕ, d ≠ 0 → IsNilpotent (coeff d f) := by
  induction r with
  | zero =>
    intro f
    classical
    have hf : f = C (coeff 0 f) := by
      ext d
      have hd : d = 0 := Subsingleton.elim d 0
      subst hd
      simp
    have hC : ∀ a : A, IsUnit (C a : MvPolynomial (Fin 0) A) ↔ IsUnit a := by
      intro a
      refine ⟨fun h => ?_, fun h => h.map C⟩
      have := h.map (constantCoeff : MvPolynomial (Fin 0) A →+* A)
      simpa using this
    conv_lhs => rw [hf]
    rw [hC]
    exact ⟨fun h => ⟨h, fun d hd => absurd (Subsingleton.elim d 0) hd⟩, fun h => h.1⟩
  | succ r ih =>
    intro f
    classical
    let e := finSuccEquiv A r
    have hiff : IsUnit f ↔ IsUnit (e f) :=
      ⟨fun h => h.map e, fun h => by simpa using h.map e.symm⟩
    rw [hiff, Polynomial.isUnit_iff_coeff_isUnit_isNilpotent]
    constructor
    · rintro ⟨h0, hpos⟩
      have h0' := (ih ((e f).coeff 0)).mp h0
      refine ⟨?_, fun d hd => ?_⟩
      · have hc : coeff 0 ((e f).coeff 0) = coeff 0 f := by
          rw [finSuccEquiv_coeff_coeff (0 : Fin r →₀ ℕ) f 0, Finsupp.cons_zero_zero]
        rw [← hc]
        exact h0'.1
      · have hc : coeff (Finsupp.tail d) ((e f).coeff (d 0)) = coeff d f := by
          rw [finSuccEquiv_coeff_coeff (Finsupp.tail d) f (d 0), Finsupp.cons_tail]
        rw [← hc]
        by_cases hd0 : d 0 = 0
        · rw [hd0]
          have ht : Finsupp.tail d ≠ 0 := by
            intro h
            apply hd
            rw [← Finsupp.cons_tail d, hd0, h, Finsupp.cons_zero_zero]
          exact h0'.2 (Finsupp.tail d) ht
        · exact (nilpotent_iff_coeff_aux r ((e f).coeff (d 0))).mp (hpos (d 0) hd0)
            (Finsupp.tail d)
    · rintro ⟨hunit, hpos⟩
      refine ⟨?_, fun i hi => ?_⟩
      · refine (ih ((e f).coeff 0)).mpr ⟨?_, ?_⟩
        · have hc : coeff 0 ((e f).coeff 0) = coeff 0 f := by
            rw [finSuccEquiv_coeff_coeff (0 : Fin r →₀ ℕ) f 0, Finsupp.cons_zero_zero]
          rw [hc]
          exact hunit
        · intro d hd
          have hc : coeff d ((e f).coeff 0) = coeff (Finsupp.cons 0 d) f :=
            finSuccEquiv_coeff_coeff d f 0
          rw [hc]
          exact hpos (Finsupp.cons 0 d) (by rw [Finsupp.cons_ne_zero_iff]; exact Or.inr hd)
      · refine (nilpotent_iff_coeff_aux r ((e f).coeff i)).mpr (fun m => ?_)
        rw [finSuccEquiv_coeff_coeff m f i]
        exact hpos (Finsupp.cons i m) (by rw [Finsupp.cons_ne_zero_iff]; exact Or.inl hi)

/-- Exercise 1.3 (ii). -/
theorem part_b {r : ℕ} (f : MvPolynomial (Fin r) A) :
    IsNilpotent f ↔ ∀ d : Fin r →₀ ℕ, IsNilpotent (coeff d f) :=
  nilpotent_iff_coeff_aux r f

/-- Exercise 1.3 (i). -/
theorem part_a {r : ℕ} (f : MvPolynomial (Fin r) A) :
    IsUnit f ↔ IsUnit (coeff 0 f) ∧ ∀ d : Fin r →₀ ℕ, d ≠ 0 → IsNilpotent (coeff d f) :=
  unit_iff_aux r f

/-- Cross-check: parts (i) and (ii) are also available in Mathlib in exactly this form. -/
theorem part_a_mathlib {r : ℕ} (f : MvPolynomial (Fin r) A) :
    IsUnit f ↔ IsUnit (coeff 0 f) ∧ ∀ d : Fin r →₀ ℕ, d ≠ 0 → IsNilpotent (coeff d f) :=
  MvPolynomial.isUnit_iff

/-- Cross-check: parts (i) and (ii) are also available in Mathlib in exactly this form. -/
theorem part_b_mathlib {r : ℕ} (f : MvPolynomial (Fin r) A) :
    IsNilpotent f ↔ ∀ d : Fin r →₀ ℕ, IsNilpotent (coeff d f) :=
  MvPolynomial.isNilpotent_iff

/-! ### Part (iii): zero-divisors

The mathematical content is the following contraction statement: if a *family* of
polynomials in `r` variables is annihilated by one nonzero polynomial `g`, then there is a
single nonzero scalar `a` in `A` killing every coefficient of every member of the family.
This is proved by induction on `r`: writing the polynomials as polynomials in the last
variable, take an annihilator `Q` of the family of minimal degree; then its leading
coefficient kills all coefficients of the family, and the induction hypothesis applies to
that family of coefficients.  This is the mechanism behind the "scalar substitution"
argument: the annihilator can be pushed down to the coefficient ring without ever losing
nonzeroness. -/

/-- Coefficient identity used in the contraction argument.  If all coefficients of `P`
above degree `l` are killed by `Q`, then the coefficient of `X ^ (l + deg Q)` in `P * Q`
is `(coeff P l) * (leadingCoeff Q)`. -/
private lemma coeff_mul_add_natDegree {S : Type*} [CommRing S] (P Q : Polynomial S) (l : ℕ)
    (h : ∀ i, l < i → P.coeff i • Q = 0) :
    (P * Q).coeff (l + Q.natDegree) = P.coeff l * Q.leadingCoeff := by
  have hsingle : (∑ k ∈ Finset.range (l + Q.natDegree).succ,
      P.coeff k * Q.coeff (l + Q.natDegree - k)) = P.coeff l * Q.leadingCoeff := by
    refine (Finset.sum_eq_single l ?_ ?_).trans ?_
    · -- terms with `k > l`: the `k`-th coefficient of `P` annihilates `Q`
      intro b _ hne
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · -- `l + deg Q - b > deg Q`
        have hq : Q.coeff (l + Q.natDegree - b) = 0 :=
          Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
        rw [hq, mul_zero]
      · have hz := h b hgt
        have hc := congrArg (fun p : Polynomial S => p.coeff (l + Q.natDegree - b)) hz
        simpa [Polynomial.coeff_smul, smul_eq_mul] using hc
    · exact fun hmem => absurd (Finset.mem_range.mpr (by omega)) hmem
    · rw [Nat.add_sub_cancel_left, Polynomial.coeff_natDegree]
  rw [Polynomial.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
    (fun i j => P.coeff i * Q.coeff j) (l + Q.natDegree)]
  exact hsingle

/-- Contraction lemma: if one nonzero polynomial `g` annihilates a family `F` of polynomials
in `r` variables, then one nonzero element of the coefficient ring annihilates all
coefficients of all the `F t`. -/
private lemma exists_scalar_annihilator {R : Type*} [CommRing R] (r : ℕ) :
    ∀ {ι : Type*} (F : ι → MvPolynomial (Fin r) R) (g : MvPolynomial (Fin r) R),
      g ≠ 0 → (∀ t, F t * g = 0) →
        ∃ a : R, a ≠ 0 ∧ ∀ (t : ι) (d : Fin r →₀ ℕ), a * coeff d (F t) = 0 := by
  induction r with
  | zero =>
    -- every polynomial in no variables is a constant
    intro ι F g hg hFg
    refine ⟨coeff 0 g, ?_, ?_⟩
    · intro h0
      apply hg
      ext d
      have hd : d = 0 := Subsingleton.elim d 0
      simpa [hd] using h0
    · intro t d
      have hf : F t = C (coeff 0 (F t)) := by
        ext e
        have he : e = 0 := Subsingleton.elim e 0
        simp [he]
      have h := congrArg (coeff 0) (hFg t)
      rw [hf, coeff_C_mul, coeff_zero] at h
      have hd : d = 0 := Subsingleton.elim d 0
      simpa [hd, mul_comm] using h
  | succ r ih =>
    intro ι F g hg hFg
    classical
    -- regard everything as a polynomial in the last variable over `R[x_0,...,x_{r-1}]`
    let e := finSuccEquiv R r
    let H : ι → Polynomial (MvPolynomial (Fin r) R) := fun t => e (F t)
    have hge : e g ≠ 0 := fun h => hg (e.injective (by simpa using h))
    have hH : ∀ t, H t * e g = 0 := by
      intro t
      change e (F t) * e g = 0
      rw [← map_mul, hFg t, map_zero]
    -- pick an annihilator of the family of minimal degree
    have hex : ∃ k : ℕ, ∃ q : Polynomial (MvPolynomial (Fin r) R),
        q ≠ 0 ∧ (∀ t, H t * q = 0) ∧ q.natDegree = k :=
      ⟨(e g).natDegree, e g, hge, hH, rfl⟩
    obtain ⟨Q, hQ, hQH, hdeg⟩ := Nat.find_spec hex
    have hmin : ∀ q : Polynomial (MvPolynomial (Fin r) R), q ≠ 0 →
        (∀ t, H t * q = 0) → Q.natDegree ≤ q.natDegree := by
      intro q hq hHq
      rw [hdeg]
      exact Nat.find_min' hex ⟨q, hq, hHq, rfl⟩
    -- the leading coefficient of `Q` kills every coefficient of every `H t`
    have hann : ∀ t i, Q.leadingCoeff * (H t).coeff i = 0 := by
      intro t
      have hall : ∀ i, (H t).coeff i • Q = 0 := by
        apply Nat.strong_decreasing_induction
        · exact ⟨(H t).natDegree, fun i hi => by
            rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, zero_smul]⟩
        intro l IH
        rcases (Polynomial.natDegree_smul_le ((H t).coeff l) Q).lt_or_eq with hlt | heq
        · -- a nonzero `(H t).coeff l • Q` would be an annihilator of smaller degree
          by_cases hz : (H t).coeff l • Q = 0
          · exact hz
          · have hc : ∀ j, H j * ((H t).coeff l • Q) = 0 := by
              intro j
              rw [Polynomial.smul_eq_C_mul, mul_left_comm, hQH j, mul_zero]
            exact absurd (hmin _ hz hc) (not_le.mpr hlt)
        · -- otherwise the coefficient at `l + deg Q` is both zero and `coeff l * lc Q`
          have hkey := coeff_mul_add_natDegree (H t) Q l (fun i hi => IH i hi)
          have hzero : (H t).coeff l * Q.leadingCoeff = 0 := by
            rw [← hkey, hQH t, Polynomial.coeff_zero]
          rwa [← Polynomial.leadingCoeff_eq_zero, ← Polynomial.coeff_natDegree,
            Polynomial.coeff_smul, heq, Polynomial.coeff_natDegree, smul_eq_mul]
      intro i
      have h := congrArg (fun p : Polynomial (MvPolynomial (Fin r) R) => p.coeff Q.natDegree)
        (hall i)
      simpa [Polynomial.coeff_smul, Polynomial.coeff_natDegree, smul_eq_mul, mul_comm] using h
    have hlc : Q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ
    -- apply the induction hypothesis to the family of coefficients of the `H t`
    obtain ⟨a, ha, haF⟩ := ih (fun p : ι × ℕ => (H p.1).coeff p.2) Q.leadingCoeff hlc
      (fun p => by simpa [mul_comm] using hann p.1 p.2)
    refine ⟨a, ha, ?_⟩
    intro t d
    have h := haF (t, d 0) (Finsupp.tail d)
    change a * coeff (Finsupp.tail d) ((finSuccEquiv R r (F t)).coeff (d 0)) = 0 at h
    simpa only [finSuccEquiv_coeff_coeff, Finsupp.cons_tail] using h

/-- The scalar form of the zero-divisor criterion: `f` is killed by `a != 0` iff `a` kills
every coefficient of `f`. -/
theorem exists_scalar_mul_eq_zero_iff {r : ℕ} (f : MvPolynomial (Fin r) A) :
    (∃ a : A, a ≠ 0 ∧ C a * f = 0) ↔ ∃ a : A, a ≠ 0 ∧ ∀ d : Fin r →₀ ℕ, a * coeff d f = 0 := by
  constructor
  · rintro ⟨a, ha, h⟩
    refine ⟨a, ha, fun d => ?_⟩
    have hd := congrArg (fun p : MvPolynomial (Fin r) A => coeff d p) h
    simpa [coeff_C_mul] using hd
  · rintro ⟨a, ha, h⟩
    refine ⟨a, ha, ?_⟩
    ext d
    simpa [coeff_C_mul] using h d

/-- Exercise 1.3 (iii): `f` in `A[x_1,...,x_r]` is a zero-divisor iff there is a nonzero
`a` in `A` with `a f = 0`. -/
theorem part_c {r : ℕ} (f : MvPolynomial (Fin r) A) :
    (∃ g : MvPolynomial (Fin r) A, g ≠ 0 ∧ f * g = 0) ↔
      ∃ a : A, a ≠ 0 ∧ C a * f = 0 := by
  constructor
  · rintro ⟨g, hg, hfg⟩
    obtain ⟨a, ha, hann⟩ :=
      exists_scalar_annihilator r (fun _ : Unit => f) g hg (fun _ => hfg)
    refine ⟨a, ha, ?_⟩
    ext d
    simpa [coeff_C_mul] using hann () d
  · rintro ⟨a, ha, h⟩
    refine ⟨C a, ?_, by rw [mul_comm]; exact h⟩
    intro h0
    apply ha
    simpa using congrArg (fun p : MvPolynomial (Fin r) A => coeff 0 p) h0

/-! ### Part (iv): primitive polynomials -/

/-- If all coefficients of `p` lie in an ideal `I` of `R`, then so do all coefficients of
`p * q`. -/
private lemma coeff_mul_mem_of_left {R : Type*} [CommRing R] {σ : Type*} (I : Ideal R)
    {p q : MvPolynomial σ R} (hp : ∀ d, coeff d p ∈ I) (d : σ →₀ ℕ) :
    coeff d (p * q) ∈ I := by
  have hp' : p ∈ Ideal.map (C : R →+* MvPolynomial σ R) I := mem_map_C_iff.mpr hp
  exact mem_map_C_iff.mp ((Ideal.map (C : R →+* MvPolynomial σ R) I).mul_mem_right q hp') d

/-- Exercise 1.3 (iv): for `f, g` in `A[x_1,...,x_r]`, the product `f g` is primitive (the
ideal generated by the coefficients of `f g` is the unit ideal) iff both `f` and `g` are
primitive. -/
theorem part_d {r : ℕ} (f g : MvPolynomial (Fin r) A) :
    Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d (f * g)) = ⊤ ↔
      Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d f) = ⊤ ∧
        Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d g) = ⊤ := by
  classical
  -- a factor of a primitive polynomial is primitive
  have hfactor : ∀ p q : MvPolynomial (Fin r) A,
      Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d (p * q)) = ⊤ →
        Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d p) = ⊤ := by
    intro p q hpq
    rw [eq_top_iff, ← hpq]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨d, rfl⟩
    exact coeff_mul_mem_of_left (Ideal.span (Set.range fun e : Fin r →₀ ℕ => coeff e p))
      (fun e => Ideal.subset_span ⟨e, rfl⟩) d
  constructor
  · intro h
    exact ⟨hfactor f g h, hfactor g f (by rw [mul_comm]; exact h)⟩
  · rintro ⟨hf, hg⟩
    by_contra h
    -- the ideal generated by the coefficients of `f g` is contained in a maximal ideal
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ h
    have hMmax : M.IsMaximal := hM
    have hz : ∀ p : MvPolynomial (Fin r) A,
        map (Ideal.Quotient.mk M) p = 0 ↔ ∀ d, coeff d p ∈ M := by
      intro p
      constructor
      · intro hp d
        have hd := congrArg (fun q : MvPolynomial (Fin r) (A ⧸ M) => coeff d q) hp
        simpa only [coeff_map, coeff_zero, Ideal.Quotient.eq_zero_iff_mem] using hd
      · intro hp
        ext d
        simpa only [coeff_map, coeff_zero] using
          (Ideal.Quotient.eq_zero_iff_mem.mpr (hp d) : Ideal.Quotient.mk M (coeff d p) = 0)
    -- over the field `A / M` the polynomial ring is a domain
    have hprod : map (Ideal.Quotient.mk M) f * map (Ideal.Quotient.mk M) g = 0 := by
      rw [← map_mul]
      exact (hz (f * g)).mpr (fun d => hle (Ideal.subset_span ⟨d, rfl⟩))
    rcases mul_eq_zero.mp hprod with hzero | hzero
    · have hle' : Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d f) ≤ M :=
        Ideal.span_le.mpr (by
          rintro _ ⟨d, rfl⟩
          exact (hz f).mp hzero d)
      exact hM.ne_top (top_le_iff.mp (hf ▸ hle'))
    · have hle' : Ideal.span (Set.range fun d : Fin r →₀ ℕ => coeff d g) ≤ M :=
        Ideal.span_le.mpr (by
          rintro _ ⟨d, rfl⟩
          exact (hz g).mp hzero d)
      exact hM.ne_top (top_le_iff.mp (hg ▸ hle'))

/-- Exercise 1.3 (iii), coefficient form: `f` is a zero-divisor iff some nonzero `a` in `A`
kills every coefficient of `f`. -/
theorem part_c_coeff {r : ℕ} (f : MvPolynomial (Fin r) A) :
    (∃ g : MvPolynomial (Fin r) A, g ≠ 0 ∧ f * g = 0) ↔
      ∃ a : A, a ≠ 0 ∧ ∀ d : Fin r →₀ ℕ, a * coeff d f = 0 :=
  (part_c f).trans (exists_scalar_mul_eq_zero_iff f)

#print axioms part_a
#print axioms part_b
#print axioms part_a_mathlib
#print axioms part_b_mathlib
#print axioms part_c
#print axioms part_c_coeff
#print axioms part_d

end AtiyahMcdonald69.Ex_1_3
