/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 4 (Primary decomposition),
Exercise 4.11.

Statement of the exercise (p. 56 of the book):

(a) If `𝔭` is a minimal prime ideal of a ring `A`, show that `S_𝔭(0)` (Exercise 10) is the
    smallest `𝔭`-primary ideal.
(b) Let `𝔞` be the intersection of the ideals `S_𝔭(0)` as `𝔭` runs through the minimal prime ideals
    of `A`. Show that `𝔞` is contained in the nilradical of `A`.
(c) Suppose that the zero ideal is decomposable. Prove that `𝔞 = (0)` if and only if every prime
    ideal of `(0)` is isolated.

Here `S_𝔭(0)` is, by definition (Exercise 4.10), the kernel of the canonical homomorphism
`A → A_𝔭`; a "prime ideal of `(0)`" is an ideal occurring as the radical of a member of a minimal
primary decomposition of `(0)`, and such a prime is *isolated* iff it is minimal among the primes
belonging to `(0)`, i.e. iff it is a minimal prime ideal of `A`.
-/
import Mathlib

open Ideal

namespace AtiyahMcdonald69.Ex_4_11

variable {A : Type*} [CommRing A]

/-! ### The ideal `S_𝔭(0)` -/

/-- `S_𝔭(0)`: the kernel of the canonical homomorphism `A → A_𝔭`
(Atiyah–Macdonald, Chapter 4, Exercise 10).  To keep the definition available for an arbitrary ideal
we localize at the submonoid generated by the complement of `𝔭`; for a prime ideal `𝔭` this is
exactly the complement of `𝔭`, so this is the usual `S_𝔭(0)`. -/
noncomputable def Sp0 (p : Ideal A) : Ideal A :=
  RingHom.ker (algebraMap A (Localization (Submonoid.closure (p : Set A)ᶜ)))

lemma closure_compl_le_primeCompl (p : Ideal A) [hp : p.IsPrime] :
    Submonoid.closure (p : Set A)ᶜ ≤ p.primeCompl := by
  rw [Submonoid.closure_le]
  intro x hx
  exact Ideal.mem_primeCompl_iff.mpr (by simpa using hx)

/-- The kernel of `A → A_S`, for an arbitrary submonoid `S`. -/
lemma mem_ker_algebraMap_iff (S : Submonoid A) (x : A) :
    x ∈ RingHom.ker (algebraMap A (Localization S)) ↔ ∃ s : S, (s : A) * x = 0 := by
  rw [RingHom.mem_ker, ← map_zero (algebraMap A (Localization S)),
    IsLocalization.eq_iff_exists S (Localization S)]
  exact ⟨fun ⟨c, hc⟩ => ⟨c, by simpa using hc⟩, fun ⟨c, hc⟩ => ⟨c, by simpa using hc⟩⟩

lemma mem_Sp0_iff (p : Ideal A) [hp : p.IsPrime] (x : A) :
    x ∈ Sp0 p ↔ ∃ s : p.primeCompl, (s : A) * x = 0 := by
  rw [Sp0, mem_ker_algebraMap_iff]
  exact ⟨fun ⟨s, hsx⟩ =>
      ⟨⟨s, Ideal.mem_primeCompl_iff.mp (closure_compl_le_primeCompl p s.2)⟩, hsx⟩,
    fun ⟨s, hsx⟩ =>
      ⟨⟨s, Submonoid.subset_closure (Ideal.mem_primeCompl_iff.mpr s.2)⟩, hsx⟩⟩

lemma mem_Sp0_iff' (p : Ideal A) [hp : p.IsPrime] (x : A) :
    x ∈ Sp0 p ↔ ∃ s : A, s ∉ p ∧ s * x = 0 := by
  rw [mem_Sp0_iff]
  exact ⟨fun ⟨s, hsx⟩ => ⟨s, Ideal.mem_primeCompl_iff.mp s.2, hsx⟩,
    fun ⟨s, hsp, hsx⟩ => ⟨⟨s, Ideal.mem_primeCompl_iff.mpr hsp⟩, hsx⟩⟩

/-- `S_𝔭(0)` is the contraction of the zero ideal of `A_𝔭`. -/
lemma Sp0_eq_comap (p : Ideal A) [hp : p.IsPrime] :
    Sp0 p = (⊥ : Ideal (Localization p.primeCompl)).comap
      (algebraMap A (Localization p.primeCompl)) := by
  ext x
  rw [Ideal.mem_comap, Submodule.mem_bot, mem_Sp0_iff, ← RingHom.mem_ker,
    mem_ker_algebraMap_iff]

lemma Sp0_eq_ker (p : Ideal A) [hp : p.IsPrime] :
    Sp0 p = RingHom.ker (algebraMap A (Localization p.primeCompl)) := by
  rw [Sp0_eq_comap p, RingHom.ker_eq_comap_bot]

lemma Sp0_le (p : Ideal A) [hp : p.IsPrime] : Sp0 p ≤ p := by
  intro x hx
  obtain ⟨s, hs⟩ := (mem_Sp0_iff p x).mp hx
  by_contra hxp
  have hmul : (s : A) * x ∈ p := by rw [hs]; exact p.zero_mem
  rcases hp.mem_or_mem hmul with h | h
  · exact s.2 h
  · exact hxp h

/-! ### Part (a) -/

theorem isPrimary_Sp0 (p : Ideal A) [hp : p.IsPrime] (hmin : IsMinimalPrime p) :
    (Sp0 p).IsPrimary := by
  -- the zero ideal of `A_𝔭` is primary because its radical is the maximal ideal
  have hbot : (⊥ : Ideal (Localization p.primeCompl)).IsPrimary := by
    apply isPrimary_of_isMaximal_radical
    have h := IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes (Localization p.primeCompl) p
      (⊥ : Ideal A) hmin
    rw [Ideal.map_bot, IsLocalization.AtPrime.map_eq_maximalIdeal p] at h
    rw [h]
    exact IsLocalRing.maximalIdeal.isMaximal _
  rw [Sp0_eq_comap p]
  exact hbot.comap _

theorem radical_Sp0 (p : Ideal A) [hp : p.IsPrime] (hmin : IsMinimalPrime p) :
    (Sp0 p).radical = p := by
  have h := IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes (Localization p.primeCompl) p
    (⊥ : Ideal A) hmin
  rw [Ideal.map_bot, IsLocalization.AtPrime.map_eq_maximalIdeal p] at h
  rw [Sp0_eq_comap p, ← Ideal.comap_radical, h]
  exact IsLocalization.AtPrime.under_maximalIdeal (Localization p.primeCompl) p

/-- The minimality half of Exercise 4.11 (a): `S_𝔭(0)` is contained in every `𝔭`-primary ideal. -/
theorem Sp0_le_of_isPrimary {p q : Ideal A} [hp : p.IsPrime]
    (hq : q.IsPrimary) (hqp : q.radical = p) : Sp0 p ≤ q := by
  intro x hx
  obtain ⟨s, hs⟩ := (mem_Sp0_iff p x).mp hx
  have hmul : (s : A) * x ∈ q := by rw [hs]; exact q.zero_mem
  have h := Submodule.IsPrimary.mem_or_mem hq (r := (s : A)) (m := x) (by simpa using hmul)
  rcases h with h | h
  · exact h
  · rw [Submodule.colon_univ, hqp] at h
    exact absurd h s.2

/-- **Exercise 4.11 (a)**: for a minimal prime ideal `𝔭` of `A`, `S_𝔭(0)` is the smallest
`𝔭`-primary ideal. -/
theorem part_a (p : Ideal A) [hp : p.IsPrime] (hmin : IsMinimalPrime p) :
    (Sp0 p).IsPrimary ∧ (Sp0 p).radical = p ∧
      ∀ q : Ideal A, q.IsPrimary → q.radical = p → Sp0 p ≤ q :=
  ⟨isPrimary_Sp0 p hmin, radical_Sp0 p hmin, fun _ hq hqp => Sp0_le_of_isPrimary hq hqp⟩

/-! ### Part (b) -/

/-- The ideal `𝔞` of Exercise 4.11: the intersection of the ideals `S_𝔭(0)` as `𝔭` runs through the
minimal prime ideals of `A`. -/
noncomputable def minInter : Ideal A :=
  ⨅ p : minimalPrimes A, Sp0 p.1

lemma mem_minInter_iff (x : A) :
    x ∈ minInter (A := A) ↔ ∀ p : minimalPrimes A, x ∈ Sp0 p.1 := by
  rw [minInter, Submodule.mem_iInf]

/-- **Exercise 4.11 (b)**, elementwise form: an element lying in `S_𝔭(0)` for every minimal prime
ideal `𝔭` of `A` lies in the nilradical. -/
theorem part_b (x : A) (hx : ∀ p ∈ minimalPrimes A, x ∈ Sp0 p) : x ∈ nilradical A := by
  have h : nilradical A = sInf (minimalPrimes A) := (Ideal.sInf_minimalPrimes (I := ⊥)).symm
  rw [h, Submodule.mem_sInf]
  intro p hp
  have : Ideal.IsPrime p := IsMinimalPrime.isPrime hp
  exact Sp0_le p (hx p hp)

/-- **Exercise 4.11 (b)**: the intersection `𝔞` of the ideals `S_𝔭(0)` over the minimal prime ideals
`𝔭` of `A` is contained in the nilradical of `A`. -/
theorem part_b_iInf : minInter (A := A) ≤ nilradical A := by
  intro x hx
  rw [mem_minInter_iff] at hx
  exact part_b x fun p hp => hx ⟨p, hp⟩

/-! ### Part (c): the decomposable case -/

section Decomposition

variable (t : Finset (Ideal A))

/-- The radical of a finite intersection of ideals is the intersection of the radicals. -/
lemma radical_finsetInf {ι : Type*} (t : Finset ι) (f : ι → Ideal A) :
    (t.inf f).radical = t.inf fun i => (f i).radical := by
  classical
  induction t using Finset.induction with
  | empty => simp
  | insert a s ha ih => rw [Finset.inf_insert, Finset.inf_insert, radical_inf, ih]

lemma radical_finsetInf_id (t : Finset (Ideal A)) :
    (t.inf id).radical = t.inf fun q => q.radical := by
  simpa using radical_finsetInf t id

/-- A minimal prime ideal is minimal among the prime ideals contained in it. -/
lemma IsMinimalPrime.le_of_le {p r : Ideal A} (hp : IsMinimalPrime p) (hr : r.IsPrime)
    (h : r ≤ p) : p ≤ r :=
  (hp : Minimal (fun q : Ideal A => q.IsPrime ∧ (⊥ : Ideal A) ≤ q) p).2 ⟨hr, bot_le⟩ h

/-- Every minimal prime ideal of `A` is the radical of one of the primary components of a minimal
primary decomposition of `(0)`: the set of "prime ideals belonging to `(0)`" contains the minimal
prime ideals of `A`. -/
lemma exists_radical_eq_of_mem_minimalPrimes
    (hinf : t.inf id = ⊥) (hprim : ∀ q ∈ t, q.IsPrimary)
    {p : Ideal A} (hp : p ∈ minimalPrimes A) :
    ∃ q ∈ t, q.radical = p := by
  have hp' : Ideal.IsPrime p := IsMinimalPrime.isPrime hp
  have hnil : nilradical A ≤ p := nilradical_le_prime p
  have hrad : nilradical A = t.inf fun q => q.radical := by
    rw [show nilradical A = (⊥ : Ideal A).radical from rfl, ← hinf, radical_finsetInf_id]
  obtain ⟨q, hqt, hqp⟩ := (Ideal.IsPrime.inf_le' hp').mp (hrad ▸ hnil)
  exact ⟨q, hqt, le_antisymm hqp
    (IsMinimalPrime.le_of_le hp (isPrime_radical (hprim q hqt)) hqp)⟩

/-- Key step of Exercise 4.11 (c): if `q` is the primary component of a minimal primary decomposition
of `(0)` whose radical `𝔭` is a *minimal* prime ideal, then `q = S_𝔭(0)`. -/
lemma Sp0_radical_eq_of_isMinimalPrime
    (hinf : t.inf id = ⊥) (hprim : ∀ q ∈ t, q.IsPrimary)
    (hdist : ∀ q ∈ t, ∀ q' ∈ t, q ≠ q' → q.radical ≠ q'.radical)
    {p : Ideal A} (hpt : p ∈ t) (hmin : IsMinimalPrime p.radical) :
    Sp0 p.radical = p := by
  have hp_prim : Ideal.IsPrime p.radical := isPrime_radical (hprim p hpt)
  refine le_antisymm (Sp0_le_of_isPrimary (hprim p hpt) rfl) ?_
  -- the remaining components are not all contained in `p.radical`
  have hJ : ¬ (t.erase p).inf id ≤ p.radical := by
    intro hle
    have h1 : (t.erase p).inf (fun q => q.radical) ≤ p.radical := by
      rw [← radical_finsetInf]
      exact (radical_mono hle).trans_eq (Ideal.radical_idem p)
    obtain ⟨q, hq_mem, hq_le⟩ := (Ideal.IsPrime.inf_le' hp_prim).mp h1
    have hqt : q ∈ t := Finset.mem_of_mem_erase hq_mem
    have hq_ne : q ≠ p := Finset.ne_of_mem_erase hq_mem
    have heq : q.radical = p.radical :=
      le_antisymm hq_le (IsMinimalPrime.le_of_le hmin (isPrime_radical (hprim q hqt)) hq_le)
    exact absurd heq (hdist q hqt p hpt hq_ne)
  obtain ⟨s, hsJ, hsp⟩ := SetLike.not_le_iff_exists.mp hJ
  intro x hx
  refine (mem_Sp0_iff p.radical x).mpr ⟨⟨s, hsp⟩, ?_⟩
  have h1 : s * x ∈ (t.erase p).inf id := Ideal.mul_mem_right x _ hsJ
  have h2 : s * x ∈ p := Ideal.mul_mem_left p s hx
  have h4 : s * x ∈ t.inf id := by
    conv_lhs => rw [← Finset.insert_erase hpt]
    rw [Finset.inf_insert]
    exact ⟨h2, h1⟩
  rw [hinf, Submodule.mem_bot] at h4
  exact h4

/-- **Exercise 4.11 (c)**: if `(0) = ⋂_{q ∈ t} q` is a minimal primary decomposition of the zero
ideal, then `𝔞 = 0` if and only if every prime ideal belonging to `(0)` (i.e. every `radical q`,
`q ∈ t`) is isolated, that is, is a minimal prime ideal of `A`. -/
theorem part_c
    (hinf : t.inf id = ⊥) (hprim : ∀ q ∈ t, q.IsPrimary)
    (hdist : ∀ q ∈ t, ∀ q' ∈ t, q ≠ q' → q.radical ≠ q'.radical)
    (hirr : ∀ q ∈ t, ¬ (t.erase q).inf id ≤ q) :
    minInter (A := A) = ⊥ ↔ ∀ q ∈ t, IsMinimalPrime q.radical := by
  constructor
  · intro hzero q hqt
    by_contra hnotmin
    have hqprim : Ideal.IsPrime q.radical := isPrime_radical (hprim q hqt)
    -- a strictly smaller prime ideal below `q.radical`
    have hex : ∃ r : Ideal A, r.IsPrime ∧ r ≤ q.radical ∧ ¬ q.radical ≤ r := by
      by_contra h
      apply hnotmin
      refine ⟨⟨hqprim, bot_le⟩, fun r hr hrle => ?_⟩
      by_contra hle
      exact h ⟨r, hr.1, hrle, hle⟩
    obtain ⟨r, hrprim, hrle, hrlt⟩ := hex
    have hnil : nilradical A ≤ r := nilradical_le_prime r
    have hrad : nilradical A = t.inf fun q => q.radical := by
      rw [show nilradical A = (⊥ : Ideal A).radical from rfl, ← hinf, radical_finsetInf_id]
    obtain ⟨q', hq't, hq'le⟩ := (Ideal.IsPrime.inf_le' hrprim).mp (hrad ▸ hnil)
    have hq'ne : q' ≠ q := fun h => hrlt (h ▸ hq'le)
    -- irredundancy provides an element of all other components outside `q`
    obtain ⟨x, hxJ, hxq⟩ := SetLike.not_le_iff_exists.mp (hirr q hqt)
    have key : ∀ (p : Ideal A), IsMinimalPrime p → x ∈ Sp0 p := by
      intro p hp
      obtain ⟨q₀, hq₀t, hq₀p⟩ := exists_radical_eq_of_mem_minimalPrimes t hinf hprim hp
      have hq₀ne : q₀ ≠ q := by
        rintro rfl
        exact hnotmin (hq₀p ▸ hp)
      have hxq₀ : x ∈ q₀ := Submodule.mem_finsetInf.mp hxJ q₀
        (Finset.mem_erase.mpr ⟨hq₀ne, hq₀t⟩)
      have h := Sp0_radical_eq_of_isMinimalPrime t hinf hprim hdist hq₀t (hq₀p ▸ hp)
      rw [← hq₀p, h]
      exact hxq₀
    have hxbot : x ∈ minInter (A := A) := by
      rw [mem_minInter_iff]
      exact fun p => key p.1 p.2
    rw [hzero, Submodule.mem_bot] at hxbot
    exact hxq (hxbot ▸ q.zero_mem)
  · intro hall
    refine le_antisymm ?_ bot_le
    intro x hx
    rw [mem_minInter_iff] at hx
    have hxq : ∀ q ∈ t, x ∈ q := by
      intro q hqt
      have h := Sp0_radical_eq_of_isMinimalPrime t hinf hprim hdist hqt (hall q hqt)
      rw [← h]
      exact hx ⟨q.radical, hall q hqt⟩
    have : x ∈ t.inf id := Submodule.mem_finsetInf.mpr hxq
    rw [hinf, Submodule.mem_bot] at this
    exact this

/-- **Exercise 4.11 (c)**, in the book's own terminology: a prime ideal `𝔭` belonging to `(0)`
(here: `𝔭 = radical q` for a member `q` of the minimal primary decomposition) is *isolated* iff no
prime ideal belonging to `(0)` is strictly contained in it.  Every prime belonging to `(0)` is
isolated iff every one of them is a minimal prime ideal of `A`. -/
lemma forall_isMinimalPrime_iff_isolated
    (hinf : t.inf id = ⊥) (hprim : ∀ q ∈ t, q.IsPrimary) :
    (∀ q ∈ t, IsMinimalPrime q.radical) ↔
      ∀ q ∈ t, ∀ q' ∈ t, q'.radical ≤ q.radical → q'.radical = q.radical := by
  constructor
  · intro hall q hqt q' hq't hle
    exact le_antisymm hle (IsMinimalPrime.le_of_le (hall q hqt) (isPrime_radical (hprim q' hq't)) hle)
  · intro hiso q hqt
    have hqprim : Ideal.IsPrime q.radical := isPrime_radical (hprim q hqt)
    refine ⟨⟨hqprim, bot_le⟩, fun r hr hrle => ?_⟩
    have hnil : nilradical A ≤ r := @nilradical_le_prime A _ r hr.1
    have hrad : nilradical A = t.inf fun q => q.radical := by
      rw [show nilradical A = (⊥ : Ideal A).radical from rfl, ← hinf, radical_finsetInf_id]
    obtain ⟨q', hq't, hq'le⟩ := (Ideal.IsPrime.inf_le' hr.1).mp (hrad ▸ hnil)
    have heq : q.radical = q'.radical := (hiso q hqt q' hq't (hq'le.trans hrle)).symm
    rw [heq]
    exact hq'le

/-- **Exercise 4.11 (c)**: the intersection `𝔞` of the ideals `S_𝔭(0)` over the minimal prime ideals
vanishes if and only if every prime ideal belonging to `(0)` is isolated. -/
theorem part_c_isolated
    (hinf : t.inf id = ⊥) (hprim : ∀ q ∈ t, q.IsPrimary)
    (hdist : ∀ q ∈ t, ∀ q' ∈ t, q ≠ q' → q.radical ≠ q'.radical)
    (hirr : ∀ q ∈ t, ¬ (t.erase q).inf id ≤ q) :
    minInter (A := A) = ⊥ ↔
      ∀ q ∈ t, ∀ q' ∈ t, q'.radical ≤ q.radical → q'.radical = q.radical := by
  rw [part_c t hinf hprim hdist hirr, forall_isMinimalPrime_iff_isolated t hinf hprim]

/-- **Exercise 4.11 (c)**, stated with the set of prime ideals *belonging* to `(0)`: by the first
uniqueness theorem for primary decompositions this set is independent of the chosen minimal primary
decomposition of `(0)`, so this is the book's formulation. -/
theorem part_c_associatedPrimes {t : Finset (Ideal A)}
    (ht : Submodule.IsMinimalPrimaryDecomposition (⊥ : Ideal A) t) :
    minInter (A := A) = ⊥ ↔ ∀ p ∈ (⊥ : Ideal A).associatedPrimes, IsMinimalPrime p := by
  have hinf : t.inf id = ⊥ := ht.inf_eq
  have hprim : ∀ q ∈ t, q.IsPrimary := fun q hq => ht.primary hq
  have hdist : ∀ q ∈ t, ∀ q' ∈ t, q ≠ q' → q.radical ≠ q'.radical := by
    intro q hq q' hq' hne
    simpa [Submodule.colon_univ] using ht.distinct hq hq' hne
  have hirr : ∀ q ∈ t, ¬ (t.erase q).inf id ≤ q := fun q hq => ht.minimal hq
  have himg : (fun J : Ideal A => (J.colon Set.univ).radical) '' t = (⊥ : Ideal A).associatedPrimes :=
    Submodule.IsMinimalPrimaryDecomposition.image_radical_eq_associated_primes ht
  rw [part_c t hinf hprim hdist hirr]
  constructor
  · intro hall p hp
    obtain ⟨q, hq, hqp⟩ := (himg.symm ▸ hp : p ∈ (fun J : Ideal A => (J.colon Set.univ).radical) '' t)
    rw [← hqp]
    simpa [Submodule.colon_univ] using hall q hq
  · intro hall q hq
    have hmem : (fun J : Ideal A => (J.colon Set.univ).radical) q ∈ (⊥ : Ideal A).associatedPrimes := by
      rw [← himg]
      exact Set.mem_image_of_mem _ hq
    exact hall _ (by simpa [Submodule.colon_univ] using hmem)

/-- **Exercise 4.11 (c)** for Noetherian rings, where the decomposability hypothesis of the exercise
holds automatically (Lasker–Noether). -/
theorem part_c_noetherian [IsNoetherianRing A] :
    minInter (A := A) = ⊥ ↔ ∀ p ∈ (⊥ : Ideal A).associatedPrimes, IsMinimalPrime p := by
  have : IsNoetherian A A := isNoetherianRing_iff.mp ‹IsNoetherianRing A›
  obtain ⟨t, ht⟩ := Submodule.IsLasker.exists_isMinimalPrimaryDecomposition
    (Submodule.isLasker A A) (⊥ : Ideal A)
  exact part_c_associatedPrimes ht

/-! ### The exercise as a single statement -/

/-- **Atiyah–Macdonald, Exercise 4.11**, all three parts, with `𝔭` ranging over prime ideals of a
commutative ring `A` and `t` over minimal primary decompositions of the zero ideal. -/
theorem solution :
    (∀ (p : Ideal A) [p.IsPrime], IsMinimalPrime p →
        (Sp0 p).IsPrimary ∧ (Sp0 p).radical = p ∧
          ∀ q : Ideal A, q.IsPrimary → q.radical = p → Sp0 p ≤ q) ∧
    (minInter (A := A) ≤ nilradical A) ∧
    (∀ t : Finset (Ideal A), t.inf id = ⊥ → (∀ q ∈ t, q.IsPrimary) →
        (∀ q ∈ t, ∀ q' ∈ t, q ≠ q' → q.radical ≠ q'.radical) →
        (∀ q ∈ t, ¬ (t.erase q).inf id ≤ q) →
        (minInter (A := A) = ⊥ ↔ ∀ q ∈ t, IsMinimalPrime q.radical)) :=
  ⟨fun p _ hmin => part_a p hmin, part_b_iInf, fun t => part_c t⟩

end Decomposition

end AtiyahMcdonald69.Ex_4_11

