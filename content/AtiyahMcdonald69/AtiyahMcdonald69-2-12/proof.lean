/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 2, Exercise 12.

Book statement (Chapter 2, "Tensor products", Exercise 12):

  "Let M be a finitely generated A-module and φ : M → Aⁿ a surjective homomorphism.
   Show that Ker(φ) is finitely generated.
   [Let e₁, …, eₙ be a basis of Aⁿ and choose uᵢ ∈ M such that φ(uᵢ) = eᵢ
    (1 ≤ i ≤ n). Show that M is the direct sum of Ker(φ) and the submodule generated
    by u₁, …, uₙ.]"

Both the statement and the content of the book's hint are formalized below.  Nothing
is assumed about `A` beyond being a commutative ring (in particular `A` is not
assumed to be Noetherian), and `n` is an arbitrary natural number, including `0`.

Audit of the supplied natural-language solution ("choose `uᵢ` with `φ uᵢ = eᵢ`, define
`s : Aⁿ → M` by `s eᵢ = uᵢ`; then `φ s = 1`, so `M = ker φ ⊕ s(Aⁿ)`; the map `1 - sφ`
projects `M` onto `ker φ`, and its values on a finite generating set of `M` generate
`ker φ`"): the argument is correct as stated and needs no Noetherian hypothesis.  The
points worth recording explicitly, all formalized here, are:

* `n = 0` is a genuine case and the argument covers it (`A^0` is the zero module, any
  `φ : M → A^0` is surjective and `ker φ = ⊤ = M` is finitely generated);
* `s(Aⁿ)` is exactly the submodule generated by `u₁, …, uₙ` (`range_lift`), and the
  decomposition `M = ker φ ⊕ s(Aⁿ)` is `IsCompl` (`ker_isCompl_span`), realized as an
  explicit linear isomorphism `ker φ × Aⁿ ≃ₗ M` (`prodEquiv`);
* `1 - sφ` indeed has image exactly `ker φ` and fixes `ker φ` pointwise
  (`range_kerProj`, `kerProj_eq_self`), which is what makes "its values on a finite
  generating set of `M` generate `ker φ`" true;
* the chosen `u₁, …, uₙ` are automatically `A`-linearly independent
  (`linearIndependent_section`) — the books's hint does not need this, but it is part
  of the structure of the decomposition;
* the argument is not special to `Aⁿ`: it works verbatim for `A^ι` with `ι` any finite
  index type (`ker_finite_of_surjective`);
* finite generation of `M` is not a technical convenience: for a surjection onto `A^ι`
  with `ι` finite, it is *equivalent* to finite generation of `ker φ`
  (`finite_iff_ker_finite`), so it cannot be dropped from the statement.

Note on placement in the book: Exercise 12 sits in the Chapter 2 exercise set, but its
content is about finitely generated modules and the free module `Aⁿ`; no tensor product
occurs in it, and none is introduced here.
-/
import Mathlib

open scoped BigOperators

namespace AtiyahMcdonald69.Ex_2_12

noncomputable section

variable {A : Type*} [CommRing A]

/-! ## The standard basis of `A^ι` -/

/-- The `i`-th standard basis vector of `A^ι = (ι → A)`, i.e. `j ↦ if j = i then 1 else 0`. -/
def stdBasis {ι : Type*} (i : ι) : ι → A := by
  classical
  exact fun j => if j = i then 1 else 0

@[simp]
theorem stdBasis_self {ι : Type*} (i : ι) : stdBasis (A := A) i i = 1 := by
  classical
  simp [stdBasis]

@[simp]
theorem stdBasis_of_ne {ι : Type*} {i j : ι} (h : j ≠ i) : stdBasis (A := A) i j = 0 := by
  classical
  simp [stdBasis, h]

/-- The standard basis vectors span `A^ι`: `f = ∑ i, f i • eᵢ`. -/
theorem sum_smul_stdBasis {ι : Type*} [Fintype ι] (f : ι → A) :
    ∑ i, f i • stdBasis (A := A) i = f := by
  classical
  funext j
  rw [Finset.sum_apply]
  rw [Finset.sum_eq_single j]
  · simp
  · intro i _ hij
    have h : stdBasis (A := A) i j = 0 := stdBasis_of_ne (Ne.symm hij)
    simp [h]
  · intro hj
    simp at hj

/-- The standard basis of `A^ι` is linearly independent. -/
theorem linearIndependent_stdBasis {ι : Type*} [Fintype ι] :
    LinearIndependent A (fun i : ι => stdBasis (A := A) i) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have h2 : (∑ x, g x • stdBasis (A := A) x) = g := sum_smul_stdBasis g
  rw [h2] at hg
  exact congrFun hg

/-- The standard basis of `A^ι` spans `A^ι`; together with `linearIndependent_stdBasis` this
says that `e₁, …, eₙ` is a basis of `Aⁿ`, as in the book's hint. -/
theorem span_stdBasis {ι : Type*} [Fintype ι] :
    Submodule.span A (Set.range (fun i : ι => stdBasis (A := A) i)) = ⊤ := by
  classical
  rw [eq_top_iff]
  intro f _
  rw [← sum_smul_stdBasis f]
  exact Submodule.sum_smul_mem _ (t := Finset.univ) (f := fun i => stdBasis (A := A) i) f
    fun i _ => Submodule.subset_span (Set.mem_range.mpr ⟨i, rfl⟩)

/-! ## The map `A^ι → M` determined by a family of vectors -/

variable {M : Type*} [AddCommGroup M] [Module A M]

/-- The `A`-linear map `A^ι → M` sending the standard basis vector `eᵢ` to `uᵢ`:
it is `f ↦ ∑ i, f i • uᵢ`. -/
def lift {ι : Type*} [Fintype ι] (u : ι → M) : (ι → A) →ₗ[A] M where
  toFun f := ∑ i, f i • u i
  map_add' f g := by
    simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' a f := by
    simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply]

@[simp]
theorem lift_apply {ι : Type*} [Fintype ι] (u : ι → M) (f : ι → A) :
    lift u f = ∑ i, f i • u i := rfl

@[simp]
theorem lift_stdBasis {ι : Type*} [Fintype ι] (u : ι → M) (i : ι) :
    lift u (stdBasis (A := A) i) = u i := by
  classical
  rw [lift_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    have h : stdBasis (A := A) i j = 0 := stdBasis_of_ne hji
    simp [h]
  · intro hi
    simp at hi

/-- If `φ (uᵢ) = eᵢ` for all `i`, then `lift u` is a section of `φ`. -/
theorem comp_lift_eq_id {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) : φ.comp (lift u) = LinearMap.id := by
  refine LinearMap.ext fun f => ?_
  simp only [LinearMap.comp_apply, LinearMap.id_apply, lift_apply, map_sum, map_smul, hu]
  exact sum_smul_stdBasis f

/-- The section property, in application form. -/
theorem apply_lift_eq {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) (f : ι → A) : φ (lift u f) = f :=
  LinearMap.congr_fun (comp_lift_eq_id φ u hu) f

/-- The range of `lift u` is the submodule generated by the `uᵢ`. -/
theorem range_lift {ι : Type*} [Fintype ι] (u : ι → M) :
    LinearMap.range (lift u) = Submodule.span A (Set.range u) := by
  classical
  ext x
  constructor
  · rintro ⟨f, rfl⟩
    rw [lift_apply]
    exact Submodule.sum_smul_mem (Submodule.span A (Set.range u)) (t := Finset.univ) (f := u) f
      fun i _ => Submodule.subset_span (Set.mem_range.mpr ⟨i, rfl⟩)
  · intro hx
    refine Submodule.span_le.mpr ?_ hx
    rintro _ ⟨i, rfl⟩
    exact ⟨stdBasis i, lift_stdBasis u i⟩

/-- The image of `lift u` is a complement of the kernel of any retraction `φ` of `lift u`. -/
theorem ker_isCompl_lift_range {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) :
    IsCompl (LinearMap.ker φ) (LinearMap.range (lift u)) := by
  have hs : ∀ f, φ (lift u f) = f := apply_lift_eq φ u hu
  constructor
  · rw [disjoint_iff]
    refine le_antisymm ?_ bot_le
    rintro x ⟨hx1, hx2⟩
    rw [Submodule.mem_bot]
    obtain ⟨f, rfl⟩ := hx2
    have hf0 : f = 0 := by
      have h1 : φ (lift u f) = 0 := LinearMap.mem_ker.mp hx1
      exact (hs f).symm.trans h1
    simp [hf0]
  · rw [codisjoint_iff]
    refine eq_top_iff.mpr ?_
    rintro x -
    have hsplit : x = (x - lift u (φ x)) + lift u (φ x) := (sub_add_cancel _ _).symm
    rw [hsplit]
    refine Submodule.add_mem_sup ?_ ?_
    · rw [LinearMap.mem_ker, map_sub, hs, sub_self]
    · exact ⟨φ x, rfl⟩

/-- `M` is the direct sum of `ker φ` and the submodule generated by the `uᵢ`. -/
theorem ker_isCompl_span {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) :
    IsCompl (LinearMap.ker φ) (Submodule.span A (Set.range u)) := by
  rw [← range_lift u]
  exact ker_isCompl_lift_range φ u hu

/-- The linear projection `1 - sφ` of the hint, where `s = lift u`. -/
def kerProj {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M) : M →ₗ[A] M :=
  LinearMap.id - (lift u).comp φ

theorem kerProj_apply {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M) (x : M) :
    kerProj φ u x = x - lift u (φ x) := rfl

/-- `1 - sφ` is the identity on `ker φ`. -/
theorem kerProj_eq_self {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    {x : M} (hx : x ∈ LinearMap.ker φ) : kerProj φ u x = x := by
  rw [kerProj_apply, LinearMap.mem_ker.mp hx, map_zero, sub_zero]

/-- `1 - sφ` maps `M` onto `ker φ`. -/
theorem range_kerProj {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) :
    LinearMap.range (kerProj φ u) = LinearMap.ker φ := by
  have hs : ∀ f, φ (lift u f) = f := apply_lift_eq φ u hu
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    rw [kerProj_apply, LinearMap.mem_ker, map_sub, hs, sub_self]
  · intro hx
    exact ⟨x, kerProj_eq_self φ u hx⟩

/-! ## The theorem -/

/-- **Exercise 2.12**, in the form in which the argument actually works: for *any*
finite index type `ι` and any surjective `φ : M →ₗ[A] (ι → A)` from a finitely
generated module `M`, the kernel of `φ` is finitely generated. -/
theorem ker_finite_of_surjective {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (hφ : Function.Surjective φ) [Module.Finite A M] : Module.Finite A (LinearMap.ker φ) := by
  classical
  choose u hu using hφ
  let v : ι → M := fun i => u (stdBasis (A := A) i)
  have hv : ∀ i, φ (v i) = stdBasis (A := A) i := fun i => hu _
  have hrange : LinearMap.range (kerProj φ v) = LinearMap.ker φ := range_kerProj φ v hv
  have hfg : (LinearMap.ker φ).FG := by
    rw [← hrange]
    have htop : (⊤ : Submodule A M).FG := Module.Finite.fg_top
    simpa only [Submodule.map_top] using Submodule.FG.map (f := kerProj φ v) htop
  exact Module.Finite.iff_fg.mpr hfg

/-- **Atiyah–Macdonald, Exercise 2.12.** Let `M` be a finitely generated `A`-module and
`φ : M → Aⁿ` a surjective `A`-module homomorphism. Then `ker φ` is finitely generated. -/
theorem ker_finite (n : ℕ) (φ : M →ₗ[A] (Fin n → A)) (hφ : Function.Surjective φ)
    [Module.Finite A M] : Module.Finite A (LinearMap.ker φ) :=
  ker_finite_of_surjective φ hφ

/-- The choice of `uᵢ ∈ M` with `φ uᵢ = eᵢ`, which the book's hint asks for. -/
theorem exists_section {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (hφ : Function.Surjective φ) : ∃ u : ι → M, ∀ i, φ (u i) = stdBasis (A := A) i := by
  classical
  choose u hu using hφ
  exact ⟨fun i => u (stdBasis i), fun i => hu _⟩

/-- The full content of the hint: there are `u₁, …, uₙ ∈ M` with `φ uᵢ = eᵢ` such that `M`
is the direct sum of `ker φ` and the submodule generated by the `uᵢ`. -/
theorem exists_section_isCompl {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (hφ : Function.Surjective φ) :
    ∃ u : ι → M, (∀ i, φ (u i) = stdBasis (A := A) i) ∧
      IsCompl (LinearMap.ker φ) (Submodule.span A (Set.range u)) := by
  classical
  choose u hu using hφ
  refine ⟨fun i => u (stdBasis i), fun i => hu _, ?_⟩
  exact ker_isCompl_span φ _ (fun i => hu _)

/-- The `uᵢ` of the hint are `A`-linearly independent. -/
theorem linearIndependent_section {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (u : ι → M) (hu : ∀ i, φ (u i) = stdBasis (A := A) i) : LinearIndependent A u := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have h2 : (∑ x, g x • stdBasis (A := A) x) = 0 := by
    have h := congrArg φ hg
    simpa [hu] using h
  rw [sum_smul_stdBasis] at h2
  exact congrFun h2

/-- Exercise 2.12 with the hint, for `Aⁿ = Fin n → A`. -/
theorem exists_section_isCompl_fin (n : ℕ) (φ : M →ₗ[A] (Fin n → A))
    (hφ : Function.Surjective φ) :
    ∃ u : Fin n → M, (∀ i, φ (u i) = stdBasis (A := A) i) ∧
      IsCompl (LinearMap.ker φ) (Submodule.span A (Set.range u)) :=
  exists_section_isCompl φ hφ

/-- The "direct sum" form of the book's hint: for `uᵢ ∈ M` with `φ uᵢ = eᵢ`, the map
`(k, f) ↦ k + ∑ i, f i • uᵢ` is a linear isomorphism `ker φ × A^ι ≃ₗ[A] M`. -/
def prodEquiv {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A)) (u : ι → M)
    (hu : ∀ i, φ (u i) = stdBasis (A := A) i) :
    ((LinearMap.ker φ) × (ι → A)) ≃ₗ[A] M where
  toFun p := (p.1 : M) + lift u p.2
  invFun x :=
    (⟨x - lift u (φ x), by
      rw [LinearMap.mem_ker, map_sub, apply_lift_eq φ u hu, sub_self]⟩, φ x)
  map_add' p q := by
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add]
    abel
  map_smul' a p := by
    simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, map_smul, smul_add,
      RingHom.id_apply]
  left_inv p := by
    obtain ⟨k, f⟩ := p
    have h1 : φ ((k : M) + lift u f) = f := by
      rw [map_add, LinearMap.mem_ker.mp k.2, zero_add, apply_lift_eq φ u hu]
    refine Prod.ext ?_ ?_
    · refine Subtype.ext ?_
      show (k : M) + lift u f - lift u (φ ((k : M) + lift u f)) = (k : M)
      rw [h1]
      abel
    · show φ ((k : M) + lift u f) = f
      exact h1
  right_inv x := by
    exact sub_add_cancel _ _

/-- Exercise 2.12 with the hint, in the direct-sum form, for `Aⁿ = Fin n → A`. -/
theorem exists_prodEquiv_fin (n : ℕ) (φ : M →ₗ[A] (Fin n → A))
    (hφ : Function.Surjective φ) :
    ∃ u : Fin n → M, (∀ i, φ (u i) = stdBasis (A := A) i) ∧
      Nonempty (((LinearMap.ker φ) × (Fin n → A)) ≃ₗ[A] M) := by
  classical
  choose u hu using hφ
  exact ⟨fun i => u (stdBasis i), fun i => hu _, ⟨prodEquiv φ _ (fun i => hu _)⟩⟩

/-- Converse of Exercise 2.12: if `ker φ` is finitely generated and `φ : M → A^ι` is
onto with `ι` finite, then `M` is finitely generated. -/
theorem finite_of_finite_ker {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (hφ : Function.Surjective φ) [Module.Finite A (LinearMap.ker φ)] : Module.Finite A M := by
  classical
  choose u hu using hφ
  let v : ι → M := fun i => u (stdBasis (A := A) i)
  have hv : ∀ i, φ (v i) = stdBasis (A := A) i := fun i => hu _
  refine Module.Finite.of_surjective ((LinearMap.ker φ).subtype.coprod (lift v)) ?_
  intro x
  refine ⟨(⟨x - lift v (φ x), ?_⟩, φ x), ?_⟩
  · rw [LinearMap.mem_ker, map_sub, apply_lift_eq φ v hv, sub_self]
  · rw [LinearMap.coprod_apply]
    simp

/-- Finite generation of `M` and of `ker φ` are equivalent for a surjection `φ : M → A^ι`
with `ι` finite.  So the hypothesis that `M` is finitely generated in Exercise 2.12 is not
a convenience: it is equivalent to the conclusion. -/
theorem finite_iff_ker_finite {ι : Type*} [Fintype ι] (φ : M →ₗ[A] (ι → A))
    (hφ : Function.Surjective φ) : Module.Finite A M ↔ Module.Finite A (LinearMap.ker φ) :=
  ⟨fun hM => @ker_finite_of_surjective A _ M _ _ ι _ φ hφ hM,
    fun hK => @finite_of_finite_ker A _ M _ _ ι _ φ hφ hK⟩

end

end AtiyahMcdonald69.Ex_2_12
