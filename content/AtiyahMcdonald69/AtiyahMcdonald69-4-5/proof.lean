/-
Atiyah–Macdonald (1969), Chapter 4, Exercise 5.

In the polynomial ring `K[x,y,z]` (`K` a field, `x,y,z` independent indeterminates) put
`𝔭₁ = (x,y)`, `𝔭₂ = (x,z)`, `𝔪 = (x,y,z)` and `𝔞 = 𝔭₁𝔭₂`.
Then `𝔭₁` and `𝔭₂` are prime, `𝔪` is maximal, and
`𝔞 = 𝔭₁ ∩ 𝔭₂ ∩ 𝔪²`  is a reduced (minimal) primary decomposition of `𝔞`,
with `𝔭₁, 𝔭₂` isolated and `𝔪` embedded.
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_4_5

open MvPolynomial

open scoped Pointwise

noncomputable section

variable (K : Type*) [Field K]

/-- The polynomial ring `K[x,y,z]` in three independent indeterminates. -/
abbrev Poly3 := MvPolynomial (Fin 3) K

/-- The indeterminate `x`. -/
def x : Poly3 K := MvPolynomial.X 0

/-- The indeterminate `y`. -/
def y : Poly3 K := MvPolynomial.X 1

/-- The indeterminate `z`. -/
def z : Poly3 K := MvPolynomial.X 2

/-- `𝔭₁ = (x,y)`. -/
def p1 : Ideal (Poly3 K) := Ideal.span {x K, y K}

/-- `𝔭₂ = (x,z)`. -/
def p2 : Ideal (Poly3 K) := Ideal.span {x K, z K}

/-- `𝔪 = (x,y,z)`. -/
def m : Ideal (Poly3 K) := Ideal.span {x K, y K, z K}

/-- `𝔞 = 𝔭₁𝔭₂`. -/
def a : Ideal (Poly3 K) := p1 K * p2 K

/-! ## Membership in ideals generated by variables -/

lemma image_X_pair : (MvPolynomial.X '' ({0, 1} : Set (Fin 3)) : Set (Poly3 K)) = {x K, y K} := by
  rw [Set.image_pair]
  simp [x, y]

lemma image_X_pair' : (MvPolynomial.X '' ({0, 2} : Set (Fin 3)) : Set (Poly3 K)) = {x K, z K} := by
  rw [Set.image_pair]
  simp [x, z]

lemma image_X_triple : (MvPolynomial.X '' ({0, 1, 2} : Set (Fin 3)) : Set (Poly3 K)) = {x K, y K, z K} := by
  ext f
  constructor
  · rintro ⟨a, ha, rfl⟩
    rcases (by simpa using ha : a = 0 ∨ a = 1 ∨ a = 2) with rfl | rfl | rfl <;> simp [x, y, z]
  · rintro (rfl | rfl | rfl)
    · exact ⟨0, by simp, rfl⟩
    · exact ⟨1, by simp, rfl⟩
    · exact ⟨2, by simp, rfl⟩

lemma p1_eq : p1 K = Ideal.span (MvPolynomial.X '' ({0, 1} : Set (Fin 3))) := by
  rw [p1, ← image_X_pair]

lemma p2_eq : p2 K = Ideal.span (MvPolynomial.X '' ({0, 2} : Set (Fin 3))) := by
  rw [p2, ← image_X_pair']

lemma m_eq : m K = Ideal.span (MvPolynomial.X '' ({0, 1, 2} : Set (Fin 3))) := by
  rw [m, ← image_X_triple]

lemma mem_p1_iff (f : Poly3 K) :
    f ∈ p1 K ↔ ∀ n ∈ f.support, n 0 ≠ 0 ∨ n 1 ≠ 0 := by
  rw [p1_eq, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h n hn
    obtain ⟨i, hi, hne⟩ := h n hn
    rcases (by simpa using hi : i = 0 ∨ i = 1) with rfl | rfl
    · exact Or.inl hne
    · exact Or.inr hne
  · intro h n hn
    rcases h n hn with h0 | h1
    · exact ⟨0, by simp, h0⟩
    · exact ⟨1, by simp, h1⟩

lemma mem_p2_iff (f : Poly3 K) :
    f ∈ p2 K ↔ ∀ n ∈ f.support, n 0 ≠ 0 ∨ n 2 ≠ 0 := by
  rw [p2_eq, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h n hn
    obtain ⟨i, hi, hne⟩ := h n hn
    rcases (by simpa using hi : i = 0 ∨ i = 2) with rfl | rfl
    · exact Or.inl hne
    · exact Or.inr hne
  · intro h n hn
    rcases h n hn with h0 | h2
    · exact ⟨0, by simp, h0⟩
    · exact ⟨2, by simp, h2⟩

lemma mem_m_iff (f : Poly3 K) :
    f ∈ m K ↔ ∀ n ∈ f.support, n 0 ≠ 0 ∨ n 1 ≠ 0 ∨ n 2 ≠ 0 := by
  rw [m_eq, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h n hn
    obtain ⟨i, hi, hne⟩ := h n hn
    rcases (by simpa using hi : i = 0 ∨ i = 1 ∨ i = 2) with rfl | rfl | rfl
    · exact Or.inl hne
    · exact Or.inr (Or.inl hne)
    · exact Or.inr (Or.inr hne)
  · intro h n hn
    rcases h n hn with h0 | h1 | h2
    · exact ⟨0, by simp, h0⟩
    · exact ⟨1, by simp, h1⟩
    · exact ⟨2, by simp, h2⟩

lemma m_eq_idealOfVars : m K = MvPolynomial.idealOfVars (Fin 3) K := by
  rw [m_eq, MvPolynomial.idealOfVars, ← Set.image_univ,
    show (Set.univ : Set (Fin 3)) = {0, 1, 2} from by ext i; fin_cases i <;> simp]

lemma mem_m_sq_iff (f : Poly3 K) :
    f ∈ m K ^ 2 ↔ ∀ n ∈ f.support, 2 ≤ n 0 + n 1 + n 2 := by
  rw [m_eq_idealOfVars, MvPolynomial.mem_pow_idealOfVars_iff]
  simp only [Finsupp.degree_eq_sum, Fin.sum_univ_three]

/-! ## The variables -/

lemma X_mem_span_X_image_iff {s : Set (Fin 3)} (i : Fin 3) :
    MvPolynomial.X i ∈ Ideal.span (MvPolynomial.X '' s : Set (Poly3 K)) ↔ i ∈ s := by
  rw [MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h
    have h1 := h (Finsupp.single i 1) (by rw [MvPolynomial.support_X]; simp)
    obtain ⟨j, hj, hne⟩ := h1
    rw [Finsupp.single_apply] at hne
    by_cases hij : i = j
    · subst hij; exact hj
    · rw [if_neg hij] at hne
      exact absurd rfl hne
  · intro h n hn
    rw [MvPolynomial.support_X, Finset.mem_singleton] at hn
    refine ⟨i, h, ?_⟩
    subst hn
    simp

lemma x_mem_p1 : x K ∈ p1 K := by
  rw [p1]; exact Ideal.subset_span (by simp)

lemma y_mem_p1 : y K ∈ p1 K := by
  rw [p1]; exact Ideal.subset_span (by simp)

lemma x_mem_p2 : x K ∈ p2 K := by
  rw [p2]; exact Ideal.subset_span (by simp)

lemma z_mem_p2 : z K ∈ p2 K := by
  rw [p2]; exact Ideal.subset_span (by simp)

lemma x_mem_m : x K ∈ m K := by
  rw [m]; exact Ideal.subset_span (by simp)

lemma y_mem_m : y K ∈ m K := by
  rw [m]; exact Ideal.subset_span (by simp)

lemma z_mem_m : z K ∈ m K := by
  rw [m]; exact Ideal.subset_span (by simp)

lemma y_notMem_p2 : y K ∉ p2 K := by
  rw [mem_p2_iff]
  intro h
  have h1 := h (Finsupp.single 1 1) (by rw [y]; rw [MvPolynomial.support_X]; simp)
  rw [Finsupp.single_apply, if_neg (by decide : (1 : Fin 3) ≠ 0),
    Finsupp.single_apply, if_neg (by decide : (1 : Fin 3) ≠ 2)] at h1
  rcases h1 with h1 | h1 <;> exact absurd rfl h1

lemma z_notMem_p1 : z K ∉ p1 K := by
  rw [mem_p1_iff]
  intro h
  have h1 := h (Finsupp.single 2 1) (by rw [z]; rw [MvPolynomial.support_X]; simp)
  rw [Finsupp.single_apply, if_neg (by decide : (2 : Fin 3) ≠ 0),
    Finsupp.single_apply, if_neg (by decide : (2 : Fin 3) ≠ 1)] at h1
  rcases h1 with h1 | h1 <;> exact absurd rfl h1

/-! ## Primality of `𝔭₁`, `𝔭₂` and maximality of `𝔪` -/

/-- Evaluation at "all variables except `X k` are zero", landing in `K[t]`. -/
def ρ (k : Fin 3) (K : Type*) [Field K] : Poly3 K →+* Polynomial K :=
  MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 3 => if i = k then Polynomial.X else 0)

lemma ρ_self (k : Fin 3) : ρ k K (MvPolynomial.X k) = Polynomial.X := by
  simp only [ρ, MvPolynomial.eval₂Hom_X']
  simp

lemma ρ_of_ne {k i : Fin 3} (hik : i ≠ k) : ρ k K (MvPolynomial.X i) = 0 := by
  simp only [ρ, MvPolynomial.eval₂Hom_X']
  simp [hik]

/-- The coefficient of `t^j` in the image of `f` under `ρ k` is the coefficient of the monomial
`X k ^ j` in `f`. -/
lemma coeff_ρ (k : Fin 3) (d : Fin 3 →₀ ℕ) (j : ℕ) :
    (d.prod (fun i m => (if i = k then (Polynomial.X : Polynomial K) else 0) ^ m)).coeff j
      = if d = Finsupp.single k j then 1 else 0 := by
  classical
  by_cases h : ∃ i ∈ d.support, i ≠ k
  · obtain ⟨i, hi, hik⟩ := h
    have hzero : d.prod (fun i m => (if i = k then (Polynomial.X : Polynomial K) else 0) ^ m) = 0 :=
      Finset.prod_eq_zero hi (by simp [hik, (Finsupp.mem_support_iff.mp hi)])
    rw [hzero, Polynomial.coeff_zero, if_neg]
    intro hd
    have h1 : (Finsupp.single k j : Fin 3 →₀ ℕ) i ≠ 0 := by
      rw [← hd]; exact Finsupp.mem_support_iff.mp hi
    rw [Finsupp.single_eq_of_ne hik] at h1
    exact h1 rfl
  · push Not at h
    have hsub : d.support ⊆ ({k} : Finset (Fin 3)) := by
      intro i hi; rw [Finset.mem_singleton]; exact h i hi
    rw [Finsupp.prod_of_support_subset (f := d) (s := {k}) hsub
      (g := fun i m => (if i = k then (Polynomial.X : Polynomial K) else 0) ^ m) (by simp)]
    rw [Finset.prod_singleton]
    have hd : d = Finsupp.single k (d k) := by
      rw [Finsupp.eq_single_iff]; exact ⟨hsub, rfl⟩
    have hX : ((if k = k then (Polynomial.X : Polynomial K) else 0) ^ (d k)).coeff j
        = (Polynomial.X ^ (d k)).coeff j := by rw [if_pos rfl]
    rw [hX, Polynomial.coeff_X_pow]
    by_cases hjk : j = d k
    · rw [if_pos hjk, if_pos]
      rw [hd, hjk]
    · rw [if_neg hjk, if_neg]
      rw [hd]
      intro hh
      have h1 : d k = j := by
        have h2 := congrArg (fun f : Fin 3 →₀ ℕ => f k) hh
        simpa using h2
      exact hjk h1.symm

lemma coeff_ρ_apply (k : Fin 3) (f : Poly3 K) (j : ℕ) :
    (ρ k K f).coeff j = f.coeff (Finsupp.single k j) := by
  induction f using MvPolynomial.induction_on' with
  | monomial d a =>
    simp only [ρ]
    rw [MvPolynomial.eval₂Hom_monomial, Polynomial.coeff_C_mul, coeff_ρ, MvPolynomial.coeff_monomial]
    split_ifs <;> simp only [mul_one, mul_zero]
  | add p q hp hq => simp [map_add, hp, hq]

/-- The kernel of `ρ k` is the ideal generated by all variables except `X k`. -/
lemma ker_ρ (k : Fin 3) :
    RingHom.ker (ρ k K) = Ideal.span (MvPolynomial.X '' {i : Fin 3 | i ≠ k}) := by
  ext f
  rw [RingHom.mem_ker, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h n hn
    by_contra hc
    push Not at hc
    have hn' : n = Finsupp.single k (n k) := by
      rw [Finsupp.eq_single_iff]
      refine ⟨?_, rfl⟩
      intro i hi
      rw [Finset.mem_singleton]
      by_contra hik
      have h1 : n i = 0 := hc i hik
      rw [Finsupp.mem_support_iff] at hi
      exact hi h1
    have : f.coeff n = 0 := by
      rw [hn', ← coeff_ρ_apply, h]
      simp only [Polynomial.coeff_zero]
    exact (Finsupp.mem_support_iff.mp hn) this
  · intro h
    have hle : Ideal.span (MvPolynomial.X '' {i : Fin 3 | i ≠ k}) ≤ RingHom.ker (ρ k K) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, hi, rfl⟩
      show ρ k K (MvPolynomial.X i) = 0
      exact ρ_of_ne (K := K) hi
    exact hle (MvPolynomial.mem_ideal_span_X_image.mpr h)

theorem isPrime_span_X_compl (k : Fin 3) :
    (Ideal.span (MvPolynomial.X '' {i : Fin 3 | i ≠ k} : Set (Poly3 K))).IsPrime := by
  have h := RingHom.ker_isPrime (f := ρ k K)
  rwa [ker_ρ] at h

theorem isPrime_p1 : (p1 K).IsPrime := by
  have h : ({i : Fin 3 | i ≠ 2} : Set (Fin 3)) = {0, 1} := by
    ext i; fin_cases i <;> simp
  rw [p1_eq, ← h]
  exact isPrime_span_X_compl (K := K) 2

theorem isPrime_p2 : (p2 K).IsPrime := by
  have h : ({i : Fin 3 | i ≠ 1} : Set (Fin 3)) = {0, 2} := by
    ext i; fin_cases i <;> simp
  rw [p2_eq, ← h]
  exact isPrime_span_X_compl (K := K) 1

lemma m_eq_ker_constantCoeff :
    m K = RingHom.ker (MvPolynomial.constantCoeff : Poly3 K →+* K) := by
  rw [m_eq_idealOfVars, MvPolynomial.idealOfVars, ← Set.image_univ,
    show (Set.univ : Set (Fin 3)) = {0, 1, 2} from by ext i; fin_cases i <;> simp]
  ext f
  rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h
    by_contra hc
    have h0 : (0 : Fin 3 →₀ ℕ) ∈ f.support := by
      rw [MvPolynomial.mem_support_iff]; exact hc
    obtain ⟨i, -, hi⟩ := h 0 h0
    exact hi (by simp)
  · intro h n hn
    by_contra hc
    push Not at hc
    have hn0 : n = 0 := by
      ext i
      exact hc i (by fin_cases i <;> simp)
    rw [hn0] at hn
    rw [MvPolynomial.mem_support_iff] at hn
    exact hn h

theorem isMaximal_m : (m K).IsMaximal := by
  rw [m_eq_ker_constantCoeff]
  exact RingHom.ker_isMaximal_of_surjective _
    (fun r => ⟨MvPolynomial.C r, by simp⟩)

theorem isPrime_m : (m K).IsPrime := isMaximal_m K |>.isPrime

/-! ## The product `𝔭₁𝔭₂` and its intersection with `𝔪²` -/

section
variable {K : Type*} [Field K]

lemma p1_le_m : p1 K ≤ m K := by
  rw [p1, m]
  refine Ideal.span_mono ?_
  intro f hf
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf ⊢
  tauto

lemma p2_le_m : p2 K ≤ m K := by
  rw [p2, m]
  refine Ideal.span_mono ?_
  intro f hf
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf ⊢
  tauto

lemma X_eq_monomial (i : Fin 3) :
    MvPolynomial.X i = MvPolynomial.monomial (Finsupp.single i 1) (1 : K) := by
  simpa using (MvPolynomial.X_pow_eq_monomial (R := K) (n := i) (e := 1))

lemma monomial_mul_one (s t : Fin 3 →₀ ℕ) :
    MvPolynomial.monomial s (1 : K) * MvPolynomial.monomial t (1 : K)
      = MvPolynomial.monomial (s + t) 1 := by
  rw [MvPolynomial.monomial_mul, one_mul]

/-- The four exponent vectors of the monomials generating `𝔭₁𝔭₂`. -/
def aMon : Set (Fin 3 →₀ ℕ) :=
  {Finsupp.single 0 2, Finsupp.single 0 1 + Finsupp.single 1 1,
   Finsupp.single 0 1 + Finsupp.single 2 1, Finsupp.single 1 1 + Finsupp.single 2 1}

lemma x_mul_x : x K * x K = MvPolynomial.monomial (Finsupp.single 0 2) (1 : K) := by
  rw [x, ← pow_two, MvPolynomial.X_pow_eq_monomial]

lemma x_mul_y : x K * y K
    = MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) (1 : K) := by
  rw [x, y, X_eq_monomial 0, X_eq_monomial 1, monomial_mul_one]

lemma x_mul_z : x K * z K
    = MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 2 1) (1 : K) := by
  rw [x, z, X_eq_monomial 0, X_eq_monomial 2, monomial_mul_one]

lemma y_mul_z : y K * z K
    = MvPolynomial.monomial (Finsupp.single 1 1 + Finsupp.single 2 1) (1 : K) := by
  rw [y, z, X_eq_monomial 1, X_eq_monomial 2, monomial_mul_one]

/-- `𝔭₁𝔭₂ = (x², xy, xz, yz)`. -/
theorem a_eq_span :
    a K = Ideal.span {x K * x K, x K * y K, x K * z K, y K * z K} := by
  rw [a, p1, p2, Ideal.span_mul_span']
  congr 1
  ext f
  simp only [Set.mem_mul, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨u, (rfl | rfl), v, (rfl | rfl), hf⟩
    · exact Or.inl hf.symm
    · exact Or.inr (Or.inr (Or.inl hf.symm))
    · exact Or.inr (Or.inl (by rw [mul_comm]; exact hf.symm))
    · exact Or.inr (Or.inr (Or.inr hf.symm))
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨_, Or.inl rfl, _, Or.inl rfl, rfl⟩
    · exact ⟨_, Or.inr rfl, _, Or.inl rfl, mul_comm _ _⟩
    · exact ⟨_, Or.inl rfl, _, Or.inr rfl, rfl⟩
    · exact ⟨_, Or.inr rfl, _, Or.inr rfl, rfl⟩

theorem a_eq_mon' :
    a K = Ideal.span {MvPolynomial.monomial (Finsupp.single 0 2) (1 : K),
      MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1,
      MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 2 1) 1,
      MvPolynomial.monomial (Finsupp.single 1 1 + Finsupp.single 2 1) 1} := by
  rw [a_eq_span]
  congr 1
  rw [x_mul_x, x_mul_y, x_mul_z, y_mul_z]

theorem a_eq_mon :
    a K = Ideal.span ((fun s => MvPolynomial.monomial s (1 : K)) '' aMon) := by
  rw [a_eq_mon']
  congr 1
  ext f
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_image, aMon]
  constructor
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨_, Or.inl rfl, rfl⟩
    · exact ⟨_, Or.inr (Or.inl rfl), rfl⟩
    · exact ⟨_, Or.inr (Or.inr (Or.inl rfl)), rfl⟩
    · exact ⟨_, Or.inr (Or.inr (Or.inr rfl)), rfl⟩
  · rintro ⟨s, hs, hsf⟩
    rcases hs with rfl | rfl | rfl | rfl
    · exact Or.inl hsf.symm
    · exact Or.inr (Or.inl hsf.symm)
    · exact Or.inr (Or.inr (Or.inl hsf.symm))
    · exact Or.inr (Or.inr (Or.inr hsf.symm))

theorem inter_le_a : p1 K ⊓ p2 K ⊓ (m K) ^ 2 ≤ a K := by
  intro f hf
  rw [Ideal.mem_inf, Ideal.mem_inf] at hf
  obtain ⟨⟨hf1, hf2⟩, hfm⟩ := hf
  rw [mem_p1_iff] at hf1
  rw [mem_p2_iff] at hf2
  rw [mem_m_sq_iff] at hfm
  rw [a_eq_mon, MvPolynomial.mem_ideal_span_monomial_image]
  intro n hn
  have h1 := hf1 n hn
  have h2 := hf2 n hn
  have h3 := hfm n hn
  by_cases h0 : n 0 = 0
  · have hn1 : n 1 ≠ 0 := by tauto
    have hn2 : n 2 ≠ 0 := by tauto
    have hb : 1 ≤ n 1 := Nat.one_le_iff_ne_zero.mpr hn1
    have hc : 1 ≤ n 2 := Nat.one_le_iff_ne_zero.mpr hn2
    exact ⟨Finsupp.single 1 1 + Finsupp.single 2 1, by simp [aMon], by
      rw [Finsupp.le_def]
      intro i
      fin_cases i <;> simp [hb, hc]⟩
  · have h0' : 1 ≤ n 0 := Nat.one_le_iff_ne_zero.mpr h0
    rcases Nat.eq_zero_or_pos (n 1) with h1z | h1p
    · rcases Nat.eq_zero_or_pos (n 2) with h2z | h2p
      · have h20 : 2 ≤ n 0 := by omega
        exact ⟨Finsupp.single 0 2, by simp [aMon], by
          rw [Finsupp.single_le_iff]
          exact h20⟩
      · have h2p' : 1 ≤ n 2 := h2p
        exact ⟨Finsupp.single 0 1 + Finsupp.single 2 1, by simp [aMon], by
          rw [Finsupp.le_def]
          intro i
          fin_cases i <;> simp [h0', h2p']⟩
    · have h1p' : 1 ≤ n 1 := h1p
      exact ⟨Finsupp.single 0 1 + Finsupp.single 1 1, by simp [aMon], by
        rw [Finsupp.le_def]
        intro i
        fin_cases i <;> simp [h0', h1p']⟩

theorem a_le_inter : a K ≤ p1 K ⊓ p2 K ⊓ (m K) ^ 2 := by
  rw [a]
  refine le_inf (le_inf Ideal.mul_le_left Ideal.mul_le_right) ?_
  calc p1 K * p2 K ≤ m K * m K := Ideal.mul_mono (p1_le_m) (p2_le_m)
    _ = m K ^ 2 := (pow_two _).symm

end

/-- `𝔞 = 𝔭₁ ∩ 𝔭₂ ∩ 𝔪²`: the main computation of the exercise. -/
theorem a_eq_inter : a K = p1 K ⊓ p2 K ⊓ (m K) ^ 2 :=
  le_antisymm (a_le_inter) (inter_le_a)

/-! ## The primary decomposition -/

lemma monomial_mem_p1_iff (s : Fin 3 →₀ ℕ) (c : K) (hc : c ≠ 0) :
    MvPolynomial.monomial s c ∈ p1 K ↔ s 0 ≠ 0 ∨ s 1 ≠ 0 := by
  classical
  rw [mem_p1_iff, MvPolynomial.support_monomial, if_neg hc]
  simp

lemma monomial_mem_p2_iff (s : Fin 3 →₀ ℕ) (c : K) (hc : c ≠ 0) :
    MvPolynomial.monomial s c ∈ p2 K ↔ s 0 ≠ 0 ∨ s 2 ≠ 0 := by
  classical
  rw [mem_p2_iff, MvPolynomial.support_monomial, if_neg hc]
  simp

lemma monomial_mem_m_sq_iff (s : Fin 3 →₀ ℕ) (c : K) (hc : c ≠ 0) :
    MvPolynomial.monomial s c ∈ m K ^ 2 ↔ 2 ≤ s 0 + s 1 + s 2 := by
  classical
  rw [mem_m_sq_iff, MvPolynomial.support_monomial, if_neg hc]
  simp

lemma X_sq_eq (i : Fin 3) : MvPolynomial.X i ^ 2
    = MvPolynomial.monomial (Finsupp.single i 2) (1 : K) :=
  MvPolynomial.X_pow_eq_monomial

lemma y_sq_mem_p1 : y K ^ 2 ∈ p1 K := by
  rw [y, X_sq_eq]
  exact (monomial_mem_p1_iff (K := K) (s := Finsupp.single 1 2) (c := 1) one_ne_zero).mpr (by simp)

lemma z_sq_mem_p2 : z K ^ 2 ∈ p2 K := by
  rw [z, X_sq_eq]
  exact (monomial_mem_p2_iff (K := K) (s := Finsupp.single 2 2) (c := 1) one_ne_zero).mpr (by simp)

lemma y_sq_mem_m_sq : y K ^ 2 ∈ m K ^ 2 := by
  rw [y, X_sq_eq]
  exact (monomial_mem_m_sq_iff (K := K) (s := Finsupp.single 1 2) (c := 1) one_ne_zero).mpr (by simp)

lemma z_sq_mem_m_sq : z K ^ 2 ∈ m K ^ 2 := by
  rw [z, X_sq_eq]
  exact (monomial_mem_m_sq_iff (K := K) (s := Finsupp.single 2 2) (c := 1) one_ne_zero).mpr (by simp)

lemma y_sq_notMem_p2 : y K ^ 2 ∉ p2 K := by
  rw [y, X_sq_eq]
  exact (monomial_mem_p2_iff (K := K) (s := Finsupp.single 1 2) (c := 1) one_ne_zero).not.mpr (by simp)

lemma z_sq_notMem_p1 : z K ^ 2 ∉ p1 K := by
  rw [z, X_sq_eq]
  exact (monomial_mem_p1_iff (K := K) (s := Finsupp.single 2 2) (c := 1) one_ne_zero).not.mpr (by simp)

lemma x_mem_p1' : x K ∈ p1 K := x_mem_p1 K

lemma x_mem_p2' : x K ∈ p2 K := x_mem_p2 K

lemma x_notMem_m_sq : x K ∉ m K ^ 2 := by
  rw [x, X_eq_monomial]
  exact (monomial_mem_m_sq_iff (K := K) (s := Finsupp.single 0 1) (c := 1) one_ne_zero).not.mpr (by simp)

theorem radical_p1 : (p1 K).radical = p1 K := (isPrime_p1 K).isRadical.radical

theorem radical_p2 : (p2 K).radical = p2 K := (isPrime_p2 K).isRadical.radical

theorem radical_m_sq : (m K ^ 2).radical = m K := by
  rw [Ideal.radical_pow (m K) (by norm_num), (isPrime_m K).isRadical.radical]

theorem isPrimary_p1 : (p1 K).IsPrimary := (isPrime_p1 K).isPrimary

theorem isPrimary_p2 : (p2 K).IsPrimary := (isPrime_p2 K).isPrimary

theorem isPrimary_m_sq : (m K ^ 2).IsPrimary := by
  apply Ideal.isPrimary_of_isMaximal_radical
  rw [radical_m_sq]
  exact isMaximal_m K

theorem p1_ne_p2 : p1 K ≠ p2 K := by
  intro h
  exact y_notMem_p2 K (h ▸ y_mem_p1 K)

theorem p1_ne_m : p1 K ≠ m K := by
  intro h
  exact z_notMem_p1 K (h ▸ z_mem_m K)

theorem p2_ne_m : p2 K ≠ m K := by
  intro h
  exact y_notMem_p2 K (h ▸ y_mem_m K)

theorem p1_ne_m_sq : p1 K ≠ m K ^ 2 := by
  intro h
  refine p1_ne_m K ?_
  have h2 := congrArg Ideal.radical h
  rwa [radical_p1, radical_m_sq] at h2

theorem p2_ne_m_sq : p2 K ≠ m K ^ 2 := by
  intro h
  refine p2_ne_m K ?_
  have h2 := congrArg Ideal.radical h
  rwa [radical_p2, radical_m_sq] at h2

lemma inf_three : ({p1 K, p2 K, (m K) ^ 2} : Finset (Ideal (Poly3 K))).inf id
    = p1 K ⊓ p2 K ⊓ (m K) ^ 2 := by
  simp only [Finset.inf_insert, Finset.inf_singleton, id_eq]
  rw [← inf_assoc]

/-- `𝔞 = 𝔭₁ ∩ 𝔭₂ ∩ 𝔪²` is a reduced (minimal) primary decomposition of `𝔞`. -/
theorem isMinimalPrimaryDecomposition :
    Submodule.IsMinimalPrimaryDecomposition (a K) {p1 K, p2 K, (m K) ^ 2} where
  inf_eq := by
    rw [a_eq_inter, inf_three]
  primary := by
    intro J hJ
    simp only [Finset.mem_insert, Finset.mem_singleton] at hJ
    rcases hJ with rfl | rfl | rfl
    · exact isPrimary_p1 K
    · exact isPrimary_p2 K
    · exact isPrimary_m_sq K
  distinct := by
    intro J hJ J' hJ' hne
    simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hJ hJ'
    simp only [Function.onFun]
    rcases hJ with rfl | rfl | rfl <;> rcases hJ' with rfl | rfl | rfl <;>
      simp only [Submodule.colon_univ, radical_p1, radical_p2, radical_m_sq]
    · exact hne
    · exact p1_ne_p2 K
    · exact p1_ne_m K
    · exact fun h => p1_ne_p2 K h.symm
    · exact hne
    · exact p2_ne_m K
    · exact fun h => p1_ne_m K h.symm
    · exact fun h => p2_ne_m K h.symm
    · exact fun _ => hne rfl
  minimal := by
    intro J hJ
    simp only [Finset.mem_insert, Finset.mem_singleton] at hJ
    rcases hJ with rfl | rfl | rfl
    · intro hle
      have hz : z K ^ 2 ∈ (p2 K ⊓ (m K) ^ 2 : Ideal (Poly3 K)) :=
        ⟨z_sq_mem_p2 K, z_sq_mem_m_sq K⟩
      have hle' : (p2 K ⊓ (m K) ^ 2 : Ideal (Poly3 K))
          ≤ (({p1 K, p2 K, (m K) ^ 2} : Finset (Ideal (Poly3 K))).erase (p1 K)).inf id := by
        refine Finset.le_inf ?_
        intro J' hJ'
        simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton] at hJ'
        obtain ⟨hJ'ne, hJ'mem⟩ := hJ'
        rcases hJ'mem with h | h | h
        · subst h; exact absurd rfl hJ'ne
        · subst h; exact inf_le_left
        · subst h; exact inf_le_right
      exact z_sq_notMem_p1 K (hle (hle' hz))
    · intro hle
      have hy : y K ^ 2 ∈ (p1 K ⊓ (m K) ^ 2 : Ideal (Poly3 K)) :=
        ⟨y_sq_mem_p1 K, y_sq_mem_m_sq K⟩
      have hle' : (p1 K ⊓ (m K) ^ 2 : Ideal (Poly3 K))
          ≤ (({p1 K, p2 K, (m K) ^ 2} : Finset (Ideal (Poly3 K))).erase (p2 K)).inf id := by
        refine Finset.le_inf ?_
        intro J' hJ'
        simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton] at hJ'
        obtain ⟨hJ'ne, hJ'mem⟩ := hJ'
        rcases hJ'mem with h | h | h
        · subst h; exact inf_le_left
        · subst h; exact absurd rfl hJ'ne
        · subst h; exact inf_le_right
      exact y_sq_notMem_p2 K (hle (hle' hy))
    · intro hle
      have hx : x K ∈ (p1 K ⊓ p2 K : Ideal (Poly3 K)) := ⟨x_mem_p1 K, x_mem_p2 K⟩
      have hle' : (p1 K ⊓ p2 K : Ideal (Poly3 K))
          ≤ (({p1 K, p2 K, (m K) ^ 2} : Finset (Ideal (Poly3 K))).erase ((m K) ^ 2)).inf id := by
        refine Finset.le_inf ?_
        intro J' hJ'
        simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton] at hJ'
        obtain ⟨hJ'ne, hJ'mem⟩ := hJ'
        rcases hJ'mem with h | h | h
        · subst h; exact inf_le_left
        · subst h; exact inf_le_right
        · subst h; exact absurd rfl hJ'ne
      exact x_notMem_m_sq K (hle (hle' hx))

/-! ## Isolated and embedded primes -/

lemma a_le_p1 : a K ≤ p1 K := by
  rw [a]; exact Ideal.mul_le_left

lemma a_le_p2 : a K ≤ p2 K := by
  rw [a]; exact Ideal.mul_le_right

lemma a_le_m : a K ≤ m K := (a_le_p1 K).trans p1_le_m

/-- The radical of `𝔞 = 𝔭₁ ∩ 𝔭₂ ∩ 𝔪²` is `𝔭₁ ∩ 𝔭₂ ∩ 𝔪`. -/
theorem radical_a : (a K).radical = p1 K ⊓ p2 K ⊓ m K := by
  rw [a_eq_inter, Ideal.radical_inf, Ideal.radical_inf, radical_p1, radical_p2, radical_m_sq]

theorem p1_mem_minimalPrimes : p1 K ∈ (a K).minimalPrimes := by
  refine ⟨⟨isPrime_p1 K, a_le_p1 K⟩, ?_⟩
  intro q hq hle
  have h1 : (a K).radical ≤ q := by
    have h2 := Ideal.radical_mono hq.2
    rwa [hq.1.isRadical.radical] at h2
  have hle_q : p1 K ⊓ p2 K ⊓ m K ≤ q := by
    rw [← radical_a]
    exact h1
  have hx : x K ∈ q := hle_q ⟨⟨x_mem_p1 K, x_mem_p2 K⟩, x_mem_m K⟩
  have hyz_p1 : y K * z K ∈ p1 K := by
    have h := Submodule.mul_mem_mul (y_mem_p1 K) (Submodule.mem_top : z K ∈ (⊤ : Ideal (Poly3 K)))
    rwa [Ideal.mul_top] at h
  have hyz_p2 : y K * z K ∈ p2 K := by
    have h := Submodule.mul_mem_mul (Submodule.mem_top : y K ∈ (⊤ : Ideal (Poly3 K))) (z_mem_p2 K)
    rwa [Ideal.top_mul] at h
  have hyz_m : y K * z K ∈ m K := by
    have h := Submodule.mul_mem_mul (y_mem_m K) (Submodule.mem_top : z K ∈ (⊤ : Ideal (Poly3 K)))
    rwa [Ideal.mul_top] at h
  have hyz : y K * z K ∈ q := hle_q ⟨⟨hyz_p1, hyz_p2⟩, hyz_m⟩
  have hz : z K ∉ q := fun h => z_notMem_p1 K (hle h)
  have hy : y K ∈ q := (hq.1.mem_or_mem hyz).resolve_right hz
  rw [p1]
  refine Ideal.span_le.mpr ?_
  intro f hf
  rcases (by simpa using hf : f = x K ∨ f = y K) with rfl | rfl
  · exact hx
  · exact hy

theorem p2_mem_minimalPrimes : p2 K ∈ (a K).minimalPrimes := by
  refine ⟨⟨isPrime_p2 K, a_le_p2 K⟩, ?_⟩
  intro q hq hle
  have h1 : (a K).radical ≤ q := by
    have h2 := Ideal.radical_mono hq.2
    rwa [hq.1.isRadical.radical] at h2
  have hle_q : p1 K ⊓ p2 K ⊓ m K ≤ q := by
    rw [← radical_a]
    exact h1
  have hx : x K ∈ q := hle_q ⟨⟨x_mem_p1 K, x_mem_p2 K⟩, x_mem_m K⟩
  have hyz_p1 : y K * z K ∈ p1 K := by
    have h := Submodule.mul_mem_mul (y_mem_p1 K) (Submodule.mem_top : z K ∈ (⊤ : Ideal (Poly3 K)))
    rwa [Ideal.mul_top] at h
  have hyz_p2 : y K * z K ∈ p2 K := by
    have h := Submodule.mul_mem_mul (Submodule.mem_top : y K ∈ (⊤ : Ideal (Poly3 K))) (z_mem_p2 K)
    rwa [Ideal.top_mul] at h
  have hyz_m : y K * z K ∈ m K := by
    have h := Submodule.mul_mem_mul (y_mem_m K) (Submodule.mem_top : z K ∈ (⊤ : Ideal (Poly3 K)))
    rwa [Ideal.mul_top] at h
  have hyz : y K * z K ∈ q := hle_q ⟨⟨hyz_p1, hyz_p2⟩, hyz_m⟩
  have hy : y K ∉ q := fun h => y_notMem_p2 K (hle h)
  have hz : z K ∈ q := (hq.1.mem_or_mem hyz).resolve_left hy
  rw [p2]
  refine Ideal.span_le.mpr ?_
  intro f hf
  rcases (by simpa using hf : f = x K ∨ f = z K) with rfl | rfl
  · exact hx
  · exact hz

theorem m_notMem_minimalPrimes : m K ∉ (a K).minimalPrimes := by
  intro h
  have hmp : m K ≤ p1 K := h.2 (y := p1 K) ⟨isPrime_p1 K, a_le_p1 K⟩ p1_le_m
  exact z_notMem_p1 K (hmp (z_mem_m K))

/-- The isolated (minimal) primes belonging to `𝔞` are `𝔭₁` and `𝔭₂`. -/
theorem minimalPrimes_eq : (a K).minimalPrimes = {p1 K, p2 K} := by
  apply le_antisymm
  · intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    have hsub := Ideal.IsMinimalPrimaryDecomposition.minimalPrimes_subset_image_radical
      (isMinimalPrimaryDecomposition K)
    have h2 := hsub hq
    simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_image, Set.mem_insert_iff,
      Set.mem_singleton_iff] at h2
    obtain ⟨J, hJ, hJq⟩ := h2
    rcases hJ with rfl | rfl | rfl
    · left; rw [← hJq, radical_p1]
    · right; rw [← hJq, radical_p2]
    · rw [radical_m_sq] at hJq
      subst hJq
      exact absurd hq (m_notMem_minimalPrimes K)
  · intro q hq
    rcases (by simpa using hq : q = p1 K ∨ q = p2 K) with rfl | rfl
    · exact p1_mem_minimalPrimes K
    · exact p2_mem_minimalPrimes K

/-- The prime ideals belonging to `𝔞` (the associated primes) are `𝔭₁, 𝔭₂, 𝔪`. -/
theorem associatedPrimes_eq : (a K).associatedPrimes = {p1 K, p2 K, m K} := by
  have h := Submodule.IsMinimalPrimaryDecomposition.image_radical_eq_associated_primes
    (isMinimalPrimaryDecomposition K)
  rw [← h]
  ext q
  simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_image, Set.mem_insert_iff,
    Set.mem_singleton_iff]
  constructor
  · rintro ⟨J, (rfl | rfl | rfl), hJq⟩
    · left; rw [← hJq, Submodule.colon_univ, radical_p1]
    · right; left; rw [← hJq, Submodule.colon_univ, radical_p2]
    · right; right; rw [← hJq, Submodule.colon_univ, radical_m_sq]
  · rintro (rfl | rfl | rfl)
    · exact ⟨_, Or.inl rfl, by rw [Submodule.colon_univ, radical_p1]⟩
    · exact ⟨_, Or.inr (Or.inl rfl), by rw [Submodule.colon_univ, radical_p2]⟩
    · exact ⟨_, Or.inr (Or.inr rfl), by rw [Submodule.colon_univ, radical_m_sq]⟩

/-- `𝔮` is an isolated prime of `𝔞`: a minimal prime over `𝔞`. -/
def IsIsolatedPrime (q : Ideal (Poly3 K)) : Prop := q ∈ (a K).minimalPrimes

/-- `𝔮` is an embedded prime of `𝔞`: a prime belonging to `𝔞` which is not minimal. -/
def IsEmbeddedPrime (q : Ideal (Poly3 K)) : Prop :=
  q ∈ (a K).associatedPrimes ∧ q ∉ (a K).minimalPrimes

/-- `𝔭₁` is an isolated component. -/
theorem isIsolatedPrime_p1 : IsIsolatedPrime K (p1 K) := p1_mem_minimalPrimes K

/-- `𝔭₂` is an isolated component. -/
theorem isIsolatedPrime_p2 : IsIsolatedPrime K (p2 K) := p2_mem_minimalPrimes K

/-- `𝔪` is the embedded component. -/
theorem isEmbeddedPrime_m : IsEmbeddedPrime K (m K) := by
  refine ⟨?_, m_notMem_minimalPrimes K⟩
  rw [associatedPrimes_eq]
  exact Or.inr (Or.inr rfl)

/--
Atiyah–Macdonald, Chapter 4, Exercise 5.

In `K[x,y,z]` (`K` a field, `x,y,z` independent indeterminates) with
`𝔭₁ = (x,y)`, `𝔭₂ = (x,z)`, `𝔪 = (x,y,z)` and `𝔞 = 𝔭₁𝔭₂`:
`𝔭₁`, `𝔭₂` are prime, `𝔪` is maximal, `𝔞 = (x²,xy,xz,yz) = 𝔭₁ ∩ 𝔭₂ ∩ 𝔪²`
is a reduced primary decomposition, `𝔭₁, 𝔭₂` are isolated and `𝔪` is embedded.
-/
theorem solution (K : Type*) [Field K] :
    (p1 K).IsPrime ∧ (p2 K).IsPrime ∧ (m K).IsMaximal ∧
    a K = Ideal.span {x K * x K, x K * y K, x K * z K, y K * z K} ∧
    a K = p1 K ⊓ p2 K ⊓ (m K) ^ 2 ∧
    Submodule.IsMinimalPrimaryDecomposition (a K) {p1 K, p2 K, (m K) ^ 2} ∧
    (a K).minimalPrimes = {p1 K, p2 K} ∧
    IsIsolatedPrime K (p1 K) ∧ IsIsolatedPrime K (p2 K) ∧
    IsEmbeddedPrime K (m K) :=
  ⟨isPrime_p1 K, isPrime_p2 K, isMaximal_m K, a_eq_span, a_eq_inter K,
    isMinimalPrimaryDecomposition K, minimalPrimes_eq K, isIsolatedPrime_p1 K,
    isIsolatedPrime_p2 K, isEmbeddedPrime_m K⟩

end

