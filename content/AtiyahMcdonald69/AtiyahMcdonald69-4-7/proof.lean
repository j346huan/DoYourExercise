/-
# Atiyah–Macdonald (1969), Chapter 4, Exercise 7

Let `A` be a commutative ring and `A[x]` the polynomial ring in one indeterminate over `A`.
For an ideal `a` of `A`, write `a[x]` for the set of polynomials all of whose coefficients lie in `a`.

* (i)   `a[x]` is the extension of `a` to `A[x]`.
* (ii)  if `p` is prime, then `p[x]` is prime.
* (iii) if `q` is `p`-primary, then `q[x]` is `p[x]`-primary.
* (iv)  if `a = ⋂ᵢ qᵢ` is a minimal primary decomposition, then `a[x] = ⋂ᵢ qᵢ[x]` is a minimal
        primary decomposition.
* (v)   if `p` is a minimal prime ideal of `a`, then `p[x]` is a minimal prime ideal of `a[x]`.

We use the book's notions verbatim.  A proper ideal `q` is *primary* iff `A ⧸ q ≠ 0` and every
zero-divisor of `A ⧸ q` is nilpotent; we check that Mathlib's `Ideal.IsPrimary` (the usual
"`xy ∈ q → x ∈ q ∨ y ∈ r(q)`") agrees with this (`isPrimary_iff_forall_isZeroDiv`).
A primary decomposition `a = ⋂ᵢ qᵢ` is *minimal* if the radicals `r(qᵢ)` are pairwise distinct and
no `qᵢ` contains the intersection of the remaining ones (`IsMinimalPrimaryDecomposition`).
`p` is a *minimal prime ideal of `a`* if it is minimal among the prime ideals containing `a`
(Mathlib's `Ideal.IsMinimalPrime a p`).

The proof of (iii) follows the book's hint (Chapter 1, Exercise 2 (iii)): if `F * G = 0` with
`G ≠ 0`, every coefficient of `F` is a zero-divisor of the coefficient ring
(`coeff_isZeroDiv_of_mul_eq_zero`, proved from scratch by induction on the degrees of `F` and `G`).
Over `S = A ⧸ q` a zero-divisor is nilpotent, so every coefficient of `F` is nilpotent, hence `F`
is nilpotent (`Polynomial.isNilpotent_iff`).
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_4_7

open Polynomial

variable {R : Type*} [CommRing R]

/-! ## Notation

The extension of an ideal `a` of `A` to `A[x]`, i.e. the book's `a[x]`, is `a.map (algebraMap R R[X])`.
Since `algebraMap R R[X] = C`, we prove everything for `Ideal.map C` and record the translation once.
-/

@[simp]
theorem extension_eq_map_C (a : Ideal R) :
    a.map (algebraMap R R[X]) = a.map (C : R →+* R[X]) := by
  rw [Polynomial.algebraMap_eq]

/-! ## Part (i): `a[x]` is the extension of `a` to `A[x]` -/

/-- **Exercise 4.7 (i)**.  The extension of `a` to `A[x]` consists exactly of the polynomials all of
whose coefficients lie in `a`. -/
theorem mem_extension_iff {a : Ideal R} {f : R[X]} :
    f ∈ a.map (algebraMap R R[X]) ↔ ∀ n, f.coeff n ∈ a := by
  rw [extension_eq_map_C]
  exact Ideal.mem_map_C_iff

/-- **Exercise 4.7 (i)**: `a[x]` is the ideal generated by `a` inside `A[x]`, i.e. the extension. -/
theorem extension_eq_span (a : Ideal R) :
    a.map (algebraMap R R[X]) = Ideal.span ((fun x => C x) '' (a : Set R)) := by
  rw [extension_eq_map_C]
  rfl

/-- **Exercise 4.7 (i)**, set-theoretic form: `a[x] = {f : A[x] // ∀ n, coeff f n ∈ a}` is the
extension of `a`. -/
theorem extension_eq_setOf_coeff (a : Ideal R) :
    (a.map (algebraMap R R[X]) : Set R[X]) = {f | ∀ n, f.coeff n ∈ a} := by
  ext f
  exact mem_extension_iff

/-! ## Zero-divisors of a polynomial ring

Chapter 1, Exercise 2 (iii) of the book: `f ∈ S[x]` is a zero-divisor iff `c f = 0` for some
`0 ≠ c ∈ S`.  We only need the coefficient-wise consequence, proved here from scratch. -/

section ZeroDiv

variable {S : Type*} [CommRing S]

/-- `IsZeroDiv x`: `x` is a zero-divisor in the book's sense, i.e. `x` kills some `y ≠ 0`. -/
def IsZeroDiv (x : S) : Prop := ∃ y : S, y ≠ 0 ∧ x * y = 0

theorem isZeroDiv_zero {c : S} (hc : c ≠ 0) : IsZeroDiv (0 : S) := ⟨c, hc, zero_mul c⟩

/-- The top coefficient of a product is the product of the top coefficients.  (Unlike
`Polynomial.leadingCoeff_mul` this needs no hypothesis on the coefficient ring.) -/
theorem coeff_mul_natDegree_add_natDegree (F G : S[X]) :
    (F * G).coeff (F.natDegree + G.natDegree) = F.leadingCoeff * G.leadingCoeff := by
  rw [Polynomial.coeff_mul]
  refine Finset.sum_eq_single (F.natDegree, G.natDegree) ?_ ?_
  · rintro ⟨i, j⟩ hij hne
    have hsum : i + j = F.natDegree + G.natDegree := by simpa using hij
    rcases lt_trichotomy i F.natDegree with hi | hi | hi
    · rw [coeff_eq_zero_of_natDegree_lt (p := G) (by omega), mul_zero]
    · have hj : j = G.natDegree := by omega
      exact absurd (by rw [hi, hj]) hne
    · rw [coeff_eq_zero_of_natDegree_lt (p := F) (by omega), zero_mul]
  · intro h
    exact absurd (by simp) h

/-- **Chapter 1, Exercise 2 (iii), coefficient form.**  If `F * G = 0` and `G ≠ 0`, every
coefficient of `F` is a zero-divisor. -/
theorem coeff_isZeroDiv_of_mul_eq_zero {F G : S[X]} (hG : G ≠ 0) (hFG : F * G = 0) (i : ℕ) :
    IsZeroDiv (F.coeff i) := by
  suffices H : ∀ k : ℕ, ∀ F G : S[X], F.natDegree + G.natDegree ≤ k → G ≠ 0 → F * G = 0 →
      ∀ i, ∃ y : S, y ≠ 0 ∧ F.coeff i * y = 0 by
    exact H _ F G le_rfl hG hFG i
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro F G hk hG hFG i
    have hbne : G.leadingCoeff ≠ 0 := fun h => hG (leadingCoeff_eq_zero.mp h)
    by_cases hF : F = 0
    · rw [hF]
      exact ⟨G.leadingCoeff, hbne, by rw [coeff_zero, zero_mul]⟩
    · have hab : F.leadingCoeff * G.leadingCoeff = 0 := by
        rw [← coeff_mul_natDegree_add_natDegree, hFG, coeff_zero]
      by_cases hcase : C F.leadingCoeff * G = 0
      · -- the leading term of `F` kills `G`: cancel it and use the induction hypothesis
        have herase : F.eraseLead * G = 0 := by
          have h3 : (C F.leadingCoeff * X ^ F.natDegree) * G = 0 := by
            rw [mul_assoc, mul_comm (X ^ F.natDegree) G, ← mul_assoc, hcase, zero_mul]
          have h2 : F.eraseLead * G + (C F.leadingCoeff * X ^ F.natDegree) * G = 0 := by
            rw [← add_mul, eraseLead_add_C_mul_X_pow, hFG]
          rwa [h3, add_zero] at h2
        have hle : F.eraseLead.natDegree ≤ F.natDegree := by
          rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro N hN
          rw [eraseLead_coeff, if_neg (by omega)]
          exact coeff_eq_zero_of_natDegree_lt hN
        rcases lt_or_eq_of_le hle with hlt | heq
        · have hIH := ih ((F.eraseLead).natDegree + G.natDegree) (by omega) F.eraseLead G le_rfl
            hG herase
          rcases eq_or_ne i F.natDegree with hi | hi
          · subst hi
            exact ⟨G.leadingCoeff, hbne, hab⟩
          · rw [← eraseLead_coeff_of_ne i hi]
            exact hIH i
        · -- `F` is a monomial: `F = leadingCoeff F * x ^ natDegree F`
          have hzero : F.eraseLead = 0 := by
            have h1 : (F.eraseLead).coeff (F.eraseLead).natDegree = 0 := by
              rw [heq]; exact eraseLead_coeff_natDegree
            exact leadingCoeff_eq_zero.mp h1
          have hmono : F = C F.leadingCoeff * X ^ F.natDegree :=
            calc F = F.eraseLead + C F.leadingCoeff * X ^ F.natDegree :=
                  (eraseLead_add_C_mul_X_pow F).symm
              _ = C F.leadingCoeff * X ^ F.natDegree := by rw [hzero, zero_add]
          rw [hmono, coeff_C_mul_X_pow]
          split_ifs with hi
          · exact ⟨G.leadingCoeff, hbne, hab⟩
          · exact isZeroDiv_zero hbne
      · -- multiply by the leading coefficient of `F`, lowering the degree of `G`
        have hFG' : F * (C F.leadingCoeff * G) = 0 := by
          rw [← mul_assoc, mul_comm F (C F.leadingCoeff), mul_assoc, hFG, mul_zero]
        have hdeg : (C F.leadingCoeff * G).natDegree < G.natDegree := by
          rcases lt_or_eq_of_le (natDegree_C_mul_le F.leadingCoeff G) with h | h
          · exact h
          · exfalso
            have hcoeff : (C F.leadingCoeff * G).coeff ((C F.leadingCoeff * G).natDegree) = 0 := by
              rw [h, coeff_C_mul]
              exact hab
            exact hcase (leadingCoeff_eq_zero.mp hcoeff)
        exact ih (F.natDegree + (C F.leadingCoeff * G).natDegree) (by omega) F
          (C F.leadingCoeff * G) le_rfl hcase hFG' i

/-- If every zero-divisor of `S` is nilpotent, then `F * G = 0` with `G ≠ 0` forces `F` to be
nilpotent. -/
theorem isNilpotent_of_mul_eq_zero (hS : ∀ x : S, IsZeroDiv x → IsNilpotent x) {F G : S[X]}
    (hG : G ≠ 0) (hFG : F * G = 0) : IsNilpotent F := by
  rw [Polynomial.isNilpotent_iff]
  intro i
  exact hS _ (coeff_isZeroDiv_of_mul_eq_zero hG hFG i)

end ZeroDiv

/-! ## The book's definition of a primary ideal -/

section Primary

/-- The book's definition (p. 50): `q` is primary iff `A ⧸ q ≠ 0` and every zero-divisor of
`A ⧸ q` is nilpotent.  We check it agrees with `Ideal.IsPrimary`. -/
theorem isPrimary_iff_forall_isZeroDiv (I : Ideal R) :
    I.IsPrimary ↔ I ≠ ⊤ ∧ ∀ x : R ⧸ I, IsZeroDiv x → IsNilpotent x := by
  constructor
  · intro hI
    refine ⟨hI.ne_top, fun x hx => ?_⟩
    obtain ⟨y, hy0, hxy⟩ := hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hb : b ∉ I := fun hbI => hy0 (by rw [Ideal.Quotient.eq_zero_iff_mem.mpr hbI])
    have hab : a * b ∈ I :=
      Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_mul]; exact hxy)
    have hba : b * a ∈ I := by rwa [mul_comm]
    have harad : a ∈ I.radical := by
      rcases (Ideal.isPrimary_iff.mp hI).2 hba with h | h
      · exact absurd h hb
      · exact h
    obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp harad
    exact ⟨k, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hk]⟩
  · rintro ⟨hne, h⟩
    rw [Ideal.isPrimary_iff]
    refine ⟨hne, ?_⟩
    intro x y hxy
    by_cases hx : x ∈ I
    · exact Or.inl hx
    · refine Or.inr (Ideal.mem_radical_iff.mpr ?_)
      have hx0 : (Ideal.Quotient.mk I) x ≠ 0 := fun h0 =>
        hx (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      have hzero : IsZeroDiv ((Ideal.Quotient.mk I) y) :=
        ⟨(Ideal.Quotient.mk I) x, hx0, by
          rw [mul_comm, ← map_mul]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hxy⟩
      obtain ⟨k, hk⟩ := h (Ideal.Quotient.mk I y) hzero
      exact ⟨k, Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_pow]; exact hk)⟩

end Primary

/-! ## Part (ii): the extension of a prime ideal is prime -/

/-- **Exercise 4.7 (ii)**. -/
theorem isPrime_map_C (p : Ideal R) (hp : p.IsPrime) :
    (p.map (C : R →+* R[X])).IsPrime :=
  (Ideal.isPrime_map_C_iff_isPrime p).mpr hp

/-- **Exercise 4.7 (ii)**, for the extension `p[x]`. -/
theorem isPrime_extension (p : Ideal R) (hp : p.IsPrime) :
    (p.map (algebraMap R R[X])).IsPrime := by
  rw [extension_eq_map_C]
  exact isPrime_map_C p hp

/-! ## Part (iii): the extension of a primary ideal is primary -/

/-- `q` is `p`-primary (book, p. 50): `q` is primary with `r(q) = p`. -/
def IsPPrimary (q p : Ideal R) : Prop := q.IsPrimary ∧ q.radical = p

/-- Contraction of `q[x]` along `A → A[x]` recovers `q`. -/
theorem comap_C_map_C (q : Ideal R) :
    (q.map (C : R →+* R[X])).comap (C : R →+* R[X]) = q := by
  ext a
  rw [Ideal.mem_comap, Ideal.mem_map_C_iff]
  constructor
  · intro h; simpa using h 0
  · intro h n
    rw [Polynomial.coeff_C]
    split_ifs with hn
    · exact h
    · exact q.zero_mem

/-- `f` maps to zero in `(A ⧸ q)[x]` iff all of its coefficients lie in `q`. -/
theorem map_quotient_mk_eq_zero_iff {q : Ideal R} {f : R[X]} :
    f.map (Ideal.Quotient.mk q) = 0 ↔ f ∈ q.map (C : R →+* R[X]) := by
  rw [Ideal.mem_map_C_iff]
  constructor
  · intro h n
    have := congrArg (fun p : (R ⧸ q)[X] => p.coeff n) h
    rwa [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem] at this
  · intro h
    ext n
    rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact h n

/-- **Exercise 4.7 (iii)**, primary part: the extension of a primary ideal is primary. -/
theorem isPrimary_map_C (q : Ideal R) (hq : q.IsPrimary) :
    (q.map (C : R →+* R[X])).IsPrimary := by
  rw [Ideal.isPrimary_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    have hqtop : q = ⊤ := by
      have h := congrArg (Ideal.comap (C : R →+* R[X])) htop
      simpa [comap_C_map_C] using h
    exact hq.ne_top hqtop
  · intro f g hfg
    by_cases hf : f ∈ q.map (C : R →+* R[X])
    · exact Or.inl hf
    · right
      have hF : f.map (Ideal.Quotient.mk q) ≠ 0 :=
        fun h => hf (map_quotient_mk_eq_zero_iff.mp h)
      have hFG : f.map (Ideal.Quotient.mk q) * g.map (Ideal.Quotient.mk q) = 0 := by
        rw [← Polynomial.map_mul]
        exact map_quotient_mk_eq_zero_iff.mpr hfg
      by_cases hG : g.map (Ideal.Quotient.mk q) = 0
      · exact Ideal.le_radical (map_quotient_mk_eq_zero_iff.mp hG)
      · have hnil : IsNilpotent (g.map (Ideal.Quotient.mk q)) :=
          isNilpotent_of_mul_eq_zero
            (fun x hx => (isPrimary_iff_forall_isZeroDiv q).mp hq |>.2 x hx) hF
            (by rw [mul_comm]; exact hFG)
        obtain ⟨k, hk⟩ := hnil
        refine Ideal.mem_radical_iff.mpr ⟨k, ?_⟩
        exact map_quotient_mk_eq_zero_iff.mp (by rw [Polynomial.map_pow]; exact hk)

/-- **Exercise 4.7 (iii)**: `r(q[x]) = r(q)[x]`. -/
theorem radical_map_C (q : Ideal R) :
    (q.map (C : R →+* R[X])).radical = q.radical.map (C : R →+* R[X]) := by
  refine le_antisymm ?_ (Ideal.map_radical_le (C : R →+* R[X]))
  intro f hf
  obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hf
  rw [Ideal.mem_map_C_iff]
  intro i
  have hnil : IsNilpotent (f.map (Ideal.Quotient.mk q)) :=
    ⟨k, by rw [← Polynomial.map_pow]; exact map_quotient_mk_eq_zero_iff.mpr hk⟩
  have hcoeff : IsNilpotent ((f.map (Ideal.Quotient.mk q)).coeff i) :=
    Polynomial.isNilpotent_iff.mp hnil i
  rw [Polynomial.coeff_map] at hcoeff
  obtain ⟨j, hj⟩ := hcoeff
  exact Ideal.mem_radical_iff.mpr ⟨j, Ideal.Quotient.eq_zero_iff_mem.mp hj⟩

/-- **Exercise 4.7 (iii)**: if `q` is `p`-primary then `q[x]` is `p[x]`-primary. -/
theorem isPPrimary_map_C {q p : Ideal R} (h : IsPPrimary q p) :
    IsPPrimary (q.map (C : R →+* R[X])) (p.map (C : R →+* R[X])) :=
  ⟨isPrimary_map_C q h.1, by rw [radical_map_C, h.2]⟩

/-- **Exercise 4.7 (iii)**, in the book's notation `q[x]`, `p[x]`. -/
theorem isPPrimary_extension {q p : Ideal R} (h : IsPPrimary q p) :
    IsPPrimary (q.map (algebraMap R R[X])) (p.map (algebraMap R R[X])) := by
  rw [extension_eq_map_C q, extension_eq_map_C p]
  exact isPPrimary_map_C h

/-! ## Part (iv): minimal primary decompositions extend -/

/-- A *minimal primary decomposition* of `a` (book, p. 52): a finite family of primary ideals whose
intersection is `a`, whose radicals are pairwise distinct, and none of which contains the
intersection of the others. -/
def IsMinimalPrimaryDecomposition {ι : Type*} [Fintype ι] (a : Ideal R) (q : ι → Ideal R) : Prop :=
  (∀ i, (q i).IsPrimary) ∧
  (∀ i j, i ≠ j → (q i).radical ≠ (q j).radical) ∧
  (∀ i, ¬ (⨅ j ∈ ({i}ᶜ : Set ι), q j) ≤ q i) ∧
  (⨅ i, q i) = a

/-- Extension commutes with intersections of polynomial ideals. -/
theorem map_C_biInf {ι : Type*} (q : ι → Ideal R) (s : Set ι) :
    ((⨅ j ∈ s, q j).map (C : R →+* R[X])) = ⨅ j ∈ s, (q j).map (C : R →+* R[X]) := by
  ext f
  rw [Ideal.mem_map_C_iff]
  constructor
  · intro h
    rw [Ideal.mem_iInf]
    intro j
    rw [Ideal.mem_iInf]
    intro hj
    rw [Ideal.mem_map_C_iff]
    intro n
    exact Ideal.mem_iInf.mp (Ideal.mem_iInf.mp (h n) j) hj
  · intro h n
    rw [Ideal.mem_iInf]
    intro j
    rw [Ideal.mem_iInf]
    intro hj
    have hmem : f ∈ (q j).map (C : R →+* R[X]) := Ideal.mem_iInf.mp (Ideal.mem_iInf.mp h j) hj
    exact Ideal.mem_map_C_iff.mp hmem n

/-- Extension commutes with intersections of polynomial ideals. -/
theorem map_C_iInf {ι : Type*} (q : ι → Ideal R) :
    ((⨅ i, q i).map (C : R →+* R[X])) = ⨅ i, (q i).map (C : R →+* R[X]) := by
  ext f
  rw [Ideal.mem_map_C_iff, Ideal.mem_iInf]
  constructor
  · intro h i
    rw [Ideal.mem_map_C_iff]
    intro n
    exact Ideal.mem_iInf.mp (h n) i
  · intro h n
    rw [Ideal.mem_iInf]
    intro i
    exact Ideal.mem_map_C_iff.mp (h i) n

/-- **Exercise 4.7 (iv)**: a minimal primary decomposition of `a` extends to one of `a[x]`. -/
theorem isMinimalPrimaryDecomposition_map_C {ι : Type*} [Fintype ι]
    {a : Ideal R} {q : ι → Ideal R} (h : IsMinimalPrimaryDecomposition a q) :
    IsMinimalPrimaryDecomposition (a.map (C : R →+* R[X]))
      (fun i => (q i).map (C : R →+* R[X])) := by
  obtain ⟨hprim, hdist, hred, hinter⟩ := h
  refine ⟨fun i => isPrimary_map_C (q i) (hprim i), ?_, ?_, ?_⟩
  · intro i j hij heq
    refine hdist i j hij ?_
    have h1 := congrArg (Ideal.comap (C : R →+* R[X])) heq
    rw [radical_map_C, radical_map_C, comap_C_map_C, comap_C_map_C] at h1
    exact h1
  · intro i hle
    refine hred i ?_
    have h1 : ((⨅ j ∈ ({i}ᶜ : Set ι), q j).map (C : R →+* R[X])) ≤ (q i).map C := by
      rw [map_C_biInf]
      exact hle
    rwa [Ideal.map_le_iff_le_comap, comap_C_map_C] at h1
  · rw [← map_C_iInf, hinter]

/-- **Exercise 4.7 (iv)**, in the book's notation `a[x]`, `qᵢ[x]`. -/
theorem isMinimalPrimaryDecomposition_extension {ι : Type*} [Fintype ι]
    {a : Ideal R} {q : ι → Ideal R} (h : IsMinimalPrimaryDecomposition a q) :
    IsMinimalPrimaryDecomposition (a.map (algebraMap R R[X]))
      (fun i => (q i).map (algebraMap R R[X])) := by
  have h' := isMinimalPrimaryDecomposition_map_C h
  simpa only [extension_eq_map_C] using h'

/-! ## Part (v): minimal primes extend to minimal primes -/

/-- **Exercise 4.7 (v)**: if `p` is a minimal prime ideal of `a`, then `p[x]` is a minimal prime
ideal of `a[x]`. -/
theorem isMinimalPrime_map_C {a p : Ideal R} (h : a.IsMinimalPrime p) :
    (a.map (C : R →+* R[X])).IsMinimalPrime (p.map (C : R →+* R[X])) := by
  refine ⟨⟨isPrime_map_C p h.isPrime, Ideal.map_mono h.le⟩, ?_⟩
  intro q' hq' hle
  obtain ⟨hq'prime, hq'le⟩ := hq'
  have hq'c : (q'.comap (C : R →+* R[X])).IsPrime := Ideal.IsPrime.comap (C : R →+* R[X])
  have h1 : q'.comap (C : R →+* R[X]) ≤ p := by
    rw [← comap_C_map_C p]
    exact Ideal.comap_mono hle
  have h2 : a ≤ q'.comap (C : R →+* R[X]) :=
    le_trans (Ideal.le_comap_map) (Ideal.comap_mono hq'le)
  calc p.map (C : R →+* R[X]) ≤ (q'.comap (C : R →+* R[X])).map (C : R →+* R[X]) :=
        Ideal.map_mono (h.2 ⟨hq'c, h2⟩ h1)
    _ ≤ q' := Ideal.map_comap_le

/-- **Exercise 4.7 (v)**, in the book's notation. -/
theorem isMinimalPrime_extension {a p : Ideal R} (h : a.IsMinimalPrime p) :
    (a.map (algebraMap R R[X])).IsMinimalPrime (p.map (algebraMap R R[X])) := by
  rw [extension_eq_map_C a, extension_eq_map_C p]
  exact isMinimalPrime_map_C h

/-! ## The five parts bundled -/

/-- Atiyah–Macdonald, Chapter 4, Exercise 7, all five parts. -/
theorem solution :
    (∀ (a : Ideal R) (f : R[X]),
        f ∈ a.map (algebraMap R R[X]) ↔ ∀ n, f.coeff n ∈ a) ∧
    (∀ (a : Ideal R), (a.map (algebraMap R R[X]) : Set R[X]) = {f | ∀ n, f.coeff n ∈ a}) ∧
    (∀ p : Ideal R, p.IsPrime → (p.map (algebraMap R R[X])).IsPrime) ∧
    (∀ q p : Ideal R, IsPPrimary q p →
        IsPPrimary (q.map (algebraMap R R[X])) (p.map (algebraMap R R[X]))) ∧
    (∀ {ι : Type*} [Fintype ι] (a : Ideal R) (q : ι → Ideal R),
        IsMinimalPrimaryDecomposition a q →
        IsMinimalPrimaryDecomposition (a.map (algebraMap R R[X]))
          (fun i => (q i).map (algebraMap R R[X]))) ∧
    (∀ a p : Ideal R, a.IsMinimalPrime p →
        (a.map (algebraMap R R[X])).IsMinimalPrime (p.map (algebraMap R R[X]))) :=
  ⟨fun _ _ => mem_extension_iff, extension_eq_setOf_coeff, isPrime_extension,
    fun _ _ => isPPrimary_extension, fun _ _ => isMinimalPrimaryDecomposition_extension,
    fun _ _ => isMinimalPrime_extension⟩

/-! ## Consistency checks

The notions above are not vacuous: in a field `⊥` is prime, hence primary with radical `⊥`, and it
gives a (one-term) minimal primary decomposition. -/

example : IsPPrimary (⊥ : Ideal ℚ) ⊥ := by
  have h : (⊥ : Ideal ℚ).IsPrime := inferInstance
  exact ⟨h.isPrimary, h.radical⟩

example : IsMinimalPrimaryDecomposition (⊥ : Ideal ℚ) (fun _ : Unit => ⊥) := by
  have h : (⊥ : Ideal ℚ).IsPrime := inferInstance
  refine ⟨fun _ => h.isPrimary, ?_, ?_, ?_⟩
  · intro i j hij
    exact absurd (Subsingleton.elim i j) hij
  · intro i
    have htop : (⨅ j ∈ (({i} : Set Unit)ᶜ), (⊥ : Ideal ℚ)) = ⊤ := by simp
    rw [htop]
    exact fun hle => bot_ne_top (le_bot_iff.mp hle).symm
  · exact iInf_unique _

/-- Non-vacuity with a genuinely non-prime primary ideal: in `ℤ` the ideal `(4)` is `(2)`-primary. -/
theorem isPPrimary_span_four : IsPPrimary (Ideal.span {(4 : ℤ)}) (Ideal.span {(2 : ℤ)}) := by
  have hprim : (Ideal.span {(4 : ℤ)}).IsPrimary := by
    rw [Ideal.isPrimary_iff]
    refine ⟨?_, ?_⟩
    · intro h
      have h1 : (1 : ℤ) ∈ Ideal.span {(4 : ℤ)} := by rw [h]; exact Submodule.mem_top
      rw [Ideal.mem_span_singleton] at h1
      omega
    · intro x y hxy
      rw [Ideal.mem_span_singleton] at hxy ⊢
      have h2 : (2 : ℤ) ∣ x * y := dvd_trans ⟨2, by norm_num⟩ hxy
      suffices h : (4 : ℤ) ∣ x ∨ (2 : ℤ) ∣ y by
        rcases h with h | h
        · exact Or.inl h
        · refine Or.inr (Ideal.mem_radical_iff.mpr ⟨2, ?_⟩)
          rw [Ideal.mem_span_singleton]
          obtain ⟨m, rfl⟩ := h
          exact ⟨m ^ 2, by ring⟩
      rcases (Int.prime_two.dvd_mul).mp h2 with h2x | h2y
      · obtain ⟨m, hm⟩ := h2x
        obtain ⟨k, hk⟩ := hxy
        rw [hm] at hk
        have h3 : m * y = 2 * k := by
          have h4 : 2 * (m * y) = 2 * (2 * k) := by linarith
          exact mul_left_cancel₀ (by norm_num : (2 : ℤ) ≠ 0) h4
        rcases (Int.prime_two.dvd_mul).mp ⟨k, h3⟩ with h5 | h5
        · obtain ⟨i, hi⟩ := h5
          exact Or.inl ⟨i, by rw [hm, hi]; ring⟩
        · exact Or.inr h5
      · exact Or.inr h2y
  refine ⟨hprim, ?_⟩
  refine le_antisymm ?_ ?_
  · intro y hy
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hy
    rw [Ideal.mem_span_singleton] at hn ⊢
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · rw [h0, pow_zero] at hn
      omega
    · exact Int.prime_two.dvd_of_dvd_pow (dvd_trans ⟨2, by norm_num⟩ hn)
  · rw [Ideal.span_singleton_le_iff_mem]
    refine Ideal.mem_radical_iff.mpr ⟨2, ?_⟩
    rw [Ideal.mem_span_singleton]
    norm_num

/-- Exercise 4.7 (iii) on the non-prime example `(4) ⊂ ℤ`: `(4)[x]` is `(2)[x]`-primary. -/
example : IsPPrimary (Ideal.span {(4 : ℤ[X])}) (Ideal.span {(2 : ℤ[X])}) := by
  have h := isPPrimary_map_C isPPrimary_span_four
  rw [Ideal.map_span, Ideal.map_span] at h
  simpa using h

end AtiyahMcdonald69.Ex_4_7

