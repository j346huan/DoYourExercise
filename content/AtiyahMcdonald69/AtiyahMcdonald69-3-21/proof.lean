/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 3, Exercise 21.

Statement (from the book):

(i) Let `A` be a ring, `S` a multiplicatively closed subset of `A`, and `φ : A → S⁻¹A` the
    canonical homomorphism. Then `φ* : Spec (S⁻¹A) → Spec A` is a homeomorphism of
    `Spec (S⁻¹A)` onto its image in `X = Spec A`; that image is denoted `S⁻¹X`. In particular,
    if `f ∈ A`, the image of `Spec (A_f)` in `X` is the basic open set `X_f`.
(ii) Let `f : A → B` be a ring homomorphism, `X = Spec A`, `Y = Spec B`, `f* : Y → X`.
    Identifying `Spec (S⁻¹A)` with `S⁻¹X` and `Spec (S⁻¹B) = Spec (f(S)⁻¹B)` with `S⁻¹Y`,
    the map `S⁻¹f* : Spec (S⁻¹B) → Spec (S⁻¹A)` is the restriction of `f*` to `S⁻¹Y`, and
    `S⁻¹Y = f*⁻¹(S⁻¹X)`.
(iii) Let `a` be an ideal of `A` and `b = aᵉ` its extension in `B`; let `f̄ : A/a → B/b` be the
    induced homomorphism. Identifying `Spec (A/a)` with `V(a) ⊆ X` and `Spec (B/b)` with
    `V(b) ⊆ Y`, the map `f̄*` is the restriction of `f*` to `V(b)`.
(iv) Let `p` be a prime ideal of `A`. Taking `S = A - p` in (ii) and reducing mod `S⁻¹p` as in
    (iii), the subspace `f*⁻¹(p)` of `Y` is naturally homeomorphic to
    `Spec (B_p / pB_p) = Spec (k(p) ⊗_A B)`.
-/
import Mathlib

open PrimeSpectrum

namespace AtiyahMcdonald69.Ex_3_21

/-! ## Part (i) -/

section PartI

variable {A A_S : Type*} [CommRing A] [CommRing A_S] [Algebra A A_S]

/-- Part (i): the map `Spec (S⁻¹A) → Spec A` induced by the canonical homomorphism `φ` is a
topological embedding, i.e. a homeomorphism onto its image. -/
theorem comap_localization_isEmbedding (S : Submonoid A) [IsLocalization S A_S] :
    Topology.IsEmbedding (PrimeSpectrum.comap (algebraMap A A_S)) :=
  PrimeSpectrum.localization_comap_isEmbedding A_S S

/-- Part (i): the image `S⁻¹X` of `Spec (S⁻¹A)` in `X = Spec A` consists of the primes of `A`
which are disjoint from `S`. -/
theorem range_comap_localization (S : Submonoid A) [IsLocalization S A_S] :
    Set.range (PrimeSpectrum.comap (algebraMap A A_S)) =
      {p : PrimeSpectrum A | Disjoint (S : Set A) (p.asIdeal : Set A)} :=
  PrimeSpectrum.localization_comap_range A_S S

/-- Part (i): `φ*` as a homeomorphism of `Spec (S⁻¹A)` onto its image `S⁻¹X`. -/
noncomputable def homeomorphLocalizationImage (S : Submonoid A) [IsLocalization S A_S] :
    PrimeSpectrum A_S ≃ₜ
      Set.range (PrimeSpectrum.comap (algebraMap A A_S) : PrimeSpectrum A_S → PrimeSpectrum A) :=
  (comap_localization_isEmbedding S).toHomeomorph

@[simp]
theorem homeomorphLocalizationImage_apply (S : Submonoid A) [IsLocalization S A_S]
    (x : PrimeSpectrum A_S) :
    (homeomorphLocalizationImage S x : PrimeSpectrum A) =
      PrimeSpectrum.comap (algebraMap A A_S) x := rfl

/-- Membership in the image `S⁻¹X`: a prime of `A` lies in the image of `Spec (S⁻¹A)` if and
only if it is disjoint from `S`. -/
theorem mem_range_comap_localization_iff (S : Submonoid A) [IsLocalization S A_S]
    (p : PrimeSpectrum A) :
    p ∈ Set.range (PrimeSpectrum.comap (algebraMap A A_S)) ↔
      Disjoint (S : Set A) (p.asIdeal : Set A) := by
  simp only [range_comap_localization S, Set.mem_ofPred_eq]

end PartI

/-! ## Part (i), the special case `S = {fⁿ}`: the image is the basic open set `X_f`. -/

section PartIAway

variable {A A_f : Type*} [CommRing A] [CommRing A_f] [Algebra A A_f]

/-- Part (i), final sentence: for `S` the submonoid generated by `f`, the image of
`Spec (A_f)` in `Spec A` is the basic open set `X_f`. -/
theorem range_comap_away (f : A) [IsLocalization.Away f A_f] :
    Set.range (PrimeSpectrum.comap (algebraMap A A_f)) = PrimeSpectrum.basicOpen f :=
  PrimeSpectrum.localization_away_comap_range A_f f

end PartIAway

/-! ## Part (ii) -/

section PartII

variable {A B A_S B_S : Type*} [CommRing A] [CommRing B] [CommRing A_S] [CommRing B_S]
  [Algebra A A_S] [Algebra B B_S]

/-- The ring homomorphism `S⁻¹f : S⁻¹A →+* S⁻¹B` induced by `f : A →+* B`. -/
noncomputable def localizationMap (f : A →+* B) (S : Submonoid A) [IsLocalization S A_S]
    [IsLocalization (S.map f) B_S] : A_S →+* B_S :=
  IsLocalization.map B_S f (Submonoid.le_comap_map S)

/-- `S⁻¹f` is compatible with the canonical maps: `(S⁻¹f) ∘ φ_A = φ_B ∘ f`. -/
theorem localizationMap_comp_algebraMap (f : A →+* B) (S : Submonoid A) [IsLocalization S A_S]
    [IsLocalization (S.map f) B_S] :
    (localizationMap f S).comp (algebraMap A A_S) = (algebraMap B B_S).comp f := by
  simp only [localizationMap, IsLocalization.map_comp]

/-- Part (ii): `S⁻¹f*`, read through the identifications `Spec (S⁻¹A) = S⁻¹X` and
`Spec (S⁻¹B) = S⁻¹Y`, is the restriction of `f*` to `S⁻¹Y`. -/
theorem comap_localizationMap_eq (f : A →+* B) (S : Submonoid A) [IsLocalization S A_S]
    [IsLocalization (S.map f) B_S] (q : PrimeSpectrum B_S) :
    PrimeSpectrum.comap (algebraMap A A_S) (PrimeSpectrum.comap (localizationMap f S) q) =
      PrimeSpectrum.comap f (PrimeSpectrum.comap (algebraMap B B_S) q) := by
  rw [← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply,
    localizationMap_comp_algebraMap]

/-- `q ∈ Spec B` is disjoint from `f(S)` if and only if `f* q = q ∩ A` is disjoint from `S`. -/
theorem disjoint_map_comap_of_prime (f : A →+* B) (S : Submonoid A) (q : PrimeSpectrum B) :
    Disjoint ((S.map f : Submonoid B) : Set B) (q.asIdeal : Set B) ↔
      Disjoint (S : Set A) ((q.asIdeal.comap f : Ideal A) : Set A) := by
  rw [Set.disjoint_left, Set.disjoint_left]
  constructor
  · intro h a ha haq
    exact h (Submonoid.mem_map_of_mem f ha) haq
  · rintro h _ ⟨a, ha, rfl⟩ haq
    exact h ha haq

/-- Part (ii): `S⁻¹Y = f*⁻¹(S⁻¹X)`. -/
theorem range_comap_localization_eq_preimage (f : A →+* B) (S : Submonoid A)
    [IsLocalization S A_S] [IsLocalization (S.map f) B_S] :
    Set.range (PrimeSpectrum.comap (algebraMap B B_S)) =
      PrimeSpectrum.comap f ⁻¹'
        Set.range (PrimeSpectrum.comap (algebraMap A A_S)) := by
  rw [range_comap_localization (A_S := B_S) (S.map f), range_comap_localization (A_S := A_S) S]
  ext q
  exact disjoint_map_comap_of_prime f S q

/-- Part (ii): `f*` maps `S⁻¹Y` into `S⁻¹X`. -/
theorem mapsTo_comap_localization (f : A →+* B) (S : Submonoid A)
    [IsLocalization S A_S] [IsLocalization (S.map f) B_S] :
    Set.MapsTo (PrimeSpectrum.comap f)
      (Set.range (PrimeSpectrum.comap (algebraMap B B_S)))
      (Set.range (PrimeSpectrum.comap (algebraMap A A_S))) := by
  rw [range_comap_localization_eq_preimage (A_S := A_S) (B_S := B_S) f S]
  exact Set.mapsTo_preimage _ _

/-- Part (ii), literally: identifying `Spec (S⁻¹A)` and `Spec (S⁻¹B)` with their images
`S⁻¹X` and `S⁻¹Y`, the restriction of `f*` to `S⁻¹Y` is `S⁻¹f*`. -/
theorem part_ii_restriction (f : A →+* B) (S : Submonoid A) [IsLocalization S A_S]
    [IsLocalization (S.map f) B_S] :
    (Set.MapsTo.restrict (PrimeSpectrum.comap f)
        (Set.range (PrimeSpectrum.comap (algebraMap B B_S)))
        (Set.range (PrimeSpectrum.comap (algebraMap A A_S)))
        (mapsTo_comap_localization f S)) ∘
      (homeomorphLocalizationImage (A_S := B_S) (S.map f)) =
    (homeomorphLocalizationImage (A_S := A_S) S) ∘
      (PrimeSpectrum.comap (localizationMap f S)) := by
  funext q
  apply Subtype.ext
  change PrimeSpectrum.comap f ↑(homeomorphLocalizationImage (A_S := B_S) (S.map f) q) =
    ↑(homeomorphLocalizationImage (A_S := A_S) S (PrimeSpectrum.comap (localizationMap f S) q))
  rw [homeomorphLocalizationImage_apply, homeomorphLocalizationImage_apply]
  exact (comap_localizationMap_eq f S q).symm

/-- Part (ii), both assertions together. -/
theorem part_ii (f : A →+* B) (S : Submonoid A) [IsLocalization S A_S]
    [IsLocalization (S.map f) B_S] :
    (∀ q : PrimeSpectrum B_S,
        PrimeSpectrum.comap (algebraMap A A_S) (PrimeSpectrum.comap (localizationMap f S) q) =
          PrimeSpectrum.comap f (PrimeSpectrum.comap (algebraMap B B_S) q)) ∧
      Set.range (PrimeSpectrum.comap (algebraMap B B_S)) =
        PrimeSpectrum.comap f ⁻¹' Set.range (PrimeSpectrum.comap (algebraMap A A_S)) :=
  ⟨comap_localizationMap_eq f S, range_comap_localization_eq_preimage f S⟩

end PartII

/-! ## Part (iii) -/

section PartIII

variable {A B : Type*} [CommRing A] [CommRing B]

/-- The homomorphism `f̄ : A/a →+* B/aᵉ` induced by `f : A →+* B`. -/
noncomputable def idealQuotientMap (f : A →+* B) (a : Ideal A) :
    A ⧸ a →+* B ⧸ a.map f :=
  Ideal.quotientMap (a.map f) f (Ideal.map_le_iff_le_comap.mp le_rfl)

/-- `f̄` is compatible with the quotient maps. -/
theorem idealQuotientMap_comp_quotientMk (f : A →+* B) (a : Ideal A) :
    (idealQuotientMap f a).comp (Ideal.Quotient.mk a) =
      (Ideal.Quotient.mk (a.map f)).comp f :=
  Ideal.quotientMap_comp_mk (Ideal.map_le_iff_le_comap.mp le_rfl)

/-- Part (iii): `f̄*` is the restriction of `f*` to `V(b)` (`b = aᵉ`), i.e. the two ways of
contracting a prime of `B/b` to a prime of `A` agree. -/
theorem comap_idealQuotientMap_eq (f : A →+* B) (a : Ideal A)
    (q : PrimeSpectrum (B ⧸ a.map f)) :
    PrimeSpectrum.comap f (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f)) q) =
      PrimeSpectrum.comap (Ideal.Quotient.mk a) (PrimeSpectrum.comap (idealQuotientMap f a) q) := by
  rw [← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply,
    idealQuotientMap_comp_quotientMk]

/-- `V(a) = Spec (A/a)` as a subset of `Spec A`. -/
theorem range_comap_quotientMk (a : Ideal A) :
    Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk a : A →+* A ⧸ a)) =
      PrimeSpectrum.zeroLocus (a : Set A) := by
  rw [range_comap_of_surjective (A ⧸ a) (Ideal.Quotient.mk a) Ideal.Quotient.mk_surjective,
    Ideal.mk_ker]

/-- Part (iii): `f̄*` is the restriction of `f*` to `V(b)`, in the form that `f*` maps `V(b)`
into `V(a)`. -/
theorem mapsTo_comap_of_idealQuotientMap (f : A →+* B) (a : Ideal A) :
    Set.MapsTo (PrimeSpectrum.comap f)
      (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f))))
      (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk a))) := by
  intro q hq
  rw [Set.mem_range] at hq ⊢
  obtain ⟨q', rfl⟩ := hq
  exact ⟨PrimeSpectrum.comap (idealQuotientMap f a) q', (comap_idealQuotientMap_eq f a q').symm⟩

/-- Part (iii), literally: identifying `Spec (A/a)` with `V(a)` and `Spec (B/aᵉ)` with `V(aᵉ)`,
the restriction of `f*` to `V(aᵉ)` is `f̄*`. -/
theorem part_iii_restriction (f : A →+* B) (a : Ideal A) :
    (Set.MapsTo.restrict (PrimeSpectrum.comap f)
        (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f))))
        (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk a)))
        (mapsTo_comap_of_idealQuotientMap f a)) ∘
      (PrimeSpectrum.isEmbedding_comap_of_surjective (B ⧸ a.map f) (Ideal.Quotient.mk (a.map f))
        Ideal.Quotient.mk_surjective).toHomeomorph =
    (PrimeSpectrum.isEmbedding_comap_of_surjective (A ⧸ a) (Ideal.Quotient.mk a)
        Ideal.Quotient.mk_surjective).toHomeomorph ∘
      (PrimeSpectrum.comap (idealQuotientMap f a)) := by
  funext q
  apply Subtype.ext
  change PrimeSpectrum.comap f
      ↑((PrimeSpectrum.isEmbedding_comap_of_surjective (B ⧸ a.map f)
        (Ideal.Quotient.mk (a.map f)) Ideal.Quotient.mk_surjective).toHomeomorph q) =
    ↑((PrimeSpectrum.isEmbedding_comap_of_surjective (A ⧸ a)
        (Ideal.Quotient.mk a) Ideal.Quotient.mk_surjective).toHomeomorph
        (PrimeSpectrum.comap (idealQuotientMap f a) q))
  rw [Topology.IsEmbedding.toHomeomorph_apply_coe, Topology.IsEmbedding.toHomeomorph_apply_coe]
  exact (comap_idealQuotientMap_eq f a q).symm

/-- Part (iii), all formulations together. -/
theorem part_iii (f : A →+* B) (a : Ideal A) :
    (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk a : A →+* A ⧸ a)) =
        PrimeSpectrum.zeroLocus (a : Set A) ∧
      Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f) : B →+* B ⧸ a.map f)) =
        PrimeSpectrum.zeroLocus (a.map f : Set B) ∧
      Set.MapsTo (PrimeSpectrum.comap f)
        (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f))))
        (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk a))) ∧
      ∀ q : PrimeSpectrum (B ⧸ a.map f),
        PrimeSpectrum.comap f (PrimeSpectrum.comap (Ideal.Quotient.mk (a.map f)) q) =
          PrimeSpectrum.comap (Ideal.Quotient.mk a)
            (PrimeSpectrum.comap (idealQuotientMap f a) q)) :=
  ⟨range_comap_quotientMk a, range_comap_quotientMk (a.map f),
    mapsTo_comap_of_idealQuotientMap f a, comap_idealQuotientMap_eq f a⟩

end PartIII

/-! ## Part (iv) -/

section PartIV

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

attribute [local instance] PrimeSpectrum.isPrime Algebra.TensorProduct.rightAlgebra

/-- `k(p)`, the residue field of the local ring `A_p`, is the residue field of `p`
(`p.Fiber B` is by definition `k(p) ⊗[A] B`). -/
theorem residueField_eq (p : PrimeSpectrum A) :
    p.asIdeal.ResidueField = IsLocalRing.ResidueField (Localization p.asIdeal.primeCompl) := rfl

/-- Part (iv): the subspace `f*⁻¹(p)` of `Y = Spec B` is naturally homeomorphic to
`Spec (k(p) ⊗_A B)`. -/
noncomputable def fiberHomeomorph (p : PrimeSpectrum A) :
    ↥(PrimeSpectrum.comap (algebraMap A B) ⁻¹' {p}) ≃ₜ PrimeSpectrum (p.asIdeal.Fiber B) :=
  PrimeSpectrum.preimageHomeomorphFiber A B p

/-- Explicit description of the homeomorphism of part (iv): a prime `q` of `k(p) ⊗_A B`
corresponds to its contraction along `B → k(p) ⊗_A B`, `b ↦ 1 ⊗ b`. -/
theorem fiberHomeomorph_symm_asIdeal (p : PrimeSpectrum A)
    (q : PrimeSpectrum (p.asIdeal.Fiber B)) :
    (((fiberHomeomorph p).symm q : PrimeSpectrum B).asIdeal : Set B) =
      (q.asIdeal.comap Algebra.TensorProduct.includeRight : Set B) :=
  PrimeSpectrum.coe_preimageHomeomorphFiber_symm_apply_coe_asIdeal A B p q

/-- Part (iv): `k(p) ⊗_A B ≅ B_p ⧸ pB_p`, where `B_p = (A ∖ p)⁻¹B`. -/
noncomputable def fiberAlgEquivQuotient (p : PrimeSpectrum A) :
    p.asIdeal.Fiber B ≃ₐ[B]
      Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl) ⧸
        (IsLocalRing.maximalIdeal (Localization p.asIdeal.primeCompl)).map
          (algebraMap (Localization p.asIdeal.primeCompl)
            (Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl))) :=
  Ideal.Fiber.algEquivQuotient p.asIdeal

/-- Part (iv), in the form stated in the book: the fibre of `f*` over `p` is homeomorphic to
`Spec (B_p ⧸ pB_p)`, where `B_p = (A ∖ p)⁻¹B`. -/
noncomputable def fiberHomeomorphQuotient (p : PrimeSpectrum A) :
    ↥(PrimeSpectrum.comap (algebraMap A B) ⁻¹' {p}) ≃ₜ
      PrimeSpectrum
        (Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl) ⧸
          (IsLocalRing.maximalIdeal (Localization p.asIdeal.primeCompl)).map
            (algebraMap (Localization p.asIdeal.primeCompl)
              (Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl)))) :=
  (fiberHomeomorph p).trans
    (PrimeSpectrum.homeomorphOfRingEquiv (fiberAlgEquivQuotient p).toRingEquiv)

end PartIV

/-! ## Additional concrete descriptions used in the derivation of part (iv)

The book derives part (iv) by applying (ii) with `S = A ∖ p` and then (iii) with the ideal
`S⁻¹p` of `A_p`. The lemmas below spell out the two intermediate descriptions. -/

section PrimeCompl

variable {A B A_S B_S : Type*} [CommRing A] [CommRing B] [CommRing A_S] [CommRing B_S]
  [Algebra A A_S] [Algebra B B_S]

attribute [local instance] PrimeSpectrum.isPrime

/-- For `S = A ∖ p`, the image `S⁻¹X` of `Spec (A_p)` in `Spec A` is the set of primes of `A`
contained in `p`. -/
theorem range_comap_localization_primeCompl (p : PrimeSpectrum A)
    [IsLocalization p.asIdeal.primeCompl A_S] :
    Set.range (PrimeSpectrum.comap (algebraMap A A_S)) =
      {q : PrimeSpectrum A | q.asIdeal ≤ p.asIdeal} := by
  rw [PrimeSpectrum.localization_comap_range A_S p.asIdeal.primeCompl]
  ext q
  show Disjoint (p.asIdeal.primeCompl : Set A) (q.asIdeal : Set A) ↔ q.asIdeal ≤ p.asIdeal
  constructor
  · intro h x hxq
    by_contra hxp
    exact (Set.disjoint_left.mp h) (Ideal.mem_primeCompl_iff.mpr hxp) hxq
  · intro h
    rw [Set.disjoint_left]
    intro x hx hxq
    exact (Ideal.mem_primeCompl_iff.mp hx) (h hxq)

/-- For `S = A ∖ p`, the set `S⁻¹Y = f*⁻¹(S⁻¹X)` of (ii) consists of the primes of `B` whose
contraction to `A` is contained in `p`. -/
theorem range_comap_localization_map_primeCompl (f : A →+* B) (p : PrimeSpectrum A)
    [IsLocalization p.asIdeal.primeCompl A_S]
    [IsLocalization (Submonoid.map f p.asIdeal.primeCompl) B_S] :
    Set.range (PrimeSpectrum.comap (algebraMap B B_S)) =
      {q : PrimeSpectrum B | q.asIdeal.comap f ≤ p.asIdeal} := by
  rw [range_comap_localization_eq_preimage (A_S := A_S) (B_S := B_S) f p.asIdeal.primeCompl,
    range_comap_localization_primeCompl (A_S := A_S) p]
  rfl

end PrimeCompl

section PrimeComplExtension

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

attribute [local instance] PrimeSpectrum.isPrime

/-- In `B_p`, the extension of `p` is the extension of the maximal ideal of `A_p`, i.e.
`p B_p = (p A_p) B_p`. -/
theorem map_maximalIdeal_eq_map (p : PrimeSpectrum A) :
    (IsLocalRing.maximalIdeal (Localization p.asIdeal.primeCompl)).map
        (algebraMap (Localization p.asIdeal.primeCompl)
          (Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl)))
      = p.asIdeal.map (algebraMap A
          (Localization (Algebra.algebraMapSubmonoid B p.asIdeal.primeCompl))) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq]

end PrimeComplExtension
