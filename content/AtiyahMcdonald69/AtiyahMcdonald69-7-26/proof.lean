/-
# Atiyah–Macdonald (1969), Exercise 7.26: the Grothendieck group `K(A)`

Formalisation of Exercise 7.26 of Atiyah–Macdonald, *Introduction to Commutative Algebra*.

Public statement and solution:
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-26

The exercise: let `A` be a ring, `F(A)` the set of isomorphism classes of finitely generated
`A`-modules, `C` the free abelian group on `F(A)`. To each short exact sequence
`0 → M' → M → M'' → 0` of finitely generated `A`-modules associate `[M'] - [M] + [M''] ∈ C`,
and let `D ≤ C` be the subgroup generated by these elements. The Grothendieck group of `A` is
`K(A) = C ⧸ D`, and `γ_A(M)` denotes the image of `[M]` in `K(A)`. Then:

* (a) every additive function `λ : F(A) → G` into an abelian group `G` factors uniquely
  through a homomorphism `λ₀ : K(A) → G` with `λ₀ ∘ γ = λ`;
* (b) if `A` is Noetherian the elements `γ(A/𝔭)`, `𝔭` prime, generate `K(A)`;
* (c) if `A ≠ 0` is a principal ideal domain then `K(A) ≃ ℤ`;
* (d) a finite ring homomorphism `f : A → B` induces `f_! : K(B) → K(A)` with
  `f_!(γ_B(N)) = γ_A(N)`, and `(g ∘ f)_! = f_! ∘ g_!`.
-/
import Mathlib

-- Two style linters are switched off locally: `unusedSectionVars` fires on hypotheses such as
-- `[IsDomain A]` that enter only through typeclass instances, and `haveILetI` fires on the
-- `haveI` used to install the flatness/finiteness instances required by part (c).
-- They are style lints only; nothing here affects the statements proved.
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

open scoped TensorProduct

universe u v

namespace AtiyahMcdonald69.Ex_7_26

/-! ## Finitely generated modules and their isomorphism classes -/

/-- Bundled finitely generated modules over a commutative ring. -/
structure FGMod (A : Type u) [CommRing A] where
  carrier : Type u
  str : AddCommGroup carrier
  str' : Module A carrier
  finite : Module.Finite A carrier

attribute [instance] FGMod.str FGMod.str' FGMod.finite

namespace FGMod

variable {A : Type u} [CommRing A]

/-- Bundle a finitely generated module. -/
abbrev of (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] : FGMod A :=
  ⟨M, inferInstance, inferInstance, inferInstance⟩

end FGMod

/-- Isomorphism of finitely generated modules. -/
def isoRel {A : Type u} [CommRing A] (M N : FGMod A) : Prop := Nonempty (M.carrier ≃ₗ[A] N.carrier)

theorem isoRel_refl {A : Type u} [CommRing A] (M : FGMod A) : isoRel M M :=
  ⟨LinearEquiv.refl A M.carrier⟩

theorem isoRel_symm {A : Type u} [CommRing A] {M N : FGMod A} (h : isoRel M N) : isoRel N M := by
  obtain ⟨e⟩ := h
  exact ⟨e.symm⟩

theorem isoRel_trans {A : Type u} [CommRing A] {M N P : FGMod A} (h₁ : isoRel M N)
    (h₂ : isoRel N P) : isoRel M P := by
  obtain ⟨e₁⟩ := h₁
  obtain ⟨e₂⟩ := h₂
  exact ⟨e₁.trans e₂⟩

/-- Isomorphism is an equivalence relation. -/
theorem isoRel_equivalence (A : Type u) [CommRing A] : Equivalence (isoRel (A := A)) where
  refl := fun M => isoRel_refl M
  symm := fun h => isoRel_symm h
  trans := fun h₁ h₂ => isoRel_trans h₁ h₂

/-- The setoid of isomorphism classes of finitely generated modules. -/
def isoSetoid (A : Type u) [CommRing A] : Setoid (FGMod A) where
  r := isoRel
  iseqv := isoRel_equivalence A

/-- The set `F(A)` of isomorphism classes of finitely generated `A`-modules. -/
abbrev IsoClass (A : Type u) [CommRing A] := Quotient (isoSetoid A)

/-- The class of a finitely generated module. -/
abbrev isoClass {A : Type u} [CommRing A] (M : FGMod A) : IsoClass A := Quotient.mk _ M

theorem isoClass_eq_of_iso {A : Type u} [CommRing A] {M N : FGMod A} (h : isoRel M N) :
    isoClass M = isoClass N := Quotient.sound h

/-! ## The free abelian group `C` and the subgroup `D` -/

/-- The generator `[M]` of the free abelian group on `F(A)`. -/
abbrev gen {A : Type u} [CommRing A] (M : FGMod A) : FreeAbelianGroup (IsoClass A) :=
  FreeAbelianGroup.of (isoClass M)

/-- A short exact sequence `0 → M' → M → M'' → 0` of finitely generated modules,
encoded by its two maps. -/
def SESRel {A : Type u} [CommRing A] (M' M M'' : FGMod A) (f : M'.carrier →ₗ[A] M.carrier)
    (g : M.carrier →ₗ[A] M''.carrier) : Prop :=
  Function.Injective f ∧ Function.Surjective g ∧ ∀ y, g y = 0 ↔ ∃ x, f x = y

/-- A short exact sequence of finitely generated `A`-modules. -/
structure SES (A : Type u) [CommRing A] where
  /-- the first term -/
  M₀ : FGMod A
  /-- the middle term -/
  M₁ : FGMod A
  /-- the last term -/
  M₂ : FGMod A
  /-- the first map -/
  f : M₀.carrier →ₗ[A] M₁.carrier
  /-- the second map -/
  g : M₁.carrier →ₗ[A] M₂.carrier
  /-- exactness -/
  exact : SESRel M₀ M₁ M₂ f g

/-- The element `[M'] - [M] + [M''] ∈ C` attached to a short exact sequence. -/
def SES.el {A : Type u} [CommRing A] (s : SES A) : FreeAbelianGroup (IsoClass A) :=
  gen s.M₀ - gen s.M₁ + gen s.M₂

/-- The set of elements `[M'] - [M] + [M'']` attached to short exact sequences. -/
def sesEls (A : Type u) [CommRing A] : Set (FreeAbelianGroup (IsoClass A)) :=
  {x | ∃ s : SES A, x = s.el}

/-- The subgroup `D ≤ C` generated by the elements attached to short exact sequences. -/
abbrev D (A : Type u) [CommRing A] : AddSubgroup (FreeAbelianGroup (IsoClass A)) :=
  AddSubgroup.closure (sesEls A)

/-- The Grothendieck group `K(A) = C ⧸ D`. -/
abbrev K (A : Type u) [CommRing A] : Type (u + 1) := FreeAbelianGroup (IsoClass A) ⧸ D A

/-- `γ_A(M)`: the image of `[M]` in `K(A)`. -/
abbrev gamma {A : Type u} [CommRing A] (M : FGMod A) : K A :=
  QuotientAddGroup.mk' (D A) (gen M)

theorem gamma_congr {A : Type u} [CommRing A] {M N : FGMod A} (h : isoRel M N) :
    gamma M = gamma N := by
  have hc : isoClass M = isoClass N := isoClass_eq_of_iso h
  simp only [gamma, gen]
  rw [hc]

theorem gamma_ses {A : Type u} [CommRing A] (s : SES A) : gamma s.M₀ - gamma s.M₁ + gamma s.M₂ = 0 := by
  have hmem : s.el ∈ D A := AddSubgroup.subset_closure ⟨s, rfl⟩
  have hz : QuotientAddGroup.mk' (D A) s.el = 0 := by
    rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
    exact hmem
  simpa only [SES.el, gamma, gen, map_add, map_sub] using hz

/-- A module which is a subsingleton has trivial class. -/
theorem gamma_eq_zero_of_subsingleton {A : Type u} [CommRing A] (M : FGMod A)
    [Subsingleton M.carrier] : gamma M = 0 := by
  have hses : SESRel M M M (LinearMap.id : M.carrier →ₗ[A] M.carrier)
      (0 : M.carrier →ₗ[A] M.carrier) :=
    ⟨fun _ _ hxy => hxy, fun y => ⟨0, Subsingleton.elim _ _⟩,
      fun y => ⟨fun _ => ⟨y, rfl⟩, fun _ => Subsingleton.elim _ _⟩⟩
  have h := gamma_ses (A := A) ⟨M, M, M, _, _, hses⟩
  simpa using h

/-! ## Part (a): the universal property of `K(A)` -/

/-- An additive function on `F(A)` with values in an abelian group `G`. -/
def IsAdditiveFun (A : Type u) [CommRing A] (G : Type v) [AddCommGroup G]
    (lam : IsoClass A → G) : Prop :=
  ∀ (M' M M'' : FGMod A) (f : M'.carrier →ₗ[A] M.carrier) (g : M.carrier →ₗ[A] M''.carrier),
    SESRel M' M M'' f g → lam (isoClass M) = lam (isoClass M') + lam (isoClass M'')

/-- Two homomorphisms out of `K(A)` which agree on all classes `γ(M)` are equal. -/
theorem gamma_ext {A : Type u} [CommRing A] {G : Type v} [AddCommGroup G] {f g : K A →+ G}
    (h : ∀ M : FGMod A, f (gamma M) = g (gamma M)) : f = g := by
  refine QuotientAddGroup.addMonoidHom_ext (D A) ?_
  refine FreeAbelianGroup.lift_ext _ _ fun a => ?_
  obtain ⟨M, rfl⟩ := Quotient.exists_rep a
  exact h M

/-- **Exercise 7.26 (a)**: an additive function on `F(A)` factors uniquely through `K(A)`. -/
theorem part_a (A : Type u) [CommRing A] (G : Type v) [AddCommGroup G] (lam : IsoClass A → G)
    (hlam : IsAdditiveFun A G lam) :
    ∃! lam0 : K A →+ G, ∀ M : FGMod A, lam0 (gamma M) = lam (isoClass M) := by
  have hker : D A ≤ (FreeAbelianGroup.lift lam).ker := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨s, rfl⟩
    simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, SES.el, map_add, map_sub,
      FreeAbelianGroup.lift_apply_of]
    have h := hlam s.M₀ s.M₁ s.M₂ s.f s.g s.exact
    rw [h]
    abel
  refine ⟨QuotientAddGroup.lift (D A) (FreeAbelianGroup.lift lam) hker, ?_, ?_⟩
  · intro M
    have h : (QuotientAddGroup.lift (D A) (FreeAbelianGroup.lift lam) hker)
        (QuotientAddGroup.mk' (D A) (gen M)) = (FreeAbelianGroup.lift lam) (gen M) :=
      QuotientAddGroup.lift_mk' (D A) hker (gen M)
    rw [h, FreeAbelianGroup.lift_apply_of]
  · intro mu hmu
    refine QuotientAddGroup.addMonoidHom_ext (D A) ?_
    have hL : (QuotientAddGroup.lift (D A) (FreeAbelianGroup.lift lam) hker).comp
        (QuotientAddGroup.mk' (D A)) = FreeAbelianGroup.lift lam := by
      refine AddMonoidHom.ext fun x => ?_
      exact QuotientAddGroup.lift_mk' (D A) hker x
    have hMu : mu.comp (QuotientAddGroup.mk' (D A)) = FreeAbelianGroup.lift lam := by
      refine FreeAbelianGroup.lift_ext _ _ fun a => ?_
      obtain ⟨M, rfl⟩ := Quotient.exists_rep a
      have h1 : (mu.comp (QuotientAddGroup.mk' (D A))) (FreeAbelianGroup.of (isoClass M))
          = lam (isoClass M) := hmu M
      rw [h1, FreeAbelianGroup.lift_apply_of]
    rw [hMu, hL]

/-! ## Part (b): the classes `γ(A/𝔭)` generate `K(A)` -/

/-- The cyclic module `A ⧸ 𝔭` attached to an ideal `𝔭`. -/
noncomputable abbrev modIdeal (A : Type u) [CommRing A] (p : Ideal A) : FGMod A :=
  FGMod.of (A ⧸ p)

/-- **Exercise 7.26 (b)**: for Noetherian `A`, the classes `γ(A/𝔭)`, `𝔭` prime, generate `K(A)`. -/
theorem part_b (A : Type u) [CommRing A] [IsNoetherianRing A] :
    AddSubgroup.closure (Set.range fun p : {p : Ideal A // p.IsPrime} => gamma (modIdeal A p.1)) =
      ⊤ := by
  classical
  set S : AddSubgroup (K A) :=
    AddSubgroup.closure (Set.range fun p : {p : Ideal A // p.IsPrime} => gamma (modIdeal A p.1))
      with hS
  have hmem : ∀ p : {p : Ideal A // p.IsPrime}, gamma (modIdeal A p.1) ∈ S := fun p =>
    AddSubgroup.subset_closure ⟨p, rfl⟩
  have hgen : ∀ M : FGMod A, gamma M ∈ S := by
    intro M
    refine IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime A M.finite
      (motive := fun (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] =>
        gamma (FGMod.of N) ∈ S) ?_ ?_ ?_
    · intro N _ _ _ _
      rw [gamma_eq_zero_of_subsingleton (A := A) (FGMod.of N)]
      exact S.zero_mem
    · intro N _ _ _ p e
      have hN : isoRel (FGMod.of N) (modIdeal A p.asIdeal) := ⟨e⟩
      rw [gamma_congr hN]
      exact hmem ⟨p.asIdeal, p.isPrime⟩
    · intro N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f g hf hg hex ih₁ ih₃
      have hses : SESRel (A := A) (FGMod.of (A := A) N₁) (FGMod.of (A := A) N₂)
          (FGMod.of (A := A) N₃) f g := ⟨hf, hg, hex⟩
      have h := gamma_ses (A := A) ⟨_, _, _, _, _, hses⟩
      have h₂ : gamma (FGMod.of (A := A) N₂) = gamma (FGMod.of (A := A) N₁) + gamma (FGMod.of (A := A) N₃) := by
        have h1 : gamma (FGMod.of (A := A) N₁) - gamma (FGMod.of (A := A) N₂) = -gamma (FGMod.of (A := A) N₃) := by
          rw [add_eq_zero_iff_eq_neg] at h
          exact h
        rw [sub_eq_iff_eq_add] at h1
        rw [h1]
        abel
      rw [h₂]
      exact S.add_mem ih₁ ih₃
  refine eq_top_iff.mpr ?_
  rintro x -
  obtain ⟨c, rfl⟩ := QuotientAddGroup.mk'_surjective (D A) x
  induction c using FreeAbelianGroup.induction_on with
  | zero => exact S.zero_mem
  | of a =>
      obtain ⟨M, rfl⟩ := Quotient.exists_rep a
      exact hgen M
  | neg a ih => exact S.neg_mem ih
  | add a b ha hb => exact S.add_mem ha hb

/-! ## Part (d): functoriality in finite ring homomorphisms -/

section PartD

variable {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]

section FiniteAlgebra

variable [Algebra A B] [Module.Finite A B]

/-- A `B`-module is an `A`-module by restriction of scalars along `A → B`. -/
instance instModuleRestrict (N : FGMod B) : Module A N.carrier :=
  Module.compHom N.carrier (algebraMap A B)

instance instIsScalarTowerRestrict (N : FGMod B) : IsScalarTower A B N.carrier :=
  ⟨fun x y z => by rw [Algebra.smul_def, mul_smul]; rfl⟩

/-- Restriction of scalars: a finitely generated `B`-module is a finitely generated
`A`-module when `B` is a finite `A`-module. -/
noncomputable abbrev restrict (N : FGMod B) : FGMod A :=
  FGMod.mk N.carrier N.str (instModuleRestrict N) (Module.Finite.trans (R := A) B N.carrier)

/-- A `B`-linear map is `A`-linear after restriction of scalars. -/
def restrictLinMap {M M' : FGMod B} (f : M.carrier →ₗ[B] M'.carrier) : M.carrier →ₗ[A] M'.carrier where
  toFun := f
  map_add' := f.map_add
  map_smul' := fun a x => f.map_smul (algebraMap A B a) x

/-- Restriction of scalars preserves isomorphisms. -/
theorem isoRel_restrict {N₁ N₂ : FGMod B} (h : isoRel N₁ N₂) :
    isoRel (restrict (A := A) N₁) (restrict (A := A) N₂) := by
  obtain ⟨e⟩ := h
  exact ⟨{ toFun := e, invFun := e.symm, left_inv := e.left_inv, right_inv := e.right_inv, map_add' := e.map_add, map_smul' := fun a x => e.map_smul (algebraMap A B a) x }⟩

/-- The function `F(B) → K(A)` induced by restriction of scalars. -/
noncomputable def mapIso : IsoClass B → K A :=
  Quotient.lift (fun N : FGMod B => gamma (restrict (A := A) N)) fun _ _ h => gamma_congr (isoRel_restrict h)

theorem mapIso_additive : IsAdditiveFun B (K A) (mapIso (A := A) (B := B)) := by
  intro M' M M'' f g hses
  have hses' : SESRel (A := A) (restrict (A := A) M') (restrict (A := A) M) (restrict (A := A) M'')
      (restrictLinMap (A := A) (B := B) (M := M') (M' := M) f)
      (restrictLinMap (A := A) (B := B) (M := M) (M' := M'') g) := ⟨hses.1, hses.2.1, hses.2.2⟩
  have h := gamma_ses (A := A)
    ⟨restrict (A := A) M', restrict (A := A) M, restrict (A := A) M'', restrictLinMap (A := A) (B := B) (M := M') (M' := M) f,
      restrictLinMap (A := A) (B := B) (M := M) (M' := M'') g, hses'⟩
  have h₂ : gamma (restrict (A := A) M) = gamma (restrict (A := A) M') + gamma (restrict (A := A) M'') := by
    have h1 : gamma (restrict (A := A) M') - gamma (restrict (A := A) M) = -gamma (restrict (A := A) M'') := by
      rw [add_eq_zero_iff_eq_neg] at h
      exact h
    rw [sub_eq_iff_eq_add] at h1
    rw [h1]
    abel
  simpa only [mapIso, Quotient.lift_mk] using h₂

/-- **Exercise 7.26 (d)**: restriction of scalars along a finite ring homomorphism, as a map
`K(B) → K(A)`. -/
noncomputable def mapK : K B →+ K A :=
  (part_a B (K A) (mapIso (A := A)) (mapIso_additive (A := A))).choose

theorem mapK_gamma (N : FGMod B) : mapK (A := A) (gamma N) = gamma (restrict (A := A) N) :=
  (part_a B (K A) (mapIso (A := A)) (mapIso_additive (A := A))).choose_spec.1 N

end FiniteAlgebra

section Functoriality

variable [Algebra A B] [Module.Finite A B] [Algebra B C] [Algebra A C]
  [IsScalarTower A B C] [Module.Finite B C]

/-- Restriction of scalars from `C` to `A` directly or through `B` gives isomorphic modules. -/
theorem isoRel_restrict_restrict (P : FGMod C) :
    isoRel (@restrict A C _ _ _ (Module.Finite.trans (R := A) B C) P)
      (@restrict A B _ _ _ _ (restrict (A := B) (B := C) P)) := by
  refine ⟨{ toFun := id, invFun := id, left_inv := fun _ => rfl, right_inv := fun _ => rfl, map_add' := fun _ _ => rfl, map_smul' := ?_ }⟩
  intro a x
  show (algebraMap A C a) • x = (algebraMap B C (algebraMap A B a)) • x
  rw [IsScalarTower.algebraMap_apply A B C]

/-- **Exercise 7.26 (d)**, functoriality: `(g ∘ f)_! = f_! ∘ g_!`. -/
theorem mapK_comp :
    @mapK A C _ _ _ (Module.Finite.trans (R := A) B C) =
      (mapK (A := A) (B := B)).comp (mapK (A := B) (B := C)) := by
  refine gamma_ext (A := C) (G := K A) fun P => ?_
  rw [AddMonoidHom.comp_apply, mapK_gamma (A := B) (B := C) P,
    mapK_gamma (A := A) (B := B) (restrict (A := B) (B := C) P),
    @mapK_gamma A C _ _ _ (Module.Finite.trans (R := A) B C) P]
  exact gamma_congr (isoRel_restrict_restrict P)

end Functoriality

end PartD

/-! ## Part (c): for a principal ideal domain, `K(A) ≅ ℤ` -/

/-- `A ⧸ (0)` is `A` as an `A`-module. -/
noncomputable def quotientBotEquiv {A : Type u} [CommRing A] : (A ⧸ (⊥ : Ideal A)) ≃ₗ[A] A where
  toFun x := (RingEquiv.quotientBot A) x
  invFun y := (RingEquiv.quotientBot A).symm y
  left_inv x := (RingEquiv.quotientBot A).left_inv x
  right_inv y := (RingEquiv.quotientBot A).right_inv y
  map_add' := (RingEquiv.quotientBot A).map_add
  map_smul' r x := by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    have h1 : r • (Ideal.Quotient.mk (⊥ : Ideal A) x) = Ideal.Quotient.mk (⊥ : Ideal A) (r * x) :=
      rfl
    rw [h1, RingEquiv.quotientBot_mk, RingEquiv.quotientBot_mk]
    simp [smul_eq_mul]

section PartC

variable {A : Type u} [CommRing A] [IsDomain A]

/-- The fraction field of a domain is a flat module over it. -/
instance instFlatFractionRing : Module.Flat A (FractionRing A) :=
  IsLocalization.flat (FractionRing A) (nonZeroDivisors A)

/-- `Frac A ⊗ M` is finite dimensional over `Frac A` when `M` is finitely generated. -/
instance instFiniteTensorFractionRing (M : FGMod A) :
    Module.Finite (FractionRing A) (FractionRing A ⊗[A] M.carrier) :=
  Module.Finite.equiv (LocalizedModule.equivTensorProduct (nonZeroDivisors A) M.carrier)

/-- The rank of a finitely generated module: the dimension of `Frac A ⊗ M` over `Frac A`. -/
noncomputable def rankFun (M : FGMod A) : ℕ :=
  Module.finrank (FractionRing A) (FractionRing A ⊗[A] M.carrier)

/-- Additivity of `finrank` over a field along a short exact sequence. -/
theorem finrank_add_of_exact {V V' V'' : Type u} [AddCommGroup V] [Module (FractionRing A) V]
    [AddCommGroup V'] [Module (FractionRing A) V'] [AddCommGroup V''] [Module (FractionRing A) V'']
    [Module.Finite (FractionRing A) V] [Module.Finite (FractionRing A) V']
    [Module.Finite (FractionRing A) V''] (f : V' →ₗ[FractionRing A] V)
    (g : V →ₗ[FractionRing A] V'') (hf : Function.Injective f) (hg : Function.Surjective g)
    (hex : Function.Exact f g) :
    Module.finrank (FractionRing A) V =
      Module.finrank (FractionRing A) V' + Module.finrank (FractionRing A) V'' := by
  have h1 : Module.finrank (FractionRing A) (V ⧸ LinearMap.ker g)
      + Module.finrank (FractionRing A) (LinearMap.ker g)
      = Module.finrank (FractionRing A) V :=
    Submodule.finrank_quotient_add_finrank (LinearMap.ker g)
  have h2 : Module.finrank (FractionRing A) (V ⧸ LinearMap.ker g)
      = Module.finrank (FractionRing A) V'' :=
    LinearEquiv.finrank_eq (LinearMap.quotKerEquivOfSurjective g hg)
  have h3 : Module.finrank (FractionRing A) (LinearMap.ker g)
      = Module.finrank (FractionRing A) V' := by
    rw [LinearMap.exact_iff.mp hex]
    exact (LinearEquiv.finrank_eq (LinearEquiv.ofInjective f hf)).symm
  omega

/-- Isomorphic modules have the same rank. -/
theorem rankFun_congr {M N : FGMod A} (h : isoRel M N) : rankFun M = rankFun N := by
  obtain ⟨e⟩ := h
  have ee : (FractionRing A ⊗[A] M.carrier) ≃ₗ[FractionRing A]
      (FractionRing A ⊗[A] N.carrier) :=
    LinearEquiv.extendScalarsOfIsLocalization (nonZeroDivisors A) (FractionRing A)
      (TensorProduct.congr (LinearEquiv.refl A (FractionRing A)) e)
  exact LinearEquiv.finrank_eq ee

/-- The rank as a function on iso classes. -/
noncomputable def rankIso : IsoClass A → ℕ :=
  Quotient.lift rankFun fun _ _ h => rankFun_congr h

/-- Rank is additive on short exact sequences. -/
theorem rankFun_ses {M' M M'' : FGMod A} {f : M'.carrier →ₗ[A] M.carrier}
    {g : M.carrier →ₗ[A] M''.carrier} (h : SESRel M' M M'' f g) :
    rankFun M = rankFun M' + rankFun M'' :=
  finrank_add_of_exact (f.lTensor (FractionRing A)) (g.lTensor (FractionRing A))
    (Module.Flat.lTensor_preserves_injective_linearMap _ h.1)
    (LinearMap.lTensor_surjective _ h.2.1)
    (Module.Flat.lTensor_exact (FractionRing A) h.2.2)

theorem rankIso_additive :
    IsAdditiveFun A ℤ fun x : IsoClass A => ((rankIso (A := A) x : ℕ) : ℤ) := by
  intro M' M M'' f g hses
  have h := rankFun_ses hses
  simp only [rankIso, Quotient.lift_mk]
  have h' : ((rankFun M : ℕ) : ℤ) = ((rankFun M' : ℕ) : ℤ) + ((rankFun M'' : ℕ) : ℤ) := by
    rw [h]; push_cast; ring
  exact h'

/-- The rank of `A` itself is one. -/
theorem rankFun_self : rankFun (A := A) (FGMod.of (A := A) A) = 1 := by
  have e : (FractionRing A ⊗[A] A) ≃ₗ[FractionRing A] (FractionRing A) :=
    LinearEquiv.extendScalarsOfIsLocalization (nonZeroDivisors A) (FractionRing A)
      ((TensorProduct.comm A (FractionRing A) A).trans (TensorProduct.lid A (FractionRing A)))
  rw [rankFun, LinearEquiv.finrank_eq e, Module.finrank_self]

/-- In a principal ideal domain every nonzero prime ideal is principal on a nonzero element,
and then `γ(A ⧸ 𝔭) = 0`. -/
theorem gamma_modIdeal_eq_zero_of_ne_bot [IsPrincipalIdealRing A] {p : Ideal A}
    (_hp : p.IsPrime) (hne : p ≠ ⊥) : gamma (modIdeal A p) = 0 := by
  obtain ⟨a, ha⟩ := IsPrincipalIdealRing.principal p
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact hne (by rw [ha]; simp)
  have hf : Function.Injective (a • (LinearMap.id : A →ₗ[A] A)) := by
    intro x y hxy
    simp only [LinearMap.smul_apply, LinearMap.id_coe, id, smul_eq_mul] at hxy
    exact mul_left_cancel₀ ha0 hxy
  have hg : Function.Surjective (Ideal.Quotient.mkₐ A p).toLinearMap :=
    Ideal.Quotient.mk_surjective
  have hex : ∀ y : A, (Ideal.Quotient.mkₐ A p).toLinearMap y = 0 ↔
      ∃ x : A, (a • (LinearMap.id : A →ₗ[A] A)) x = y := by
    intro y
    constructor
    · intro hy
      have hym : y ∈ p := by
        have h' : Ideal.Quotient.mk p y = 0 := hy
        exact Ideal.Quotient.eq_zero_iff_mem.mp h'
      rw [ha, Ideal.mem_span_singleton] at hym
      obtain ⟨z, hz⟩ := hym
      refine ⟨z, ?_⟩
      show a * z = y
      rw [hz, mul_comm]
    · rintro ⟨x, rfl⟩
      have hm : a * x ∈ p := by
        rw [ha]
        exact Ideal.mul_mem_right x _ (Ideal.subset_span (Set.mem_singleton a))
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hm
  have hses : SESRel (FGMod.of (A := A) A) (FGMod.of (A := A) A) (modIdeal A p)
      (a • (LinearMap.id : A →ₗ[A] A)) (Ideal.Quotient.mkₐ A p).toLinearMap := ⟨hf, hg, hex⟩
  have h := gamma_ses (A := A) ⟨_, _, _, _, _, hses⟩
  simpa using h

/-- **Exercise 7.26 (c)**: for a principal ideal domain `A`, the rank map is an isomorphism
`K(A) ≅ ℤ`. -/
theorem part_c [IsPrincipalIdealRing A] :
    ∃ rk : K A →+ ℤ, Function.Bijective rk ∧ ∀ M : FGMod A, rk (gamma M) = (rankFun M : ℤ) := by
  haveI hnoeth : IsNoetherianRing A := PrincipalIdealRing.isNoetherianRing
  obtain ⟨rk, hrk, -⟩ := part_a A ℤ (fun x => ((rankIso (A := A) x : ℕ) : ℤ)) rankIso_additive
  have hrkA : rk (gamma (FGMod.of (A := A) A)) = 1 := by
    rw [hrk]
    show ((rankFun (A := A) (FGMod.of (A := A) A) : ℕ) : ℤ) = 1
    rw [rankFun_self]
    norm_num
  -- `γ(A)` generates `K(A)` as an abelian group
  have htop : ∀ x : K A, ∃ n : ℤ, n • gamma (FGMod.of (A := A) A) = x := by
    have hle : AddSubgroup.closure
        (Set.range fun p : {p : Ideal A // p.IsPrime} => gamma (modIdeal A p.1)) ≤
        (zmultiplesHom (K A) (gamma (FGMod.of (A := A) A))).range := by
      refine (AddSubgroup.closure_le _).mpr ?_
      rintro _ ⟨p, rfl⟩
      change gamma (modIdeal A p.1) ∈ (zmultiplesHom (K A) (gamma (FGMod.of (A := A) A))).range
      by_cases hbot : p.1 = ⊥
      · rw [hbot]
        refine ⟨1, ?_⟩
        rw [zmultiplesHom_apply, one_smul]
        exact gamma_congr ⟨(quotientBotEquiv (A := A)).symm⟩
      · rw [gamma_modIdeal_eq_zero_of_ne_bot p.2 hbot]
        exact ⟨0, by simp⟩
    rw [part_b A] at hle
    intro x
    obtain ⟨n, hn⟩ := hle (Set.mem_univ x)
    exact ⟨n, hn⟩
  refine ⟨rk, ⟨?_, ?_⟩, hrk⟩
  · rintro x y hxy
    obtain ⟨n, rfl⟩ := htop x
    obtain ⟨m, rfl⟩ := htop y
    have hn : rk (n • gamma (FGMod.of (A := A) A)) = n := by
      rw [map_zsmul, hrkA]; simp
    have hm : rk (m • gamma (FGMod.of (A := A) A)) = m := by
      rw [map_zsmul, hrkA]; simp
    rw [hn, hm] at hxy
    rw [hxy]
  · intro n
    exact ⟨n • gamma (FGMod.of (A := A) A), by rw [map_zsmul, hrkA]; simp⟩

end PartC

/-! ## The exercise, all four parts -/

/-- **Atiyah–Macdonald (1969), Exercise 7.26.** Let `A` be a Noetherian ring, `F(A)` the set of
isomorphism classes of finitely generated `A`-modules, `C` the free abelian group on `F(A)`, `D ≤ C`
the subgroup generated by the elements `[M'] - [M] + [M'']` attached to short exact sequences, and
`K(A) = C ⧸ D` with `γ_A(M) = [M] mod D`. Then:

* (a) every additive function `λ : F(A) → G` into an abelian group `G` factors uniquely as
  `λ₀ ∘ γ = λ` with `λ₀ : K(A) → G` a homomorphism;
* (b) the classes `γ(A/𝔭)`, `𝔭` prime, generate `K(A)`;
* (c) if `A ≠ 0` is a principal ideal domain then the rank map is an isomorphism `K(A) ≅ ℤ`;
* (d) a finite ring homomorphism `A → B` gives `f_! : K(B) → K(A)` with `f_! γ_B = γ_A`, and
  `(g ∘ f)_! = f_! ∘ g_!`.

We state all four parts; (a), (b) only need `A` Noetherian, (c) needs a principal ideal domain,
and in (d) the ring homomorphisms are packaged as algebra structures. -/
theorem solution {A : Type u} [CommRing A] [IsDomain A] [IsPrincipalIdealRing A] :
    (∀ (G : Type v) [AddCommGroup G] (lam : IsoClass A → G), IsAdditiveFun A G lam →
        ∃! lam0 : K A →+ G, ∀ M : FGMod A, lam0 (gamma M) = lam (isoClass M)) ∧
      (AddSubgroup.closure
          (Set.range fun p : {p : Ideal A // p.IsPrime} => gamma (modIdeal A p.1)) = ⊤) ∧
      (∃ rk : K A →+ ℤ, Function.Bijective rk ∧
        ∀ M : FGMod A, rk (gamma M) = (rankFun M : ℤ)) ∧
      (∀ {B : Type u} [CommRing B] [Algebra A B] [Module.Finite A B] (N : FGMod B),
        mapK (A := A) (gamma N) = gamma (restrict (A := A) N)) ∧
      (∀ {B C : Type u} [CommRing B] [Algebra A B] [Module.Finite A B] [CommRing C] [Algebra B C]
        [Algebra A C] [IsScalarTower A B C] [Module.Finite B C],
        @mapK A C _ _ _ (Module.Finite.trans (R := A) B C) =
          (mapK (A := A) (B := B)).comp (mapK (A := B) (B := C))) := by
  refine ⟨part_a A, part_b A, part_c, fun N => mapK_gamma N, ?_⟩
  intro B C _ _ _ _ _ _ _ _
  exact mapK_comp

/-- Exercise 7.26 (c) stated as an additive equivalence `K(A) ≃+ ℤ`. -/
theorem part_c_addEquiv {A : Type u} [CommRing A] [IsDomain A] [IsPrincipalIdealRing A] :
    ∃ e : K A ≃+ ℤ, ∀ M : FGMod A, e (gamma M) = (rankFun M : ℤ) := by
  obtain ⟨rk, hbij, h⟩ := part_c (A := A)
  exact ⟨AddEquiv.ofBijective rk hbij, h⟩


/-- **Exercise 7.26 (d)** in the form stated in the book: a finite ring homomorphism
`A → B` gives `f_! : K(B) → K(A)` with `f_!(γ_B N) = γ_A N`, and `f_! ∘ g_! = (g ∘ f)_!`. -/
theorem part_d {A : Type u} [CommRing A] {B : Type u} [CommRing B] [Algebra A B]
    [Module.Finite A B] {C : Type u} [CommRing C] [Algebra B C] [Algebra A C]
    [IsScalarTower A B C] [Module.Finite B C] :
    ∃ fsh : K B →+ K A, (∀ N : FGMod B, fsh (gamma N) = gamma (restrict (A := A) N)) ∧
      fsh.comp (mapK (A := B) (B := C)) =
        @mapK A C _ _ _ (Module.Finite.trans (R := A) B C) :=
  ⟨mapK, mapK_gamma, mapK_comp.symm⟩

