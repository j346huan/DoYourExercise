import Mathlib

set_option autoImplicit false

/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Addison–Wesley 1969,
Chapter 7, Exercise 9.

Original statement (Chapter 7, Exercise 9):
  "Show that the ring A is Noetherian if the following hold
   a. For each maximal ideal m, the ring A_m is Noetherian.
   b. For each x ≠ 0 in A, there are finitely many maximal ideals in A containing x."

Reference (natural-language proof, read in full and checked against the book statement):
  https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-9

The reference proof is correct and uses no unstated hypothesis.  It runs: given an ideal
`a ≠ 0` and `0 ≠ x ∈ a`, hypothesis (b) gives a finite set `T` of maximal ideals containing
`x`; for each `m ∈ T` the ideal `a_m` is finitely generated over the Noetherian ring `A_m`,
and each generator can be lifted to an element of `a`; the ideal generated by `x` and all
these lifts is contained in `a` and has the same localization as `a` at every maximal ideal
(at `m ∈ T` by construction, at `m ∉ T` because `x` becomes a unit).  Localizations at
maximal ideals are jointly faithful, so the two ideals coincide, and `a` is finitely
generated.

Hypothesis (b) is not redundant: Exercise 7.11 of the same chapter exhibits a ring
(`∏_n ℤ/2`) whose localizations at prime ideals are all fields, hence Noetherian, but
which is not Noetherian.  This is not formalized below.
-/

namespace AtiyahMcdonald69.Ex_7_9

/-- Atiyah–Macdonald, Exercise 7.9: if `A_m` is Noetherian for every maximal ideal `m`, and
every nonzero `x : A` lies in only finitely many maximal ideals, then `A` is Noetherian. -/
theorem solution (A : Type*) [CommRing A]
    (hA : ∀ (m : Ideal A) [m.IsMaximal], IsNoetherianRing (Localization.AtPrime m))
    (hB : ∀ (x : A), x ≠ 0 → {m : Ideal A | m.IsMaximal ∧ x ∈ m}.Finite) :
    IsNoetherianRing A := by
  classical
  rw [isNoetherianRing_iff_ideal_fg]
  intro a
  by_cases ha : a = ⊥
  · rw [ha]
    exact ⟨∅, by simp⟩
  obtain ⟨x, hxa, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot ha
  -- Hypothesis (b): only finitely many maximal ideals contain `x`.
  let T : Set (Ideal A) := {m : Ideal A | m.IsMaximal ∧ x ∈ m}
  have hTfin : T.Finite := hB x hx0
  have : Fintype T := hTfin.fintype
  -- At a maximal ideal `m`, finitely many elements of `a` generate the localization of `a`.
  have aux : ∀ (m : Ideal A) [m.IsMaximal], ∃ S : Finset A, (↑S : Set A) ⊆ (a : Set A) ∧
      Ideal.map (algebraMap A (Localization.AtPrime m)) a ≤
        Ideal.span ((algebraMap A (Localization.AtPrime m)) '' (↑S : Set A)) := by
    intro m hm
    have hN : IsNoetherianRing (Localization.AtPrime m) := hA m
    have hfg : (Submodule.span (Localization.AtPrime m)
        ((algebraMap A (Localization.AtPrime m)) '' (a : Set A))).FG :=
      IsNoetherian.noetherian _
    obtain ⟨S, hSsub, hSspan⟩ :=
      (Submodule.fg_span_iff_fg_span_finset_subset
        (R := Localization.AtPrime m)
        ((algebraMap A (Localization.AtPrime m)) '' (a : Set A))).mp hfg
    -- every generator of `a_m` is the image of an element of `a`
    have hex : ∀ s ∈ S, ∃ y ∈ (a : Set A), algebraMap A (Localization.AtPrime m) y = s := by
      intro s hs
      exact hSsub (by simpa using hs)
    refine ⟨S.attach.image (fun s => (hex s.1 s.2).choose), ?_, ?_⟩
    · intro y hy
      obtain ⟨s, -, rfl⟩ := Finset.mem_image.mp hy
      exact (hex s.1 s.2).choose_spec.1
    · have himg : (↑S : Set (Localization.AtPrime m)) ⊆
          (algebraMap A (Localization.AtPrime m)) ''
            (↑(S.attach.image (fun s => (hex s.1 s.2).choose)) : Set A) := by
        intro s hs
        exact ⟨(hex s hs).choose, Finset.mem_image.mpr ⟨⟨s, hs⟩, by simp, rfl⟩,
          (hex s hs).choose_spec.2⟩
      calc Ideal.map (algebraMap A (Localization.AtPrime m)) a
          = Ideal.span (↑S : Set (Localization.AtPrime m)) := hSspan
        _ ≤ Ideal.span ((algebraMap A (Localization.AtPrime m)) ''
              (↑(S.attach.image (fun s => (hex s.1 s.2).choose)) : Set A)) :=
            Submodule.span_mono himg
  choose S hSsub hSgen using fun m : T => @aux m.1 m.2.1
  -- The candidate ideal: generated by `x` and all the lifts.
  let G : Finset A := insert x (Finset.univ.biUnion S)
  have hGmem : ∀ y ∈ G, y ∈ a := by
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact hxa
    · obtain ⟨m, -, hym⟩ := Finset.mem_biUnion.mp hy
      exact hSsub m hym
  -- Localizations at maximal ideals detect equality of ideals.
  have hloc : ∀ (P : Ideal A) [P.IsMaximal],
      Ideal.map (algebraMap A (Localization.AtPrime P)) (Ideal.span (↑G : Set A)) =
        Ideal.map (algebraMap A (Localization.AtPrime P)) a := by
    intro P hP
    have hP' : P.IsMaximal := hP
    rw [Ideal.map_span]
    refine le_antisymm ?_ ?_
    · refine Ideal.span_le.mpr ?_
      rintro y ⟨z, hzG, rfl⟩
      exact Ideal.mem_map_of_mem (algebraMap A (Localization.AtPrime P)) (hGmem z hzG)
    · by_cases hxP : x ∈ P
      · -- `P` is one of the finitely many maximal ideals containing `x`
        have hPT : P ∈ T := ⟨hP, hxP⟩
        have hsub : (algebraMap A (Localization.AtPrime P)) '' (↑(S ⟨P, hPT⟩) : Set A) ⊆
            (algebraMap A (Localization.AtPrime P)) '' (↑G : Set A) := by
          rintro y ⟨z, hz, rfl⟩
          exact ⟨z, Finset.mem_insert_of_mem
            (Finset.mem_biUnion.mpr ⟨⟨P, hPT⟩, Finset.mem_univ _, hz⟩), rfl⟩
        calc Ideal.map (algebraMap A (Localization.AtPrime P)) a
            ≤ Ideal.span ((algebraMap A (Localization.AtPrime P)) ''
                (↑(S ⟨P, hPT⟩) : Set A)) := hSgen ⟨P, hPT⟩
          _ ≤ Ideal.span ((algebraMap A (Localization.AtPrime P)) '' (↑G : Set A)) :=
              Submodule.span_mono hsub
      · -- `x` becomes a unit, so both localizations are the whole ring
        have hunit : IsUnit (algebraMap A (Localization.AtPrime P) x) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff (S := Localization.AtPrime P) (I := P)
            x).mpr hxP
        have htop : Ideal.span ((algebraMap A (Localization.AtPrime P)) '' (↑G : Set A)) = ⊤ :=
          Ideal.eq_top_of_isUnit_mem _
            (Submodule.subset_span ⟨x, Finset.mem_insert_self x _, rfl⟩) hunit
        rw [htop]
        exact le_top
  exact ⟨G, Ideal.eq_of_localization_maximal hloc⟩

#print axioms AtiyahMcdonald69.Ex_7_9.solution
