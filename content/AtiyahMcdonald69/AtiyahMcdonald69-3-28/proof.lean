import Mathlib

/-!
# Atiyah–Macdonald, Chapter 3, Exercise 28

We formalize Exercise 28 of Chapter 3 of Atiyah–Macdonald, *Introduction to Commutative
Algebra*:

> 28. (Continuation of Exercise 27.) i) For each `g ∈ A`, the set `X_g` (Chapter 1,
> Exercise 17) is both open and closed in the constructible topology. ii) Let `C'` denote the
> smallest topology on `X = Spec A` for which the sets `X_g` are both open and closed, and let
> `X_{C'}` denote the set `X` endowed with this topology. Show that `X_{C'}` is Hausdorff.
> iii) Deduce that the identity mapping `X_C → X_{C'}` is a homeomorphism. Hence a subset `E`
> of `X` is of the form `f^*(Spec B)` for some `f : A → B` if and only if it is closed in the
> topology `C'`. iv) The topological space `X_C` is compact, Hausdorff and totally disconnected.

Mathlib's `PrimeSpectrum` provides the Zariski topology; the topology `C'` is defined below as
the topology generated by the `X_g` and their complements, and the topology `C` of Exercise 3.27
as the coarsest topology in which every set of the form `f^*(Spec B)` is closed.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace AtiyahMcdonald69.Ex_3_28

open PrimeSpectrum Topology Set

universe u

variable {A : Type u} [CommRing A]

/-! ## The sets `X_g` (Chapter 1, Exercise 17) -/

/-- Chapter 1, Exercise 17: `X_g = {p | g ∉ p} = D(g)`, the set of primes not containing `g`. -/
def Xg (g : A) : Set (PrimeSpectrum A) := (basicOpen g : Set _)

theorem mem_Xg {g : A} {p : PrimeSpectrum A} : p ∈ Xg g ↔ g ∉ p.asIdeal :=
  PrimeSpectrum.mem_basicOpen g p

theorem Xg_eq_compl_zeroLocus (g : A) : Xg g = (zeroLocus {g})ᶜ := by
  rw [Xg, basicOpen_eq_zeroLocus_compl]

/-! ## The topology `C'` of Exercise 3.28 (ii) -/

/-- The subbasis for the topology `C'`: the sets `X_g` and their complements. -/
def subbasisC' : Set (Set (PrimeSpectrum A)) :=
  {s | (∃ g : A, s = Xg g) ∨ ∃ g : A, s = (Xg g)ᶜ}

theorem subbasisC'_compl {s : Set (PrimeSpectrum A)} (hs : s ∈ subbasisC' (A := A)) :
    sᶜ ∈ subbasisC' (A := A) := by
  obtain ⟨g, rfl⟩ | ⟨g, rfl⟩ := hs
  · exact Or.inr ⟨g, rfl⟩
  · exact Or.inl ⟨g, compl_compl (Xg g)⟩

/-- The topology `C'` of Exercise 3.28 (ii): the smallest topology for which all `X_g` are
clopen. -/
@[instance_reducible]
def topologyC' : TopologicalSpace (PrimeSpectrum A) :=
  TopologicalSpace.generateFrom (subbasisC' (A := A))

theorem Xg_isOpen (g : A) : IsOpen[topologyC' (A := A)] (Xg g) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨g, rfl⟩)

theorem Xg_compl_isOpen (g : A) : IsOpen[topologyC' (A := A)] (Xg g)ᶜ :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨g, rfl⟩)

theorem Xg_isClosed (g : A) : IsClosed[topologyC' (A := A)] (Xg g) :=
  @IsClosed.mk _ (topologyC' (A := A)) _ (Xg_compl_isOpen g)

theorem Xg_compl_isClosed (g : A) : IsClosed[topologyC' (A := A)] (Xg g)ᶜ :=
  @IsClosed.mk _ (topologyC' (A := A)) _ (by simpa using Xg_isOpen (A := A) g)

/-- **Exercise 3.28 (i)**: each `X_g` is both open and closed in the topology `C'`. -/
theorem Xg_isClopen (g : A) : @IsClopen _ (topologyC' (A := A)) (Xg g) :=
  ⟨Xg_isClosed g, Xg_isOpen g⟩

theorem Xg_compl_isClopen (g : A) : @IsClopen _ (topologyC' (A := A)) (Xg g)ᶜ :=
  ⟨Xg_compl_isClosed g, Xg_compl_isOpen g⟩

/-! ## Separation: Exercise 3.28 (ii) -/

theorem exists_separating {p q : PrimeSpectrum A} (h : p ≠ q) :
    ∃ a : A, (a ∈ p.asIdeal ∧ a ∉ q.asIdeal) ∨ (a ∈ q.asIdeal ∧ a ∉ p.asIdeal) := by
  by_contra hc
  push Not at hc
  refine h (PrimeSpectrum.ext (Ideal.ext fun a => ?_))
  exact ⟨fun ha => (hc a).1 ha, fun ha => (hc a).2 ha⟩

theorem exists_isClopen_separating {p q : PrimeSpectrum A} (h : p ≠ q) :
    ∃ U : Set (PrimeSpectrum A), @IsClopen _ (topologyC' (A := A)) U ∧ p ∈ U ∧ q ∈ Uᶜ := by
  obtain ⟨a, ha | ha⟩ := exists_separating h
  · exact ⟨(Xg a)ᶜ, Xg_compl_isClopen a, fun hc => (mem_Xg.mp hc) ha.1,
      by simpa using mem_Xg.mpr ha.2⟩
  · exact ⟨Xg a, Xg_isClopen a, mem_Xg.mpr ha.2, fun hc => (mem_Xg.mp hc) ha.1⟩

/-- **Exercise 3.28 (ii)**: `X_{C'}` is Hausdorff. -/
theorem t2Space_C' : @T2Space (PrimeSpectrum A) (topologyC' (A := A)) := by
  refine (@t2Space_iff (PrimeSpectrum A) (topologyC' (A := A))).mpr ?_
  intro p q hpq
  obtain ⟨a, ha | ha⟩ := exists_separating hpq
  · exact ⟨(Xg a)ᶜ, Xg a, Xg_compl_isOpen a, Xg_isOpen a,
      fun hc => (mem_Xg.mp hc) ha.1, mem_Xg.mpr ha.2, disjoint_compl_left⟩
  · exact ⟨Xg a, (Xg a)ᶜ, Xg_isOpen a, Xg_compl_isOpen a,
      mem_Xg.mpr ha.2, fun hc => (mem_Xg.mp hc) ha.1, disjoint_compl_right⟩

theorem totallySeparatedSpace_C' :
    @TotallySeparatedSpace (PrimeSpectrum A) (topologyC' (A := A)) := by
  refine (@totallySeparatedSpace_iff_exists_isClopen (PrimeSpectrum A)
    (topologyC' (A := A))).mpr ?_
  intro p q hpq
  obtain ⟨a, ha | ha⟩ := exists_separating hpq
  · exact ⟨(Xg a)ᶜ, Xg_compl_isClopen a, fun hc => (mem_Xg.mp hc) ha.1,
      by simpa using mem_Xg.mpr ha.2⟩
  · exact ⟨Xg a, Xg_isClopen a, mem_Xg.mpr ha.2, fun hc => (mem_Xg.mp hc) ha.1⟩

/-! ## Compactness: Exercise 3.28 (iv) -/

/-- Elements of the submonoid generated by a set meeting no prime ideal `p` are not in `p`. -/
theorem notMem_of_mem_closure_of_isPrime {p : Ideal A} (hp : p.IsPrime) {G : Set A}
    (hG : ∀ g ∈ G, g ∉ p) {x : A} (hx : x ∈ Submonoid.closure G) : x ∉ p :=
  Submonoid.closure_induction (motive := fun x _ => x ∉ p) (fun y hy => hG y hy)
    (fun h1 => hp.ne_top (Ideal.eq_top_iff_one p |>.mpr h1))
    (fun _ _ _ _ hy hz hyz => (hp.mem_or_mem hyz).elim hy hz) hx

theorem exists_finset_span_of_mem_span {H : Set A} {x : A} (hx : x ∈ Ideal.span H) :
    ∃ H₀ : Finset A, (↑H₀ : Set A) ⊆ H ∧ x ∈ Ideal.span (↑H₀ : Set A) := by
  classical
  refine Submodule.span_induction (p := fun x _ => ∃ H₀ : Finset A, (↑H₀ : Set A) ⊆ H ∧
    x ∈ Ideal.span (↑H₀ : Set A)) ?_ ?_ ?_ ?_ hx
  · intro y hy
    exact ⟨{y}, by simpa using hy, Ideal.subset_span (by simp)⟩
  · exact ⟨∅, by simp, Ideal.zero_mem _⟩
  · rintro y z _ _ ⟨H₁, h₁, hy⟩ ⟨H₂, h₂, hz⟩
    refine ⟨H₁ ∪ H₂, ?_, ?_⟩
    · intro w hw
      rcases Finset.mem_union.mp hw with h | h
      · exact h₁ h
      · exact h₂ h
    · exact Ideal.add_mem _ (Ideal.span_mono (by simp) hy) (Ideal.span_mono (by simp) hz)
  · rintro a y _ ⟨H₁, h₁, hy⟩
    exact ⟨H₁, h₁, Ideal.mul_mem_left _ a hy⟩

theorem exists_finset_closure_of_mem_closure {G : Set A} {x : A}
    (hx : x ∈ Submonoid.closure G) :
    ∃ G₀ : Finset A, (↑G₀ : Set A) ⊆ G ∧ x ∈ Submonoid.closure (↑G₀ : Set A) := by
  classical
  refine Submonoid.closure_induction (motive := fun x _ => ∃ G₀ : Finset A, (↑G₀ : Set A) ⊆ G ∧
    x ∈ Submonoid.closure (↑G₀ : Set A)) ?_ ?_ ?_ hx
  · intro y hy
    exact ⟨{y}, by simpa using hy, Submonoid.subset_closure (by simp)⟩
  · exact ⟨∅, by simp, Submonoid.one_mem _⟩
  · rintro y z _ _ ⟨G₁, h₁, hy⟩ ⟨G₂, h₂, hz⟩
    refine ⟨G₁ ∪ G₂, ?_, ?_⟩
    · intro w hw
      rcases Finset.mem_union.mp hw with h | h
      · exact h₁ h
      · exact h₂ h
    · exact Submonoid.mul_mem _ (Submonoid.closure_mono (by simp) hy)
        (Submonoid.closure_mono (by simp) hz)

/-- The finite intersection property criterion for the subbasis of `C'`: a family of subbasic
sets with the finite intersection property has nonempty intersection (Alexander's subbasis
theorem for the constructible topology). -/
theorem sInter_nonempty_of_fip (P : Set (Set (PrimeSpectrum A)))
    (hP : P ⊆ subbasisC' (A := A))
    (hfin : ∀ Q ⊆ P, Q.Finite → (⋂₀ Q).Nonempty) :
    (⋂₀ P).Nonempty := by
  have hFIP : ∀ (G₀ H₀ : Finset A), (↑G₀ : Set A) ⊆ {g | Xg g ∈ P} →
      (↑H₀ : Set A) ⊆ {h | (Xg h)ᶜ ∈ P} →
      ∃ p : PrimeSpectrum A, (∀ h ∈ H₀, h ∈ p.asIdeal) ∧ (∀ g ∈ G₀, g ∉ p.asIdeal) := by
    intro G₀ H₀ hG₀ hH₀
    have hQfin : (Xg '' (↑G₀ : Set A) ∪ (fun g => (Xg g)ᶜ) '' (↑H₀ : Set A)).Finite :=
      (G₀.finite_toSet.image _).union (H₀.finite_toSet.image _)
    have hQP : (Xg '' (↑G₀ : Set A) ∪ (fun g => (Xg g)ᶜ) '' (↑H₀ : Set A)) ⊆ P := by
      rintro s (⟨g, hg, rfl⟩ | ⟨h, hh, rfl⟩)
      · exact hG₀ hg
      · exact hH₀ hh
    obtain ⟨p, hp⟩ := hfin _ hQP hQfin
    refine ⟨p, ?_, ?_⟩
    · intro h hh
      have hmem : (Xg h)ᶜ ∈ (Xg '' (↑G₀ : Set A) ∪ (fun g => (Xg g)ᶜ) '' (↑H₀ : Set A)) :=
        Or.inr ⟨h, hh, rfl⟩
      have hnot : p ∉ Xg h := (Set.mem_sInter.mp hp) _ hmem
      by_contra hc
      exact hnot (mem_Xg.mpr hc)
    · intro g gg
      have hmem : Xg g ∈ (Xg '' (↑G₀ : Set A) ∪ (fun g => (Xg g)ᶜ) '' (↑H₀ : Set A)) :=
        Or.inl ⟨g, gg, rfl⟩
      exact mem_Xg.mp ((Set.mem_sInter.mp hp) _ hmem)
  have hdisj : Disjoint ((Ideal.span {h | (Xg h)ᶜ ∈ P} : Ideal A) : Set A)
      ((Submonoid.closure {g | Xg g ∈ P} : Submonoid A) : Set A) := by
    rw [Set.disjoint_left]
    intro x hxH hxG
    obtain ⟨H₀, hH₀, hxH₀⟩ := exists_finset_span_of_mem_span hxH
    obtain ⟨G₀, hG₀, hxG₀⟩ := exists_finset_closure_of_mem_closure hxG
    obtain ⟨p, hp⟩ := hFIP G₀ H₀ hG₀ hH₀
    have hspan_le : (Ideal.span (↑H₀ : Set A)) ≤ p.asIdeal :=
      Ideal.span_le.mpr (fun h hh => hp.1 h hh)
    exact (notMem_of_mem_closure_of_isPrime p.isPrime (fun g gg => hp.2 g gg) hxG₀)
      (hspan_le hxH₀)
  obtain ⟨p, hp_prime, hp_le, hp_disj⟩ :=
    Ideal.exists_le_prime_disjoint (I := Ideal.span {h | (Xg h)ᶜ ∈ P})
      (Submonoid.closure {g | Xg g ∈ P}) hdisj
  refine ⟨⟨p, hp_prime⟩, ?_⟩
  rw [Set.mem_sInter]
  intro s hs
  rcases hP hs with ⟨g, rfl⟩ | ⟨h, rfl⟩
  · have hg : g ∈ (Submonoid.closure {g | Xg g ∈ P} : Set A) := Submonoid.subset_closure hs
    exact mem_Xg.mpr (Set.disjoint_right.mp hp_disj hg)
  · have hh : h ∈ (Ideal.span {h | (Xg h)ᶜ ∈ P} : Set A) := Ideal.subset_span hs
    have hmem : h ∈ p := hp_le hh
    exact fun hc => hc hmem

/-- **Exercise 3.28 (iv)**, quasi-compactness: `X_{C'}` is compact. -/
theorem compactSpace_C' : @CompactSpace (PrimeSpectrum A) (topologyC' (A := A)) :=
  compactSpace_generateFrom_of_compl_mem (T := topologyC' (A := A)) (subbasisC' (A := A)) rfl
    (fun s hs => subbasisC'_compl (s := s) hs)
    (fun P hP hfin => sInter_nonempty_of_fip P hP hfin)

/-- **Exercise 3.28 (iv)**: `X_{C'}` is totally disconnected. -/
theorem totallyDisconnectedSpace_C' :
    @TotallyDisconnectedSpace (PrimeSpectrum A) (topologyC' (A := A)) :=
  @TotallySeparatedSpace.totallyDisconnectedSpace _ (topologyC' (A := A))
    (totallySeparatedSpace_C' (A := A))

/-! ## The topology `C` of Exercise 3.27 and Exercise 3.28 (iii) -/

/-- The subsets of `Spec A` of the form `f^*(Spec B)`: these are the closed sets of the
constructible topology of Exercise 3.27. -/
def imageFamily : Set (Set (PrimeSpectrum A)) :=
  {s | ∃ (B : Type u) (_ : CommRing B) (f : A →+* B),
      s = Set.range (PrimeSpectrum.comap f)}

/-- The topology `C` of Exercise 3.27 (iii): the coarsest topology in which every set of the
form `f^*(Spec B)` is closed. -/
@[instance_reducible]
def topologyC : TopologicalSpace (PrimeSpectrum A) :=
  TopologicalSpace.generateFrom {s | sᶜ ∈ imageFamily (A := A)}

theorem Xg_mem_imageFamily (g : A) : Xg g ∈ imageFamily (A := A) := by
  refine ⟨Localization.Away g, inferInstance, algebraMap A (Localization.Away g), ?_⟩
  rw [Xg]
  exact (PrimeSpectrum.localization_away_comap_range (Localization.Away g) g).symm

theorem zeroLocus_mem_imageFamily (g : A) : zeroLocus {g} ∈ imageFamily (A := A) := by
  refine ⟨A ⧸ Ideal.span {g}, inferInstance, Ideal.Quotient.mk (Ideal.span {g}), ?_⟩
  rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker, zeroLocus_span]

/-- `f^* : Spec B → Spec A` is continuous for the topology `C'`. -/
theorem continuous_comap_C' {B : Type u} [CommRing B] (f : A →+* B) :
    Continuous[topologyC' (A := B), topologyC' (A := A)] (PrimeSpectrum.comap f) := by
  rw [show topologyC' (A := B) = TopologicalSpace.generateFrom (subbasisC' (A := B)) from rfl]
  rw [continuous_generateFrom_iff]
  have hpre : ∀ a : A, (PrimeSpectrum.comap f) ⁻¹' Xg a = Xg (f a) := by
    intro a
    ext p
    rw [Set.mem_preimage, mem_Xg, mem_Xg, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
  intro s hs
  rcases hs with ⟨a, rfl⟩ | ⟨a, rfl⟩
  · rw [hpre a]
    exact Xg_isOpen (A := B) (f a)
  · rw [Set.preimage_compl, hpre a]
    exact Xg_compl_isOpen (A := B) (f a)

/-- Every set of the form `f^*(Spec B)` is closed in the topology `C'`: one half of the
description of the closed sets in Exercise 3.28 (iii). -/
theorem imageFamily_isClosed_C' {E : Set (PrimeSpectrum A)} (hE : E ∈ imageFamily (A := A)) :
    IsClosed[topologyC' (A := A)] E := by
  obtain ⟨B, hB, f, rfl⟩ := hE
  letI := hB
  letI tB : TopologicalSpace (PrimeSpectrum B) := topologyC' (A := B)
  letI tA : TopologicalSpace (PrimeSpectrum A) := topologyC' (A := A)
  haveI : CompactSpace (PrimeSpectrum B) := compactSpace_C' (A := B)
  haveI : T2Space (PrimeSpectrum A) := t2Space_C' (A := A)
  exact IsCompact.isClosed (isCompact_range (continuous_comap_C' (A := A) (B := B) f))

/-- Each set of the form `f^*(Spec B)` generates an open set of `C` (its complement). -/
theorem imageFamily_compl_isOpen_C {E : Set (PrimeSpectrum A)} (hE : E ∈ imageFamily (A := A)) :
    IsOpen[topologyC (A := A)] Eᶜ := by
  refine TopologicalSpace.isOpen_generateFrom_of_mem ?_
  simpa using hE

theorem topologyC_le_topologyC' : topologyC (A := A) ≤ topologyC' (A := A) := by
  show TopologicalSpace.generateFrom {s | sᶜ ∈ imageFamily (A := A)} ≤ topologyC' (A := A)
  rw [show topologyC' (A := A) = TopologicalSpace.generateFrom (subbasisC' (A := A)) from rfl,
    TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s (⟨g, rfl⟩ | ⟨g, rfl⟩)
  · have hE : zeroLocus {g} ∈ imageFamily (A := A) := zeroLocus_mem_imageFamily g
    simpa [Xg_eq_compl_zeroLocus] using imageFamily_compl_isOpen_C hE
  · exact TopologicalSpace.isOpen_generateFrom_of_mem (by simpa using Xg_mem_imageFamily g)

theorem topologyC'_le_topologyC : topologyC' (A := A) ≤ topologyC (A := A) := by
  show topologyC' (A := A) ≤ TopologicalSpace.generateFrom {s | sᶜ ∈ imageFamily (A := A)}
  rw [TopologicalSpace.le_def]
  letI t : TopologicalSpace (PrimeSpectrum A) := topologyC' (A := A)
  intro U hU
  induction hU with
  | basic s hs =>
      obtain ⟨B, hB, f, hEq⟩ := hs
      have hclosed : IsClosed (Set.range (PrimeSpectrum.comap f)) :=
        imageFamily_isClosed_C' (A := A) ⟨B, hB, f, rfl⟩
      have hs' : s = (Set.range (PrimeSpectrum.comap f))ᶜ := by
        rw [← hEq, compl_compl]
      rw [hs']
      exact hclosed.isOpen_compl
  | univ => exact isOpen_univ
  | inter s t _ _ ihs iht => exact ihs.inter iht
  | sUnion S _ ih => exact isOpen_sUnion ih

/-- **Exercise 3.28 (iii)**: the topology `C` of Exercise 3.27 and the topology `C'` of
Exercise 3.28 (ii) coincide; equivalently the identity map `X_C → X_{C'}` is a
homeomorphism. -/
theorem topologyC_eq_topologyC' : topologyC (A := A) = topologyC' (A := A) :=
  le_antisymm topologyC_le_topologyC' topologyC'_le_topologyC

/-- The identity map `X_C → X_{C'}`, which is a homeomorphism by `topologyC_eq_topologyC'`. -/
def identityHomeomorph :
    @Homeomorph (PrimeSpectrum A) (PrimeSpectrum A) (topologyC (A := A))
      (topologyC' (A := A)) := by
  rw [topologyC_eq_topologyC']
  exact @Homeomorph.refl (PrimeSpectrum A) (topologyC' (A := A))

/-! ## The converse: every `C'`-closed set is `f^*(Spec B)`

The construction is the product of the residue fields of the points of `E`:
`B = ∏_{q ∈ E} Frac(A/q)`. Its spectrum maps onto `Spec A` with image exactly `E`. -/

/-- The basic clopens of `C'`: `V(H) ∩ D(g)` for a finite set `H ⊆ A`. -/
def basicClopen (H : Finset A) (g : A) : Set (PrimeSpectrum A) :=
  zeroLocus (↑H : Set A) ∩ Xg g

theorem mem_basicClopen {H : Finset A} {g : A} {p : PrimeSpectrum A} :
    p ∈ basicClopen H g ↔ (↑H : Set A) ⊆ p.asIdeal ∧ g ∉ p.asIdeal := by
  rw [basicClopen, Set.mem_inter_iff, PrimeSpectrum.mem_zeroLocus, mem_Xg]

theorem Xg_one : Xg (1 : A) = Set.univ := by
  ext p
  rw [mem_Xg]
  exact ⟨fun _ => Set.mem_univ p, fun _ h =>
    p.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h)⟩

theorem Xg_eq_basicClopen (g : A) : Xg g = basicClopen ∅ g := by
  ext p
  rw [mem_basicClopen, mem_Xg]
  simp

theorem Xg_compl_eq_zeroLocus (g : A) : (Xg g)ᶜ = zeroLocus {g} := by
  rw [Xg_eq_compl_zeroLocus, compl_compl]

theorem zeroLocus_singleton_eq_basicClopen (g : A) : zeroLocus {g} = basicClopen {g} 1 := by
  rw [basicClopen, Xg_one, Set.inter_univ, Finset.coe_singleton]

theorem basicClopen_empty_one : basicClopen (∅ : Finset A) 1 = Set.univ :=
  (Xg_eq_basicClopen 1).symm.trans Xg_one

theorem basicClopen_inter [DecidableEq A] (H₁ H₂ : Finset A) (g₁ g₂ : A) :
    basicClopen H₁ g₁ ∩ basicClopen H₂ g₂ = basicClopen (H₁ ∪ H₂) (g₁ * g₂) := by
  ext p
  rw [Set.mem_inter_iff, mem_basicClopen, mem_basicClopen, mem_basicClopen]
  constructor
  · rintro ⟨⟨h₁, hg₁⟩, h₂, hg₂⟩
    refine ⟨fun a ha => ?_, fun hgg => ?_⟩
    · rcases Finset.mem_union.mp ha with h | h
      · exact h₁ h
      · exact h₂ h
    · exact (p.isPrime.mem_or_mem hgg).elim hg₁ hg₂
  · rintro ⟨hH, hg⟩
    refine ⟨⟨fun a ha => hH (Finset.mem_union_left _ ha), fun hg₁ => hg ?_⟩,
      ⟨fun a ha => hH (Finset.mem_union_right _ ha), fun hg₂ => hg ?_⟩⟩
    · have h := Ideal.mul_mem_left p.asIdeal g₂ hg₁
      rwa [mul_comm] at h
    · exact Ideal.mul_mem_left p.asIdeal g₁ hg₂

/-- Every point of an open set of `C'` admits a basic clopen neighbourhood inside it. -/
theorem exists_basicClopen_of_isOpen [DecidableEq A] {U : Set (PrimeSpectrum A)}
    (hU : IsOpen[topologyC' (A := A)] U) :
    ∀ p ∈ U, ∃ (H : Finset A) (g : A), p ∈ basicClopen H g ∧ basicClopen H g ⊆ U := by
  induction hU with
  | basic s hs =>
      intro p hp
      rcases hs with ⟨g, rfl⟩ | ⟨g, rfl⟩
      · exact ⟨∅, g, by rw [← Xg_eq_basicClopen]; exact hp,
          by rw [← Xg_eq_basicClopen]⟩
      · refine ⟨{g}, 1, ?_, ?_⟩
        · simpa [← zeroLocus_singleton_eq_basicClopen, ← Xg_compl_eq_zeroLocus] using hp
        · intro x hx
          simpa [← zeroLocus_singleton_eq_basicClopen, ← Xg_compl_eq_zeroLocus] using hx
  | univ =>
      intro p _
      exact ⟨∅, 1, by simp [basicClopen_empty_one], by simp [basicClopen_empty_one]⟩
  | inter s t _ _ ihs iht =>
      intro p hp
      obtain ⟨H₁, g₁, hp₁, h₁⟩ := ihs p hp.1
      obtain ⟨H₂, g₂, hp₂, h₂⟩ := iht p hp.2
      exact ⟨H₁ ∪ H₂, g₁ * g₂, by rw [← basicClopen_inter]; exact ⟨hp₁, hp₂⟩,
        by rw [← basicClopen_inter]; exact Set.inter_subset_inter h₁ h₂⟩
  | sUnion S _ ih =>
      intro p hp
      obtain ⟨s, hsS, hps⟩ := Set.mem_sUnion.mp hp
      obtain ⟨H, g, hpB, hsub⟩ := ih s hsS p hps
      exact ⟨H, g, hpB, fun x hx => Set.mem_sUnion.mpr ⟨s, hsS, hsub hx⟩⟩

/-- The product of the residue fields of the primes belonging to `E ⊆ Spec A`. -/
noncomputable abbrev residuePi (E : Set (PrimeSpectrum A)) : Type u :=
  ∀ q : E, FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)

/-- The canonical ring homomorphism `A → ∏_{q ∈ E} k(q)`. -/
noncomputable def residuePiHom (E : Set (PrimeSpectrum A)) : A →+* residuePi E where
  toFun a := fun q => algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
    (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) (Ideal.Quotient.mk _ a)
  map_one' := by funext q; simp
  map_mul' a b := by funext q; simp
  map_zero' := by funext q; simp
  map_add' a b := by funext q; simp

theorem residuePiHom_apply (E : Set (PrimeSpectrum A)) (a : A) (q : E) :
    residuePiHom E a q = algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
      (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) (Ideal.Quotient.mk _ a) := rfl

/-- Points of `E` lie in the image of `Spec (∏_{q ∈ E} k(q)) → Spec A`: project to the
`p`-th residue field. -/
theorem mem_range_of_mem {E : Set (PrimeSpectrum A)} {p : PrimeSpectrum A} (hp : p ∈ E) :
    p ∈ Set.range (PrimeSpectrum.comap (residuePiHom E)) := by
  haveI : (p.asIdeal).IsPrime := p.isPrime
  let ev : residuePi E →+* FractionRing (A ⧸ p.asIdeal) :=
    Pi.evalRingHom (fun q : E => FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) ⟨p, hp⟩
  refine ⟨⟨RingHom.ker ev, RingHom.ker_isPrime ev⟩, ?_⟩
  rw [PrimeSpectrum.ext_iff, PrimeSpectrum.comap_asIdeal]
  ext a
  rw [Ideal.mem_comap, RingHom.mem_ker]
  show (residuePiHom E a) ⟨p, hp⟩ = 0 ↔ a ∈ p.asIdeal
  rw [residuePiHom_apply]
  constructor
  · intro h0
    have hinj := IsFractionRing.injective (A ⧸ p.asIdeal) (FractionRing (A ⧸ p.asIdeal))
    have h1 : Ideal.Quotient.mk p.asIdeal a = 0 := hinj (by rw [h0, map_zero])
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  · intro ha
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]

/-- Points outside `E` are not in the image: use a basic clopen separating `p` from `E` and a
partition of unity in the residue fields of `E`. -/
theorem not_mem_range_of_not_mem {E : Set (PrimeSpectrum A)}
    (hE : IsClosed[topologyC' (A := A)] E) {p : PrimeSpectrum A} (hp : p ∉ E) :
    p ∉ Set.range (PrimeSpectrum.comap (residuePiHom E)) := by
  classical
  rintro ⟨Q, hQ⟩
  obtain ⟨H, g, hpB, hBsub⟩ :=
    exists_basicClopen_of_isOpen (A := A) hE.isOpen_compl p (by simpa using hp)
  rw [mem_basicClopen] at hpB
  obtain ⟨hHp, hgp⟩ := hpB
  -- for each `q ∈ E`, pick `h ∈ H` with `h ∉ q` whenever such an `h` exists
  set choice : ∀ q : E, ((∃ h' ∈ H, h' ∉ (q : PrimeSpectrum A).asIdeal) → A) :=
    fun q hex => Classical.choose hex with hchoice
  have choice_spec : ∀ (q : E) (hex : ∃ h' ∈ H, h' ∉ (q : PrimeSpectrum A).asIdeal),
      choice q hex ∈ H ∧ choice q hex ∉ (q : PrimeSpectrum A).asIdeal :=
    fun q hex => Classical.choose_spec hex
  -- the partition of unity in the residue fields of the points of `E`
  set b : A → residuePi E := fun h q =>
    if hex : ∃ h' ∈ H, h' ∉ (q : PrimeSpectrum A).asIdeal then
      if h = choice q hex then
        algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
            (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) g /
          algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
            (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) h
      else 0
    else 0 with hb
  have key : residuePiHom E g = ∑ h ∈ H, residuePiHom E h * b h := by
    funext q
    rw [Finset.sum_apply]
    by_cases hex : ∃ h' ∈ H, h' ∉ (q : PrimeSpectrum A).asIdeal
    · obtain ⟨hspecH, hspecq⟩ := choice_spec q hex
      rw [Finset.sum_eq_single (choice q hex)]
      · have hbq : b (choice q hex) q =
            algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
                (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) g /
              algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
                (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) (choice q hex) := by
          rw [hb]
          simp only [dif_pos hex, if_true]
        rw [Pi.mul_apply, hbq, residuePiHom_apply, residuePiHom_apply]
        haveI : (q : PrimeSpectrum A).asIdeal.IsPrime := (q : PrimeSpectrum A).isPrime
        have hinj := IsFractionRing.injective (A ⧸ (q : PrimeSpectrum A).asIdeal)
          (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal))
        have hne : algebraMap (A ⧸ (q : PrimeSpectrum A).asIdeal)
            (FractionRing (A ⧸ (q : PrimeSpectrum A).asIdeal)) (choice q hex) ≠ 0 := by
          intro h0
          have h1 : Ideal.Quotient.mk ((q : PrimeSpectrum A).asIdeal) (choice q hex) = 0 :=
            hinj (by rw [h0, map_zero])
          exact hspecq (Ideal.Quotient.eq_zero_iff_mem.mp h1)
        rw [← mul_div_assoc, mul_div_cancel_left₀ _ hne]
      · intro h' h'H h'ne
        have h0 : b h' q = 0 := by
          simp only [hb, dif_pos hex, if_neg h'ne]
        rw [Pi.mul_apply, h0, mul_zero]
      · intro hnotin
        exact absurd hspecH hnotin
    · have hex' : ¬ ∃ h' ∈ H, h' ∉ (q : PrimeSpectrum A).asIdeal := hex
      push Not at hex
      have hgq : g ∈ (q : PrimeSpectrum A).asIdeal := by
        have hqE : (q : PrimeSpectrum A) ∈ E := q.2
        have hnotin : (q : PrimeSpectrum A) ∉ basicClopen H g := fun hc => (hBsub hc) hqE
        rw [mem_basicClopen] at hnotin
        by_contra hg
        exact hnotin ⟨fun h' h'H => hex h' h'H, hg⟩
      have hz : ∀ h ∈ H, b h q = 0 := by
        intro h _
        simp only [hb, dif_neg hex']
      rw [Finset.sum_eq_zero fun h hH => by rw [Pi.mul_apply, hz h hH, mul_zero],
        residuePiHom_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hgq, map_zero]
  -- compare with the prime `Q` of the product
  have hcomap : ∀ a : A, residuePiHom E a ∈ Q.asIdeal ↔ a ∈ p.asIdeal := by
    intro a
    have h1 : Ideal.comap (residuePiHom E) Q.asIdeal = p.asIdeal := by
      rw [← PrimeSpectrum.comap_asIdeal, hQ]
    rw [← Ideal.mem_comap, h1]
  have hsumQ : residuePiHom E g ∈ Q.asIdeal := by
    rw [key]
    refine Ideal.sum_mem _ fun h hH => ?_
    have h1 : residuePiHom E h ∈ Q.asIdeal := (hcomap h).mpr (hHp hH)
    have h2 := Ideal.mul_mem_left Q.asIdeal (b h) h1
    rwa [mul_comm] at h2
  exact hgp ((hcomap g).mp hsumQ)

/-- **Exercise 3.28 (iii)**, the converse: every set closed in `C'` is of the form
`f^*(Spec B)`. -/
theorem imageFamily_of_isClosed {E : Set (PrimeSpectrum A)}
    (hE : IsClosed[topologyC' (A := A)] E) : E ∈ imageFamily (A := A) := by
  refine ⟨residuePi E, inferInstance, residuePiHom E, ?_⟩
  ext p
  exact ⟨fun hp => mem_range_of_mem hp, fun hp => by
    by_contra hne
    exact not_mem_range_of_not_mem hE hne hp⟩

/-- **Exercise 3.28 (iii)**, second sentence: a subset `E ⊆ Spec A` is of the form
`f^*(Spec B)` if and only if it is closed in the topology `C'`. -/
theorem imageFamily_iff_isClosed (E : Set (PrimeSpectrum A)) :
    E ∈ imageFamily (A := A) ↔ IsClosed[topologyC' (A := A)] E :=
  ⟨imageFamily_isClosed_C', imageFamily_of_isClosed⟩

/-- The closed sets of the topology `C` of Exercise 3.27 (iii) are exactly the sets of the form
`f^*(Spec B)`. -/
theorem isClosed_topologyC_iff (E : Set (PrimeSpectrum A)) :
    IsClosed[topologyC (A := A)] E ↔ E ∈ imageFamily (A := A) := by
  rw [topologyC_eq_topologyC']
  exact (imageFamily_iff_isClosed E).symm

/-- Part (i) for the topology `C` itself (the book states it for the constructible topology). -/
theorem Xg_isClopen_C (g : A) : @IsClopen _ (topologyC (A := A)) (Xg g) := by
  rw [topologyC_eq_topologyC']
  exact Xg_isClopen g

/-- Part (iv) for `X_C` itself: quasi-compact. -/
theorem compactSpace_C : @CompactSpace (PrimeSpectrum A) (topologyC (A := A)) := by
  rw [topologyC_eq_topologyC']
  exact compactSpace_C'

/-- Part (iv) for `X_C` itself: Hausdorff. -/
theorem t2Space_C : @T2Space (PrimeSpectrum A) (topologyC (A := A)) := by
  rw [topologyC_eq_topologyC']
  exact t2Space_C'

/-- Part (iv) for `X_C` itself: totally disconnected. -/
theorem totallyDisconnectedSpace_C :
    @TotallyDisconnectedSpace (PrimeSpectrum A) (topologyC (A := A)) := by
  rw [topologyC_eq_topologyC']
  exact totallyDisconnectedSpace_C'

/-- **Exercise 3.28**, bundled: (i) each `X_g` is clopen in `C'` and in `C`; (ii) `X_{C'}` and
`X_C` are Hausdorff; (iii) the constructible topology `C` of Exercise 3.27 equals `C'` and the
closed sets of `C'` are exactly the sets `f^*(Spec B)`; (iv) `X_C` (and `X_{C'}`) is compact,
Hausdorff and totally disconnected. -/
theorem solution :
    (∀ g : A, @IsClopen _ (topologyC' (A := A)) (Xg g) ∧
      @IsClopen _ (topologyC (A := A)) (Xg g)) ∧
    (@T2Space (PrimeSpectrum A) (topologyC' (A := A))) ∧
    (@T2Space (PrimeSpectrum A) (topologyC (A := A))) ∧
    (@CompactSpace (PrimeSpectrum A) (topologyC' (A := A))) ∧
    (@CompactSpace (PrimeSpectrum A) (topologyC (A := A))) ∧
    (@TotallyDisconnectedSpace (PrimeSpectrum A) (topologyC' (A := A))) ∧
    (@TotallyDisconnectedSpace (PrimeSpectrum A) (topologyC (A := A))) ∧
    (topologyC (A := A) = topologyC' (A := A)) ∧
    (∀ E : Set (PrimeSpectrum A), E ∈ imageFamily (A := A) ↔
      IsClosed[topologyC' (A := A)] E) :=
  ⟨fun g => ⟨Xg_isClopen g, Xg_isClopen_C g⟩, t2Space_C', t2Space_C, compactSpace_C',
    compactSpace_C, totallyDisconnectedSpace_C', totallyDisconnectedSpace_C,
    topologyC_eq_topologyC', fun E => imageFamily_iff_isClosed E⟩

/-! ## Fidelity addition (independent audit, m3)

Exercise 3.28 (ii) *defines* `C'` as "the smallest topology on `X` for which the sets `X_g` are
both open and closed".  The formalization above takes the concrete description
(`generateFrom` of the `X_g` and their complements) as the definition and proves the Hausdorff
property, but never records that this concrete topology has the required universal property.
The lemmas below supply it: every topology in which all `X_g` are clopen is finer than `C'`.

Order convention of this Mathlib version: `t₁ ≤ t₂` means that `t₁` is *finer* than `t₂`
(`TopologicalSpace.le_def`), so the "smallest" (coarsest) topology is `IsGreatest` in Lean's
order. -/

/-- Any topology in which all `X_g` are clopen is finer than `C'`. -/
theorem le_topologyC'_of_isClopen {t : TopologicalSpace (PrimeSpectrum A)}
    (ht : ∀ g : A, @IsClopen _ t (Xg g)) : t ≤ topologyC' (A := A) := by
  rw [show topologyC' (A := A) = TopologicalSpace.generateFrom (subbasisC' (A := A)) from rfl,
    TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  rintro s (⟨g, rfl⟩ | ⟨g, rfl⟩)
  · exact (ht g).isOpen
  · exact (ht g).isClosed.isOpen_compl

/-- **Exercise 3.28 (ii)**, definition: `C'` is the smallest topology on `X` for which every
`X_g` is both open and closed. -/
theorem isGreatest_topologyC' :
    IsGreatest {t : TopologicalSpace (PrimeSpectrum A) | ∀ g : A, @IsClopen _ t (Xg g)}
      (topologyC' (A := A)) :=
  ⟨Xg_isClopen, fun _ ht => le_topologyC'_of_isClopen ht⟩

end AtiyahMcdonald69.Ex_3_28

