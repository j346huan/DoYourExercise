/-
# Atiyah–Macdonald, Exercise 5.16: Noether's normalization lemma

The exercise (M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*,
Addison-Wesley 1969, Chapter 5, Exercise 16, p. 69) reads:

  "**Noether's normalization lemma.** Let `k` be an infinite field and let `A ≠ 0` be a
  finitely generated `k`-algebra. Then there exist elements `y₁, …, y_r ∈ A` which are
  algebraically independent over `k` and such that `A` is integral over `k[y₁, …, y_r]`."

Formalization of the imported constructions:

* `A ≠ 0` is `[Nontrivial A]`;
* `A` is a finitely generated `k`-algebra is `[Algebra k A] [Algebra.FiniteType k A]`;
* `y₁, …, y_r ∈ A` is a map `Fin r → A`;
* `y₁, …, y_r` are algebraically independent over `k` is `AlgebraicIndependent k y`
  (the canonical map `k[X₁,…,X_r] → A`, `X_i ↦ y_i`, is injective);
* `k[y₁, …, y_r]` is the subalgebra `Algebra.adjoin k (Set.range y) ⊆ A`;
* `A` is integral over `k[y₁, …, y_r]` is `Algebra.IsIntegral (Algebra.adjoin k
  (Set.range y)) A`.

The main work is to pass from Noether normalization in *map* form — an injective
integral `k`-algebra homomorphism `k[X₁,…,X_s] → A` (Mathlib's
`exists_integral_inj_algHom_of_fg`, the Stacks project's Lemma 00OW) — to the *element*
form stated in the book, where the polynomial variables are required to have
algebraically independent images and `A` must be integral over the subalgebra they
generate.  This is done in `algebraicIndependent_of_injective_aeval` and
`isIntegral_of_isIntegral_map` below, and the two are combined in
`exists_algIndep_isIntegral`.
-/
import Mathlib.RingTheory.NoetherNormalization
import Mathlib.RingTheory.AlgebraicIndependent.Basic

namespace AtiyahMcdonald69.Ex_5_16

open MvPolynomial

/-! ## Algebraic independence and integrality, transported from map form -/

/-- If an algebra map `g : k[X_i : i ∈ ι] → A` is injective, then the family
`i ↦ g (X i)` is algebraically independent over `k`.  (Algebraic independence of a
family is, by definition, the injectivity of its evaluation map
`algebraicIndependent_iff_injective_aeval`, and `aeval (fun i => g (X i)) = g`.) -/
theorem algebraicIndependent_of_injective_aeval {k A : Type*} [Field k] [CommRing A]
    [Algebra k A] {ι : Type*} {g : MvPolynomial ι k →ₐ[k] A} (hg : Function.Injective g) :
    AlgebraicIndependent k fun i => g (X i) := by
  rw [algebraicIndependent_iff_injective_aeval]
  have h : (MvPolynomial.aeval fun i => g (X i) : MvPolynomial ι k →ₐ[k] A) = g := by
    ext i
    simp
  rw [h]
  exact hg

/-- If an algebra map `g : k[X_i : i ∈ ι] → A` is integral (every element of `A` satisfies
a monic polynomial equation with coefficients in the image of `g`), then `A` is integral
over the subalgebra `k[g (X_i)] ⊆ A` generated by the images of the variables.

Indeed, a monic polynomial `p` over `k[X_i]` with `p a = 0` is turned into a monic
polynomial over `k[g (X_i)]` by mapping its coefficients along the factorization
`k[X_i] → k[g (X_i)]` of `g`; evaluation is unchanged because that factorization
followed by the inclusion of the subalgebra is `g`. -/
theorem isIntegral_of_isIntegral_map {k A : Type*} [Field k] [CommRing A] [Algebra k A]
    {ι : Type*} {g : MvPolynomial ι k →ₐ[k] A} (hg : g.IsIntegral) :
    Algebra.IsIntegral (Algebra.adjoin k (Set.range fun i => g (X i))) A := by
  classical
  refine ⟨fun a => ?_⟩
  obtain ⟨p, hpmonic, hpeval⟩ := hg a
  set S : Subalgebra k A := Algebra.adjoin k (Set.range fun i => g (X i)) with hS
  have hxS : ∀ i, g (X i) ∈ S := fun i => Algebra.subset_adjoin (Set.mem_range_self i)
  -- the factorization of `g` through the subalgebra generated by the images
  set ψ : MvPolynomial ι k →ₐ[k] S := MvPolynomial.aeval fun i => ⟨g (X i), hxS i⟩ with hψdef
  have hψ : S.val.comp ψ = g := by
    ext i
    simp [hψdef]
  refine ⟨p.map (ψ : MvPolynomial ι k →+* S),
    Polynomial.Monic.map (ψ : MvPolynomial ι k →+* S) hpmonic, ?_⟩
  have halg : (algebraMap S A : S →+* A) = (S.val : S →+* A) := by
    rw [Subalgebra.algebraMap_eq]
    ext x
    simp
  have hcomp : ((algebraMap S A : S →+* A).comp (ψ : MvPolynomial ι k →+* S))
      = (g : MvPolynomial ι k →+* A) := by
    refine RingHom.ext fun q => ?_
    rw [RingHom.comp_apply, halg]
    exact DFunLike.congr_fun hψ q
  rw [Polynomial.eval₂_map, hcomp]
  exact hpeval

/-! ## Noether normalization in the form of Exercise 5.16 -/

/-- **Noether normalization, element form** (for an arbitrary field `k`): for a nonzero
finitely generated `k`-algebra `A` there are elements `y : Fin r → A`, algebraically
independent over `k`, such that `A` is integral over `k[y]`.

This is obtained from Mathlib's Noether normalization in map form
(`exists_integral_inj_algHom_of_fg`, Stacks 00OW) by the two transport lemmas above.
No infiniteness of `k` is needed; see `noether_normalization` for the statement with
precisely the hypotheses of Atiyah–Macdonald. -/
theorem exists_algIndep_isIntegral (k A : Type*) [Field k] [CommRing A] [Nontrivial A]
    [Algebra k A] [Algebra.FiniteType k A] :
    ∃ (r : ℕ) (y : Fin r → A), AlgebraicIndependent k y ∧
      Algebra.IsIntegral (Algebra.adjoin k (Set.range y)) A := by
  obtain ⟨s, g, hginj, hgint⟩ := exists_integral_inj_algHom_of_fg k A
  exact ⟨s, fun i => g (X i), algebraicIndependent_of_injective_aeval hginj,
    isIntegral_of_isIntegral_map hgint⟩

/-- **Atiyah–Macdonald, Exercise 5.16 (Noether's normalization lemma).**
Let `k` be an infinite field and let `A ≠ 0` be a finitely generated `k`-algebra.
Then there exist elements `y₁, …, y_r ∈ A` which are algebraically independent over `k`
and such that `A` is integral over `k[y₁, …, y_r]`. -/
theorem noether_normalization (k A : Type*) [Field k] [Infinite k] [CommRing A]
    [Nontrivial A] [Algebra k A] [Algebra.FiniteType k A] :
    ∃ (r : ℕ) (y : Fin r → A), AlgebraicIndependent k y ∧
      Algebra.IsIntegral (Algebra.adjoin k (Set.range y)) A :=
  exists_algIndep_isIntegral k A

/-- Noether normalization with the hypotheses of Exercise 5.16 weakened: the assumption
that `k` is infinite is not needed (the finite field case is due to Akizuki and Nagata;
Mathlib's proof of the map form `exists_integral_inj_algHom_of_fg` covers all fields).
The assumption `A ≠ 0`, on the other hand, cannot be dropped; see
`nontrivial_of_algebraicIndependent`. -/
theorem noether_normalization_of_arbitrary_field (k A : Type*) [Field k] [CommRing A]
    [Nontrivial A] [Algebra k A] [Algebra.FiniteType k A] :
    ∃ (r : ℕ) (y : Fin r → A), AlgebraicIndependent k y ∧
      Algebra.IsIntegral (Algebra.adjoin k (Set.range y)) A :=
  exists_algIndep_isIntegral k A

/-- **Quantitative form of Noether normalization**, following the induction on the number
of generators used in the hint to Exercise 5.16: if `A` is generated as a `k`-algebra by
`n` elements `y : Fin n → A`, then the algebraically independent elements over which `A`
is integral can be chosen with `r ≤ n`.

This is proved from the quantitative map form
`exists_integral_inj_algHom_of_quotient` (Mathlib), by writing `A` as a quotient
`k[X₁,…,X_n] ⧸ ker (aeval y)` of the polynomial ring on the given generators. -/
theorem exists_algIndep_isIntegral_of_adjoin_eq_top (k A : Type*) [Field k] [CommRing A]
    [Nontrivial A] [Algebra k A] {n : ℕ} (y : Fin n → A)
    (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    ∃ (r : ℕ) (x : Fin r → A), r ≤ n ∧ AlgebraicIndependent k x ∧
      Algebra.IsIntegral (Algebra.adjoin k (Set.range x)) A := by
  classical
  set φ : MvPolynomial (Fin n) k →ₐ[k] A := MvPolynomial.aeval y with hφ
  have hsurj : Function.Surjective φ := by
    have hle : (⊤ : Subalgebra k A) ≤ φ.range := by
      rw [← hy]
      refine Algebra.adjoin_le ?_
      rintro a ⟨i, rfl⟩
      exact ⟨MvPolynomial.X i, by simp [hφ]⟩
    intro a
    exact hle (by simp)
  have hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* A) ≠ ⊤ := by
    intro h
    have hmem : (1 : MvPolynomial (Fin n) k) ∈
        RingHom.ker (φ : MvPolynomial (Fin n) k →+* A) := by
      rw [h]
      simp
    rw [RingHom.mem_ker] at hmem
    have h2 : (1 : A) = 0 := by
      rw [← hmem]
      simp
    exact one_ne_zero h2
  obtain ⟨s, hs, g, hginj, hgint⟩ :=
    exists_integral_inj_algHom_of_quotient (RingHom.ker φ) hker
  set e : (MvPolynomial (Fin n) k ⧸ RingHom.ker φ) ≃ₐ[k] A :=
    Ideal.quotientKerAlgEquivOfSurjective hsurj
  refine ⟨s, fun i => e (g (MvPolynomial.X i)), hs, ?_, ?_⟩
  · exact algebraicIndependent_of_injective_aeval (g := e.toAlgHom.comp g) (e.injective.comp hginj)
  · exact isIntegral_of_isIntegral_map (g := e.toAlgHom.comp g)
      (hgint.trans _ _ (RingHom.isIntegral_of_surjective _ e.surjective))

/-- The restriction `A ≠ 0` in Exercise 5.16 is necessary: in the zero ring no family
(not even the empty one) is algebraically independent over a field, since the evaluation
map `k[X_i] → A` would send the distinct elements `1` and `0` to the same element. -/
theorem not_algebraicIndependent_of_subsingleton {k A : Type*} [Field k] [CommRing A]
    [Algebra k A] [Subsingleton A] {ι : Type*} (y : ι → A) :
    ¬ AlgebraicIndependent k y := by
  intro h
  rw [algebraicIndependent_iff_injective_aeval] at h
  have h10 : (MvPolynomial.aeval y : MvPolynomial ι k →ₐ[k] A) 1
      = (MvPolynomial.aeval y : MvPolynomial ι k →ₐ[k] A) 0 := by
    rw [map_one, map_zero]
    exact Subsingleton.elim _ _
  have hone : (1 : MvPolynomial ι k) = 0 := h h10
  exact one_ne_zero hone

/-- Consequently, the hypothesis `A ≠ 0` is forced by the conclusion of Exercise 5.16. -/
theorem nontrivial_of_algebraicIndependent {k A : Type*} [Field k] [CommRing A]
    [Algebra k A] {ι : Type*} {y : ι → A} (h : AlgebraicIndependent k y) :
    Nontrivial A := by
  by_contra hA
  have hsub : Subsingleton A := not_nontrivial_iff_subsingleton.mp hA
  rw [algebraicIndependent_iff_injective_aeval] at h
  have h10 : (MvPolynomial.aeval y : MvPolynomial ι k →ₐ[k] A) 1
      = (MvPolynomial.aeval y : MvPolynomial ι k →ₐ[k] A) 0 := by
    rw [map_one, map_zero]
    exact hsub.elim _ _
  have hone : (1 : MvPolynomial ι k) = 0 := h h10
  exact one_ne_zero hone

#print axioms exists_algIndep_isIntegral
#print axioms exists_algIndep_isIntegral_of_adjoin_eq_top
#print axioms noether_normalization
#print axioms noether_normalization_of_arbitrary_field

end AtiyahMcdonald69.Ex_5_16
