import Mathlib

/-!
# Atiyah–Macdonald (1969), Chapter 7, Exercise 11

The exercise asks: *let `A` be a ring such that each local ring `A_p` (the localization of `A` at a
prime ideal `p`) is Noetherian. Must `A` itself be Noetherian?*

The answer is **no**.  We formalize the counterexample given in the exercise: the Boolean ring
`A = ∏_{n ∈ ℕ} 𝔽₂`.  The explicitly named constructions are

* `A := ℕ → ZMod 2`, the (internal) direct product of countably many copies of `𝔽₂`,
* `e n`, the element that is `1` in coordinate `n` and `0` elsewhere (`eₙ` in the exercise),
* `I n := (e 0, …, e (n-1))`, the ideals `(e₁) ⊊ (e₁, e₂) ⊊ ⋯` of the exercise.

We then prove

* `I n < I (n+1)` for every `n`, so the ascending chain never stabilizes and `A` is not Noetherian
  (`not_isNoetherianRing`);
* every localization `A_p` at a prime ideal is Noetherian: `A` is Boolean, hence so is `A_p`, and a
  local ring has no nontrivial idempotents (Exercise 1.12), so every element of `A_p` is `0` or `1`;
  in particular `A_p` is a field and therefore Noetherian (`isNoetherianRing_atPrime`).  The
  isomorphism `A_p ≅ 𝔽₂` is made explicit as the ring equivalence `equivZMod2`.

Natural-language proof: https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-11
-/

namespace AtiyahMcdonald69.Ex_7_11

open scoped Classical

/-- The counterexample ring: the direct product of countably many copies of `𝔽₂`. -/
abbrev A : Type := ℕ → ZMod 2

/-- `𝔽₂` is Boolean: every element is idempotent. -/
theorem zmod2_mul_self (a : ZMod 2) : a * a = a := by
  fin_cases a <;> rfl

/-- The only elements of `𝔽₂` are `0` and `1`. -/
theorem zmod2_eq_zero_or_eq_one (n : ZMod 2) : n = 0 ∨ n = 1 := by
  have h : n.val < 2 := ZMod.val_lt n
  have h' : n.val = 0 ∨ n.val = 1 := by omega
  rcases h' with h0 | h1
  · left
    rw [← ZMod.natCast_zmod_val n, h0]
    simp
  · right
    rw [← ZMod.natCast_zmod_val n, h1]
    norm_num

/-- The ring `A = ∏_{n ∈ ℕ} 𝔽₂` is Boolean. -/
theorem mul_self (x : A) : x * x = x := by
  funext i
  exact zmod2_mul_self (x i)

/-- `e n` is `1` in coordinate `n` and `0` elsewhere: the idempotent `eₙ` of the exercise. -/
def e (n : ℕ) : A := Pi.single n 1

@[simp]
theorem e_self (n : ℕ) : e n n = 1 := Pi.single_eq_same n 1

theorem e_of_ne {m n : ℕ} (h : m ≠ n) : e n m = 0 := Pi.single_eq_of_ne h 1

/-- The ideal `(e 0, …, e (n-1))` of the exercise.  The exercise lists them as
`(e₁) ⊊ (e₁, e₂) ⊊ ⋯`. -/
noncomputable def I (n : ℕ) : Ideal A := Ideal.span (Set.range fun k : Fin n => e k)

theorem I_le_I {m n : ℕ} (hmn : m ≤ n) : I m ≤ I n := by
  apply Ideal.span_mono
  rintro _ ⟨k, rfl⟩
  exact ⟨⟨k, lt_of_lt_of_le k.isLt hmn⟩, rfl⟩

theorem monotone_I : Monotone I := fun _ _ hmn => I_le_I hmn

theorem e_mem_I_succ (n : ℕ) : e n ∈ I (n + 1) :=
  Ideal.subset_span ⟨⟨n, Nat.lt_succ_self n⟩, rfl⟩

/-- `e n` is not in the ideal generated by `e 0, …, e (n-1)`: the evaluation at the coordinate `n`
is a ring homomorphism vanishing on the generators but not on `e n`. -/
theorem e_not_mem_I (n : ℕ) : e n ∉ I n := by
  intro h
  have hle : I n ≤ RingHom.ker (Pi.evalRingHom (fun _ : ℕ => ZMod 2) n) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨k, rfl⟩
    simp [e, Pi.single_eq_of_ne (ne_of_gt k.isLt)]
  have h1 : Pi.evalRingHom (fun _ : ℕ => ZMod 2) n (e n) = 0 := hle h
  rw [Pi.evalRingHom_apply, e_self] at h1
  exact one_ne_zero h1

/-- The ideals `(e 0, …, e (n-1))` form a strictly increasing chain. -/
theorem I_lt_I_succ (n : ℕ) : I n < I (n + 1) :=
  lt_of_le_of_ne (I_le_I (Nat.le_succ n))
    (fun h => e_not_mem_I n (h ▸ e_mem_I_succ n))

/-- The chain `(e₀) ⊊ (e₀, e₁) ⊊ (e₀, e₁, e₂) ⊊ ⋯` is strictly increasing. -/
theorem strictMono_I : StrictMono I := strictMono_nat_of_lt_succ I_lt_I_succ

/-- `A = ∏_{n ∈ ℕ} 𝔽₂` is **not** a Noetherian ring: the ascending chain of ideals
`(e₁) ⊊ (e₁, e₂) ⊊ ⋯` never stabilizes. -/
theorem not_isNoetherianRing : ¬ IsNoetherianRing A := by
  intro h
  obtain ⟨n, hn⟩ := (monotone_stabilizes_iff_noetherian.mpr h) ⟨I, monotone_I⟩
  exact absurd (hn (n + 1) (Nat.le_succ n)) (ne_of_lt (I_lt_I_succ n))

section Localization

variable (p : Ideal A) [hp : p.IsPrime]

/-- Every element of the localization `A_p` is idempotent, because `A` is Boolean. -/
theorem localization_mul_self (x : Localization.AtPrime p) : x * x = x := by
  obtain ⟨⟨a, s⟩, hx⟩ := IsLocalization.mk'_surjective p.primeCompl x
  rw [← hx, ← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq']
  simp [mul_self]

/-- In the local ring `A_p` every idempotent is `0` or `1` (Exercise 1.12), so every element of
`A_p` is `0` or `1`. -/
theorem localization_eq_zero_or_eq_one (x : Localization.AtPrime p) : x = 0 ∨ x = 1 := by
  have hx := localization_mul_self p x
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self x with hu | hu
  · right
    apply hu.mul_left_cancel
    simp [hx]
  · left
    apply hu.mul_left_cancel
    simp [sub_mul, hx]

/-- Every localization of `A` at a prime ideal is a field: all its elements are `0` or `1`, and it
is nontrivial.  In particular `A_p ≅ 𝔽₂`. -/
theorem isField_localization : IsField (Localization.AtPrime p) where
  exists_pair_ne := Nontrivial.exists_pair_ne
  mul_comm := mul_comm
  mul_inv_cancel := by
    intro a ha
    rcases localization_eq_zero_or_eq_one p a with h | h
    · exact absurd h ha
    · exact ⟨1, by rw [h, one_mul]⟩

/-- A commutative ring all of whose elements are `0` or `1` is Noetherian: its only ideals are
`⊥` and `⊤`. -/
theorem isNoetherianRing_of_forall_eq_zero_or_eq_one {K : Type*} [CommRing K]
    (h : ∀ x : K, x = 0 ∨ x = 1) : IsNoetherianRing K := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro J
  by_cases hJ : J = ⊥
  · rw [hJ]
    exact ⟨∅, by simp⟩
  · obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
    rcases h x with hx | hx
    · exact absurd hx hx0
    · have h1 : (1 : K) ∈ J := hx ▸ hxJ
      rw [(Ideal.eq_top_iff_one J).mpr h1]
      exact ⟨{1}, by simp⟩

/-- Each local ring `A_p` is Noetherian. -/
theorem isNoetherianRing_atPrime : IsNoetherianRing (Localization.AtPrime p) :=
  isNoetherianRing_of_forall_eq_zero_or_eq_one (localization_eq_zero_or_eq_one p)

end Localization

/-- **Atiyah–Macdonald, Exercise 7.11.**  The answer to the exercise is negative: for the ring
`A = ∏_{n ∈ ℕ} 𝔽₂` every localization `A_p` at a prime ideal is Noetherian (each one is a field,
indeed `A_p ≅ 𝔽₂`), while `A` itself is not Noetherian. -/
theorem solution :
    ¬ IsNoetherianRing A ∧ ∀ (p : Ideal A) [p.IsPrime], IsNoetherianRing (Localization.AtPrime p) :=
  ⟨not_isNoetherianRing, fun p _ => isNoetherianRing_atPrime p⟩

/-- The question of the exercise, answered negatively: it is *not* the case that a ring all of
whose localizations at prime ideals are Noetherian is itself Noetherian. -/
theorem not_forall_localizations_noetherian :
    ¬ ∀ (R : Type) [CommRing R],
        (∀ (p : Ideal R) [p.IsPrime], IsNoetherianRing (Localization.AtPrime p)) →
          IsNoetherianRing R := by
  intro h
  exact not_isNoetherianRing (h A fun p _ => isNoetherianRing_atPrime p)

section RingEquiv

variable (p : Ideal A) [hp : p.IsPrime]

/-- The `0`–`1` indicator on `A_p`: every nonzero element is sent to `1`. -/
noncomputable def indicator (x : Localization.AtPrime p) : ZMod 2 := if x = 0 then 0 else 1

theorem indicator_zero : indicator p 0 = 0 := by
  rw [indicator, if_pos rfl]

theorem indicator_one : indicator p 1 = 1 := by
  rw [indicator, if_neg (one_ne_zero : (1 : Localization.AtPrime p) ≠ 0)]

theorem indicator_eq_zero_iff {x : Localization.AtPrime p} : indicator p x = 0 ↔ x = 0 := by
  constructor
  · intro h
    by_contra hx
    rw [indicator, if_neg hx] at h
    exact one_ne_zero h
  · rintro rfl
    exact indicator_zero p

theorem indicator_eq_one_iff {x : Localization.AtPrime p} : indicator p x = 1 ↔ x ≠ 0 := by
  constructor
  · intro h hx
    rw [hx, indicator_zero] at h
    exact zero_ne_one h
  · intro hx
    rw [indicator, if_neg hx]

theorem one_add_one_eq_zero : (1 : Localization.AtPrime p) + 1 = 0 := by
  rcases localization_eq_zero_or_eq_one p ((1 : Localization.AtPrime p) + 1) with h | h
  · exact h
  · exfalso
    have h' : (1 : Localization.AtPrime p) + 1 = 1 + 0 := by rw [h, add_zero]
    exact one_ne_zero (add_left_cancel h')

theorem indicator_add (x y : Localization.AtPrime p) :
    indicator p (x + y) = indicator p x + indicator p y := by
  rcases localization_eq_zero_or_eq_one p x with rfl | rfl
  · rcases localization_eq_zero_or_eq_one p y with rfl | rfl
    · rw [zero_add, indicator_zero]
      simp
    · rw [zero_add, indicator_zero, indicator_one]
      decide
  · rcases localization_eq_zero_or_eq_one p y with rfl | rfl
    · rw [add_zero, indicator_zero, indicator_one]
      decide
    · rw [one_add_one_eq_zero, indicator_zero, indicator_one]
      decide

theorem indicator_mul (x y : Localization.AtPrime p) :
    indicator p (x * y) = indicator p x * indicator p y := by
  rcases localization_eq_zero_or_eq_one p x with rfl | rfl
  · rcases localization_eq_zero_or_eq_one p y with rfl | rfl
    · rw [zero_mul, indicator_zero]
      simp
    · rw [zero_mul, indicator_zero, indicator_one]
      simp
  · rcases localization_eq_zero_or_eq_one p y with rfl | rfl
    · rw [mul_zero, indicator_zero, indicator_one]
      simp
    · rw [mul_one, indicator_one]
      decide

/-- The indicator is a ring homomorphism `A_p → 𝔽₂`. -/
noncomputable def indicatorHom : Localization.AtPrime p →+* ZMod 2 where
  toFun := indicator p
  map_one' := indicator_one p
  map_zero' := indicator_zero p
  map_add' := indicator_add p
  map_mul' := indicator_mul p

theorem eq_of_indicator (x : Localization.AtPrime p) :
    x = if indicator p x = 0 then 0 else 1 := by
  rcases localization_eq_zero_or_eq_one p x with rfl | rfl
  · rw [indicator_zero, if_pos rfl]
  · rw [indicator_one, if_neg (one_ne_zero : (1 : ZMod 2) ≠ 0)]

/-- **`A_p ≅ 𝔽₂`**: the indicator map is a bijective ring homomorphism. -/
noncomputable def equivZMod2 : Localization.AtPrime p ≃+* ZMod 2 :=
  RingEquiv.ofBijective (indicatorHom p)
    ⟨fun x y h => by
      change indicator p x = indicator p y at h
      rw [eq_of_indicator p x, eq_of_indicator p y, h],
     fun n => by
      rcases zmod2_eq_zero_or_eq_one n with rfl | rfl
      · exact ⟨0, indicator_zero p⟩
      · exact ⟨1, indicator_one p⟩⟩

end RingEquiv

end AtiyahMcdonald69.Ex_7_11

