/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969), Chapter 9, Exercise 7.

Statement (Ch. 9, Ex. 7 of the textbook):
  Let `A` be a Dedekind domain and `a ≠ 0` an ideal in `A`. Show that every ideal in `A / a` is
  principal. Deduce that every ideal in `A` can be generated by at most 2 elements.

Coverage: both assertions are stated and proved in full (no `sorry`, no `admit`, no custom axioms or
extra hypotheses; the only hypothesis on `A` is the textbook one, `IsDedekindDomain A`, and each
theorem depends only on Lean's standard axioms `propext`, `Classical.choice`, `Quot.sound`, checked
with `#print axioms`).  The file is checked with `lean -DwarningAsError=true` (Lean 4.33.1, the
toolchain matching this VM's prebuilt Mathlib).
  * assertion 1: `principal_ideals_of_quotient` (elementwise form) and
    `isPrincipalIdealRing_quotient` (the class `IsPrincipalIdealRing (A ⧸ a)`); the case `a = A` is
    included, as in the source proof ("the assertion also holds when `a = A`");
  * assertion 2: `exists_span_pair_of_mem` (the book's *deduction*, in the stronger form
    "one of the two generators may be any prescribed nonzero element of the ideal") and
    `exists_span_pair` (every ideal is generated by at most two elements);
  * the local ingredient of the source proof: `isPrincipalIdealRing_localization(_quotient)`;
  * `solution` bundles the two assertions.

Source of the natural-language proof:
  https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-9-7

Math approach / scope adaptation:
  Assertion 1 rests on the ideal-theoretic approximation step `J = a + (x)` valid for ideals
  `0 < a ≤ J` of a Dedekind domain; this single step is Mathlib's
  `IsDedekindDomain.exists_sup_span_eq`, whose proof is a formalization of the Chinese-remainder
  and localization argument used by the source solution (factor `a` into prime powers, choose `x`
  with the prescribed order of vanishing at each of the finitely many relevant primes, then
  conclude by coprimality of distinct prime powers).  We formalize here the transport to the
  quotient: ideals of `A ⧸ a` are the ideals `J ⧸ a` with `a ≤ J`, and `(a + (x)) ⧸ a` is the
  principal ideal generated by `x mod a`.  Assertion 2 is then *deduced* from assertion 1 exactly
  as in the book, with no use of Mathlib's shortcut lemma: for `0 ≠ a ∈ I`, the ring `A ⧸ (a)` is
  a principal ideal ring by assertion 1, so `I ⧸ (a) = (x)`; lifting `x` to `b ∈ I` gives
  `I = (a) + (b) = (a, b)`.
-/

import Mathlib.RingTheory.DedekindDomain.Factorization

namespace AtiyahMcdonald69.Ex_9_7

variable {A : Type*} [CommRing A] [IsDedekindDomain A]

/-! ### Assertion 1: every ideal of `A ⧸ a` is principal, for `a ≠ 0` -/

/-- The approximation step `J = a + (x)` for `0 < a ≤ J`, restated with the textbook's
hypothesis `a ≠ 0`. -/
theorem exists_sup_span_eq_of_ne_bot {a J : Ideal A} (hle : a ≤ J) (ha : a ≠ ⊥) :
    ∃ x : A, a ⊔ Ideal.span {x} = J :=
  IsDedekindDomain.exists_sup_span_eq hle ha

/-- **Atiyah–Macdonald, Ch. 9, Ex. 7, first assertion.**  For a nonzero ideal `a` of a Dedekind
domain `A`, every ideal of the quotient ring `A ⧸ a` is principal. -/
theorem principal_ideals_of_quotient (a : Ideal A) (ha : a ≠ ⊥) :
    ∀ I : Ideal (A ⧸ a), I.IsPrincipal := by
  intro I
  -- ideals above `a` correspond to ideals of the quotient
  have hle : a ≤ Ideal.comap (Ideal.Quotient.mk a) I := by
    intro y hy
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hy]
    exact I.zero_mem
  obtain ⟨x, hx⟩ := exists_sup_span_eq_of_ne_bot hle ha
  -- `I` is the image of `a ⊔ (x)`, hence generated by `x mod a`
  have hmap : Ideal.map (Ideal.Quotient.mk a) (Ideal.comap (Ideal.Quotient.mk a) I) = I :=
    Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective I
  have hbot : Ideal.map (Ideal.Quotient.mk a) a = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
  refine ⟨Ideal.Quotient.mk a x, ?_⟩
  rw [← hmap, ← hx, Ideal.map_sup, hbot, bot_sup_eq, Ideal.map_span, Set.image_singleton]

/-- **Atiyah–Macdonald, Ch. 9, Ex. 7, first assertion**, as a class instance statement:
`A ⧸ a` is a principal ideal ring. -/
theorem isPrincipalIdealRing_quotient (a : Ideal A) (ha : a ≠ ⊥) :
    IsPrincipalIdealRing (A ⧸ a) :=
  ⟨principal_ideals_of_quotient a ha⟩

/-! ### The local ingredient of the textbook proof

The source solution decomposes `A / a ≅ ∏ᵢ A / pᵢ ^ eᵢ ≅ ∏ᵢ A_{pᵢ} / pᵢ ^ eᵢ A_{pᵢ}` and notes that
each factor is a quotient of a principal ideal domain.  The local fact is verified here; the
Chinese-remainder identification itself is the content of the global approximation step used above
(`J = a + (x)` for all `a ≤ J`, which is exactly what the CRT argument produces). -/

/-- For a prime `p` of a Dedekind domain `A` the localization `A_p` is a principal ideal ring
(it is a discrete valuation ring when `p ≠ 0`). -/
theorem isPrincipalIdealRing_localization (p : Ideal A) [p.IsPrime] :
    IsPrincipalIdealRing (Localization.AtPrime p) :=
  inferInstance

/-- Every quotient of `A_p`, in particular `A_p / p ^ e A_p`, is a principal ideal ring: "each
factor is a quotient of a principal ideal domain". -/
theorem isPrincipalIdealRing_localization_quotient (p : Ideal A) [p.IsPrime]
    (I : Ideal (Localization.AtPrime p)) :
    IsPrincipalIdealRing ((Localization.AtPrime p) ⧸ I) :=
  IsPrincipalIdealRing.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective

/-! ### Assertion 2: every ideal of `A` needs at most two generators -/

/-- **Atiyah–Macdonald, Ch. 9, Ex. 7, second assertion, in the form in which the book deduces
it.**  If `0 ≠ a ∈ I`, then `I = (a, b)` for some `b`: the image of `I` in `A ⧸ (a)` is a principal
ideal, and a lift of its generator together with `a` generates `I`. -/
theorem exists_span_pair_of_mem {I : Ideal A} {a : A} (haI : a ∈ I) (ha : a ≠ 0) :
    ∃ b : A, I = Ideal.span {a, b} := by
  have hspan : Ideal.span {a} ≠ ⊥ := fun h => ha (Ideal.span_singleton_eq_bot.mp h)
  -- the image of `I` in `A ⧸ (a)` is principal, by the first assertion
  obtain ⟨x, hx⟩ :=
    (principal_ideals_of_quotient (Ideal.span {a}) hspan
      (Ideal.map (Ideal.Quotient.mk (Ideal.span {a})) I)).principal
  have hxmem : x ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {a})) I := by
    rw [hx]
    exact Ideal.subset_span (Set.mem_singleton x)
  -- lift the generator to an element of `I`
  obtain ⟨b, hbI, hbx⟩ :=
    (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk (Ideal.span {a}))
      Ideal.Quotient.mk_surjective).mp hxmem
  refine ⟨b, le_antisymm ?_ ?_⟩
  · -- `I ≤ (a, b)`: reduce an element of `I` modulo `(a) ⊆ I`
    intro z hz
    have hz' : Ideal.Quotient.mk (Ideal.span {a}) z ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {a})) I := Ideal.mem_map_of_mem _ hz
    rw [hx] at hz'
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hz'
    obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
    -- `c • x` in the quotient is the class of `c' * b`
    have hc' : Ideal.Quotient.mk (Ideal.span {a}) c' * x = Ideal.Quotient.mk (Ideal.span {a}) z := by
      rw [← smul_eq_mul]
      exact hc
    have hcb : Ideal.Quotient.mk (Ideal.span {a}) (c' * b) = Ideal.Quotient.mk (Ideal.span {a}) z := by
      rw [map_mul, hbx, hc']
    have hker : z - c' * b ∈ Ideal.span {a} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hcb, sub_self]
    have hab : ({a} : Set A) ⊆ ({a, b} : Set A) := by
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact Set.mem_insert_iff.mpr (Or.inl rfl)
    have hmem1 : z - c' * b ∈ Ideal.span {a, b} := Ideal.span_mono hab hker
    have hmem2 : c' * b ∈ Ideal.span {a, b} :=
      Ideal.mul_mem_left _ c' (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton b))))
    rw [(sub_add_cancel z (c' * b)).symm]
    exact add_mem hmem1 hmem2
  · -- `(a, b) ≤ I` since both generators lie in `I`
    rw [Ideal.span_insert]
    exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr haI)
      ((Ideal.span_singleton_le_iff_mem _).mpr hbI)

/-- **Atiyah–Macdonald, Ch. 9, Ex. 7, second assertion.**  Every ideal of a Dedekind domain can be
generated by at most two elements. -/
theorem exists_span_pair (I : Ideal A) : ∃ x y : A, I = Ideal.span {x, y} := by
  by_cases hI : I = ⊥
  · refine ⟨0, 0, ?_⟩
    rw [hI, Ideal.span_pair_zero]
    exact (Ideal.span_singleton_eq_bot.mpr rfl).symm
  · obtain ⟨a, haI, ha0⟩ := (Submodule.ne_bot_iff I).mp hI
    obtain ⟨b, hb⟩ := exists_span_pair_of_mem haI ha0
    exact ⟨a, b, hb⟩

/-! ### The exercise -/

/-- **Atiyah–Macdonald, Ch. 9, Ex. 7**, both assertions. -/
theorem solution :
    (∀ (a : Ideal A), a ≠ ⊥ → ∀ I : Ideal (A ⧸ a), I.IsPrincipal) ∧
      (∀ I : Ideal A, ∃ x y : A, I = Ideal.span {x, y}) :=
  ⟨principal_ideals_of_quotient, exists_span_pair⟩

end AtiyahMcdonald69.Ex_9_7
