/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (1969),
Chapter 7 (Noetherian Rings), Exercise 5, p. 84.

Original statement (from the book; cf. the transcription `.scratch/dl/amcd.tex`,
"Page 84, Exercise 7.5", and Carlson's solutions, `.scratch/dl/carlson.txt`, `Ex. 7.5`):

  "Let A be a Noetherian ring, B a finitely generated A-algebra, G a finite group of
   A-automorphisms of B, and B^G the set of all elements of B which are left fixed by every
   element of G. Show that B^G is a finitely generated A-algebra."
  [Hint: use Chapter 5, Exercise 12 and Proposition 7.8.]

Natural-language solution (public source, commit 80e1ebef1d7621c66aabb3920d981ffd8995ba91):
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-5

The source's argument: `A → B^G ⊆ B`, and `B` is integral over `B^G` by Chapter 5 Exercise 12
(`Algebra.IsInvariant.isIntegral` below).  The finitely many `A`-algebra generators of `B`
also generate it over `B^G`, so integrality makes `B` a finite `B^G`-module; the Artin–Tate
lemma (Proposition 7.8, proved here from scratch as `artin_tate_lemma`) then shows that `B^G`
is a finitely generated `A`-algebra.

The hypothesis that `A` is Noetherian is genuinely used, in the Artin–Tate lemma, to conclude
that `B^G` — a submodule of the finite `B^G`-module `B` — is finitely generated over the
finitely generated `A`-algebra generated by the finitely many relevant coefficients.
-/
import Mathlib

set_option linter.style.haveILetI false

namespace AtiyahMcdonald69.Ex_7_5

universe u

/-- **Artin–Tate lemma** (Atiyah–Macdonald, Proposition 7.8).

Let `A ⊆ C ⊆ B` be commutative rings, with `B` a finitely generated `A`-algebra and a finite
`C`-module. If `A` is Noetherian, then `C` is a finitely generated `A`-algebra. -/
theorem artin_tate_lemma (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A] [Algebra.FiniteType A B] (C : Subalgebra A B) [Module.Finite ↥C B] :
    Algebra.FiniteType A ↥C := by
  classical
  -- ## Step 1: generators of `B` as an `A`-algebra and as a `C`-module.
  obtain ⟨xs, hxsfin, hxs⟩ := Subalgebra.fg_def.mp (Algebra.FiniteType.out (R := A) (A := B))
  obtain ⟨m, y, hy⟩ := Module.Finite.exists_fin (R := ↥C) (M := B)
  -- ## Step 2: coefficients expressing each element of `B` in terms of the `y i`.
  have key : ∀ b : B, ∃ c : Fin m → ↥C, ∑ i, c i • y i = b := by
    intro b
    refine (Submodule.mem_span_range_iff_exists_fun ↥C).mp ?_
    rw [hy]
    exact Submodule.mem_top
  choose c hc using key
  -- ## Step 3: the subalgebra `C₀` generated by the finitely many coefficients.
  let T₁ : Set B := ⋃ i : Fin m, ⋃ j : Fin m, Set.range fun k => (c (y i * y j) k : B)
  let T₂ : Set B := Set.range fun k => (c (1 : B) k : B)
  let T₃ : Set B := ⋃ x ∈ xs, Set.range fun k => (c x k : B)
  let S : Set B := T₁ ∪ T₂ ∪ T₃
  let C₀ : Subalgebra A B := Algebra.adjoin A S
  have hT₁ : ∀ (i j k : Fin m), (c (y i * y j) k : B) ∈ S := by
    intro i j k
    refine Or.inl (Or.inl ?_)
    exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨j, Set.mem_range_self k⟩⟩
  have hT₂ : ∀ k : Fin m, (c (1 : B) k : B) ∈ S := fun k =>
    Or.inl (Or.inr (Set.mem_range_self k))
  have hT₃ : ∀ x ∈ xs, ∀ k : Fin m, (c x k : B) ∈ S := by
    intro x hx k
    exact Or.inr (Set.mem_iUnion.mpr ⟨x, Set.mem_iUnion.mpr ⟨hx, Set.mem_range_self k⟩⟩)
  have hSfin : S.Finite := by
    have h1 : T₁.Finite :=
      Set.finite_iUnion fun i => Set.finite_iUnion fun _ => Set.finite_range _
    have h2 : T₂.Finite := Set.finite_range _
    have h3 : T₃.Finite := hxsfin.biUnion fun _ _ => Set.finite_range _
    exact (h1.union h2).union h3
  have hSC : S ⊆ (C : Set B) := by
    intro z hz
    simp only [S, T₁, T₂, T₃, Set.mem_union, Set.mem_iUnion, Set.mem_range] at hz
    rcases hz with (⟨i, j, k, rfl⟩ | ⟨k, rfl⟩) | ⟨x, hx, k, rfl⟩
    · exact (c (y i * y j) k).2
    · exact (c (1 : B) k).2
    · exact (c x k).2
  have hC₀C : C₀ ≤ C := Algebra.adjoin_le hSC
  have hC₀fg : Algebra.FiniteType A ↥C₀ :=
    Algebra.FiniteType.mk ((Subalgebra.fg_top C₀).mpr (Subalgebra.fg_def.mpr ⟨S, hSfin, rfl⟩))
  haveI : IsNoetherianRing ↥C₀ := Algebra.FiniteType.isNoetherianRing A ↥C₀
  -- ## Step 4: every element of `B` is a `C₀`-linear combination of the `y i`.
  let M : Submodule ↥C₀ B := Submodule.span ↥C₀ (Set.range y)
  have hyM : ∀ i : Fin m, y i ∈ M := fun i => Submodule.subset_span (Set.mem_range_self i)
  have coeff_mem : ∀ (b : B) (hb : ∀ k : Fin m, (c b k : B) ∈ S), b ∈ M := by
    intro b hb
    rw [← hc b]
    refine Submodule.sum_mem _ fun k _ => ?_
    have hcoeff : c b k • y k = (⟨(c b k : B), Algebra.subset_adjoin (hb k)⟩ : ↥C₀) • y k := by
      simp [Algebra.smul_def]
    rw [hcoeff]
    exact Submodule.smul_mem _ _ (hyM k)
  have hone : (1 : B) ∈ M := coeff_mem 1 fun k => hT₂ k
  have hyy : ∀ i j : Fin m, y i * y j ∈ M := fun i j => coeff_mem _ fun k => hT₁ i j k
  have hxM : ∀ x ∈ xs, x ∈ M := fun x hx => coeff_mem x fun k => hT₃ x hx k
  have hMM : ∀ u ∈ M, ∀ v ∈ M, u * v ∈ M := by
    intro u hu
    induction hu using Submodule.span_induction with
    | mem u hu =>
      obtain ⟨i, rfl⟩ := hu
      intro v hv
      induction hv using Submodule.span_induction with
      | mem v hv => obtain ⟨j, rfl⟩ := hv; exact hyy i j
      | zero => rw [mul_zero]; exact Submodule.zero_mem _
      | add v₁ v₂ _ _ ih₁ ih₂ => rw [mul_add]; exact Submodule.add_mem _ ih₁ ih₂
      | smul a v _ ih => rw [Algebra.mul_smul_comm]; exact Submodule.smul_mem _ a ih
    | zero => intro v _; rw [zero_mul]; exact Submodule.zero_mem _
    | add u₁ u₂ _ _ ih₁ ih₂ => intro v hv; rw [add_mul]; exact Submodule.add_mem _ (ih₁ v hv) (ih₂ v hv)
    | smul a u _ ih => intro v hv; rw [Algebra.smul_mul_assoc]; exact Submodule.smul_mem _ a (ih v hv)
  have htop : ∀ b : B, b ∈ M := by
    have hmem : ∀ b ∈ Algebra.adjoin A xs, b ∈ M := by
      intro b hb
      induction hb using Algebra.adjoin_induction with
      | mem x hx => exact hxM x hx
      | algebraMap r =>
        rw [IsScalarTower.algebraMap_apply A ↥C₀ B, Algebra.algebraMap_eq_smul_one]
        exact Submodule.smul_mem _ _ hone
      | add x y _ _ ihx ihy => exact Submodule.add_mem _ ihx ihy
      | mul x y _ _ ihx ihy => exact hMM x ihx y ihy
    intro b
    exact hmem b (by rw [hxs]; trivial)
  -- ## Step 5: `C` sits inside the finite `C₀`-module `M`, so it is a finite `C₀`-module,
  -- hence a finitely generated `A`-algebra.
  let N : Submodule ↥C₀ B :=
    { carrier := (C : Set B)
      add_mem' := fun {x y} hx hy => C.add_mem hx hy
      zero_mem' := C.zero_mem
      smul_mem' := fun c {x} hx => C.mul_mem (hC₀C c.2) hx }
  have hNfin : N.FG := by
    have hNle : N ≤ M := fun x hx => htop x
    have hMfin : M.FG := Submodule.fg_def.mpr ⟨Set.range y, Set.finite_range y, rfl⟩
    haveI : Module.Finite ↥C₀ ↥M := Module.Finite.of_fg hMfin
    haveI : IsNoetherian ↥C₀ ↥M := isNoetherian_of_isNoetherianRing_of_finite ↥C₀ ↥M
    have h1 : (Submodule.comap M.subtype N).FG := IsNoetherian.noetherian _
    have h2 : ((Submodule.comap M.subtype N).map M.subtype).FG := h1.map _
    have h3 : Submodule.map M.subtype (Submodule.comap M.subtype N) = N :=
      Submodule.map_comap_eq_self (f := M.subtype) (q := N) (by simpa using hNle)
    rwa [h3] at h2
  obtain ⟨t', ht'fin, ht'span⟩ := Submodule.fg_def.mp hNfin
  have ht'C : t' ⊆ (C : Set B) := by
    intro z hz
    have hzN : z ∈ N := ht'span ▸ Submodule.subset_span hz
    exact hzN
  have hCFG : C.FG := by
    refine Subalgebra.fg_def.mpr ⟨S ∪ t', hSfin.union ht'fin, ?_⟩
    refine le_antisymm ?_ ?_
    · refine Algebra.adjoin_le ?_
      intro z hz
      rcases hz with hz | hz
      · exact hC₀C (Algebra.subset_adjoin hz)
      · exact ht'C hz
    · have hspan_le : (Submodule.span ↥C₀ t' : Set B) ⊆ (Algebra.adjoin A (S ∪ t') : Set B) := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem z hz => exact Algebra.subset_adjoin (Or.inr hz)
        | zero => exact Subalgebra.zero_mem _
        | add y z _ _ ihy ihz => exact Subalgebra.add_mem _ ihy ihz
        | smul c z _ ih =>
          rw [Algebra.smul_def]
          exact Subalgebra.mul_mem _
            (Algebra.adjoin_mono Set.subset_union_left (show (c : B) ∈ Algebra.adjoin A S from c.2)) ih
      intro x hx
      exact hspan_le (ht'span ▸ hx)
  exact Algebra.FiniteType.mk ((Subalgebra.fg_top C).mpr hCFG)

/-- Artin–Tate lemma, integral form (the second form of Atiyah–Macdonald, Proposition 7.8):
if `B` is a finitely generated `A`-algebra, `C` an `A`-subalgebra of `B` over which `B` is
integral, and `A` is Noetherian, then `C` is a finitely generated `A`-algebra. -/
theorem artin_tate_lemma_of_isIntegral (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A] [Algebra.FiniteType A B] (C : Subalgebra A B) [Algebra.IsIntegral ↥C B] :
    Algebra.FiniteType A ↥C := by
  haveI hFt : Algebra.FiniteType ↥C B := Algebra.FiniteType.of_restrictScalars_finiteType A ↥C B
  haveI : Module.Finite ↥C B := Algebra.IsIntegral.finite
  exact artin_tate_lemma A B C

/-- **Atiyah–Macdonald, Chapter 7, Exercise 5** (p. 84).

Let `A` be a Noetherian ring, `B` a finitely generated `A`-algebra, `G` a finite group of
`A`-automorphisms of `B`, and `B^G` the set of all elements of `B` which are left fixed by
every element of `G`. Then `B^G` is a finitely generated `A`-algebra.

The action of `G` by `A`-algebra automorphisms is encoded by the typeclass assumptions
`MulSemiringAction G B` (each `g : G` acts as a ring automorphism of `B`) together with
`SMulCommClass G A B` (each `g` fixes the image of `A` in `B`).  The invariant ring `B^G` is
the concrete subalgebra `FixedPoints.subalgebra A B G` of `B`, whose elements are exactly the
fixed points (`mem_fixedPoints_subalgebra` below). -/
theorem solution (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] (G : Type*)
    [Group G] [Finite G] [MulSemiringAction G B] [SMulCommClass G A B]
    [IsNoetherianRing A] [Algebra.FiniteType A B] :
    Algebra.FiniteType A ↥(FixedPoints.subalgebra A B G) := by
  haveI hInt : Algebra.IsIntegral ↥(FixedPoints.subalgebra A B G) B := by
    haveI : Algebra.IsInvariant ↥(FixedPoints.subalgebra A B G) B G :=
      ⟨fun b hb => ⟨⟨b, hb⟩, rfl⟩⟩
    exact Algebra.IsInvariant.isIntegral ↥(FixedPoints.subalgebra A B G) B G
  haveI hFt : Algebra.FiniteType ↥(FixedPoints.subalgebra A B G) B :=
    Algebra.FiniteType.of_restrictScalars_finiteType A _ B
  haveI : Module.Finite ↥(FixedPoints.subalgebra A B G) B := Algebra.IsIntegral.finite
  exact artin_tate_lemma A B (FixedPoints.subalgebra A B G)

/-- The carrier of `B^G = FixedPoints.subalgebra A B G` is, concretely, the set of elements
fixed by every element of `G`. -/
theorem mem_fixedPoints_subalgebra {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {G : Type*} [Group G] [MulSemiringAction G B] [SMulCommClass G A B] {b : B} :
    b ∈ FixedPoints.subalgebra A B G ↔ ∀ g : G, g • b = b :=
  Iff.rfl

end AtiyahMcdonald69.Ex_7_5
