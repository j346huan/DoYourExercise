/-
# Atiyah--Macdonald (1969), Exercise 11.5

"Reformulate the Hilbert--Serre theorem (11.1) in terms of the Grothendieck group `K(A₀)`
(Chapter 7, Exercise 25)."

For a graded module `M = ⊕_n M_n` over a Noetherian graded ring `A = A₀[x_0,…,x_{m-1}]`
with `deg x_i = k_i`, whose pieces `M_n` are finitely generated over `A₀` and which is finitely
generated in the graded sense, the *additive-class Hilbert series*
`H_M(t) = Σ_n [M_n] t^n ∈ K(A₀)[[t]]` satisfies

  `∏_{i<m} (1 - t^{k_i}) · H_M(t) ∈ K(A₀)[t]`

(main theorems `hilbert_serre`, `hilbert_serre_KM`), and consequently for every additive
function `λ` on finitely generated `A₀`-modules `Σ_n λ(M_n) t^n = f(t)/∏_{i<m}(1-t^{k_i})`
with `f` a polynomial (`hilbert_serre_classical`) — this is Theorem 11.1 itself.

Contents: the Grothendieck group of finitely generated modules and its universal property
(§1), the algebra of additive Laurent series and the operators `(1 - t^k)` (§2), graded data
and the graded finite-generation predicate (§3), the kernel and cokernel pieces of the last
multiplication together with the four-term Hilbert-class identity (§4), and the induction
(§5).  Standalone formalisation; only Mathlib is imported.
-/
import Mathlib

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

universe u

namespace AtiyahMcdonald69.Ex_11_5

/-! ## §1. The Grothendieck group of finitely generated modules -/

variable (R : Type u) [CommRing R]

/-- Bundled finitely generated `R`-modules: the objects whose classes generate `K(R)`. -/
structure FgMod where
  carrier : Type u
  [str1 : AddCommGroup carrier]
  [str2 : Module R carrier]
  [str3 : Module.Finite R carrier]

attribute [instance] FgMod.str1 FgMod.str2 FgMod.str3

namespace FgMod

/-- Bundle a finitely generated module. -/
abbrev mkOf (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] : FgMod R := ⟨M⟩

end FgMod

/-- The data of a short exact sequence `0 → L → M → N → 0` of finitely generated modules. -/
structure SES where
  L : FgMod R
  M : FgMod R
  N : FgMod R
  f : L.carrier →ₗ[R] M.carrier
  g : M.carrier →ₗ[R] N.carrier
  hinj : Function.Injective f
  hsurj : Function.Surjective g
  hex : Function.Exact f g

/-- The relation `[N] - [M] + [L] = 0` in the free abelian group, attached to `E`. -/
def rel (E : SES R) : FreeAbelianGroup (FgMod R) :=
  FreeAbelianGroup.of E.N - FreeAbelianGroup.of E.M + FreeAbelianGroup.of E.L

/-- The subgroup of the free abelian group generated by the short exact sequence relations. -/
def grothSub : AddSubgroup (FreeAbelianGroup (FgMod R)) :=
  AddSubgroup.closure (Set.range (rel R))

/-- **The Grothendieck group of finitely generated `R`-modules.** -/
abbrev K := FreeAbelianGroup (FgMod R) ⧸ grothSub R

/-- The class `[M] ∈ K(R)` of a finitely generated module. -/
def cls (X : FgMod R) : K R := QuotientAddGroup.mk' (grothSub R) (FreeAbelianGroup.of X)

theorem cls_rel (E : SES R) : cls R E.N - cls R E.M + cls R E.L = 0 := by
  have hmem : rel R E ∈ grothSub R := AddSubgroup.subset_closure ⟨E, rfl⟩
  have hzero : QuotientAddGroup.mk' (grothSub R) (rel R E) = 0 := by
    rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
    exact hmem
  have hEq : QuotientAddGroup.mk' (grothSub R) (rel R E)
      = cls R E.N - cls R E.M + cls R E.L := by
    simp only [rel, cls, map_add, map_sub]
  rw [← hEq]
  exact hzero

/-- `cls_rel` with the fields of the short exact sequence as explicit arguments. -/
theorem cls_rel' {L M N : FgMod R} (f : L.carrier →ₗ[R] M.carrier) (g : M.carrier →ₗ[R] N.carrier)
    (hinj : Function.Injective f) (hsurj : Function.Surjective g) (hex : Function.Exact f g) :
    cls R N - cls R M + cls R L = 0 :=
  cls_rel R ⟨L, M, N, f, g, hinj, hsurj, hex⟩

/-- Additivity of the class map for a four term exact sequence
`0 → A → B → C → D → 0`:  `[B] - [A] = [C] - [D]`. -/
theorem cls_four (A B C D : FgMod R) (f : A.carrier →ₗ[R] B.carrier)
    (g : B.carrier →ₗ[R] C.carrier) (h : C.carrier →ₗ[R] D.carrier)
    (hex1 : Function.Exact f g) (hex2 : Function.Exact g h)
    (hinj : Function.Injective f) (hsurj : Function.Surjective h) :
    cls R B - cls R A = cls R C - cls R D := by
  set P : Submodule R C.carrier := LinearMap.range g with hP
  have hsurj' : Function.Surjective (g.codRestrict P (fun x => LinearMap.mem_range_self g x)) := by
    intro y
    obtain ⟨x, hx⟩ := y.2
    exact ⟨x, Subtype.ext hx⟩
  haveI : Module.Finite R ↥P :=
    Module.Finite.of_surjective (g.codRestrict P (fun x => LinearMap.mem_range_self g x)) hsurj'
  have hex1' : Function.Exact f (g.codRestrict P (fun x => LinearMap.mem_range_self g x)) := by
    rw [LinearMap.exact_iff] at hex1 ⊢
    rw [LinearMap.ker_codRestrict]
    exact hex1
  have hex2' : Function.Exact (Submodule.subtype P) h := by
    rw [LinearMap.exact_iff] at hex2 ⊢
    rw [Submodule.range_subtype]
    exact hex2
  have h1 : cls R B - cls R A = cls R (FgMod.mkOf R ↥P) := by
    have hh : cls R (FgMod.mkOf R ↥P) - cls R B + cls R A = 0 :=
      cls_rel' R f (g.codRestrict P (fun x => LinearMap.mem_range_self g x)) hinj hsurj' hex1'
    have key : cls R (FgMod.mkOf R ↥P) + cls R A = cls R B := by
      calc cls R (FgMod.mkOf R ↥P) + cls R A
          = (cls R (FgMod.mkOf R ↥P) - cls R B + cls R A) + cls R B := by abel
        _ = cls R B := by rw [hh, zero_add]
    symm
    rw [eq_sub_iff_add_eq]
    exact key
  have h2 : cls R C - cls R D = cls R (FgMod.mkOf R ↥P) := by
    have hh : cls R D - cls R C + cls R (FgMod.mkOf R ↥P) = 0 :=
      cls_rel' R (Submodule.subtype P) h Subtype.coe_injective hsurj hex2'
    have key : cls R (FgMod.mkOf R ↥P) + cls R D = cls R C := by
      calc cls R (FgMod.mkOf R ↥P) + cls R D
          = (cls R D - cls R C + cls R (FgMod.mkOf R ↥P)) + cls R C := by abel
        _ = cls R C := by rw [hh, zero_add]
    symm
    rw [eq_sub_iff_add_eq]
    exact key
  rw [h1, ← h2]

/-- A module whose carrier is a subsingleton has class `0` in `K(R)`. -/
theorem cls_eq_zero_of_subsingleton (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Subsingleton M] : cls R (FgMod.mkOf R M) = 0 := by
  have hinj : Function.Injective (0 : M →ₗ[R] M) := by
    intro x y _
    exact Subsingleton.elim x y
  have hsurj : Function.Surjective (0 : M →ₗ[R] M) := by
    intro y
    exact ⟨0, Subsingleton.elim _ _⟩
  have hex : Function.Exact (0 : M →ₗ[R] M) (0 : M →ₗ[R] M) := by
    intro x
    constructor
    · intro _; exact ⟨0, Subsingleton.elim _ _⟩
    · intro _; rfl
  have hh : cls R (FgMod.mkOf R M) - cls R (FgMod.mkOf R M) + cls R (FgMod.mkOf R M) = 0 :=
    cls_rel' R (0 : M →ₗ[R] M) (0 : M →ₗ[R] M) hinj hsurj hex
  simpa only [sub_self, zero_add] using hh

/-- **The universal property of the Grothendieck group**: every additive function on finitely
generated modules (one that vanishes on `[N] - [M] + [L]` for every short exact sequence)
factors through `K R`.  This is the "reformulation" content of the exercise. -/
theorem K_lift {G : Type*} [AddCommGroup G] (lam : FgMod R → G)
    (hadd : ∀ E : SES R, lam E.N - lam E.M + lam E.L = 0) :
    ∃ φ : K R →+ G, ∀ X : FgMod R, φ (cls R X) = lam X := by
  refine ⟨QuotientAddGroup.lift (grothSub R) (FreeAbelianGroup.lift lam) ?_,
    fun X => ?_⟩
  · rw [grothSub, AddSubgroup.closure_le]
    intro x hx
    rw [Set.mem_range] at hx
    obtain ⟨E, rfl⟩ := hx
    show (FreeAbelianGroup.lift lam) (rel R E) = 0
    simp only [rel, map_add, map_sub, FreeAbelianGroup.lift_apply_of]
    exact hadd E
  · rw [cls, QuotientAddGroup.mk'_apply, QuotientAddGroup.lift_mk',
      FreeAbelianGroup.lift_apply_of]

/-! ## §2. Additive Laurent series and the operators `(1 - t^k)` -/

section Series

variable {G : Type*} [AddCommGroup G]

/-- Coefficient sequence of `t^k · H`. -/
def TMul (k : ℤ) (H : ℤ → G) : ℤ → G := fun n => H (n - k)

/-- Coefficient sequence of `(1 - t^k) · H`. -/
def oneMinus (k : ℤ) (H : ℤ → G) : ℤ → G := fun n => H n - H (n - k)

/-- `TMul k` as an additive endomorphism. -/
def TMulHom (k : ℤ) : (ℤ → G) →+ (ℤ → G) where
  toFun := TMul k
  map_zero' := by funext n; simp [TMul]
  map_add' H H' := by funext n; simp [TMul, Pi.add_apply]

/-- `H ↦ (1 - t^k) H` as an additive endomorphism. -/
def oneMinusHom (k : ℤ) : (ℤ → G) →+ (ℤ → G) where
  toFun := oneMinus k
  map_zero' := by funext n; simp [oneMinus]
  map_add' H H' := by
    funext n
    simp only [oneMinus, Pi.add_apply]
    abel

@[simp] theorem oneMinusHom_apply (k : ℤ) (H : ℤ → G) : oneMinusHom k H = oneMinus k H := rfl

@[simp] theorem TMulHom_apply (k : ℤ) (H : ℤ → G) : TMulHom k H = TMul k H := rfl

theorem oneMinus_eq (k : ℤ) (H : ℤ → G) : oneMinus k H = H - TMul k H := rfl

theorem TMul_TMul (k l : ℤ) (H : ℤ → G) : TMul k (TMul l H) = TMul (k + l) H := by
  funext n
  simp only [TMul]
  congr 1
  omega

theorem TMul_sub (k : ℤ) (H H' : ℤ → G) : TMul k (H - H') = TMul k H - TMul k H' := by
  funext n
  simp only [TMul, Pi.sub_apply]

/-- The operator `(1 - t^l)` commutes with `t^k`. -/
theorem oneMinus_TMul (l k : ℤ) (X : ℤ → G) : oneMinus l (TMul k X) = TMul k (oneMinus l X) := by
  funext n
  simp only [oneMinus, TMul]
  congr 2 <;> omega

/-- The iterated operator `∏_{i<m} (1 - t^{w i})`. -/
def prodFin : (m : ℕ) → (Fin m → ℤ) → ((ℤ → G) →+ (ℤ → G))
  | 0, _ => AddMonoidHom.id _
  | m + 1, w => (oneMinusHom (w (Fin.last m))).comp (prodFin m (fun i => w i.castSucc))

theorem prodFin_succ (m : ℕ) (w : Fin (m + 1) → ℤ) (H : ℤ → G) :
    prodFin (m + 1) w H = oneMinus (w (Fin.last m)) (prodFin m (fun i => w i.castSucc) H) :=
  rfl

/-- `t^k` commutes with every `prodFin`. -/
theorem prodFin_TMul (m : ℕ) (w : Fin m → ℤ) (k : ℤ) (H : ℤ → G) :
    prodFin m w (TMul k H) = TMul k (prodFin m w H) := by
  induction m with
  | zero => rfl
  | succ m ih =>
    rw [prodFin_succ, prodFin_succ, ih, oneMinus_TMul]

/-- `prodFin` and `oneMinus` commute. -/
theorem oneMinus_prodFin (k : ℤ) (m : ℕ) (w : Fin m → ℤ) (H : ℤ → G) :
    oneMinus k (prodFin m w H) = prodFin m w (oneMinus k H) := by
  rw [oneMinus_eq, oneMinus_eq, ← prodFin_TMul, ← map_sub]

/-- A coefficient sequence which vanishes above some bound ("is a polynomial"). -/
def IsPoly (H : ℤ → G) : Prop := ∃ N : ℤ, ∀ n : ℤ, N ≤ n → H n = 0

theorem IsPoly.zero : IsPoly (0 : ℤ → G) := ⟨0, by intro n _; rfl⟩

theorem IsPoly.congr {H H' : ℤ → G} (h : IsPoly H) (hh : ∀ n, H' n = H n) : IsPoly H' := by
  obtain ⟨N, hN⟩ := h
  exact ⟨N, fun n hn => by rw [hh n, hN n hn]⟩

theorem IsPoly.add {H H' : ℤ → G} (h : IsPoly H) (h' : IsPoly H') : IsPoly (H + H') := by
  obtain ⟨N, hN⟩ := h
  obtain ⟨N', hN'⟩ := h'
  refine ⟨max N N', fun n hn => ?_⟩
  simp only [Pi.add_apply]
  rw [hN n (le_trans (le_max_left _ _) hn), hN' n (le_trans (le_max_right _ _) hn), add_zero]

theorem IsPoly.sub {H H' : ℤ → G} (h : IsPoly H) (h' : IsPoly H') : IsPoly (H - H') := by
  obtain ⟨N, hN⟩ := h
  obtain ⟨N', hN'⟩ := h'
  refine ⟨max N N', fun n hn => ?_⟩
  simp only [Pi.sub_apply]
  rw [hN n (le_trans (le_max_left _ _) hn), hN' n (le_trans (le_max_right _ _) hn), sub_zero]

theorem IsPoly.tmul {H : ℤ → G} (h : IsPoly H) (k : ℤ) : IsPoly (TMul k H) := by
  obtain ⟨N, hN⟩ := h
  exact ⟨N + k, fun n hn => hN (n - k) (by omega)⟩

theorem IsPoly.map {G' : Type*} [AddCommGroup G'] (φ : G →+ G') {H : ℤ → G}
    (h : IsPoly H) : IsPoly (fun n => φ (H n)) := by
  obtain ⟨N, hN⟩ := h
  exact ⟨N, fun n hn => by
    show φ (H n) = 0
    rw [hN n hn, map_zero]⟩

/-- `prodFin` is natural with respect to additive maps. -/
theorem prodFin_map {G' : Type*} [AddCommGroup G'] (φ : G →+ G') (m : ℕ) (w : Fin m → ℤ)
    (H : ℤ → G) :
    (fun n => φ (prodFin m w H n)) = prodFin m w (fun n => φ (H n)) := by
  induction m with
  | zero => rfl
  | succ m ih =>
    funext n
    simp only [prodFin_succ, oneMinus, Pi.sub_apply, map_sub]
    rw [← congrFun (ih (fun i => w i.castSucc)) n,
      ← congrFun (ih (fun i => w i.castSucc)) (n - w (Fin.last m))]

theorem IsPoly.prodFin {H : ℤ → G} (h : IsPoly H) (m : ℕ) (w : Fin m → ℤ) :
    IsPoly (prodFin m w H) := by
  induction m with
  | zero => exact h
  | succ m ih =>
    rw [prodFin_succ]
    exact (ih (fun i => w i.castSucc)).sub ((ih (fun i => w i.castSucc)).tmul _)

end Series


/-! ## §3. Graded data over a weighted graded ring `A₀[x_0,…,x_{s-1}]` -/

section Graded

variable {R : Type u} [CommRing R]

/-- Transport of an element of the degree-`a` piece to the degree-`b` piece,
along an equality `a = b` of degrees. -/
def pcast {M : ℤ → Type u} {a b : ℤ} (h : a = b) (v : M a) : M b := h ▸ v

theorem pcast_self {M : ℤ → Type u} {a : ℤ} (v : M a) : pcast rfl v = v := rfl

theorem pcast_rfl {M : ℤ → Type u} {a : ℤ} (h : a = a) (v : M a) : pcast h v = v := by
  cases h; rfl

/-- Graded data: a family of finitely generated `R`-modules indexed by `ℤ`, together with
the multiplications by the `s` homogeneous generators `x_0,…,x_{s-1}`, of degrees `k i`,
satisfying the obvious commutation. -/
structure GData (s : ℕ) (k : Fin s → ℕ) where
  M : ℤ → Type u
  [str1 : ∀ n, AddCommGroup (M n)]
  [str2 : ∀ n, Module R (M n)]
  [str3 : ∀ n, Module.Finite R (M n)]
  x : ∀ (i : Fin s) (n : ℤ), M n →ₗ[R] M (n + k i)
  comm : ∀ (i j : Fin s) (n : ℤ) (v : M n),
    (x i (n + k j)) ((x j n) v)
      = pcast (M := M) (show n + k i + k j = n + k j + k i by omega)
          ((x j (n + k i)) ((x i n) v))

attribute [instance] GData.str1 GData.str2 GData.str3

namespace GData

variable {s : ℕ} {k : Fin s → ℕ} (D : GData (R := R) s k)

/-- Transport of graded elements along an equality of degrees. -/
def ecast {a b : ℤ} (h : a = b) (v : D.M a) : D.M b := pcast h v

theorem ecast_self {a : ℤ} (v : D.M a) : D.ecast rfl v = v := rfl

theorem ecast_rfl {a : ℤ} (h : a = a) (v : D.M a) : D.ecast h v = v := pcast_rfl h v

theorem ecast_ecast {a b c : ℤ} (h1 : a = b) (h2 : b = c) (v : D.M a) :
    D.ecast h2 (D.ecast h1 v) = D.ecast (h1.trans h2) v := by subst h1; subst h2; rfl

theorem ecast_cancel {a b : ℤ} (h : a = b) (v : D.M b) :
    D.ecast h (D.ecast h.symm v) = v := by subst h; rfl

theorem ecast_cancel' {a b : ℤ} (h : a = b) (v : D.M a) :
    D.ecast h.symm (D.ecast h v) = v := by subst h; rfl

theorem ecast_zero {a b : ℤ} (h : a = b) : D.ecast h (0 : D.M a) = 0 := by subst h; rfl

theorem ecast_add {a b : ℤ} (h : a = b) (u v : D.M a) :
    D.ecast h (u + v) = D.ecast h u + D.ecast h v := by subst h; rfl

theorem ecast_smul {a b : ℤ} (h : a = b) (r : R) (v : D.M a) :
    D.ecast h (r • v) = r • D.ecast h v := by subst h; rfl

theorem ecast_eq_zero {a b : ℤ} (h : a = b) (v : D.M a) : D.ecast h v = 0 ↔ v = 0 := by
  subst h; rfl

theorem ecast_eq {a b : ℤ} (h : a = b) (u v : D.M a) : D.ecast h u = D.ecast h v ↔ u = v := by
  subst h; rfl

/-- Multiplication maps are compatible with transport of degrees. -/
theorem x_ecast (i : Fin s) {a b : ℤ} (h : a = b) (v : D.M a) :
    (D.x i b) (D.ecast h v) = D.ecast (by omega : a + k i = b + k i) (D.x i a v) := by
  subst h; rfl

/-- The "swap" relation between two multiplication maps. -/
theorem x_swap (i j : Fin s) (n : ℤ) (v : D.M n) :
    (D.x i (n + k j)) ((D.x j n) v)
      = D.ecast (show n + k i + k j = n + k j + k i by omega)
          ((D.x j (n + k i)) ((D.x i n) v)) := D.comm i j n v

/-- A linear map between two degree pieces, given by transport. -/
def lcast {a b : ℤ} (h : a = b) : D.M a →ₗ[R] D.M b where
  toFun := D.ecast h
  map_add' := D.ecast_add h
  map_smul' := D.ecast_smul h

@[simp] theorem lcast_apply {a b : ℤ} (h : a = b) (v : D.M a) :
    D.lcast h v = D.ecast h v := rfl

end GData

/-- The submodule generated (over `A₀[x_0,…,x_{m-1}]`) by a finite homogeneous family. -/
inductive InGen (D : GData (R := R) s k) (m : ℕ) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ i, D.M (d i)) : {n : ℤ} → D.M n → Prop
  | base (i : Fin r) : InGen D m d g (g i)
  | zero (n : ℤ) : InGen D m d g (0 : D.M n)
  | add {n : ℤ} {a b : D.M n} : InGen D m d g a → InGen D m d g b → InGen D m d g (a + b)
  | smul {n : ℤ} (c : R) {a : D.M n} : InGen D m d g a → InGen D m d g (c • a)
  | shift (i : Fin s) (hi : (i : ℕ) < m) {n : ℤ} {a : D.M n} :
      InGen D m d g a → InGen D m d g ((D.x i n) a)

theorem InGen.congr {D : GData (R := R) s k} {m : ℕ} {r : ℕ} {d : Fin r → ℤ}
    {g : ∀ i, D.M (d i)} {n : ℤ} {v v' : D.M n} (h : InGen D m d g v) (hv : v = v') :
    InGen D m d g v' := by subst hv; exact h

/-- The degree-`n` piece of the submodule generated by `(d, g)` over `A₀[x_0,…,x_{m-1}]`. -/
def genSub (D : GData (R := R) s k) (m : ℕ) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ i, D.M (d i)) (n : ℤ) : Submodule R (D.M n) where
  carrier := {v | InGen D m d g v}
  zero_mem' := InGen.zero n
  add_mem' := fun ha hb => InGen.add ha hb
  smul_mem' := fun c _ ha => InGen.smul c ha

/-- `(d, g)` generates the whole graded module over `A₀[x_0,…,x_{m-1}]`. -/
def IsFgOver (D : GData (R := R) s k) (m : ℕ) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ i, D.M (d i)) : Prop := ∀ n, genSub D m d g n = ⊤

/-- **Minimality** of the generated submodule. -/
theorem genSub_le_of (D : GData (R := R) s k) (m : ℕ) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ i, D.M (d i)) (N : ∀ n, Submodule R (D.M n))
    (hG : ∀ i, g i ∈ N (d i))
    (hcl : ∀ (i : Fin s) (hi : (i : ℕ) < m) (n : ℤ) (v : D.M n), v ∈ N n → (D.x i n) v ∈ N (n + k i)) :
    ∀ {n : ℤ} {v : D.M n}, InGen D m d g v → v ∈ N n := by
  intro n v hv
  induction hv with
  | base i => exact hG i
  | zero n => exact (N n).zero_mem
  | add ha hb iha ihb => exact (N _).add_mem iha ihb
  | smul c ha ih => exact (N _).smul_mem c ih
  | shift i hi a ih => exact hcl _ hi _ _ ih

end Graded


/-! ## §4. The kernel and cokernel of multiplication by the last generator -/

section Kernels

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {s : ℕ} {k : Fin s → ℕ}

/-- Transport in a family of submodules. -/
theorem subtype_pcast {M : ℤ → Type u} [∀ n, AddCommGroup (M n)] [∀ n, Module R (M n)]
    {P : ∀ n, Submodule R (M n)} {a b : ℤ} (h : a = b) (v : ↥(P a)) :
    ((pcast (M := fun n => ↥(P n)) h v : ↥(P b)) : M b) = pcast (M := M) h (v : M a) := by
  subst h; rfl

/-- Transport in a family of quotient modules. -/
theorem quot_pcast {M : ℤ → Type u} [∀ n, AddCommGroup (M n)] [∀ n, Module R (M n)]
    {P : ∀ n, Submodule R (M n)} {a b : ℤ} (h : a = b) (v : M a) :
    pcast (M := fun n => M n ⧸ P n) h (Submodule.Quotient.mk v)
      = Submodule.Quotient.mk (pcast (M := M) h v) := by
  subst h; rfl

/-- The kernel pieces `(0 :_M x_{i₀})` of the last multiplication. -/
def kerSub (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) : Submodule R (D.M n) :=
  LinearMap.ker (D.x i₀ n)

abbrev KData (D : GData (R := R) s k) (i₀ : Fin s) :
    GData (R := R) (i₀ : ℕ) (fun i => k (Fin.castLE (le_of_lt i₀.2) i)) where
  M n := ↥(kerSub D i₀ n)
  str1 n := inferInstance
  str2 n := inferInstance
  str3 n := by
    haveI : IsNoetherian R (D.M n) := isNoetherian_of_isNoetherianRing_of_finite R (D.M n)
    exact Module.Finite.iff_fg.mpr (isNoetherian_def.mp inferInstance (LinearMap.ker (D.x i₀ n)))
  x i n :=
    ((D.x (Fin.castLE (le_of_lt i₀.2) i) n).comp (Submodule.subtype (kerSub D i₀ n))).codRestrict
      (kerSub D i₀ (n + k (Fin.castLE (le_of_lt i₀.2) i))) (by
        intro v
        have hv : (D.x i₀ n) (v : D.M n) = 0 := v.2
        have hsw := D.x_swap (Fin.castLE (le_of_lt i₀.2) i) i₀ n (v : D.M n)
        rw [hv, map_zero] at hsw
        exact (D.ecast_eq_zero _ _).mp hsw.symm)
  comm i j n v := by
    apply Subtype.ext
    simp only [subtype_pcast]
    exact D.comm _ _ n (v : D.M n)

/-- The image of `x_{i₀}` in degree `n`. -/
abbrev cokerSub (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) : Submodule R (D.M n) :=
  LinearMap.range ((D.lcast (show n - k i₀ + k i₀ = n by omega)).comp (D.x i₀ (n - k i₀)))

theorem cokerSub_mem {D : GData (R := R) s k} {i₀ : Fin s} {n : ℤ} {v : D.M n} :
    v ∈ cokerSub D i₀ n ↔
      ∃ w : D.M (n - k i₀),
        D.ecast (show n - k i₀ + k i₀ = n by omega) ((D.x i₀ (n - k i₀)) w) = v := by
  rw [cokerSub, LinearMap.mem_range]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨w, by simpa only [LinearMap.comp_apply, GData.lcast_apply] using hw⟩
  · rintro ⟨w, hw⟩
    exact ⟨w, by simpa only [LinearMap.comp_apply, GData.lcast_apply] using hw⟩

/-- The image of `x_{i₀}` into the degree `n + k i₀` is the range of `x_{i₀}` on degree `n`. -/
theorem cokerSub_self (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) :
    cokerSub D i₀ (n + k i₀) = LinearMap.range (D.x i₀ n) := by
  ext v
  rw [cokerSub_mem, LinearMap.mem_range]
  constructor
  · rintro ⟨w, hw⟩
    refine ⟨D.ecast (show n + k i₀ - k i₀ = n by omega) w, ?_⟩
    rw [← hw, GData.x_ecast]
  · rintro ⟨w, rfl⟩
    refine ⟨D.ecast (show n = n + k i₀ - k i₀ by omega) w, ?_⟩
    rw [GData.x_ecast, GData.ecast_ecast]
    exact D.ecast_rfl _ _

/-- The Hilbert series of a graded family, with coefficients in `K(A₀)`. -/
abbrev hseries (D : GData (R := R) s k) : ℤ → K R := fun n => cls R (FgMod.mkOf R (D.M n))

/-- At level `0` a finitely generated module has only finitely many nonzero pieces. -/
theorem inGen_zero_span (D : GData (R := R) s k) {r : ℕ} (d : Fin r → ℤ) (g : ∀ i, D.M (d i))
    {n : ℤ} {v : D.M n} (h : InGen D 0 d g v) :
    v ∈ Submodule.span R (Set.range (fun i : {i : Fin r // d i = n} => (i.2 ▸ g i.1 : D.M n))) := by
  induction h with
  | base i => exact Submodule.subset_span ⟨⟨i, rfl⟩, rfl⟩
  | zero n => exact Submodule.zero_mem _
  | add ha hb iha ihb => exact Submodule.add_mem _ iha ihb
  | smul c ha ih => exact Submodule.smul_mem _ c ih
  | shift i hi a ih => exact absurd hi (by omega)

theorem isPoly_zero {D : GData (R := R) s k} {r : ℕ} {d : Fin r → ℤ} {g : ∀ i, D.M (d i)}
    (h : IsFgOver D 0 d g) : IsPoly (hseries (R := R) D) := by
  refine ⟨(∑ i : Fin r, (d i).natAbs) + 1, fun n hn => ?_⟩
  have hno : ∀ i, d i ≠ n := by
    intro i hi
    have h1 : d i ≤ ((d i).natAbs : ℤ) := Int.le_natAbs
    have h2 : (d i).natAbs ≤ ∑ j : Fin r, (d j).natAbs :=
      Finset.single_le_sum (f := fun j : Fin r => (d j).natAbs) (fun j _ => by omega) (Finset.mem_univ i)
    omega
  have hbot : genSub D 0 d g n = ⊥ := by
    refine le_antisymm ?_ bot_le
    intro v hv
    have hmem := inGen_zero_span D d g (n := n) hv
    have hempty : (Set.range (fun i : {i : Fin r // d i = n} => (i.2 ▸ g i.1 : D.M n))) = ∅ := by
      apply Set.not_nonempty_iff_eq_empty.mp
      rintro ⟨_, i, _⟩
      exact hno i.1 i.2
    rw [hempty, Submodule.span_empty] at hmem
    exact hmem
  haveI : Subsingleton (D.M n) := by
    have htop : (⊤ : Submodule R (D.M n)) = ⊥ := by rw [← h n, hbot]
    exact ⟨fun a b => by
      have ha : a ∈ (⊥ : Submodule R (D.M n)) := by rw [← htop]; exact Submodule.mem_top
      have hb : b ∈ (⊥ : Submodule R (D.M n)) := by rw [← htop]; exact Submodule.mem_top
      rw [Submodule.mem_bot] at ha hb
      rw [ha, hb]⟩
  exact cls_eq_zero_of_subsingleton R (D.M n)

/-- **The inductive step of Hilbert--Serre**: the coefficient identity together with the
induction hypothesis on the kernel and the cokernel gives polynomiality. -/
theorem hilbert_serre_step {m : ℕ} {k : Fin (m + 1) → ℕ} {D : GData (R := R) (m + 1) k}
    {Kd Ld : GData (R := R) m (fun i => k i.castSucc)}
    (hcoef : ∀ n : ℤ, hseries (R := R) D n - hseries (R := R) D (n - k (Fin.last m))
      = hseries (R := R) Ld n - hseries (R := R) Kd (n - k (Fin.last m)))
    (hK : IsPoly (prodFin m (fun i : Fin m => ((k i.castSucc : ℕ) : ℤ)) (hseries (R := R) Kd)))
    (hL : IsPoly (prodFin m (fun i : Fin m => ((k i.castSucc : ℕ) : ℤ)) (hseries (R := R) Ld))) :
    IsPoly (prodFin (m + 1) (fun i : Fin (m + 1) => ((k i : ℕ) : ℤ)) (hseries (R := R) D)) := by
  rw [prodFin_succ]
  rw [oneMinus_prodFin]
  have hEq : oneMinus (((k (Fin.last m) : ℕ)) : ℤ) (hseries (R := R) D)
      = hseries (R := R) Ld - TMul (((k (Fin.last m) : ℕ)) : ℤ) (hseries (R := R) Kd) := by
    funext n
    simpa only [oneMinus, Pi.sub_apply, TMul] using hcoef n
  rw [hEq, map_sub, prodFin_TMul]
  exact hL.sub (hK.tmul _)


/-- Multiplication by a variable preserves the image of the last one: this is what makes the
multiplications descend to the cokernel pieces. -/
theorem cokerSub_le_comap (D : GData (R := R) s k) (i₀ : Fin s) (i : Fin (i₀ : ℕ))
    (n : ℤ) :
    cokerSub D i₀ n ≤ Submodule.comap (D.x (Fin.castLE (le_of_lt i₀.2) i) n)
      (cokerSub D i₀ (n + k (Fin.castLE (le_of_lt i₀.2) i))) := by
  intro v hv
  rw [Submodule.mem_comap]
  obtain ⟨w, hw⟩ := (cokerSub_mem (D := D) (i₀ := i₀) (n := n)).mp hv
  refine (cokerSub_mem (D := D) (i₀ := i₀)
    (n := n + k (Fin.castLE (le_of_lt i₀.2) i))).mpr
    ⟨D.ecast (show n - k i₀ + k (Fin.castLE (le_of_lt i₀.2) i)
        = n + k (Fin.castLE (le_of_lt i₀.2) i) - k i₀ by omega)
      ((D.x (Fin.castLE (le_of_lt i₀.2) i) (n - k i₀)) w), ?_⟩
  rw [← hw]
  rw [D.x_ecast i₀]
  rw [GData.ecast_ecast]
  rw [GData.x_swap]
  rw [GData.ecast_ecast]
  rw [GData.x_ecast]

/-- Quotient classes: the class map is additive. -/
@[simp] theorem qmk_zero {M : Type u} [AddCommGroup M] [Module R M] (p : Submodule R M) :
    (Submodule.Quotient.mk (0 : M) : M ⧸ p) = 0 := by
  rw [← Submodule.mkQ_apply]; exact map_zero p.mkQ

@[simp] theorem qmk_add {M : Type u} [AddCommGroup M] [Module R M] (p : Submodule R M) (a b : M) :
    (Submodule.Quotient.mk (a + b) : M ⧸ p) = Submodule.Quotient.mk a + Submodule.Quotient.mk b := by
  simp only [← Submodule.mkQ_apply]; exact map_add p.mkQ a b

@[simp] theorem qmk_smul {M : Type u} [AddCommGroup M] [Module R M] (p : Submodule R M) (c : R)
    (a : M) :
    (Submodule.Quotient.mk (c • a) : M ⧸ p) = c • Submodule.Quotient.mk a := by
  simp only [← Submodule.mkQ_apply]; exact map_smul p.mkQ c a

/-- The cokernel pieces `M ⧸ x_{i₀}M`, as graded data over `A₀[x_0,…,x_{i₀-1}]`. -/
abbrev LData (D : GData (R := R) s k) (i₀ : Fin s) :
    GData (R := R) (i₀ : ℕ) (fun i => k (Fin.castLE (le_of_lt i₀.2) i)) where
  M n := D.M n ⧸ cokerSub D i₀ n
  str1 n := inferInstance
  str2 n := inferInstance
  str3 n := Module.Finite.quotient R (cokerSub D i₀ n)
  x i n :=
    Submodule.mapQ (cokerSub D i₀ n) (cokerSub D i₀ (n + k (Fin.castLE (le_of_lt i₀.2) i)))
      (D.x (Fin.castLE (le_of_lt i₀.2) i) n) (cokerSub_le_comap D i₀ i n)
  comm i j n v := by
    obtain ⟨u, rfl⟩ := Submodule.mkQ_surjective (cokerSub D i₀ n) v
    simp only [Submodule.mkQ_apply, Submodule.mapQ_apply, quot_pcast]
    rw [D.comm (Fin.castLE (le_of_lt i₀.2) i) (Fin.castLE (le_of_lt i₀.2) j) n u]

/-- `x_{i₀}` dies in the cokernel pieces. -/
theorem x_mem_cokerSub (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) (u : D.M n) :
    (D.x i₀ n) u ∈ cokerSub D i₀ (n + k i₀) := by
  rw [cokerSub_self]
  exact LinearMap.mem_range_self _ u

/-- The descended multiplication on the cokernel pieces, on classes. -/
theorem LData_x_mk (D : GData (R := R) s k) (i₀ : Fin s) (i : Fin s)
    (hi : (i : ℕ) < (i₀ : ℕ)) (n : ℤ) (w : D.M n) :
    ((LData D i₀).x ⟨i, hi⟩ n) (Submodule.Quotient.mk w : (LData D i₀).M n)
      = Submodule.Quotient.mk ((D.x i n) w) :=
  Submodule.mapQ_apply (cokerSub D i₀ n)
    (cokerSub D i₀ (n + k (Fin.castLE (le_of_lt i₀.2) ⟨i, hi⟩)))
    (D.x (Fin.castLE (le_of_lt i₀.2) ⟨i, hi⟩) n)
    (h := cokerSub_le_comap D i₀ ⟨i, hi⟩ n) (x := w)

/-- The last multiplication dies in the cokernel pieces. -/
theorem LData_mk_x_last (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) (w : D.M n) :
    (Submodule.Quotient.mk ((D.x i₀ n) w) : (LData D i₀).M (n + k i₀)) = 0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr (x_mem_cokerSub D i₀ n w)

/-- The generators of the cokernel pieces. -/
theorem inGen_LData (D : GData (R := R) s k) (i₀ : Fin s) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ a, D.M (d a)) {n : ℤ} {u : D.M n} (hu : InGen D ((i₀ : ℕ) + 1) d g u) :
    InGen (LData D i₀) (i₀ : ℕ) d (fun a => Submodule.Quotient.mk (g a))
      (Submodule.Quotient.mk u : (LData D i₀).M n) := by
  induction hu with
  | base a => exact InGen.base a
  | zero n => rw [qmk_zero]; exact InGen.zero n
  | add ha hb iha ihb => rw [qmk_add]; exact InGen.add iha ihb
  | smul c ha ih => rw [qmk_smul]; exact InGen.smul c ih
  | shift i hi a ih =>
    by_cases hlt : (i : ℕ) < (i₀ : ℕ)
    · rw [← LData_x_mk D i₀ i hlt]
      exact InGen.shift ⟨i, hlt⟩ hlt ih
    · have hii : i = i₀ := Fin.ext (by omega)
      rw [hii, LData_mk_x_last D i₀]
      exact InGen.zero _

/-- Finite generation passes to the cokernel pieces. -/
theorem isFgOver_LData (D : GData (R := R) s k) (i₀ : Fin s) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ a, D.M (d a)) (h : IsFgOver D ((i₀ : ℕ) + 1) d g) :
    IsFgOver (LData D i₀) (i₀ : ℕ) d (fun a => Submodule.Quotient.mk (g a)) := by
  intro n
  rw [Submodule.eq_top_iff']
  intro y
  obtain ⟨u, rfl⟩ := Submodule.mkQ_surjective (cokerSub D i₀ n) y
  have hu : u ∈ genSub D ((i₀ : ℕ) + 1) d g n := by rw [h n]; exact Submodule.mem_top
  exact inGen_LData D i₀ d g hu

/-- Isomorphic finitely generated modules have the same class in `K(R)`. -/
theorem cls_of_linearEquiv {M N : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] (e : M ≃ₗ[R] N) :
    cls R (FgMod.mkOf R M) = cls R (FgMod.mkOf R N) := by
  haveI : Module.Finite R ↥(⊥ : Submodule R M) := Module.Finite.iff_fg.mpr Submodule.fg_bot
  haveI : Subsingleton ↥(⊥ : Submodule R M) :=
    ⟨fun a b => by
      have ha : (a : M) = 0 := (Submodule.mem_bot R).mp a.2
      have hb : (b : M) = 0 := (Submodule.mem_bot R).mp b.2
      exact Subtype.ext (by rw [ha, hb])⟩
  have hinj : Function.Injective (0 : ↥(⊥ : Submodule R M) →ₗ[R] M) := by
    intro a b _
    exact Subsingleton.elim a b
  have hex : Function.Exact (0 : ↥(⊥ : Submodule R M) →ₗ[R] M) e.toLinearMap := by
    rw [LinearMap.exact_iff, LinearMap.ker_eq_bot.mpr e.injective, LinearMap.range_zero]
  have h := cls_rel' (R := R) (L := FgMod.mkOf R ↥(⊥ : Submodule R M)) (M := FgMod.mkOf R M)
    (N := FgMod.mkOf R N) (0 : ↥(⊥ : Submodule R M) →ₗ[R] M) e.toLinearMap hinj
    e.surjective hex
  have hz : cls R (FgMod.mkOf R ↥(⊥ : Submodule R M)) = 0 :=
    cls_eq_zero_of_subsingleton R ↥(⊥ : Submodule R M)
  rw [hz, add_zero] at h
  exact (sub_eq_zero.mp h).symm

/-- The Hilbert series is invariant under propositionally equal degrees. -/
theorem hseries_cast (D : GData (R := R) s k) {a b : ℤ} (h : a = b) :
    hseries (R := R) D a = hseries (R := R) D b := by
  subst h; rfl

/-- **The four term Hilbert-class identity** attached to
`0 → K_{n-k} → M_{n-k} → M_n → L_n → 0`. -/
theorem hseries_coef (D : GData (R := R) s k) (i₀ : Fin s) (n : ℤ) :
    hseries (R := R) D n - hseries (R := R) D (n - k i₀)
      = hseries (R := R) (LData D i₀) n - hseries (R := R) (KData D i₀) (n - k i₀) := by
  set m := n - k i₀ with hm
  have hex1 : Function.Exact (Submodule.subtype (kerSub D i₀ m)) (D.x i₀ m) := by
    rw [LinearMap.exact_iff, Submodule.range_subtype]
    rfl
  have hex2 : Function.Exact (D.x i₀ m) ((cokerSub D i₀ (m + k i₀)).mkQ) := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ, cokerSub_self]
  have hraw := cls_four R (FgMod.mkOf R ↥(kerSub D i₀ m)) (FgMod.mkOf R (D.M m))
    (FgMod.mkOf R (D.M (m + k i₀)))
    (FgMod.mkOf R ((LData D i₀).M (m + k i₀)))
    (Submodule.subtype (kerSub D i₀ m)) (D.x i₀ m) ((cokerSub D i₀ (m + k i₀)).mkQ)
    hex1 hex2 Subtype.coe_injective (Submodule.mkQ_surjective _)
  have hfour : hseries (R := R) D (m + k i₀) - hseries (R := R) D m
      = hseries (R := R) (LData D i₀) (m + k i₀) - hseries (R := R) (KData D i₀) m := by
    have hC : hseries (R := R) D (m + k i₀)
        = hseries (R := R) D m - hseries (R := R) (KData D i₀) m
          + hseries (R := R) (LData D i₀) (m + k i₀) := by
      rw [hraw]; abel
    rw [hC]; abel
  rw [hseries_cast D (a := n) (b := m + k i₀) (by omega),
    hseries_cast (LData D i₀) (a := n) (b := m + k i₀) (by omega)]
  exact hfour

/-- The kernel pieces are stable under the earlier multiplications. -/
theorem kerSub_closed (D : GData (R := R) s k) (i₀ : Fin s) (i : Fin s)
    (n : ℤ) (v : D.M n) (hv : v ∈ kerSub D i₀ n) :
    (D.x i n) v ∈ kerSub D i₀ (n + k i) := by
  have hv' : (D.x i₀ n) v = 0 := hv
  have hsw := D.x_swap i i₀ n v
  rw [hv', map_zero] at hsw
  exact (D.ecast_eq_zero _ _).mp hsw.symm

/-- Elements generated by generators inside the kernel stay inside the kernel. -/
theorem mem_kerSub_of_inGen (D : GData (R := R) s k) (i₀ : Fin s) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ a, D.M (d a)) (hg : ∀ a, g a ∈ kerSub D i₀ (d a)) {n : ℤ} {v : D.M n}
    (h : InGen D (i₀ : ℕ) d g v) : v ∈ kerSub D i₀ n :=
  genSub_le_of D (i₀ : ℕ) d g (kerSub D i₀) hg
    (fun j _ n' v' hv' => kerSub_closed D i₀ j n' v' hv') h

/-- Generation transfers from `M` to the kernel pieces. -/
theorem inGen_KData (D : GData (R := R) s k) (i₀ : Fin s) {r : ℕ} (d : Fin r → ℤ)
    (g : ∀ a, D.M (d a)) (hg : ∀ a, g a ∈ kerSub D i₀ (d a)) :
    ∀ {n : ℤ} {v : D.M n}, InGen D (i₀ : ℕ) d g v → ∀ (hv : v ∈ kerSub D i₀ n),
      InGen (KData D i₀) (i₀ : ℕ) d
        (fun a => (⟨g a, hg a⟩ : (KData D i₀).M (d a))) (⟨v, hv⟩ : (KData D i₀).M n) := by
  intro n v h
  induction h with
  | base a => intro hv; exact (InGen.base a).congr (Subtype.ext rfl)
  | zero n => intro hv; exact (InGen.zero n).congr (Subtype.ext rfl)
  | add ha hb iha ihb =>
    intro hv
    have ha' := mem_kerSub_of_inGen D i₀ d g hg ha
    have hb' := mem_kerSub_of_inGen D i₀ d g hg hb
    exact (InGen.add (iha ha') (ihb hb')).congr (Subtype.ext rfl)
  | smul c ha ih =>
    intro hv
    have ha' := mem_kerSub_of_inGen D i₀ d g hg ha
    exact (InGen.smul c (ih ha')).congr (Subtype.ext rfl)
  | shift i hi a ih =>
    intro hv
    have hmem := mem_kerSub_of_inGen D i₀ d g hg a
    exact (InGen.shift (i := ⟨i, hi⟩) hi (ih hmem)).congr (Subtype.ext rfl)

/-- **Noetherian input.**  For a Noetherian graded ring `A = A₀[x_0,…]` every graded
submodule of a finitely generated graded module that is killed by `x_{i₀}` is finitely
generated over `A₀[x_0,…,x_{i₀-1}]` (A–M 7.2 and 7.3).  This is the Noetherian hypothesis of
Theorem 11.1/Exercise 11.5, stated for our abstract graded data. -/
def NoethInput (D : GData (R := R) s k) : Prop :=
  ∀ (i₀ : Fin s), ∃ (r : ℕ) (d : Fin r → ℤ) (g : ∀ a, (KData D i₀).M (d a)),
    IsFgOver (KData D i₀) (i₀ : ℕ) d g

/-- **Graded Noetherianity.**  Every graded subfamily of `M` killed by `x_{i₀}` is finitely
generated over `A₀[x_0,…,x_{i₀-1}]`.  For a Noetherian graded ring `A = A₀[x_0,…]` and a
finitely generated graded `A`-module this is A–M 7.2 together with 7.3; it is the content of
the hypothesis "`A` is a Noetherian graded ring" of Theorem 11.1. -/
def NoetherianGraded (D : GData (R := R) s k) : Prop :=
  ∀ (i₀ : Fin s) (N : ∀ n, Submodule R (D.M n)),
    (∀ (i : Fin s) (n : ℤ) (v : D.M n), v ∈ N n → (D.x i n) v ∈ N (n + k i)) →
    (∀ (n : ℤ) (v : D.M n), v ∈ N n → (D.x i₀ n) v = 0) →
    ∃ (r : ℕ) (d : Fin r → ℤ) (g : ∀ a, D.M (d a)),
      (∀ a, g a ∈ N (d a)) ∧ ∀ n, N n ≤ genSub D (i₀ : ℕ) d g n

/-- A sanity check: graded Noetherianity holds whenever the multiplications are injective
(all kernels vanish, so the empty family generates). -/
theorem noetherianGraded_of_injective (D : GData (R := R) s k)
    (h : ∀ (i : Fin s) (n : ℤ), Function.Injective (D.x i n)) : NoetherianGraded D := by
  intro i₀ N _ hkill
  refine ⟨0, (fun i => i.elim0), (fun a => a.elim0), (fun a => a.elim0), fun n => ?_⟩
  intro v hv
  have hv0 : v = 0 := by
    apply h i₀ n
    rw [map_zero]
    exact hkill n v hv
  rw [hv0]
  exact InGen.zero n

/-- Graded Noetherianity yields the kernel-generation used in the induction. -/
theorem noethInput_of_noetherian (D : GData (R := R) s k) (h : NoetherianGraded D) :
    NoethInput D := by
  intro i₀
  obtain ⟨r, d, g, hg, hgen⟩ := h i₀ (kerSub D i₀)
    (fun i n v hv => kerSub_closed D i₀ i n v hv) (fun n v hv => hv)
  refine ⟨r, d, (fun a => (⟨g a, hg a⟩ : (KData D i₀).M (d a))), fun n => ?_⟩
  rw [Submodule.eq_top_iff']
  intro y
  exact inGen_KData D i₀ d g hg (hgen n y.2) y.2

/-- **Atiyah–Macdonald, Theorem 11.1 reformulated in `K(A₀)` (Exercise 11.5).**
For graded data with `M_n` finitely generated over `A₀`, finitely generated over
`A₀[x_0,…,x_{m-1}]`, the additive-class Hilbert series
`H_M(t) = Σ_n [M_n] t^n ∈ K(A₀)[[t]]` satisfies `∏_{i<m}(1 - t^{k_i})·H_M(t) ∈ K(A₀)[t]`. -/
theorem hilbert_serre_KM
    (hnoeth : ∀ (s : ℕ) (k : Fin s → ℕ) (D : GData (R := R) s k), NoethInput D) :
    ∀ (m : ℕ) (k : Fin m → ℕ) (D : GData (R := R) m k) (r : ℕ) (d : Fin r → ℤ)
      (g : ∀ i, D.M (d i)),
      IsFgOver D m d g →
      IsPoly (prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ)) (hseries (R := R) D)) := by
  intro m
  induction m with
  | zero => intro k D r d g hfg; exact isPoly_zero hfg
  | succ m ih =>
    intro k D r d g hfg
    have hi₀ : m < m + 1 := Nat.lt_succ_self m
    obtain ⟨rK, dK, gK, hKfg⟩ := hnoeth (m + 1) k D ⟨m, hi₀⟩
    have hLfg : IsFgOver (LData D ⟨m, hi₀⟩) m d (fun a => Submodule.Quotient.mk (g a)) :=
      isFgOver_LData D ⟨m, hi₀⟩ d g hfg
    exact hilbert_serre_step (Kd := KData D ⟨m, hi₀⟩) (Ld := LData D ⟨m, hi₀⟩)
      (fun n => hseries_coef D ⟨m, hi₀⟩ n)
      (ih (fun i => k i.castSucc) (KData D ⟨m, hi₀⟩) rK dK gK hKfg)
      (ih (fun i => k i.castSucc) (LData D ⟨m, hi₀⟩) r d (fun a => Submodule.Quotient.mk (g a))
        hLfg)

end Kernels

/-- **Atiyah–Macdonald Theorem 11.1 (Hilbert–Serre), classical form**, deduced from the
`K(A₀)` form: for every additive function `λ` on finitely generated `A₀`-modules with values in
an abelian group, `Σ_n λ(M_n) t^n = f(t)/∏_{i<m}(1 - t^{k_i})` with `f` a polynomial. -/
theorem hilbert_serre_additive [IsNoetherianRing R]
    (hnoeth : ∀ (s : ℕ) (k : Fin s → ℕ) (D : GData (R := R) s k), NoethInput D)
    {G : Type*} [AddCommGroup G] (lam : FgMod R → G)
    (hadd : ∀ E : SES R, lam E.N - lam E.M + lam E.L = 0) :
    ∀ (m : ℕ) (k : Fin m → ℕ) (D : GData (R := R) m k) (r : ℕ) (d : Fin r → ℤ)
      (g : ∀ i, D.M (d i)),
      IsFgOver D m d g →
      IsPoly (prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ))
        (fun n => lam (FgMod.mkOf R (D.M n)))) := by
  obtain ⟨φ, hφ⟩ := K_lift R lam hadd
  intro m k D r d g hfg
  have h := hilbert_serre_KM (R := R) hnoeth m k D r d g hfg
  have h2 : IsPoly (fun n => φ (prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ))
      (hseries (R := R) D) n)) := h.map φ
  rw [prodFin_map] at h2
  refine h2.congr fun n => ?_
  refine congrArg (fun z => prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ)) z n) ?_
  funext j
  exact (hφ (FgMod.mkOf R (D.M j))).symm


/-- **Atiyah–Macdonald, Exercise 11.5** (Theorem 11.1 reformulated in `K(A₀)`), stated with
the Noetherian hypothesis of Theorem 11.1 itself: for every graded module over a Noetherian
graded ring `A₀[x_0,…,x_{m-1}]` whose pieces are finitely generated over `A₀` and which is
finitely generated in the graded sense, the additive-class Hilbert series
`H_M(t) = Σ_n [M_n] t^n ∈ K(A₀)[[t]]` satisfies `∏_{i<m}(1-t^{k_i})·H_M(t) ∈ K(A₀)[t]`. -/
theorem hilbert_serre [IsNoetherianRing R]
    (hnoeth : ∀ (s : ℕ) (k : Fin s → ℕ) (D : GData (R := R) s k), NoetherianGraded D) :
    ∀ (m : ℕ) (k : Fin m → ℕ) (D : GData (R := R) m k) (r : ℕ) (d : Fin r → ℤ)
      (g : ∀ i, D.M (d i)),
      IsFgOver D m d g →
      IsPoly (prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ)) (hseries (R := R) D)) :=
  hilbert_serre_KM fun s k D => noethInput_of_noetherian D (hnoeth s k D)

/-- **Atiyah–Macdonald, Theorem 11.1 (classical form)** from the Noetherian hypothesis:
for every additive function `λ` on finitely generated `A₀`-modules,
`Σ_n λ(M_n) t^n = f(t)/∏_{i<m}(1-t^{k_i})` with `f` a polynomial. -/
theorem hilbert_serre_classical [IsNoetherianRing R]
    (hnoeth : ∀ (s : ℕ) (k : Fin s → ℕ) (D : GData (R := R) s k), NoetherianGraded D)
    {G : Type*} [AddCommGroup G] (lam : FgMod R → G)
    (hadd : ∀ E : SES R, lam E.N - lam E.M + lam E.L = 0) :
    ∀ (m : ℕ) (k : Fin m → ℕ) (D : GData (R := R) m k) (r : ℕ) (d : Fin r → ℤ)
      (g : ∀ i, D.M (d i)),
      IsFgOver D m d g →
      IsPoly (prodFin m (fun i : Fin m => ((k i : ℕ) : ℤ))
        (fun n => lam (FgMod.mkOf R (D.M n)))) :=
  hilbert_serre_additive (R := R) (fun s k D => noethInput_of_noetherian D (hnoeth s k D)) lam hadd


end AtiyahMcdonald69.Ex_11_5

