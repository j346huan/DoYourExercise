/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (Addison–Wesley, 1969),
Chapter 5, Exercise 18.

Source statement (Chapter 5, Exercises, p. 70 of the original text):

  "18. Let k be a field and let B be a finitely generated k-algebra. Suppose that B
   is a field. Then B is a finite algebraic extension of k. (This is another version of
   Hilbert's Nullstellensatz. The following proof is due to Zariski. For other proofs,
   see (5.24), (7.9).)"

The statement is Zariski's lemma: a field which is finitely generated as an algebra over
a field `k` is a finite (hence algebraic) extension of `k`.

Natural proof (DoYourExercise):
  https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-5-18
It argues: by Exercise 5.16 (Noether normalization) `B` is integral over a polynomial
subalgebra `k[y₁,…,y_r]` with `y₁,…,y_r` algebraically independent; since `B` is a field,
Proposition 5.7 makes `k[y₁,…,y_r]` a field, forcing `r = 0`; so `B` is algebraic over `k`,
and as `B` is generated over `k` by finitely many algebraic elements it is finite over `k`.

Omitted hypotheses/constructions recovered for the formalisation:
* `B` a "finitely generated k-algebra" is `Algebra.FiniteType k B`, i.e. `B` is generated
  as a `k`-algebra by a finite set (this is stated concretely below in
  `solution_of_finset_generators`).
* `B` a field is `[Field B]`, and `k` a field is `[Field k]`.  With both fields the
  structure map `k → B` is automatically injective (a field has no proper nonzero ideal),
  so `B` is a genuine field extension of `k`; no extra hypothesis is needed.
* "finite algebraic extension" is formalised as `Module.Finite k B` (equivalently
  `FiniteDimensional k B`) together with `Algebra.IsAlgebraic k B`.  Over a field, finite
  implies algebraic, so the two components are proved together but stated separately.
* No finiteness or infiniteness assumption on `k` is used; the restricted proof of
  Exercise 5.16 that assumes `k` infinite is not needed (and Exercise 5.18 does not
  inherit that assumption: the Noether normalization lemma used below is proved in
  Mathlib for an arbitrary field, and the second proof is completely independent of it).
-/
import Mathlib.RingTheory.NoetherNormalization
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.Algebraic.MvPolynomial

namespace AtiyahMcdonald69.Ex_5_18

universe u v

variable {k : Type u} {B : Type v}

section FiniteGeneration

variable [CommRing k] [CommRing B] [Algebra k B]

/-- The hypothesis "finitely generated `k`-algebra" is literally this: the algebra is
generated by a finite set of elements.  This records that passing to the Mathlib class
`Algebra.FiniteType` does not weaken the statement of the exercise. -/
theorem finiteType_iff_exists_finset :
    Algebra.FiniteType k B ↔ ∃ s : Finset B, Algebra.adjoin k (s : Set B) = ⊤ :=
  ⟨fun h => h.out, fun ⟨s, hs⟩ => ⟨s, hs⟩⟩

end FiniteGeneration

section Sharpness

variable [Field k]

/-- The hypothesis that `B` is a field is not redundant: `k[X]` is a finitely generated
`k`-algebra (so the other hypothesis of Exercise 5.18 holds) but is not a finite
`k`-module, since `X` is transcendental over `k`. -/
theorem not_finite_mvPolynomial_one : ¬ Module.Finite k (MvPolynomial (Fin 1) k) := by
  intro h
  let _ : Module.Finite k (MvPolynomial (Fin 1) k) := h
  exact MvPolynomial.transcendental_X k 0
    (Algebra.IsAlgebraic.isAlgebraic (MvPolynomial.X (0 : Fin 1)))

end Sharpness

section Main

variable [Field k] [Field B] [Algebra k B]

/-! ### First proof: Noether normalization plus Proposition 5.7

This follows the route of the natural proof.  Noether normalization is applied as
`exists_integral_inj_algHom_of_fg`: for a finitely generated `k`-algebra `B` there are
`s : ℕ` and an injective integral `k`-algebra map `k[X₀,…,X_{s-1}] → B`.
Since `B` is a field and this map is injective and integral, Proposition 5.7
(`isField_of_isIntegral_of_isField`) shows that `k[X₀,…,X_{s-1}]` is a field, which forces
`s = 0`.  Then the structure map `k → B` is the composite of the surjection
`k → k[X₀,…,X_{s-1}]` (surjective because `s = 0`) with the integral map to `B`; hence it
is integral, and `B`, being finitely generated over `k`, is finite over `k`. -/

/-- Zariski's lemma, proved along the lines of the natural proof of Exercise 5.18:
a finitely generated `k`-algebra which is a field is a finite `k`-module. -/
theorem finite_of_finiteType_of_isField_via_noetherNormalization
    [Algebra.FiniteType k B] : Module.Finite k B := by
  obtain ⟨s, g, hinj, hint⟩ := exists_integral_inj_algHom_of_fg k B
  let _ : Algebra (MvPolynomial (Fin s) k) B := g.toRingHom.toAlgebra
  -- `B` is integral over `k[X₀,…,X_{s-1}]`
  have hint' : Algebra.IsIntegral (MvPolynomial (Fin s) k) B := ⟨hint⟩
  -- Proposition 5.7: an integral extension of a field is a field
  have hfield : IsField (MvPolynomial (Fin s) k) :=
    isField_of_isIntegral_of_isField hinj (Field.toIsField B)
  -- hence the number of variables must be zero
  have hs0 : s = 0 := by
    by_contra h
    have hpos : 0 < s := Nat.pos_of_ne_zero h
    let i : Fin s := ⟨0, hpos⟩
    -- in a field every non-zero element is a unit, but `X i` cannot be one
    obtain ⟨b, hb⟩ := hfield.mul_inv_cancel (MvPolynomial.X_ne_zero i)
    have h1 := congr_arg (MvPolynomial.eval (fun _ : Fin s => (0 : k))) hb
    simp at h1
  subst hs0
  -- `k → k[X₀]` is surjective when there are no variables, hence integral
  have hC : RingHom.IsIntegral (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k) :=
    RingHom.isIntegral_of_surjective _ (MvPolynomial.C_surjective (Fin 0))
  -- composing with the integral map `k[X₀] → B` gives integrality of `k → B`
  have hcomp : (g.toRingHom.comp (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k)).IsIntegral :=
    RingHom.IsIntegral.trans _ _ hC hint
  have heq : (g.toRingHom.comp (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k)) =
      algebraMap k B := by
    ext x
    exact g.commutes x
  have hB : Algebra.IsIntegral k B := algebraMap_isIntegral_iff.mp (heq ▸ hcomp)
  -- integral and finitely generated over a field implies finite
  exact Algebra.IsIntegral.finite

/-! ### Second proof: via Mathlib's Zariski lemma for Jacobson rings

Mathlib's `finite_of_finite_type_of_isJacobsonRing` states Zariski's lemma in the form:
a field which is a finitely generated algebra over a Jacobson ring is finite over it.
A field is a Jacobson ring because it is Artinian.  This gives a second, logically
independent derivation of the same statement. -/

/-- Zariski's lemma for a finitely generated algebra over a field which is itself a
field, deduced from Mathlib's Jacobson-ring form of Zariski's lemma. -/
theorem finite_of_finiteType_of_isField_via_jacobson
    [Algebra.FiniteType k B] : Module.Finite k B :=
  finite_of_finite_type_of_isJacobsonRing k B

/-- **Atiyah–Macdonald, Chapter 5, Exercise 18** (Zariski's lemma, weak Nullstellensatz).

Let `k` be a field and let `B` be a finitely generated `k`-algebra.  If `B` is a field,
then `B` is a finite algebraic extension of `k`: it is a finite `k`-module and every
element of `B` is algebraic over `k`. -/
theorem solution [Algebra.FiniteType k B] :
    Module.Finite k B ∧ Algebra.IsAlgebraic k B := by
  have h : Module.Finite k B := finite_of_finiteType_of_isField_via_noetherNormalization
  exact ⟨h, Algebra.IsAlgebraic.of_finite k B⟩

/-- Exercise 5.18, stated with `FiniteDimensional` ("finite extension").  This is the
same proposition as `solution`, since `FiniteDimensional k B` is by definition
`Module.Finite k B`. -/
theorem solution_finiteDimensional [Algebra.FiniteType k B] :
    FiniteDimensional k B ∧ Algebra.IsAlgebraic k B :=
  solution

/-- Exercise 5.18, proved independently through Mathlib's Jacobson-ring machinery. -/
theorem solution_via_jacobson [Algebra.FiniteType k B] :
    Module.Finite k B ∧ Algebra.IsAlgebraic k B := by
  have h : Module.Finite k B := finite_of_finiteType_of_isField_via_jacobson
  exact ⟨h, Algebra.IsAlgebraic.of_finite k B⟩

/-- Exercise 5.18 with the finite generation hypothesis made concrete: if the field `B`
is generated as a `k`-algebra by a finite set `s`, then `B` is a finite algebraic
extension of `k`.  (This is the form in which the exercise phrases its hypothesis.) -/
theorem solution_of_finset_generators (s : Finset B) (hs : Algebra.adjoin k (s : Set B) = ⊤) :
    Module.Finite k B ∧ Algebra.IsAlgebraic k B :=
  have : Algebra.FiniteType k B := ⟨s, hs⟩
  solution

/-- The word "extension" in the exercise: for two fields the structure map `k → B` is
injective, so `B` really is a field extension of `k`.  Combined with `solution` this
gives the full conclusion "`B` is a finite algebraic extension of `k`". -/
theorem solution_is_extension [Algebra.FiniteType k B] :
    Function.Injective (algebraMap k B) ∧ Module.Finite k B ∧ Algebra.IsAlgebraic k B :=
  ⟨(algebraMap k B).injective, solution.1, solution.2⟩

/-- The case `n = 1` of the exercise (a field generated over `k` by a single element is a
finite algebraic extension of `k`), obtained as the special case `s = {x}` of
`solution_of_finset_generators`. -/
theorem solution_of_single_generator (x : B) (hx : Algebra.adjoin k ({x} : Set B) = ⊤) :
    Module.Finite k B ∧ Algebra.IsAlgebraic k B :=
  solution_of_finset_generators {x} (by simpa using hx)

end Main

/-! ### Axiom check

The following commands verify that no `sorry`, no custom axiom and no extra classical
principle is used by the public results. -/

#print axioms AtiyahMcdonald69.Ex_5_18.finiteType_iff_exists_finset
#print axioms AtiyahMcdonald69.Ex_5_18.not_finite_mvPolynomial_one
#print axioms AtiyahMcdonald69.Ex_5_18.finite_of_finiteType_of_isField_via_noetherNormalization
#print axioms AtiyahMcdonald69.Ex_5_18.finite_of_finiteType_of_isField_via_jacobson
#print axioms AtiyahMcdonald69.Ex_5_18.solution
#print axioms AtiyahMcdonald69.Ex_5_18.solution_finiteDimensional
#print axioms AtiyahMcdonald69.Ex_5_18.solution_via_jacobson
#print axioms AtiyahMcdonald69.Ex_5_18.solution_of_finset_generators
#print axioms AtiyahMcdonald69.Ex_5_18.solution_is_extension
#print axioms AtiyahMcdonald69.Ex_5_18.solution_of_single_generator

end AtiyahMcdonald69.Ex_5_18
