/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 7, Exercise 23.
Verbatim textbook statement (Chapter 7, Exercises, p. 87):

  "23. Let `A` be a Noetherian ring, `f : A → B` a ring homomorphism of finite type (so that `B`
   is Noetherian). Let `X = Spec(A)`, `Y = Spec(B)` and let `f* : Y → X` be the mapping associated
   with `f`. Then the image under `f*` of a constructible subset `E` of `Y` is a constructible
   subset of `X`."

`f*` is the contraction `𝔭 ↦ f⁻¹(𝔭)`, i.e. `PrimeSpectrum.comap f`, and `constructible` has the
meaning fixed in Exercise 20 of the same list: `F` is the smallest collection of subsets of a
topological space that contains all open subsets and is closed under finite intersections and
complements.  By Exercise 20(i), a set lies in `F` iff it is a finite union of sets of the form
`U ∩ C` with `U` open and `C` closed.

Natural-language statement and proof:
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-23

Proof strategy.  The mathematical content of the exercise is Chevalley's theorem on constructible
images; the formalization reduces it to Mathlib's Chevalley theorem for morphisms of finite
presentation (`PrimeSpectrum.isConstructible_comap_image`), after
* identifying the book's constructible sets with Mathlib's constructible sets (all open sets of
  `Spec B` are retrocompact, because `Spec B` is a Noetherian space), and
* observing that `B` is Noetherian (Hilbert's basis theorem) so that finite type and finite
  presentation agree, which is exactly the exercise's hypothesis.
-/
import Mathlib.RingTheory.Spectrum.Prime.Chevalley
import Mathlib.RingTheory.Spectrum.Prime.Noetherian
import Mathlib.Topology.Constructible
import Mathlib.Topology.LocallyClosed
import Mathlib.RingTheory.FinitePresentation

-- `letI`/`haveI` are the only way to install the `Algebra A B` structure of a ring homomorphism.
set_option linter.style.haveILetI false

namespace AtiyahMcdonald69.Ex_7_23

open Set Topology TopologicalSpace

variable {X : Type*} [TopologicalSpace X]

/-! ### The book's constructible sets (Exercise 7.20) -/

/-- The collection `F` of Exercise 7.20: the smallest set of subsets of `X` containing every open
set and closed under finite unions, finite intersections and complements, i.e. the Boolean
subalgebra of `Set X` generated by the open sets. -/
def IsBookConstructible (E : Set X) : Prop :=
  E ∈ BooleanSubalgebra.closure {U : Set X | IsOpen U}

namespace IsBookConstructible

variable {E F : Set X}

protected lemma isOpen (U : Set X) (hU : IsOpen U) : IsBookConstructible U :=
  BooleanSubalgebra.subset_closure hU

protected lemma empty : IsBookConstructible (∅ : Set X) := BooleanSubalgebra.bot_mem

protected lemma univ : IsBookConstructible (univ : Set X) := BooleanSubalgebra.top_mem

protected lemma union (hE : IsBookConstructible E) (hF : IsBookConstructible F) :
    IsBookConstructible (E ∪ F) := BooleanSubalgebra.sup_mem hE hF

protected lemma inter (hE : IsBookConstructible E) (hF : IsBookConstructible F) :
    IsBookConstructible (E ∩ F) := BooleanSubalgebra.inf_mem hE hF

protected lemma compl (hE : IsBookConstructible E) : IsBookConstructible Eᶜ :=
  BooleanSubalgebra.compl_mem hE

protected lemma isClosed (C : Set X) (hC : IsClosed C) : IsBookConstructible C := by
  have h : IsBookConstructible Cᶜ := IsBookConstructible.isOpen Cᶜ hC.isOpen_compl
  simpa using h.compl

protected lemma diff (hE : IsBookConstructible E) (hF : IsBookConstructible F) :
    IsBookConstructible (E \ F) := BooleanSubalgebra.sdiff_mem hE hF

protected lemma iUnion {ι : Type*} [Finite ι] (f : ι → Set X)
    (hf : ∀ i, IsBookConstructible (f i)) : IsBookConstructible (⋃ i, f i) :=
  BooleanSubalgebra.iSup_mem hf

protected lemma iInter {ι : Type*} [Finite ι] (f : ι → Set X)
    (hf : ∀ i, IsBookConstructible (f i)) : IsBookConstructible (⋂ i, f i) :=
  BooleanSubalgebra.iInf_mem hf

omit [TopologicalSpace X] in
protected lemma biUnion_finset {Y : Type*} [TopologicalSpace Y] {S : Finset (Set X)}
    {g : Set X → Set Y} (hg : ∀ L ∈ S, IsBookConstructible (g L)) :
    IsBookConstructible (⋃ L ∈ S, g L) := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using IsBookConstructible.empty
  | insert a s ha ih =>
    rw [Finset.set_biUnion_insert]
    exact (hg a (Finset.mem_insert_self a s)).union
      (ih fun L hL => hg L (Finset.mem_insert_of_mem hL))

protected lemma isLocallyClosed {L : Set X} (hL : IsLocallyClosed L) :
    IsBookConstructible L := by
  obtain ⟨U, C, hU, hC, rfl⟩ := hL
  exact (IsBookConstructible.isOpen U hU).inter (IsBookConstructible.isClosed C hC)

end IsBookConstructible

/-! ### Exercise 7.20(a): constructible = finite union of locally closed sets -/

/-- A set is a finite union of locally closed sets, i.e. of sets of the form `U ∩ C` with `U` open
and `C` closed.  This is the description of the book's constructible sets given in Exercise
7.20(a). -/
def IsFiniteUnionLocallyClosed (E : Set X) : Prop :=
  ∃ S : Finset (Set X), (∀ L ∈ S, IsLocallyClosed L) ∧ E = ⋃ L ∈ S, L

namespace IsFiniteUnionLocallyClosed

variable {E F : Set X}

protected lemma isLocallyClosed {L : Set X} (hL : IsLocallyClosed L) :
    IsFiniteUnionLocallyClosed L :=
  ⟨{L}, by simp [hL]⟩

protected lemma empty : IsFiniteUnionLocallyClosed (∅ : Set X) := ⟨∅, by simp⟩

protected lemma univ : IsFiniteUnionLocallyClosed (univ : Set X) := by
  refine ⟨{univ}, ?_, by simp⟩
  intro L hL
  rw [Finset.mem_singleton] at hL
  subst hL
  exact ⟨univ, univ, isOpen_univ, isClosed_univ, by simp⟩

protected lemma union (hE : IsFiniteUnionLocallyClosed E) (hF : IsFiniteUnionLocallyClosed F) :
    IsFiniteUnionLocallyClosed (E ∪ F) := by
  obtain ⟨S, hS, rfl⟩ := hE
  obtain ⟨T, hT, rfl⟩ := hF
  refine ⟨S ∪ T, ?_, by rw [Finset.set_biUnion_union]⟩
  intro L hL
  rcases Finset.mem_union.mp hL with h | h
  exacts [hS L h, hT L h]

protected lemma inter (hE : IsFiniteUnionLocallyClosed E) (hF : IsFiniteUnionLocallyClosed F) :
    IsFiniteUnionLocallyClosed (E ∩ F) := by
  obtain ⟨S, hS, rfl⟩ := hE
  obtain ⟨T, hT, rfl⟩ := hF
  refine ⟨(S.product T).image (fun p : Set X × Set X => p.1 ∩ p.2), ?_, ?_⟩
  · intro L hL
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hL
    exact (hS p.1 (Finset.mem_product.mp hp).1).inter (hT p.2 (Finset.mem_product.mp hp).2)
  · ext x
    simp only [Set.mem_inter_iff, Set.mem_iUnion, Finset.mem_image]
    constructor
    · rintro ⟨⟨a, ha, hxa⟩, b, hb, hxb⟩
      exact ⟨a ∩ b, ⟨(a, b), Finset.mem_product.mpr ⟨ha, hb⟩, rfl⟩, hxa, hxb⟩
    · rintro ⟨L, ⟨p, hp, rfl⟩, hxL⟩
      exact ⟨⟨p.1, (Finset.mem_product.mp hp).1, hxL.1⟩,
        p.2, (Finset.mem_product.mp hp).2, hxL.2⟩

protected lemma compl {L : Set X} (hL : IsLocallyClosed L) : IsFiniteUnionLocallyClosed Lᶜ := by
  obtain ⟨U, C, hU, hC, rfl⟩ := hL
  have h₁ : IsFiniteUnionLocallyClosed (Uᶜ : Set X) :=
    IsFiniteUnionLocallyClosed.isLocallyClosed
      ⟨univ, Uᶜ, isOpen_univ, isClosed_compl_iff.mpr hU, by simp⟩
  have h₂ : IsFiniteUnionLocallyClosed (Cᶜ : Set X) :=
    IsFiniteUnionLocallyClosed.isLocallyClosed
      ⟨Cᶜ, univ, hC.isOpen_compl, isClosed_univ, by simp⟩
  simpa [Set.compl_inter] using h₁.union h₂

protected lemma biInter_finset {S : Finset (Set X)} {g : Set X → Set X}
    (hg : ∀ L ∈ S, IsFiniteUnionLocallyClosed (g L)) :
    IsFiniteUnionLocallyClosed (⋂ L ∈ S, g L) := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using IsFiniteUnionLocallyClosed.univ
  | insert a s ha ih =>
    rw [Finset.set_biInter_insert]
    exact (hg a (Finset.mem_insert_self a s)).inter
      (ih fun L hL => hg L (Finset.mem_insert_of_mem hL))

end IsFiniteUnionLocallyClosed

/-- **Exercise 7.20(a).**  For a topological space `X` and `E ⊆ X`, `E` is constructible in the
sense of Exercise 7.20 iff `E` is a finite union of locally closed sets. -/
theorem isBookConstructible_iff_isFiniteUnionLocallyClosed {E : Set X} :
    IsBookConstructible E ↔ IsFiniteUnionLocallyClosed E := by
  constructor
  · intro hE
    refine BooleanSubalgebra.closure_bot_sup_induction
      (s := {U : Set X | IsOpen U}) (p := fun E _ => IsFiniteUnionLocallyClosed E)
      ?_ ?_ ?_ ?_ hE
    · intro U hU
      exact IsFiniteUnionLocallyClosed.isLocallyClosed ⟨U, univ, hU, isClosed_univ, by simp⟩
    · exact IsFiniteUnionLocallyClosed.empty
    · intro x _ y _ hx hy
      exact hx.union hy
    · intro x _ hx
      obtain ⟨S, hS, rfl⟩ := hx
      have hcompl : (⋃ L ∈ S, L)ᶜ = ⋂ L ∈ S, Lᶜ := by
        ext y
        simp
      rw [hcompl]
      exact IsFiniteUnionLocallyClosed.biInter_finset fun L hL =>
        IsFiniteUnionLocallyClosed.compl (hS L hL)
  · rintro ⟨S, hS, rfl⟩
    refine IsBookConstructible.biUnion_finset fun L hL => ?_
    obtain ⟨U, C, hU, hC, hLC⟩ := hS L hL
    rw [hLC]
    exact (IsBookConstructible.isOpen U hU).inter (IsBookConstructible.isClosed C hC)

/-! ### Comparison with Mathlib's `Topology.IsConstructible`

Mathlib's `IsConstructible` is the Boolean subalgebra generated by the *retrocompact* open sets.
In a Noetherian space every subset is compact, hence every open set is retrocompact, so the two
notions coincide. -/

/-- In a Noetherian space every subset is retrocompact. -/
lemma isRetrocompact_of_noetherianSpace [NoetherianSpace X] (E : Set X) : IsRetrocompact E :=
  fun _ _ _ ↦ NoetherianSpace.isCompact _

/-- In a Noetherian space, "retrocompact open" is the same as "open". -/
lemma isOpen_and_isRetrocompact_eq [NoetherianSpace X] :
    {U : Set X | IsOpen U} = {U : Set X | IsOpen U ∧ IsRetrocompact U} := by
  ext U
  exact ⟨fun hU ↦ ⟨hU, isRetrocompact_of_noetherianSpace U⟩, fun hU ↦ hU.1⟩

/-- In a Noetherian space, the constructible sets of Exercise 7.20 are exactly the constructible
sets of Mathlib. -/
theorem isBookConstructible_iff_isConstructible [NoetherianSpace X] {E : Set X} :
    IsBookConstructible E ↔ IsConstructible E := by
  unfold IsBookConstructible IsConstructible
  rw [isOpen_and_isRetrocompact_eq]

/-! ### Exercise 7.23 -/

variable {A B : Type*} [CommRing A] [CommRing B]

/-- **Atiyah–Macdonald, Exercise 7.23.**  Let `A` be a Noetherian ring and `f : A → B` a
homomorphism of finite type.  Then `f* : Spec B → Spec A` maps constructible sets into
constructible sets: for every constructible `E ⊆ Spec B`, the image `f*(E)` is a constructible
subset of `Spec A`. -/
theorem solution [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType)
    {E : Set (PrimeSpectrum B)} (hE : IsBookConstructible E) :
    IsBookConstructible (PrimeSpectrum.comap f '' E) := by
  -- `B` is a finitely generated `A`-algebra, hence Noetherian by Hilbert's basis theorem, so
  -- `Spec B` is a Noetherian space and every open subset of `Spec B` is retrocompact.
  haveI : IsNoetherianRing B := by
    letI : Algebra A B := f.toAlgebra
    haveI : Algebra.FiniteType A B := hf
    exact Algebra.FiniteType.isNoetherianRing A B
  rw [isBookConstructible_iff_isConstructible] at hE ⊢
  -- Over a Noetherian ring, finite type and finite presentation agree, and Chevalley's theorem
  -- gives that images of constructible sets under `Spec` of a finite presentation are again
  -- constructible.
  exact PrimeSpectrum.isConstructible_comap_image (RingHom.FinitePresentation.of_finiteType.mp hf) hE

/-- Exercise 7.23 in the literal form "`f*` maps constructible sets into constructible sets":
every constructible subset of `Spec B` has constructible image in `Spec A`. -/
theorem solution_forall [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType) :
    ∀ E : Set (PrimeSpectrum B), IsBookConstructible E →
      IsBookConstructible (PrimeSpectrum.comap f '' E) :=
  fun _ hE => solution hf hE

/-- Exercise 7.23 with the conclusion in the form of Exercise 7.20(a). -/
theorem solution_finiteUnion [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType)
    {E : Set (PrimeSpectrum B)} (hE : IsBookConstructible E) :
    IsFiniteUnionLocallyClosed (PrimeSpectrum.comap f '' E) :=
  isBookConstructible_iff_isFiniteUnionLocallyClosed.mp (solution hf hE)

/-- Exercise 7.23 in the `Algebra` formulation: if `B` is a finitely generated `A`-algebra and
`A` is Noetherian, then `Spec B → Spec A` maps constructible sets to constructible sets. -/
theorem solution_algebra [IsNoetherianRing A] (B : Type*) [CommRing B] [Algebra A B]
    [Algebra.FiniteType A B] {E : Set (PrimeSpectrum B)} (hE : IsBookConstructible E) :
    IsBookConstructible (PrimeSpectrum.comap (algebraMap A B) '' E) :=
  solution (RingHom.finiteType_algebraMap.mpr ‹Algebra.FiniteType A B›) hE

/-- The first reduction in the book's proof of Exercise 7.23: by Exercise 7.20 it suffices to
prove the claim for the locally closed sets `E = U ∩ C` with `U` open and `C` closed.  This
reduction is purely topological and needs no hypothesis on `f`. -/
theorem solution_of_locallyClosed {f : A →+* B}
    (h : ∀ (U C : Set (PrimeSpectrum B)), IsOpen U → IsClosed C →
      IsBookConstructible (PrimeSpectrum.comap f '' (U ∩ C)))
    {E : Set (PrimeSpectrum B)} (hE : IsBookConstructible E) :
    IsBookConstructible (PrimeSpectrum.comap f '' E) := by
  rw [isBookConstructible_iff_isFiniteUnionLocallyClosed] at hE
  obtain ⟨S, hS, rfl⟩ := hE
  have himg : PrimeSpectrum.comap f '' (⋃ L ∈ S, L) =
      ⋃ L ∈ S, PrimeSpectrum.comap f '' L := by
    ext x
    simp only [Set.mem_image, Set.mem_iUnion, exists_prop]
    exact ⟨fun ⟨y, ⟨L, hL, hy⟩, hxy⟩ => ⟨L, hL, y, hy, hxy⟩,
      fun ⟨L, hL, y, hy, hxy⟩ => ⟨y, ⟨L, hL, hy⟩, hxy⟩⟩
  rw [himg]
  refine IsBookConstructible.biUnion_finset fun L hL => ?_
  obtain ⟨U, C, hU, hC, hLC⟩ := hS L hL
  rw [hLC]
  exact h U C hU hC

/-! ### The cases of the exercise used in its proof -/

/-- The image of a locally closed subset of `Spec B` is constructible. -/
theorem isBookConstructible_image_isLocallyClosed [IsNoetherianRing A] {f : A →+* B}
    (hf : f.FiniteType) {L : Set (PrimeSpectrum B)} (hL : IsLocallyClosed L) :
    IsBookConstructible (PrimeSpectrum.comap f '' L) :=
  solution hf (IsBookConstructible.isLocallyClosed hL)

/-- The image of an open subset of `Spec B` is constructible. -/
theorem isBookConstructible_image_isOpen [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType)
    {U : Set (PrimeSpectrum B)} (hU : IsOpen U) :
    IsBookConstructible (PrimeSpectrum.comap f '' U) :=
  solution hf (IsBookConstructible.isOpen U hU)

/-- The image of a closed subset of `Spec B` (e.g. of `V(𝔭)`, as in the proof of Exercise 7.21)
is constructible. -/
theorem isBookConstructible_image_isClosed [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType)
    {C : Set (PrimeSpectrum B)} (hC : IsClosed C) :
    IsBookConstructible (PrimeSpectrum.comap f '' C) :=
  solution hf (IsBookConstructible.isClosed C hC)

/-- The image of a basic open set `D(g) ⊆ Spec B` is constructible. -/
theorem isBookConstructible_image_basicOpen [IsNoetherianRing A] {f : A →+* B}
    (hf : f.FiniteType) (g : B) :
    IsBookConstructible
      (PrimeSpectrum.comap f '' (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B))) :=
  isBookConstructible_image_isOpen hf (PrimeSpectrum.basicOpen g).2

/-- The image of the whole spectrum, i.e. the image of `f* : Spec B → Spec A`, is constructible. -/
theorem isBookConstructible_range [IsNoetherianRing A] {f : A →+* B} (hf : f.FiniteType) :
    IsBookConstructible (Set.range (PrimeSpectrum.comap f)) := by
  simpa using solution (f := f) hf (E := univ) IsBookConstructible.univ


/-! ### The reductions performed in the book's proof of Exercise 7.23 -/

/-- The first step of the book's proof ("replacing `B` by a homomorphic image"): for an ideal `I`
of `B`, the part of the image of `f*` coming from the closed set `V(I) = Spec(B ⧸ I)` is the image
of the spectrum of the quotient ring, i.e. it is the image of the map associated with the composite
`A → B → B ⧸ I`. -/
theorem image_zeroLocus_eq_range {f : A →+* B} (I : Ideal B) :
    PrimeSpectrum.comap f '' PrimeSpectrum.zeroLocus (I : Set B) =
      Set.range (PrimeSpectrum.comap ((Ideal.Quotient.mk I).comp f)) := by
  have h : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) =
      PrimeSpectrum.zeroLocus (I : Set B) := by
    rw [range_comap_of_surjective (B ⧸ I) (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
      Ideal.mk_ker]
  rw [← h, ← Set.image_univ, ← Set.image_comp,
    ← PrimeSpectrum.comap_comp f (Ideal.Quotient.mk I), Set.image_univ]

/-- The second step of the book's proof ("`E` is a finite union of open sets of the form
`Spec(B_g)`, hence reduce to the case `E = Y`"): the image of the basic open set `D(g) ⊆ Spec B` is
the image of the whole spectrum of the localization `B_g`. -/
theorem image_basicOpen_eq_range {f : A →+* B} (g : B) (S : Type*) [CommRing S] [Algebra B S]
    [IsLocalization.Away g S] :
    PrimeSpectrum.comap f '' (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B)) =
      Set.range (PrimeSpectrum.comap ((algebraMap B S).comp f)) := by
  rw [← PrimeSpectrum.localization_away_comap_range (R := B) S g, ← Set.image_univ,
    ← Set.image_comp, ← PrimeSpectrum.comap_comp f (algebraMap B S), Set.image_univ]

/-- In the spectrum of a Noetherian ring every open set is a finite union of basic open sets, the
form in which the book's proof uses quasi-compactness. -/
theorem exists_finset_basicOpen_eq_of_isOpen [IsNoetherianRing B] {U : Set (PrimeSpectrum B)}
    (hU : IsOpen U) :
    ∃ t : Finset B, U = ⋃ g ∈ t, (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B)) := by
  have hb : IsCompact U ∧ IsOpen U := ⟨NoetherianSpace.isCompact U, hU⟩
  obtain ⟨s, hs, hU'⟩ := (isCompact_open_iff_eq_finite_iUnion_of_isTopologicalBasis
    (fun g : B => (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B)))
    PrimeSpectrum.isTopologicalBasis_basic_opens (fun _ => NoetherianSpace.isCompact _) U).mp hb
  exact ⟨hs.toFinset, by rw [hU']; simp⟩

end AtiyahMcdonald69.Ex_7_23

