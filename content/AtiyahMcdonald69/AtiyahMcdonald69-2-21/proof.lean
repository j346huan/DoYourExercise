/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (Addison–Wesley, 1969),
Chapter 2 (Tensor products), Exercise 21 (page 33):

  "Let `(A_i, α_{ij})` be a directed system of `ℤ`-modules so that each `A_i` is a ring and each
   `α_{ij}` is a ring homomorphism.  Show that `A = lim A_i` inherits a ring structure so that each
   associated homomorphism `α_i` is a ring homomorphism.  In case `A = 0`, show that some `A_i = 0`."

(Statement recovered from the book text and from Exercise 14 of the same chapter, which constructs
the direct limit of a directed system of modules as `C/D`, where `C = ⨁ M_i` and `D` is the
submodule generated by the elements `x_i - µ_{ij}(x_i)` for `i ≤ j`.)

As elsewhere in the book, rings are commutative with `1`, and ring homomorphisms preserve `1`.  A
"directed system of `ℤ`-modules in which every member is a ring and every transition map is a ring
homomorphism" is exactly a directed system of commutative rings in the sense of `DirSystem` below:
the `ℤ`-module structure of `A i` is its additive group, and `α i j` is additive because it is a
ring homomorphism.

## What is formalized

* `DirSystem` : the data `(A i, α i j)` of a directed system of rings over a directed preorder `I`
  (`map_self`, `map_map` : compatibility of the transition maps).
* `DirSystem.Lim` : the direct limit, constructed as the quotient of the disjoint union `Σ i, A i`
  of the rings by the relation "the two elements agree after being mapped to a common later stage".
  The identifications are generated by `x i = α i j (x i)`, which is exactly the submodule `D` of
  Exercise 14 (there is a canonical bijection between this quotient and `(⨁ i, A i)/D`, induced by
  the two maps `Σ i, A i → ⨁ i, A i ⧸ D` and `⨁ i, A i → lim A i`, and the two composites are the
  identity because they are the identity on the classes of the generators).  That comparison is not
  formalized here; instead the universal property `existsUnique_lift` is proved, which
  characterizes the direct limit up to a unique isomorphism.
* `DirSystem.of` : the canonical maps `α i : A i → lim A_i`, with `of_eq_iff` ("two elements have
  the same class iff they agree at a common later stage"), `of_map` (`α j ∘ α i j = α i`),
  `exists_of` (Exercise 15 (a)) and `of_eq_zero_iff` (Exercise 15 (b)).
* `DirSystem.instCommRing` : the direct limit **inherits a commutative ring structure**, with the
  book's formula `α i x + α j y = α k (α ik x + α jk y)` and `α i x * α j y = α k (α ik x * α jk y)`
  for `k ≥ i, j` (`of_add`, `of_mul`), the zero and the unit of any stage (`of_zero_irrel`,
  `of_one_irrel`), and the negative `α i (-x) = -α i x` (`of_neg`).  Every ring axiom is verified
  from these formulas (`add_assoc_ax`, ..., `right_distrib_ax`).
* `DirSystem.ofRingHom` : **each associated homomorphism `α i` is a ring homomorphism**.
* `DirSystem.exists_trivial_of_trivial` : **if `lim A_i` is the zero ring then `A i` is the zero
  ring for some `i`**, together with the converse `subsingleton_of_exists_subsingleton` and the
  resulting characterization `subsingleton_iff`.
* `DirSystem.existsUnique_lift` : the universal property of the direct limit in the category of
  commutative rings (Exercise 16 in the ring case).
* `DirSystem.solution` : the two statements of the exercise, assembled.
* `DirSystem.unitLimitEquiv` : a worked example (the one-stage system has limit `R`).

Only the standard axioms `propext`, `Classical.choice` and `Quot.sound` are used.
-/
import Mathlib

set_option linter.unusedSectionVars false

namespace AtiyahMcdonald69.Ex_2_21

universe u v

/-- A directed system of rings over a preorder `I`: rings `A i` together with ring homomorphisms
`α i j : A i →+* A j` for `i ≤ j`, compatible with identities and composition.  This is
Atiyah–Macdonald's directed system of `ℤ`-modules in which every module is a ring and every
transition map is a ring homomorphism. -/
structure DirSystem (I : Type u) [Preorder I] where
  /-- the rings of the system -/
  A : I → Type v
  [instA : ∀ i, CommRing (A i)]
  /-- the transition homomorphisms `α i j` for `i ≤ j` -/
  map : ∀ (i j : I), i ≤ j → A i →+* A j
  /-- `α i i` is the identity -/
  map_self : ∀ (i : I) (x : A i), map i i le_rfl x = x
  /-- the transition maps are compatible with composition -/
  map_map : ∀ (i j k : I) (hij : i ≤ j) (hjk : j ≤ k) (x : A i),
    map j k hjk (map i j hij x) = map i k (hij.trans hjk) x

attribute [instance] DirSystem.instA

namespace DirSystem

variable {I : Type u} [Preorder I]

/-- The transition homomorphism `α i j : A i →+* A j` attached to `i ≤ j`. -/
abbrev α (S : DirSystem.{u, v} I) {i j : I} (h : i ≤ j) : S.A i →+* S.A j := S.map i j h

@[simp] theorem α_self (S : DirSystem.{u, v} I) {i : I} (x : S.A i) : S.α le_rfl x = x :=
  S.map_self i x

theorem α_map (S : DirSystem.{u, v} I) {i j k : I} (hij : i ≤ j) (hjk : j ≤ k) (x : S.A i) :
    S.α hjk (S.α hij x) = S.α (hij.trans hjk) x :=
  S.map_map i j k hij hjk x

variable [Nonempty I] [IsDirectedOrder I]

/-- Two elements of the disjoint union `Σ i, A i` of the rings of a directed system become equal in
the direct limit exactly when they agree after being mapped to a common later stage. -/
def rel (S : DirSystem.{u, v} I) (x y : Σ i, S.A i) : Prop :=
  ∃ (k : I) (h₁ : x.1 ≤ k) (h₂ : y.1 ≤ k), S.α h₁ x.2 = S.α h₂ y.2

theorem rel_refl (S : DirSystem.{u, v} I) (x : Σ i, S.A i) : S.rel x x :=
  ⟨x.1, le_rfl, le_rfl, rfl⟩

theorem rel_symm {S : DirSystem.{u, v} I} {x y : Σ i, S.A i} (h : S.rel x y) : S.rel y x := by
  obtain ⟨k, h₁, h₂, he⟩ := h
  exact ⟨k, h₂, h₁, he.symm⟩

theorem rel_trans {S : DirSystem.{u, v} I} {x y z : Σ i, S.A i}
    (h₁ : S.rel x y) (h₂ : S.rel y z) : S.rel x z := by
  obtain ⟨k, hx, hy, he₁⟩ := h₁
  obtain ⟨l, hy', hz, he₂⟩ := h₂
  obtain ⟨m, hkm, hlm⟩ := IsDirected.directed (r := (· ≤ ·)) k l
  refine ⟨m, hx.trans hkm, hz.trans hlm, ?_⟩
  calc S.α (hx.trans hkm) x.2
      = S.α hkm (S.α hx x.2) := (S.α_map hx hkm x.2).symm
    _ = S.α hkm (S.α hy y.2) := by rw [he₁]
    _ = S.α (hy.trans hkm) y.2 := S.α_map hy hkm y.2
    _ = S.α (hy'.trans hlm) y.2 := rfl
    _ = S.α hlm (S.α hy' y.2) := (S.α_map hy' hlm y.2).symm
    _ = S.α hlm (S.α hz z.2) := by rw [he₂]
    _ = S.α (hz.trans hlm) z.2 := S.α_map hz hlm z.2

/-- The setoid on `Σ i, A i` whose quotient is the direct limit. -/
def setoid (S : DirSystem.{u, v} I) : Setoid (Σ i, S.A i) :=
  ⟨S.rel, S.rel_refl, S.rel_symm, S.rel_trans⟩

/-- The direct limit `lim A_i` of a directed system of rings, as a type: the quotient of the
disjoint union of the rings by the relation of agreeing at a common later stage (this is
Atiyah–Macdonald's `C/D` of Exercise 14 for the underlying `ℤ`-modules). -/
def Lim (S : DirSystem.{u, v} I) : Type (max u v) := Quotient S.setoid

/-- The canonical map `α i : A i → lim A_i` from a stage into the direct limit. -/
def of (S : DirSystem.{u, v} I) (i : I) (x : S.A i) : S.Lim := Quotient.mk S.setoid ⟨i, x⟩

theorem of_eq_iff {S : DirSystem.{u, v} I} {i j : I} {x : S.A i} {y : S.A j} :
    S.of i x = S.of j y ↔ ∃ (k : I) (h₁ : i ≤ k) (h₂ : j ≤ k), S.α h₁ x = S.α h₂ y :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

/-- Two elements of a common stage define the same class as soon as they agree at a later stage. -/
theorem of_eq_of_agree {S : DirSystem.{u, v} I} {i : I} {x y : S.A i} {k : I} (h : i ≤ k)
    (he : S.α h x = S.α h y) : S.of i x = S.of i y :=
  S.of_eq_iff.2 ⟨k, h, h, he⟩

/-- The defining property of the canonical maps: `α_j(α_{ij}(x)) = α_i(x)`. -/
theorem of_map {S : DirSystem.{u, v} I} {i j : I} (h : i ≤ j) (x : S.A i) :
    S.of j (S.α h x) = S.of i x := by
  refine S.of_eq_iff.2 ⟨j, le_rfl, h, ?_⟩
  rw [S.α_self]

/-- Moving a stage up does not change the class, and two such presentations of one class agree at a
common later stage. -/
theorem of_stable {S : DirSystem.{u, v} I} {i j k : I} (x : S.A i) (hij : i ≤ j) (hik : i ≤ k) :
    S.of j (S.α hij x) = S.of k (S.α hik x) := by
  obtain ⟨m, hjm, hkm⟩ := IsDirected.directed (r := (· ≤ ·)) j k
  rw [← S.of_map hjm, ← S.of_map hkm, S.α_map, S.α_map]

/-- Every element of the direct limit is the class of an element of one of the rings
(Exercise 15 (a)). -/
theorem exists_of (S : DirSystem.{u, v} I) (z : S.Lim) : ∃ (i : I) (x : S.A i), S.of i x = z :=
  Quotient.inductionOn z fun p => ⟨p.1, p.2, rfl⟩

/-- A chosen common upper bound of two indices. -/
noncomputable def sup (i j : I) : I := Classical.choose (IsDirected.directed (r := (· ≤ ·)) i j)

theorem le_sup_left (i j : I) : i ≤ sup i j :=
  (Classical.choose_spec (IsDirected.directed (r := (· ≤ ·)) i j)).1

theorem le_sup_right (i j : I) : j ≤ sup i j :=
  (Classical.choose_spec (IsDirected.directed (r := (· ≤ ·)) i j)).2

theorem exists_upper_three (a b c : I) : ∃ m, a ≤ m ∧ b ≤ m ∧ c ≤ m := by
  obtain ⟨u, hau, hbu⟩ := IsDirected.directed (r := (· ≤ ·)) a b
  obtain ⟨v, huv, hcv⟩ := IsDirected.directed (r := (· ≤ ·)) u c
  exact ⟨v, le_trans hau huv, le_trans hbu huv, hcv⟩

theorem exists_upper_four (a b c d : I) : ∃ m, a ≤ m ∧ b ≤ m ∧ c ≤ m ∧ d ≤ m := by
  obtain ⟨u, hau, hbu⟩ := IsDirected.directed (r := (· ≤ ·)) a b
  obtain ⟨v, hcv, hdv⟩ := IsDirected.directed (r := (· ≤ ·)) c d
  obtain ⟨m, hum, hvm⟩ := IsDirected.directed (r := (· ≤ ·)) u v
  exact ⟨m, le_trans hau hum, le_trans hbu hum, le_trans hcv hvm, le_trans hdv hvm⟩

/-- The class of `α_{ik}(x) + α_{jk}(y)` does not depend on the common stage `k ≥ i, j`. -/
theorem of_add_stable {S : DirSystem.{u, v} I} {i j k l : I} (x : S.A i) (y : S.A j)
    (hik : i ≤ k) (hjk : j ≤ k) (hil : i ≤ l) (hjl : j ≤ l) :
    S.of k (S.α hik x + S.α hjk y) = S.of l (S.α hil x + S.α hjl y) := by
  obtain ⟨m, hkm, hlm⟩ := IsDirected.directed (r := (· ≤ ·)) k l
  rw [← S.of_map hkm, ← S.of_map hlm, map_add, map_add, S.α_map, S.α_map, S.α_map, S.α_map]

/-- The class of `α_{ik}(x) * α_{jk}(y)` does not depend on the common stage `k ≥ i, j`. -/
theorem of_mul_stable {S : DirSystem.{u, v} I} {i j k l : I} (x : S.A i) (y : S.A j)
    (hik : i ≤ k) (hjk : j ≤ k) (hil : i ≤ l) (hjl : j ≤ l) :
    S.of k (S.α hik x * S.α hjk y) = S.of l (S.α hil x * S.α hjl y) := by
  obtain ⟨m, hkm, hlm⟩ := IsDirected.directed (r := (· ≤ ·)) k l
  rw [← S.of_map hkm, ← S.of_map hlm, map_mul, map_mul, S.α_map, S.α_map, S.α_map, S.α_map]

/-- Congruence for sums, in a form that avoids rewriting (needed because the index arguments of
`S.α` are proofs, which rewriting does not match). -/
theorem add_congr_eq {M : Type*} [Add M] {a₁ b₁ a₂ b₂ : M} (h₁ : a₁ = b₁) (h₂ : a₂ = b₂) :
    a₁ + a₂ = b₁ + b₂ :=
  (congrArg (fun z => z + a₂) h₁).trans (congrArg (fun z => b₁ + z) h₂)

theorem mul_congr_eq {M : Type*} [Mul M] {a₁ b₁ a₂ b₂ : M} (h₁ : a₁ = b₁) (h₂ : a₂ = b₂) :
    a₁ * a₂ = b₁ * b₂ :=
  (congrArg (fun z => z * a₂) h₁).trans (congrArg (fun z => b₁ * z) h₂)

/-- If `x` and `x'` have the same class in the limit, then so do any two of their images at
common later stages. -/
theorem rel_map_eq {S : DirSystem.{u, v} I} {p p' : Σ i, S.A i} {mp : I} (h₁ : p.1 ≤ mp)
    (h₂ : p'.1 ≤ mp) (he : S.α h₁ p.2 = S.α h₂ p'.2) {u : I} (hu : mp ≤ u) :
    S.α (h₁.trans hu) p.2 = S.α (h₂.trans hu) p'.2 := by
  rw [← S.α_map h₁ hu, ← S.α_map h₂ hu, he]

/-- Addition of classes, defined on representatives by the formula `α_i(x) + α_j(y)` computed at a
common later stage. -/
noncomputable def addRep (S : DirSystem.{u, v} I) (p q : Σ i, S.A i) : S.Lim :=
  S.of (sup p.1 q.1) (S.α (le_sup_left p.1 q.1) p.2 + S.α (le_sup_right p.1 q.1) q.2)

/-- Multiplication of classes, by the book's formula
`α_i(x) · α_j(y) = α_k(α_{ik}(x) · α_{jk}(y))` for `k ≥ i, j`. -/
noncomputable def mulRep (S : DirSystem.{u, v} I) (p q : Σ i, S.A i) : S.Lim :=
  S.of (sup p.1 q.1) (S.α (le_sup_left p.1 q.1) p.2 * S.α (le_sup_right p.1 q.1) q.2)

theorem addRep_congr {S : DirSystem.{u, v} I} {p p' q q' : Σ i, S.A i}
    (hp : S.rel p p') (hq : S.rel q q') : S.addRep p q = S.addRep p' q' := by
  obtain ⟨mp, hp₁, hp₂, hpe⟩ := hp
  obtain ⟨mq, hq₁, hq₂, hqe⟩ := hq
  obtain ⟨n, hn₁, hn₂, hmp, hmq⟩ :=
    exists_upper_four (I := I) (sup p.1 q.1) (sup p'.1 q'.1) mp mq
  have step₁ := S.of_add_stable p.2 q.2 (le_sup_left p.1 q.1) (le_sup_right p.1 q.1)
    (le_trans (le_sup_left p.1 q.1) hn₁) (le_trans (le_sup_right p.1 q.1) hn₁)
  have step₂ := S.of_add_stable p'.2 q'.2 (le_sup_left p'.1 q'.1) (le_sup_right p'.1 q'.1)
    (le_trans (le_sup_left p'.1 q'.1) hn₂) (le_trans (le_sup_right p'.1 q'.1) hn₂)
  have e₁ : S.α (le_trans (le_sup_left p.1 q.1) hn₁) p.2 =
      S.α (le_trans (le_sup_left p'.1 q'.1) hn₂) p'.2 :=
    S.rel_map_eq hp₁ hp₂ hpe hmp
  have e₂ : S.α (le_trans (le_sup_right p.1 q.1) hn₁) q.2 =
      S.α (le_trans (le_sup_right p'.1 q'.1) hn₂) q'.2 :=
    S.rel_map_eq hq₁ hq₂ hqe hmq
  have hmid : S.of n (S.α (le_trans (le_sup_left p.1 q.1) hn₁) p.2 +
        S.α (le_trans (le_sup_right p.1 q.1) hn₁) q.2) =
      S.of n (S.α (le_trans (le_sup_left p'.1 q'.1) hn₂) p'.2 +
        S.α (le_trans (le_sup_right p'.1 q'.1) hn₂) q'.2) := by
    refine S.of_eq_of_agree le_rfl ?_
    simp only [S.α_self]
    exact add_congr_eq e₁ e₂
  exact step₁.trans (hmid.trans step₂.symm)

theorem mulRep_congr {S : DirSystem.{u, v} I} {p p' q q' : Σ i, S.A i}
    (hp : S.rel p p') (hq : S.rel q q') : S.mulRep p q = S.mulRep p' q' := by
  obtain ⟨mp, hp₁, hp₂, hpe⟩ := hp
  obtain ⟨mq, hq₁, hq₂, hqe⟩ := hq
  obtain ⟨n, hn₁, hn₂, hmp, hmq⟩ :=
    exists_upper_four (I := I) (sup p.1 q.1) (sup p'.1 q'.1) mp mq
  have step₁ := S.of_mul_stable p.2 q.2 (le_sup_left p.1 q.1) (le_sup_right p.1 q.1)
    (le_trans (le_sup_left p.1 q.1) hn₁) (le_trans (le_sup_right p.1 q.1) hn₁)
  have step₂ := S.of_mul_stable p'.2 q'.2 (le_sup_left p'.1 q'.1) (le_sup_right p'.1 q'.1)
    (le_trans (le_sup_left p'.1 q'.1) hn₂) (le_trans (le_sup_right p'.1 q'.1) hn₂)
  have e₁ : S.α (le_trans (le_sup_left p.1 q.1) hn₁) p.2 =
      S.α (le_trans (le_sup_left p'.1 q'.1) hn₂) p'.2 :=
    S.rel_map_eq hp₁ hp₂ hpe hmp
  have e₂ : S.α (le_trans (le_sup_right p.1 q.1) hn₁) q.2 =
      S.α (le_trans (le_sup_right p'.1 q'.1) hn₂) q'.2 :=
    S.rel_map_eq hq₁ hq₂ hqe hmq
  have hmid : S.of n (S.α (le_trans (le_sup_left p.1 q.1) hn₁) p.2 *
        S.α (le_trans (le_sup_right p.1 q.1) hn₁) q.2) =
      S.of n (S.α (le_trans (le_sup_left p'.1 q'.1) hn₂) p'.2 *
        S.α (le_trans (le_sup_right p'.1 q'.1) hn₂) q'.2) := by
    refine S.of_eq_of_agree le_rfl ?_
    simp only [S.α_self]
    exact mul_congr_eq e₁ e₂
  exact step₁.trans (hmid.trans step₂.symm)

noncomputable instance instAdd {S : DirSystem.{u, v} I} : Add S.Lim :=
  ⟨Quotient.lift₂ S.addRep fun _ _ _ _ h₁ h₂ => S.addRep_congr h₁ h₂⟩

noncomputable instance instMul {S : DirSystem.{u, v} I} : Mul S.Lim :=
  ⟨Quotient.lift₂ S.mulRep fun _ _ _ _ h₁ h₂ => S.mulRep_congr h₁ h₂⟩

noncomputable instance instNeg {S : DirSystem.{u, v} I} : Neg S.Lim :=
  ⟨Quotient.lift (fun p : Σ i, S.A i => S.of p.1 (-p.2)) fun p p' h => by
    obtain ⟨k, h₁, h₂, he⟩ := h
    refine S.of_eq_iff.2 ⟨k, h₁, h₂, ?_⟩
    rw [map_neg, map_neg, he]⟩

noncomputable instance instZero {S : DirSystem.{u, v} I} : Zero S.Lim :=
  ⟨S.of (Classical.arbitrary I) 0⟩

noncomputable instance instOne {S : DirSystem.{u, v} I} : One S.Lim :=
  ⟨S.of (Classical.arbitrary I) 1⟩

@[simp] theorem of_add {S : DirSystem.{u, v} I} {i j : I} (x : S.A i) (y : S.A j) :
    S.of i x + S.of j y =
      S.of (sup i j) (S.α (le_sup_left i j) x + S.α (le_sup_right i j) y) := rfl

@[simp] theorem of_mul {S : DirSystem.{u, v} I} {i j : I} (x : S.A i) (y : S.A j) :
    S.of i x * S.of j y =
      S.of (sup i j) (S.α (le_sup_left i j) x * S.α (le_sup_right i j) y) := rfl

@[simp] theorem of_neg {S : DirSystem.{u, v} I} {i : I} (x : S.A i) :
    -S.of i x = S.of i (-x) := rfl

theorem of_zero_irrel (S : DirSystem.{u, v} I) (i j : I) :
    S.of i (0 : S.A i) = S.of j (0 : S.A j) := by
  refine S.of_eq_iff.2 ⟨sup i j, le_sup_left i j, le_sup_right i j, ?_⟩
  rw [map_zero, map_zero]

theorem of_one_irrel (S : DirSystem.{u, v} I) (i j : I) :
    S.of i (1 : S.A i) = S.of j (1 : S.A j) := by
  refine S.of_eq_iff.2 ⟨sup i j, le_sup_left i j, le_sup_right i j, ?_⟩
  rw [map_one, map_one]

@[simp] theorem of_zero {S : DirSystem.{u, v} I} {i : I} : S.of i 0 = (0 : S.Lim) :=
  S.of_zero_irrel i _

@[simp] theorem of_one {S : DirSystem.{u, v} I} {i : I} : S.of i 1 = (1 : S.Lim) :=
  S.of_one_irrel i _

/-- Two classes that are `of`-presentations at two stages are equal as soon as their images at a
common later stage agree. -/
theorem of_eq_of_maps {S : DirSystem.{u, v} I} {i j m : I} (him : i ≤ m) (hjm : j ≤ m)
    {E : S.A i} {F : S.A j} (he : S.α him E = S.α hjm F) : S.of i E = S.of j F := by
  rw [← S.of_map him, ← S.of_map hjm, he]

theorem zero_def (S : DirSystem.{u, v} I) :
    (0 : S.Lim) = S.of (Classical.arbitrary I) 0 := rfl

theorem one_def (S : DirSystem.{u, v} I) :
    (1 : S.Lim) = S.of (Classical.arbitrary I) 1 := rfl

theorem add_assoc_ax (S : DirSystem.{u, v} I) (a b c : S.Lim) : a + b + c = a + (b + c) := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  obtain ⟨r, z, rfl⟩ := S.exists_of c
  simp only [of_add]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·))
    (sup (sup p q) r) (sup p (sup q r))
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, S.α_map]
  rw [add_assoc]

theorem add_comm_ax (S : DirSystem.{u, v} I) (a b : S.Lim) : a + b = b + a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  rw [of_add, of_add]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup p q) (sup q p)
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, S.α_map]
  rw [add_comm]

theorem zero_add_ax (S : DirSystem.{u, v} I) (a : S.Lim) : 0 + a = a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [zero_def, of_add]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup (Classical.arbitrary I) p) p
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, map_zero, S.α_map]
  rw [zero_add]

theorem add_zero_ax (S : DirSystem.{u, v} I) (a : S.Lim) : a + 0 = a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [zero_def, of_add]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup p (Classical.arbitrary I)) p
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, map_zero, S.α_map]
  rw [add_zero]

theorem neg_add_cancel_ax (S : DirSystem.{u, v} I) (a : S.Lim) : -a + a = 0 := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [of_neg, of_add, zero_def]
  obtain ⟨m, h₁, h₂⟩ :=
    IsDirected.directed (r := (· ≤ ·)) (sup p p) (Classical.arbitrary I)
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, map_neg, map_zero, S.α_map]
  rw [neg_add_cancel]

theorem mul_assoc_ax (S : DirSystem.{u, v} I) (a b c : S.Lim) : a * b * c = a * (b * c) := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  obtain ⟨r, z, rfl⟩ := S.exists_of c
  rw [of_mul, of_mul, of_mul, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·))
    (sup (sup p q) r) (sup p (sup q r))
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, S.α_map]
  rw [mul_assoc]

theorem mul_comm_ax (S : DirSystem.{u, v} I) (a b : S.Lim) : a * b = b * a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  rw [of_mul, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup p q) (sup q p)
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, S.α_map]
  rw [mul_comm]

theorem one_mul_ax (S : DirSystem.{u, v} I) (a : S.Lim) : 1 * a = a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [one_def, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup (Classical.arbitrary I) p) p
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, map_one, S.α_map]
  rw [one_mul]

theorem mul_one_ax (S : DirSystem.{u, v} I) (a : S.Lim) : a * 1 = a := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [one_def, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·)) (sup p (Classical.arbitrary I)) p
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, map_one, S.α_map]
  rw [mul_one]

theorem zero_mul_ax (S : DirSystem.{u, v} I) (a : S.Lim) : 0 * a = 0 := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [zero_def, of_mul]
  obtain ⟨m, h₁, h₂⟩ :=
    IsDirected.directed (r := (· ≤ ·)) (sup (Classical.arbitrary I) p) (Classical.arbitrary I)
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, map_zero, S.α_map]
  rw [zero_mul]

theorem mul_zero_ax (S : DirSystem.{u, v} I) (a : S.Lim) : a * 0 = 0 := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  rw [zero_def, of_mul]
  obtain ⟨m, h₁, h₂⟩ :=
    IsDirected.directed (r := (· ≤ ·)) (sup p (Classical.arbitrary I)) (Classical.arbitrary I)
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, map_zero, S.α_map]
  rw [mul_zero]

theorem left_distrib_ax (S : DirSystem.{u, v} I) (a b c : S.Lim) :
    a * (b + c) = a * b + a * c := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  obtain ⟨r, z, rfl⟩ := S.exists_of c
  simp only [of_add, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·))
    (sup p (sup q r)) (sup (sup p q) (sup p r))
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, map_mul, S.α_map]
  rw [left_distrib]

theorem right_distrib_ax (S : DirSystem.{u, v} I) (a b c : S.Lim) :
    (a + b) * c = a * c + b * c := by
  obtain ⟨p, x, rfl⟩ := S.exists_of a
  obtain ⟨q, y, rfl⟩ := S.exists_of b
  obtain ⟨r, z, rfl⟩ := S.exists_of c
  simp only [of_add, of_mul]
  obtain ⟨m, h₁, h₂⟩ := IsDirected.directed (r := (· ≤ ·))
    (sup (sup p q) r) (sup (sup p r) (sup q r))
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, map_mul, S.α_map]
  rw [right_distrib]

/-- **Exercise 2.21 (main part).**  The direct limit of a directed system of rings inherits a
commutative ring structure for which the classes of the elements of each stage multiply and add by
the book's formula. -/
noncomputable instance instCommRing (S : DirSystem.{u, v} I) : CommRing S.Lim where
  add := (· + ·)
  add_assoc := S.add_assoc_ax
  zero := 0
  zero_add := S.zero_add_ax
  add_zero := S.add_zero_ax
  nsmul := nsmulRec
  add_comm := S.add_comm_ax
  mul := (· * ·)
  mul_assoc := S.mul_assoc_ax
  one := 1
  one_mul := S.one_mul_ax
  mul_one := S.mul_one_ax
  zero_mul := S.zero_mul_ax
  mul_zero := S.mul_zero_ax
  left_distrib := S.left_distrib_ax
  right_distrib := S.right_distrib_ax
  neg := Neg.neg
  zsmul := zsmulRec
  neg_add_cancel := S.neg_add_cancel_ax
  mul_comm := S.mul_comm_ax


/-! ### The canonical maps are ring homomorphisms -/

theorem of_add_of {S : DirSystem.{u, v} I} {i : I} (x y : S.A i) :
    S.of i (x + y) = S.of i x + S.of i y := by
  rw [of_add]
  obtain ⟨m, h₂, h₁⟩ := IsDirected.directed (r := (· ≤ ·)) (sup i i) i
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_add, S.α_map]

theorem of_mul_of {S : DirSystem.{u, v} I} {i : I} (x y : S.A i) :
    S.of i (x * y) = S.of i x * S.of i y := by
  rw [of_mul]
  obtain ⟨m, h₂, h₁⟩ := IsDirected.directed (r := (· ≤ ·)) (sup i i) i
  refine S.of_eq_of_maps h₁ h₂ ?_
  simp only [map_mul, S.α_map]

/-- **Exercise 2.21, first statement.**  The canonical map `α i : A i → lim A_i` of a directed
system of rings is a ring homomorphism. -/
noncomputable def ofRingHom (S : DirSystem.{u, v} I) (i : I) : S.A i →+* S.Lim where
  toFun := S.of i
  map_one' := S.of_one
  map_zero' := S.of_zero
  map_add' := S.of_add_of
  map_mul' := S.of_mul_of

@[simp] theorem ofRingHom_apply {S : DirSystem.{u, v} I} (i : I) (x : S.A i) :
    S.ofRingHom i x = S.of i x := rfl

/-- The canonical maps are compatible with the transition homomorphisms. -/
@[simp] theorem ofRingHom_map {S : DirSystem.{u, v} I} {i j : I} (h : i ≤ j) (x : S.A i) :
    S.ofRingHom j (S.α h x) = S.ofRingHom i x :=
  S.of_map h x

/-! ### Exercise 15 (b) for rings, and the vanishing statement -/

/-- **Exercise 15 (b).**  An element of a stage vanishes in the direct limit exactly when it
vanishes at some later stage. -/
theorem of_eq_zero_iff {S : DirSystem.{u, v} I} {i : I} (x : S.A i) :
    S.of i x = (0 : S.Lim) ↔ ∃ (j : I) (h : i ≤ j), S.α h x = 0 := by
  constructor
  · intro h
    have h' : S.of i x = S.of (Classical.arbitrary I) (0 : S.A (Classical.arbitrary I)) := h
    obtain ⟨k, h₁, h₂, he⟩ := S.of_eq_iff.1 h'
    exact ⟨k, h₁, he.trans (map_zero _)⟩
  · rintro ⟨j, h, hx⟩
    rw [← S.of_map h, hx, S.of_zero]

/-- A ring in which `1 = 0` is trivial. -/
theorem subsingleton_of_one_eq_zero {R : Type*} [CommRing R] (h : (1 : R) = 0) : Subsingleton R :=
  ⟨fun a b => by
    have ha : a = 0 := by rw [← mul_one a, h, mul_zero]
    have hb : b = 0 := by rw [← mul_one b, h, mul_zero]
    rw [ha, hb]⟩

/-- The same statement in the form "if `1 = 0` in the limit then `1 = 0` in some `A_i`", which is
how Atiyah–Macdonald state it (`A = 0` means `A` is the zero ring). -/
theorem exists_trivial_of_trivial {S : DirSystem.{u, v} I} (h : (1 : S.Lim) = 0) :
    ∃ i, (1 : S.A i) = 0 := by
  have h1 : S.of (Classical.arbitrary I) (1 : S.A (Classical.arbitrary I)) = 0 := by
    rw [← S.one_def]; exact h
  obtain ⟨j, hj, hj0⟩ := S.of_eq_zero_iff _ |>.1 h1
  exact ⟨j, (map_one (S.α hj)).symm.trans hj0⟩

/-- **Exercise 2.21, second statement**, in the form: if the direct limit is the zero ring, then one
of the rings `A i` is the zero ring. -/
theorem exists_subsingleton_of_subsingleton {S : DirSystem.{u, v} I} [Subsingleton S.Lim] :
    ∃ i, Subsingleton (S.A i) := by
  obtain ⟨i, hi⟩ := S.exists_trivial_of_trivial (Subsingleton.elim (1 : S.Lim) 0)
  exact ⟨i, subsingleton_of_one_eq_zero hi⟩

/-! ### The universal property -/

/-- The unique ring homomorphism out of the direct limit determined by a compatible family of ring
homomorphisms out of the stages (Exercise 16 for rings). -/
noncomputable def lift (S : DirSystem.{u, v} I) {P : Type*} [CommRing P] (g : ∀ i, S.A i →+* P)
    (hg : ∀ (i j : I) (h : i ≤ j) (x : S.A i), g j (S.α h x) = g i x) : S.Lim →+* P := by
  have key : ∀ p q : Σ i, S.A i, S.rel p q → g p.1 p.2 = g q.1 q.2 := by
    intro p q h
    obtain ⟨k, h₁, h₂, he⟩ := h
    exact (hg p.1 k h₁ p.2).symm.trans ((congrArg (g k) he).trans (hg q.1 k h₂ q.2))
  refine
    { toFun := Quotient.lift (fun p : Σ i, S.A i => g p.1 p.2) key
      map_one' := ?_
      map_mul' := ?_
      map_zero' := ?_
      map_add' := ?_ }
  · conv_lhs => rw [S.one_def]
    exact map_one _
  · intro a b
    obtain ⟨i, x, rfl⟩ := S.exists_of a
    obtain ⟨j, y, rfl⟩ := S.exists_of b
    conv_lhs => rw [of_mul]
    show g (sup i j) (S.α (le_sup_left i j) x * S.α (le_sup_right i j) y) = g i x * g j y
    rw [map_mul, hg i (sup i j) (le_sup_left i j) x, hg j (sup i j) (le_sup_right i j) y]
  · conv_lhs => rw [S.zero_def]
    exact map_zero _
  · intro a b
    obtain ⟨i, x, rfl⟩ := S.exists_of a
    obtain ⟨j, y, rfl⟩ := S.exists_of b
    conv_lhs => rw [of_add]
    show g (sup i j) (S.α (le_sup_left i j) x + S.α (le_sup_right i j) y) = g i x + g j y
    rw [map_add, hg i (sup i j) (le_sup_left i j) x, hg j (sup i j) (le_sup_right i j) y]

@[simp] theorem lift_of {S : DirSystem.{u, v} I} {P : Type*} [CommRing P] (g : ∀ i, S.A i →+* P)
    (hg : ∀ (i j : I) (h : i ≤ j) (x : S.A i), g j (S.α h x) = g i x) (i : I) (x : S.A i) :
    S.lift g hg (S.of i x) = g i x := rfl

/-- **Exercise 2.21 / Exercise 16.**  The ring `lim A_i` together with the homomorphisms `α_i` is
the direct limit: every compatible family of ring homomorphisms out of the stages factors through
it uniquely. -/
theorem existsUnique_lift (S : DirSystem.{u, v} I) {P : Type*} [CommRing P]
    (g : ∀ i, S.A i →+* P) (hg : ∀ (i j : I) (h : i ≤ j) (x : S.A i), g j (S.α h x) = g i x) :
    ∃! f : S.Lim →+* P, ∀ (i : I) (x : S.A i), f (S.of i x) = g i x := by
  refine ⟨S.lift g hg, fun i x => rfl, ?_⟩
  rintro f hf
  ext z
  obtain ⟨i, x, rfl⟩ := S.exists_of z
  rw [hf i x, lift_of]


/-- **The book's formula for the sum**, for an arbitrary common upper bound `k ≥ i, j`:
`α_i(x) + α_j(y) = α_k(α_{ik}(x) + α_{jk}(y))`.  The class does not depend on the choice of `k`
(`of_add_stable`). -/
theorem of_add_of_le {S : DirSystem.{u, v} I} {i j k : I} (hik : i ≤ k) (hjk : j ≤ k)
    (x : S.A i) (y : S.A j) :
    S.of i x + S.of j y = S.of k (S.α hik x + S.α hjk y) := by
  rw [of_add]
  exact S.of_add_stable x y (le_sup_left i j) (le_sup_right i j) hik hjk

/-- **The book's formula for the product**, for an arbitrary common upper bound `k ≥ i, j`:
`α_i(x) · α_j(y) = α_k(α_{ik}(x) · α_{jk}(y))`.  The class does not depend on the choice of `k`
(`of_mul_stable`). -/
theorem of_mul_of_le {S : DirSystem.{u, v} I} {i j k : I} (hik : i ≤ k) (hjk : j ≤ k)
    (x : S.A i) (y : S.A j) :
    S.of i x * S.of j y = S.of k (S.α hik x * S.α hjk y) := by
  rw [of_mul]
  exact S.of_mul_stable x y (le_sup_left i j) (le_sup_right i j) hik hjk

/-! ### Sharpness of the vanishing condition -/

/-- Conversely, if one of the rings `A i` is the zero ring, then the direct limit is the zero ring:
the ring becomes zero at every later stage, and every stage maps into a later one.  Together with
`exists_subsingleton_of_subsingleton` this gives `Subsingleton (lim A i) ↔ ∃ i, Subsingleton (A i)`. -/
theorem subsingleton_of_exists_subsingleton {S : DirSystem.{u, v} I}
    (h : ∃ i, Subsingleton (S.A i)) : Subsingleton S.Lim := by
  obtain ⟨i, hi⟩ := h
  have hone : (1 : S.Lim) = 0 := by
    rw [S.one_def]
    obtain ⟨k, hik, hark⟩ := IsDirected.directed (r := (· ≤ ·)) i (Classical.arbitrary I)
    have hi1 : (1 : S.A i) = 0 := Subsingleton.elim _ _
    have hk : (1 : S.A k) = 0 := by
      rw [← map_one (S.α hik), hi1, map_zero]
    calc S.of (Classical.arbitrary I) 1 = S.of k (S.α hark 1) := (S.of_map hark 1).symm
      _ = S.of k 0 := by rw [map_one, hk]
      _ = 0 := S.of_zero
  exact subsingleton_of_one_eq_zero hone

/-- For a directed system of rings, the direct limit is the zero ring if and only if one of the
rings of the system is the zero ring.  This is the exact content of the second statement of
Exercise 2.21 together with its sharpness. -/
theorem subsingleton_iff (S : DirSystem.{u, v} I) :
    Subsingleton S.Lim ↔ ∃ i, Subsingleton (S.A i) :=
  ⟨fun h => letI := h; S.exists_subsingleton_of_subsingleton, S.subsingleton_of_exists_subsingleton⟩

/-! ### A worked example: the one-stage system -/

/-- The directed system with a single ring `R` (indexed by `Unit`). -/
def unitSystem (R : Type u) [CommRing R] : DirSystem Unit where
  A _ := R
  map _ _ _ := RingHom.id R
  map_self _ _ := rfl
  map_map _ _ _ _ _ _ := rfl

/-- The direct limit of the one-stage system is the ring itself: the construction does compute the
expected object in the base case. -/
noncomputable def unitLimitEquiv (R : Type u) [CommRing R] :
    (unitSystem R).Lim ≃+* R where
  toFun := (unitSystem R).lift (fun _ => RingHom.id R) (fun _ _ _ _ => rfl)
  invFun := (unitSystem R).ofRingHom ()
  left_inv := by
    intro z
    obtain ⟨i, x, rfl⟩ := (unitSystem R).exists_of z
    cases i
    rfl
  right_inv := by
    intro x
    rfl
  map_add' := map_add _
  map_mul' := map_mul _

/-- The directed system over `ℕ` whose rings are all equal to `R` and whose transition maps are all
the identity; a genuine directed system over an infinite directed set. -/
def constSystem (R : Type u) [CommRing R] : DirSystem ℕ where
  A _ := R
  map _ _ _ := RingHom.id R
  map_self _ _ := rfl
  map_map _ _ _ _ _ _ := rfl

/-- The direct limit of the constant system over `ℕ` is again `R`. -/
noncomputable def constLimitEquiv (R : Type u) [CommRing R] :
    (constSystem R).Lim ≃+* R where
  toFun := (constSystem R).lift (fun _ => RingHom.id R) (fun _ _ _ _ => rfl)
  invFun := (constSystem R).ofRingHom 0
  left_inv := by
    intro z
    obtain ⟨i, x, rfl⟩ := (constSystem R).exists_of z
    exact ((constSystem R).of_map (Nat.zero_le i) x).symm
  right_inv := by
    intro x
    rfl
  map_add' := map_add _
  map_mul' := map_mul _

/-! ### The solution statement -/

/-- **Atiyah–Macdonald, Chapter 2, Exercise 21.**  For a directed system `(A_i, α_{ij})` of rings
over a directed set `I`:

* the direct limit `A = lim A_i` carries a commutative ring structure for which the canonical maps
  `α_i : A_i → A` are ring homomorphisms;
* if `A = 0`, then `A_i = 0` for some `i` (and conversely).

The ring structure is the `CommRing S.Lim` instance constructed above; the other two items are
`ofRingHom` (with `of_add_of`, `of_mul_of`, `of_one`, `of_zero`) and `exists_trivial_of_trivial`.
The universal property of the limit as a ring is `existsUnique_lift`. -/
theorem solution (S : DirSystem.{u, v} I) :
    (∀ (i : I) (x y : S.A i), S.ofRingHom i (x + y) = S.ofRingHom i x + S.ofRingHom i y) ∧
    (∀ (i : I) (x y : S.A i), S.ofRingHom i (x * y) = S.ofRingHom i x * S.ofRingHom i y) ∧
    (∀ i : I, S.ofRingHom i 1 = 1) ∧
    (∀ i : I, S.ofRingHom i 0 = 0) ∧
    ((1 : S.Lim) = 0 → ∃ i, (1 : S.A i) = 0) ∧
    (Subsingleton S.Lim ↔ ∃ i, Subsingleton (S.A i)) :=
  ⟨fun _ _ _ => map_add _ _ _, fun _ _ _ => map_mul _ _ _, fun _ => map_one _, fun _ => map_zero _,
    S.exists_trivial_of_trivial, S.subsingleton_iff⟩

end DirSystem

end AtiyahMcdonald69.Ex_2_21

