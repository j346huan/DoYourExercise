set_option autoImplicit false

/-!
# Atiyah–Macdonald (1969), Chapter 2, Exercise 1

The exercise (M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*,
Chapter 2 "Modules", Exercise 1) reads:

> Show that `Z_m ⊗_Z Z_n` is the zero ring if `(m, n) = 1`.

Formally: for natural numbers `m`, `n` with `Nat.Coprime m n`, the tensor product over `ℤ` of the
commutative rings `ZMod m` and `ZMod n` is the zero ring.

`ZMod m` and `ZMod n` are `ℤ`-algebras, so Mathlib puts its canonical commutative ring structure on
`ZMod m ⊗[ℤ] ZMod n`.  The assertion "is the zero ring" is formalized in the two equivalent ways
that the phrase admits: as the vanishing of the underlying `ℤ`-module,
`Subsingleton (ZMod m ⊗[ℤ] ZMod n)` (`zmod_tensor_zmod_subsingleton`), and as the identity
`1 = 0` holding in that ring (`zmod_tensor_zmod_one_eq_zero`); for a ring the two are equivalent,
see `one_eq_zero_of_subsingleton`.

## Proof route

The published natural-language proof argues: since `(m, n) = 1`, multiplication by `n` is
invertible on `ZMod m`; hence a pure tensor `x ⊗ y` can be rewritten as `(x / n) ⊗ (n * y) = 0`,
and pure tensors generate the tensor product.  Here we use the equivalent but more structured
route of cancelling a coprimality relation inside a pure tensor, which never has to name the
inverse of `n`:

* `tmul_eq_zero_of_isCoprime`:  if `m`, `n` are coprime elements of a commutative ring `R` and
  `M`, `N` are `R`-modules killed by `m` and `n` respectively, then every pure tensor
  `x ⊗ₜ y` of `M ⊗[R] N` is zero.  (From `a * m + b * n = 1` we get `x = b • (n • x)`.)
* `subsingleton_tensor_of_isCoprime`:  consequently `M ⊗[R] N` is the zero module, because pure
  tensors span the tensor product (induction on the tensor product).
* `zmod_tensor_zmod_subsingleton`:  the exercise, with `R = ℤ`, `M = ZMod m`, `N = ZMod n`,
  `m` the integer `m` and `n` the integer `n`.
* `exists_int_smul_one_tmul_one`:  `ZMod m ⊗[ℤ] ZMod n` is a cyclic `ℤ`-module generated by the
  pure tensor `1 ⊗ₜ 1` (both factors are generated by `1`), so it is the zero ring exactly when
  `1 ⊗ₜ 1` vanishes (`subsingleton_iff_one_tmul_one_eq_zero`).

## Audit of the natural-language proof

The first sentence of that proof, "multiplication by `n` is invertible on `ZMod m`", is exactly
`isUnit_natCast_of_coprime`, and `exists_smul_eq_of_isUnit_natCast` records the rewriting step it
is used for.  The hypothesis `(m, n) = 1` is not redundant: the converse of the exercise holds as
well, `zmod_tensor_zmod_subsingleton_iff`, i.e. `ZMod m ⊗[ℤ] ZMod n` is the zero ring *iff*
`m` and `n` are coprime.  The proof of the converse exhibits a `ℤ`-linear map
`ZMod m ⊗[ℤ] ZMod n → ZMod d` for every common divisor `d` of `m` and `n`
(`zmodMulBilin`, `one_tmul_one_ne_zero_of_dvd`), which sends `1 ⊗ₜ 1` to `1`.  Concretely
`ZMod 2 ⊗[ℤ] ZMod 3` is the zero ring while `ZMod 2 ⊗[ℤ] ZMod 4` is not.
-/

open TensorProduct

namespace AtiyahMcdonald69.Ex_2_1

/-! ## Trivial rings

The phrase "zero ring" in the exercise refers to the trivial ring. -/

/-- A ring whose underlying type is a subsingleton is the zero ring: `1 = 0`. -/
theorem one_eq_zero_of_subsingleton {A : Type*} [One A] [Zero A] [Subsingleton A] :
    (1 : A) = 0 :=
  Subsingleton.elim 1 0

/-- Conversely, a (multiplicative) ring in which `1 = 0` is the zero ring: every element is equal
to every other.  Together with `one_eq_zero_of_subsingleton` this makes "is the zero ring" mean the
same thing whether it is phrased as `Subsingleton` or as `1 = 0`. -/
theorem subsingleton_of_one_eq_zero {A : Type*} [CommRing A] (h : (1 : A) = 0) :
    Subsingleton A :=
  ⟨fun a b => by rw [← one_mul a, ← one_mul b, h, zero_mul, zero_mul]⟩

/-! ## A general vanishing criterion for pure tensors -/

section General

variable {R : Type*} [CommRing R]
variable {M : Type*} [AddCommMonoid M] [Module R M]
variable {N : Type*} [AddCommMonoid N] [Module R N]

/-- If `m`, `n` are coprime elements of a commutative ring `R`, and the `R`-modules `M`, `N` are
killed by `m` and `n` respectively, then every pure tensor of `M ⊗[R] N` vanishes.

Indeed, from `a * m + b * n = 1` we get `x = 1 • x = a • (m • x) + b • (n • x) = b • (n • x)`, and
then `x ⊗ₜ y = (b • (n • x)) ⊗ₜ y = (n • x) ⊗ₜ (b • y) = x ⊗ₜ (n • (b • y)) = x ⊗ₜ (b • 0) = 0`. -/
theorem tmul_eq_zero_of_isCoprime {m n : R} (h : IsCoprime m n)
    (hm : ∀ x : M, m • x = 0) (hn : ∀ y : N, n • y = 0) (x : M) (y : N) :
    x ⊗ₜ[R] y = 0 := by
  obtain ⟨a, b, hab⟩ := h
  have hx : x = b • (n • x) := by
    calc x = (1 : R) • x := (one_smul R x).symm
      _ = (a * m + b * n) • x := by rw [hab]
      _ = a • (m • x) + b • (n • x) := by rw [add_smul, mul_smul, mul_smul]
      _ = b • (n • x) := by rw [hm x, smul_zero, zero_add]
  calc x ⊗ₜ[R] y = (b • (n • x)) ⊗ₜ[R] y := by conv_lhs => rw [hx]
    _ = (n • x) ⊗ₜ[R] (b • y) := by rw [TensorProduct.smul_tmul]
    _ = x ⊗ₜ[R] (n • (b • y)) := by rw [TensorProduct.smul_tmul]
    _ = x ⊗ₜ[R] (b • (n • y)) := by rw [smul_comm]
    _ = x ⊗ₜ[R] (b • (0 : N)) := by rw [hn y]
    _ = 0 := by rw [smul_zero, TensorProduct.tmul_zero]

/-- If `m`, `n` are coprime elements of a commutative ring `R` and the `R`-modules `M`, `N` are
killed by `m` and `n` respectively, then `M ⊗[R] N` is the zero module. -/
theorem subsingleton_tensor_of_isCoprime {m n : R} (h : IsCoprime m n)
    (hm : ∀ x : M, m • x = 0) (hn : ∀ y : N, n • y = 0) :
    Subsingleton (M ⊗[R] N) := by
  have hz : ∀ z : M ⊗[R] N, z = 0 := fun z =>
    TensorProduct.induction_on z rfl (fun x y => tmul_eq_zero_of_isCoprime h hm hn x y)
      (fun x y ihx ihy => by rw [ihx, ihy, add_zero])
  exact ⟨fun z w => by rw [hz z, hz w]⟩

end General

/-! ## The exercise -/

/-- Atiyah–Macdonald, Chapter 2, Exercise 1:  if `m` and `n` are coprime, then
`ZMod m ⊗[ℤ] ZMod n` is the zero ring, i.e. its underlying additive group is trivial. -/
theorem zmod_tensor_zmod_subsingleton (m n : ℕ) (h : Nat.Coprime m n) :
    Subsingleton (ZMod m ⊗[ℤ] ZMod n) := by
  refine subsingleton_tensor_of_isCoprime (R := ℤ) (M := ZMod m) (N := ZMod n) h.isCoprime ?_ ?_
  · intro x
    simp
  · intro y
    simp

/-- Restatement of the exercise:  every element of `ZMod m ⊗[ℤ] ZMod n` is zero when `m`, `n` are
coprime. -/
theorem zmod_tensor_zmod_eq_zero (m n : ℕ) (h : Nat.Coprime m n) (z : ZMod m ⊗[ℤ] ZMod n) :
    z = 0 :=
  (zmod_tensor_zmod_subsingleton m n h).elim z 0

/-- Restatement of the exercise:  `ZMod m ⊗[ℤ] ZMod n` has no two distinct elements when `m`, `n`
are coprime, i.e. the ring is trivial. -/
theorem zmod_tensor_zmod_not_nontrivial (m n : ℕ) (h : Nat.Coprime m n) :
    ¬ Nontrivial (ZMod m ⊗[ℤ] ZMod n) := by
  intro hn
  obtain ⟨a, b, hab⟩ := hn.exists_pair_ne
  exact hab ((zmod_tensor_zmod_subsingleton m n h).elim a b)

/-- The exercise in the ring-theoretic form of the book's phrase "the zero ring":  when `m`, `n`
are coprime, the identity element of the ring `ZMod m ⊗[ℤ] ZMod n` is `0`. -/
theorem zmod_tensor_zmod_one_eq_zero (m n : ℕ) (h : Nat.Coprime m n) :
    (1 : ZMod m ⊗[ℤ] ZMod n) = 0 :=
  @one_eq_zero_of_subsingleton (ZMod m ⊗[ℤ] ZMod n) _ _
    (zmod_tensor_zmod_subsingleton m n h)

/-! ## The tensor product is generated by `1 ⊗ₜ 1`

Both factors `ZMod m`, `ZMod n` are cyclic `ℤ`-modules generated by `1`, hence every pure tensor is
an integer multiple of `1 ⊗ₜ 1` and so is every element of the tensor product.  This is the reason
why the pairing `zmodMulBilin` below, which is evaluated at `1 ⊗ₜ 1`, detects non-vanishing. -/

/-- Every element of `ZMod m ⊗[ℤ] ZMod n` is an integer multiple of the pure tensor `1 ⊗ₜ 1`. -/
theorem exists_int_smul_one_tmul_one (m n : ℕ) (z : ZMod m ⊗[ℤ] ZMod n) :
    ∃ k : ℤ, z = k • ((1 : ZMod m) ⊗ₜ[ℤ] (1 : ZMod n)) := by
  refine TensorProduct.induction_on z ⟨0, by simp⟩ ?_ ?_
  · intro x y
    obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
    obtain ⟨b, rfl⟩ := ZMod.intCast_surjective y
    have ha : (a : ZMod m) = a • (1 : ZMod m) := by rw [zsmul_eq_mul, mul_one]
    have hb : (b : ZMod n) = b • (1 : ZMod n) := by rw [zsmul_eq_mul, mul_one]
    exact ⟨a * b, by rw [ha, hb, TensorProduct.smul_tmul, smul_smul, TensorProduct.tmul_smul]⟩
  · intro z w hz hw
    obtain ⟨k, hk⟩ := hz
    obtain ⟨l, hl⟩ := hw
    exact ⟨k + l, by rw [hk, hl, add_smul]⟩

/-- The tensor product `ZMod m ⊗[ℤ] ZMod n` is the zero ring if and only if the single pure tensor
`1 ⊗ₜ 1` vanishes. -/
theorem subsingleton_iff_one_tmul_one_eq_zero (m n : ℕ) :
    Subsingleton (ZMod m ⊗[ℤ] ZMod n) ↔ (1 : ZMod m) ⊗ₜ[ℤ] (1 : ZMod n) = 0 := by
  refine ⟨fun h => h.elim _ _, fun h => ⟨fun z w => ?_⟩⟩
  obtain ⟨k, rfl⟩ := exists_int_smul_one_tmul_one m n z
  obtain ⟨l, hl⟩ := exists_int_smul_one_tmul_one m n w
  rw [hl, h, smul_zero, smul_zero]

/-! ## The first step of the natural-language proof

The published solution begins with "multiplication by `n` is invertible on `ZMod m`", using
`(m, n) = 1`.  Mathlib knows this implication. -/

/-- If `m` and `n` are coprime, then `n` is a unit of `ZMod m`. -/
theorem isUnit_natCast_of_coprime (m n : ℕ) (h : Nat.Coprime m n) : IsUnit (n : ZMod m) :=
  (ZMod.isUnit_iff_coprime n m).mpr h.symm

/-- The rewriting step for which the natural-language proof uses the invertibility of `n`:  if `n`
is invertible in `ZMod m`, then every `x : ZMod m` is `n` times some `x' : ZMod m`. -/
theorem exists_smul_eq_of_isUnit_natCast (m n : ℕ) (h : IsUnit (n : ZMod m)) (x : ZMod m) :
    ∃ x' : ZMod m, x = n • x' := by
  obtain ⟨u, hu⟩ := h
  refine ⟨(↑u⁻¹ : ZMod m) * x, ?_⟩
  rw [nsmul_eq_mul, ← hu, ← mul_assoc, Units.mul_inv, one_mul]

/-! ## Sharpness:  the converse of the exercise

For a common divisor `d` of `m` and `n` there is a `ℤ`-linear map `ZMod m ⊗[ℤ] ZMod n → ZMod d`
sending `x ⊗ₜ y` to the product of the reductions of `x` and `y`.  It sends `1 ⊗ₜ 1` to `1`, so the
tensor product is nonzero as soon as some `d ≠ 1` divides both `m` and `n`. -/

/-- The `ℤ`-bilinear map `ZMod m × ZMod n → ZMod d` given by multiplication of the two
reductions, for `d` dividing both `m` and `n`. -/
noncomputable def zmodMulBilin (d m n : ℕ) (hm : d ∣ m) (hn : d ∣ n) :
    ZMod m →ₗ[ℤ] ZMod n →ₗ[ℤ] ZMod d :=
  LinearMap.mk₂ ℤ
    (fun x y => ZMod.castHom hm (ZMod d) x * ZMod.castHom hn (ZMod d) y)
    (fun x₁ x₂ y => by rw [map_add, add_mul])
    (fun c x y => by rw [zsmul_eq_mul, zsmul_eq_mul, map_mul, map_intCast]; ring)
    (fun x y₁ y₂ => by rw [map_add, mul_add])
    (fun c x y => by rw [zsmul_eq_mul, zsmul_eq_mul, map_mul, map_intCast]; ring)

@[simp]
theorem zmodMulBilin_apply (d m n : ℕ) (hm : d ∣ m) (hn : d ∣ n) (x : ZMod m) (y : ZMod n) :
    zmodMulBilin d m n hm hn x y =
      ZMod.castHom hm (ZMod d) x * ZMod.castHom hn (ZMod d) y :=
  rfl

/-- The pure tensor `1 ⊗ₜ 1` is nonzero in `ZMod m ⊗[ℤ] ZMod n` as soon as there is a common
divisor `d ≠ 1` of `m` and `n`:  the pairing `zmodMulBilin` sends it to `1` in `ZMod d`. -/
theorem one_tmul_one_ne_zero_of_dvd (m n d : ℕ) (hm : d ∣ m) (hn : d ∣ n) (hd : d ≠ 1) :
    ((1 : ZMod m) ⊗ₜ[ℤ] (1 : ZMod n) : ZMod m ⊗[ℤ] ZMod n) ≠ 0 := by
  intro h0
  have h1 : TensorProduct.lift (zmodMulBilin d m n hm hn)
      ((1 : ZMod m) ⊗ₜ[ℤ] (1 : ZMod n)) = 0 := by
    rw [h0]
    simp
  rw [TensorProduct.lift.tmul, zmodMulBilin_apply, map_one, map_one, one_mul] at h1
  exact hd (ZMod.subsingleton_iff.mp (subsingleton_of_one_eq_zero h1))

/-- If some `d ≠ 1` divides both `m` and `n`, then `ZMod m ⊗[ℤ] ZMod n` is not the zero ring. -/
theorem not_subsingleton_zmod_tensor_zmod_of_dvd (m n d : ℕ) (hm : d ∣ m) (hn : d ∣ n)
    (hd : d ≠ 1) : ¬ Subsingleton (ZMod m ⊗[ℤ] ZMod n) := by
  intro hsub
  exact one_tmul_one_ne_zero_of_dvd m n d hm hn hd (hsub.elim _ _)

/-- The exercise is sharp:  `ZMod m ⊗[ℤ] ZMod n` is the zero ring if and only if `m` and `n` are
coprime. -/
theorem zmod_tensor_zmod_subsingleton_iff (m n : ℕ) :
    Subsingleton (ZMod m ⊗[ℤ] ZMod n) ↔ Nat.Coprime m n := by
  refine ⟨fun hsub => ?_, zmod_tensor_zmod_subsingleton m n⟩
  by_contra hnc
  refine not_subsingleton_zmod_tensor_zmod_of_dvd m n (Nat.gcd m n) (Nat.gcd_dvd_left m n)
    (Nat.gcd_dvd_right m n) (fun hd => hnc ?_) hsub
  simpa [Nat.Coprime] using hd

/-- `ZMod m ⊗[ℤ] ZMod n` is the zero ring, in the ring-theoretic form `1 = 0`, if and only if `m`
and `n` are coprime. -/
theorem zmod_tensor_zmod_one_eq_zero_iff (m n : ℕ) :
    (1 : ZMod m ⊗[ℤ] ZMod n) = 0 ↔ Nat.Coprime m n := by
  refine ⟨fun h => ?_, zmod_tensor_zmod_one_eq_zero m n⟩
  rw [← zmod_tensor_zmod_subsingleton_iff]
  exact subsingleton_of_one_eq_zero h

/-! ## Two concrete instances -/

/-- `ZMod 2 ⊗[ℤ] ZMod 3` is the zero ring. -/
theorem zmod_two_tensor_zmod_three : Subsingleton (ZMod 2 ⊗[ℤ] ZMod 3) :=
  zmod_tensor_zmod_subsingleton 2 3 (by decide)

/-- `ZMod 2 ⊗[ℤ] ZMod 4` is *not* the zero ring, so coprimality cannot be dropped. -/
theorem zmod_two_tensor_zmod_four_not_subsingleton : ¬ Subsingleton (ZMod 2 ⊗[ℤ] ZMod 4) :=
  not_subsingleton_zmod_tensor_zmod_of_dvd 2 4 2 dvd_rfl (by norm_num) (by norm_num)

/-- In `ZMod 2 ⊗[ℤ] ZMod 4` the identity element is not zero:  this ring is not the zero ring. -/
theorem zmod_two_tensor_zmod_four_one_ne_zero : (1 : ZMod 2 ⊗[ℤ] ZMod 4) ≠ 0 := fun h =>
  zmod_two_tensor_zmod_four_not_subsingleton (subsingleton_of_one_eq_zero h)

end AtiyahMcdonald69.Ex_2_1

