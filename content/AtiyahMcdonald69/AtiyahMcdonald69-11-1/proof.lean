/-
# Atiyah–Macdonald (1969), Chapter 11, Exercise 1: regularity of a hypersurface

Let `k` be a field, `f ∈ k[x₁,…,xₙ]` a nonzero polynomial and `a` a point with `f(a) = 0`.
Write `A = k[x₁,…,xₙ]/(f)` and `𝔪` for the maximal ideal of `A` generated by the classes of
`Xᵢ - aᵢ`.  The exercise (with `k` algebraically closed and `f` irreducible) asks to prove

  `a` is a non-singular point of `f = 0`  ↔  `A_𝔪` is a regular local ring,

where `a` is non-singular when not all the partial derivatives `∂f/∂xᵢ` vanish at `a`.

The proof formalised here is the one from the book, in two halves.

* Regular case (`isRegularLocalRing_of_exists_pderiv_ne_zero`): if `∂ⱼf(a) ≠ 0`, the first
  order Taylor expansion `∑ᵢ ∂ᵢf(a)·(Xᵢ - aᵢ) ∈ 𝔪²` (together with the fact that
  `∂ⱼf(a)` is a unit of `A_𝔪`) shows `𝔪 = (Xᵢ - aᵢ : i ≠ j) + 𝔪²`, so by Nakayama
  (`Submodule.le_of_le_smul_of_le_jacobson_bot`) `𝔪` is generated by `n - 1` elements.  As
  `dim A_𝔪 = n - 1` (`ringKrullDim_LocRing`), `A_𝔪` is regular.

* Singular case (`not_isRegularLocalRing_of_forall_pderiv_eq_zero`): if all `∂ᵢf(a)` vanish, then
  for every `i` the "thickened point" `Xᵢ ↦ aᵢ + ε` (and `Xₖ ↦ aₖ` for `k ≠ i`) is a
  `k`-algebra map `A_𝔪 → k[ε]/(ε²)` (`ThetaS`); its `ε`-coefficient `delta i : A_𝔪 → k` is a
  derivation killing the square of the maximal ideal, with `delta i (Xⱼ - aⱼ) = δᵢⱼ`.  A
  derivation on a local ring is determined by its values on a generating set of the maximal
  ideal (`deriv_eq_zero_of_kills_span`), so the `n` functionals are linearly independent on
  `𝔪/𝔪²`; hence `𝔪` needs at least `n > n - 1 = dim A_𝔪` generators and `A_𝔪` is singular.

## Scope and hypotheses

* The field is arbitrary; algebraic closedness is only used in the book to know that every
  maximal ideal of `k[x₁,…,xₙ]` is the ideal of a point, and here the point `a` is given.
* Irreducibility of `f` is used only through `f ≠ 0` (to get `dim A_𝔪 = n - 1` from
  `dim k[x₁,…,xₙ] = n`); both forms are provided.
* `LocRing f a h := Localization.AtPrime (mIdeal f a)` is `A_𝔪` and `mIdeal f a` is the image in
  `A` of the maximal ideal `(Xᵢ - aᵢ)` of `k[x₁,…,xₙ]`.

No `sorry`, no extra axioms; everything is proved from `Mathlib`.
-/

import Mathlib

open MvPolynomial IsLocalRing

set_option linter.style.haveILetI false
set_option linter.style.emptyLine false
set_option linter.style.longLine false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 1600000

open MvPolynomial IsLocalRing

set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

namespace AtiyahMcdonald69.Ex_11_1

variable {k : Type*} [Field k]

/-! ## The point ideal of `k[X]` and the linear forms `X i - a i` -/

/-- The linear polynomial `X i - C (a i)`, which vanishes at the point `a`. -/
noncomputable def y {n : ℕ} (a : Fin n → k) (i : Fin n) : MvPolynomial (Fin n) k :=
  X i - C (a i)

/-- The maximal ideal of `k[X₁,…,Xₙ]` corresponding to the point `a`,
namely the kernel of evaluation at `a`. -/
noncomputable def ptIdeal {n : ℕ} (a : Fin n → k) : Ideal (MvPolynomial (Fin n) k) :=
  RingHom.ker (eval a)

variable {n : ℕ} {a : Fin n → k}

lemma mem_ptIdeal {g : MvPolynomial (Fin n) k} : g ∈ ptIdeal a ↔ eval a g = 0 := Iff.rfl

lemma y_mem (i : Fin n) : y a i ∈ ptIdeal a := by
  rw [mem_ptIdeal, y, map_sub, eval_X, eval_C, sub_self]

lemma eval_surj : Function.Surjective (eval a : MvPolynomial (Fin n) k →+* k) :=
  fun c => ⟨C c, eval_C c⟩

lemma ptIdeal_isMaximal : (ptIdeal a).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ eval_surj

instance instIsMaximalPtIdeal (a : Fin n → k) : (ptIdeal a).IsMaximal := ptIdeal_isMaximal

lemma ptIdeal_ne_top : ptIdeal a ≠ ⊤ := ptIdeal_isMaximal.ne_top

/-- **First-order Taylor expansion, part 1.** Any polynomial differs from its value at `a`
by a combination of the linear forms `X i - a i`. -/
lemma sub_C_eval_mem_span_y (g : MvPolynomial (Fin n) k) :
    g - C (eval a g) ∈ Ideal.span (Set.range (y a)) := by
  induction g using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
      have h1 : p + q - C (eval a (p + q)) = (p - C (eval a p)) + (q - C (eval a q)) := by
        rw [map_add, map_add]
        ring
      rw [h1]
      exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
      have h1 : p * X i - C (eval a (p * X i)) =
          (p - C (eval a p)) * X i + C (eval a p) * (X i - C (a i)) := by
        rw [map_mul, eval_X, map_mul]
        ring
      rw [h1]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
      exact Ideal.subset_span ⟨i, rfl⟩

lemma ptIdeal_le_span_y : ptIdeal a ≤ Ideal.span (Set.range (y a)) := by
  intro g hg
  have h := sub_C_eval_mem_span_y (a := a) g
  rw [mem_ptIdeal] at hg
  simpa [hg] using h

lemma span_y_le_ptIdeal : Ideal.span (Set.range (y a)) ≤ ptIdeal a := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact y_mem i

lemma ptIdeal_eq_span_y : ptIdeal a = Ideal.span (Set.range (y a)) :=
  le_antisymm ptIdeal_le_span_y span_y_le_ptIdeal

/-! ## Truncated spans and the substitution maps -/

/-- The ideal generated by the first `m` linear forms. -/
noncomputable def qIdeal {n : ℕ} (a : Fin n → k) (m : ℕ) : Ideal (MvPolynomial (Fin n) k) :=
  Ideal.span (y a '' {i : Fin n | i.val < m})

/-- Substitution of `a i` for `X i`, for all `i` with `i.val < m`. -/
noncomputable def subst {n : ℕ} (a : Fin n → k) (m : ℕ) :
    MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k :=
  aeval (fun i => if i.val < m then C (a i) else X i)

lemma subst_apply_C (m : ℕ) (c : k) : subst a m (C c) = C c := by
  simp [subst]

lemma subst_apply_X_of_lt (m : ℕ) {i : Fin n} (hi : i.val < m) : subst a m (X i) = C (a i) := by
  simp [subst, hi]

lemma subst_apply_X_of_le (m : ℕ) {i : Fin n} (hi : m ≤ i.val) : subst a m (X i) = X i := by
  simp [subst, Nat.not_lt.mpr hi]

lemma subst_apply_y_of_lt (m : ℕ) {i : Fin n} (hi : i.val < m) : subst a m (y a i) = 0 := by
  simp [y, subst, hi]

lemma subst_apply_y_of_le (m : ℕ) {i : Fin n} (hi : m ≤ i.val) : subst a m (y a i) = y a i := by
  simp [y, subst, Nat.not_lt.mpr hi]

/-- **First-order Taylor expansion, part 2 (truncated form).** -/
lemma sub_subst_mem_qIdeal (m : ℕ) (g : MvPolynomial (Fin n) k) :
    g - subst a m g ∈ qIdeal a m := by
  induction g using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
      have h1 : p + q - subst a m (p + q) = (p - subst a m p) + (q - subst a m q) := by
        rw [map_add]; ring
      rw [h1]
      exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
      have h1 : p * X i - subst a m (p * X i) = (p - subst a m p) * X i
          + subst a m p * (X i - subst a m (X i)) := by
        rw [map_mul]; ring
      rw [h1]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
      rcases lt_or_ge i.val m with h | h
      · rw [subst_apply_X_of_lt m h]
        exact Ideal.subset_span ⟨i, h, rfl⟩
      · rw [subst_apply_X_of_le m h, sub_self]
        exact Ideal.zero_mem _

lemma qIdeal_le_ker (m : ℕ) : qIdeal a m ≤ RingHom.ker (subst a m).toRingHom := by
  rw [qIdeal, Ideal.span_le]
  rintro _ ⟨i, hi, rfl⟩
  simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
  exact subst_apply_y_of_lt m hi

lemma ker_subst_le_qIdeal (m : ℕ) :
    RingHom.ker (subst a m).toRingHom ≤ qIdeal a m := by
  intro g hg
  have h1 : subst a m g = 0 := hg
  have h2 := sub_subst_mem_qIdeal (a := a) m g
  rw [h1, sub_zero] at h2
  exact h2

lemma qIdeal_eq_ker (m : ℕ) : qIdeal a m = RingHom.ker (subst a m).toRingHom :=
  le_antisymm (qIdeal_le_ker m) (ker_subst_le_qIdeal m)

lemma qIdeal_isPrime (m : ℕ) : (qIdeal a m).IsPrime := by
  rw [qIdeal_eq_ker]
  exact RingHom.ker_isPrime _

lemma qIdeal_zero : qIdeal a 0 = ⊥ := by
  rw [qIdeal]
  convert Ideal.span_empty (α := MvPolynomial (Fin n) k)
  ext i
  simp

lemma subst_n_apply (g : MvPolynomial (Fin n) k) : subst a n g = C (eval a g) := by
  induction g using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq => rw [map_add, hp, hq, map_add, map_add]
  | mul_X p i hp =>
      rw [map_mul, hp, subst_apply_X_of_lt n i.isLt, map_mul, eval_X, map_mul]

lemma qIdeal_n : qIdeal a n = ptIdeal a := by
  rw [qIdeal_eq_ker]
  ext g
  simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, mem_ptIdeal]
  rw [subst_n_apply]
  constructor
  · intro h
    simpa using h
  · intro h; rw [h]; simp

lemma qIdeal_mono {m₁ m₂ : ℕ} (h : m₁ ≤ m₂) : qIdeal a m₁ ≤ qIdeal a m₂ := by
  rw [qIdeal, qIdeal, Ideal.span_le]
  rintro _ ⟨i, hi, rfl⟩
  exact Ideal.subset_span ⟨i, lt_of_lt_of_le hi h, rfl⟩

/-- The linear form `X i - C (a i)` is nonzero. -/
lemma y_ne_zero (i : Fin n) : y a i ≠ 0 := by
  intro h
  have h2 := congrArg (eval (Function.update a i (a i + 1))) h
  rw [y, map_sub, eval_X, eval_C, map_zero, Function.update_self] at h2
  have h3 : a i + 1 - a i = 1 := by ring
  rw [h3] at h2
  exact one_ne_zero h2

lemma qIdeal_lt {m : ℕ} (hm : m < n) : qIdeal a m < qIdeal a (m + 1) := by
  refine lt_of_le_of_ne (qIdeal_mono (Nat.le_succ m)) (fun hEq => ?_)
  have hmem : y a ⟨m, hm⟩ ∈ qIdeal a m := by
    rw [hEq]
    exact Ideal.subset_span ⟨_, Nat.lt_succ_self m, rfl⟩
  have h0 : subst a m (y a ⟨m, hm⟩) = 0 := qIdeal_le_ker m hmem
  rw [subst_apply_y_of_le m (le_refl m)] at h0
  exact y_ne_zero ⟨m, hm⟩ h0


/-! ## The height of the point ideal -/

lemma height_qIdeal_ge : ∀ m ≤ n, (m : ℕ∞) ≤ (qIdeal a m).height := by
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
      intro hm
      have h1 : (m : ℕ∞) ≤ (qIdeal a m).height := ih (Nat.le_of_succ_le hm)
      have h2 : (qIdeal a m).height + 1 ≤ (qIdeal a (m + 1)).height :=
        @Ideal.height_add_one_le_of_lt_of_isPrime _ _ (qIdeal a m) (qIdeal a (m + 1))
          (qIdeal_isPrime (a := a) m) (qIdeal_isPrime (a := a) (m + 1))
          (qIdeal_lt (a := a) (m := m) hm)
      have h3 : ((m : ℕ∞) + 1) ≤ (qIdeal a (m + 1)).height := by
        calc (m : ℕ∞) + 1 ≤ (qIdeal a m).height + 1 := by gcongr
          _ ≤ _ := h2
      simpa [Nat.cast_add, Nat.cast_one] using h3

/-- The point ideal of `k[X₁,…,Xₙ]` has height `n`. -/
theorem ptIdeal_height : (ptIdeal a).height = (n : ℕ∞) := by
  refine le_antisymm ?_ ?_
  · have h := Ideal.height_le_ringKrullDim_of_ne_top (I := ptIdeal a) ptIdeal_ne_top
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing] at h
    simp only [ringKrullDim_eq_zero_of_field, Nat.card_eq_fintype_card, Fintype.card_fin,
      zero_add] at h
    exact WithBot.coe_le_coe.mp h
  · rw [← qIdeal_n (a := a)]
    exact height_qIdeal_ge n le_rfl

/-! ## Second-order Taylor expansion -/

lemma pderiv_X_ite (i j : Fin n) :
    pderiv i (X j : MvPolynomial (Fin n) k) = if i = j then 1 else 0 := by
  by_cases h : i = j
  · subst h; simp
  · rw [pderiv_X_of_ne (Ne.symm h), if_neg h]

lemma eval_pderiv_X (i j : Fin n) : eval a (pderiv i (X j)) = if i = j then 1 else 0 := by
  rw [pderiv_X_ite]
  by_cases h : i = j
  · rw [if_pos h, if_pos h]; simp
  · rw [if_neg h, if_neg h]; simp

/-- The derivative of `X j - C (a j)` is `1` in the direction `j` and `0` elsewhere. -/
lemma eval_pderiv_y (i j : Fin n) : eval a (pderiv i (y a j)) = if i = j then 1 else 0 := by
  have h1 : pderiv i (y a j) = pderiv i (X j) := by rw [y, map_sub, pderiv_C, sub_zero]
  rw [h1, eval_pderiv_X]

/-- **Second-order Taylor expansion.** A polynomial differs from its first-order Taylor
polynomial at `a` by an element of the square of the ideal generated by the `X i - a i`. -/
lemma taylor_sq_mem (g : MvPolynomial (Fin n) k) :
    g - C (eval a g) - ∑ i, C (eval a (pderiv i g)) * y a i
      ∈ (Ideal.span (Set.range (y a))) ^ 2 := by
  classical
  induction g using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
      have hsum : (∑ i, C (eval a (pderiv i (p + q))) * y a i)
          = (∑ i, C (eval a (pderiv i p)) * y a i)
            + (∑ i, C (eval a (pderiv i q)) * y a i) := by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i _ => by simp only [map_add]; ring)
      have hid : p + q - C (eval a (p + q)) - ∑ i, C (eval a (pderiv i (p + q))) * y a i
          = (p - C (eval a p) - ∑ i, C (eval a (pderiv i p)) * y a i)
            + (q - C (eval a q) - ∑ i, C (eval a (pderiv i q)) * y a i) := by
        rw [hsum]
        simp only [map_add]
        ring
      rw [hid]
      exact Ideal.add_mem _ hp hq
  | mul_X p j hp =>
      set T : MvPolynomial (Fin n) k := ∑ i, C (eval a (pderiv i p)) * y a i with hT
      set tau : MvPolynomial (Fin n) k := p - C (eval a p) - T with htau
      have hptau : p = tau + C (eval a p) + T := by rw [htau]; ring
      have hX : (X j : MvPolynomial (Fin n) k) = y a j + C (a j) := by rw [y]; ring
      have hbody : ∀ i : Fin n,
          C (eval a (pderiv i (p * X j))) * y a i
            = (C (eval a (pderiv i p)) * C (a j)) * y a i
              + (C (eval a p) * (if i = j then (1 : MvPolynomial (Fin n) k) else 0)) * y a i := by
        intro i
        rw [pderiv_mul]
        simp only [map_add, map_mul, eval_X, eval_pderiv_X]
        rcases eq_or_ne i j with h | h
        · subst h; simp; ring
        · rw [if_neg h, if_neg h]; simp
      have hdiag : (∑ i, (C (eval a p) * (if i = j then (1 : MvPolynomial (Fin n) k) else 0))
          * y a i) = C (eval a p) * y a j := by
        rw [Finset.sum_eq_single j]
        · simp
        · intro b _ hb; simp [hb]
        · intro hcon; exact absurd (Finset.mem_univ j) hcon
      have hoff : (∑ i, (C (eval a (pderiv i p)) * C (a j)) * y a i) = C (a j) * T := by
        rw [hT, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      have hring : ∀ (P X c aa yy TT tt : MvPolynomial (Fin n) k), X = yy + aa →
          P = tt + c + TT → P * X - c * aa - (aa * TT + c * yy) = TT * yy + tt * X := by
        intro P X c aa yy TT tt hX' hP
        rw [hX', hP]
        ring
      have hkey : p * X j - C (eval a (p * X j))
          - ∑ i, C (eval a (pderiv i (p * X j))) * y a i = T * y a j + tau * X j := by
        have e1 : p * X j - C (eval a (p * X j))
            - ∑ i, C (eval a (pderiv i (p * X j))) * y a i
            = p * X j - C (eval a p) * C (a j) - (C (a j) * T + C (eval a p) * y a j) := by
          rw [Finset.sum_congr rfl (fun i (_ : i ∈ Finset.univ) => hbody i),
            Finset.sum_add_distrib, hdiag, hoff]
          simp only [map_mul, eval_X]
        rw [e1]
        exact hring p (X j) (C (eval a p)) (C (a j)) (y a j) T tau hX hptau
      rw [hkey]
      refine Ideal.add_mem _ ?_ (Ideal.mul_mem_right _ _ hp)
      rw [hT, Finset.sum_mul]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      have h1 : y a i ∈ Ideal.span (Set.range (y a)) := Ideal.subset_span ⟨i, rfl⟩
      have h2 : y a j ∈ Ideal.span (Set.range (y a)) := Ideal.subset_span ⟨j, rfl⟩
      have hmem : y a i * y a j ∈ (Ideal.span (Set.range (y a))) ^ 2 := by
        rw [pow_two]
        exact Ideal.mul_mem_mul h1 h2
      have hEq : C (eval a (pderiv i p)) * y a i * y a j
          = C (eval a (pderiv i p)) * (y a i * y a j) := by ring
      rw [hEq]
      exact Ideal.mul_mem_left _ _ hmem

/-- The second-order Taylor expansion, stated for the point ideal. -/
lemma taylor_sq_mem_ptIdeal (g : MvPolynomial (Fin n) k) :
    g - C (eval a g) - ∑ i, C (eval a (pderiv i g)) * y a i ∈ (ptIdeal a) ^ 2 := by
  rw [ptIdeal_eq_span_y]
  exact taylor_sq_mem g

/-! ## The coordinate ring of the hypersurface -/

/-- The coordinate ring `k[X₁,…,Xₙ]/(f)` of the hypersurface `f = 0`. -/
abbrev HypRing {n : ℕ} (f : MvPolynomial (Fin n) k) : Type _ :=
  MvPolynomial (Fin n) k ⧸ Ideal.span {f}

/-- The maximal ideal of the coordinate ring corresponding to the point `a`. -/
noncomputable abbrev mIdeal {n : ℕ} (f : MvPolynomial (Fin n) k) (a : Fin n → k) :
    Ideal (HypRing f) :=
  (ptIdeal a).map (Ideal.Quotient.mk (Ideal.span {f}))

variable {f : MvPolynomial (Fin n) k} {a : Fin n → k}

lemma f_mem_ptIdeal (hP : eval a f = 0) : f ∈ ptIdeal a := by
  rwa [mem_ptIdeal]

lemma span_f_le_ptIdeal (hP : eval a f = 0) : Ideal.span {f} ≤ ptIdeal a :=
  Ideal.span_le.mpr (by simpa using f_mem_ptIdeal hP)

lemma mIdeal_isMaximal (hP : eval a f = 0) : (mIdeal f a).IsMaximal :=
  Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact span_f_le_ptIdeal hP)

lemma span_f_isPrime (hirr : Irreducible f) : (Ideal.span {f}).IsPrime :=
  (Ideal.span_singleton_prime hirr.ne_zero).mpr hirr.prime

lemma isDomain_hypRing (hirr : Irreducible f) : IsDomain (HypRing f) :=
  Ideal.Quotient.isDomain_iff_prime _ |>.mpr (span_f_isPrime hirr)

/-- `dim A + 1 ≤ n`. -/
lemma ringKrullDim_hypRing_add_one_le (hirr : Irreducible f) :
    ringKrullDim (HypRing f) + 1 ≤ ((n : ℕ∞) : WithBot ℕ∞) := by
  have h := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (R := MvPolynomial (Fin n) k)
    (mem_nonZeroDivisors_of_ne_zero hirr.ne_zero)
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field] at h
  simpa using h

/-- `dim A_𝔪 + 1 ≤ n`. -/
lemma mIdeal_height_succ_le (hP : eval a f = 0) (hirr : Irreducible f) :
    (mIdeal f a).height + 1 ≤ (n : ℕ∞) := by
  have h1 : ((mIdeal f a).height : WithBot ℕ∞) ≤ ringKrullDim (HypRing f) :=
    Ideal.height_le_ringKrullDim_of_ne_top (mIdeal_isMaximal hP).ne_top
  have h2 := ringKrullDim_hypRing_add_one_le (f := f) hirr
  have h3 : ((mIdeal f a).height : WithBot ℕ∞) + 1 ≤ ((n : ℕ∞) : WithBot ℕ∞) := by
    calc ((mIdeal f a).height : WithBot ℕ∞) + 1 ≤ ringKrullDim (HypRing f) + 1 := by gcongr
      _ ≤ _ := h2
  rw [← WithBot.coe_one, ← WithBot.coe_add, WithBot.coe_le_coe] at h3
  exact h3

/-- `n - 1 ≤ dim A_𝔪`. -/
lemma le_mIdeal_height (hP : eval a f = 0) :
    ((n - 1 : ℕ) : ℕ∞) ≤ (mIdeal f a).height := by
  have h := Ideal.height_le_height_add_one_of_mem (r := f) (p := ptIdeal a)
    (f_mem_ptIdeal hP)
  rw [ptIdeal_height] at h
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn; simp
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hn)
    have h' : (m : ℕ∞) + 1 ≤ (mIdeal f a).height + 1 := by
      simpa [Nat.cast_add, Nat.cast_one] using h
    exact (ENat.add_le_add_iff_right (k := 1) (by simp)).mp h'

/-! ## The local ring of a point of the hypersurface -/

/-- The local ring `A_𝔪` of the coordinate ring at the point `a`. -/
noncomputable abbrev LocRing {n : ℕ} (f : MvPolynomial (Fin n) k) (a : Fin n → k)
    (h : (mIdeal f a).IsMaximal) : Type _ :=
  @Localization.AtPrime _ _ (mIdeal f a) h.isPrime

/-- The canonical map `k[X₁,…,Xₙ] → A → A_𝔪`. -/
noncomputable def toLoc {n : ℕ} (f : MvPolynomial (Fin n) k) (a : Fin n → k)
    (h : (mIdeal f a).IsMaximal) : MvPolynomial (Fin n) k →ₐ[k] LocRing f a h :=
  (IsScalarTower.toAlgHom k (HypRing f) (LocRing f a h)).comp
    (Ideal.Quotient.mkₐ k (Ideal.span {f}))

section Main

variable {f : MvPolynomial (Fin n) k} {a : Fin n → k} (hmax : (mIdeal f a).IsMaximal)

lemma toLoc_C (c : k) :
    toLoc f a hmax (MvPolynomial.C c) = algebraMap k (LocRing f a hmax) c :=
  (toLoc f a hmax).commutes c

lemma maximalIdeal_LocRing_eq :
    maximalIdeal (LocRing f a hmax) = (ptIdeal a).map (toLoc f a hmax).toRingHom := by
  haveI : (mIdeal f a).IsPrime := hmax.isPrime
  have h1 : Ideal.map (algebraMap (HypRing f) (LocRing f a hmax)) (mIdeal f a) =
      maximalIdeal (LocRing f a hmax) := Localization.AtPrime.map_eq_maximalIdeal
  rw [← h1]
  show Ideal.map (algebraMap (HypRing f) (LocRing f a hmax))
      ((ptIdeal a).map (Ideal.Quotient.mk (Ideal.span {f}))) = _
  rw [Ideal.map_map]
  rfl

lemma maximalIdeal_LocRing_eq_span :
    maximalIdeal (LocRing f a hmax) =
      Ideal.span (Set.range (fun i => toLoc f a hmax (y a i))) := by
  rw [maximalIdeal_LocRing_eq, ptIdeal_eq_span_y, Ideal.map_span, ← Set.range_comp]
  rfl

/-- The Taylor expansion of `f` at `a`, pushed into `A_𝔪`. -/
lemma toLoc_self : toLoc f a hmax f = 0 := by
  simp [toLoc]

lemma toLoc_self' : (toLoc f a hmax).toRingHom f = 0 := toLoc_self hmax

lemma toLoc_C' (c : k) :
    (toLoc f a hmax).toRingHom (MvPolynomial.C c) = algebraMap k (LocRing f a hmax) c :=
  toLoc_C hmax c

lemma taylor_sum_mem (hP : eval a f = 0) :
    (∑ i, toLoc f a hmax (MvPolynomial.C (eval a (pderiv i f))) * toLoc f a hmax (y a i))
      ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
  have hmem := taylor_sq_mem_ptIdeal (a := a) f
  have hmap : (toLoc f a hmax).toRingHom
      (f - C (eval a f) - ∑ i, C (eval a (pderiv i f)) * y a i)
      ∈ Ideal.map (toLoc f a hmax).toRingHom ((ptIdeal a) ^ 2) :=
    Ideal.mem_map_of_mem _ hmem
  have hpow : Ideal.map (toLoc f a hmax).toRingHom ((ptIdeal a) ^ 2) =
      (maximalIdeal (LocRing f a hmax)) ^ 2 := by
    rw [maximalIdeal_LocRing_eq, Ideal.map_pow]
  rw [hpow] at hmap
  have h2 : (toLoc f a hmax).toRingHom f - (toLoc f a hmax).toRingHom (C (eval a f))
      - ∑ i, (toLoc f a hmax).toRingHom (C (eval a (pderiv i f)))
        * (toLoc f a hmax).toRingHom (y a i)
      ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
    simpa only [map_sub, map_sum, map_mul] using hmap
  rw [toLoc_self', toLoc_C', hP, map_zero] at h2
  have hS : -(∑ i, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
      * (toLoc f a hmax) (y a i)) ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
    simpa [toLoc_C'] using h2
  have hmul : (-1 : LocRing f a hmax) * (-(∑ i, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
      * (toLoc f a hmax) (y a i))) ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 :=
    Ideal.mul_mem_left _ _ hS
  rw [show (-1 : LocRing f a hmax) * (-(∑ i, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
      * (toLoc f a hmax) (y a i))) = ∑ i, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
      * (toLoc f a hmax) (y a i) from by ring] at hmul
  exact hmul

/-- In Case 1, the maximal ideal of `A_𝔪` is generated by the images of the `y i` for `i ≠ j`. -/
lemma maximalIdeal_le_span_ne (hP : eval a f = 0) {j : Fin n} (hj : eval a (pderiv j f) ≠ 0) :
    maximalIdeal (LocRing f a hmax) ≤
      Ideal.span (Set.range (fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1))) := by
  haveI : (mIdeal f a).IsPrime := hmax.isPrime
  classical
  set T : Ideal (LocRing f a hmax) :=
    Ideal.span (Set.range (fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1))) with hT
  have hyT : ∀ i : Fin n, i ≠ j → (toLoc f a hmax) (y a i) ∈ T := by
    intro i hi
    rw [hT]
    exact Ideal.subset_span ⟨⟨i, hi⟩, rfl⟩
  have hTM : T ≤ maximalIdeal (LocRing f a hmax) := by
    rw [hT, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [maximalIdeal_LocRing_eq_span]
    exact Ideal.subset_span ⟨i.1, rfl⟩
  have hsum := taylor_sum_mem (f := f) (a := a) hmax hP
  have hsplit : (∑ i, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
        * (toLoc f a hmax) (y a i))
      = (∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
          * (toLoc f a hmax) (y a i))
        + (algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j) :=
    (Finset.sum_erase_add _ _ (Finset.mem_univ j)).symm
  have hR : (∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
      * (toLoc f a hmax) (y a i)) ∈ T := by
    refine Ideal.sum_mem _ (fun i hi => ?_)
    exact Ideal.mul_mem_left _ _ (hyT i (Finset.mem_erase.mp hi).1)
  have huj : IsUnit ((algebraMap k (LocRing f a hmax)) (eval a (pderiv j f))) :=
    (isUnit_iff_ne_zero.mpr hj).map (algebraMap k (LocRing f a hmax))
  have hyj : (toLoc f a hmax) (y a j) ∈ T ⊔ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
    have hmem : (∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
          * (toLoc f a hmax) (y a i))
        + (algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j)
        ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
      rw [← hsplit]; exact hsum
    have h1 : (algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j)
        ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 ⊔ T := by
      have hneg : -(∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
          * (toLoc f a hmax) (y a i)) ∈ T := by
        have hm := Ideal.mul_mem_left T (-1) hR
        rwa [show (-1 : LocRing f a hmax) * (∑ i ∈ Finset.univ.erase j,
            (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f)) * (toLoc f a hmax) (y a i))
          = -(∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
            * (toLoc f a hmax) (y a i)) from by ring] at hm
      have hadd := Submodule.add_mem_sup (show _ ∈ (maximalIdeal (LocRing f a hmax)) ^ 2 from hmem) hneg
      rw [show (∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
            * (toLoc f a hmax) (y a i))
          + (algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j)
          + -(∑ i ∈ Finset.univ.erase j, (algebraMap k (LocRing f a hmax)) (eval a (pderiv i f))
            * (toLoc f a hmax) (y a i))
          = (algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j)
          from by ring] at hadd
      exact hadd
    rw [sup_comm] at h1
    obtain ⟨v, hv⟩ := huj.exists_left_inv
    have hEq : (toLoc f a hmax) (y a j)
        = v * ((algebraMap k (LocRing f a hmax)) (eval a (pderiv j f)) * (toLoc f a hmax) (y a j)) := by
      rw [← mul_assoc, hv, one_mul]
    rw [hEq]
    exact Ideal.mul_mem_left _ _ h1
  have hgen : maximalIdeal (LocRing f a hmax) ≤ T ⊔ (maximalIdeal (LocRing f a hmax)) ^ 2 := by
    conv_lhs => rw [maximalIdeal_LocRing_eq_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    by_cases hi : i = j
    · subst hi; exact hyj
    · exact Ideal.mem_sup_left (hyT i hi)
  have h2 : (maximalIdeal (LocRing f a hmax)) ^ 2
      = maximalIdeal (LocRing f a hmax) • (maximalIdeal (LocRing f a hmax) : Ideal (LocRing f a hmax)) := by
    rw [smul_eq_mul, pow_two]
  rw [h2] at hgen
  exact Submodule.le_of_le_smul_of_le_jacobson_bot (R := LocRing f a hmax) (M := LocRing f a hmax)
    (I := maximalIdeal (LocRing f a hmax)) (N := T) (N' := maximalIdeal (LocRing f a hmax))
    (IsNoetherian.noetherian _)
    (le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (R := LocRing f a hmax) (⊥ : Ideal (LocRing f a hmax)) bot_ne_top).symm)
    hgen

/-- In Case 1 the maximal ideal has at most `n - 1` generators. -/
lemma spanFinrank_maximalIdeal_le (hP : eval a f = 0) {j : Fin n}
    (hj : eval a (pderiv j f) ≠ 0) :
    (maximalIdeal (LocRing f a hmax)).spanFinrank ≤ n - 1 := by
  classical
  have hle := maximalIdeal_le_span_ne (f := f) (a := a) hmax hP hj
  have hTM : Ideal.span (Set.range (fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1)))
      ≤ maximalIdeal (LocRing f a hmax) := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [maximalIdeal_LocRing_eq_span]
    exact Ideal.subset_span ⟨i.1, rfl⟩
  have hEq : maximalIdeal (LocRing f a hmax)
      = Ideal.span (Set.range (fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1))) :=
    le_antisymm hle hTM
  rw [hEq]
  refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)) ?_
  have h1 : (Set.range (fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1))).ncard
      ≤ Nat.card {i : Fin n // i ≠ j} := by
    have := Set.ncard_image_le (s := (Set.univ : Set {i : Fin n // i ≠ j}))
      (f := fun i : {i : Fin n // i ≠ j} => (toLoc f a hmax) (y a i.1))
    rwa [Set.image_univ, Set.ncard_univ] at this
  refine h1.trans ?_
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl]
  simp


/-! ## Case 2: thickened points and tangent functionals -/

lemma fst_algebraMap_dual (c : k) : (algebraMap k (DualNumber k) c).fst = c := by
  rw [TrivSqZeroExt.algebraMap_eq_inl]; simp

lemma snd_algebraMap_dual (c : k) : (algebraMap k (DualNumber k) c).snd = 0 := by
  rw [TrivSqZeroExt.algebraMap_eq_inl]; simp

lemma snd_mul_dual {x y : DualNumber k} : (x * y).snd = x.fst * y.snd + y.fst * x.snd := by
  rw [TrivSqZeroExt.snd_mul]
  have h1 : TrivSqZeroExt.fst x • TrivSqZeroExt.snd y
      = TrivSqZeroExt.fst x * TrivSqZeroExt.snd y := rfl
  have h2 : MulOpposite.op (TrivSqZeroExt.fst y) • TrivSqZeroExt.snd x
      = TrivSqZeroExt.snd x * TrivSqZeroExt.fst y := by simp
  rw [h1, h2]
  ring

/-- The thickened point at `a` in the direction `i`, as a `k`-algebra map to the dual numbers. -/
noncomputable def theta {n : ℕ} (a : Fin n → k) (i : Fin n) :
    MvPolynomial (Fin n) k →ₐ[k] DualNumber k :=
  MvPolynomial.aeval fun j =>
    if j = i then (TrivSqZeroExt.inl (a j) + TrivSqZeroExt.inr 1) else TrivSqZeroExt.inl (a j)

variable {n : ℕ} {a : Fin n → k} {f : MvPolynomial (Fin n) k}

lemma theta_fst {i : Fin n} (g : MvPolynomial (Fin n) k) : (theta a i g).fst = eval a g := by
  induction g using MvPolynomial.induction_on with
  | C c => simp [theta, fst_algebraMap_dual]
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p j hp =>
      rw [map_mul, TrivSqZeroExt.fst_mul, hp]
      rcases eq_or_ne j i with h | h
      · subst h
        rw [theta, MvPolynomial.aeval_X, if_pos rfl, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl,
          TrivSqZeroExt.fst_inr, add_zero, map_mul, eval_X]
      · rw [theta, MvPolynomial.aeval_X, if_neg h, TrivSqZeroExt.fst_inl, map_mul, eval_X]

lemma theta_snd {i : Fin n} (g : MvPolynomial (Fin n) k) :
    (theta a i g).snd = eval a (pderiv i g) := by
  induction g using MvPolynomial.induction_on with
  | C c => simp [theta, snd_algebraMap_dual]
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p j hp =>
      have hXfst : (theta a i (X j)).fst = a j := by
        rcases eq_or_ne j i with h | h
        · subst h; rw [theta, MvPolynomial.aeval_X, if_pos rfl, TrivSqZeroExt.fst_add,
            TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero]
        · rw [theta, MvPolynomial.aeval_X, if_neg h, TrivSqZeroExt.fst_inl]
      have hXsnd : (theta a i (X j)).snd = if j = i then 1 else 0 := by
        rcases eq_or_ne j i with h | h
        · subst h; rw [theta, MvPolynomial.aeval_X, if_pos rfl, TrivSqZeroExt.snd_add,
            TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add, if_pos rfl]
        · rw [theta, MvPolynomial.aeval_X, if_neg h, TrivSqZeroExt.snd_inl, if_neg h]
      rw [map_mul, snd_mul_dual, theta_fst, hp, hXfst, hXsnd, pderiv_mul,
        pderiv_X_ite]
      rcases eq_or_ne j i with h | h
      · subst h; rw [if_pos rfl, if_pos rfl]; simp; ring
      · rw [if_neg h, if_neg (Ne.symm h)]; simp; ring

/-- In Case 2 the thickened-point map kills `f`. -/
lemma theta_f_eq_zero {i : Fin n} (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) :
    theta a i f = 0 := by
  have h1 := theta_fst (a := a) (i := i) f
  have h2 := theta_snd (a := a) (i := i) f
  rw [hP] at h1
  rw [h0 i] at h2
  have h : theta a i f = TrivSqZeroExt.inl (0 : k) + TrivSqZeroExt.inr (0 : k) := by
    ext
    · simpa using h1
    · simpa using h2
  simpa using h

/-! ## Descending the thickened point to `A` -/

/-- The evaluation map `A = k[X]/(f) → k` at the point `a`. -/
noncomputable def evalA (hP : eval a f = 0) : HypRing f →+* k :=
  Ideal.Quotient.lift (Ideal.span {f}) (MvPolynomial.eval a) (by
    intro x hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [map_mul, hP, zero_mul])

lemma evalA_mk (hP : eval a f = 0) (r : MvPolynomial (Fin n) k) :
    evalA hP (Ideal.Quotient.mk _ r) = eval a r := by
  simp [evalA]

lemma mIdeal_eq_ker_evalA (hP : eval a f = 0) : mIdeal f a = RingHom.ker (evalA hP) := by
  ext x
  constructor
  · intro hx
    obtain ⟨r, hr, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hx
    rw [RingHom.mem_ker]
    simpa [evalA_mk, mem_ptIdeal] using hr
  · intro hx
    rw [RingHom.mem_ker] at hx
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    refine (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mpr ⟨r, ?_, rfl⟩
    simpa [evalA_mk, mem_ptIdeal] using hx

/-- In Case 2 the thickened-point map descends to the coordinate ring `A`. -/
noncomputable def ThetaA (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) :
    HypRing f →+* DualNumber k :=
  Ideal.Quotient.lift (Ideal.span {f}) (theta a i).toRingHom (by
    intro x hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp hx
    have hfy : (theta a i).toRingHom f = 0 := theta_f_eq_zero hP h0
    rw [map_mul, hfy, zero_mul])

lemma ThetaA_mk (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n)
    (r : MvPolynomial (Fin n) k) :
    ThetaA hP h0 i (Ideal.Quotient.mk _ r) = theta a i r := by
  simp [ThetaA]

lemma ThetaA_fst (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n)
    (x : HypRing f) : (ThetaA hP h0 i x).fst = evalA hP x := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [ThetaA_mk, theta_fst, evalA_mk]

/-- A dual number whose constant term is nonzero is a unit. -/
lemma isUnit_dual_of_fst_ne_zero {x : DualNumber k} (hx : x.fst ≠ 0) : IsUnit x := by
  have hrep : x = TrivSqZeroExt.inl x.fst + TrivSqZeroExt.inr x.snd := by
    ext <;> simp
  rw [hrep]
  refine IsUnit.of_mul_eq_one
    (TrivSqZeroExt.inl x.fst⁻¹ + TrivSqZeroExt.inr (-(x.snd * x.fst⁻¹ * x.fst⁻¹))) ?_
  ext
  · simp [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl]
    field_simp
  · simp [TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add, TrivSqZeroExt.fst_inl,
      TrivSqZeroExt.snd_inl]
    field_simp
    ring

end Main

end Ex_11_1

namespace Ex_11_1

noncomputable section

variable {k : Type*} [Field k] {n : ℕ} {a : Fin n → k} {f : MvPolynomial (Fin n) k}

/-! ## The dimension of the local ring, with `f ≠ 0` instead of irreducibility -/

lemma ringKrullDim_hypRing_add_one_le_of_ne_zero (hf : f ≠ 0) :
    ringKrullDim (HypRing f) + 1 ≤ ((n : ℕ∞) : WithBot ℕ∞) := by
  have h := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (R := MvPolynomial (Fin n) k)
    (mem_nonZeroDivisors_of_ne_zero hf)
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field] at h
  simpa using h

lemma mIdeal_height_succ_le_of_ne_zero (hP : eval a f = 0) (hf : f ≠ 0) :
    (mIdeal f a).height + 1 ≤ (n : ℕ∞) := by
  have h1 : ((mIdeal f a).height : WithBot ℕ∞) ≤ ringKrullDim (HypRing f) :=
    Ideal.height_le_ringKrullDim_of_ne_top (mIdeal_isMaximal hP).ne_top
  have h2 := ringKrullDim_hypRing_add_one_le_of_ne_zero (f := f) hf
  have h3 : ((mIdeal f a).height : WithBot ℕ∞) + 1 ≤ ((n : ℕ∞) : WithBot ℕ∞) := by
    calc ((mIdeal f a).height : WithBot ℕ∞) + 1 ≤ ringKrullDim (HypRing f) + 1 := by gcongr
      _ ≤ _ := h2
  rw [← WithBot.coe_one, ← WithBot.coe_add, WithBot.coe_le_coe] at h3
  exact h3

/-- A nonempty list of coordinates: `k[x₁,…,x_n]/(f)` has a point only for `n ≥ 1` when `f ≠ 0`. -/
lemma one_le_of_isMaximal (_hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (hf : f ≠ 0) :
    1 ≤ n := by
  have h1 := mIdeal_height_succ_le_of_ne_zero (f := f) (a := a) hP hf
  rcases Nat.eq_zero_or_pos n with h | h
  · exfalso
    have hlt : (0 : ℕ∞) < (mIdeal f a).height + 1 := by simp
    have hle : (mIdeal f a).height + 1 ≤ (0 : ℕ∞) := by
      calc (mIdeal f a).height + 1 ≤ (n : ℕ∞) := h1
        _ = 0 := by rw [h]; simp
    exact absurd hle (not_le.mpr hlt)
  · omega

/-- The Krull dimension of `A_𝔪` is `n - 1`. -/
theorem ringKrullDim_LocRing (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (hf : f ≠ 0) :
    ringKrullDim (LocRing f a hmax) = (((n - 1 : ℕ)) : ℕ∞) := by
  haveI : (mIdeal f a).IsPrime := hmax.isPrime
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (mIdeal f a) (LocRing f a hmax)]
  have h1 := mIdeal_height_succ_le_of_ne_zero (f := f) (a := a) hP hf
  have h2 := le_mIdeal_height (f := f) (a := a) hP
  have hpos : 1 ≤ n := one_le_of_isMaximal hmax hP hf
  have hcast : ((n - 1 : ℕ) : ℕ∞) + 1 = (n : ℕ∞) := by
    calc ((n - 1 : ℕ) : ℕ∞) + 1 = ((n - 1 : ℕ) : ℕ∞) + ((1:ℕ) : ℕ∞) := by rw [Nat.cast_one]
      _ = ((n - 1 + 1 : ℕ) : ℕ∞) := by rw [Nat.cast_add]
      _ = (n : ℕ∞) := by rw [Nat.sub_add_cancel hpos]
  have h1'' : (mIdeal f a).height + 1 ≤ ((n - 1 : ℕ) : ℕ∞) + 1 := by
    rw [hcast]; exact h1
  have h3 : (mIdeal f a).height ≤ ((n - 1 : ℕ) : ℕ∞) :=
    (ENat.add_le_add_iff_right (by simp)).mp h1''
  have hheight : (mIdeal f a).height = ((n - 1 : ℕ) : ℕ∞) := le_antisymm h3 h2
  rw [hheight]

/-- Case 1: a non-vanishing partial derivative makes `A_𝔪` regular. -/
theorem isRegularLocalRing_of_exists_pderiv_ne_zero (hmax : (mIdeal f a).IsMaximal)
    (hP : eval a f = 0) (hf : f ≠ 0) {j : Fin n} (hj : eval a (pderiv j f) ≠ 0) :
    IsRegularLocalRing (LocRing f a hmax) := by
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (LocRing f a hmax) ?_
  rw [ringKrullDim_LocRing hmax hP hf]
  exact_mod_cast spanFinrank_maximalIdeal_le hmax hP hj

end

end Ex_11_1


namespace Ex_11_1

noncomputable section

variable {k : Type*} [Field k] {n : ℕ} {a : Fin n → k} {f : MvPolynomial (Fin n) k}

/-! ## Case 2: all partial derivatives vanish -/

section Case2

/-! ### The residue map `A_𝔪 → k` -/

lemma evalA_algebraMap (hP : eval a f = 0) (c : k) :
    evalA hP (algebraMap k (HypRing f) c) = c := by
  rw [show algebraMap k (HypRing f) c
      = Ideal.Quotient.mk (Ideal.span {f}) (MvPolynomial.C c) from rfl, evalA_mk]
  simp

/-- A class in `A` whose evaluation at `a` vanishes lies in `𝔪`. -/
lemma mem_mIdeal_of_evalA_eq_zero (hP : eval a f = 0) {x : HypRing f}
    (hx : evalA hP x = 0) : x ∈ mIdeal f a := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [evalA_mk] at hx
  exact Ideal.mem_map_of_mem _ (by rwa [mem_ptIdeal])

/-- Evaluation at the point `a`, as a ring hom on the local ring `A_𝔪`. -/
noncomputable def evS (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) :
    LocRing f a hmax →+* k :=
  IsLocalization.lift (M := (mIdeal f a).primeCompl) (g := evalA hP) (by
    intro y
    exact isUnit_iff_ne_zero.mpr fun hcon => y.2 (mem_mIdeal_of_evalA_eq_zero hP hcon))

lemma evS_algebraMap (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (x : HypRing f) :
    evS hmax hP (algebraMap (HypRing f) (LocRing f a hmax) x) = evalA hP x :=
  IsLocalization.lift_eq (M := (mIdeal f a).primeCompl) (g := evalA hP)
    (fun y => isUnit_iff_ne_zero.mpr fun hcon => y.2 (mem_mIdeal_of_evalA_eq_zero hP hcon)) x

lemma evS_algebraMap_k (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (c : k) :
    evS hmax hP (algebraMap k (LocRing f a hmax) c) = c := by
  rw [show (algebraMap k (LocRing f a hmax)) c
      = algebraMap (HypRing f) (LocRing f a hmax) ((algebraMap k (HypRing f)) c) from
    (IsScalarTower.algebraMap_apply k (HypRing f) (LocRing f a hmax) c).symm,
    evS_algebraMap, evalA_algebraMap]

lemma evS_toLoc_y (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (j : Fin n) :
    evS hmax hP (toLoc f a hmax (y a j)) = 0 := by
  have hx : toLoc f a hmax (y a j)
      = algebraMap (HypRing f) (LocRing f a hmax)
          (Ideal.Quotient.mk (Ideal.span {f}) (y a j)) := rfl
  rw [hx, evS_algebraMap, evalA_mk]
  have hy : y a j = X j - C (a j) := rfl
  rw [hy, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]

lemma evS_eq_zero_of_mem_maximalIdeal (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (x : LocRing f a hmax) (hx : x ∈ maximalIdeal (LocRing f a hmax)) :
    evS hmax hP x = 0 := by
  rw [maximalIdeal_LocRing_eq_span hmax] at hx
  have h : Ideal.span (Set.range (fun i => toLoc f a hmax (y a i)))
      ≤ RingHom.ker (evS hmax hP) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact evS_toLoc_y hmax hP j
  exact h hx

lemma evS_surjective (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) :
    Function.Surjective (evS hmax hP) :=
  fun c => ⟨algebraMap k (LocRing f a hmax) c, evS_algebraMap_k hmax hP c⟩

lemma ker_evS (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) :
    RingHom.ker (evS hmax hP) = maximalIdeal (LocRing f a hmax) := by
  have hK : (RingHom.ker (evS hmax hP)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ (evS_surjective hmax hP)
  exact ((Ideal.IsMaximal.eq_of_le (I := maximalIdeal (LocRing f a hmax))
    (J := RingHom.ker (evS hmax hP)) inferInstance hK.ne_top
    (fun x hx => evS_eq_zero_of_mem_maximalIdeal hmax hP x hx)).symm)

/-! ### The thickened-point maps `A_𝔪 → k[ε]` -/

/-- The thickened point map on `A`, as a `k`-algebra map. -/
noncomputable def ThetaA_alg (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0)
    (i : Fin n) : HypRing f →ₐ[k] DualNumber k :=
  Ideal.Quotient.liftₐ (Ideal.span {f}) (theta a i) (by
    intro x hx
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [map_mul, theta_f_eq_zero hP h0, zero_mul])

lemma ThetaA_alg_mk (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n)
    (r : MvPolynomial (Fin n) k) :
    ThetaA_alg hP h0 i (Ideal.Quotient.mk (Ideal.span {f}) r) = theta a i r := by
  rw [ThetaA_alg, Ideal.Quotient.liftₐ_apply]
  exact Ideal.Quotient.lift_mk _ _ _

lemma ThetaA_alg_fst (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n)
    (x : HypRing f) : (ThetaA_alg hP h0 i x).fst = evalA hP x := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [ThetaA_alg_mk, theta_fst, evalA_mk]

lemma isUnit_ThetaA_alg (hP : eval a f = 0) (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n)
    {y : HypRing f} (hy : y ∉ mIdeal f a) : IsUnit (ThetaA_alg hP h0 i y) := by
  apply isUnit_dual_of_fst_ne_zero
  rw [ThetaA_alg_fst]
  exact fun h => hy (mem_mIdeal_of_evalA_eq_zero hP h)

/-- The thickened point map on the local ring `A_𝔪`: `X_j ↦ a_j + δ_ij ε`. -/
noncomputable def ThetaS (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) :
    LocRing f a hmax →ₐ[k] DualNumber k :=
  IsLocalization.liftAlgHom (M := (mIdeal f a).primeCompl) (f := ThetaA_alg hP h0 i)
    (fun y => isUnit_ThetaA_alg hP h0 i (y := (y : HypRing f)) y.2)

lemma ThetaS_algebraMap (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) (x : HypRing f) :
    ThetaS hmax hP h0 i (algebraMap (HypRing f) (LocRing f a hmax) x)
      = ThetaA_alg hP h0 i x :=
  IsLocalization.lift_eq (M := (mIdeal f a).primeCompl)
    (g := (ThetaA_alg hP h0 i).toRingHom)
    (fun y => isUnit_ThetaA_alg hP h0 i (y := (y : HypRing f)) y.2) x

lemma ThetaS_fst (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) (x : LocRing f a hmax) :
    (ThetaS hmax hP h0 i x).fst = evS hmax hP x := by
  have h1 : ((TrivSqZeroExt.fstHom k k k).toRingHom.comp (ThetaS hmax hP h0 i).toRingHom)
      = evS hmax hP := by
    refine IsLocalization.ringHom_ext (mIdeal f a).primeCompl ?_
    refine RingHom.ext fun x => ?_
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      TrivSqZeroExt.fstHom_apply, evS_algebraMap, ThetaS_algebraMap, ThetaA_alg_fst]
  exact RingHom.congr_fun h1 x

/-- The `i`-th tangent functional `A_𝔪 → k`, the `ε`-coefficient of the thickened point. -/
noncomputable def delta (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) : LocRing f a hmax →ₗ[k] k :=
  (TrivSqZeroExt.sndHom k k).comp (ThetaS hmax hP h0 i).toLinearMap

lemma delta_apply (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) (x : LocRing f a hmax) :
    delta hmax hP h0 i x = (ThetaS hmax hP h0 i x).snd := rfl

lemma delta_toLoc_y (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i j : Fin n) :
    delta hmax hP h0 i (toLoc f a hmax (y a j)) = if i = j then 1 else 0 := by
  have hx : toLoc f a hmax (y a j)
      = algebraMap (HypRing f) (LocRing f a hmax)
          (Ideal.Quotient.mk (Ideal.span {f}) (y a j)) := rfl
  rw [delta_apply, hx, ThetaS_algebraMap, ThetaA_alg_mk, theta_snd, eval_pderiv_y]

lemma delta_mul (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (i : Fin n) (x y : LocRing f a hmax) :
    delta hmax hP h0 i (x * y)
      = evS hmax hP x * delta hmax hP h0 i y + evS hmax hP y * delta hmax hP h0 i x := by
  rw [delta_apply, map_mul, snd_mul_dual, ThetaS_fst, ThetaS_fst]
  rfl

end Case2

end

end Ex_11_1


namespace Ex_11_1

noncomputable section

variable {k : Type*} [Field k] {n : ℕ} {a : Fin n → k} {f : MvPolynomial (Fin n) k}

/-- **Determinacy of derivations on a local ring**: a `k`-linear map `Δ` satisfying the
Leibniz rule with respect to the residue map `evS` and killing a generating set of the
maximal ideal is zero. -/
lemma deriv_eq_zero_of_kills_span (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (Δ : LocRing f a hmax →ₗ[k] k)
    (hleib : ∀ x y, Δ (x * y) = evS hmax hP x * Δ y + evS hmax hP y * Δ x)
    (t : Finset (LocRing f a hmax))
    (ht : Submodule.span (LocRing f a hmax) (t : Set (LocRing f a hmax))
      = maximalIdeal (LocRing f a hmax))
    (hk : ∀ x ∈ t, Δ x = 0) : Δ = 0 := by
  have hmem : ∀ x ∈ maximalIdeal (LocRing f a hmax), Δ x = 0 ∧ evS hmax hP x = 0 := by
    rw [← ht]
    intro x hx
    refine Submodule.span_induction (p := fun x _ => Δ x = 0 ∧ evS hmax hP x = 0)
      ?_ ?_ ?_ ?_ hx
    · intro x hx
      exact ⟨hk x hx,
        evS_eq_zero_of_mem_maximalIdeal hmax hP x (ht ▸ Submodule.subset_span hx)⟩
    · exact ⟨map_zero Δ, map_zero (evS hmax hP)⟩
    · intro x y _ _ hx hy
      exact ⟨by simp only [map_add, hx.1, hy.1, add_zero],
        by simp only [map_add, hx.2, hy.2, add_zero]⟩
    · intro r x _ hx
      refine ⟨?_, ?_⟩
      · show Δ (r * x) = 0
        rw [hleib]
        simp only [hx.1, hx.2, mul_zero, zero_mul, add_zero]
      · show evS hmax hP (r * x) = 0
        rw [map_mul, hx.2, mul_zero]
  have hΔ1 : Δ 1 = 0 := by
    have h := hleib 1 1
    rw [mul_one, map_one (evS hmax hP), one_mul] at h
    have h' : Δ 1 + 0 = Δ 1 + Δ 1 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  have hΔc : ∀ c : k, Δ (algebraMap k (LocRing f a hmax) c) = 0 := by
    intro c
    rw [Algebra.algebraMap_eq_smul_one, LinearMap.map_smul, hΔ1, smul_zero]
  ext x
  have hx : x - algebraMap k (LocRing f a hmax) (evS hmax hP x)
      ∈ maximalIdeal (LocRing f a hmax) := by
    rw [← ker_evS hmax hP, RingHom.mem_ker, map_sub, evS_algebraMap_k, sub_self]
  have h1 := (hmem _ hx).1
  have hsplit : x = algebraMap k (LocRing f a hmax) (evS hmax hP x)
      + (x - algebraMap k (LocRing f a hmax) (evS hmax hP x)) := by ring
  rw [hsplit, map_add, hΔc, h1, zero_add, LinearMap.zero_apply]

/-- **The tangent-space lower bound**: if all partial derivatives of `f` vanish at `a`, then
the maximal ideal of `A_𝔪` needs at least `n` generators. -/
lemma card_le_of_span_eq (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) (t : Finset (LocRing f a hmax))
    (ht : Submodule.span (LocRing f a hmax) (t : Set (LocRing f a hmax))
      = maximalIdeal (LocRing f a hmax)) : n ≤ t.card := by
  classical
  set Φ : (Fin n → k) →ₗ[k] (t → k) :=
    { toFun := fun c x => ∑ i, c i * delta hmax hP h0 i (x : LocRing f a hmax)
      map_add' := by
        intro c d
        funext x
        simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
      map_smul' := by
        intro r c
        funext x
        simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [RingHom.id_apply, mul_assoc] } with hΦ
  have hinj : Function.Injective Φ := by
    intro c d hcd
    set e : Fin n → k := fun i => c i - d i with he
    set Δ : LocRing f a hmax →ₗ[k] k := ∑ i, e i • delta hmax hP h0 i with hΔ
    have hΔ_apply : ∀ x, Δ x = ∑ i, e i * delta hmax hP h0 i x := by
      intro x
      conv_lhs => rw [hΔ]
      rw [LinearMap.sum_apply]
      exact Finset.sum_congr rfl fun i _ => by rw [LinearMap.smul_apply, smul_eq_mul]
    have hΔ_kills : ∀ x ∈ t, Δ x = 0 := by
      intro x hx
      have h : ∑ i, c i * delta hmax hP h0 i x = ∑ i, d i * delta hmax hP h0 i x :=
        congrFun hcd ⟨x, hx⟩
      have h2 : ∑ i, (c i - d i) * delta hmax hP h0 i x
          = ∑ i, c i * delta hmax hP h0 i x - ∑ i, d i * delta hmax hP h0 i x := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun i _ => by ring
      rw [hΔ_apply, h2, h, sub_self]
    have hleib : ∀ x y : LocRing f a hmax,
        Δ (x * y) = evS hmax hP x * Δ y + evS hmax hP y * Δ x := by
      intro x y
      rw [hΔ_apply, hΔ_apply, hΔ_apply]
      simp only [delta_mul]
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    have hzero := deriv_eq_zero_of_kills_span hmax hP Δ hleib t ht hΔ_kills
    funext j
    have h := LinearMap.congr_fun hzero (toLoc f a hmax (y a j))
    rw [hΔ_apply, LinearMap.zero_apply] at h
    have hsingle : ∑ i, e i * delta hmax hP h0 i (toLoc f a hmax (y a j)) = e j := by
      rw [Finset.sum_eq_single j]
      · rw [delta_toLoc_y, if_pos rfl, mul_one]
      · intro i _ hij
        rw [delta_toLoc_y, if_neg hij, mul_zero]
      · intro hj
        exact absurd (Finset.mem_univ j) hj
    rw [hsingle] at h
    show c j = d j
    rw [he] at h
    exact sub_eq_zero.mp h
  have := LinearMap.finrank_le_finrank_of_injective hinj
  rwa [Module.finrank_fintype_fun_eq_card, Module.finrank_fintype_fun_eq_card,
    Fintype.card_coe, Fintype.card_fin] at this

lemma le_spanFinrank_maximalIdeal (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (h0 : ∀ j, eval a (pderiv j f) = 0) :
    n ≤ (maximalIdeal (LocRing f a hmax)).spanFinrank := by
  obtain ⟨t, hcard, ht⟩ :=
    (IsNoetherian.noetherian (maximalIdeal (LocRing f a hmax))).exists_span_finset_card_eq_spanFinrank
  rw [← hcard]
  exact card_le_of_span_eq hmax hP h0 t ht

/-- Case 2: if all partial derivatives vanish at `a`, then `A_𝔪` is not regular. -/
theorem not_isRegularLocalRing_of_forall_pderiv_eq_zero (hmax : (mIdeal f a).IsMaximal)
    (hP : eval a f = 0) (hf : f ≠ 0) (h0 : ∀ j, eval a (pderiv j f) = 0) :
    ¬ IsRegularLocalRing (LocRing f a hmax) := by
  intro hreg
  rw [isRegularLocalRing_iff (LocRing f a hmax)] at hreg
  rw [ringKrullDim_LocRing hmax hP hf] at hreg
  have hspan := le_spanFinrank_maximalIdeal hmax hP h0
  have h1 : ((n : ℕ∞) : WithBot ℕ∞) ≤ (((n - 1 : ℕ) : ℕ∞) : WithBot ℕ∞) := by
    rw [← hreg]
    exact_mod_cast hspan
  have h2 : (n : ℕ∞) ≤ ((n - 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h1
  have h3 : n ≤ n - 1 := ENat.natCast_le_natCast.mp h2
  have hpos : 1 ≤ n := one_le_of_isMaximal hmax hP hf
  omega

/-- A point `a` of the hypersurface `f = 0` is *non-singular* when not all the partial
derivatives of `f` vanish at `a`. -/
def NonSingular (f : MvPolynomial (Fin n) k) (a : Fin n → k) : Prop :=
  ∃ i, eval a (pderiv i f) ≠ 0

/-- **Atiyah–Macdonald, Exercise 11.1** (with `f ≠ 0` in place of irreducibility):
a point `a` of the hypersurface `f = 0` is non-singular iff `A_𝔪` is a regular local ring. -/
theorem ex_11_1_of_ne_zero (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0)
    (hf : f ≠ 0) :
    (∃ i, eval a (pderiv i f) ≠ 0) ↔ IsRegularLocalRing (LocRing f a hmax) := by
  constructor
  · rintro ⟨i, hi⟩
    exact isRegularLocalRing_of_exists_pderiv_ne_zero hmax hP hf hi
  · intro hreg
    by_contra hcon
    push Not at hcon
    exact not_isRegularLocalRing_of_forall_pderiv_eq_zero hmax hP hf hcon hreg

/-- **Atiyah–Macdonald, Exercise 11.1**, in the book's form (`f` irreducible). -/
theorem ex_11_1 (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (hirr : Irreducible f) :
    (∃ i, eval a (pderiv i f) ≠ 0) ↔ IsRegularLocalRing (LocRing f a hmax) :=
  ex_11_1_of_ne_zero hmax hP hirr.ne_zero

/-- **Atiyah–Macdonald, Exercise 11.1**, stated with the predicate `NonSingular`. -/
theorem ex_11_1' (hmax : (mIdeal f a).IsMaximal) (hP : eval a f = 0) (hirr : Irreducible f) :
    NonSingular f a ↔ IsRegularLocalRing (LocRing f a hmax) :=
  ex_11_1 hmax hP hirr

end

end Ex_11_1

namespace Ex_11_1

/-! ## Sanity checks: the statement is not vacuous -/

section Sanity

/-- The line `x = 0` in the plane is non-singular at the origin, and its local ring is regular. -/
example : NonSingular (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) ℚ) (fun _ => 0) := by
  refine ⟨0, by simp⟩

example : IsRegularLocalRing
    (LocRing (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) ℚ) (fun _ => 0)
      (mIdeal_isMaximal (f := MvPolynomial.X 0) (a := fun _ => 0) (by simp))) := by
  refine (ex_11_1_of_ne_zero _ (by simp) (by simp)).mp ?_
  exact ⟨0, by simp⟩

/-- The doubled line `x² = 0` is singular at the origin, and its local ring is not regular. -/
example : ¬ IsRegularLocalRing
    (LocRing ((MvPolynomial.X (0 : Fin 1)) ^ 2 : MvPolynomial (Fin 1) ℚ) (fun _ => 0)
      (mIdeal_isMaximal (f := MvPolynomial.X 0 ^ 2) (a := fun _ => 0) (by simp))) := by
  refine not_isRegularLocalRing_of_forall_pderiv_eq_zero _ (by simp) (by simp) ?_
  intro j
  fin_cases j
  simp

end Sanity

end Ex_11_1

