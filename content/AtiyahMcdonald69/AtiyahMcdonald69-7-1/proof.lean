#print axioms AtiyahMcdonald69.Ex_7_1.Sigma_nonempty
#print axioms AtiyahMcdonald69.Ex_7_1.fg_of_fg_sup_span_of_fg_colon
#print axioms AtiyahMcdonald69.Ex_7_1.not_fg_sSup_of_isChain
#print axioms AtiyahMcdonald69.Ex_7_1.exists_maximal_sigma
#print axioms AtiyahMcdonald69.Ex_7_1.isPrime_of_maximal_sigma
#print axioms AtiyahMcdonald69.Ex_7_1.isNoetherianRing_of_prime_ideal_fg
#print axioms AtiyahMcdonald69.Ex_7_1.isNoetherianRing_iff_prime_ideal_fg
#print axioms AtiyahMcdonald69.Ex_7_1.exercise_7_1

end AtiyahMcdonald69.Ex_7_1
