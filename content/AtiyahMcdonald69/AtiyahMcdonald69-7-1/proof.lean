/-
# Atiyah–Macdonald, Exercise 7.1 (Chapter 7, *Noetherian Rings*)

Statement (M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*,
Addison-Wesley 1969, Chapter 7, Exercise 1):

> Let `A` be a non-Noetherian ring and let `Σ` be the set of ideals in `A` which are not
> finitely generated. Show that `Σ` has maximal elements and that the maximal elements of `Σ`
> are prime ideals. Hence a ring in which every prime ideal is finitely generated is Noetherian
> (I. S. Cohen).

The formalisation below follows the book's argument:
* `Σ` is non-empty because `A` is not Noetherian;
* the union of a chain in `Σ` is again in `Σ` (finitely many generators of the union already
  lie in a single member of the chain), so Zorn's lemma produces a maximal element of `Σ`;
* a maximal element `p` of `Σ` is prime: if `x * y ∈ p` with `x ∉ p`, then `p ⊔ (x)` is
  finitely generated, and the "Oka step" `fg_of_fg_sup_span_of_fg_colon` shows that `p` is
  finitely generated as soon as `(p : x)` is, which it is by maximality because `y ∈ (p : x)`;
* hence a ring all of whose prime ideals are finitely generated is Noetherian (Cohen).
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_7_1

open Set

variable {A : Type*} [CommRing A]

/-! ### The set `Σ` of ideals which are not finitely generated -/

/-- `Σ`: the set of ideals of `A` which are not finitely generated (Chapter 7, Exercise 1). -/
def Sigma (A : Type*) [CommRing A] : Set (Ideal A) := {I | ¬ I.FG}

@[simp]
lemma mem_Sigma {I : Ideal A} : I ∈ Sigma A ↔ ¬ I.FG := Iff.rfl

/-- `Σ` is non-empty for a non-Noetherian ring. -/
theorem Sigma_nonempty (h : ¬ IsNoetherianRing A) : (Sigma A).Nonempty := by
  obtain ⟨J, hJ⟩ : ∃ J : Ideal A, ¬ J.FG := by
    by_contra hcon
    simp only [not_exists, not_not] at hcon
    exact h ((isNoetherianRing_iff_ideal_fg A).2 hcon)
  exact ⟨J, hJ⟩

/-! ### The key finiteness step -/

/-- If `p ⊔ (x)` and `(p : x)` are both finitely generated, then so is `p`.

This is the "Oka step" used in the book: from finitely many generators of `p ⊔ (x)` split off
their `p`-parts to get a finitely generated `p₁ ≤ p` with `p ≤ p₁ ⊔ (x)`; then every element of
`p` is a sum of an element of `p₁` and a multiple `x * b` with `b ∈ (p : x)`. -/
theorem fg_of_fg_sup_span_of_fg_colon {p : Ideal A} {x : A}
    (hsup : (p ⊔ Ideal.span {x}).FG) (hcol : (p.colon (Ideal.span {x})).FG) : p.FG := by
  classical
  obtain ⟨n, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hsup
  -- split each generator of `p ⊔ (x)` into its `p`-part and its `x`-multiple
  have hdec : ∀ k : Fin n, ∃ a b : A, a ∈ p ∧ a + b * x = f k := by
    intro k
    have hk : f k ∈ p ⊔ Ideal.span {x} := hf ▸ Submodule.subset_span (mem_range_self k)
    obtain ⟨a, ha, c, hc, hac⟩ := Submodule.mem_sup.1 hk
    obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.1 hc
    exact ⟨a, b, ha, by simpa [smul_eq_mul] using hac⟩
  choose a b hab using hdec
  -- the finitely generated ideal generated by the `p`-parts
  set p₁ : Ideal A := Ideal.span (range a) with hp₁
  have hp₁_le : p₁ ≤ p := by
    rw [hp₁]
    exact Ideal.span_le.2 (by rintro _ ⟨k, rfl⟩; exact (hab k).1)
  have hp₁_fg : p₁.FG := by
    rw [hp₁]
    exact Submodule.fg_span (Set.finite_range a)
  -- `p` is generated by `p₁` and `(x)`
  have hspan_le : Submodule.span A (range f) ≤ p₁ ⊔ Ideal.span {x} := by
    rw [hp₁]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨k, rfl⟩
    rw [← (hab k).2]
    exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (mem_range_self k)))
      (Ideal.mem_sup_right (Submodule.mem_span_singleton.2 ⟨b k, by simp⟩))
  have hp_le : p ≤ p₁ ⊔ Ideal.span {x} := le_trans le_sup_left (hf ▸ hspan_le)
  -- `(x) * (p : x) ≤ p`
  have hmul_le : Ideal.span {x} * p.colon (Ideal.span {x}) ≤ p := by
    have hspan : Ideal.span (p.colon (Ideal.span {x}) : Set A) = p.colon (Ideal.span {x}) :=
      Ideal.span_eq _
    rw [← hspan, Ideal.span_mul_span]
    refine Ideal.span_le.2 ?_
    rintro w ⟨u, hu, v, hv, rfl⟩
    rw [Set.mem_singleton_iff] at hu
    rw [hu]
    change x * v ∈ (p : Set A)
    rw [mul_comm x v]
    exact Ideal.mem_colon_span_singleton.1 hv
  -- `p ≤ p₁ + (x) * (p : x)`
  have hp_le' : p ≤ p₁ ⊔ (Ideal.span {x} * p.colon (Ideal.span {x})) := by
    intro z hz
    obtain ⟨c, hc, d, hd, hcd⟩ := Submodule.mem_sup.1 (hp_le hz)
    obtain ⟨bb, hbb⟩ := Submodule.mem_span_singleton.1 hd
    have hbbx : bb * x = d := by rw [← hbb, smul_eq_mul]
    have hbbp : bb * x ∈ p := by
      have h1 : bb * x = z - c := by rw [hbbx, ← hcd]; ring
      rw [h1]
      exact Submodule.sub_mem p hz (hp₁_le hc)
    have hbbcol : bb ∈ p.colon (Ideal.span {x}) :=
      Ideal.mem_colon_span_singleton.2 hbbp
    have hxbb : x * bb ∈ Ideal.span {x} * p.colon (Ideal.span {x}) :=
      Ideal.mul_mem_mul (Ideal.subset_span (mem_singleton x)) hbbcol
    have h2 : c + x * bb = z := by rw [mul_comm x bb, hbbx, ← hcd]
    exact Submodule.mem_sup.2 ⟨c, hc, x * bb, hxbb, h2⟩
  have hp_eq : p = p₁ ⊔ (Ideal.span {x} * p.colon (Ideal.span {x})) :=
    le_antisymm hp_le' (sup_le hp₁_le hmul_le)
  rw [hp_eq]
  exact Submodule.FG.sup hp₁_fg
    (Ideal.FG.mul (Submodule.fg_span (Set.finite_singleton x)) hcol)

/-! ### `Σ` is closed under unions of chains -/

/-- The union of a chain of non-finitely-generated ideals is not finitely generated. -/
theorem not_fg_sSup_of_isChain {C : Set (Ideal A)} (hC : C ⊆ Sigma A)
    (hchain : IsChain (· ≤ ·) C) (hne : C.Nonempty) : ¬ (sSup C).FG := by
  classical
  rintro ⟨T, hT⟩
  have hdir : DirectedOn (· ≤ ·) C := hchain.directedOn
  have hsub : (T : Set A) ⊆ ⋃ J ∈ C, (J : Set A) := by
    intro t ht
    have ht' : t ∈ sSup C := hT ▸ Submodule.subset_span ht
    obtain ⟨J, hJC, htJ⟩ := (Submodule.mem_sSup_of_directed hne hdir).1 ht'
    simp only [mem_iUnion, exists_prop]
    exact ⟨J, hJC, htJ⟩
  obtain ⟨J, hJC, hTJ⟩ := hdir.exists_mem_subset_of_finset_subset_biUnion hne hsub
  have hle : sSup C ≤ J := by
    rw [← hT]
    exact Submodule.span_le.2 hTJ
  have heq : sSup C = J := le_antisymm hle (le_sSup hJC)
  exact hC hJC (heq ▸ ⟨T, hT⟩)

/-! ### Maximal elements of `Σ` and their primality -/

/-- `Σ` has maximal elements when `A` is not Noetherian (Zorn's lemma). -/
theorem exists_maximal_sigma (h : ¬ IsNoetherianRing A) :
    ∃ p : Ideal A, Maximal (· ∈ Sigma A) p := by
  obtain ⟨I, hI⟩ := Sigma_nonempty h
  obtain ⟨m, -, hm⟩ :=
    zorn_le_nonempty₀ (Sigma A)
      (fun C hC hchain y hy =>
        ⟨sSup C, not_fg_sSup_of_isChain hC hchain ⟨y, hy⟩, fun z hz => le_sSup hz⟩)
      I hI
  exact ⟨m, hm⟩

/-- Every maximal element of `Σ` is a prime ideal. -/
theorem isPrime_of_maximal_sigma {p : Ideal A} (hp : Maximal (· ∈ Sigma A) p) : p.IsPrime := by
  rw [Ideal.isPrime_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    refine hp.prop ?_
    rw [htop]
    exact ⟨{1}, by simp⟩
  · intro x y hxy
    by_contra hcon
    simp only [not_or] at hcon
    obtain ⟨hx, hy⟩ := hcon
    have hsup : (p ⊔ Ideal.span {x}).FG := by
      by_contra hnot
      have hle : p ⊔ Ideal.span {x} ≤ p := hp.le_of_ge hnot le_sup_left
      exact hx (hle (Ideal.mem_sup_right (Ideal.subset_span (mem_singleton x))))
    have hycol : y ∈ p.colon (Ideal.span {x}) := by
      rw [Ideal.mem_colon_span_singleton]
      rwa [mul_comm y x]
    have hcol : (p.colon (Ideal.span {x})).FG := by
      by_contra hnot
      have hle : p.colon (Ideal.span {x}) ≤ p := hp.le_of_ge hnot Ideal.le_colon
      exact hy (hle hycol)
    exact hp.prop (fg_of_fg_sup_span_of_fg_colon hsup hcol)

/-! ### Cohen's theorem: the "hence" clause -/

/-- A ring in which every prime ideal is finitely generated is Noetherian (I. S. Cohen). -/
theorem isNoetherianRing_of_prime_ideal_fg (h : ∀ p : Ideal A, p.IsPrime → p.FG) :
    IsNoetherianRing A := by
  by_contra hA
  obtain ⟨p, hp⟩ := exists_maximal_sigma hA
  exact hp.prop (h p (isPrime_of_maximal_sigma hp))

/-- A ring is Noetherian if and only if all its prime ideals are finitely generated. -/
theorem isNoetherianRing_iff_prime_ideal_fg :
    IsNoetherianRing A ↔ ∀ p : Ideal A, p.IsPrime → p.FG where
  mp _ := fun p _ => Ideal.fg_of_isNoetherianRing p
  mpr := isNoetherianRing_of_prime_ideal_fg

/-- **Atiyah–Macdonald, Chapter 7, Exercise 1.** Let `A` be a non-Noetherian ring and let `Σ` be
the set of ideals of `A` that are not finitely generated. Then `Σ` is non-empty, `Σ` has maximal
elements, and every maximal element of `Σ` is a prime ideal. -/
theorem exercise_7_1 (h : ¬ IsNoetherianRing A) :
    (Sigma A).Nonempty ∧ (∃ p : Ideal A, Maximal (· ∈ Sigma A) p) ∧
      ∀ p : Ideal A, Maximal (· ∈ Sigma A) p → p.IsPrime :=
  ⟨Sigma_nonempty h, exists_maximal_sigma h, fun _ hp => isPrime_of_maximal_sigma hp⟩

/-! ### Independent cross-checks against Mathlib

The statements proved above are consistent with Mathlib's own (independently proved) forms of
Cohen's theorem and of the "maximal for a non-finiteness property is prime" step. -/

/-- Cross-check of the primality step with `Ideal.IsOka.isPrime_of_maximal_not`. -/
example {p : Ideal A} (hp : Maximal (· ∈ Sigma A) p) : p.IsPrime :=
  Ideal.IsOka.isPrime_of_maximal_not Ideal.isOka_fg hp

/-- Cross-check of the "hence" clause with Mathlib's `IsNoetherianRing.of_prime`. -/
theorem isNoetherianRing_of_prime_ideal_fg' (h : ∀ p : Ideal A, p.IsPrime → p.FG) :
    IsNoetherianRing A :=
  IsNoetherianRing.of_prime h

