import Mathlib.Algebra.DirectSum.Module
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Order.Directed

/-!
# Atiyah–Macdonald (1969), Chapter 2, Exercise 14: the direct limit of a direct system

Textbook statement (Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 2,
Exercises, "Direct limits", Exercise 14).

> A partially ordered set `I` is said to be a *directed set* if for each pair `i, j ∈ I` there
> exists `k ∈ I` such that `i ≤ k` and `j ≤ k`. Let `A` be a ring, let `I` be a directed set and
> let `(M_i)_{i ∈ I}` be a family of `A`-modules indexed by `I`. For each pair `i, j ∈ I` with
> `i ≤ j` let `μ_{ij} : M_i → M_j` be an `A`-homomorphism, and suppose that
> (1) `μ_{ii}` is the identity mapping of `M_i`, for all `i ∈ I`;
> (2) `μ_{ik} = μ_{jk} ∘ μ_{ij}` whenever `i ≤ j ≤ k`.
> Then the modules `M_i` and homomorphisms `μ_{ij}` are said to form a *direct system*
> `M = (M_i, μ_{ij})` over the directed set `I`.
>
> We shall construct an `A`-module `M` called the *direct limit* of the direct system `M`.
> Let `C` be the direct sum of the `M_i`, and identify each module `M_i` with its canonical image
> in `C`. Let `D` be the submodule of `C` generated by all elements of the form `x_i - μ_{ij}(x_i)`
> where `i ≤ j` and `x_i ∈ M_i`. Let `M = C/D`, let `π : C → M` be the projection and let `μ_i` be
> the restriction of `π` to `M_i`. The module `M`, or more correctly the pair consisting of `M` and
> the family of homomorphisms `μ_i : M_i → M`, is called the *direct limit* of the direct system
> `M`, and is written `lim M_i`. From the construction it is clear that `μ_i = μ_j ∘ μ_{ij}`
> whenever `i ≤ j`.

What is proved below is the construction together with its asserted property
`μ_i = μ_j ∘ μ_ij` (`proj_compat`, `proj_compat_comp`, and the collected statement `solution`),
with every object of the construction kept explicit:

* `IsDirectedSet` – the book's directedness condition on the index set;
* `IsDirectSystem` – the book's axioms (1) and (2) for the transition maps `μ_ij`;
* `ι i` – the canonical image of `M i` in `C = ⨁ i, M i` (shown injective in `ι_injective`);
* `relSet μ` / `relSubmodule μ` – the set of the book's generators `x_i - μ_ij(x_i)` and the
  submodule `D` they generate (with `relSubmodule_le`: `D` is the *least* submodule containing
  them, i.e. it really is "the submodule generated by" these elements);
* `Lim μ` – the quotient `M = C/D`, an `A`-module;
* `proj μ i` – the map `μ_i : M_i → M`, `x ↦ x + D`, i.e. `π` restricted to `M_i`;
* `proj_compat` – the book's assertion `μ_i(x_i) = μ_j(μ_ij(x_i))` for `i ≤ j`.

## Audit of the natural-language proof

The natural-language proof is correct and complete for the assertion that is actually made
("from the construction it is clear that `μ_i = μ_j ∘ μ_ij`"): it only needs that
`x_i - μ_ij(x_i) ∈ D`, the `A`-linearity of the quotient map `π`, and the definition of `μ_i`.
Two observations, both recorded formally below rather than glossed over:

1. *The proof never uses directedness of `I`, nor axioms (1) and (2).* The compatibility
   `μ_i = μ_j ∘ μ_ij` holds for an arbitrary preorder and an arbitrary family of `A`-linear
   transition maps; this is the unconditional theorem `proj_compat` / `proj_compat_comp`,
   stated with no hypothesis on `I` and no axiom on `μ`. (In the book, directedness enters only
   in Exercises 2.15 and 2.16: the equality criterion and the universal property need upper
   bounds. Axioms (1) and (2) are used below only in `rel_mem_self`, `proj_self` and
   `proj_trans`, which record the coherence of the resulting family of maps.)
   The book's hypotheses are nevertheless kept in the final statement `solution`, so nothing is
   weakened relative to the text; no false generalisation is being asserted.
2. *The "identification of `M_i` with its canonical image in `C`" is not needed for the claim*,
   because `μ_i` is simply `π ∘ (M_i ↪ C)` and no injectivity of that inclusion is used. It is
   proved separately (`ι_injective`) so that the identification is available.

Nothing in the construction uses commutativity of `A`; the hypotheses of the book
(`CommRing A` throughout Chapter 2) are retained verbatim.

Natural-language reference: <https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-2-14>
-/

set_option autoImplicit false

namespace AtiyahMcdonald69.Ex_2_14

open DirectSum

universe u v w

/-! ### The index set -/

/-- Atiyah–Macdonald, Chapter 2, Exercise 14: a partially ordered set `I` is a *directed set* if
for each pair `i, j ∈ I` there exists `k ∈ I` such that `i ≤ k` and `j ≤ k`.

(The construction below only needs a preorder, so we state it for preorders; a partially ordered
set is a special case.) -/
def IsDirectedSet (I : Type*) [Preorder I] : Prop := ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k

/-! ### The direct system -/

section Construction

variable {A : Type u} [CommRing A] {I : Type v} [Preorder I]
variable {M : I → Type w} [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)]

/-- Atiyah–Macdonald, Chapter 2, Exercise 14, axioms (1) and (2): a family of `A`-linear maps
`μ_ij : M_i → M_j` for `i ≤ j` is a *direct system* of transition maps when `μ_ii = id` and
`μ_ik = μ_jk ∘ μ_ij` for `i ≤ j ≤ k`. -/
structure IsDirectSystem (μ : ∀ ⦃i j : I⦄, i ≤ j → M i →ₗ[A] M j) : Prop where
  /-- Axiom (1): `μ_ii` is the identity mapping of `M_i`. -/
  map_self : ∀ i, μ (le_refl i) = LinearMap.id
  /-- Axiom (2): `μ_ik = μ_jk ∘ μ_ij` whenever `i ≤ j ≤ k`. -/
  map_comp : ∀ {i j k : I} (hij : i ≤ j) (hjk : j ≤ k),
    μ (hij.trans hjk) = (μ hjk).comp (μ hij)

variable (μ : ∀ ⦃i j : I⦄, i ≤ j → M i →ₗ[A] M j)

section CanonicalImage

variable {A : Type u} [CommRing A] {I : Type v}
variable {M : I → Type w} [∀ i, AddCommGroup (M i)] [∀ i, Module A (M i)]

/-- The canonical image of `M i` in the direct sum `C = ⨁ i, M i`, i.e. the book's identification
of `M_i` with a submodule of `C`. -/
noncomputable def ι (i : I) : M i →ₗ[A] ⨁ i, M i := by
  classical exact DirectSum.lof A I M i

/-- The inclusion of `M i` into `C = ⨁ i, M i` is injective, so that `M_i` may indeed be
identified with its canonical image in `C`. -/
theorem ι_injective (i : I) : Function.Injective (ι (A := A) (M := M) i) := by
  classical
  exact DirectSum.of_injective i

end CanonicalImage

/-! ### The construction of the direct limit -/

/-- The set of the book's defining relations `x_i - μ_ij(x_i)` in `C = ⨁ i, M i`, for `i ≤ j`
and `x_i ∈ M_i`. -/
def relSet : Set (⨁ i, M i) :=
  {c | ∃ (i j : I) (hij : i ≤ j) (x : M i), c = ι (A := A) i x - ι (A := A) j (μ hij x)}

/-- The submodule `D` of `C` generated by all elements `x_i - μ_ij(x_i)` with `i ≤ j`. -/
def relSubmodule : Submodule A (⨁ i, M i) := Submodule.span A (relSet μ)

/-- The direct limit `M = C/D` of the direct system: the quotient of the direct sum `C` by the
submodule `D` generated by the relations `x_i - μ_ij(x_i)`. -/
abbrev Lim : Type (max v w) := (⨁ i, M i) ⧸ relSubmodule μ

/-- The map `μ_i : M_i → M`, `x ↦ x + D`: the projection `π : C → M` restricted to (the canonical
image of) `M_i`. -/
noncomputable def proj (i : I) : M i →ₗ[A] Lim μ :=
  (Submodule.mkQ (relSubmodule μ)).comp (ι (M := M) i)

/-- The direct limit is an `A`-module (it is a quotient of the `A`-module `C`). -/
example : AddCommGroup (Lim μ) := inferInstance
example : Module A (Lim μ) := inferInstance

/-! ### The defining relations -/

/-- The elements `x_i - μ_ij(x_i)` belong to `D`. -/
theorem rel_mem {i j : I} (hij : i ≤ j) (x : M i) :
    ι (A := A) i x - ι (A := A) j (μ hij x) ∈ relSubmodule μ :=
  Submodule.subset_span ⟨i, j, hij, x, rfl⟩

/-- `D` is the *least* submodule of `C` containing all the elements `x_i - μ_ij(x_i)`: it is
generated by them. -/
theorem relSubmodule_le {N : Submodule A (⨁ i, M i)}
    (hN : ∀ ⦃i j : I⦄ (hij : i ≤ j) (x : M i),
      ι (A := A) i x - ι (A := A) j (μ hij x) ∈ N) :
    relSubmodule μ ≤ N :=
  Submodule.span_le.mpr (by rintro c ⟨i, j, hij, x, rfl⟩; exact hN hij x)

/-- When `μ_ii = id` (axiom (1)), the relation attached to `i ≤ i` is trivial. -/
theorem rel_mem_self (hμ : IsDirectSystem μ) (i : I) (x : M i) :
    ι (A := A) i x - ι (A := A) i (μ (le_refl i) x) = 0 := by
  rw [hμ.map_self i]
  simp

/-! ### The maps `μ_i` and the compatibility `μ_i = μ_j ∘ μ_ij` -/

/-- The value of `μ_i` is the class of `x_i` modulo `D`: `μ_i(x) = x + D`. -/
theorem proj_apply (i : I) (x : M i) :
    proj μ i x = Submodule.Quotient.mk (ι (A := A) i x) := rfl

/-- Two elements of the limit are equal precisely when their difference lies in `D`. This is the
precise content of the phrase "from the construction it is clear". -/
theorem proj_eq_iff {i j : I} (x : M i) (y : M j) :
    proj μ i x = proj μ j y ↔ ι (A := A) i x - ι (A := A) j y ∈ relSubmodule μ := by
  rw [proj_apply, proj_apply, Submodule.Quotient.eq]

/-- The defining relations of `D` are exactly what makes the maps `μ_i` compatible: for `i ≤ j`
and `x ∈ M_i` one has `μ_i(x) = μ_j(μ_ij(x))`. This is the assertion of Exercise 14, and it uses
neither directedness of `I` nor axioms (1), (2). -/
theorem proj_compat {i j : I} (hij : i ≤ j) (x : M i) :
    proj μ i x = proj μ j (μ hij x) := by
  rw [proj_apply, proj_apply]
  exact (Submodule.Quotient.eq (relSubmodule μ)).mpr (rel_mem μ hij x)

/-- Exercise 14, in the form of an equality of `A`-linear maps: `μ_i = μ_j ∘ μ_ij` for `i ≤ j`. -/
theorem proj_compat_comp {i j : I} (hij : i ≤ j) :
    proj μ i = (proj μ j).comp (μ hij) :=
  LinearMap.ext (fun x => proj_compat μ hij x)

/-- Axiom (1) makes `μ_i` compatible with `μ_ii = id`. -/
theorem proj_self (hμ : IsDirectSystem μ) (i : I) :
    proj μ i = (proj μ i).comp (μ (le_refl i)) := by
  rw [hμ.map_self i, LinearMap.comp_id]

/-- Axiom (2) makes the family `(μ_i)` a cocone: the composite of the transition maps
`M_i → M_j → M_k` is again compatible with `μ_i` and `μ_k`. -/
theorem proj_trans (hμ : IsDirectSystem μ) {i j k : I} (hij : i ≤ j) (hjk : j ≤ k) :
    proj μ i = (proj μ k).comp ((μ hjk).comp (μ hij)) := by
  rw [← hμ.map_comp hij hjk]
  exact proj_compat_comp μ (hij.trans hjk)

/-! ### The exercise -/

set_option linter.unusedVariables false in
/-- **Atiyah–Macdonald, Chapter 2, Exercise 14.** Let `A` be a commutative ring, let `I` be a
directed set, let `(M_i)` be a family of `A`-modules and let `μ_ij : M_i → M_j` (`i ≤ j`) be
`A`-homomorphisms satisfying (1) `μ_ii = id` and (2) `μ_ik = μ_jk ∘ μ_ij`. Form `C = ⨁ i, M_i`,
let `D` be the submodule generated by the elements `x_i - μ_ij(x_i)` (`i ≤ j`, `x_i ∈ M_i`), put
`M = C/D`, let `π : C → M` be the projection and let `μ_i : M_i → M` be the restriction of `π` to
`M_i`. Then `μ_i = μ_j ∘ μ_ij` whenever `i ≤ j`. -/
theorem solution (hI : IsDirectedSet I) (hμ : IsDirectSystem μ) {i j : I} (hij : i ≤ j) :
    proj μ i = (proj μ j).comp (μ hij) :=
  proj_compat_comp μ hij

set_option linter.unusedVariables false in
/-- Exercise 14, collected: the direct limit construction produces an `A`-module `M`, together
with `A`-linear maps `μ_i : M_i → M`, such that `μ_i = μ_j ∘ μ_ij` for `i ≤ j` and such that the
maps are compatible with axioms (1) and (2). -/
theorem exists_directLimit (hI : IsDirectedSet I) (hμ : IsDirectSystem μ) :
    ∃ (L : Type (max v w)) (_ : AddCommGroup L) (_ : Module A L)
      (ν : ∀ i : I, M i →ₗ[A] L),
      (∀ ⦃i j : I⦄ (hij : i ≤ j), ν i = (ν j).comp (μ hij)) ∧
      (∀ i : I, ν i = (ν i).comp (μ (le_refl i))) :=
  ⟨Lim μ, inferInstance, inferInstance, proj μ,
    fun i j hij => proj_compat_comp (μ := μ) (i := i) (j := j) hij,
    fun i => proj_self μ hμ i⟩

end Construction

/-! ### The packaged direct system -/

section Packaged

variable {A : Type u} [CommRing A] {I : Type v} [Preorder I]

/-- Atiyah–Macdonald, Chapter 2, Exercise 14: a *direct system* `M = (M_i, μ_ij)` of `A`-modules
over the index set `I` — the modules `M_i` together with the transition maps `μ_ij : M_i → M_j`
for `i ≤ j` satisfying (1) `μ_ii = id` and (2) `μ_ik = μ_jk ∘ μ_ij`. -/
structure DirectSystem where
  /-- The family `(M_i)_{i ∈ I}` of `A`-modules. -/
  obj : I → Type w
  /-- Each `M_i` is an additive commutative group. -/
  [instAddCommGroup : ∀ i, AddCommGroup (obj i)]
  /-- Each `M_i` is an `A`-module. -/
  [instModule : ∀ i, Module A (obj i)]
  /-- The transition maps `μ_ij : M_i → M_j`, defined for `i ≤ j`. -/
  map : ∀ ⦃i j : I⦄, i ≤ j → obj i →ₗ[A] obj j
  /-- Axiom (1): `μ_ii` is the identity of `M_i`. -/
  map_self : ∀ i, map (le_refl i) = LinearMap.id
  /-- Axiom (2): `μ_ik = μ_jk ∘ μ_ij` for `i ≤ j ≤ k`. -/
  map_comp : ∀ {i j k : I} (hij : i ≤ j) (hjk : j ≤ k),
    map (hij.trans hjk) = (map hjk).comp (map hij)

attribute [instance] DirectSystem.instAddCommGroup DirectSystem.instModule

namespace DirectSystem

variable (X : DirectSystem (A := A) (I := I))

/-- The transition maps of a direct system satisfy axioms (1) and (2). -/
theorem isDirectSystem : IsDirectSystem X.map := ⟨X.map_self, X.map_comp⟩

/-- The direct limit of a direct system, as constructed in Exercise 14: the quotient of
`C = ⨁ i, M_i` by the submodule generated by the elements `x_i - μ_ij(x_i)`. -/
abbrev limit : Type (max v w) := Lim X.map

/-- The canonical map `μ_i : M_i → lim M_i` of the direct limit. -/
noncomputable abbrev toLimit (i : I) : X.obj i →ₗ[A] X.limit := proj X.map i

/-- **Atiyah–Macdonald, Chapter 2, Exercise 14** for a packaged direct system: `μ_i = μ_j ∘ μ_ij`
whenever `i ≤ j`. -/
theorem toLimit_compat {i j : I} (hij : i ≤ j) :
    X.toLimit i = (X.toLimit j).comp (X.map hij) :=
  proj_compat_comp X.map hij

/-- The same compatibility, pointwise: `μ_i(x_i) = μ_j(μ_ij(x_i))` for `i ≤ j`. -/
theorem toLimit_compat_apply {i j : I} (hij : i ≤ j) (x : X.obj i) :
    X.toLimit i x = X.toLimit j (X.map hij x) :=
  proj_compat X.map hij x

end DirectSystem

end Packaged

/-! ### A concrete check of the construction

The construction of Exercise 14 is not vacuous: for the one-term direct system over a single
index, where the only transition map is the identity, `D` is zero and the canonical map to the
limit is injective on the (nontrivial) module. -/

section OneTermExample

/-- The one-term direct system over the one-point index `Fin 1`, with `M_* = A` and the only
transition map (necessarily) the identity. -/
def oneTermSys (A : Type u) [CommRing A] : DirectSystem (A := A) (I := Fin 1) where
  obj := fun _ => A
  map := fun _ _ _ => LinearMap.id
  map_self := fun _ => rfl
  map_comp := fun _ _ => rfl

/-- For the one-term direct system, the submodule `D` of relations is zero. -/
theorem oneTermSys_relSubmodule_eq_bot (A : Type u) [CommRing A] :
    relSubmodule (oneTermSys A).map = ⊥ := by
  refine le_antisymm ?_ bot_le
  rw [relSubmodule]
  refine Submodule.span_le.mpr ?_
  rintro c ⟨i, j, hij, x, rfl⟩
  have hij' : i = j := Subsingleton.elim i j
  subst hij'
  have hx : ((oneTermSys A).map hij) x = x := rfl
  rw [hx, sub_self]
  exact Submodule.zero_mem ⊥

/-- The canonical map to the limit of the one-term direct system sends `1` to a nonzero element,
so the limit is not the zero module when `A` is nontrivial. -/
theorem oneTermSys_toLimit_one_ne_zero (A : Type u) [CommRing A] [Nontrivial A]
    (i : Fin 1) : (oneTermSys A).toLimit i (1 : A) ≠ 0 := by
  intro h
  have h1 : proj (oneTermSys A).map i (1 : A) = proj (oneTermSys A).map i (0 : A) :=
    h.trans (map_zero (proj (oneTermSys A).map i)).symm
  have h2 := (proj_eq_iff (oneTermSys A).map (i := i) (j := i) (x := (1 : A)) (y := (0 : A))).mp h1
  rw [oneTermSys_relSubmodule_eq_bot, Submodule.mem_bot] at h2
  have h3 : ι (A := A) (M := (oneTermSys A).obj) i (1 : A)
      = ι (A := A) (M := (oneTermSys A).obj) i (0 : A) := sub_eq_zero.mp h2
  have h4 : (1 : A) = 0 := ι_injective (A := A) (M := (oneTermSys A).obj) i h3
  exact one_ne_zero h4

end OneTermExample

end AtiyahMcdonald69.Ex_2_14
