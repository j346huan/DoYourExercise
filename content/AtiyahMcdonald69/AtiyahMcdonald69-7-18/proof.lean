/-
Formalization of Atiyah–Macdonald, *Introduction to Commutative Algebra* (Addison-Wesley, 1969),
Chapter 7, Exercise 18.

Public natural proof page:
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-18

The exercise (verbatim, from the source `AtiyahMcdonald69-7-18/proof.tex` and cross-checked with
the published solutions text) reads:

  Let A be a Noetherian ring, p a prime ideal of A, and M a finitely generated A-module. Show that
  the following are equivalent
    a. The ideal p belongs to 0 in M.
    b. There exists x ∈ M so that Ann(x) = p.
    c. There exists a submodule N of M isomorphic with A ⧸ p.
  Deduce that there exists a chain of submodules 0 = M₀ ⊂ M₁ ⊂ ⋯ ⊂ Mₙ = M of M with each
  Mᵢ₊₁ ⧸ Mᵢ isomorphic with A ⧸ pᵢ, for some prime ideal pᵢ in A.

Encoding of the three conditions (all quantifiers and objects are those of the exercise):

* (a) `BelongsToZero p M` is `IsAssociatedPrime p M`.  Atiyah–Macdonald define "p belongs to 0 in M"
  through minimal primary decompositions of the zero submodule of `M`; Chapter 4, Theorem 4.5
  characterizes the prime ideals occurring there, and Mathlib's `IsAssociatedPrime` is exactly that
  characterization (see the module documentation of `Mathlib.RingTheory.Ideal.AssociatedPrime.Basic`,
  which states that `IsAssociatedPrime` gives "the correct characterization of the prime ideals of any
  minimal primary decomposition ... (see Theorem 4.5 in Atiyah-Macdonald)").  In the Noetherian case
  the radical in the definition can be dropped, which is exactly the content of (a) ⇔ (b).
* (b) `HasAnn A M p` is `∃ x : M, (⊥ : Submodule A M).colon {x} = p`, i.e. `Ann(x) = p`
  (`Submodule.colon ⊥ {x}` is the annihilator of `x` in `M`).
* (c) `HasSubmoduleIso A M p` is `∃ N : Submodule A M, Nonempty (N ≃ₗ[A] A ⧸ p)`, i.e. `M` has a
  submodule isomorphic to `A ⧸ p`.

The chain of the last sentence is `PrimeChain A M`: an explicit sequence of submodules
`c : Fin (n+1) → Submodule A M` with `c 0 = ⊥`, `c (Fin.last n) = ⊤`, strictly increasing, together
with prime ideals `pᵢ` and linear equivalences `Mᵢ₊₁ ⧸ Mᵢ ≃ₗ[A] A ⧸ pᵢ` (no bare existential in
place of the quotient isomorphisms).
-/
import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
import Mathlib.LinearAlgebra.Isomorphisms

open Submodule

namespace AtiyahMcdonald69.Ex_7_18

universe u v

/-! ## The conditions of the exercise -/

section Conditions

variable (A : Type u) [CommRing A]

/-- Condition (a) of Exercise 7.18: the ideal `p` belongs to `0` in `M`.  This is Atiyah–Macdonald's
notion, encoded by the associated primes of `M` (see the file header; by Theorem 4.5 of the book this
is exactly "p occurs as the radical of a component of a minimal primary decomposition of `0`"). -/
def BelongsToZero (M : Type v) [AddCommGroup M] [Module A M] (p : Ideal A) : Prop :=
  IsAssociatedPrime p M

/-- Condition (b) of Exercise 7.18: `p` is the annihilator of some element of `M`. -/
def HasAnn (M : Type v) [AddCommGroup M] [Module A M] (p : Ideal A) : Prop :=
  ∃ x : M, (⊥ : Submodule A M).colon {x} = p

/-- Condition (c) of Exercise 7.18: `M` has a submodule isomorphic to `A ⧸ p`. -/
def HasSubmoduleIso (M : Type v) [AddCommGroup M] [Module A M] (p : Ideal A) : Prop :=
  ∃ N : Submodule A M, Nonempty (N ≃ₗ[A] A ⧸ p)

end Conditions

/-! ## (b) ⇔ (c): annihilators versus cyclic submodules -/

section Annihilator

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- The annihilator of `x` is the kernel of `A → M`, `a ↦ a • x`. -/
theorem ker_toSpanSingleton_eq_colon (x : M) :
    LinearMap.ker (LinearMap.toSpanSingleton A M x) = (⊥ : Submodule A M).colon {x} := by
  ext a
  simp [LinearMap.mem_ker, Submodule.mem_colon_singleton]

/-- (b) ⇒ (c) of Exercise 7.18: if `p = Ann(x)`, the cyclic submodule `A ∙ x` generated by `x` is
isomorphic to `A ⧸ p` (first isomorphism theorem for `A → M`, `a ↦ a • x`). -/
theorem hasSubmoduleIso_of_hasAnn {p : Ideal A} (h : HasAnn A M p) : HasSubmoduleIso A M p := by
  obtain ⟨x, hx⟩ := h
  refine ⟨LinearMap.range (LinearMap.toSpanSingleton A M x), ?_⟩
  refine ⟨(LinearMap.quotKerEquivRange (LinearMap.toSpanSingleton A M x)).symm.trans
    (Submodule.quotEquivOfEq _ _ (by rw [ker_toSpanSingleton_eq_colon, hx]))⟩

end Annihilator

/-! ## (a) ⇔ (b) and (c) ⇒ (b) -/

section Noetherian

variable {A : Type u} [CommRing A] [IsNoetherianRing A]
  {M : Type v} [AddCommGroup M] [Module A M]

/-- (a) ⇔ (b) of Exercise 7.18.  In a Noetherian ring an associated prime of `M` (a prime belonging
to `0` in `M`) is the annihilator of an element, and conversely.  This is Atiyah–Macdonald's
Theorem 4.5 together with Exercise 4.22, formalized as `isAssociatedPrime_iff`. -/
theorem belongsToZero_iff_hasAnn {p : Ideal A} (hp : p.IsPrime) :
    BelongsToZero A M p ↔ HasAnn A M p := by
  rw [BelongsToZero, isAssociatedPrime_iff, and_iff_right hp]
  exact exists_congr fun x => eq_comm

/-- (c) ⇒ (a) of Exercise 7.18: if `A ⧸ p` embeds in `M` as a submodule, then `p` belongs to `0`
in `M`. -/
theorem belongsToZero_of_hasSubmoduleIso {p : Ideal A} (hp : p.IsPrime)
    (h : HasSubmoduleIso A M p) : BelongsToZero A M p := by
  obtain ⟨N, ⟨e⟩⟩ := h
  refine (isAssociatedPrime_iff_exists_injective_linearMap (I := p) (M := M)).mpr ⟨hp, ?_⟩
  exact ⟨N.subtype ∘ₗ e.symm.toLinearMap, N.injective_subtype.comp e.symm.injective⟩

/-- (c) ⇒ (b) of Exercise 7.18. -/
theorem hasAnn_of_hasSubmoduleIso {p : Ideal A} (hp : p.IsPrime)
    (h : HasSubmoduleIso A M p) : HasAnn A M p :=
  belongsToZero_iff_hasAnn hp |>.mp (belongsToZero_of_hasSubmoduleIso hp h)

end Noetherian

/-! ## Condition (a) via minimal primary decompositions

Atiyah–Macdonald define "`p` belongs to `0` in `M`" through minimal primary decompositions of the
zero submodule of `M` (Chapter 4).  Condition (a) is encoded above as `BelongsToZero p M`, i.e.
`IsAssociatedPrime p M`; the next lemma checks that this notion does capture the book's primes: for
any minimal primary decomposition `0 = ⋂ⱼ Qⱼ` of `0` in `M`, the radical of every component `Qᵢ`
belongs to `0` in `M`.  This is exactly the book's argument for (i) ⇒ (ii): the elements of `M`
lying in all the other components but not in `Qᵢ` have annihilator whose radical is `r(Qᵢ : M)`. -/

section PrimaryDecomposition

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

theorem belongsToZero_radical_colon_of_primaryDecomposition {ι : Type*} [Fintype ι]
    (Q : ι → Submodule A M) (hQ : ∀ j, (Q j).IsPrimary) (hinf : ⨅ j, Q j = ⊥)
    (hmin : ∀ i, ∃ x : M, (∀ j, j ≠ i → x ∈ Q j) ∧ x ∉ Q i) (i : ι) :
    BelongsToZero A M ((Q i).colon (⊤ : Set M)).radical := by
  classical
  obtain ⟨x, hx, hxi⟩ := hmin i
  refine Submodule.isAssociatedPrime_def.mpr ⟨(hQ i).isPrime_radical_colon, x, ?_⟩
  refine le_antisymm ?_ ?_
  · -- `r(Qᵢ : M) ⊆ r(0 : x)`, because `aⁿ • x = 0` whenever `aⁿ • M ⊆ Qᵢ`
    intro a ha
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp ha
    have hzero : a ^ n • x = 0 := by
      have h1 : a ^ n • x ∈ ⨅ j, Q j := by
        refine (Submodule.mem_iInf Q).mpr fun j => ?_
        by_cases hj : j = i
        · subst hj
          exact Submodule.mem_colon.mp hn x (Set.mem_univ x)
        · exact (Q j).smul_mem (a ^ n) (hx j hj)
      rwa [hinf, Submodule.mem_bot] at h1
    exact Ideal.mem_radical_iff.mpr
      ⟨n, by rwa [Submodule.mem_colon_singleton, Submodule.mem_bot]⟩
  · -- `r(0 : x) ⊆ r(Qᵢ : M)`, using primarity of `Qᵢ` and `x ∉ Qᵢ`
    intro a ha
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp ha
    rw [Submodule.mem_colon_singleton, Submodule.mem_bot] at hn
    rcases (hQ i).mem_or_mem (m := x) (r := a ^ n) (by rw [hn]; exact (Q i).zero_mem) with h | h
    · exact absurd h hxi
    · obtain ⟨m, hm⟩ := Ideal.mem_radical_iff.mp h
      exact Ideal.mem_radical_iff.mpr ⟨n * m, by rwa [pow_mul]⟩

end PrimaryDecomposition

/-! ## The literal form of condition (a) implies (b)

Atiyah–Macdonald's condition (a) is about minimal primary decompositions of the zero submodule.
Packaged below is the literal statement "`0 = ⨅ⱼ Qⱼ` is a minimal primary decomposition of `0` in
`M`", and the direction (a) ⇒ (b) of the exercise is proved for it (this is the book's own route for
(i) ⇒ (ii)).  The converse direction (b) ⇒ (a) in this literal form needs the existence of minimal
primary decompositions for finitely generated modules over Noetherian rings — Atiyah–Macdonald's
Exercise 7.17 — together with the uniqueness part of Theorem 4.5, which is why condition (a) is
encoded by the associated primes themselves (its Theorem 4.5 characterization) in `solution` below.
-/

section LiteralConditionA

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- A minimal primary decomposition `0 = ⨅ⱼ Qⱼ` of the zero submodule of `M`: the `Qⱼ` are primary,
their intersection is `0`, and no component is redundant (`irredundant`). -/
structure MinimalPrimaryDecomposition (A : Type u) [CommRing A] (M : Type v)
    [AddCommGroup M] [Module A M] (ι : Type*) [Fintype ι] where
  /-- the primary components -/
  Q : ι → Submodule A M
  /-- the components intersect in `0` -/
  inf_eq_bot : (⨅ j, Q j) = ⊥
  /-- every component is primary -/
  isPrimary : ∀ j, (Q j).IsPrimary
  /-- minimality: no component contains the intersection of the others -/
  irredundant : ∀ j, ∃ x : M, (∀ k, k ≠ j → x ∈ Q k) ∧ x ∉ Q j

variable [IsNoetherianRing A]

/-- Condition (a) ⇒ (b) of Exercise 7.18, for the literal reading of (a): if `p` is the radical of
a component of a minimal primary decomposition of `0` in `M`, then `p` is the annihilator of an
element of `M`. -/
theorem hasAnn_of_minimalPrimaryDecomposition {ι : Type*} [Fintype ι]
    (D : MinimalPrimaryDecomposition A M ι) (i : ι) {p : Ideal A}
    (hp : ((D.Q i).colon (⊤ : Set M)).radical = p) : HasAnn A M p := by
  subst hp
  exact (belongsToZero_iff_hasAnn (D.isPrimary i).isPrime_radical_colon).mp
    (belongsToZero_radical_colon_of_primaryDecomposition D.Q D.isPrimary D.inf_eq_bot
      D.irredundant i)

end LiteralConditionA

/-! ## The two ways of writing the quotient `Mᵢ₊₁ ⧸ Mᵢ`

Inside `Mᵢ₊₁`, the submodule `Mᵢ` can be written either as `(Mᵢ).submoduleOf Mᵢ₊₁` or as the image of
`Mᵢ` under the inclusion `Mᵢ → Mᵢ₊₁`; both submodules coincide, so the statement of the exercise is
independent of this choice of notation for `Mᵢ₊₁ / Mᵢ`. -/

section QuotientForm

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

theorem submoduleOf_eq_map_inclusion {N P : Submodule A M} (h : N ≤ P) :
    N.submoduleOf P = (⊤ : Submodule A ↥N).map (Submodule.inclusion h) := by
  ext ⟨x, hx⟩
  simp only [Submodule.submoduleOf, Submodule.mem_comap, Submodule.mem_map, Submodule.mem_top,
    true_and]
  constructor
  · intro hxN
    exact ⟨⟨x, hxN⟩, Subtype.ext rfl⟩
  · rintro ⟨a, hax⟩
    have hax' : (a : M) = x := by simpa using congrArg (fun y : ↥P => (y : M)) hax
    simpa [hax'] using a.2

end QuotientForm

/-! ## The chain `0 = M₀ ⊂ M₁ ⊂ ⋯ ⊂ Mₙ = M` -/

/-- The chain of submodules deduced in Exercise 7.18: `0 = M₀ ⊂ M₁ ⊂ ⋯ ⊂ Mₙ = M`, where each
successive quotient `Mᵢ₊₁ ⧸ Mᵢ` is isomorphic to `A ⧸ pᵢ` for a prime ideal `pᵢ`. -/
structure PrimeChain (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M] where
  /-- the number of inclusions in the chain -/
  n : ℕ
  /-- the submodules of the chain -/
  c : Fin (n + 1) → Submodule A M
  /-- the prime ideals giving the successive quotients -/
  p : Fin n → Ideal A
  /-- the chain starts at `0` -/
  c_zero : c 0 = ⊥
  /-- the chain ends at `M` -/
  c_last : c (Fin.last n) = ⊤
  /-- the chain is strictly increasing -/
  strict : ∀ i : Fin n, c i.castSucc < c i.succ
  /-- the ideals `pᵢ` are prime -/
  prime : ∀ i : Fin n, (p i).IsPrime
  /-- the successive quotients are isomorphic to `A ⧸ pᵢ` -/
  quot : ∀ i : Fin n,
    Nonempty ((↥(c i.succ) ⧸ (c i.castSucc).submoduleOf (c i.succ)) ≃ₗ[A] A ⧸ p i)

/-- **Exercise 7.18, last sentence**: for a finitely generated module `M` over a Noetherian ring
there is a chain `0 = M₀ ⊂ M₁ ⊂ ⋯ ⊂ Mₙ = M` of submodules whose successive quotients are
isomorphic to `A ⧸ pᵢ` for prime ideals `pᵢ`.

This is obtained from `IsNoetherianRing.exists_relSeries_isQuotientEquivQuotientPrime` (the
associated-prime recursion `Mᵢ ↦ Mᵢ₊₁/Mᵢ ≅ A ⧸ pᵢ`, using that `A ⧸ pᵢ` is non-zero because `pᵢ`
is prime, so each inclusion is strict). -/
theorem exists_primeChain (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M]
    [IsNoetherianRing A] [Module.Finite A M] : Nonempty (PrimeChain A M) := by
  classical
  obtain ⟨s, hs_head, hs_last⟩ :=
    IsNoetherianRing.exists_relSeries_isQuotientEquivQuotientPrime A M
  have hstep : ∀ i : Fin s.length, s i.castSucc ≤ s i.succ ∧ ∃ q : PrimeSpectrum A,
      Nonempty ((↥(s i.succ) ⧸ (s i.castSucc).submoduleOf (s i.succ)) ≃ₗ[A] A ⧸ q.1) := by
    intro i
    have h := s.step i
    simpa only [Set.mem_ofPred_eq, Submodule.IsQuotientEquivQuotientPrime] using h
  refine ⟨s.length, fun i => s i, fun i => (hstep i).2.choose.1, hs_head, hs_last, ?_, ?_, ?_⟩
  · -- each step is strict, since `A ⧸ pᵢ` is non-trivial
    intro i
    obtain ⟨hle, q, ⟨e⟩⟩ := hstep i
    refine lt_of_le_of_ne hle fun heq => ?_
    have hsub : Subsingleton (↥(s i.succ) ⧸ (s i.castSucc).submoduleOf (s i.succ)) := by
      rw [heq, Submodule.submoduleOf_self]
      infer_instance
    have h1 : (1 : A ⧸ q.1) ≠ 0 := by
      intro h
      exact q.2.ne_top ((Ideal.eq_top_iff_one q.1).mpr
        (by simpa using Ideal.Quotient.eq_zero_iff_mem.mp h))
    exact h1 (e.symm.injective (Subsingleton.elim _ _))
  · exact fun i => (hstep i).2.choose.2
  · exact fun i => (hstep i).2.choose_spec

/-! ## The chain with the quotient written via the inclusion -/

section ChainQuotientForm

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- The quotient isomorphisms of a `PrimeChain`, written with the image of `Mᵢ` under the inclusion
`Mᵢ → Mᵢ₊₁` instead of `submoduleOf`. -/
theorem PrimeChain.quot_map (C : PrimeChain A M) (i : Fin C.n) :
    Nonempty ((↥(C.c i.succ) ⧸ (⊤ : Submodule A ↥(C.c i.castSucc)).map
      (Submodule.inclusion (le_of_lt (C.strict i)))) ≃ₗ[A] A ⧸ C.p i) := by
  obtain ⟨e⟩ := C.quot i
  exact ⟨(Submodule.quotEquivOfEq _ _
    (submoduleOf_eq_map_inclusion (le_of_lt (C.strict i)))).symm.trans e⟩

end ChainQuotientForm

/-! ## The complete exercise -/

/-- **Atiyah–Macdonald, Exercise 7.18** (Chapter 7, Noetherian rings; see
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-7-18).

Let `A` be a Noetherian ring, `p` a prime ideal of `A` and `M` a finitely generated `A`-module.  Then
the three conditions

(a) `p` belongs to `0` in `M`, (b) `p = Ann(x)` for some `x ∈ M`, (c) `M` contains a submodule
isomorphic to `A ⧸ p`

are equivalent, and `M` admits a strictly increasing chain of submodules
`0 = M₀ ⊂ M₁ ⊂ ⋯ ⊂ Mₙ = M` with `Mᵢ₊₁ ⧸ Mᵢ ≃ₗ[A] A ⧸ pᵢ` for prime ideals `pᵢ`. -/
theorem solution (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M]
    [IsNoetherianRing A] [Module.Finite A M] (p : Ideal A) (hp : p.IsPrime) :
    (BelongsToZero A M p ↔ HasAnn A M p) ∧
      (HasAnn A M p ↔ HasSubmoduleIso A M p) ∧
      (BelongsToZero A M p ↔ HasSubmoduleIso A M p) ∧
      Nonempty (PrimeChain A M) :=
  ⟨belongsToZero_iff_hasAnn hp,
   ⟨fun h => hasSubmoduleIso_of_hasAnn h, fun h => hasAnn_of_hasSubmoduleIso hp h⟩,
   ⟨fun h => hasSubmoduleIso_of_hasAnn ((belongsToZero_iff_hasAnn hp).mp h),
     fun h => belongsToZero_of_hasSubmoduleIso hp h⟩,
   exists_primeChain A M⟩

#print axioms AtiyahMcdonald69.Ex_7_18.solution
#print axioms AtiyahMcdonald69.Ex_7_18.exists_primeChain
#print axioms AtiyahMcdonald69.Ex_7_18.belongsToZero_iff_hasAnn
#print axioms AtiyahMcdonald69.Ex_7_18.hasSubmoduleIso_of_hasAnn
#print axioms AtiyahMcdonald69.Ex_7_18.hasAnn_of_hasSubmoduleIso
#print axioms AtiyahMcdonald69.Ex_7_18.belongsToZero_of_hasSubmoduleIso
#print axioms AtiyahMcdonald69.Ex_7_18.belongsToZero_radical_colon_of_primaryDecomposition
#print axioms AtiyahMcdonald69.Ex_7_18.PrimeChain.quot_map
#print axioms AtiyahMcdonald69.Ex_7_18.submoduleOf_eq_map_inclusion
#print axioms AtiyahMcdonald69.Ex_7_18.hasAnn_of_minimalPrimaryDecomposition

end AtiyahMcdonald69.Ex_7_18
