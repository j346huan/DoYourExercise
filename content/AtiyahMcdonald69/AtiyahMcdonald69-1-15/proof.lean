import Mathlib

/- Natural-language solution: https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-1-15 -/


/-!
# Atiyah–Macdonald (1969), Chapter 1, Exercise 1.15: the prime spectrum of a ring

**Statement** (book wording, audited against `.scratch/dl/amcd.tex` §"Page 12, Exercise 1.15" and
`.scratch/reference/atiyah-solutions.txt` line 327; the two agree verbatim):

> [The prime spectrum of a ring.] Let `A` be a ring and let `X` be the set of all prime ideals of
> `A`. For each subset `E` of `A`, let `V(E)` denote the set of all prime ideals of `A` which
> contain `E`. Prove that
>
> (i) if `𝔞` is the ideal generated by `E`, then `V(E) = V(𝔞) = V(r(𝔞))`;
> (ii) `V(0) = X`, `V(1) = ∅`;
> (iii) if `(E_i)_{i ∈ I}` is any family of subsets of `A`, then
> `V(⋃_{i ∈ I} E_i) = ⋂_{i ∈ I} V(E_i)`;
> (iv) `V(𝔞 ∩ 𝔟) = V(𝔞𝔟) = V(𝔞) ∪ V(𝔟)` for any ideals `𝔞`, `𝔟` of `A`.
>
> These results show that the sets `V(E)` satisfy the axioms for closed sets in a topological
> space. The resulting topology is called the Zariski topology. The topological space `X` is
> called the prime spectrum of `A`, and is written `Spec(A)`.

Encoding notes (statement fidelity):
* `X`, "the set of all prime ideals of `A`", is the type `PrimeSpectrum A`; a point `p` of it is a
  prime ideal and coerces to `(p : Ideal A)`.
* `E` ranges over *arbitrary* subsets of `A`, so `V` is defined on `Set A` (not on ideals); the
  coercion `Ideal A → Set A` lets us write `V 𝔞` for an ideal `𝔞`, exactly as in the book.
* In (i) the ideal generated by `E` is `Ideal.span E` and its radical is `Ideal.radical`.
* In (ii) `V(0) = X` and `V(1) = ∅` are formalised with the *elements* `0` and `1`
  (`V ({0} : Set A)`, `V ({1} : Set A)`), which is literally what the book's notation `V(0)`,
  `V(1)` means; the ideal-level readings `V (⊥ : Ideal A)` and `V (⊤ : Ideal A)` are corollaries,
  recorded as `part_ii_bot` and `part_ii_top` (they agree with (ii) by (i)).
* Part (iv) is two identities, `V(𝔞 ⊓ 𝔟) = V(𝔞 * 𝔟)` and `V(𝔞 * 𝔟) = V 𝔞 ∪ V 𝔟`.
* The closing remark of the exercise is formalised as `closed_axioms` together with a genuine
  `TopologicalSpace (PrimeSpectrum A)` instance `zariskiTopology` whose closed sets are exactly
  the sets `V E`; `zariskiTopology_eq` shows that this is Mathlib's `PrimeSpectrum.zariskiTopology`.

Everything is proved from the definitions (span, radical, primality); no result of this exercise
is assumed.
-/

noncomputable section

namespace AtiyahMcdonald69.Ex_1_15

variable {A : Type*} [CommRing A]

/-- `V E`: the set of all prime ideals of `A` which contain the subset `E` of `A`
(Atiyah–Macdonald, Ch. 1, Exercise 1.15). -/
def V (E : Set A) : Set (PrimeSpectrum A) := {p | E ⊆ (p : Ideal A)}

@[simp]
theorem mem_V {E : Set A} {p : PrimeSpectrum A} : p ∈ V E ↔ E ⊆ (p : Ideal A) := Iff.rfl

/-- `V` is Mathlib's vanishing set `PrimeSpectrum.zeroLocus`. -/
theorem V_eq_zeroLocus (E : Set A) : V E = PrimeSpectrum.zeroLocus E := rfl

/-! ### (i) `V(E) = V((E)) = V(r(E))` -/

/-- Part (i), first identity: `V E = V (E)`, where `(E)` is the ideal generated by `E`.
A prime contains `E` iff it contains the ideal generated by `E`. -/
theorem part_i_span (E : Set A) : V E = V (Ideal.span E) := by
  ext p
  constructor
  · intro h x hx
    exact Ideal.span_le.mpr h hx
  · intro h x hx
    exact h (Ideal.subset_span hx)

/-- Part (i), second identity: `V (E) = V (r(E))`. A prime ideal `𝔭` is radical, so it contains
`r(𝔞)` iff it contains `𝔞`. -/
theorem part_i_radical (E : Set A) :
    V (Ideal.span E) = V (((Ideal.span E).radical : Ideal A) : Set A) := by
  ext p
  constructor
  · -- `r(a) ⊆ p` because `p` is prime, hence radical
    intro h x hx
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hx
    exact p.isPrime.mem_of_pow_mem n (h hn)
  · -- `a ⊆ r(a)` always
    intro h x hx
    exact h (Ideal.le_radical hx)

/-- Part (i) in the form of the book: if `𝔞` is the ideal generated by `E`, then
`V(E) = V(𝔞) = V(r(𝔞))`. -/
theorem part_i' (E : Set A) (𝔞 : Ideal A) (h𝔞 : 𝔞 = Ideal.span E) :
    V E = V (𝔞 : Set A) ∧ V (𝔞 : Set A) = V (𝔞.radical : Set A) := by
  subst h𝔞
  exact ⟨part_i_span E, part_i_radical E⟩

/-- Part (i), as a chain of equalities. -/
theorem part_i (E : Set A) :
    V E = V (Ideal.span E) ∧
      V (Ideal.span E) = V (((Ideal.span E).radical : Ideal A) : Set A) :=
  ⟨part_i_span E, part_i_radical E⟩

/-! ### (ii) `V(0) = X`, `V(1) = ∅` -/

/-- Part (ii): every prime ideal contains `0`, so `V(0) = X`. -/
theorem part_ii_zero : V ({0} : Set A) = Set.univ := by
  ext p
  simp [V]

/-- Part (ii): no prime ideal contains `1` (a prime ideal is proper), so `V(1) = ∅`. -/
theorem part_ii_one : V ({1} : Set A) = ∅ := by
  ext p
  simp only [V, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, Set.not_subset]
  exact ⟨1, rfl, p.isPrime.one_notMem⟩

/-- Part (ii), both identities. -/
theorem part_ii : V ({0} : Set A) = Set.univ ∧ V ({1} : Set A) = ∅ :=
  ⟨part_ii_zero, part_ii_one⟩

/-- Part (ii) at the level of ideals: `V((0)) = X`. -/
theorem part_ii_bot : V ((⊥ : Ideal A) : Set A) = Set.univ := by
  ext p
  simp [V]

/-- Part (ii) at the level of ideals: `V((1)) = ∅`. -/
theorem part_ii_top : V ((⊤ : Ideal A) : Set A) = ∅ := by
  ext p
  simp only [V, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, Set.not_subset]
  exact ⟨1, Submodule.mem_top, p.isPrime.one_notMem⟩

/-! ### (iii) `V(⋃ Eᵢ) = ⋂ V(Eᵢ)` -/

/-- Part (iii): a prime contains the union of a family of subsets iff it contains every member of
the family. -/
theorem part_iii {ι : Type*} (E : ι → Set A) : V (⋃ i, E i) = ⋂ i, V (E i) := by
  ext p
  simp only [V, Set.mem_ofPred_eq, Set.mem_iInter, Set.iUnion_subset_iff]

/-! ### (iv) `V(𝔞 ∩ 𝔟) = V(𝔞𝔟) = V(𝔞) ∪ V(𝔟)` -/

/-- Part (iv), first identity: `V (𝔞 ⊓ 𝔟) = V (𝔞 * 𝔟)`.
One inclusion is `𝔞𝔟 ⊆ 𝔞 ⊓ 𝔟`; for the other, a prime containing `𝔞𝔟` contains `x * x` for every
`x ∈ 𝔞 ⊓ 𝔟`, hence contains `𝔞 ⊓ 𝔟` by primality. -/
theorem part_iv_inf (𝔞 𝔟 : Ideal A) :
    V ((𝔞 ⊓ 𝔟 : Ideal A) : Set A) = V ((𝔞 * 𝔟 : Ideal A) : Set A) := by
  ext p
  constructor
  · intro h x hx
    exact h (Ideal.mul_le_inf hx)
  · intro h x hx
    rcases p.isPrime.mem_or_mem (h (Ideal.mul_mem_mul hx.1 hx.2)) with h' | h'
    · exact h'
    · exact h'

/-- Part (iv), second identity: `V (𝔞 * 𝔟) = V 𝔞 ∪ V 𝔟`.
If a prime `𝔭` contains `𝔞𝔟` but not `𝔞`, choose `a ∈ 𝔞 \ 𝔭`; then `a * b ∈ 𝔭` forces `b ∈ 𝔭`
for every `b ∈ 𝔟`. -/
theorem part_iv_union (𝔞 𝔟 : Ideal A) :
    V ((𝔞 * 𝔟 : Ideal A) : Set A) = V (𝔞 : Set A) ∪ V (𝔟 : Set A) := by
  ext p
  rw [Set.mem_union]
  constructor
  · intro h
    by_cases h𝔞 : (𝔞 : Set A) ⊆ (p : Ideal A)
    · exact Or.inl h𝔞
    · right
      obtain ⟨a, ha, hap⟩ := Set.not_subset.mp h𝔞
      intro b hb
      rcases p.isPrime.mem_or_mem (h (Ideal.mul_mem_mul ha hb)) with h' | h'
      · exact absurd h' hap
      · exact h'
  · rintro (h | h) x hx
    · exact h (Ideal.mul_le_left hx)
    · exact h (Ideal.mul_le_right hx)

/-- Part (iv), both identities. -/
theorem part_iv (𝔞 𝔟 : Ideal A) :
    V ((𝔞 ⊓ 𝔟 : Ideal A) : Set A) = V ((𝔞 * 𝔟 : Ideal A) : Set A) ∧
      V ((𝔞 * 𝔟 : Ideal A) : Set A) = V (𝔞 : Set A) ∪ V (𝔟 : Set A) :=
  ⟨part_iv_inf 𝔞 𝔟, part_iv_union 𝔞 𝔟⟩

/-! ### Two general forms of the same identities, used in the book's argument -/

/-- Radical invariance for an arbitrary ideal: `V 𝔞 = V (r 𝔞)`. (Part (i) is the case
`𝔞 = (E)`; the book's hint "`𝔭 = r(𝔭)`" is exactly this argument.) -/
theorem V_radical (𝔞 : Ideal A) : V (𝔞 : Set A) = V (𝔞.radical : Set A) := by
  ext p
  constructor
  · intro h x hx
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hx
    exact p.isPrime.mem_of_pow_mem n (h hn)
  · intro h x hx
    exact h (Ideal.le_radical hx)

/-- The sum of two ideals corresponds to the intersection of their vanishing sets:
`V (𝔞 + 𝔟) = V 𝔞 ∩ V 𝔟`. -/
theorem V_sup (𝔞 𝔟 : Ideal A) :
    V ((𝔞 ⊔ 𝔟 : Ideal A) : Set A) = V (𝔞 : Set A) ∩ V (𝔟 : Set A) := by
  ext p
  constructor
  · intro h
    refine ⟨fun x hx => h ?_, fun x hx => h ?_⟩
    · exact Submodule.mem_sup.mpr ⟨x, hx, 0, Submodule.zero_mem _, by simp⟩
    · exact Submodule.mem_sup.mpr ⟨0, Submodule.zero_mem _, x, hx, by simp⟩
  · rintro ⟨h1, h2⟩ x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    exact Submodule.add_mem _ (h1 ha) (h2 hb)

/-- The empty family in (iii): `V ∅ = X`. -/
theorem V_empty : V (∅ : Set A) = Set.univ := by
  ext p
  simp [V]

/-! ### The sets `V E` are the closed sets of a topology on `X = Spec A` -/

/-- `∅` is a set of the form `V E`. -/
theorem empty_mem_range : (∅ : Set (PrimeSpectrum A)) ∈ Set.range V :=
  ⟨{1}, part_ii_one⟩

/-- `X = Spec A` is a set of the form `V E`. -/
theorem univ_mem_range : (Set.univ : Set (PrimeSpectrum A)) ∈ Set.range V :=
  ⟨{0}, part_ii_zero⟩

/-- The family `{V E}` is closed under arbitrary intersections (by (iii)). -/
theorem sInter_mem_range {S : Set (Set (PrimeSpectrum A))} (hS : S ⊆ Set.range V) :
    ⋂₀ S ∈ Set.range V := by
  refine ⟨⋃₀ {E : Set A | V E ∈ S}, ?_⟩
  ext p
  constructor
  · intro h s hs
    obtain ⟨E, rfl⟩ := hS hs
    exact fun x hx => h (Set.mem_sUnion.mpr ⟨E, hs, hx⟩)
  · intro h x hx
    obtain ⟨E, hE, hxE⟩ := hx
    exact h (V E) hE hxE

/-- The family `{V E}` is closed under finite (binary) unions (by (i) and (iv)). -/
theorem union_mem_range {s t : Set (PrimeSpectrum A)} (hs : s ∈ Set.range V)
    (ht : t ∈ Set.range V) : s ∪ t ∈ Set.range V := by
  obtain ⟨E, rfl⟩ := hs
  obtain ⟨F, rfl⟩ := ht
  refine ⟨(((Ideal.span E * Ideal.span F : Ideal A)) : Set A), ?_⟩
  rw [part_i_span E, part_i_span F, part_iv_union]

/-- The closing remark of Exercise 1.15: the sets `V E` satisfy the axioms for closed sets of a
topological space on `X = Spec A`. -/
theorem closed_axioms :
    (∅ : Set (PrimeSpectrum A)) ∈ Set.range V ∧
      (Set.univ : Set (PrimeSpectrum A)) ∈ Set.range V ∧
      (∀ S : Set (Set (PrimeSpectrum A)), S ⊆ Set.range V → ⋂₀ S ∈ Set.range V) ∧
      (∀ s t : Set (PrimeSpectrum A),
        s ∈ Set.range V → t ∈ Set.range V → s ∪ t ∈ Set.range V) := by
  refine ⟨empty_mem_range, univ_mem_range, ?_, ?_⟩
  · intro S hS
    exact sInter_mem_range hS
  · intro s t hs ht
    exact union_mem_range hs ht

/-- The Zariski topology on `Spec A`: the topology whose closed sets are the sets `V E`. -/
@[instance_reducible]
def zariskiTopology : TopologicalSpace (PrimeSpectrum A) :=
  TopologicalSpace.ofClosed (Set.range V) empty_mem_range
    (fun _ hS => sInter_mem_range hS) (fun _ hs _ ht => union_mem_range hs ht)

/-- For the topology built from the sets `V E`, the closed sets are exactly the sets `V E`. -/
theorem isClosed_iff_exists_V (s : Set (PrimeSpectrum A)) :
    @IsClosed (PrimeSpectrum A) zariskiTopology s ↔ ∃ E : Set A, s = V E := by
  constructor
  · intro hs
    have h1 : (sᶜ)ᶜ ∈ Set.range V := hs.isOpen_compl
    rw [compl_compl, Set.mem_range] at h1
    exact (exists_congr fun E => eq_comm).mp h1
  · rintro ⟨E, rfl⟩
    refine ⟨?_⟩
    change ((V E)ᶜ)ᶜ ∈ Set.range V
    rw [compl_compl]
    exact ⟨E, rfl⟩

/-- The topology built from the sets `V E` is Mathlib's Zariski topology on `Spec A`. -/
theorem zariskiTopology_eq : zariskiTopology (A := A) = PrimeSpectrum.zariskiTopology := by
  rw [TopologicalSpace.ext_iff_isClosed]
  intro s
  rw [isClosed_iff_exists_V, PrimeSpectrum.isClosed_iff_zeroLocus]
  exact exists_congr fun E => by rw [V_eq_zeroLocus]

/-- Each `V E` is closed for the Zariski topology. -/
theorem isClosed_V (E : Set A) : @IsClosed (PrimeSpectrum A) zariskiTopology (V E) :=
  (isClosed_iff_exists_V (V E)).mpr ⟨E, rfl⟩

/-! ### The exercise, as one assertion -/

/-- Atiyah–Macdonald, Ch. 1, Exercise 1.15: parts (i), (ii), (iii), (iv), with the same
quantifiers as the book. -/
theorem solution :
    (∀ E : Set A, V E = V (Ideal.span E) ∧
      V (Ideal.span E) = V (((Ideal.span E).radical : Ideal A) : Set A)) ∧
      (V ({0} : Set A) = Set.univ ∧ V ({1} : Set A) = ∅) ∧
      (∀ (ι : Type*) (E : ι → Set A), V (⋃ i, E i) = ⋂ i, V (E i)) ∧
      (∀ 𝔞 𝔟 : Ideal A,
        V ((𝔞 ⊓ 𝔟 : Ideal A) : Set A) = V ((𝔞 * 𝔟 : Ideal A) : Set A) ∧
          V ((𝔞 * 𝔟 : Ideal A) : Set A) = V (𝔞 : Set A) ∪ V (𝔟 : Set A)) :=
  ⟨part_i, part_ii, fun _ E => part_iii E, part_iv⟩

end AtiyahMcdonald69.Ex_1_15

#print axioms AtiyahMcdonald69.Ex_1_15.solution
