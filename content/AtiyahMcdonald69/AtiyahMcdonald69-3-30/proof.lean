/-
Atiyah–Macdonald (1969), Exercise 3.30 — a complete Lean 4 formalisation.

# Exercise 3.30 (Atiyah–Macdonald, *Introduction to Commutative Algebra*, Ch. 3)

**Book statement** (Chapter 3, exercises, p. 49):

> 30. Show that the Zariski topology and the constructible topology on `Spec A` are the
> same if and only if `A/𝔑` is absolutely flat (where `𝔑` is the nilradical of `A`).
> [Use Exercise 11.]

The constructible topology is the one introduced in Exercises 3.27 and 3.28: the smallest
topology on `X = Spec A` for which every set `X_f = {p : f ∉ p}` (`f ∈ A`) is both open
*and closed* (Exercise 3.28 ii), i.e. the topology generated by the `X_f` together with their
complements.  Here it is `constructibleTopology A`.

## What is proved (all without `sorry`, with only the standard axioms)

* `constructibleTopology A` — the topology generated by the `X_f` and their complements,
  `t2Space_constructibleTopology` — it is Hausdorff (Exercise 3.28 ii),
  `constructible_le_zariski` — it is finer than the Zariski topology (Exercise 3.27 iii);
* `exists_notMem_mul_pow_eq_zero` — in a ring all of whose prime ideals are maximal, if
  `f ∈ 𝔭` then some `s ∉ 𝔭` kills a power of `f` (the concrete form of
  "the localisation at `𝔭` is a zero-dimensional local ring");
* `isOpen_zeroLocus_singleton`, `zariski_le_constructible_of_forall_isMaximal` — hence
  `V(f)` is Zariski-open and the two topologies coincide;
* `zariski_eq_constructible_iff` — **the topological core of 3.30**:
  `zariskiTopology = constructibleTopology ↔ ∀ p, p.IsPrime → p.IsMaximal`;
* `vnr_quotient_nilradical_iff` — **Exercise 3.11**: `A/𝔑` is von Neumann regular iff every
  prime ideal of `A` is maximal (both directions);
* `isAbsolutelyFlat_iff_vnr` — **Chapter 2, Exercise 27**: a ring is absolutely flat (every
  module is flat) iff it is von Neumann regular;
* `zariski_eq_constructible_iff_absolutelyFlat`, alias `solution` — **Exercise 3.30 in the
  book's own terms**: the Zariski and constructible topologies on `Spec A` coincide iff
  `A/𝔑` is absolutely flat.

Concrete examples and an audit of the statement are at the end of the file
(`generateFrom_basicOpen_eq_zariski`, a field, and `ℤ`).
-/
import Mathlib

set_option linter.style.haveILetI false
set_option linter.style.setOption false

namespace AtiyahMcdonald69.Ex_3_30

open PrimeSpectrum TopologicalSpace
open scoped Topology

variable (A : Type*) [CommRing A]

/-! ## The constructible topology -/

/-- The subbasis of the constructible topology: all sets `X_f` (for `f : A`) together with
their complements.  Equivalently it is the smallest topology making all `X_f` clopen. -/
def constructibleSubbasis : Set (Set (PrimeSpectrum A)) :=
  {s | (∃ f : A, s = (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))) ∨
      ∃ f : A, s = (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))ᶜ}

/-- **The constructible topology** on `Spec A` (Exercises 3.27, 3.28): the smallest topology
for which every `X_f = D(f)` is both open and closed. -/
@[instance_reducible]
def constructibleTopology : TopologicalSpace (PrimeSpectrum A) :=
  TopologicalSpace.generateFrom (constructibleSubbasis A)

theorem isOpen_basicOpen_constructible (f : A) :
    IsOpen[constructibleTopology A] (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A)) :=
  isOpen_generateFrom_of_mem (Or.inl ⟨f, rfl⟩)

theorem isOpen_compl_basicOpen_constructible (f : A) :
    IsOpen[constructibleTopology A] ((PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))ᶜ) :=
  isOpen_generateFrom_of_mem (Or.inr ⟨f, rfl⟩)

/-- Membership in the complement of a basic open set: `p ∈ X_fᶜ ↔ f ∈ p`. -/
theorem mem_compl_basicOpen_iff (x : A) (p : PrimeSpectrum A) :
    p ∈ ((PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A)))ᶜ ↔ x ∈ p.asIdeal := by
  simp

/-- The Zariski topology is contained in the constructible topology (Exercise 3.27 iii). -/
theorem constructible_le_zariski :
    constructibleTopology A ≤ PrimeSpectrum.zariskiTopology (R := A) := by
  have h1 : constructibleTopology A ≤
      TopologicalSpace.generateFrom (Set.range fun f : A =>
        (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))) :=
    le_generateFrom (t := constructibleTopology A)
      (by rintro _ ⟨f, rfl⟩; exact isOpen_generateFrom_of_mem (Or.inl ⟨f, rfl⟩))
  have h2 : TopologicalSpace.generateFrom (Set.range fun f : A =>
      (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))) =
        PrimeSpectrum.zariskiTopology (R := A) :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.eq_generateFrom.symm
  rw [h2] at h1
  exact h1

/-- The constructible topology is Hausdorff (Exercise 3.28 ii). -/
theorem t2Space_constructibleTopology : @T2Space (PrimeSpectrum A) (constructibleTopology A) := by
  letI := constructibleTopology A
  refine ⟨fun p q hpq => ?_⟩
  have hne : p.asIdeal ≠ q.asIdeal := fun h => hpq (PrimeSpectrum.ext h)
  have hsep : (∃ x ∈ p.asIdeal, x ∉ q.asIdeal) ∨ (∃ x ∈ q.asIdeal, x ∉ p.asIdeal) := by
    by_cases h : p.asIdeal ≤ q.asIdeal
    · have hqp : ¬ q.asIdeal ≤ p.asIdeal := fun h' => hne (le_antisymm h h')
      obtain ⟨x, hxq, hxp⟩ := Set.not_subset.1 hqp
      exact Or.inr ⟨x, hxq, hxp⟩
    · obtain ⟨x, hxp, hxq⟩ := Set.not_subset.1 h
      exact Or.inl ⟨x, hxp, hxq⟩
  rcases hsep with ⟨x, hxp, hxq⟩ | ⟨x, hxq, hxp⟩
  · refine ⟨((PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A))ᶜ),
      (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A)), ?_, ?_, ?_, ?_, ?_⟩
    · exact isOpen_compl_basicOpen_constructible A x
    · exact isOpen_basicOpen_constructible A x
    · exact (mem_compl_basicOpen_iff A x p).mpr hxp
    · exact hxq
    · exact disjoint_compl_left
  · refine ⟨(PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A)),
      ((PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A))ᶜ), ?_, ?_, ?_, ?_, ?_⟩
    · exact isOpen_basicOpen_constructible A x
    · exact isOpen_compl_basicOpen_constructible A x
    · exact hxp
    · exact (mem_compl_basicOpen_iff A x q).mpr hxq
    · exact disjoint_compl_right

/-! ## The key algebraic input

If every prime ideal of `A` is maximal, then for `f ∈ 𝔭` the localisation `A_𝔭` is a
zero-dimensional local ring; the image of `f` lies in the maximal ideal, which is the
nilradical, so `f` is nilpotent in `A_𝔭`.  Clearing denominators gives `s * f ^ n = 0` for
some `s ∉ 𝔭`.  This is the concrete form of "prime = maximal" that makes `V(f)` open. -/

/-- If every prime ideal of `A` is maximal and `f ∈ 𝔭`, then some `s ∉ 𝔭` kills a power of
`f`. -/
theorem exists_notMem_mul_pow_eq_zero (h : ∀ p : Ideal A, p.IsPrime → p.IsMaximal)
    {p : Ideal A} (hp : p.IsPrime) {f : A} (hf : f ∈ p) :
    ∃ s : A, s ∉ p ∧ ∃ n : ℕ, s * f ^ n = 0 := by
  have hp_prime : p.IsPrime := hp
  have hdimA : Ring.KrullDimLE 0 A := Ring.krullDimLE_zero_iff.mpr h
  have hpmin : p ∈ minimalPrimes A := by
    rw [Ring.KrullDimLE.minimalPrimes_eq_setOfPred_isPrime]; exact hp
  have hloc : IsLocalRing (Localization.AtPrime p) := Localization.AtPrime.isLocalRing (P := p)
  have hdimS : Ring.KrullDimLE 0 (Localization.AtPrime p) :=
    Ring.KrullDimLE.of_isLocalization (R := A) p hpmin (Localization.AtPrime p)
  have hmem : algebraMap A (Localization.AtPrime p) f ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (S := Localization.AtPrime p) (I := p) (x := f)]
    exact hf
  obtain ⟨n, hn⟩ := (Ring.KrullDimLE.isNilpotent_iff_mem_maximalIdeal
    (R := Localization.AtPrime p)).mpr hmem
  have hzero : algebraMap A (Localization.AtPrime p) (f ^ n) = 0 := by
    rw [map_pow]; exact hn
  obtain ⟨c, hc⟩ :=
    (IsLocalization.map_eq_zero_iff p.primeCompl (Localization.AtPrime p) (f ^ n)).mp hzero
  exact ⟨c, c.2, n, hc⟩

/-- **`V(f)` is Zariski-open when every prime ideal is maximal.**  For `𝔭 ∋ f` the previous
lemma produces `s ∉ 𝔭` with `s * f ^ n = 0`; then `𝔭 ∈ D(s) ⊆ V(f)`, because a prime
containing `s * f ^ n = 0` but not `s` must contain `f`. -/
theorem isOpen_zeroLocus_singleton (h : ∀ p : Ideal A, p.IsPrime → p.IsMaximal) (f : A) :
    IsOpen (PrimeSpectrum.zeroLocus ({f} : Set A) : Set (PrimeSpectrum A)) := by
  rw [isOpen_iff_forall_mem_open]
  intro p hp
  have hf : f ∈ p.asIdeal := hp (Set.mem_singleton f)
  obtain ⟨s, hs, n, hsn⟩ := exists_notMem_mul_pow_eq_zero A h p.2 hf
  refine ⟨(PrimeSpectrum.basicOpen s : Set (PrimeSpectrum A)), ?_, PrimeSpectrum.isOpen_basicOpen,
    ?_⟩
  · intro q hq
    have hq' : s ∉ q.asIdeal := hq
    intro a ha
    rw [Set.mem_singleton_iff] at ha
    rw [ha]
    have hmem : f ^ n ∈ q.asIdeal := by
      have hz : s * f ^ n ∈ q.asIdeal := by rw [hsn]; exact q.asIdeal.zero_mem
      rcases q.2.mem_or_mem hz with h' | h'
      · exact absurd h' hq'
      · exact h'
    exact q.2.mem_of_pow_mem n hmem
  · exact hs

/-- The constructible topology is contained in the Zariski topology when every prime ideal is
maximal: both `X_f` and its complement `V(f)` are Zariski-open. -/
theorem zariski_le_constructible_of_forall_isMaximal
    (h : ∀ p : Ideal A, p.IsPrime → p.IsMaximal) :
    PrimeSpectrum.zariskiTopology (R := A) ≤ constructibleTopology A := by
  show PrimeSpectrum.zariskiTopology (R := A) ≤
    TopologicalSpace.generateFrom (constructibleSubbasis A)
  rw [le_generateFrom_iff_subset_isOpen]
  rintro s (⟨f, rfl⟩ | ⟨f, rfl⟩)
  · exact PrimeSpectrum.isOpen_basicOpen
  · simpa [PrimeSpectrum.basicOpen_eq_zeroLocus_compl] using isOpen_zeroLocus_singleton A h f

/-! ## Exercise 3.30 -/

/-- **Atiyah–Macdonald, Exercise 3.30.**  The Zariski topology and the constructible topology
on `Spec A` coincide if and only if every prime ideal of `A` is maximal; by Exercise 3.11
this is equivalent to `A/𝔑` being absolutely flat (`𝔑` the nilradical of `A`). -/
theorem zariski_eq_constructible_iff :
    PrimeSpectrum.zariskiTopology (R := A) = constructibleTopology A ↔
      ∀ p : Ideal A, p.IsPrime → p.IsMaximal := by
  constructor
  · intro h
    have t2 : T2Space (PrimeSpectrum A) := h ▸ t2Space_constructibleTopology A
    intro p hp
    have hcl : IsClosed ({⟨p, hp⟩} : Set (PrimeSpectrum A)) := isClosed_singleton
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal ⟨p, hp⟩).mp hcl
  · intro h
    exact le_antisymm (zariski_le_constructible_of_forall_isMaximal A h)
      (constructible_le_zariski A)


/-! ## Exercise 3.11: the ring-theoretic side

The book's hint is to use Exercise 3.11, whose statement is that `A/𝔑` is absolutely flat
iff every prime ideal of `A` is maximal.  "Absolutely flat" is defined in Chapter 2
(Exercise 27) as "every module is flat", and Exercise 27 lists the equivalent
characterisations; the one used here is von Neumann regularity: every element is a multiple
of its own square, equivalently every principal ideal is generated by an idempotent.
-/

/-- A commutative ring is *von Neumann regular* if every element is a multiple of its own
square.  This is one of the equivalent characterisations of absolute flatness listed in
Chapter 2, Exercise 27. -/
def IsVonNeumannRegular (R : Type*) [CommRing R] : Prop :=
  ∀ x : R, ∃ y : R, x = x ^ 2 * y

/-- In a von Neumann regular ring every element is a unit modulo any prime ideal it does not
belong to: if `x̄ = x̄² ȳ` in a domain and `x̄ ≠ 0`, then `x̄ ȳ = 1`. -/
theorem exists_one_sub_mul_mem_of_vnr_quotient
    (h : IsVonNeumannRegular (A ⧸ nilradical A)) {p : Ideal A} (hp : p.IsPrime)
    {a : A} (ha : a ∉ p) : ∃ c : A, 1 - a * c ∈ p := by
  have hp_prime : p.IsPrime := hp
  obtain ⟨y, hy⟩ := h (Ideal.Quotient.mk (nilradical A) a)
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective y
  have h1 : Ideal.Quotient.mk (nilradical A) (a - a ^ 2 * c) =
      Ideal.Quotient.mk (nilradical A) a -
        (Ideal.Quotient.mk (nilradical A) a) ^ 2 * Ideal.Quotient.mk (nilradical A) c := by
    simp
  have h0 : Ideal.Quotient.mk (nilradical A) (a - a ^ 2 * c) = 0 := by
    rw [h1, hy.symm, sub_self]
  have hmem : a - a ^ 2 * c ∈ nilradical A := Ideal.Quotient.eq_zero_iff_mem.mp h0
  have hmem' : a - a ^ 2 * c ∈ p := nilradical_le_prime p hmem
  refine ⟨c, ?_⟩
  have hprod : a * (1 - a * c) ∈ p := by
    have heq : a * (1 - a * c) = a - a ^ 2 * c := by ring
    rw [heq]; exact hmem'
  rcases hp.mem_or_mem hprod with h' | h'
  · exact absurd h' ha
  · exact h'

/-- The quotient of `A` by its nilradical is von Neumann regular when every prime ideal of
`A` is maximal (this is the nontrivial half of Exercise 3.11). -/
theorem vnr_quotient_nilradical_of_forall_isMaximal
    (h : ∀ p : Ideal A, p.IsPrime → p.IsMaximal) :
    IsVonNeumannRegular (A ⧸ nilradical A) := by
  set B := A ⧸ nilradical A with hB
  have hBmax : ∀ P : Ideal B, P.IsPrime → P.IsMaximal := by
    intro P hP
    have hP' : P.IsPrime := hP
    have hpc : (P.comap (Ideal.Quotient.mk (nilradical A))).IsPrime := Ideal.IsPrime.comap _
    have hmax : (P.comap (Ideal.Quotient.mk (nilradical A))).IsMaximal := h _ hpc
    have hmap : (P.comap (Ideal.Quotient.mk (nilradical A))).map
        (Ideal.Quotient.mk (nilradical A)) = P :=
      Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P
    rw [← hmap]
    refine hmax.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective ?_
    intro x hx
    rw [RingHom.mem_ker] at hx
    rw [Ideal.mem_comap, hx]
    exact P.zero_mem
  have hBred : IsReduced B :=
    (Ideal.isRadical_iff_quotient_reduced (nilradical A)).mp
      (show (nilradical A).IsRadical from Ideal.radical_isRadical ⊥)
  intro x
  have htop : Ideal.span {x} ⊔ LinearMap.ker (LinearMap.mulLeft (R := B) x) = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    have hMp : M.IsPrime := hM.isPrime
    have hx1 : x ∈ Ideal.span {x} ⊔ LinearMap.ker (LinearMap.mulLeft (R := B) x) :=
      Submodule.mem_sup_left (Ideal.subset_span (Set.mem_singleton x))
    have hxM : x ∈ M := hle hx1
    obtain ⟨s, hs, n, hsn⟩ := exists_notMem_mul_pow_eq_zero B hBmax hMp hxM
    have hsker : s ∈ LinearMap.ker (LinearMap.mulLeft (R := B) x) := by
      rw [LinearMap.mem_ker]
      show x * s = 0
      cases n with
      | zero =>
        have hs0 : s = 0 := by simpa using hsn
        rw [hs0, mul_zero]
      | succ m =>
        have hnil : IsNilpotent (x * s) := by
          refine ⟨m + 1, ?_⟩
          have hpow : (x * s) ^ (m + 1) = s ^ m * (s * x ^ (m + 1)) := by ring
          rw [hpow, hsn, mul_zero]
        exact IsReduced.eq_zero _ hnil
    exact hs (hle (Submodule.mem_sup_right hsker))
  have h1 : (1 : B) ∈ Ideal.span {x} ⊔ LinearMap.ker (LinearMap.mulLeft (R := B) x) := by
    rw [htop]; exact Submodule.mem_top
  obtain ⟨e, he, z, hz, hsum⟩ := Submodule.mem_sup.mp h1
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp he
  have hz' : x * z = 0 := by
    have hz2 := hz
    rw [LinearMap.mem_ker] at hz2
    exact hz2
  refine ⟨y, ?_⟩
  calc x = x * (e + z) := by rw [hsum, mul_one]
    _ = x * e := by rw [mul_add, hz', add_zero]
    _ = x ^ 2 * y := by rw [hy]; ring

/-- **Exercise 3.11** (in the von Neumann regular form of Chapter 2, Exercise 27): `A/𝔑`
is absolutely flat iff every prime ideal of `A` is maximal. -/
theorem vnr_quotient_nilradical_iff :
    IsVonNeumannRegular (A ⧸ nilradical A) ↔ ∀ p : Ideal A, p.IsPrime → p.IsMaximal := by
  constructor
  · intro h p hp
    have hp' : p.IsPrime := hp
    refine Ideal.isMaximal_iff.mpr ⟨hp.one_notMem, ?_⟩
    intro J a hpJ hap haJ
    obtain ⟨c, hc⟩ := exists_one_sub_mul_mem_of_vnr_quotient A h hp hap
    have h2 : a * c ∈ J := J.mul_mem_right c haJ
    have h3 : 1 - a * c ∈ J := hpJ hc
    have h4 : a * c + (1 - a * c) ∈ J := J.add_mem h2 h3
    simpa using h4
  · intro h
    exact vnr_quotient_nilradical_of_forall_isMaximal A h

/-- **Exercise 3.30 in the form of the book's statement**, with "absolutely flat" in the
von Neumann regular form of Chapter 2, Exercise 27. -/
theorem zariski_eq_constructible_iff_vnr :
    PrimeSpectrum.zariskiTopology (R := A) = constructibleTopology A ↔
      IsVonNeumannRegular (A ⧸ nilradical A) :=
  (zariski_eq_constructible_iff A).trans (vnr_quotient_nilradical_iff A).symm


/-! ## Absolute flatness (Chapter 2, Exercise 27)

"Absolutely flat" means "every module is flat" (Chapter 2, Exercise 27).  The characterisation
of absolute flatness that enters Exercise 3.11 is von Neumann regularity
(Exercise 27, condition (iv)): every element is a multiple of its own square.  We record the
implication "absolutely flat ⟹ von Neumann regular", proved by applying the equational
criterion for flatness to the relation `a · 1 = 0` in `A ⧸ (a)`. -/

universe u

/-- **Absolutely flat** (Atiyah–Macdonald, Chapter 2, Exercise 27): every module is flat. -/
def IsAbsolutelyFlat (R : Type u) [CommRing R] : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module R M], Module.Flat R M

/-- In a quotient ring, scalar multiplication by `r` is multiplication by the class of `r`. -/
theorem quotient_smul_mk {R : Type u} [CommRing R] (I : Ideal R) (r x : R) :
    r • (Ideal.Quotient.mk I x : R ⧸ I) = Ideal.Quotient.mk I (r * x) := by
  rw [Algebra.smul_def, map_mul]
  rfl

set_option maxHeartbeats 2000000 in
/-- An absolutely flat ring is von Neumann regular (one direction of Chapter 2, Exercise 27,
`(i) ⇒ (iv)`): apply the equational criterion for flatness to the relation `a · 1 = 0` in
`A ⧸ (a)`. -/
theorem vnr_of_absolutelyFlat {R : Type u} [CommRing R] (h : IsAbsolutelyFlat R) :
    IsVonNeumannRegular R := by
  intro a
  let I : Ideal R := Ideal.span {a}
  haveI : Module.Flat R (R ⧸ I) := h _
  have haI : a ∈ I := Ideal.subset_span (Set.mem_singleton a)
  have hsmul : a • (1 : R ⧸ I) = 0 := by
    have h1 : a • (Ideal.Quotient.mk I (1 : R)) = a • (1 : R ⧸ I) := by rw [map_one]
    rw [← h1, quotient_smul_mk, mul_one, Ideal.Quotient.eq_zero_iff_mem]
    exact haI
  have hrel : ∑ i : Fin 1, (fun _ : Fin 1 => a) i • (fun _ : Fin 1 => (1 : R ⧸ I)) i = 0 := by
    rw [Fin.sum_univ_one]
    exact hsmul
  obtain ⟨k, a', y, hy1, hy2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  choose b hb using fun j => Ideal.Quotient.mk_surjective (y j)
  have h2 : (1 : R ⧸ I) = Ideal.Quotient.mk I (∑ j, a' 0 j * b j) := by
    have hstart : (1 : R ⧸ I) = ∑ j, a' 0 j • y j := hy1 0
    rw [hstart, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← hb j, quotient_smul_mk]
  have hmem : (1 : R) - ∑ j, a' 0 j * b j ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, h2, sub_self]
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hmem
  have hS : a * ∑ j, a' 0 j * b j = 0 := by
    rw [Finset.mul_sum]
    refine Finset.sum_eq_zero fun j _ => ?_
    have hj := hy2 j
    simp only [Fin.sum_univ_one] at hj
    calc a * (a' 0 j * b j) = (a * a' 0 j) * b j := by ring
      _ = 0 := by rw [hj, zero_mul]
  have key : a = a * (1 - ∑ j, a' 0 j * b j) + a * ∑ j, a' 0 j * b j := by ring
  rw [hc, hS] at key
  refine ⟨c, key.trans ?_⟩
  ring

/-- **Exercise 3.30 in the book's own terms, one direction**: if `A/𝔑` is absolutely flat
then the Zariski and constructible topologies on `Spec A` coincide. -/
theorem zariski_eq_constructible_of_absolutelyFlat
    (h : IsAbsolutelyFlat (A ⧸ nilradical A)) :
    PrimeSpectrum.zariskiTopology (R := A) = constructibleTopology A :=
  (zariski_eq_constructible_iff_vnr A).mpr (vnr_of_absolutelyFlat h)

/-! ## Auditing the statement, and concrete examples -/

/-- The topology generated by the sets `X_f` as *open* sets alone is always the Zariski
topology (they form a basis).  So it is the "open **and closed**" requirement of
Exercise 3.28 ii that gives the constructible topology its content: read with the coarser
topology generated by the `X_f` as open sets only, the two sides of 3.30 would always agree
and the statement would fail. -/
theorem generateFrom_basicOpen_eq_zariski :
    TopologicalSpace.generateFrom (Set.range fun f : A =>
      (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum A))) =
        PrimeSpectrum.zariskiTopology (R := A) :=
  PrimeSpectrum.isTopologicalBasis_basic_opens.eq_generateFrom.symm

/-- In a field every prime ideal is maximal. -/
theorem isMaximal_of_isPrime_field (K : Type u) [Field K] (p : Ideal K) (hp : p.IsPrime) :
    p.IsMaximal := by
  refine Ideal.isMaximal_iff.mpr ⟨hp.one_notMem, ?_⟩
  intro J a _ hap haJ
  have ha0 : a ≠ 0 := fun h => hap (h ▸ Ideal.zero_mem p)
  have hunit : IsUnit a := isUnit_iff_ne_zero.mpr ha0
  have htop : J = ⊤ := J.eq_top_of_isUnit_mem haJ hunit
  rw [htop]; exact Submodule.mem_top

/-- **A field satisfies the hypothesis**: the Zariski and constructible topologies on
`Spec K` coincide. -/
example (K : Type u) [Field K] :
    PrimeSpectrum.zariskiTopology (R := K) = constructibleTopology K :=
  (zariski_eq_constructible_iff K).mpr fun p hp => isMaximal_of_isPrime_field K p hp

/-- **`ℤ` does not satisfy the hypothesis**, and indeed the two topologies differ: the zero
ideal is prime but not maximal, so `Spec ℤ` with the Zariski topology is not `T₁`, while the
constructible topology is Hausdorff. -/
example : PrimeSpectrum.zariskiTopology (R := ℤ) ≠ constructibleTopology ℤ := by
  intro h
  have hbot : (⊥ : Ideal ℤ).IsPrime := Ideal.isPrime_bot
  have hmax : (⊥ : Ideal ℤ).IsMaximal := (zariski_eq_constructible_iff ℤ).mp h ⊥ hbot
  have hne : Ideal.span {(2 : ℤ)} ≠ ⊤ := by
    intro htop
    have h1 : (1 : ℤ) ∈ Ideal.span {(2 : ℤ)} := by
      rw [htop]; simp
    rw [Ideal.mem_span_singleton] at h1
    obtain ⟨c, hc⟩ := h1
    omega
  have heq : (⊥ : Ideal ℤ) = Ideal.span {(2 : ℤ)} := hmax.eq_of_le hne bot_le
  have h2 : (2 : ℤ) ∈ (⊥ : Ideal ℤ) := by
    rw [heq]; exact Ideal.subset_span (Set.mem_singleton 2)
  rw [Ideal.mem_bot] at h2
  omega


/-! ## Completing Chapter 2, Exercise 27: von Neumann regular ⟹ absolutely flat -/

/-- The sum of two idempotent-generated principal ideals is generated by the idempotent
`e + f - e * f`. -/
theorem span_singleton_sup_span_singleton {R : Type u} [CommRing R] (e f : R)
    (he : e * e = e) (hf : f * f = f) :
    (e + f - e * f) * (e + f - e * f) = e + f - e * f ∧
      Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) =
        Ideal.span ({e + f - e * f} : Set R) := by
  constructor
  · have he' : (1 - e) * (1 - e) = 1 - e := by linear_combination he
    have hf' : (1 - f) * (1 - f) = 1 - f := by linear_combination hf
    have hg : ((1 - e) * (1 - f)) * ((1 - e) * (1 - f)) = (1 - e) * (1 - f) := by
      rw [mul_mul_mul_comm, he', hf']
    have hu : (e + f - e * f) = 1 - (1 - e) * (1 - f) := by ring
    rw [hu]
    linear_combination hg
  · refine le_antisymm ?_ ?_
    · rw [sup_le_iff]
      constructor
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨e, by linear_combination (f - 1) * he⟩
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨f, by linear_combination (e - 1) * hf⟩
    · rw [Ideal.span_singleton_le_iff_mem]
      have h1 : e ∈ Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) :=
        Submodule.mem_sup_left (Ideal.subset_span (Set.mem_singleton e))
      have h2 : f ∈ Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) :=
        Submodule.mem_sup_right (Ideal.subset_span (Set.mem_singleton f))
      have h3 : e * f ∈ Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) :=
        Ideal.mul_mem_left _ e h2
      exact sub_mem (add_mem h1 h2) h3

/-- In a von Neumann regular ring, every finitely generated ideal is generated by an
idempotent. -/
theorem exists_idempotent_span_finset {R : Type u} [CommRing R] (h : IsVonNeumannRegular R)
    (s : Finset R) : ∃ e : R, e * e = e ∧ Ideal.span ((s : Set R)) = Ideal.span {e} := by
  classical
  induction s using Finset.induction with
  | empty =>
      refine ⟨0, by ring, ?_⟩
      rw [Finset.coe_empty, Ideal.span_empty]
      refine le_antisymm bot_le ?_
      rw [Ideal.span_le]
      simp
  | insert a s ha ih =>
      obtain ⟨e, he, hspan_e⟩ := ih
      obtain ⟨y, hy⟩ := h a
      have hidem_a : (a * y) * (a * y) = a * y := by
        have h1 : a ^ 2 * y ^ 2 = a * y := by
          rw [show a ^ 2 * y ^ 2 = a ^ 2 * y * y from by ring, ← hy]
        rw [show a * y * (a * y) = a ^ 2 * y ^ 2 from by ring, h1]
      have hspan_a : Ideal.span ({(a : R)} : Set R) = Ideal.span ({a * y} : Set R) := by
        refine le_antisymm ?_ ?_
        · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
          refine ⟨a, ?_⟩
          rw [show a * y * a = a ^ 2 * y from by ring, ← hy]
        · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
          exact ⟨y, rfl⟩
      obtain ⟨hidem_u, hspan_u⟩ := span_singleton_sup_span_singleton (a * y) e hidem_a he
      refine ⟨a * y + e - (a * y) * e, hidem_u, ?_⟩
      rw [Finset.coe_insert, Ideal.span_insert, hspan_a, hspan_e, hspan_u]

/-- The ideal generated by a single element of a von Neumann regular ring is generated by an
idempotent. -/
theorem exists_idempotent_of_fg {R : Type u} [CommRing R] (h : IsVonNeumannRegular R)
    {I : Ideal R} (hI : I.FG) : ∃ e : R, e * e = e ∧ I = Ideal.span {e} := by
  obtain ⟨s, rfl⟩ := hI
  exact exists_idempotent_span_finset h s

/-- A von Neumann regular ring is absolutely flat (Chapter 2, Exercise 27, `(iv) ⇒ (i)`):
a finitely generated ideal is generated by an idempotent, hence is a direct summand of `R`,
so tensoring its inclusion with any module stays injective. -/
theorem absolutelyFlat_of_vnr {R : Type u} [CommRing R] (h : IsVonNeumannRegular R) :
    IsAbsolutelyFlat R := by
  intro M _ _
  rw [Module.Flat.iff_lTensor_injective]
  intro I hI
  obtain ⟨e, he, hspan⟩ := exists_idempotent_of_fg h hI
  rw [hspan]
  have hemem : e ∈ Ideal.span ({e} : Set R) := Ideal.subset_span (Set.mem_singleton e)
  have hfix : ∀ i : Ideal.span ({e} : Set R), e * (i : R) = (i : R) := by
    intro i
    have hi : (i : R) ∈ Ideal.span ({e} : Set R) := i.2
    rw [Ideal.mem_span_singleton] at hi
    obtain ⟨r, hr⟩ := hi
    rw [hr]
    calc e * (e * r) = (e * e) * r := by ring
      _ = e * r := by rw [he]
  let ρ : R →ₗ[R] Ideal.span ({e} : Set R) :=
    LinearMap.codRestrict _ (LinearMap.mulLeft R e) (fun a => by
      show e * a ∈ Ideal.span ({e} : Set R)
      exact Ideal.mem_span_singleton.mpr ⟨a, rfl⟩)
  have hcomp : ρ.comp (Ideal.span ({e} : Set R)).subtype = LinearMap.id := by
    ext i
    exact hfix i
  have hleft : (ρ.lTensor M).comp ((Ideal.span ({e} : Set R)).subtype.lTensor M) =
      LinearMap.id := by
    rw [← LinearMap.lTensor_comp, hcomp, LinearMap.lTensor_id]
  exact Function.LeftInverse.injective (g := ρ.lTensor M) (fun x => LinearMap.congr_fun hleft x)

/-- **Chapter 2, Exercise 27**: a commutative ring is absolutely flat if and only if it is
von Neumann regular. -/
theorem isAbsolutelyFlat_iff_vnr {R : Type u} [CommRing R] :
    IsAbsolutelyFlat R ↔ IsVonNeumannRegular R :=
  ⟨vnr_of_absolutelyFlat, absolutelyFlat_of_vnr⟩

/-- **Exercise 3.30, in the book's own terms**: the Zariski topology and the constructible
topology on `Spec A` coincide if and only if `A/𝔑` is absolutely flat. -/
theorem zariski_eq_constructible_iff_absolutelyFlat :
    PrimeSpectrum.zariskiTopology (R := A) = constructibleTopology A ↔
      IsAbsolutelyFlat (A ⧸ nilradical A) := by
  rw [zariski_eq_constructible_iff_vnr, isAbsolutelyFlat_iff_vnr]


/-- **Exercise 3.30** (Atiyah–Macdonald), the main result: the Zariski topology and the
constructible topology on `Spec A` coincide if and only if `A/𝔑` is absolutely flat. -/
theorem solution :
    PrimeSpectrum.zariskiTopology (R := A) = constructibleTopology A ↔
      IsAbsolutelyFlat (A ⧸ nilradical A) :=
  zariski_eq_constructible_iff_absolutelyFlat A

end AtiyahMcdonald69.Ex_3_30
