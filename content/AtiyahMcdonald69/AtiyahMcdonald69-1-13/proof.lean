/-
Atiyah–Macdonald, *Introduction to Commutative Algebra*, Chapter 1, Exercise 1.13:

  "Given a field `K`, construct an algebraic closure of `K`" (E. Artin's construction).

Formalization of the construction.  Let `Σ` be the set of monic irreducible polynomials over
`K`, and let `A = K[x_{f,i}]` be the polynomial ring with one indeterminate `x_{f,i}` for each
`f ∈ Σ` and each `i < deg f`.  Let `𝔞 ⊆ A` be the ideal generated by all the coefficients of
the polynomials `f - ∏_{i < deg f} (X - x_{f,i})`, and let `𝔪 ⊇ 𝔞` be a maximal ideal.

* `𝔞 ≠ ⊤`: for a *finite* set of polynomials one needs a field in which they all split; we use
  `Polynomial.SplittingField` of their product (the "successively adjoin roots" step of the
  informal argument).
* Hence `L = A / 𝔪` is a field, a `K`-algebra, and every `f ∈ Σ` splits over `L`:
  `f = ∏_{i} (X - x_{f,i})` in `L[X]`.
* Each `x_{f,i}` is a root of the monic polynomial `f`, hence is algebraic over `K`, and `L` is
  generated by these elements over `K`, so `L / K` is algebraic.
* An algebraic extension of `K` over which every monic irreducible polynomial splits is an
  algebraic closure of `K` (`IsAlgClosure.of_splits`).

The first stage of the informal iteration is also formalized (Section "The first stage `K₁`"):
with one indeterminate `x_f` per `f ∈ Σ`,
`K₁ = K[x_f : f ∈ Σ] / 𝔪`, where `𝔪` contains all the elements `f(x_f)`, is a field in which
every `f ∈ Σ` has a root (`artinRootField_exists_root`).

The informal solution (Adam Allan, *Solutions to Atiyah Macdonald*, Exercise 1.13, and the
natural proof at https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-1-13)
iterates "adjoin one root of every irreducible polynomial" countably many times and then passes
to the algebraic part of the union.  The single-step *simultaneous splitting* variant used here
is the standard reformulation of the same construction (all roots are adjoined at once); the
resulting field is already algebraic over `K`, so the countable iteration and the final pass to
the algebraic part become unnecessary.  The statement proved is unchanged:

  For every field `K` there is a field `L` with a `K`-algebra structure such that `L` is
  algebraic over `K` and algebraically closed (`solution`, `solution_isAlgClosure`).
-/
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Data.Multiset.Fintype
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.FieldTheory.SplittingField.Construction
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations

open Polynomial
open scoped Classical

noncomputable section

namespace AtiyahMcdonald69.Ex_1_13

universe u

/-! ### The polynomial ring of Artin's construction -/

/-- `Σ`: the set of monic irreducible polynomials over `K`. -/
abbrev ArtinIndex (K : Type*) [Field K] : Type _ := { f : K[X] // f.Monic ∧ Irreducible f }

/-- The indeterminates `x_{f,i}` of the construction, indexed by `f ∈ Σ` and `i < deg f`. -/
abbrev ArtinVars (K : Type*) [Field K] : Type _ :=
  Σ f : ArtinIndex K, Fin (f : K[X]).natDegree

/-- `K[x_{f,i}]`, the polynomial ring of Artin's construction. -/
abbrev ArtinRing (K : Type*) [Field K] : Type _ := MvPolynomial (ArtinVars K) K

variable {K : Type*} [Field K]

/-- The indeterminate `x_{f,i}`. -/
def artinX (f : ArtinIndex K) (i : Fin (f : K[X]).natDegree) : ArtinRing K :=
  MvPolynomial.X ⟨f, i⟩

/-- The relation `f = ∏_{i < deg f} (X - x_{f,i})`, viewed in `K[x_{f,i}][X]`. -/
def artinRel (f : ArtinIndex K) : (ArtinRing K)[X] :=
  (f : K[X]).map (algebraMap K (ArtinRing K)) - ∏ i, (X - C (artinX f i))

/-- The ideal `𝔞` generated by all the coefficients of the relations `f = ∏ᵢ (X - x_{f,i})`. -/
def artinIdeal (K : Type*) [Field K] : Ideal (ArtinRing K) :=
  Ideal.span (Set.range fun p : ArtinIndex K × ℕ => (artinRel p.1).coeff p.2)

/-! ### Roots of finitely many irreducible polynomials

For the properness of `𝔞` we need one finitary input, taken for granted in the informal proof
("successively adjoin roots"): for finitely many monic irreducible polynomials there is a field
extension in which they all split.  `Polynomial.SplittingField` of their product provides it,
together with an enumeration of the roots of each of them by `Fin (deg f)`.
-/

/-- The product of a finite set of elements of `Σ`. -/
abbrev artinProd (s : Finset (ArtinIndex K)) : K[X] := ∏ g ∈ s, (g : K[X])

/-- A splitting field of a finite set of elements of `Σ`. -/
abbrev artinSplit (s : Finset (ArtinIndex K)) : Type _ := SplittingField (artinProd s)

/-- Every element of `Σ` splits in the splitting field of a finite product of elements of `Σ`. -/
theorem artin_splits_prod {s : Finset (ArtinIndex K)} {f : ArtinIndex K} (hf : f ∈ s) :
    ((f : K[X]).map (algebraMap K (artinSplit s))).Splits := by
  refine (splits_prod_iff (f := fun g : ArtinIndex K =>
    (g : K[X]).map (algebraMap K (artinSplit s))) ?_).mp ?_ f hf
  · intro g _
    exact map_ne_zero g.2.1.ne_zero
  · simpa [artinProd, Polynomial.map_prod] using SplittingField.splits (artinProd s)

/-- For a monic irreducible `f` which splits over an extension `L`, an enumeration by
`Fin (deg f)` of its roots counted with multiplicity. -/
def artinRootEquiv {L : Type*} [Field L] [DecidableEq L] (i : K →+* L) {f : ArtinIndex K}
    (hf : ((f : K[X]).map i).Splits) :
    Fin (f : K[X]).natDegree ≃ ↥(((f : K[X]).map i).roots.toEnumFinset) :=
  .symm <| Finset.equivFinOfCardEq <| by
    rwa [splits_iff_card_roots, ← Multiset.card_toEnumFinset, f.2.1.natDegree_map] at hf

/-- Evaluation of the polynomial ring in the splitting field of a finite product of elements
of `Σ`, sending `x_{f,i}` to the `i`-th root of `f`. -/
def artinToSplittingField (s : Finset (ArtinIndex K)) : ArtinRing K →ₐ[K] artinSplit s :=
  MvPolynomial.aeval fun v : ArtinVars K =>
    if h : v.1 ∈ s then ((artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h))
      v.2).1.1
    else 0

/-- The value of the evaluation map on the indeterminate `x_{f,i}`. -/
theorem artinToSplittingField_X {s : Finset (ArtinIndex K)} (f : ArtinIndex K)
    (i : Fin (f : K[X]).natDegree) :
    (artinToSplittingField s : ArtinRing K →+* artinSplit s) (artinX f i) =
      if h : f ∈ s then
        ((artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h)) i).1.1
      else 0 := by
  simp only [artinToSplittingField, artinX, AlgHom.coe_toRingHom, MvPolynomial.aeval_X]

/-- The product of the linear factors cut out by the enumerated roots of `f` is `f` itself,
in the splitting field of a finite product of elements of `Σ` containing `f`. -/
theorem artin_prod_roots_eq {s : Finset (ArtinIndex K)} {f : ArtinIndex K} (h : f ∈ s) :
    (∏ i : Fin (f : K[X]).natDegree,
        (X - C ((artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h)) i).1.1))
      = (f : K[X]).map (algebraMap K (artinSplit s)) := by
  classical
  rw [Fintype.prod_equiv (artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h))
    (fun i : Fin (f : K[X]).natDegree =>
      X - C ((artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h)) i).1.1)
    (fun x => X - C x.1.1) (fun _ => rfl)]
  rw [Finset.prod_coe_sort (f := fun x : artinSplit s × ℕ => X - C x.1)]
  rw [Multiset.prod_toEnumFinset ((f : K[X]).map (algebraMap K (artinSplit s))).roots
    (fun a (_ : ℕ) => (X - C a : (artinSplit s)[X]))]
  have hmapuniv : (∏ x : ((f : K[X]).map (algebraMap K (artinSplit s))).roots,
        (X - C (x : artinSplit s)))
      = (((f : K[X]).map (algebraMap K (artinSplit s))).roots.map (fun y => X - C y)).prod := by
    rw [← Multiset.map_univ ((f : K[X]).map (algebraMap K (artinSplit s))).roots
      (fun y => (X - C y : (artinSplit s)[X]))]
    rfl
  rw [hmapuniv]
  exact (Splits.eq_prod_roots_of_monic (artin_splits_prod h) (f.2.1.map _)).symm

/-- The relation `f = ∏ᵢ (X - x_{f,i})` vanishes in the splitting field of a finite product
containing `f`. -/
theorem artinRel_map_toSplittingField {s : Finset (ArtinIndex K)} {f : ArtinIndex K}
    (h : f ∈ s) :
    (artinRel f).map (artinToSplittingField s : ArtinRing K →+* artinSplit s) = 0 := by
  classical
  have h1 : ((f : K[X]).map (algebraMap K (ArtinRing K))).map
      (artinToSplittingField s : ArtinRing K →+* artinSplit s)
      = (f : K[X]).map (algebraMap K (artinSplit s)) := by
    rw [Polynomial.map_map]
    congr 1
    ext a
    simp [artinToSplittingField]
  have h2 : (∏ i : Fin (f : K[X]).natDegree, (X - C (artinX f i))).map
      (artinToSplittingField s : ArtinRing K →+* artinSplit s)
      = ∏ i : Fin (f : K[X]).natDegree,
          (X - C ((artinRootEquiv (algebraMap K (artinSplit s)) (artin_splits_prod h)) i).1.1) := by
    rw [Polynomial.map_prod]
    exact Finset.prod_congr rfl fun i _ => by
      rw [Polynomial.map_sub, map_X, map_C, artinToSplittingField_X, dif_pos h]
  rw [artinRel, Polynomial.map_sub, h1, h2, sub_eq_zero]
  exact (artin_prod_roots_eq h).symm

/-- The generators of `𝔞` vanish in the splitting field of a finite product containing `f`. -/
theorem artinToSplittingField_coeff {s : Finset (ArtinIndex K)} {f : ArtinIndex K}
    (h : f ∈ s) (n : ℕ) : artinToSplittingField s ((artinRel f).coeff n) = 0 := by
  show (artinToSplittingField s : ArtinRing K →+* artinSplit s) ((artinRel f).coeff n) = 0
  rw [← coeff_map (artinToSplittingField s : ArtinRing K →+* artinSplit s) n,
    artinRel_map_toSplittingField h, coeff_zero]

/-! ### The ideal is proper -/

/-- **The ideal `𝔞` is proper.**  Otherwise `1` would be a finite linear combination of the
generators, and evaluating it in a splitting field of the finitely many polynomials involved
would give `1 = 0`. -/
theorem artinIdeal_ne_top : artinIdeal K ≠ ⊤ := by
  rw [Ideal.ne_top_iff_one, artinIdeal, Ideal.span, ← Set.image_univ,
    Finsupp.mem_span_image_iff_linearCombination]
  rintro ⟨v, -, hv⟩
  classical
  replace hv := congr_arg (artinToSplittingField (v.support.image Prod.fst)) hv
  rw [map_one, Finsupp.linearCombination_apply, Finsupp.sum, map_sum, Finset.sum_eq_zero] at hv
  · exact zero_ne_one hv
  intro j hj
  rw [smul_eq_mul, map_mul, artinToSplittingField_coeff (Finset.mem_image_of_mem _ hj), mul_zero]

/-! ### The quotient field -/

/-- A maximal ideal of `K[x_{f,i}]` containing the ideal `𝔞`. -/
def artinMaxIdeal (K : Type*) [Field K] : Ideal (ArtinRing K) :=
  Classical.choose (Ideal.exists_le_maximal (artinIdeal K) (artinIdeal_ne_top (K := K)))

instance artinMaxIdeal_isMaximal (K : Type*) [Field K] : (artinMaxIdeal K).IsMaximal :=
  (Classical.choose_spec (Ideal.exists_le_maximal (artinIdeal K)
    (artinIdeal_ne_top (K := K)))).1

/-- The ideal `𝔞` is contained in the chosen maximal ideal. -/
theorem artinIdeal_le_maxIdeal (K : Type*) [Field K] : artinIdeal K ≤ artinMaxIdeal K :=
  (Classical.choose_spec (Ideal.exists_le_maximal (artinIdeal K)
    (artinIdeal_ne_top (K := K)))).2

/-- The field `L = K[x_{f,i}] / 𝔪` of Artin's construction. -/
abbrev ArtinClosure (K : Type*) [Field K] : Type _ := ArtinRing K ⧸ artinMaxIdeal K

instance artinClosure_field (K : Type*) [Field K] : Field (ArtinClosure K) :=
  Ideal.Quotient.field (artinMaxIdeal K)

/-- In `L` the relation `f = ∏ᵢ (X - x_{f,i})` holds for every `f ∈ Σ`. -/
theorem artinClosure_map_eq_prod (f : ArtinIndex K) :
    (f : K[X]).map (algebraMap K (ArtinClosure K)) =
      ∏ i, (X - C (Ideal.Quotient.mk (artinMaxIdeal K) (artinX f i))) := by
  classical
  have hD : (artinRel f).map
        (Ideal.Quotient.mk (artinMaxIdeal K) : ArtinRing K →+* ArtinClosure K) = 0 := by
    ext n
    rw [coeff_map, coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact artinIdeal_le_maxIdeal K (Ideal.subset_span ⟨⟨f, n⟩, rfl⟩)
  have hA : (f : K[X]).map (algebraMap K (ArtinClosure K))
      = ((f : K[X]).map (algebraMap K (ArtinRing K))).map
          (Ideal.Quotient.mk (artinMaxIdeal K) : ArtinRing K →+* ArtinClosure K) := by
    rw [Polynomial.map_map, Ideal.Quotient.mk_comp_algebraMap]
  have hB : (∏ i : Fin (f : K[X]).natDegree, (X - C (artinX f i))).map
        (Ideal.Quotient.mk (artinMaxIdeal K) : ArtinRing K →+* ArtinClosure K)
      = ∏ i, (X - C (Ideal.Quotient.mk (artinMaxIdeal K) (artinX f i))) := by
    rw [Polynomial.map_prod]
    exact Finset.prod_congr rfl fun i _ => by rw [Polynomial.map_sub, map_X, map_C]
  rw [hA, ← hB, ← sub_eq_zero, ← Polynomial.map_sub, ← artinRel, hD]

/-- Every element of `Σ` splits over `L`. -/
theorem artinClosure_splits (f : ArtinIndex K) :
    ((f : K[X]).map (algebraMap K (ArtinClosure K))).Splits := by
  rw [artinClosure_map_eq_prod f]
  exact Splits.prod fun i _ => Splits.X_sub_C _

/-! ### `L` is algebraic over `K` -/

/-- The image in `L` of any element of `K[x_{f,i}]` is integral over `K`. -/
theorem artinClosure_isIntegral_mk (p : ArtinRing K) :
    IsIntegral K (Ideal.Quotient.mk (artinMaxIdeal K) p) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a =>
      show IsIntegral K (Ideal.Quotient.mk (artinMaxIdeal K) (MvPolynomial.C a))
      exact isIntegral_algebraMap
  | add p q hp hq =>
      rw [map_add]
      exact hp.add hq
  | mul_X p v hp =>
      rw [map_mul]
      obtain ⟨f, i⟩ := v
      refine hp.mul ⟨(f : K[X]), f.2.1, ?_⟩
      have h := congr_arg
        (Polynomial.eval (Ideal.Quotient.mk (artinMaxIdeal K) (artinX f i)))
        (artinClosure_map_eq_prod (K := K) f)
      simp only [Polynomial.eval_map_algebraMap, Polynomial.eval_prod, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C] at h
      have hroot : Polynomial.aeval (Ideal.Quotient.mk (artinMaxIdeal K) (artinX f i)) (f : K[X])
          = 0 := by
        rw [h]
        exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp)
      simpa [artinX, Polynomial.aeval_def] using hroot

/-- **`L` is algebraic over `K`.** -/
theorem artinClosure_isAlgebraic (K : Type*) [Field K] :
    Algebra.IsAlgebraic K (ArtinClosure K) := by
  refine ⟨fun z => ?_⟩
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (I := artinMaxIdeal K) z
  rw [← hp]
  exact (artinClosure_isIntegral_mk p).isAlgebraic

instance artinClosure_algebraic (K : Type*) [Field K] : Algebra.IsAlgebraic K (ArtinClosure K) :=
  artinClosure_isAlgebraic K

/-! ### `L` is an algebraic closure of `K` -/

/-- **`L = K[x_{f,i}]/𝔪` is an algebraic closure of `K`.**  It is algebraic over `K` and every
monic irreducible polynomial over `K` splits in it. -/
theorem artinClosure_isAlgClosure (K : Type*) [Field K] : IsAlgClosure K (ArtinClosure K) :=
  IsAlgClosure.of_splits fun p hpmonic hpirr => artinClosure_splits ⟨p, hpmonic, hpirr⟩

instance artinClosure_isAlgClosed (K : Type*) [Field K] : IsAlgClosed (ArtinClosure K) :=
  (artinClosure_isAlgClosure K).isAlgClosed

/-- Every polynomial over `K` splits over `L` (the conclusion drawn in the informal
solution: every monic polynomial over `K` is a product of linear factors `X - x_{f,i}`). -/
theorem artinClosure_splits_all (p : K[X]) :
    (p.map (algebraMap K (ArtinClosure K))).Splits :=
  (artinClosure_isAlgClosure K).isAlgClosed.splits _

/-- Every non-constant polynomial over `K` has a root in `L`. -/
theorem artinClosure_exists_root (p : K[X]) (hp : p.degree ≠ 0) :
    ∃ x : ArtinClosure K, (p.map (algebraMap K (ArtinClosure K))).IsRoot x :=
  IsAlgClosed.exists_root _ (by rwa [Polynomial.degree_map])

/-- `L` is a genuine field extension of `K`: the structure map is injective. -/
theorem artinClosure_algebraMap_injective : Function.Injective (algebraMap K (ArtinClosure K)) :=
  RingHom.injective _

/-- The algebraic part of `L` is `L` itself: the final step of the informal solution (passing
to the elements algebraic over `K`) is the identity for this construction. -/
theorem algebraicClosure_eq_top : algebraicClosure K (ArtinClosure K) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  rw [mem_algebraicClosure_iff]
  exact Algebra.IsAlgebraic.isAlgebraic x

/-! ### The first stage `K₁` of the informal iteration

The informal proof first builds a field in which every monic irreducible polynomial over `K`
has *one* root, by adjoining one indeterminate `x_f` per `f ∈ Σ` and dividing by a maximal ideal
containing all the elements `f(x_f)`.  That first stage is recorded here as well, together with
its root property, so that both stages of the informal argument are available explicitly.
-/

/-- `K[x_f : f ∈ Σ]`: one indeterminate `x_f` for each `f ∈ Σ`. -/
abbrev ArtinRootRing (K : Type*) [Field K] : Type _ := MvPolynomial (ArtinIndex K) K

/-- The element `f(x_f)`. -/
def artinRootPoly (f : ArtinIndex K) : ArtinRootRing K :=
  Polynomial.aeval (MvPolynomial.X f) (f : K[X])

/-- The ideal generated by the elements `f(x_f)`, `f ∈ Σ`. -/
def artinRootIdeal (K : Type*) [Field K] : Ideal (ArtinRootRing K) :=
  Ideal.span (Set.range (artinRootPoly (K := K)))

/-- A root of `f` in a splitting field of a finite set of elements of `Σ` containing `f`. -/
noncomputable def artinRootChoice {s : Finset (ArtinIndex K)} {f : ArtinIndex K} (h : f ∈ s) :
    artinSplit s :=
  ((artin_splits_prod h).exists_eval_eq_zero (by
    rw [Polynomial.degree_map]
    exact degree_ne_of_natDegree_ne f.2.2.natDegree_pos.ne')).choose

/-- Specification of the chosen root. -/
theorem artinRootChoice_spec {s : Finset (ArtinIndex K)} {f : ArtinIndex K} (h : f ∈ s) :
    Polynomial.eval (artinRootChoice h) ((f : K[X]).map (algebraMap K (artinSplit s))) = 0 :=
  ((artin_splits_prod h).exists_eval_eq_zero (by
    rw [Polynomial.degree_map]
    exact degree_ne_of_natDegree_ne f.2.2.natDegree_pos.ne')).choose_spec

/-- Evaluation of `K[x_f]` in the splitting field of a finite set, sending `x_f` to a root of `f`
for `f` in the set and to `0` otherwise. -/
def artinRootToSplit (s : Finset (ArtinIndex K)) : ArtinRootRing K →ₐ[K] artinSplit s :=
  MvPolynomial.aeval fun f : ArtinIndex K => if h : f ∈ s then artinRootChoice h else 0

/-- The value of the evaluation map on the indeterminate `x_f`. -/
theorem artinRootToSplit_X {s : Finset (ArtinIndex K)} (f : ArtinIndex K) :
    artinRootToSplit s (MvPolynomial.X f) = if h : f ∈ s then artinRootChoice h else 0 := by
  simp only [artinRootToSplit, MvPolynomial.aeval_X]

/-- The generators `f(x_f)` vanish after evaluation. -/
theorem artinRootToSplit_poly {s : Finset (ArtinIndex K)} {f : ArtinIndex K} (h : f ∈ s) :
    artinRootToSplit s (artinRootPoly f) = 0 := by
  rw [artinRootPoly,
    ← Polynomial.aeval_algHom_apply (artinRootToSplit s) (MvPolynomial.X f) (f : K[X]),
    artinRootToSplit_X, dif_pos h, ← Polynomial.eval_map_algebraMap]
  exact artinRootChoice_spec h

/-- **The ideal generated by the `f(x_f)` is proper.**  A hypothetical identity
`1 = Σ g_f f(x_f)` involves only finitely many `f`, and evaluating it at a root of each of them
in a common splitting field would give `1 = 0`. -/
theorem artinRootIdeal_ne_top (K : Type*) [Field K] : artinRootIdeal K ≠ ⊤ := by
  rw [Ideal.ne_top_iff_one, artinRootIdeal, Ideal.span, ← Set.image_univ,
    Finsupp.mem_span_image_iff_linearCombination]
  rintro ⟨v, -, hv⟩
  classical
  replace hv := congr_arg (artinRootToSplit v.support) hv
  rw [map_one, Finsupp.linearCombination_apply, Finsupp.sum, map_sum, Finset.sum_eq_zero] at hv
  · exact zero_ne_one hv
  intro j hj
  rw [smul_eq_mul, map_mul, artinRootToSplit_poly hj, mul_zero]

/-- A maximal ideal containing all the elements `f(x_f)`. -/
def artinRootMaxIdeal (K : Type*) [Field K] : Ideal (ArtinRootRing K) :=
  Classical.choose (Ideal.exists_le_maximal (artinRootIdeal K) (artinRootIdeal_ne_top K))

instance artinRootMaxIdeal_isMaximal (K : Type*) [Field K] : (artinRootMaxIdeal K).IsMaximal :=
  (Classical.choose_spec (Ideal.exists_le_maximal (artinRootIdeal K)
    (artinRootIdeal_ne_top K))).1

theorem artinRootIdeal_le_maxIdeal (K : Type*) [Field K] :
    artinRootIdeal K ≤ artinRootMaxIdeal K :=
  (Classical.choose_spec (Ideal.exists_le_maximal (artinRootIdeal K)
    (artinRootIdeal_ne_top K))).2

/-- The first stage `K₁ = K[x_f]/𝔪` of the informal iteration. -/
abbrev ArtinRootField (K : Type*) [Field K] : Type _ := ArtinRootRing K ⧸ artinRootMaxIdeal K

instance artinRootField_field (K : Type*) [Field K] : Field (ArtinRootField K) :=
  Ideal.Quotient.field (artinRootMaxIdeal K)

/-- **Every `f ∈ Σ` has a root in `K₁`.**  This is the property of the first stage of the
informal construction. -/
theorem artinRootField_exists_root (f : ArtinIndex K) :
    ∃ x : ArtinRootField K, (f : K[X]).eval₂ (algebraMap K (ArtinRootField K)) x = 0 := by
  refine ⟨(Ideal.Quotient.mkₐ K (artinRootMaxIdeal K)) (MvPolynomial.X f), ?_⟩
  have h : Polynomial.aeval ((Ideal.Quotient.mkₐ K (artinRootMaxIdeal K)) (MvPolynomial.X f))
        (f : K[X]) = Ideal.Quotient.mk (artinRootMaxIdeal K) (artinRootPoly f) := by
    rw [artinRootPoly,
      Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ K (artinRootMaxIdeal K))
        (MvPolynomial.X f) (f : K[X]),
      Ideal.Quotient.mkₐ_eq_mk]
  show Polynomial.aeval ((Ideal.Quotient.mkₐ K (artinRootMaxIdeal K)) (MvPolynomial.X f))
    (f : K[X]) = 0
  rw [h, Ideal.Quotient.eq_zero_iff_mem]
  exact artinRootIdeal_le_maxIdeal K (Ideal.subset_span ⟨f, rfl⟩)

/-! ### The exercise -/

/-- **Atiyah–Macdonald, Chapter 1, Exercise 1.13** (E. Artin): every field has an algebraic
closure.  The field constructed above is `ArtinClosure K`. -/
theorem solution (K : Type u) [Field K] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L), Algebra.IsAlgebraic K L ∧ IsAlgClosed L :=
  ⟨ArtinClosure K, artinClosure_field K, inferInstance, artinClosure_isAlgebraic K,
    (artinClosure_isAlgClosure K).isAlgClosed⟩

/-- The concrete form of the construction: an algebraic closure of `K` in which the roots of
every monic irreducible polynomial `f` are the images of the indeterminates `x_{f,i}`. -/
theorem solution_explicit (K : Type u) [Field K] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L)
      (x : ∀ f : ArtinIndex K, Fin (f : K[X]).natDegree → L),
      Algebra.IsAlgebraic K L ∧ IsAlgClosed L ∧
        ∀ f : ArtinIndex K, (f : K[X]).map (algebraMap K L) = ∏ i, (X - C (x f i)) :=
  ⟨ArtinClosure K, artinClosure_field K, inferInstance,
    fun f i => Ideal.Quotient.mk (artinMaxIdeal K) (artinX f i),
    artinClosure_isAlgebraic K, (artinClosure_isAlgClosure K).isAlgClosed,
    fun f => artinClosure_map_eq_prod f⟩

/-- The same statement for the typeclass `IsAlgClosure`. -/
theorem solution_isAlgClosure (K : Type u) [Field K] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L), IsAlgClosure K L :=
  ⟨ArtinClosure K, artinClosure_field K, inferInstance, artinClosure_isAlgClosure K⟩

end AtiyahMcdonald69.Ex_1_13

