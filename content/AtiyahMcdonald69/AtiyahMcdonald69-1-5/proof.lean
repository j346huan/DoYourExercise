/-
Atiyah–Macdonald, *Introduction to Commutative Algebra* (Addison–Wesley, 1969),
Chapter 1, Exercise 5.

Let `A` be a ring and let `A⟦X⟧` be the ring of formal power series
`f = Σ_{n≥0} aₙ Xⁿ` with coefficients in `A`.  The exercise asks for:

(i)   `f` is a unit in `A⟦X⟧` if and only if `a₀` is a unit in `A`;
(ii)  if `f` is nilpotent then every `aₙ` is nilpotent; the converse is false
      (the explicit counterexample `counterSeries` below has all coefficients
      nilpotent and is not nilpotent);
(iii) `f` belongs to the Jacobson radical `J(A⟦X⟧)` if and only if `a₀ ∈ J(A)`;
(iv)  the contraction `mᶜ` of a maximal ideal `m` of `A⟦X⟧` is a maximal ideal
      of `A`, and `m` is generated by `mᶜ` and `X`;
(v)   every prime ideal `p` of `A` is the contraction of a prime ideal of `A⟦X⟧`.

Statement cross-checked against A. Allan, "Solutions to Atiyah–Macdonald",
Exercise 1.5 (Chapter 1); see also
https://j346huan.github.io/DoYourExercise/#/problem/AtiyahMcdonald69-1-5
-/
import Mathlib

namespace AtiyahMcdonald69.Ex_1_5

noncomputable section

open PowerSeries

variable {A : Type*} [CommRing A]

/-! ## Exercise 1.5 (i): units of `A⟦X⟧` -/

/-- **Exercise 1.5 (i).** For `f = Σ aₙ Xⁿ ∈ A⟦X⟧`, `f` is a unit in `A⟦X⟧`
if and only if `a₀ = coeff 0 f` is a unit in `A`. -/
theorem part_i (f : A⟦X⟧) : IsUnit f ↔ IsUnit (PowerSeries.coeff 0 f) := by
  rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]
  exact PowerSeries.isUnit_iff_constantCoeff

/-! ## Preparation for (iii), (iv), (v) -/

/-- The Jacobson radical is the set of `x` such that `x * y + 1` is a unit for
every `y`. -/
private lemma mem_jacobson_iff (x : A) :
    x ∈ Ring.jacobson A ↔ ∀ y : A, IsUnit (x * y + 1) := by
  rw [← Ideal.jacobson_bot, Ideal.mem_jacobson_bot]

/-- **Exercise 1.5 (iii).** `f ∈ J(A⟦X⟧)` if and only if `a₀ = coeff 0 f ∈ J(A)`. -/
theorem part_iii (f : A⟦X⟧) :
    f ∈ Ring.jacobson A⟦X⟧ ↔ PowerSeries.coeff 0 f ∈ Ring.jacobson A := by
  rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]
  constructor
  · intro hf
    rw [mem_jacobson_iff] at hf ⊢
    intro b
    have h1 : IsUnit (f * PowerSeries.C b + 1) := hf (PowerSeries.C b)
    have h2 := PowerSeries.isUnit_iff_constantCoeff.mp h1
    simpa using h2
  · intro hf
    rw [mem_jacobson_iff] at hf ⊢
    intro g
    have h1 : IsUnit (PowerSeries.constantCoeff f * PowerSeries.constantCoeff g + 1) :=
      hf (PowerSeries.constantCoeff g)
    exact PowerSeries.isUnit_iff_constantCoeff.mpr (by simpa using h1)

/-- The variable `X` belongs to every maximal ideal of `A⟦X⟧` (it lies in the
Jacobson radical by (iii), since its constant coefficient is `0`). -/
private lemma X_mem_of_isMaximal {m : Ideal A⟦X⟧} (hm : m.IsMaximal) :
    PowerSeries.X ∈ m := by
  have h : PowerSeries.X ∈ Ring.jacobson A⟦X⟧ := by
    rw [part_iii]
    simp
  have hle : Ring.jacobson A⟦X⟧ ≤ m := by
    rw [Ring.jacobson_eq_sInf_isMaximal]
    exact sInf_le hm
  exact hle h

/-! ## Exercise 1.5 (iv): maximal ideals of `A⟦X⟧` and their contractions -/

/-- **Exercise 1.5 (iv), first part.** The contraction of a maximal ideal `m` of
`A⟦X⟧` is a maximal ideal of `A`. -/
theorem part_iv_contraction {m : Ideal A⟦X⟧} (hm : m.IsMaximal) :
    (Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) m).IsMaximal := by
  have hX : PowerSeries.X ∈ m := X_mem_of_isMaximal hm
  rw [Ideal.isMaximal_iff]
  refine ⟨?_, ?_⟩
  · intro h1
    have hmem : (1 : A⟦X⟧) ∈ m := by
      have h := (Ideal.mem_comap (f := (PowerSeries.C : A →+* A⟦X⟧)) (K := m)).mp h1
      simpa using h
    exact hm.ne_top ((Ideal.eq_top_iff_one m).mpr hmem)
  · intro J x hJ hx hxJ
    have hCx : (PowerSeries.C x : A⟦X⟧) ∉ m := fun h =>
      hx ((Ideal.mem_comap (f := (PowerSeries.C : A →+* A⟦X⟧)) (K := m)).mpr h)
    obtain ⟨y, i, hi, hy⟩ := hm.exists_inv hCx
    set b : A := PowerSeries.constantCoeff y with hb
    set g : A⟦X⟧ := PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) y) with hg
    have hyeq : y = PowerSeries.X * g + PowerSeries.C b := by
      rw [hb, hg]
      exact PowerSeries.eq_X_mul_shift_add_const y
    have key : (1 : A⟦X⟧) - PowerSeries.C (b * x) = (PowerSeries.X * g) * PowerSeries.C x + i := by
      rw [map_mul, ← hy, hyeq]
      ring
    have hmem : (1 : A⟦X⟧) - PowerSeries.C (b * x) ∈ m := by
      rw [key]
      have h1 : (PowerSeries.X * g) * PowerSeries.C x ∈ m := by
        simpa [mul_assoc, mul_comm, mul_left_comm] using m.mul_mem_left (g * PowerSeries.C x) hX
      exact m.add_mem h1 hi
    have hp : (1 : A) - b * x ∈ Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) m := by
      rw [Ideal.mem_comap]
      have hC : (PowerSeries.C : A →+* A⟦X⟧) ((1 : A) - b * x) =
          1 - PowerSeries.C (b * x) := by
        rw [map_sub, map_mul, map_one]
      rw [hC]
      exact hmem
    have hJ1 : (1 : A) - b * x ∈ J := hJ hp
    have hJ2 : b * x ∈ J := J.mul_mem_left b hxJ
    have hsum : b * x + ((1 : A) - b * x) ∈ J := J.add_mem hJ2 hJ1
    have hone : b * x + ((1 : A) - b * x) = 1 := by ring
    rwa [hone] at hsum

/-- **Exercise 1.5 (iv), second part.** A maximal ideal `m` of `A⟦X⟧` is
generated by its contraction `mᶜ` and by `X`. -/
theorem part_iv_generated {m : Ideal A⟦X⟧} (hm : m.IsMaximal) :
    m = Ideal.map (PowerSeries.C : A →+* A⟦X⟧) (Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) m)
      ⊔ Ideal.span {PowerSeries.X} := by
  have hX : PowerSeries.X ∈ m := X_mem_of_isMaximal hm
  refine le_antisymm ?_ ?_
  · intro f hf
    have hf_eq : f = PowerSeries.C (PowerSeries.constantCoeff f) +
        PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) :=
      (PowerSeries.eq_X_mul_shift_add_const f).trans (add_comm _ _)
    have hXg : PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) ∈ m := by
      simpa [mul_assoc, mul_comm, mul_left_comm] using
        m.mul_mem_left (PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f)) hX
    have hCa : PowerSeries.C (PowerSeries.constantCoeff f) ∈ m := by
      have hsub : f - PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) ∈ m :=
        m.sub_mem hf hXg
      have heq : f - PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f)
          = PowerSeries.C (PowerSeries.constantCoeff f) := by
        nth_rw 1 [hf_eq]
        rw [add_sub_cancel_right]
      rwa [heq] at hsub
    have hcomap : PowerSeries.constantCoeff f ∈
        Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) m := (Ideal.mem_comap).mpr hCa
    have h1 : PowerSeries.C (PowerSeries.constantCoeff f) ∈
        Ideal.map (PowerSeries.C : A →+* A⟦X⟧)
          (Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) m) :=
      Ideal.mem_map_of_mem (PowerSeries.C : A →+* A⟦X⟧) hcomap
    have h2 : PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) ∈
        Ideal.span {PowerSeries.X} :=
      Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
    rw [hf_eq]
    exact Submodule.add_mem_sup h1 h2
  · refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
    · rw [Ideal.span_singleton_le_iff_mem]
      exact hX

/-! ## Exercise 1.5 (v): prime ideals of `A` are contractions of primes of `A⟦X⟧` -/

/-- The prime ideal of `A⟦X⟧` attached to a prime ideal `p` of `A`: the power
series whose constant coefficient lies in `p`. -/
private def primeLift (p : Ideal A) : Ideal A⟦X⟧ :=
  Ideal.comap (PowerSeries.constantCoeff : A⟦X⟧ →+* A) p ⊔ Ideal.span {PowerSeries.X}

private lemma mem_primeLift {p : Ideal A} {f : A⟦X⟧} :
    f ∈ primeLift p ↔ PowerSeries.constantCoeff f ∈ p := by
  constructor
  · intro hf
    obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp hf
    have hcx : PowerSeries.constantCoeff x ∈ p := (Ideal.mem_comap).mp hx
    have hy0 : PowerSeries.constantCoeff y = 0 :=
      PowerSeries.X_dvd_iff.mp (Ideal.mem_span_singleton.mp hy)
    have hcf : PowerSeries.constantCoeff f = PowerSeries.constantCoeff x := by
      rw [← hxy, map_add, hy0, add_zero]
    rw [hcf]
    exact hcx
  · intro hf
    have hf_eq : f = PowerSeries.C (PowerSeries.constantCoeff f) +
        PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) :=
      (PowerSeries.eq_X_mul_shift_add_const f).trans (add_comm _ _)
    have h1 : PowerSeries.C (PowerSeries.constantCoeff f) ∈
        Ideal.comap (PowerSeries.constantCoeff : A⟦X⟧ →+* A) p := by
      rw [Ideal.mem_comap]
      simpa using hf
    have h2 : PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) f) ∈
        Ideal.span {PowerSeries.X} :=
      Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
    rw [hf_eq]
    exact Submodule.add_mem_sup h1 h2

/-- **Exercise 1.5 (v).** Every prime ideal `p` of `A` is the contraction of a
prime ideal of `A⟦X⟧` (namely `primeLift p`). -/
theorem part_v {p : Ideal A} (hp : p.IsPrime) :
    ∃ q : Ideal A⟦X⟧, q.IsPrime ∧
      Ideal.comap (PowerSeries.C : A →+* A⟦X⟧) q = p := by
  refine ⟨primeLift p, ?_, ?_⟩
  · rw [Ideal.isPrime_iff]
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : A⟦X⟧) ∈ primeLift p := by rw [htop]; exact Submodule.mem_top
      have h2 : (1 : A) ∈ p := by
        have := mem_primeLift.mp h1
        simpa using this
      exact hp.one_notMem h2
    · intro f g hfg
      rw [mem_primeLift] at hfg
      have hfg' : PowerSeries.constantCoeff f * PowerSeries.constantCoeff g ∈ p := by
        simpa using hfg
      rcases hp.mem_or_mem hfg' with h | h
      · exact Or.inl (mem_primeLift.mpr h)
      · exact Or.inr (mem_primeLift.mpr h)
  · ext a
    rw [Ideal.mem_comap, mem_primeLift, PowerSeries.constantCoeff_C]

/-! ## Exercise 1.5 (ii): nilpotent series have nilpotent coefficients -/

/-- The `k`-th tail `Σ_i a_{i+k} X^i` of `f = Σ_i a_i X^i`. -/
private def tail (f : A⟦X⟧) (k : ℕ) : A⟦X⟧ :=
  PowerSeries.mk fun i => PowerSeries.coeff (i + k) f

private lemma coeff_tail (f : A⟦X⟧) (k i : ℕ) :
    PowerSeries.coeff i (tail f k) = PowerSeries.coeff (i + k) f := by
  simp [tail]

private lemma tail_zero (f : A⟦X⟧) : tail f 0 = f := by
  ext n
  simp [coeff_tail]

private lemma tail_succ (f : A⟦X⟧) (k : ℕ) :
    tail f k = PowerSeries.X * tail f (k + 1) + PowerSeries.C (PowerSeries.coeff k f) := by
  have h₁ : PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) (tail f k)) = tail f (k + 1) := by
    ext i
    rw [PowerSeries.coeff_mk, coeff_tail, coeff_tail, Nat.add_right_comm, Nat.add_assoc]
  have h₂ : PowerSeries.constantCoeff (tail f k) = PowerSeries.coeff k f := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_tail, Nat.zero_add]
  rw [PowerSeries.eq_X_mul_shift_add_const (tail f k), h₁, h₂]

/-- If `X ^ k * tail f k` is nilpotent, then so is the `k`-th coefficient of `f`:
the coefficient of `X ^ (k * m)` in `(X ^ k * tail f k) ^ m` is `a_k ^ m`. -/
private lemma isNilpotent_coeff_of_tail (f : A⟦X⟧) (k : ℕ)
    (h : IsNilpotent (PowerSeries.X ^ k * tail f k)) : IsNilpotent (PowerSeries.coeff k f) := by
  obtain ⟨N, hN⟩ := h
  have hN' : (PowerSeries.X ^ k * tail f k) ^ (N + 1) = 0 := by
    rw [pow_succ, hN, zero_mul]
  have hpow : (PowerSeries.X ^ k * tail f k) ^ (N + 1)
      = PowerSeries.X ^ (k * (N + 1)) * (tail f k) ^ (N + 1) := by
    rw [mul_pow, ← pow_mul]
  have h0 : PowerSeries.coeff 0 (tail f k) = PowerSeries.coeff k f := by
    rw [coeff_tail, Nat.zero_add]
  have hm : PowerSeries.coeff 0 ((tail f k) ^ (N + 1)) =
      (PowerSeries.coeff 0 (tail f k)) ^ (N + 1) := by
    rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, map_pow,
      PowerSeries.coeff_zero_eq_constantCoeff_apply]
  have hp : PowerSeries.coeff (k * (N + 1))
        (PowerSeries.X ^ (k * (N + 1)) * (tail f k) ^ (N + 1))
      = PowerSeries.coeff 0 ((tail f k) ^ (N + 1)) := by
    simpa using PowerSeries.coeff_X_pow_mul (p := (tail f k) ^ (N + 1)) (n := k * (N + 1)) (d := 0)
  refine ⟨N + 1, ?_⟩
  rw [← h0, ← hm, ← hp, ← hpow, hN', map_zero]

/-- **Exercise 1.5 (ii).** If `f = Σ aₙ Xⁿ` is nilpotent, then each `aₙ` is
nilpotent. -/
theorem part_ii (f : A⟦X⟧) (hf : IsNilpotent f) (n : ℕ) :
    IsNilpotent (PowerSeries.coeff n f) := by
  have key : ∀ k : ℕ,
      IsNilpotent (PowerSeries.X ^ k * tail f k) ∧ IsNilpotent (PowerSeries.coeff k f) := by
    intro k
    induction k with
    | zero =>
      refine ⟨?_, ?_⟩
      · simpa [tail_zero] using hf
      · have h := hf.map (PowerSeries.constantCoeff (R := A))
        simpa [PowerSeries.coeff_zero_eq_constantCoeff_apply] using h
    | succ k ih =>
      obtain ⟨ihX, ihc⟩ := ih
      have h2 : IsNilpotent (PowerSeries.X ^ k * PowerSeries.C (PowerSeries.coeff k f)) :=
        Commute.isNilpotent_mul_left (Commute.all _ _) (ihc.map (PowerSeries.C (R := A)))
      have hstep : PowerSeries.X ^ (k + 1) * tail f (k + 1)
          = PowerSeries.X ^ k * tail f k
            - PowerSeries.X ^ k * PowerSeries.C (PowerSeries.coeff k f) := by
        rw [tail_succ f k, pow_succ]
        ring
      have hX : IsNilpotent (PowerSeries.X ^ (k + 1) * tail f (k + 1)) := by
        rw [hstep]
        exact Commute.isNilpotent_sub (Commute.all _ _) ihX h2
      exact ⟨hX, isNilpotent_coeff_of_tail f (k + 1) hX⟩
  exact (key n).2

/-! ## Exercise 1.5 (ii): the converse fails -/

/-- The ring `∏_{k≥0} ℤ/2^{k+1}ℤ`, used for the counterexample to the converse
of Exercise 1.5 (ii). -/
abbrev CounterRing : Type := ∀ k : ℕ, ZMod (2 ^ (k + 1))

/-- `2` in the `k`-th factor and `0` in every other factor.  This element is
nilpotent, with `(a k) ^ (k + 1) = 0`. -/
def counterCoeff (k : ℕ) : CounterRing :=
  fun i => if i = k then (2 : ZMod (2 ^ (i + 1))) else 0

/-- The power series `f = Σ_k a_k X^k` with `a_k = counterCoeff k`: all of its
coefficients are nilpotent, but `f` itself is not nilpotent. -/
def counterSeries : PowerSeries CounterRing := PowerSeries.mk counterCoeff

private lemma counterCoeff_self (k : ℕ) : counterCoeff k k = 2 := by
  simp [counterCoeff]

private lemma counterCoeff_of_ne {k i : ℕ} (h : i ≠ k) : counterCoeff k i = 0 := by
  simp [counterCoeff, h]

private lemma counterCoeff_pow_self (k n : ℕ) :
    (counterCoeff k ^ n) k = (2 : ZMod (2 ^ (k + 1))) ^ n := by
  rw [Pi.pow_apply, counterCoeff_self]

private lemma counterCoeff_pow_of_ne {k n i : ℕ} (h : i ≠ k) :
    (counterCoeff k ^ (n + 1)) i = 0 := by
  rw [Pi.pow_apply, counterCoeff_of_ne h]
  exact zero_pow (Nat.succ_ne_zero n)

theorem counterCoeff_isNilpotent (k : ℕ) : IsNilpotent (counterCoeff k) := by
  refine ⟨k + 1, ?_⟩
  funext i
  by_cases h : i = k
  · cases h
    rw [counterCoeff_pow_self]
    have hcast : ((2 : ZMod (2 ^ (k + 1))) ^ (k + 1))
        = ((2 ^ (k + 1) : ℕ) : ZMod (2 ^ (k + 1))) := by
      push_cast
      ring
    rw [hcast, ZMod.natCast_self]
    rfl
  · rw [counterCoeff_pow_of_ne h]
    rfl

private def proj (k : ℕ) : CounterRing →+* ZMod (2 ^ (k + 1)) where
  toFun x := x k
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

private lemma map_counterSeries (k : ℕ) :
    PowerSeries.map (proj k) counterSeries
      = PowerSeries.C (2 : ZMod (2 ^ (k + 1))) * PowerSeries.X ^ k := by
  ext j
  rw [PowerSeries.coeff_map]
  unfold counterSeries
  rw [PowerSeries.coeff_mk, PowerSeries.coeff_C_mul_X_pow]
  change counterCoeff j k = if j = k then (2 : ZMod (2 ^ (k + 1))) else 0
  by_cases h : j = k
  · subst h
    rw [counterCoeff_self]
    simp
  · rw [counterCoeff_of_ne (Ne.symm h), if_neg h]

theorem counterSeries_pow_ne_zero (n : ℕ) : counterSeries ^ n ≠ 0 := by
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · subst h0
    intro h
    have h1 : PowerSeries.coeff 0 (counterSeries ^ 0)
        = PowerSeries.coeff 0 (0 : PowerSeries CounterRing) := by rw [h]
    rw [pow_zero, PowerSeries.coeff_zero_one, map_zero] at h1
    have h2 := congrFun h1 0
    simp at h2
  · intro h
    have hm : (PowerSeries.C (2 : ZMod (2 ^ (n + 1))) * PowerSeries.X ^ n) ^ n = 0 := by
      have h' := congrArg (PowerSeries.map (proj n)) h
      rwa [map_pow, map_counterSeries, map_zero] at h'
    have hpow : (PowerSeries.C (2 : ZMod (2 ^ (n + 1))) * PowerSeries.X ^ n) ^ n
        = PowerSeries.C ((2 : ZMod (2 ^ (n + 1))) ^ n) * PowerSeries.X ^ (n * n) := by
      rw [mul_pow, ← map_pow, ← pow_mul]
    have hcoef : (2 : ZMod (2 ^ (n + 1))) ^ n = 0 := by
      have hc := congrArg (PowerSeries.coeff (n * n)) hm
      rw [hpow, PowerSeries.coeff_C_mul_X_pow, map_zero] at hc
      simpa using hc
    have hcast : ((2 ^ n : ℕ) : ZMod (2 ^ (n + 1))) ≠ 0 := by
      intro hzero
      rw [ZMod.natCast_eq_zero_iff] at hzero
      have hpos' : 0 < 2 ^ n := Nat.pow_pos (by norm_num)
      have hle : 2 ^ (n + 1) ≤ 2 ^ n := Nat.le_of_dvd hpos' hzero
      have hlt : 2 ^ n < 2 ^ (n + 1) :=
        Nat.pow_lt_pow_right (by norm_num) (Nat.lt_succ_self n)
      omega
    apply hcast
    have h2 : ((2 : ZMod (2 ^ (n + 1))) ^ n) = ((2 ^ n : ℕ) : ZMod (2 ^ (n + 1))) := by
      push_cast
      ring
    rw [← h2]
    exact hcoef

theorem counterSeries_not_isNilpotent : ¬ IsNilpotent counterSeries := by
  rintro ⟨n, hn⟩
  exact counterSeries_pow_ne_zero n hn

/-- **Exercise 1.5 (ii), converse.** The converse of (ii) is false: the series
`counterSeries` over `CounterRing = ∏_{k} ℤ/2^{k+1}ℤ` has all coefficients
nilpotent but is not itself nilpotent. -/
theorem part_ii_converse_fails :
    (∀ n : ℕ, IsNilpotent (PowerSeries.coeff n counterSeries)) ∧ ¬ IsNilpotent counterSeries :=
  ⟨fun n => by
    have h : PowerSeries.coeff n counterSeries = counterCoeff n := PowerSeries.coeff_mk n counterCoeff
    rw [h]
    exact counterCoeff_isNilpotent n,
   counterSeries_not_isNilpotent⟩

/-- **Exercise 1.5 (ii), converse, existential form.** There are a ring `A` and a
power series `f ∈ A⟦X⟧` all of whose coefficients are nilpotent while `f` itself
is not nilpotent. -/
theorem part_ii_converse_false :
    ∃ (A : Type) (_ : CommRing A) (f : PowerSeries A),
      (∀ n : ℕ, IsNilpotent (PowerSeries.coeff n f)) ∧ ¬ IsNilpotent f :=
  ⟨CounterRing, inferInstance, counterSeries, part_ii_converse_fails⟩

end

end AtiyahMcdonald69.Ex_1_5
